# Computational Software Engineering Environment
# RHUFT v6.0

# Python Configuration
PYTHONPATH=${PWD}/src:${PYTHONPATH}
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# Jupyter Configuration
JUPYTER_ENABLE_LAB=yes
JUPYTER_CONFIG_DIR=${PWD}/.jupyter

# Performance & Parallelism
OMP_NUM_THREADS=0  # Use all available cores
OPENBLAS_NUM_THREADS=0
MKL_NUM_THREADS=0
VECLIB_MAXIMUM_THREADS=0
NUMEXPR_NUM_THREADS=0

# Development Mode
DEBUG=1
LOG_LEVEL=INFO

# Data Paths
DATA_DIR=${PWD}/data
CACHE_DIR=${PWD}/.cache
OUTPUT_DIR=${PWD}/output

# Computational Settings
RANDOM_SEED=42
FLOAT_PRECISION=double

# Build Configuration
CMAKE_BUILD_TYPE=Release
BUILD_TESTS=ON
BUILD_PYTHON_BINDINGS=OFF

# ML/DL Settings
TORCH_CUDA_ARCH_LIST=
TF_CPP_MIN_LOG_LEVEL=1

# Testing
PYTEST_CURRENT_TEST=1
COVERAGE_RUN=1
