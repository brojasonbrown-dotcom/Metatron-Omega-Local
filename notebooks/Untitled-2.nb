      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"8423d9ab-d837-6e42-a97e-cae902ba69ab"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"VIII. Important correction on infinite precision\"\>", 
    "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"537cbafd-0702-eb46-a7ef-19c1abd04c2b"],
 "\nYour OPF directive says: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   RowBox[{"WorkingPrecision", "->", "Infinity"}]], "InlineWL", "Input",
   ShowAutoStyles->True,
   ShowSyntaxStyles->True,
   LanguageCategory->"Input",
   ShowStringCharacters->True,ExpressionUUID->
   "4c6356e2-e086-644b-96bc-efe7736f6fe9"]
 }], "InlineItem",ExpressionUUID->"60010420-a162-2946-9be1-d888f100b443"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["$MaxPrecision = $MinPrecision = \[Infinity]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "ccffe860-f977-f946-b4ec-8e4001324484"]
 }], "InlineItem",ExpressionUUID->"54cff9ae-9818-ec45-9605-c0602cba9932"],
 "\nIn actual Wolfram Language numerics, literal infinite numerical working \
precision is generally not available for algorithms like ",
 Cell[BoxData[
  TemplateBox[{
   "NIntegrate", "paclet:ref/NIntegrate", 
    "https://reference.wolfram.com/language/ref/NIntegrate.html"},
   "TextRefLink"]],ExpressionUUID->"62848690-0830-f34e-a623-3bfb6f57654c"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
   "NDSolve", "paclet:ref/NDSolve", 
    "https://reference.wolfram.com/language/ref/NDSolve.html"},
   "TextRefLink"]],ExpressionUUID->"b132506d-2cc7-534b-bfc3-f774984f7096"],
 ", etc.\n\nSo the rigorous computational interpretation should be: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "use exact symbolic computation first"
 }], "InlineItem",ExpressionUUID->"9b3a6498-14a7-284b-8164-03c2327c779e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "use arbitrary precision numerics second"
 }], "InlineItem",ExpressionUUID->"cfd52ab9-bd03-4a41-a023-f7c03e947434"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "increase precision adaptively"
 }], "InlineItem",ExpressionUUID->"0eaa2cd3-4112-a94d-b593-7d1cc20000e6"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "validate convergence"
 }], "InlineItem",ExpressionUUID->"740bd9cb-fe5f-7c46-80ed-8909a7660f17"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "require residual target, e.g. ",
  Cell[BoxData[
   TemplateBox[{
     Cell["Abs[residual] < 10^-50", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "b23129c7-6514-af4b-8f03-c0fb035f9e81"],
  " where feasible"
 }], "InlineItem",ExpressionUUID->"d81ab651-c1f7-9843-b722-cf301e606553"],
 "\nThat preserves your intent while remaining executable. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
