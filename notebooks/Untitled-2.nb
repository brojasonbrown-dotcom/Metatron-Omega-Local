    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"eee37d6a-3ebc-7c4e-b693-a8e06b19397e"],
 "\nConstruct scale states and system states. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. Invariant calculators\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"8840e3c8-c3bc-f147-94af-23f08acc02c9"],
 "\nPure functions from state to descriptor. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"5. Action and residual calculators\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"9db23f53-8a52-934d-91cf-1edc84118d06"],
 "\nSymbolic and numerical. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"6. Linearization and spectral analysis\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c756da2f-e2b0-6749-9117-aa3e2dfd0dce"],
 "\nUsing ",
 Cell[BoxData[
  TemplateBox[{
   "Eigensystem", "paclet:ref/Eigensystem", 
    "https://reference.wolfram.com/language/ref/Eigensystem.html"},
   "TextRefLink"]],ExpressionUUID->"ab55ba37-bd68-b646-b882-092305ead321"],
 " where appropriate. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"7. Confidence corridor logic\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"272c724c-0da5-4c4a-8d6e-5c794e4eed94"],
 "\nDecision regime mapping. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"8. Test runners\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"5b7159fa-5d11-ca45-953f-f9f349f4cc70"],
 "\nGenerate all 18 tests for each scale. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"9. Aggregators\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"19af0c97-9c27-e64b-b4c3-1d86d7fcbc93"],
 "\nSummaries, weighted stability score, failure map. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"10. Exporters\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d781e1f6-3ae2-6e46-8d54-4244b02a8d18"],
 "\nTo JSON, WL, TS templates, markdown reports. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
