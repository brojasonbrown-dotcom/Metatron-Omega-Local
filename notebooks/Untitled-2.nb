 }], "InlineItem",ExpressionUUID->"b81872a6-0bb1-cc45-aebb-5f464208f8b9"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Proposed invariant set\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"4392ab21-8255-7f48-b16f-c7280a1d9df2"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"1. Aspect ratio invariant\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"9aee202a-987a-3546-ab48-276d18e733f7"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["r", "TI"], 
            StyleBox["M", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["j", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["r", "TI"], 
            RowBox[{"[", 
              StyleBox["s", "TI"], "]"}]}], 
          RowBox[{
            StyleBox["r", "TI"], 
            StyleBox["M", "TI"], 
            StyleBox["i", "TI"], 
            StyleBox["n", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["r", "TI"], 
            RowBox[{"[", 
              StyleBox["s", "TI"], "]"}]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "a_s = \\frac{rMajor[s]}{rMinor[s]}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "13afcc09-1e59-9247-963b-97e363b573aa"],
 "\nUseful for toroidal morphology. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"2. Closure phase lock\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0df512e5-8ff0-1240-a006-1c97475b16a2"],
 "\nWe want closure phase close to a winding condition: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Theta]", 
         RowBox[{"[", 
           StyleBox["s", "TI"], "]"}], "\[TildeTilde]", "2", "\[Pi]", 
         SubscriptBox[
          StyleBox["n", "TI"], 
          StyleBox["s", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta[s] \\approx 2 \\pi n_s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db0cb76a-ae73-e040-954b-0fc2a91c64b4"],
 "\nDefine phase lock score: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", "exp", 
         RowBox[{"(", 
           RowBox[{"-", 
             TemplateBox[{
               RowBox[{
                 RowBox[{"\[Theta]", 
                   RowBox[{"[", 
                    StyleBox["s", "TI"], "]"}], "-", "2", "\[Pi] ", 
                   StyleBox["Round", FontSlant -> "Plain"], 
                   RowBox[{"(", 
                    FractionBox[
                    RowBox[{"\[Theta]", 
                    RowBox[{"[", 
                    StyleBox["s", "TI"], "]"}]}], 
                    RowBox[{"2", "\[Pi]"}]], ")"}]}]}]}, "Abs"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "C_s = \\exp\\left(-\\left|\\theta[s] - 2\\pi \
\\,\\mathrm{Round}\\left(\\frac{\\theta[s]}{2\\pi}\\right)\\right|\\right)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "81cd7a68-2ff9-574d-b28a-028cec797ef0"],
 "\nThis gives a bounded closure score in ",
 Cell[BoxData[
  TemplateBox[{
    Cell["(0,1]", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "66f5af2d-5b87-c441-b9a3-439fc7c940db"],
 ". \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"3. Curvature-torsion coherence\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"3cb7304e-de30-3842-bb8b-559ec8278aed"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["K", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"1", "+", "|", 
            StyleBox["k", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["p", "TI"], 
            StyleBox["p", "TI"], 
            StyleBox["a", "TI"], 
            RowBox[{"[", 
              StyleBox["s", "TI"], "]"}], "-", 
            StyleBox["t", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["u", "TI"], 
            RowBox[{"[", 
              StyleBox["s", "TI"], "]"}], "|"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "K_s = \\frac{1}{1 + |kappa[s] - tau[s]|}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "72ef776d-f49a-9340-a2f9-b562bff450c9"],
 "\nA balance measure. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. Flux containment\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"46c19594-cd46-ec44-b4d4-29c8320e2fd0"],
 "\nA proxy containment metric: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["F", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"1", "+", "|", "\[Del]", 
            StyleBox["f", "TI"], 
            StyleBox["l", "TI"], 
            StyleBox["u", "TI"], 
            StyleBox["x", "TI"], 
            SubscriptBox["|", 
             StyleBox["s", "TI"]]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "F_s = \\frac{1}{1 + |\\nabla flux|_s}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3e0fe44-c60e-ec4d-aae0-e503099d24ec"],
 "\nIn discrete form this can be finite-difference based. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"5. Maintenance stability\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b7b684fb-a1ad-e24a-905f-997e83720ba4"],
 "\nFrom your Layer 2 maintenance operator: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["X", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "+", "\[CapitalGamma]", 
         StyleBox["X", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\frac{dX}{dt} + \\Gamma X = 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "38c96632-7929-8d4a-876f-c0a97dcf90c5"],
 "\nIf no explicit time exists at L0/L1, then in L2 we interpret this as \
effective decoherence damping. So define: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", "\[Gamma]", 
            RowBox[{"[", 
              StyleBox["s", "TI"], "]"}]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "M_s = e^{-\\gamma[s]}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1c28faf0-079d-9d44-a959-8a1a9e62f11c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"6. Boundary integrity\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"5cec0e9c-c907-3345-9571-410bc793b0c3"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"1", "+", "|", "\[Beta]", 
            RowBox[{"[", 
              StyleBox["s", "TI"], "]"}], "-", "1|"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "B_s = \\frac{1}{1 + |\\beta[s] - 1|}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a24da7b0-5e32-5e43-ab3f-6c34503cc625"],
 "\nBoundary coupling ideally normalized near 1. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"7. Information-complexity efficiency\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7793d87a-f94d-8946-9ca5-587ae1422d57"],
 "\nFrom the action term: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", "\[Rho]", 
         RowBox[{"[", 
           StyleBox["s", "TI"], "]"}], "log", 
         RowBox[{"(", 
           RowBox[{"\[Chi]", 
             RowBox[{"[", 
               StyleBox["s", "TI"], "]"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "E_s = \\rho[s]\\log(\\chi[s])", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4bc37984-45d6-de41-9a58-f5706547e7c9"],
 "\nNeed domain condition: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Chi]", 
         RowBox[{"[", 
           StyleBox["s", "TI"], "]"}], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\chi[s] > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3045e0e2-53a9-8c46-8924-542a5a143a5d"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"8. Resolution burden\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f5cd3acc-7324-4b4e-8a0b-0096468d004b"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["s", "TI"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["c", "TI"], 
              StyleBox["o", "TI"], 
              StyleBox["s", "TI"], 
              StyleBox["t", "TI"]}], ")"}]], "\[LongEqual]", "\[Chi]", 
         RowBox[{"[", 
           StyleBox["s", "TI"], "]"}], " ", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         StyleBox["s", "TI"], 
         SuperscriptBox[
          RowBox[{"[", 
            StyleBox["s", "TI"], "]"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "R_s^{(cost)} = \\chi[s]\\,res[s]^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0590ccf3-e753-fc47-b566-ea720140d745"],
 "\nThis is already in your action density. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"9. Scale recursion consistency\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f46373ed-7529-b04d-a172-013194bce6fd"],
 "\nA scale should map coherently to neighboring scales. Define: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Q", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         FractionBox["1", 
          
          RowBox[{"1", "+", 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9", 
            SubscriptBox[
             StyleBox["I", "TI"], 
             RowBox[{
               StyleBox["s", "TI"], "+", "1"}]], "-", 
            StyleBox["T", "TI"], 
            RowBox[{"(", 
              SubscriptBox[
               StyleBox["I", "TI"], 
               StyleBox["s", "TI"]], ")"}], 
            "\[IDoubleDot]\.8e\[Cedilla]124\[IDoubleDot]\.8e\.b9"}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "Q_s = \\frac{1}{1 + |I_{s+1} - \\mathcal{T}(I_s)|}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8079a86b-30d4-294f-bdb8-eafe245eb0e3"],
 "\nwhere ",
 Cell[BoxData[
  TemplateBox[{
    Cell["I_s", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "3c362421-2844-474b-86fa-f2783d3f9105"],
 " is the invariant vector at scale ",
 StyleBox["s", "TI"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell["\|01d4af", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "808784b4-21c0-9347-bf32-7da27e77cb78"],
 " is a scale transition operator.\n\nThis is crucial if the 18 scales form a \
nested or recursive stability ladder. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"c813a0c5-04ac-d140-8b76-b78ae3bfe08c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"II. Extended action for toroidal dimensional stability\"\>", 
    "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"57889383-9288-9440-b475-fd1700d1248d"],
 "\nYour OPF action is: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "\[LongEqual]", "\[Integral]", 
         RowBox[{"[", 
           RowBox[{"\[Rho]", "log", 
             RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
             SuperscriptBox[
              StyleBox["R", "TI"], "2"]}], "]"}], "\[DifferentialD]", 
         "\[CapitalOmega]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "S = \\int [\\rho \\log(\\chi) + \\chi R^2] \\, d\\Omega", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b6642973-f658-1345-9c3b-b2195db80a8c"],
 "\nTo support toroidal closure, I propose an extended action density: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", "\[Rho]", 
         RowBox[{"[", 
           StyleBox["s", "TI"], "]"}], "log", 
         RowBox[{"(", 
           RowBox[{"\[Chi]", 
             RowBox[{"[", 
               StyleBox["s", "TI"], "]"}]}], ")"}], "+", "\[Chi]", 
         RowBox[{"[", 
           StyleBox["s", "TI"], "]"}], " ", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         StyleBox["s", "TI"], 
         SuperscriptBox[
          RowBox[{"[", 
            StyleBox["s", "TI"], "]"}], "2"], "+", 
         SubscriptBox["\[Lambda]", "1"], 
         StyleBox["k", "TI"], 
         StyleBox["a", "TI"], 
         StyleBox["p", "TI"], 
         StyleBox["p", "TI"], 
         StyleBox["a", "TI"], 
         SuperscriptBox[
          RowBox[{"[", 
            StyleBox["s", "TI"], "]"}], "2"], "+", 
         SubscriptBox["\[Lambda]", "2"], 
         StyleBox["t", "TI"], 
         StyleBox["a", "TI"], 
         StyleBox["u", "TI"], 
         SuperscriptBox[
          RowBox[{"[", 
            StyleBox["s", "TI"], "]"}], "2"], "+", 
         SubscriptBox["\[Lambda]", "3"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"\[Theta]", 
              RowBox[{"[", 
                StyleBox["s", "TI"], "]"}], "-", "2", "\[Pi]", 
              StyleBox["n", "TI"], 
              RowBox[{"[", 
                StyleBox["s", "TI"], "]"}]}], ")"}], "2"], "+", 
         SubscriptBox["\[Lambda]", "4"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              FractionBox[
               RowBox[{
                 StyleBox["r", "TI"], 
                 StyleBox["M", "TI"], 
                 StyleBox["a", "TI"], 
                 StyleBox["j", "TI"], 
                 StyleBox["o", "TI"], 
                 StyleBox["r", "TI"], 
                 RowBox[{"[", 
                   StyleBox["s", "TI"], "]"}]}], 
               RowBox[{
                 StyleBox["r", "TI"], 
                 StyleBox["M", "TI"], 
                 StyleBox["i", "TI"], 
                 StyleBox["n", "TI"], 
                 StyleBox["o", "TI"], 
                 StyleBox["r", "TI"], 
                 RowBox[{"[", 
                   StyleBox["s", "TI"], "]"}]}]], "-", "\[CurlyPhi]"}], ")"}],
           "2"], "+", 
         SubscriptBox["\[Lambda]", "5"], "\[Gamma]", 
         SuperscriptBox[
          RowBox[{"[", 
            StyleBox["s", "TI"], "]"}], "2"], "+", 
         SubscriptBox["\[Lambda]", "6"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"\[Beta]", 
              RowBox[{"[", 
                StyleBox["s", "TI"], "]"}], "-", "1"}], ")"}], "2"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{L}_s =\n\\rho[s]\\log(\\chi[s])\n+ \\chi[s]\\,res[s]^2\n+ \
\\lambda_1 kappa[s]^2\n+ \\lambda_2 tau[s]^2\n+ \\lambda_3(\\theta[s]-2\\pi \
n[s])^2\n+ \\lambda_4\\left(\\frac{rMajor[s]}{rMinor[s]}-\\varphi\\right)^2\n\
+ \\lambda_5\\gamma[s]^2\n+ \\lambda_6(\\beta[s]-1)^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2843e18c-bf98-ba47-90fa-e33cfd9e21c9"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CurlyPhi]", "\[LongEqual]", 
         FractionBox[
          RowBox[{"1", "+", 
            SqrtBox["5"]}], "2"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\varphi = \\frac{1+\\sqrt{5}}{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ed7e5c51-591c-da41-bb3d-b07f2eb0cd6f"],
 " if you want the golden-ratio attractor to remain part of the confidence / \
geometric regime.\n\nThis is not yet \[OpenCurlyDoubleQuote]truth,\
\[CloseCurlyDoubleQuote] but it is computationally meaningful.\n\nIt gives \
you penalties for: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "unstable curvature"
 }], "InlineItem",ExpressionUUID->"f4a7c571-25ee-1446-81f1-e67a6f558fdf"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "unstable torsion"
 }], "InlineItem",ExpressionUUID->"f4283c7c-bbb1-234f-9500-7458fb8640d0"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "phase nonclosure"
 }], "InlineItem",ExpressionUUID->"1a6ef5b4-8b37-2045-9f28-c752a8d0f23e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "aspect-ratio deviation"
 }], "InlineItem",ExpressionUUID->"f5369eca-34aa-bf4e-bb58-2757b7f96447"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "decoherence cost"
 }], "InlineItem",ExpressionUUID->"bea52176-becd-884d-ac6b-a97d81af6099"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "boundary mismatch"
 }], "InlineItem",ExpressionUUID->"7b29bff8-531d-3540-ae09-73f1b8bd204d"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"b4871866-db1a-ec4e-ad43-6e64dd2c0d37"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"III. The 18 stable scales\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d984822f-4bcb-9a4e-80dd-782402ad855b"],
 "\nThis is the biggest unresolved object.\n\nWe need to choose one of three \
interpretations. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Option 1 \[LongDash] Discrete nested geometric scales\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}},
   ScrollPosition->{0., 0.}]], "InlineSection",
  Background->None,ExpressionUUID->"7483a910-b402-544e-a727-23a1fc5ef326"],
 "\nThe 18 scales are a finite ladder of toroidal stability shells.\n\nEach \
scale is: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a discrete toroidal configuration"
 }], "InlineItem",ExpressionUUID->"c01e2ef9-fa94-404d-a1e0-5862df1d67f1"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "linked to neighboring shells"
 }], "InlineItem",ExpressionUUID->"7a4ac4a1-28c3-6c4b-8707-f2eb0a6dde08"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "characterized by its own invariant vector"
 }], "InlineItem",ExpressionUUID->"612f5251-edb2-a04a-af94-9bc92011b802"],
 "\nThis is the easiest computationally. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Option 2 \[LongDash] Spectral modes\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}},
   ScrollPosition->{0., 0.}]], "InlineSection",
  Background->None,ExpressionUUID->"1d5ca861-da9c-8741-a5d1-274fded9fb1e"],
 "\nThe 18 scales are the first 18 stable eigenmodes of a closure operator.\n\
\nThen \[OpenCurlyDoubleQuote]scale\[CloseCurlyDoubleQuote] means resonance \
order or harmonic structure.\n\nThis is elegant if your framework is \
resonance-first. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Option 3 \[LongDash] Dimensional effective regimes\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f6c3c3a0-a84d-e048-8541-ca8e69af0d57"],
 "\nThe 18 scales are 18 stable effective dimensional organizations of \
spacetime/information geometry.\n\nThis is philosophically strong, but \
hardest to compute unless we define exact dimensional observables. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"My recommendation\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"aa9f9138-97ec-6c42-98f5-676ab853be1b"],
 "\nUse a ",
 StyleBox["hybrid",
  FontWeight->Bold],
 ": \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "primary interpretation: ",
  StyleBox["18 discrete toroidal scales",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"cd35d65c-56ec-9b46-ba44-470803caf9d9"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "secondary interpretation: each scale has a ",
  StyleBox["dominant spectral mode",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"8967fa21-beaa-e845-8835-910d192a07ca"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "tertiary interpretation: each scale corresponds to an ",
  StyleBox["effective dimensional stability regime",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"cbc3be88-7eb8-674a-b5c0-8d72dbcda312"],
 "\nThat gives you computational traction without collapsing the larger idea. \
\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"1f88a9fe-07a9-e945-a595-c800cee72817"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"IV. Confidence corridor integration\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0e3d6f4c-236a-c74c-8360-dee1db4b7181"],
 "\nThe image you provided is very useful. It gives a decision logic: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "lower confidence bound"
 }], "InlineItem",ExpressionUUID->"3ba5c538-77e2-c74e-a7eb-d2fc85a7dd88"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "upper confidence bound"
 }], "InlineItem",ExpressionUUID->"45f2917a-c55b-5d4f-8a94-c3182efe4297"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "regimes stable / stress / critical"
 }], "InlineItem",ExpressionUUID->"c536150b-2805-7943-9ead-b7a6e999f7be"],
 "\nThis can become a general epistemic controller for the framework. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Formalization\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"76c8ca29-d3bc-1448-ad98-e640f21a875c"],
 "\nLet: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "normalized variational free energy = ",
  Cell[BoxData[
   TemplateBox[{
     Cell["vfeNorm[s]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "15ca4718-5571-4142-ad4f-9f26814bf7ad"]
 }], "InlineItem",ExpressionUUID->"7f680bca-a4f4-794c-8aa6-86aca0492566"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "normalized uncertainty = ",
  Cell[BoxData[
   TemplateBox[{
     Cell["sigmaNorm[s]", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "1cff46ad-1564-c849-a790-b3323e1faad9"]
 }], "InlineItem",ExpressionUUID->"db84d018-5a98-b34d-afd0-2db61356440b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "golden ratio = ",
  StyleBox["phi", "TI"]
 }], "InlineItem",ExpressionUUID->"1638fccd-d66a-704b-9471-99a1efa5afe7"],
 "\nThen define: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         SubscriptBox[
          StyleBox["I", "TI"], 
          RowBox[{
            StyleBox["l", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["w", "TI"], 
            StyleBox["e", "TI"], 
            StyleBox["r", "TI"]}]], 
         RowBox[{"[", 
           StyleBox["s", "TI"], "]"}], "\[LongEqual]", "max", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Phi]", "-2"], ",", "1", "-", 
             StyleBox["v", "TI"], 
             StyleBox["f", "TI"], 
             StyleBox["e", "TI"], 
             StyleBox["N", "TI"], 
             StyleBox["o", "TI"], 
             StyleBox["r", "TI"], 
             StyleBox["m", "TI"], 
             RowBox[{"[", 
               StyleBox["s", "TI"], "]"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "CI_{lower}[s] = \\max(\\phi^{-2}, 1 - vfeNorm[s])", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d885e862-4c9f-274f-94f7-7bf79c6632d9"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         SubscriptBox[
          StyleBox["I", "TI"], 
          RowBox[{
            StyleBox["u", "TI"], 
            StyleBox["p", "TI"], 
            StyleBox["p", "TI"], 
            StyleBox["e", "TI"], 
            StyleBox["r", "TI"]}]], 
         RowBox[{"[", 
           StyleBox["s", "TI"], "]"}], "\[LongEqual]", "min", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Phi]", 
              RowBox[{
                StyleBox["c", "TI"], 
                StyleBox["a", "TI"], 
                StyleBox["u", "TI"], 
                StyleBox["t", "TI"], 
                StyleBox["i", "TI"], 
                StyleBox["o", "TI"], 
                StyleBox["n", "TI"]}]], ",", "1", "-", 
             StyleBox["s", "TI"], 
             StyleBox["i", "TI"], 
             StyleBox["g", "TI"], 
             StyleBox["m", "TI"], 
             StyleBox["a", "TI"], 
             StyleBox["N", "TI"], 
             StyleBox["o", "TI"], 
             StyleBox["r", "TI"], 
             StyleBox["m", "TI"], 
             RowBox[{"[", 
               StyleBox["s", "TI"], "]"}], 
             SuperscriptBox["\[Phi]", "-1"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "CI_{upper}[s] = \\min(\\phi_{caution}, 1 - sigmaNorm[s]\\phi^{-1})", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b827e17d-13f1-a049-b384-136232504a77"],
 "\nand regime: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Stable if ",
  Cell[BoxData[
   TemplateBox[{
     Cell["CI_lower > phi^-1", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "925b6dfe-a9c3-e842-9531-6937efc04966"]
 }], "InlineItem",ExpressionUUID->"eee61b3a-a8ec-2a45-a77e-0b5d12fddbdc"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Stress if ",
  Cell[BoxData[
   TemplateBox[{
     Cell["CI_lower > 0.432", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "48614ba2-ad82-d44e-8bc8-276137fec9cb"]
 }], "InlineItem",ExpressionUUID->"d8eee901-6c6f-2446-b84d-7351b7ecc59f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Critical otherwise"
 }], "InlineItem",ExpressionUUID->"54999811-8587-3547-89d2-4456729dbff3"],
 "\nThis gives a ",
 StyleBox["decision corridor",
  FontWeight->Bold],
 " for how much autonomy / confidence a scale is permitted.\n\nThat is \
actually powerful: it can govern algorithm selection, refinement depth, and \
intervention thresholds. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"d398be5b-7150-ea40-b7d2-ef04736788c5"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"V. The 18 rigorous tests\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7745dae1-6340-4542-b9da-1872108c488d"],
 "\nNow the core deliverable.\n\nYou asked for ",
 StyleBox["18 super rigorous and robust complete tests",
  FontWeight->Bold],
 ".\n\nThese should not just be booleans. Each should have: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "definition"
 }], "InlineItem",ExpressionUUID->"cc458264-ccb9-e546-a87c-1486ae89690f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "metric"
 }], "InlineItem",ExpressionUUID->"b54a4b8d-240a-f843-8206-f0a6a1eb58a9"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "admissible interval"
 }], "InlineItem",ExpressionUUID->"3866acff-357a-2745-a3a5-e853be0acbe7"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "symbolic form"
 }], "InlineItem",ExpressionUUID->"7da281ce-acbd-6d40-80ae-757b7b265f21"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "numerical evaluator"
 }], "InlineItem",ExpressionUUID->"901fa409-92f1-0043-a9da-ecc5c1060411"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "residual check"
 }], "InlineItem",ExpressionUUID->"2cda1790-f024-b44b-8bad-dd50862773c0"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "failure diagnostics"
 }], "InlineItem",ExpressionUUID->"b8b2654b-1554-de42-8c74-c906ccf34975"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Proposed test list\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e4f562ec-3bf3-2f4f-849d-9829a5f4b33e"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 1 \[LongDash] Closure phase lock\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"1ce1715f-d2d9-dd4c-9971-ac98172b8cc6"],
 "\nChecks whether each scale is near a winding closure. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 2 \[LongDash] Aspect ratio admissibility\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"67ce0858-f063-6e48-bf74-6406cb3de7e3"],
 "\nChecks whether toroidal geometry remains in a valid ratio band. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 3 \[LongDash] Curvature boundedness\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"2f57c543-db0e-1c47-8744-8169d845234d"],
 "\nEnsures curvature remains finite and stable. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 4 \[LongDash] Torsion boundedness\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d95b475b-0a02-f54e-9439-6ce66f3fb630"],
 "\nEnsures torsion remains finite and stable. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 5 \[LongDash] Curvature-torsion coherence\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ac03a9ae-068c-8147-9e27-20201cbe900d"],
 "\nChecks whether curvature and torsion remain mutually compatible. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 6 \[LongDash] Flux containment\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"4a5b1e99-88af-9d4e-98fd-b8543f32e492"],
 "\nChecks whether flux remains bounded or self-contained. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 7 \[LongDash] Boundary integrity\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"8980815e-f489-fc43-9a60-ef5eb21fabd2"],
 "\nChecks whether boundary coupling remains coherent. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 8 \[LongDash] Decoherence maintenance \
admissibility\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"14f0ca1d-8ede-534b-8b72-541ac3d7550d"],
 "\nChecks whether maintenance cost remains below collapse threshold. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 9 \[LongDash] Positive information density\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"31c25368-3c6f-3443-bf8a-d595556607a4"],
 "\nRequires ",
 Cell[BoxData[
  TemplateBox[{
    Cell["rho[s] > 0", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "ae12a637-cefa-1d48-83c3-adae90adad8b"],
 ". \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 10 \[LongDash] Positive complexity domain\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b5253f70-e826-a94b-967d-69fce0441561"],
 "\nRequires ",
 Cell[BoxData[
  TemplateBox[{
    Cell["chi[s] > 0", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "3c4cd35d-0276-ae4f-b344-c153b173b508"],
 " so ",
 Cell[BoxData[
  RowBox[{"Log", "[", "chi", "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "7aee0853-9b1c-e244-84c5-dec8f933151b"],
 " is valid. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 11 \[LongDash] Resolution admissibility\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a6581b5b-4fcd-904e-a297-8a90461f4ffb"],
 "\nRequires ",
 Cell[BoxData[
  TemplateBox[{
    Cell["res[s] > 0", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "4d49cc20-0625-e847-8c78-5f1c1b7dfeff"],
 " and not singular. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 12 \[LongDash] Variational stationarity residual\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"880c23ad-267c-a846-beb9-e3600561db34"],
 "\nEuler-Lagrange residual near zero. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 13 \[LongDash] Scale recursion consistency\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"032805f6-0b47-7745-8f2d-3573eab698bb"],
 "\nNeighboring scales transform coherently. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 14 \[LongDash] Eigenmode neutral stability\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"51c6fdf5-320b-5041-9ae6-31bd53048b46"],
 "\nLinearized operator has stable or neutrally stable target modes. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 15 \[LongDash] Undamped harmonic extraction\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"5be36dbc-8938-bb46-85e2-733e13c89ef2"],
 "\nIsolate eigenvalues satisfying: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[GothicCapitalR]", 
         RowBox[{"(", "\[Lambda]", ")"}], "\[LongEqual]", "0", ",  ", 
         "\[GothicCapitalI]", 
         RowBox[{"(", "\[Lambda]", ")"}], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Re(\\lambda)=0,\\quad \\Im(\\lambda)>0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1367649-ca2d-c54a-926b-569aabf07cd5"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 16 \[LongDash] Measurement integrability\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b0e2a025-a542-be49-96e7-cd0cc3f324ce"],
 "\nLayer 2 observable integration exists and converges. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 17 \[LongDash] Precision convergence\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d603f088-d8fc-ad47-b685-5a638f1c14d3"],
 "\nIncreasing precision does not materially change results beyond threshold. \
\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Test 18 \[LongDash] Confidence corridor admissibility\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"149e91b9-9791-154b-8e67-7c38c767d499"],
 "\nScale remains in stable/stress corridor as specified.\n\nThis is already \
a robust test architecture. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"2c831fec-3912-b64b-9302-88ac3c6a76eb"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"VI. Better computational structure for the tests\"\>", 
    "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"02962c12-4686-a147-ae70-c0062147f4dd"],
 "\nEach test should return an association like: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"<|", "\[IndentingNewLine]", "  ", 
        RowBox[{
          RowBox[{"\"Name\"", "->", "\"ClosurePhaseLock\""}], ",", 
          "\[IndentingNewLine]", "  ", 
          RowBox[{"\"Value\"", "->", "value"}], ",", "\[IndentingNewLine]", 
          "  ", 
          RowBox[{"\"Threshold\"", "->", "threshold"}], ",", 
          "\[IndentingNewLine]", "  ", 
          RowBox[{"\"Residual\"", "->", "residual"}], ",", 
          "\[IndentingNewLine]", "  ", 
          RowBox[{"\"Pass\"", "->", "passQ"}], ",", "\[IndentingNewLine]", 
          "  ", 
          RowBox[{"\"Diagnostics\"", "->", 
            RowBox[{"<|", " ", "...", " ", "|>"}]}]}], "\[IndentingNewLine]", 
        "|>"}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "f046f3f4-8517-7148-8032-2d176a6ce816"],
 "\nThis matters because later you want: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
