 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"3. State space\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a78fa6f9-a1c3-9f47-b45d-46035e8ff142"],
 "\nCore variables, for example: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"scaleState", "[", "s_", "]"}], ":=", 
        RowBox[{"<|", "\[IndentingNewLine]", "  ", 
          RowBox[{
            RowBox[{"\"InformationDensity\"", "->", 
              RowBox[{"rho", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"FieldComplexity\"", "->", 
              RowBox[{"chi", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"Resolution\"", "->", 
              RowBox[{"res", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"Curvature\"", "->", 
              RowBox[{"kappa", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"Torsion\"", "->", 
              RowBox[{"tau", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"ClosurePhase\"", "->", 
              RowBox[{"theta", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"MajorRadius\"", "->", 
              RowBox[{"rMajor", "[", "s", "]"}]}], ",", "\[IndentingNewLine]",
             "  ", 
            RowBox[{"\"MinorRadius\"", "->", 
              RowBox[{"rMinor", "[", "s", "]"}]}], ",", "\[IndentingNewLine]",
             "  ", 
            RowBox[{"\"FluxDensity\"", "->", 
              RowBox[{"phiFlux", "[", "s", "]"}]}], ",", 
            "\[IndentingNewLine]", "  ", 
            RowBox[{"\"BoundaryCoupling\"", "->", 
              RowBox[{"beta", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"DecoherenceRate\"", "->", 
              RowBox[{"gamma", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"ResonanceAmplitude\"", "->", 
              RowBox[{"aRes", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"SpectralSpread\"", "->", 
              RowBox[{"sigmaSpec", "[", "s", "]"}]}], ",", 
            "\[IndentingNewLine]", "  ", 
            RowBox[{"\"ObserverCoupling\"", "->", 
              RowBox[{"omegaObs", "[", "s", "]"}]}]}], "\[IndentingNewLine]", 
          "|>"}]}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "dbc4c364-98d2-4744-a447-c4297092166b"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. Scale action\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e527924c-3414-3549-a89b-751a76281ab6"],
 "\nYour OPF action can be extended scale-by-scale: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Rho]", 
          StyleBox["s", "TI"]], "log", 
         RowBox[{"(", 
           SubscriptBox["\[Chi]", 
            StyleBox["s", "TI"]], ")"}], "+", 
         SubscriptBox["\[Chi]", 
          StyleBox["s", "TI"]], 
         SubsuperscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["s", "TI"], "2"], "+", 
         SubscriptBox["\[Alpha]", 
          StyleBox["s", "TI"]], 
         SubsuperscriptBox["\[Kappa]", 
          StyleBox["s", "TI"], "2"], "+", 
         SubscriptBox["\[Beta]", 
          StyleBox["s", "TI"]], 
         SubsuperscriptBox["\[Tau]", 
          StyleBox["s", "TI"], "2"], "+", 
         SubscriptBox["\[Eta]", 
          StyleBox["s", "TI"]], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[Theta]", 
               StyleBox["s", "TI"]], "-", "2", "\[Pi]", 
              SubscriptBox[
               StyleBox["n", "TI"], 
               StyleBox["s", "TI"]]}], ")"}], "2"], "+", 
         SubscriptBox["\[Mu]", 
          StyleBox["s", "TI"]], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              FractionBox[
               SubscriptBox[
                StyleBox["r", "TI"], 
                RowBox[{
                  StyleBox["major", FontSlant -> "Plain"], ",", 
                  StyleBox["s", "TI"]}]], 
               SubscriptBox[
                StyleBox["r", "TI"], 
                RowBox[{
                  StyleBox["minor", FontSlant -> "Plain"], ",", 
                  StyleBox["s", "TI"]}]]], "-", "\[CurlyPhi]"}], ")"}], "2"], 
         "+", 
         SubscriptBox["\[Nu]", 
          StyleBox["s", "TI"]], 
         SubsuperscriptBox["\[Gamma]", 
          StyleBox["s", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L}_s =\n\\rho_s \\log(\\chi_s)\n+ \\chi_s R_s^2\n+ \\alpha_s \
\\kappa_s^2\n+ \\beta_s \\tau_s^2\n+ \\eta_s(\\theta_s - 2\\pi n_s)^2\n+ \
\\mu_s \\left(\\frac{r_{\\mathrm{major},s}}{r_{\\mathrm{minor},s}} - \\varphi\
\\right)^2\n+ \\nu_s \\gamma_s^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "54dd8143-4632-054e-a182-a1c00de8d576"],
