    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"c9746cb1-c091-b644-920c-858b49a99603"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Layer B \[LongDash] State representation\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c87a1521-accb-ac44-bac7-43095c1015de"],
 "\nIn Wolfram Language, we should represent each scale state as an ",
 Cell[BoxData[
  TemplateBox[{
   "Association", "paclet:ref/Association", 
    "https://reference.wolfram.com/language/ref/Association.html"},
   "TextRefLink"]],ExpressionUUID->"955956d1-8d56-4341-8a74-06cf609525ce"],
 ", because it is extensible, inspectable, and export-friendly.\n\nExample \
conceptual form: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"scaleState", "[", "s_", "]"}], ":=", 
        RowBox[{"<|", "\[IndentingNewLine]", "  ", 
          RowBox[{
            RowBox[{"\"ScaleIndex\"", "->", "s"}], ",", "\[IndentingNewLine]",
             "  ", 
            RowBox[{"\"InformationDensity\"", "->", 
              RowBox[{"rho", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"FieldComplexity\"", "->", 
              RowBox[{"chi", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"Resolution\"", "->", 
              RowBox[{"res", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"MajorRadius\"", "->", 
              RowBox[{"rMajor", "[", "s", "]"}]}], ",", "\[IndentingNewLine]",
             "  ", 
            RowBox[{"\"MinorRadius\"", "->", 
              RowBox[{"rMinor", "[", "s", "]"}]}], ",", "\[IndentingNewLine]",
             "  ", 
            RowBox[{"\"ClosurePhase\"", "->", 
              RowBox[{"theta", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"Curvature\"", "->", 
              RowBox[{"kappa", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"Torsion\"", "->", 
              RowBox[{"tau", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"Flux\"", "->", 
              RowBox[{"flux", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"Decoherence\"", "->", 
              RowBox[{"gamma", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", 
            "  ", 
            RowBox[{"\"BoundaryCoupling\"", "->", 
              RowBox[{"beta", "[", "s", "]"}]}]}], "\[IndentingNewLine]", 
          "|>"}]}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "23a926b3-17b4-8b48-a97f-d670a844b17d"],
 "\nWe should also define a whole-system state: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"systemState", ":=", 
        RowBox[{"AssociationThread", "[", 
          RowBox[{
            RowBox[{"Range", "[", "18", "]"}], ",", 
            RowBox[{"scaleState", " ", "/@", " ", 
              RowBox[{"Range", "[", "18", "]"}]}]}], "]"}]}]], "ChatCode", 
     "Input", LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "85d5b27a-5ea4-874d-bf9c-61b38074f76a"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
