 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"VII. Recommended Wolfram Language implementation \
architecture\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"6325647d-9c86-e649-ae61-c0a2b38397a0"],
 "\nWe should build this in modules. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Suggested package-like notebook sections\"\>", "Section",
