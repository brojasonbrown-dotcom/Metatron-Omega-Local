 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"1. Constants\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"28e74dae-ebf6-694c-adf3-e7630bf2a396"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"goldenRatio", "=", 
            RowBox[{
              RowBox[{"(", 
                RowBox[{"1", "+", 
                  RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}]}], 
          ";"}], "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"goldenInverse", "=", 
            RowBox[{"1", "/", "goldenRatio"}]}], ";"}], "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"goldenInverseSquared", "=", 
            RowBox[{"1", "/", 
              RowBox[{"goldenRatio", "^", "2"}]}]}], ";"}], 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"stableScaleCount", "=", "18"}], ";"}]}]], "ChatCode", 
     "Input", LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "ac6961a2-b2b7-7b44-926c-26f6a27a8c45"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"2. Domain validators\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"3494607d-6b34-fd4b-8cb5-b93aa60b7b8e"],
 "\nUse ",
 Cell[BoxData[
  TemplateBox[{
   "VerificationTest", "paclet:ref/VerificationTest", 
    "https://reference.wolfram.com/language/ref/VerificationTest.html"},
   "TextRefLink"]],ExpressionUUID->"42ad73b4-7453-f541-bba6-fae22ae3b536"],
 " and custom predicates. \n",
 Cell[BoxData[
  PaneBox[
