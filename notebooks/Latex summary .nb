           StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
        SubscriptBox["\[Integral]", 
         SubscriptBox["\[CapitalOmega]", 
          StyleBox["n", "TI"]]], 
        SubscriptBox["\[Rho]", 
         StyleBox["I", "TI"]], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["x", "TI"], ";", 
