Cell[CellGroupData[{

Cell["9. Wolfram Language-Ready Formulas", "Section",ExpressionUUID->"d92c53f7-1369-e947-9d16-28307051f76e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "temporalCoherence", ",", "driftMetric", ",", "memoryStep", ",", 
     "reflectionStep", ",", "stabilityScore", ",", "makeState"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"temporalCoherence", "[", 
     RowBox[{"state1_", ",", "state2_"}], "]"}], ":=", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"state1", " ", ".", " ", 
       RowBox[{"Conjugate", "[", "state2", "]"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Norm", "[", "state1", "]"}], " ", 
        RowBox[{"Norm", "[", "state2", "]"}]}], "+", 
       RowBox[{"10", "^", 
        RowBox[{"-", "12"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"driftMetric", "[", 
     RowBox[{"state_", ",", "ideal_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"state", "-", "ideal"}], "]"}], "^", "2"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"memoryStep", "[", 
     RowBox[{
     "state_", ",", "memory_", ",", "input_", ",", "alpha_", ",", "gamma_", ",",
       "delta_", ",", "lambda_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nextState", ",", "nextMemory"}], "}"}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"nextState", "=", 
        RowBox[{
         RowBox[{"alpha", " ", "state"}], "+", 
         RowBox[{"gamma", " ", "input"}], "+", 
         RowBox[{"delta", " ", "memory"}]}]}], ";", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"nextMemory", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "lambda"}], ")"}], " ", "memory"}], "+", 
         RowBox[{"lambda", " ", "state"}]}]}], ";", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<State\>\"", "->", "nextState"}], ",", 
         RowBox[{"\"\<Memory\>\"", "->", "nextMemory"}]}], "|>"}]}]}], 
     "\[IndentingNewLine]", "  ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"reflectionStep", "[", 
     RowBox[{
     "state_", ",", "memory_", ",", "input_", ",", "alpha_", ",", "zeta_", ",",
       "lambda_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"predicted", ",", "nextState", ",", "nextMemory"}], "}"}], ",",
       "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"predicted", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"state", "+", "memory"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"nextState", "=", 
        RowBox[{
         RowBox[{"alpha", " ", "state"}], "+", 
         RowBox[{"zeta", " ", 
          RowBox[{"(", 
           RowBox[{"predicted", "-", "state"}], ")"}]}], "+", "input"}]}], ";",
        "\[IndentingNewLine]", "    ", 
       RowBox[{"nextMemory", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "lambda"}], ")"}], " ", "memory"}], "+", 
         RowBox[{"lambda", " ", "state"}]}]}], ";", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<State\>\"", "->", "nextState"}], ",", 
         RowBox[{"\"\<Memory\>\"", "->", "nextMemory"}], ",", 
         RowBox[{"\"\<Predicted\>\"", "->", "predicted"}]}], "|>"}]}]}], 
     "\[IndentingNewLine]", "  ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stabilityScore", "[", 
     RowBox[{
     "coherence_", ",", "closure_", ",", "drift_", ",", "dissipation_", ",", 
      RowBox[{"weights_", ":", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"weights", " ", ".", " ", 
     RowBox[{"{", 
      RowBox[{"coherence", ",", "closure", ",", 
       RowBox[{"-", "drift"}], ",", 
       RowBox[{"-", "dissipation"}]}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeState", "[", 
    RowBox[{
    "informationDensity_", ",", "coherence_", ",", "closure_", ",", "phase_", 
     ",", "memory_", ",", "burden_"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<InformationDensity\>\"", "->", "informationDensity"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Coherence\>\"", "->", "coherence"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Closure\>\"", "->", "closure"}], ",", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"\"\<Phase\>\"", "->", "phase"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<Memory\>\"", "->", "memory"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<Burden\>\"", "->", "burden"}]}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]}], "Input",ExpressionUUID->"5088b879-8e7b-9141-8b78-\
7b74ad628e05"],

Cell[CellGroupData[{

Cell["Golden-angle scan test", "Subsection",ExpressionUUID->"0d29977f-5d40-734b-bfbe-892646a74fa4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"goldenOmega", "=", 
