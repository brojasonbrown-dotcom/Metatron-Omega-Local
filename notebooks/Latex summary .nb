        RowBox[{"(", 
          StyleBox["x", "TI"], ")"}], "\[DifferentialD]", 
        StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
    "b_t^{(n)} = \\int_{\\Omega_n} \\rho_I(x;n)\\, w_n(x)\\, dx", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"b44687d5-201a-b646-8c22-17c4cc72b41d"]], \
"Text",ExpressionUUID->"fdee3f2e-4a1d-4443-ac38-f4ced62c5ac7"]
