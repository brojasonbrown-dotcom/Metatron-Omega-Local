Cell[CellGroupData[{

Cell["4. Formal Ontology and Axioms", "Section",ExpressionUUID->"668f3ee2-6f42-a347-9e8b-f75f61d07f71"],

Cell[CellGroupData[{

Cell["Primitive Ontology", "Subsection",ExpressionUUID->"f1407dd6-5efd-e546-92da-ac37f3e5f3d8"],

Cell[TextData[{
 "The primitive substrate is modeled as a timeless field of logical-geometric \
possibility. Realized physical structure is the stabilized trace produced \
through recursive lawful measurement: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalOmega]", 
          StyleBox["poss", FontSlant -> "Plain"]], 
         OverscriptBox[
         "\[LongRightArrow]", "\\mbox{recursive lawful measurement}"], 
         SubscriptBox["\[CapitalOmega]", 
          StyleBox["realized", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Omega_{\\mathrm{poss}} \\xrightarrow{\\text{recursive lawful \
measurement}} \\Omega_{\\mathrm{realized}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "513365fb-155b-964f-9485-d18b645c792d"]
}], "Text",ExpressionUUID->"50f99510-0cff-5b4e-ad16-b01278938031"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Working Interpretation", "Subsection",ExpressionUUID->"d1496dca-38f3-e24b-9b8c-7a4e5a294837"],

Cell["\<\
RHUFT is presently best modeled as a hybrid ontology combining: \
\>", "Text",ExpressionUUID->"61bc221f-1b90-8d49-8f7a-3db410f25571"],

Cell["information-first distinction structure", "Item",ExpressionUUID->"e04bf4ba-46c1-0345-aafa-a2f2872f8a58"],

Cell["geometry-first constraint structure", "Item",ExpressionUUID->"f6e1fadc-6386-8e4a-93df-2397b3dbe862"],

Cell["relation-network dynamics across scale", "Item",ExpressionUUID->"9d1aac1b-412a-6a48-b904-67b76893a191"],

Cell["\<\
measurable fields as stabilized expressions of deeper recursive logic\
\>", "Item",ExpressionUUID->"1061cc98-373d-734a-822d-3b86cbb6ac4a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Core Axioms", "Subsection",ExpressionUUID->"c2513de9-e51c-1e47-a7f5-9616af7c2b15"],

Cell[TextData[{
 "1. ",
 StyleBox["Existence:",
  FontWeight->Bold],
 " existence is stabilization at scale."
}], "Text",ExpressionUUID->"efcf46b5-6258-7b48-8ac3-52ce5f92a7a1"],

Cell[TextData[{
 "2. ",
 StyleBox["Closure:",
  FontWeight->Bold],
 " realized systems persist through recursive closure."
}], "Text",ExpressionUUID->"7df9121c-c335-6f4c-aec6-cd18fb1dc08b"],

Cell[TextData[{
 "3. ",
 StyleBox["Scale coupling:",
  FontWeight->Bold],
 " lower-scale structures aggregate upward; higher-scale structures constrain \
downward."
}], "Text",ExpressionUUID->"72832603-9bde-4c46-9881-69a4395047c1"],

Cell[TextData[{
 "4. ",
 StyleBox["Time:",
  FontWeight->Bold],
 " time is the ordered trace of recursive stabilization."
}], "Text",ExpressionUUID->"e2b065cb-e8b7-f44f-a74c-99e263ab3b68"],

Cell[TextData[{
 "5. ",
 StyleBox["Memory:",
  FontWeight->Bold],
 " continuity requires retained traces of prior measurement."
}], "Text",ExpressionUUID->"25e135e6-30f4-4043-a596-ad8435d34415"],

Cell[TextData[{
 "6. ",
 StyleBox["Matter:",
  FontWeight->Bold],
 " matter is a high-persistence, high-closure stabilization regime."
}], "Text",ExpressionUUID->"d9c23dd6-4414-984a-ad8f-1652adb804db"],

Cell[TextData[{
 "7. ",
 StyleBox["Consciousness:",
  FontWeight->Bold],
 " consciousness requires sufficiently rich recursive self-measurement, \
continuity, memory, and information integration. "
}], "Text",ExpressionUUID->"856ae71e-fb5f-004e-805e-ed039323f91f"],

