Cell[CellGroupData[{

Cell["7. Candidate Master Equations", "Section",ExpressionUUID->"b6e8ee16-66f0-4947-85d8-f357665e3f02"],

Cell[CellGroupData[{

Cell["7.1 Local recursive update", "Subsection",ExpressionUUID->"fbc15fe0-bb1b-6648-945a-3fdaf04d4a61"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox["\[Psi]", 
         RowBox[{
           StyleBox["t", "TI"], "+", "1"}], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["N", "TI"], 
         StyleBox["n", "TI"]], 
        RowBox[{"[", 
          RowBox[{
            SubscriptBox["\[Alpha]", 
             StyleBox["n", "TI"]], 
            SubsuperscriptBox["\[Psi]", 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], "+", 
            SubscriptBox["\[Beta]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["G", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              RowBox[{
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]], ",", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]]}], "]"}], "+", 
            SubscriptBox["\[Gamma]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["P", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["i", "TI"], 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]], ",", 
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]]}], "]"}], "+", 
            SubscriptBox["\[Delta]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["R", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["m", "TI"], 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]], ",", 
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]]}], "]"}], "+", 
            SubscriptBox["\[Epsilon]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["C", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              RowBox[{
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]], ",", 
                SubsuperscriptBox[
                 StyleBox["l", "TI"], 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]]}], "]"}], "+", 
            SubscriptBox["\[Zeta]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["S", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              RowBox[{
                SubsuperscriptBox[
                 OverscriptBox["\[Psi]", "^"], 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]], ",", 
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]]}], "]"}], "+", 
            SubscriptBox["\[Eta]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["B", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              SubsuperscriptBox["\[Psi]", 
               StyleBox["t", "TI"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["n", "TI"], "+", "1"}], ")"}]], "]"}], "+", 
            SubscriptBox["\[Mu]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["A", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              SubsuperscriptBox["\[Psi]", 
               StyleBox["t", "TI"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["n", "TI"], "-", "1"}], ")"}]], "]"}]}], "]"}]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "\\psi_{t+1}^{(n)} = N_n\\Big[\n\\alpha_n \\psi_t^{(n)}\n+ \\beta_n \
G_n[\\psi_t^{(n)}, g_t^{(n)}]\n+ \\gamma_n P_n[i_t^{(n)}, \\psi_t^{(n)}]\n+ \
\\delta_n R_n[m_t^{(n)}, \\psi_t^{(n)}]\n+ \\epsilon_n C_n[\\psi_t^{(n)}, \
l_t^{(n)}]\n+ \\zeta_n S_n[\\hat{\\psi}_t^{(n)}, \\psi_t^{(n)}]\n+ \\eta_n \
B_n[\\psi_t^{(n+1)}]\n+ \\mu_n A_n[\\psi_t^{(n-1)}]\n\\Big]", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"b7d83337-f4a6-2942-9e9c-8606dc3fd23b"]], \
"Text",ExpressionUUID->"e8eeded1-0da5-a145-92c2-6044e6c2963e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2 Self-model update", "Subsection",ExpressionUUID->"b44a1b80-870d-9f4d-a7c8-57b2a810fb46"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox[
         OverscriptBox["\[Psi]", "^"], 
         RowBox[{
           StyleBox["t", "TI"], "+", "1"}], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["H", "TI"], 
         StyleBox["n", "TI"]], 
        RowBox[{"(", 
          RowBox[{
            SubsuperscriptBox[
             OverscriptBox["\[Psi]", "^"], 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox[
             StyleBox["m", "TI"], 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox["\[Psi]", 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox[
             StyleBox["i", "TI"], 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]]}], ")"}]}], TraditionalForm], 
    "errors" -> {}, "input" -> 
    "\\hat{\\psi}_{t+1}^{(n)} = H_n\\big(\\hat{\\psi}_t^{(n)}, m_t^{(n)}, \
\\psi_t^{(n)}, i_t^{(n)}\\big)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"9ed22d84-94c2-d042-bde2-043c88c10338"]], \
"Text",ExpressionUUID->"b21f0819-4616-dc4d-aabb-8ac1e9277108"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.3 Memory update", "Subsection",ExpressionUUID->"8d2dfe90-b04c-154d-a016-d91e204e4576"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox[
         StyleBox["m", "TI"], 
         RowBox[{
           StyleBox["t", "TI"], "+", "1"}], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["U", "TI"], 
         StyleBox["n", "TI"]], 
        RowBox[{"(", 
          RowBox[{
            SubsuperscriptBox[
             StyleBox["m", "TI"], 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox["\[Psi]", 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox[
             OverscriptBox["\[Psi]", "^"], 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox["\[Psi]", 
             RowBox[{
               StyleBox["t", "TI"], "+", "1"}], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]]}], ")"}]}], TraditionalForm], 
    "errors" -> {}, "input" -> 
    "m_{t+1}^{(n)} = U_n\\big(m_t^{(n)}, \\psi_t^{(n)}, \\hat{\\psi}_t^{(n)}, \
\\psi_{t+1}^{(n)}\\big)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"7bf52d1e-47f5-ab49-8496-0b4e671d7110"]], \
"Text",ExpressionUUID->"3b764907-9a3d-3a4b-b077-b18b6512c459"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.4 Drift metric", "Subsection",ExpressionUUID->"1a7cf73b-9e26-1042-8c47-82f9ca5709fd"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox[
         StyleBox["d", "TI"], 
         StyleBox["t", "TI"], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], "\[LongEqual]", "||", 
        SubsuperscriptBox["\[Psi]", 
         StyleBox["t", "TI"], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], "-", 
        SubsuperscriptBox["\[Psi]", 
         StyleBox["t", "TI"], 
         RowBox[{"*", "(", 
           StyleBox["n", "TI"], ")"}]], 
        SuperscriptBox["||", "2"]}], TraditionalForm], "errors" -> {}, 
    "input" -> "d_t^{(n)} = \\lVert \\psi_t^{(n)} - \\psi_t^{*(n)} \\rVert^2",
     "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"5402179c-29af-6748-a879-e1c17158612a"]], \
"Text",ExpressionUUID->"a8f36c32-018f-344b-8129-c5a5811c9c6f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.5 Temporal coherence", "Subsection",ExpressionUUID->"30dda665-a287-8149-9171-3df332597414"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox[
         StyleBox["c", "TI"], 
         StyleBox["time", FontSlant -> "Plain"], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], 
        RowBox[{"(", 
          StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
        FractionBox[
         TemplateBox[{
           RowBox[{
             RowBox[{"\[LeftAngleBracket]", 
               RowBox[{
                 SubsuperscriptBox["\[Psi]", 
                  StyleBox["t", "TI"], 
                  RowBox[{"(", 
                    StyleBox["n", "TI"], ")"}]], ",", 
                 SubsuperscriptBox["\[Psi]", 
                  RowBox[{
                    StyleBox["t", "TI"], "+", "1"}], 
                  RowBox[{"(", 
                    StyleBox["n", "TI"], ")"}]]}], 
               "\[RightAngleBracket]"}]}]}, "Abs"], 
         RowBox[{"||", 
           SubsuperscriptBox["\[Psi]", 
            StyleBox["t", "TI"], 
            RowBox[{"(", 
              StyleBox["n", "TI"], ")"}]], "||||", 
           SubsuperscriptBox["\[Psi]", 
            RowBox[{
              StyleBox["t", "TI"], "+", "1"}], 
            RowBox[{"(", 
              StyleBox["n", "TI"], ")"}]], "||", "+", "\[Epsilon]"}]]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "c_{\\mathrm{time}}^{(n)}(t) =\n\\frac{|\\langle \\psi_t^{(n)}, \
\\psi_{t+1}^{(n)} \\rangle|}\n{\\lVert \\psi_t^{(n)} \\rVert \\lVert \
\\psi_{t+1}^{(n)} \\rVert + \\varepsilon}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"2c2e014d-a50f-9a4d-85cd-85efe1cc20a5"]], \
"Text",ExpressionUUID->"76736465-27b4-954e-804c-b8b20fe170b3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.6 Closure score", "Subsection",ExpressionUUID->"7e83ee3c-a2e3-6f44-ac68-6dc4898abe85"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox["\[Kappa]", 
         StyleBox["t", "TI"]], "\[LongEqual]", 
        FractionBox[
         RowBox[{
           UnderscriptBox["\[Sum]", 
            RowBox[{
              StyleBox["i", "TI"], ",", 
              StyleBox["j", "TI"], "\[Element]", "\[CapitalOmega]"}], 
            LimitsPositioning -> True], "|", 
           SubscriptBox[
            StyleBox["w", "TI"], 
            RowBox[{
              StyleBox["i", "TI"], 
              StyleBox["j", "TI"]}]], "|"}], 
         RowBox[{
           UnderscriptBox["\[Sum]", 
            RowBox[{
              StyleBox["i", "TI"], "\[Element]", "\[CapitalOmega]", ",", 
              StyleBox["j", "TI"], "\[Element]", 
              StyleBox["all", FontSlant -> "Plain"]}], LimitsPositioning -> 
            True], "|", 
           SubscriptBox[
            StyleBox["w", "TI"], 
            RowBox[{
              StyleBox["i", "TI"], 
              StyleBox["j", "TI"]}]], "|", "+", "\[Epsilon]"}]]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "\\kappa_t =\n\\frac{\\sum_{i,j \\in \\Omega} |w_{ij}|}\n{\\sum_{i \\in \
\\Omega, j \\in \\mathrm{all}} |w_{ij}| + \\varepsilon}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"8ebb0fd3-753c-d24d-9f26-224e8763a92d"]], \
"Text",ExpressionUUID->"95658a1d-4f5d-354f-b92c-83737cf0ad36"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.7 Information density", "Subsection",ExpressionUUID->"325bbe46-157e-0e4e-9b91-3db235220b25"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox["\[Rho]", 
         StyleBox["I", "TI"]], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["x", "TI"], ";", 
            StyleBox["n", "TI"]}], ")"}], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["a", "TI"], "1"], 
        StyleBox["H", "TI"], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["x", "TI"], ";", 
            StyleBox["n", "TI"]}], ")"}], "+", 
        SubscriptBox[
         StyleBox["a", "TI"], "2"], 
        StyleBox["R", "TI"], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["x", "TI"], ";", 
            StyleBox["n", "TI"]}], ")"}], "+", 
        SubscriptBox[
         StyleBox["a", "TI"], "3"], 
        StyleBox["K", "TI"], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["x", "TI"], ";", 
            StyleBox["n", "TI"]}], ")"}], "+", 
        SubscriptBox[
         StyleBox["a", "TI"], "4"], 
        StyleBox["S", "TI"], 
        RowBox[{"(", 
          RowBox[{
            StyleBox["x", "TI"], ";", 
            StyleBox["n", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {}, 
    "input" -> 
    "\\rho_I(x;n) = a_1 \\mathcal{H}(x;n) + a_2 \\mathcal{R}(x;n) + a_3 \
\\mathcal{K}(x;n) + a_4 \\mathcal{S}(x;n)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"7a3a3e78-586a-f847-993b-f665808dacc6"]], \
"Text",ExpressionUUID->"8aee5acf-2ef7-634e-801b-09df283a2507"]
}, Open  ]],

