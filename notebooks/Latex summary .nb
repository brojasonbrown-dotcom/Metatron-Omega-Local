Cell["4. state variables and operators", "Text",ExpressionUUID->"f49d8f64-cf31-7a40-9ad2-74bbe3a7eb27"],

Cell["5. candidate equations", "Text",ExpressionUUID->"c3c7e3fd-fc21-584b-872b-c30d49ec7a5e"],

Cell["6. test classes", "Text",ExpressionUUID->"155a604d-3160-ec40-a8fd-2dbd15da88a6"],

