Cell[CellGroupData[{

Cell["Composite Measurement Operator", "Subsection",ExpressionUUID->"36a177a5-de19-de44-b5ca-af9fedb77d2d"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["M", "TI"], 
         StyleBox["n", "TI"]], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["U", "TI"], 
         StyleBox["n", "TI"]], "\[EmptySmallCircle]", 
        SubscriptBox[
         StyleBox["S", "TI"], 
         StyleBox["n", "TI"]], "\[EmptySmallCircle]", 
        SubscriptBox[
         StyleBox["Q", "TI"], 
         StyleBox["n", "TI"]], "\[EmptySmallCircle]", 
        SubscriptBox[
         StyleBox["R", "TI"], 
         StyleBox["n", "TI"]], "\[EmptySmallCircle]", 
        SubscriptBox[
         StyleBox["P", "TI"], 
         StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
    "M_n = U_n \\circ S_n \\circ Q_n \\circ R_n \\circ P_n", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"ace8d942-5aae-5344-8f9c-2cbe23dbe5b0"]], \
"Text",ExpressionUUID->"ba238229-c631-b34f-a5b1-181ec5f9da54"],

