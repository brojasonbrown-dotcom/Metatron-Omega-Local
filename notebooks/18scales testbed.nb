Cell[CellGroupData[{

Cell["11. Full symbolic morphism pipeline L0 -> L1 -> L2", "Section",ExpressionUUID->"12fd7ed2-d7ed-6b43-ad2b-544cb2b8bfba"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"d2c35a77-4d37-d046-9d86-b713631df02c"],

Cell["\<\
This section exposes the requested compositional pipeline as callable \
functions. \
\>", "Text",ExpressionUUID->"89143614-acd3-f645-bb0a-55f4b331a562"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "layer0Map", ",", "layer1Map", ",", "layer2Map", ",", 
     "fullScalePipeline"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer0Map", "[", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<Geometry\>\"", "->", "\"\<Sphere\>\""}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<BoundaryDuality\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "Infinity"}], "}"}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"\"\<TemporalMode\>\"", "->", "\"\<Timeless\>\""}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<Substrate\>\"", "->", "\"\<EmptySpacetime\>\""}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer1Map", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"scaleSpectralData", "[", "n", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer2Map", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"rho_", "?", "NumericQ"}], ",", 
      RowBox[{"chi_", "?", "NumericQ"}], ",", 
      RowBox[{"res_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"\"\<Observable00\>\"", "->", 
       RowBox[{"measurementKernel", "[", 
        RowBox[{
        "rho", ",", "chi", ",", "res", ",", "0", ",", "0", ",", "0", ",", "0",
          ",", "50"}], "]"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<Observable10\>\"", "->", 
       RowBox[{"measurementKernel", "[", 
        RowBox[{
        "rho", ",", "chi", ",", "res", ",", "1", ",", "0", ",", "0", ",", "0",
          ",", "50"}], "]"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fullScalePipeline", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"rho_", "?", "NumericQ"}], ",", 
     RowBox[{"chi_", "?", "NumericQ"}], ",", 
     RowBox[{"res_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l0", ",", "l1", ",", "l1Golden", ",", "l2"}], "}"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"l0", "=", 
       RowBox[{"layer0Map", "[", "]"}]}], ";", "\[IndentingNewLine]", "   ", 
      RowBox[{"l1", "=", 
       RowBox[{"layer1Map", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"l1Golden", "=", 
       RowBox[{"enforceGoldenStability", "[", "l1", "]"}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"l1Golden", "[", "\"\<GoldenAlignedQ\>\"", "]"}], "]"}]}], ",",
         "\[IndentingNewLine]", "      ", 
        RowBox[{"MessageDialog", "[", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Scale \>\"", ",", "n", 
            ",", "\"\< violates strict golden alignment under adjacent-bond \
test.\>\""}], "}"}], "]"}], "]"}]}], "\[IndentingNewLine]", "   ", "]"}], ";",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"l2", "=", 
       RowBox[{"layer2Map", "[", 
        RowBox[{"n", ",", "rho", ",", "chi", ",", "res"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<L0\>\"", "->", "l0"}], ",", 
        RowBox[{"\"\<L1\>\"", "->", "l1Golden"}], ",", 
        RowBox[{"\"\<L2\>\"", "->", "l2"}]}], "|>"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"372f37f7-543d-7144-bbc3-0010cea36b4f"],

