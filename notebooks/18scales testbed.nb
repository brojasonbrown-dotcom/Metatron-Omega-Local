Cell[CellGroupData[{

Cell["9. Linearized operator and stable-frequency extraction", "Section",ExpressionUUID->"e086fdb9-3dae-b549-9c51-d3fc64451583"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"0e1bdc13-2591-cd43-9734-b0f3b3fe046d"],

Cell[TextData[{
 "This section constructs a surrogate stiffness matrix for the three OPF \
field components and extracts undamped harmonic modes according to the \
requested criterion ",
 Cell[BoxData[Cell["Re[lambda] == 0 && Im[lambda] > 0",
   Background->None,ExpressionUUID->"48b14091-5d58-744a-8f8f-9f90af579eca"]], 
  "InlineCode",ExpressionUUID->"57c2113b-f381-2542-bfd3-841af7feae53"],
 ". "
}], "Text",ExpressionUUID->"fd25d91b-1309-3c41-9df0-93236e1e3c08"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"fieldStiffnessMatrix", ",", "stableFrequencies"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fieldStiffnessMatrix", "[", 
     RowBox[{"n_Integer", ",", "k_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"base", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"scaleBaseFrequency", "[", "n", "]"}], " ", 
           RowBox[{"octaveFrequencyFactor", "[", "k", "]"}]}], ",", "80"}], 
         "]"}]}], "}"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"{", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"I", " ", "base"}], ",", "0"}], "}"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "I"}], " ", "base"}], ",", "0", ",", 
          RowBox[{"I", " ", 
           RowBox[{"base", "/", "phi"}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"base", "/", "phi"}]}], ",", "0"}], "}"}]}], 
       "\[IndentingNewLine]", "   ", "}"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stableFrequencies", "[", 
     RowBox[{"n_Integer", ",", "k_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"{", "evals", "}"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"evals", "=", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"fieldStiffnessMatrix", "[", 
          RowBox[{"n", ",", "k"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]",
        "   ", 
       RowBox[{"Select", "[", 
        RowBox[{"evals", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Chop", "[", 
             RowBox[{
              RowBox[{"Re", "[", "#", "]"}], ",", 
              RowBox[{"10", "^", 
               RowBox[{"-", "30"}]}]}], "]"}], "==", "0"}], "&&", 
           RowBox[{
            RowBox[{"Im", "[", "#", "]"}], ">", "0"}]}], " ", "&"}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stableFrequencyAudit", "=", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"Flatten", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"<|", "\[IndentingNewLine]", "         ", 
          RowBox[{
           RowBox[{"\"\<Scale\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
           "         ", 
           RowBox[{"\"\<Octave\>\"", "->", "k"}], ",", "\[IndentingNewLine]", 
           "         ", 
           RowBox[{"\"\<StableEigenvalues\>\"", "->", 
            RowBox[{"stableFrequencies", "[", 
             RowBox[{"n", ",", "k"}], "]"}]}]}], "\[IndentingNewLine]", 
          "      ", "|>"}], ",", "\[IndentingNewLine]", "      ", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"Take", "[", 
            RowBox[{"stableScaleIndices", ",", "4"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "4"}], "}"}]}], "\[IndentingNewLine]", 
        "   ", "]"}], ",", "\[IndentingNewLine]", "   ", "1"}], 
      "\[IndentingNewLine]", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "stableFrequencyAudit"}], \
"Input",ExpressionUUID->"addace3c-713e-7e4a-a6ca-a8097f728430"],

