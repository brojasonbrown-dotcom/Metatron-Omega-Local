Cell[CellGroupData[{

Cell["15. Interactive control panel with sliders", "Section",ExpressionUUID->"83ed3cd3-7016-e748-8e8e-0dba5d7d09fe"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"2d744222-9930-d64f-b1b0-b5fdeae0472c"],

Cell["\<\
This section provides interactive exploration of scale, octave, field values, \
closure score, eigenmodes, and measurement output. \
\>", "Text",ExpressionUUID->"66668a02-e8fc-c64a-b33b-99bc60219369"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"spectral", "=", 
        RowBox[{"scaleSpectralData", "[", "n", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"stiff", "=", 
        RowBox[{"fieldStiffnessMatrix", "[", 
         RowBox[{"n", ",", "k"}], "]"}]}], ",", "\[IndentingNewLine]", "    ",
        "evals", ",", "\[IndentingNewLine]", "    ", "meas", ",", 
       "\[IndentingNewLine]", "    ", "aligned"}], "\[IndentingNewLine]", 
      "   ", "}"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"evals", "=", 
       RowBox[{"Eigenvalues", "[", "stiff", "]"}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"meas", "=", 
       RowBox[{"measurementKernel", "[", 
        RowBox[{
        "rhoValue", ",", "chiValue", ",", "resValue", ",", "0", ",", "0", ",",
          "0", ",", "0", ",", "40"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"aligned", "=", 
       RowBox[{"goldenAlignedQ", "[", 
        RowBox[{"spectral", ",", "tol"}], "]"}]}], ";", "\[IndentingNewLine]",
       "   ", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "     ", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<OPF Hypercomplete Scale Diagnostic\>\"", ",", "16", ",",
            "Bold"}], "]"}], ",", "\[IndentingNewLine]", "     ", 
         RowBox[{"Dataset", " ", "@", " ", 
          RowBox[{"<|", "\[IndentingNewLine]", "       ", 
           RowBox[{
            RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", 
            "\[IndentingNewLine]", "       ", 
            RowBox[{"\"\<OctaveIndex\>\"", "->", "k"}], ",", 
            "\[IndentingNewLine]", "       ", 
            RowBox[{"\"\<ClosureResidual\>\"", "->", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"closureResidual", "[", "n", "]"}], ",", "30"}], 
              "]"}]}], ",", "\[IndentingNewLine]", "       ", 
            RowBox[{"\"\<ClosureScore\>\"", "->", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"closureScore", "[", "n", "]"}], ",", "30"}], "]"}]}], 
            ",", "\[IndentingNewLine]", "       ", 
            RowBox[{"\"\<ExpectedStableQ\>\"", "->", 
             RowBox[{"MemberQ", "[", 
              RowBox[{"stableScaleIndices", ",", "n"}], "]"}]}], ",", 
            "\[IndentingNewLine]", "       ", 
            RowBox[{"\"\<GoldenAlignedQ\>\"", "->", "aligned"}], ",", 
            "\[IndentingNewLine]", "       ", 
            RowBox[{"\"\<MeasurementObservable\>\"", "->", "meas"}]}], 
           "\[IndentingNewLine]", "     ", "|>"}]}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Eigenvalues: \>\"", ",", "evals"}], "}"}], "]"}], ",",
          "\[IndentingNewLine]", "     ", 
         RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", "       ", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{
             RowBox[{"Values", "[", 
              RowBox[{"spectral", "[", "\"\<OctaveModes\>\"", "]"}], "]"}], 
             ",", "\"\<AbsoluteFrequency\>\""}], "]"}], ",", 
           "\[IndentingNewLine]", "       ", 
           RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
           "\[IndentingNewLine]", "       ", 
           RowBox[{"PlotLabel", "->", "\"\<Absolute octave frequencies\>\""}],
            ",", "\[IndentingNewLine]", "       ", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<Octave\>\"", ",", "\"\<Frequency\>\""}], "}"}]}]}], 
          "\[IndentingNewLine]", "     ", "]"}]}], "\[IndentingNewLine]", 
        "   ", "}"}], "]"}]}]}], "\[IndentingNewLine]", " ", "]"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "13", ",", "\"\<Scale\>\""}], "}"}], ",", "0", ",", 
     RowBox[{
      RowBox[{"opfConfig", "[", "\"\<TotalScales\>\"", "]"}], "-", "1"}], ",",
      "1"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "\"\<Octave\>\""}], "}"}], ",", "1", ",", 
     RowBox[{"opfConfig", "[", "\"\<OctavesPerScale\>\"", "]"}], ",", "1"}], 
    "}"}], ",", "\[IndentingNewLine]", " ", "Delimiter", ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rhoValue", ",", "1.2", ",", "\"\<rho\>\""}], "}"}], ",", "0.1",
      ",", "5", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"chiValue", ",", "2.1", ",", "\"\<chi\>\""}], "}"}], ",", "0.1",
      ",", "5", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"resValue", ",", "0.8", ",", "\"\<resolution\>\""}], "}"}], ",",
      "0.01", ",", "5", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tol", ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}], ",", "\"\<golden tolerance\>\""}], "}"}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "12"}]}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "3"}]}], ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"SaveDefinitions", "->", "True"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"30255f25-6e5d-404b-96d6-263d6560db7a"],

