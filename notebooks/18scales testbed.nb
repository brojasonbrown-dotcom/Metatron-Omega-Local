Cell[CellGroupData[{

Cell["18. Notes on computational limits", "Section",ExpressionUUID->"58b6c85b-2c30-9440-bdf5-0590457a5227"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"db0578b2-d08b-3245-bc64-088a7952d9bf"],

Cell["\<\
This section documents practical substitutions for impossible directives. \
\>", "Text",ExpressionUUID->"f29ace27-11ce-ad48-8c26-abb832c97352"],

Cell["Exact symbolic evaluation is used where available.", "Item",ExpressionUUID->"f5a5d660-6e30-3b4a-a163-3e92e9991ceb"],

Cell[TextData[{
 "Numerical integration uses large ",
 StyleBox["finite",
  FontWeight->Bold],
 " ",
 ButtonBox["WorkingPrecision",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/WorkingPrecision"],
 ", because ",
 Cell[BoxData[
  RowBox[{"WorkingPrecision", "->", "Infinity"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "2f6ce3e1-da8e-aa4b-8a42-e3d525d40904"],
 " is not a valid computational setting."
}], "Item",ExpressionUUID->"a18e08ee-bb95-8d41-bdf8-f5ac2659e3f2"],

Cell[TextData[{
 "The full dense Hamiltonian of size ",
 Cell[BoxData[Cell["83052 x 83052",
   Background->None,ExpressionUUID->"a9b7542d-0e61-f341-84ca-6f3d7e581153"]], 
  "InlineCode",ExpressionUUID->"93adf53e-e544-1142-a308-955f2625c717"],
 " per stable block is not materialized here; instead, the notebook uses ",
 StyleBox["counting formulas",
  FontWeight->Bold],
 ", ",
 StyleBox["surrogate block operators",
  FontWeight->Bold],
 ", and ",
 StyleBox["Kronecker-structured abstractions",
  FontWeight->Bold],
 "."
}], "Item",ExpressionUUID->"ff08eb09-9a3a-a74f-bf9a-79de26cafbc3"],

Cell[TextData[{
 "The notebook is designed as a ",
 StyleBox["research scaffold",
  FontWeight->Bold],
 " for extension rather than a claim of validated physical theory."
}], "Item",ExpressionUUID->"c36bb781-728c-5545-b2f5-4d5a901aa1d2"],

