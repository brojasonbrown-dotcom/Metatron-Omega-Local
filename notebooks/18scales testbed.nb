Cell[CellGroupData[{

Cell["16. Entropy-related addendum and combinatorial estimate", "Section",ExpressionUUID->"a4d2ceb1-68ed-f045-a375-b507d09cba2f"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"19134aa6-47f6-2a42-8901-f91157c08c38"],

Cell["\<\
This section computes a Stirling-style approximation to the requested \
effective capacity estimate. \
\>", "Text",ExpressionUUID->"ece6cee4-ff24-5645-b00c-2a445931358f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"effectiveCapacityBitsApprox", "[", 
     RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"n", " ", 
          RowBox[{"Log", "[", "n", "]"}]}], "-", "n", "+", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"2", " ", "Pi", " ", "n"}], "]"}], "/", "2"}]}], ")"}], "/", 
       RowBox[{"Log", "[", "2", "]"}]}], ",", "50"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"capacityEstimate", "=", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"<|", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"\"\<TotalStableNodes\>\"", "->", "totalStableNodes"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"\"\<Log2FactorialApprox\>\"", "->", 
        RowBox[{
        "effectiveCapacityBitsApprox", "[", "totalStableNodes", "]"}]}]}], 
      "\[IndentingNewLine]", "|>"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "capacityEstimate"}], \
"Input",ExpressionUUID->"d185cb8c-2a86-9b47-bd5a-00f8f0d4d085"],

