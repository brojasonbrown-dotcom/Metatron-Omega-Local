Cell[CellGroupData[{

Cell["10. Measurement kernel for Layer-2 observables", "Section",ExpressionUUID->"1b0b40ca-2f2b-9a4a-8489-c897117164e0"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"c9f57fae-6b75-c547-b279-4e4b1c008e4a"],

Cell["\<\
This section creates a simple measurement kernel consistent with the \
requested L2 mapping, using basis expansions and numerical integration over \
compact coordinates. \
\>", "Text",ExpressionUUID->"ef6f4533-5be7-0944-b14b-66c6691b76d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"psiMode", ",", "measurementKernel"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"psiMode", "[", 
     RowBox[{
     "r_", ",", "theta_", ",", "phiAngle_", ",", "u_", ",", "v_", ",", "rho_",
       ",", "chi_", ",", "res_", ",", "l_Integer", ",", "mm_Integer", ",", 
      "mt_Integer", ",", "nt_Integer"}], "]"}], ":=", "\[IndentingNewLine]", 
    "   ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"rho", " ", 
        RowBox[{"Log", "[", "chi", "]"}]}], "+", 
       RowBox[{"chi", " ", 
        RowBox[{"res", "^", "2"}]}]}], ")"}], "*", 
     RowBox[{"SphericalHarmonicY", "[", 
      RowBox[{"l", ",", "mm", ",", "theta", ",", "phiAngle"}], "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"mt", " ", "u"}], "+", 
         RowBox[{"nt", " ", "v"}]}], ")"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measurementKernel", "[", 
     RowBox[{
      RowBox[{"rho_", "?", "NumericQ"}], ",", 
      RowBox[{"chi_", "?", "NumericQ"}], ",", 
      RowBox[{"res_", "?", "NumericQ"}], ",", "l_Integer", ",", "mm_Integer", 
      ",", "mt_Integer", ",", "nt_Integer", ",", 
      RowBox[{"prec_", ":", " ", "80"}]}], "]"}], ":=", "\[IndentingNewLine]",
     "   ", 
    RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", "      ", 
     RowBox[{
      RowBox[{"psiMode", "[", 
       RowBox[{
       "1", ",", "theta", ",", "phiAngle", ",", "u", ",", "v", ",", "rho", ",",
         "chi", ",", "res", ",", "l", ",", "mm", ",", "mt", ",", "nt"}], 
       "]"}], ",", "\[IndentingNewLine]", "      ", 
      RowBox[{"{", 
       RowBox[{"theta", ",", "0", ",", "Pi"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"phiAngle", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "      ", 
      RowBox[{"WorkingPrecision", "->", "prec"}], ",", "\[IndentingNewLine]", 
      "      ", 
      RowBox[{"AccuracyGoal", "->", "30"}], ",", "\[IndentingNewLine]", 
      "      ", 
      RowBox[{"PrecisionGoal", "->", "30"}], ",", "\[IndentingNewLine]", 
      "      ", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
         RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "   ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sampleMeasurement", "=", 
   RowBox[{"measurementKernel", "[", 
    RowBox[{
    "1.2", ",", "2.1", ",", "0.8", ",", "0", ",", "0", ",", "0", ",", "0", ",",
      "60"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "sampleMeasurement"}], "Input",ExpressionUUID->\
"2db61246-fc70-d644-94d5-f21d22507454"]
}, Open  ]],

