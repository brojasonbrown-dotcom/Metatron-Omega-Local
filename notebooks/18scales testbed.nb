Cell[CellGroupData[{

Cell["8. Golden-ratio stability law", "Section",ExpressionUUID->"0863e1b3-e7e8-7047-b634-70e369f6f95b"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"fdd1f832-8fa5-9b4c-9c25-9b23fa8cf7e9"],

Cell["\<\
This section implements the requested golden-ratio spacing validation and a \
practical re-tuning module. \
\>", "Text",ExpressionUUID->"06f3049e-0aa1-7c46-aaa8-71f4350d8b78"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "goldenStableQ", ",", "goldenAlignedQ", ",", "retuneFrequencyToPhi", ",", 
     "enforceGoldenStability"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"goldenTargets", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"phi", "^", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "3"}], ",", "3"}], "]"}]}], ",", "100"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"goldenStableQ", "[", 
     RowBox[{
      RowBox[{"omega1_", "?", "NumericQ"}], ",", 
      RowBox[{"omega2_", "?", "NumericQ"}], ",", 
      RowBox[{"tolerance_", ":", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ratio", ",", "error"}], "}"}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{
       RowBox[{"ratio", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"omega1", "/", "omega2"}], ",", "80"}], "]"}], "]"}]}], ";",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"error", "=", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"ratio", "-", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
          "goldenTargets"}], "]"}]}], ";", "\[IndentingNewLine]", "   ", 
       RowBox[{"error", "<", "tolerance"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"goldenAlignedQ", "[", 
     RowBox[{"state_Association", ",", 
      RowBox[{"tolerance_", ":", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"{", "frequencies", "}"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"frequencies", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"Values", "[", 
           RowBox[{"state", "[", "\"\<OctaveModes\>\"", "]"}], "]"}], 
          ",", "\"\<AbsoluteFrequency\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"frequencies", ",", "2", ",", "1"}], "]"}], ",", 
         RowBox[{
          RowBox[{"goldenStableQ", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "tolerance"}], "]"}], " ", 
          "&"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"retuneFrequencyToPhi", "[", 
     RowBox[{"omega_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"{", "nearestExponent", "}"}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{
       RowBox[{"nearestExponent", "=", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"MinimalBy", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"-", "20"}], ",", "20"}], "]"}], ",", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"omega", "/", 
               RowBox[{"phi", "^", "#"}]}], "-", "1"}], "]"}], " ", "&"}]}], 
          "]"}]}]}], ";", "\[IndentingNewLine]", "   ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"phi", "^", "nearestExponent"}], ",", "80"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], 
"\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"enforceGoldenStability", "[", "framework_Association", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"octaves", ",", "retuned"}], "}"}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{
      RowBox[{"octaves", "=", 
       RowBox[{"framework", "[", "\"\<OctaveModes\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"retuned", "=", 
       RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"mode", ",", "\[IndentingNewLine]", "         ", 
           RowBox[{"Join", "[", 
            RowBox[{"mode", ",", 
             RowBox[{"<|", "\[IndentingNewLine]", "            ", 
              RowBox[{
               RowBox[{"\"\<RetunedFrequencyFactor\>\"", "->", 
                RowBox[{"retuneFrequencyToPhi", "[", 
                 RowBox[{"mode", "[", "\"\<FrequencyFactor\>\"", "]"}], 
                 "]"}]}], ",", "\[IndentingNewLine]", "            ", 
               RowBox[{"\"\<RetunedAbsoluteFrequency\>\"", "->", 
                RowBox[{"N", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"mode", "[", "\"\<ScaleBaseFrequency\>\"", "]"}], " ", 
                   RowBox[{"retuneFrequencyToPhi", "[", 
                    RowBox[{"mode", "[", "\"\<FrequencyFactor\>\"", "]"}], 
                    "]"}]}], ",", "80"}], "]"}]}]}], "\[IndentingNewLine]", 
              "         ", "|>"}]}], "]"}]}], "\[IndentingNewLine]", "      ",
           "]"}], ",", "\[IndentingNewLine]", "      ", "octaves"}], 
        "\[IndentingNewLine]", "   ", "]"}]}], ";", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"Join", "[", 
       RowBox[{"framework", ",", 
        RowBox[{"<|", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"\"\<GoldenRetunedOctaves\>\"", "->", "retuned"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<GoldenAlignedQ\>\"", "->", 
           RowBox[{"goldenAlignedQ", "[", "framework", "]"}]}]}], 
         "\[IndentingNewLine]", "   ", "|>"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"9cecacb3-ba4c-b54b-9c94-ca0345d7929f"]
}, Open  ]],

