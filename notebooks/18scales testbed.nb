Cell[CellGroupData[{

Cell["4. Layer-1 action and Euler-Lagrange equations", "Section",ExpressionUUID->"3f8f4fd6-28be-ba4d-92a2-d511a3b5dfbb"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"33e6419a-3d39-1b4d-8689-4ede214d18d8"],

Cell[TextData[{
 "This section implements the OPF Layer-1 action ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "\[LongEqual]", "\[Integral]", 
         RowBox[{"(", 
           RowBox[{"\[Rho]", "log", 
             RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
             SuperscriptBox[
              StyleBox["R", "TI"], "2"]}], ")"}], "\[DifferentialD]", 
         "\[CapitalOmega]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "S = \\int (\\rho \\log(\\chi) + \\chi R^2)\\,d\\Omega", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "20b6de8d-7d9f-e84e-8542-80ec378da4ee"],
 "and derives symbolic Euler-Lagrange equations for a simple one-dimensional \
surrogate field model. "
}], "Text",ExpressionUUID->"4c7e94c4-18eb-df41-a0ea-acf21e8f2551"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"rhoField", ",", "chiField", ",", "resolutionField", ",", "x"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lagrangianDensity", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"rhoField", "[", "x", "]"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"chiField", "[", "x", "]"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"chiField", "[", "x", "]"}], " ", 
      RowBox[{
       RowBox[{"resolutionField", "[", "x", "]"}], "^", "2"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layer1EulerEquations", "=", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"lagrangianDensity", ",", 
           RowBox[{"rhoField", "[", "x", "]"}]}], "]"}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"lagrangianDensity", ",", 
             RowBox[{
              RowBox[{"rhoField", "'"}], "[", "x", "]"}]}], "]"}], ",", "x"}],
           "]"}]}], "==", "0"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"lagrangianDensity", ",", 
           RowBox[{"chiField", "[", "x", "]"}]}], "]"}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"lagrangianDensity", ",", 
             RowBox[{
              RowBox[{"chiField", "'"}], "[", "x", "]"}]}], "]"}], ",", "x"}],
           "]"}]}], "==", "0"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"lagrangianDensity", ",", 
           RowBox[{"resolutionField", "[", "x", "]"}]}], "]"}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"lagrangianDensity", ",", 
             RowBox[{
              RowBox[{"resolutionField", "'"}], "[", "x", "]"}]}], "]"}], ",",
            "x"}], "]"}]}], "==", "0"}]}], "\[IndentingNewLine]", "}"}], " ", 
     "//", " ", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "layer1EulerEquations"}], \
"Input",ExpressionUUID->"a8285f10-4d9c-b641-a239-a3418d480dbf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Analytic solution test", "Subsection",ExpressionUUID->"669033c9-afba-ea46-a918-96ce19de1b0c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"layer1AlgebraicSolutions", "=", 
    RowBox[{"Solve", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"layer1EulerEquations", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"rhoField", "[", "x", "]"}], "->", "rho"}], ",", 
         RowBox[{
          RowBox[{"chiField", "[", "x", "]"}], "->", "chi"}], ",", 
         RowBox[{
          RowBox[{"resolutionField", "[", "x", "]"}], "->", "res"}]}], 
        "}"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"{", 
       RowBox[{"rho", ",", "chi", ",", "res"}], "}"}], ",", 
      "\[IndentingNewLine]", "   ", "Reals"}], "\[IndentingNewLine]", "]"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", \
"layer1AlgebraicSolutions"}], "Input",ExpressionUUID->"dd51f59c-f070-2e4e-\
be88-0981d0e958b8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tests", "Subsection",ExpressionUUID->"2eb510df-f31c-8b42-84b7-2557d70029cd"],

Cell[BoxData[
 RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Length", "[", "layer1EulerEquations", "]"}], ",", 
   "\[IndentingNewLine]", " ", "3", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"TestID", "->", "\"\<Three Euler equations\>\""}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"354bbb3f-4bd7-f843-\
ac8f-a3dcc7c60184"],

