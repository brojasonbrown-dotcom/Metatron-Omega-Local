Cell[CellGroupData[{

Cell["14. VerificationTest report", "Section",ExpressionUUID->"902468d8-8f7f-d34d-b55b-da1f57213771"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"a75237c7-d498-904e-83f2-d023d7f7c092"],

Cell["This section collects the key tests into a single report. ", "Text",ExpressionUUID->"5ae1bc12-8568-3942-89cc-66ace01498a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"opfTestReport", "=", 
    RowBox[{"TestReport", "[", 
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"VerificationTest", "[", 
        RowBox[{"nodesPerScale", ",", "83052", ",", 
         RowBox[{"TestID", "->", "\"\<Nodes per scale\>\""}]}], "]"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"VerificationTest", "[", 
        RowBox[{"totalStableNodes", ",", "1494936", ",", 
         RowBox[{"TestID", "->", "\"\<Total stable nodes\>\""}]}], "]"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"VerificationTest", "[", 
        RowBox[{"totalPossibleNodes", ",", "24417288", ",", 
         RowBox[{"TestID", "->", "\"\<Total possible nodes\>\""}]}], "]"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"VerificationTest", "[", 
        RowBox[{
         RowBox[{"Length", "[", "sphereBasis", "]"}], ",", "169", ",", 
         RowBox[{"TestID", "->", "\"\<Sphere basis count\>\""}]}], "]"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"VerificationTest", "[", 
        RowBox[{
         RowBox[{"Length", "[", "toroidalBasis", "]"}], ",", "1369", ",", 
         RowBox[{"TestID", "->", "\"\<Toroidal basis count\>\""}]}], "]"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"VerificationTest", "[", 
        RowBox[{
         RowBox[{"goldenStableQ", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"phi", ",", "60"}], "]"}], ",", "1", ",", 
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}]}], "]"}], ",", "True", ",", 
         RowBox[{"TestID", "->", "\"\<Golden phi accepted\>\""}]}], "]"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"VerificationTest", "[", 
        RowBox[{
         RowBox[{"goldenStableQ", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"2", ",", "60"}], "]"}], ",", "1", ",", 
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}]}], "]"}], ",", "False", ",", 
         RowBox[{"TestID", "->", "\"\<Non golden rejected\>\""}]}], "]"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"VerificationTest", "[", 
        RowBox[{
         RowBox[{"NumericQ", "[", "sampleMeasurement", "]"}], ",", "True", ",", 
         RowBox[{"TestID", "->", "\"\<Measurement numeric\>\""}]}], "]"}]}], 
      "\[IndentingNewLine]", "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "opfTestReport"}], "Input",E\
xpressionUUID->"469ecfef-e6db-3840-a4db-1b9330fb61c6"],

