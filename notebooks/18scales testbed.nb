Cell[CellGroupData[{

Cell["6. Spherical and toroidal basis generators", "Section",ExpressionUUID->"a1b88433-6af1-844c-8263-e58290a1865e"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"d75bdd8a-b4f9-e443-b7c8-514c892a2abc"],

Cell["\<\
This section builds the basis-counting and representative symbolic basis \
functions used by the spectral engine. \
\>", "Text",ExpressionUUID->"43087be4-e600-dc44-9b75-92a79f6350fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sphereBasis", "=", 
    RowBox[{"Flatten", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"SphericalHarmonicY", "[", 
         RowBox[{"l", ",", "m", ",", "theta", ",", "phiAngle"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "0", ",", 
          RowBox[{"opfConfig", "[", "\"\<SphereLMax\>\"", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", 
          RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "   ", "1"}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalBasis", "=", 
    RowBox[{"Flatten", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", " ", "u"}], "+", 
            RowBox[{"n", " ", "v"}]}], ")"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", 
          RowBox[{"-", 
           RowBox[{"opfConfig", "[", "\"\<ToroidalMMax\>\"", "]"}]}], ",", 
          RowBox[{"opfConfig", "[", "\"\<ToroidalMMax\>\"", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"-", 
           RowBox[{"opfConfig", "[", "\"\<ToroidalNMax\>\"", "]"}]}], ",", 
          RowBox[{"opfConfig", "[", "\"\<ToroidalNMax\>\"", "]"}]}], "}"}]}], 
       "]"}], ",", "\[IndentingNewLine]", "   ", "1"}], "\[IndentingNewLine]",
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", " ", "@", " ", 
  RowBox[{"<|", "\[IndentingNewLine]", "   ", 
   RowBox[{
    RowBox[{"\"\<SphereBasisCount\>\"", "->", 
     RowBox[{"Length", "[", "sphereBasis", "]"}]}], ",", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{"\"\<ToroidalBasisCount\>\"", "->", 
     RowBox[{"Length", "[", "toroidalBasis", "]"}]}], ",", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{"\"\<FirstSphereModes\>\"", "->", 
     RowBox[{"Take", "[", 
      RowBox[{"sphereBasis", ",", "6"}], "]"}]}], ",", "\[IndentingNewLine]", 
    "   ", 
    RowBox[{"\"\<FirstToroidalModes\>\"", "->", 
     RowBox[{"Take", "[", 
      RowBox[{"toroidalBasis", ",", "6"}], "]"}]}]}], "\[IndentingNewLine]", 
   "|>"}]}]}], "Input",ExpressionUUID->"5f5bb194-79e6-4742-883d-1fff8e8fdda0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tests", "Subsection",ExpressionUUID->"2af6edd3-bed5-7b4e-ba97-bcd8f1238721"],

Cell[BoxData[{
 RowBox[{"VerificationTest", "[", 
  RowBox[{
   RowBox[{"Length", "[", "sphereBasis", "]"}], ",", "169", ",", 
   RowBox[{"TestID", "->", "\"\<Spherical basis count\>\""}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"VerificationTest", "[", 
  RowBox[{
   RowBox[{"Length", "[", "toroidalBasis", "]"}], ",", "1369", ",", 
