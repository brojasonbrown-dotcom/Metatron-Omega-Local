Cell[CellGroupData[{

Cell["7. Octave ladder and scale spectral data", "Section",ExpressionUUID->"d521aadf-b16b-fd48-8447-dbdd588022f3"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"0354fc0e-b53a-cb48-a49e-d7079ea7a48a"],

Cell["\<\
This section constructs the 18 phi-scaled octave modes for each scale and \
assembles symbolic spectral metadata. \
\>", "Text",ExpressionUUID->"cdaf75ab-48a4-f442-8bc3-6f86368be0b1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"scaleBaseFrequency", "[", "n_Integer", "]"}], ":=", 
   RowBox[{
    RowBox[{"phi", "^", "n"}], "/", "13"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"octaveFrequencyFactor", "[", "k_Integer", "]"}], ":=", 
   RowBox[{"phi", "^", 
    RowBox[{"(", 
     RowBox[{"k", "-", "1"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleOctaveFrequencies", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"opfConfig", "[", "\"\<OctavesPerScale\>\"", "]"}], "]"}], ",",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"<|", "\[IndentingNewLine]", "         ", 
         RowBox[{
          RowBox[{"\"\<OctaveIndex\>\"", "->", "k"}], ",", 
          "\[IndentingNewLine]", "         ", 
          RowBox[{"\"\<FrequencyFactor\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"octaveFrequencyFactor", "[", "k", "]"}], ",", "80"}], 
            "]"}]}], ",", "\[IndentingNewLine]", "         ", 
          RowBox[{"\"\<ScaleBaseFrequency\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"scaleBaseFrequency", "[", "n", "]"}], ",", "80"}], 
            "]"}]}], ",", "\[IndentingNewLine]", "         ", 
          RowBox[{"\"\<AbsoluteFrequency\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"scaleBaseFrequency", "[", "n", "]"}], " ", 
              RowBox[{"octaveFrequencyFactor", "[", "k", "]"}]}], ",", "80"}],
             "]"}]}]}], "\[IndentingNewLine]", "      ", "|>"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"opfConfig", "[", "\"\<OctavesPerScale\>\"", "]"}]}], 
         "}"}]}], "\[IndentingNewLine]", "   ", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleSpectralData", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"\"\<ClosureResidual\>\"", "->", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"closureResidual", "[", "n", "]"}], ",", "80"}], "]"}]}], ",",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ClosureScore\>\"", "->", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"closureScore", "[", "n", "]"}], ",", "80"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<StableQ\>\"", "->", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"stableScaleIndices", ",", "n"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<OctaveModes\>\"", "->", 
       RowBox[{"scaleOctaveFrequencies", "[", "n", "]"}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sampleScale", "=", 
   RowBox[{"scaleSpectralData", "[", "13", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", "sampleScale", "]"}]}], "Input",ExpressionUUID->\
"efa9f9f5-4f6e-f64f-8a66-6707bafde1af"],

