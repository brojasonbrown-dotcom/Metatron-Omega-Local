Cell[CellGroupData[{

Cell["3. Closure score and stable-scale verification", "Section",ExpressionUUID->"a1624857-b42f-2e44-a0b2-f0b5edc49116"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"919690fb-3da4-f747-8519-2c8bf51b4b45"],

Cell[TextData[{
 "This section reproduces the stated stability heuristic based on the \
residual of ",
 Cell[BoxData[Cell["phi^n/13",
   Background->None,ExpressionUUID->"8e2860b6-a6eb-1243-a439-9e19e63c7969"]], 
  "InlineCode",ExpressionUUID->"7333e7a6-b9df-f849-b77f-51fc6929a253"],
 " from the nearest integer. "
}], "Text",ExpressionUUID->"582343b2-053d-c549-8b46-e9f18f6c7de8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"closureResidual", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"phi", "^", "n"}], "/", "13"}], "-", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"phi", "^", "n"}], "/", "13"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"closureScore", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"1", "-", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"closureResidual", "[", "n", "]"}], ",", "80"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"empiricallyStableQ", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"tolerance_", ":", " ", 
       RowBox[{"opfConfig", "[", "\"\<ResidualTolerance\>\"", "]"}]}]}], 
     "]"}], ":=", 
    RowBox[{
     RowBox[{"closureResidual", "[", "n", "]"}], "<", "tolerance"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"empiricalStableScales", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"allScaleIndices", ",", "empiricallyStableQ"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"closureTable", "=", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"Map", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"<|", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"\"\<Scale\>\"", "->", "#"}], ",", "\[IndentingNewLine]", 
          "      ", 
          RowBox[{"\"\<ClosureResidual\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"closureResidual", "[", "#", "]"}], ",", "40"}], "]"}]}],
           ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<ClosureScore\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"closureScore", "[", "#", "]"}], ",", "40"}], "]"}]}], ",",
           "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<StableQ\>\"", "->", 
           RowBox[{"empiricallyStableQ", "[", "#", "]"}]}]}], 
         "\[IndentingNewLine]", "   ", "|>"}], "&"}], ",", 
       "\[IndentingNewLine]", "   ", "allScaleIndices"}], 
      "\[IndentingNewLine]", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Take", "[", 
  RowBox[{"closureTable", ",", "20"}], "]"}]}], "Input",ExpressionUUID->\
"7917ae38-f97c-9049-a743-595b6dbf0f44"]
}, Open  ]],

