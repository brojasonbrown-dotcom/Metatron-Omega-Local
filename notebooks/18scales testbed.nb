Cell[CellGroupData[{

Cell["\<\
5. Missing-variable analysis relative to the Standard Model constant set \
surrogate\
\>", "Section",ExpressionUUID->"3c1bd1db-8303-6e47-8969-cc9b0898607c"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"6d3179c4-ea86-304d-983e-2257521430da"],

Cell["\<\
This section follows the requested idea of identifying variables appearing in \
the Layer-1 action that are not part of a reference constant set. \
\>", "Text",ExpressionUUID->"4f2f49ed-6ff4-b44e-9830-44a4924890d6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"standardModelConstantSurrogate", "=", 
   RowBox[{"{", 
    RowBox[{
    "c", ",", "hbar", ",", "G", ",", "alphaEM", ",", "me", ",", "mp", ",", 
     "mn", ",", "eCharge", ",", "kB"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"layer1Variables", "=", 
   RowBox[{"DeleteDuplicates", " ", "@", " ", 
    RowBox[{"Cases", "[", 
     RowBox[{"lagrangianDensity", ",", "_Symbol", ",", "Infinity"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"missingVariables", "=", 
    RowBox[{"Complement", "[", 
     RowBox[{"layer1Variables", ",", "standardModelConstantSurrogate", ",", 
      RowBox[{"{", 
       RowBox[{"Log", ",", "x"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", " ", "@", " ", 
  RowBox[{"<|", "\[IndentingNewLine]", "   ", 
   RowBox[{
    RowBox[{"\"\<Layer1Variables\>\"", "->", "layer1Variables"}], ",", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{"\"\<ReferenceConstants\>\"", "->", 
     "standardModelConstantSurrogate"}], ",", "\[IndentingNewLine]", "   ", 
    RowBox[{"\"\<MissingVariables\>\"", "->", "missingVariables"}]}], 
   "\[IndentingNewLine]", "|>"}]}]}], "Input",ExpressionUUID->"1e2eb1cd-313e-\
f346-b2dc-62613cb655dc"],

