Cell["2. Exact counting statistics and node-capacity audit", "Section",ExpressionUUID->"b6bd4698-3607-1149-9624-23c0ba33421f"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"e0490837-6dc8-f04f-976a-6c10ff574743"],

Cell["\<\
This section computes the explicit superposition-node statistics described in \
the review addendum. \
\>", "Text",ExpressionUUID->"e3c53e03-cda5-5243-9103-ba525adcfffc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sphereModeCount", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"opfConfig", "[", "\"\<SphereLMax\>\"", "]"}], "+", "1"}], 
     ")"}], "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"toroidalModeCount", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"opfConfig", "[", "\"\<ToroidalMMax\>\"", "]"}]}], "+", "1"}], 
     ")"}], "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fieldModeCount", "=", 
   RowBox[{"Length", "[", 
    RowBox[{"opfConfig", "[", "\"\<FieldComponents\>\"", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"octaveModeCount", "=", 
    RowBox[{"opfConfig", "[", "\"\<OctavesPerScale\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nodesPerScale", "=", 
   RowBox[{"fieldModeCount", "*", "octaveModeCount", "*", 
    RowBox[{"(", 
     RowBox[{"sphereModeCount", "+", "toroidalModeCount"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableScaleCount", "=", 
   RowBox[{"Length", "[", "stableScaleIndices", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"totalPossibleNodes", "=", 
   RowBox[{
    RowBox[{"opfConfig", "[", "\"\<TotalScales\>\"", "]"}], "*", 
    "nodesPerScale"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"totalStableNodes", "=", 
    RowBox[{"stableScaleCount", "*", "nodesPerScale"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"capacityStats", "=", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"<|", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"\"\<SphereModes\>\"", "->", "sphereModeCount"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"\"\<ToroidalModes\>\"", "->", "toroidalModeCount"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"\"\<FieldModes\>\"", "->", "fieldModeCount"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"\"\<OctaveModes\>\"", "->", "octaveModeCount"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"\"\<NodesPerScale\>\"", "->", "nodesPerScale"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"\"\<StableScaleCount\>\"", "->", "stableScaleCount"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"\"\<TotalPossibleNodes\>\"", "->", "totalPossibleNodes"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"\"\<TotalStableNodes\>\"", "->", "totalStableNodes"}]}], 
      "\[IndentingNewLine]", "|>"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "capacityStats"}], "Input",E\
xpressionUUID->"84d77c24-79a6-7249-ae63-cce0817f8d84"]
}, Open  ]],

