Cell[CellGroupData[{

Cell["13. Hypercomplete execution cell", "Section",ExpressionUUID->"6e17e34d-f584-8f41-bf34-edb1027d43de"],

Cell[CellGroupData[{

Cell["What this tests", "Subsection",ExpressionUUID->"139dc2c2-9473-0d44-b69a-78c9cad543c0"],

Cell["\<\
This section assembles the stable-scale frameworks and computes the requested \
top-level diagnostics. \
\>", "Text",ExpressionUUID->"2e473fb5-e7f3-494c-b8f0-c4131b3b9e60"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "assembleStableScaleFrameworksOnly", "]"}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"assembleStableScaleFrameworksOnly", "[", "]"}], ":=", 
    RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{"stableScaleIndices", ",", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"fullScalePipeline", "[", 
         RowBox[{"#", ",", "1.2", ",", "2.1", ",", "0.8"}], "]"}], " ", "&"}],
        " ", "/@", " ", "stableScaleIndices"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hyperStats", "=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"all", "=", 
        RowBox[{"assembleStableScaleFrameworksOnly", "[", "]"}]}], "}"}], ",",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"<|", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\"\<StableScaleCount\>\"", "->", 
         RowBox[{"Length", "[", "all", "]"}]}], ",", "\[IndentingNewLine]", 
        "      ", 
        RowBox[{"\"\<StableScaleIndices\>\"", "->", 
         RowBox[{"Keys", "[", "all", "]"}]}], ",", "\[IndentingNewLine]", 
        "      ", 
        RowBox[{"\"\<TotalSuperpositionNodes\>\"", "->", 
         RowBox[{"Total", "[", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"nodesPerScale", ",", 
            RowBox[{"Length", "[", "all", "]"}]}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<GoldenAlignedScales\>\"", "->", 
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Values", "[", "all", "]"}], ",", 
           RowBox[{"framework_", " ", "/;", " ", 
            RowBox[{"TrueQ", "[", 
             RowBox[{"framework", "[", 
              RowBox[{"\"\<L1\>\"", ",", "\"\<GoldenAlignedQ\>\""}], "]"}], 
             "]"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<MasterStabilityScore\>\"", "->", 
         RowBox[{"Mean", "[", 
          RowBox[{"Lookup", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Values", "[", "all", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "\"\<L1\>\""}], "]"}], "]"}], 
            ",", "\"\<ClosureScore\>\""}], "]"}], "]"}]}]}], 
       "\[IndentingNewLine]", "   ", "|>"}]}], "\[IndentingNewLine]", "]"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Hypercomplete OPF Engine Stats:\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", "hyperStats", "]"}]}], "Input",ExpressionUUID->\
"a90369f9-29ac-fd47-9844-ee07370a1466"],

