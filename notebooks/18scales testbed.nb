Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "scaleIndex", ",", "octaveIndex", ",", "l", ",", "m", ",", "u", ",", 
         "v", ",", "x", ",", "y", ",", "z", ",", "t", ",", "r", ",", "theta", 
         ",", "phiAngle"}], "}"}], ",", "Reals"}], "]"}], "&&", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"scaleIndex", ">=", "0"}], "&&", 
     RowBox[{"octaveIndex", ">=", "1"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phi", "=", 
   RowBox[{"N", "[", 
    RowBox[{"GoldenRatio", ",", "200"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phiExact", "=", "GoldenRatio"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"opfConfig", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<TotalScales\>\"", "->", "294"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<StableScaleIndices\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "13", ",", "20", ",", "40", ",", "60", ",", "80", ",", 
         "100", ",", "120", ",", "140", ",", "160", ",", "180", ",", "186", ",",
          "200", ",", "220", ",", "240", ",", "260", ",", "280", ",", "292"}],
         "}"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<OctavesPerScale\>\"", "->", "18"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<FieldComponents\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<rho\>\"", ",", "\"\<chi\>\"", 
         ",", "\"\<resolution\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"\"\<SphereLMax\>\"", "->", "12"}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"\"\<ToroidalMMax\>\"", "->", "18"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ToroidalNMax\>\"", "->", "18"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<DefaultPrecision\>\"", "->", "200"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<GoldenTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "12"}]}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ResidualTolerance\>\"", "->", 
       RowBox[{"1", "/", "100"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableScaleIndices", "=", 
   RowBox[{"opfConfig", "[", "\"\<StableScaleIndices\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allScaleIndices", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{"opfConfig", "[", "\"\<TotalScales\>\"", "]"}], "-", "1"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"safeN", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"prec_", ":", " ", 
      RowBox[{"opfConfig", "[", "\"\<DefaultPrecision\>\"", "]"}]}]}], "]"}], 
   ":=", 
   RowBox[{"N", "[", 
    RowBox[{"expr", ",", "prec"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"residueAnalysis", "[", "value_", "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<Value\>\"", "->", "value"}], ",", "\[IndentingNewLine]", 
