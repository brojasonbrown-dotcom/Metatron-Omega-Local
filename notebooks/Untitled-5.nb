Cell[CellGroupData[{

Cell["4. Robust test framework", "Section",ExpressionUUID->"92dcccda-03a6-be43-a0d7-8475028cc0cd"],

Cell["\<\
These 9 tests are not filler tests. They are deliberately compact and tied \
directly to the chapter formulas and computational consistency. \
\>", "Text",ExpressionUUID->"13e34056-c59f-ad4c-9894-1a224c740595"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "runScaleTests", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"runScaleTests", "[", 
    RowBox[{"n_", ",", 
     RowBox[{"opts", " ", ":", " ", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Epsilon\>\"", "->", "0"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<Rho0\>\"", "->", "1"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<Mass\>\"", "->", "1"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<HBar\>\"", "->", "1"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<LightSpeed\>\"", "->", "1"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityThreshold\>\"", "->", "0.99"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<ComplexityMonotonicityWindow\>\"", "->", "1"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<ResolutionMonotonicityWindow\>\"", "->", "1"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<WaveSpeedUpperBound\>\"", "->", "Infinity"}]}], 
        "\[IndentingNewLine]", "  ", "}"}], "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{"assoc", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"epsilon", "=", 
        RowBox[{"OptionValue", "[", "\"\<Epsilon\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"rho0", "=", 
        RowBox[{"OptionValue", "[", "\"\<Rho0\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"mass", "=", 
        RowBox[{"OptionValue", "[", "\"\<Mass\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"hbar", "=", 
        RowBox[{"OptionValue", "[", "\"\<HBar\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"c", "=", 
        RowBox[{"OptionValue", "[", "\"\<LightSpeed\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"threshold", "=", 
        RowBox[{"OptionValue", "[", "\"\<StabilityThreshold\>\"", "]"}]}], ",",
        "\[IndentingNewLine]", "    ", 
       RowBox[{"waveUpper", "=", 
        RowBox[{"OptionValue", "[", "\"\<WaveSpeedUpperBound\>\"", "]"}]}], ",",
        "\[IndentingNewLine]", "    ", "prev", ",", "next"}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"assoc", "=", 
       RowBox[{"scaleAssociation", "[", 
        RowBox[{"n", ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Epsilon\>\"", "->", "epsilon"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Rho0\>\"", "->", "rho0"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<Mass\>\"", "->", "mass"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<HBar\>\"", "->", "hbar"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<LightSpeed\>\"", "->", "c"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityThreshold\>\"", "->", "threshold"}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"prev", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"stableScales", ",", 
           RowBox[{"n", "-", "1"}]}], "]"}], ",", 
         RowBox[{"scaleAssociation", "[", 
          RowBox[{
           RowBox[{"n", "-", "1"}], ",", 
           RowBox[{"\"\<Epsilon\>\"", "->", "epsilon"}]}], "]"}], ",", 
         RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"next", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"stableScales", ",", 
           RowBox[{"n", "+", "1"}]}], "]"}], ",", 
         RowBox[{"scaleAssociation", "[", 
          RowBox[{
           RowBox[{"n", "+", "1"}], ",", 
           RowBox[{"\"\<Epsilon\>\"", "->", "epsilon"}]}], "]"}], ",", 
         RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<StabilityThresholdTest\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Value\>\"", "->", 
            RowBox[{"assoc", "[", "\"\<StabilityScore\>\"", "]"}]}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Threshold\>\"", "->", "threshold"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Pass\>\"", "->", 
            RowBox[{
             RowBox[{"assoc", "[", "\"\<StabilityScore\>\"", "]"}], ">=", 
             "threshold"}]}]}], "\[IndentingNewLine]", "    ", "|>"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<PositiveLengthTest\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Value\>\"", "->", 
            RowBox[{"UnitConvert", "[", 
             RowBox[{
              RowBox[{"assoc", "[", "\"\<LengthScale\>\"", "]"}], 
              ",", "\"\<Meters\>\""}], "]"}]}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"\"\<Pass\>\"", "->", 
            RowBox[{
             RowBox[{"QuantityMagnitude", "[", 
              RowBox[{"UnitConvert", "[", 
               RowBox[{
                RowBox[{"assoc", "[", "\"\<LengthScale\>\"", "]"}], 
                ",", "\"\<Meters\>\""}], "]"}], "]"}], ">", "0"}]}]}], 
          "\[IndentingNewLine]", "    ", "|>"}]}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<PositiveTimeTest\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Value\>\"", "->", 
            RowBox[{"UnitConvert", "[", 
             RowBox[{
              RowBox[{"assoc", "[", "\"\<TimeQuantum\>\"", "]"}], 
              ",", "\"\<Seconds\>\""}], "]"}]}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"\"\<Pass\>\"", "->", 
            RowBox[{
             RowBox[{"QuantityMagnitude", "[", 
              RowBox[{"UnitConvert", "[", 
               RowBox[{
                RowBox[{"assoc", "[", "\"\<TimeQuantum\>\"", "]"}], 
                ",", "\"\<Seconds\>\""}], "]"}], "]"}], ">", "0"}]}]}], 
          "\[IndentingNewLine]", "    ", "|>"}]}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<PositiveResolutionTest\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Value\>\"", "->", 
            RowBox[{"UnitConvert", "[", 
             RowBox[{
              RowBox[{"assoc", "[", "\"\<SpatialResolution\>\"", "]"}], 
              ",", "\"\<Meters\>\""}], "]"}]}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"\"\<Pass\>\"", "->", 
            RowBox[{
             RowBox[{"QuantityMagnitude", "[", 
              RowBox[{"UnitConvert", "[", 
               RowBox[{
                RowBox[{"assoc", "[", "\"\<SpatialResolution\>\"", "]"}], 
                ",", "\"\<Meters\>\""}], "]"}], "]"}], ">", "0"}]}]}], 
          "\[IndentingNewLine]", "    ", "|>"}]}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<PositiveComplexityTest\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Value\>\"", "->", 
            RowBox[{"assoc", "[", "\"\<Complexity\>\"", "]"}]}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Pass\>\"", "->", 
            RowBox[{
             RowBox[{"assoc", "[", "\"\<Complexity\>\"", "]"}], ">=", 
             "0"}]}]}], "\[IndentingNewLine]", "    ", "|>"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<DensityDecayTest\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Value\>\"", "->", 
            RowBox[{"assoc", "[", "\"\<InformationDensityRatio\>\"", "]"}]}], 
           ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Pass\>\"", "->", 
            RowBox[{"0", "<", 
             RowBox[{"assoc", "[", "\"\<InformationDensityRatio\>\"", "]"}], "<=",
              "1"}]}]}], "\[IndentingNewLine]", "    ", "|>"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<WindingIntegralityTest\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Value\>\"", "->", 
            RowBox[{"assoc", "[", "\"\<WindingNumber\>\"", "]"}]}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Pass\>\"", "->", 
            RowBox[{"IntegerQ", "[", 
             RowBox[{"assoc", "[", "\"\<WindingNumber\>\"", "]"}], "]"}]}]}], 
          "\[IndentingNewLine]", "    ", "|>"}]}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<FiniteWaveSpeedTest\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Value\>\"", "->", 
            RowBox[{"assoc", "[", "\"\<WaveSpeedRatio\>\"", "]"}]}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Pass\>\"", "->", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"assoc", "[", "\"\<WaveSpeedRatio\>\"", "]"}], "]"}], "&&", 
             RowBox[{"TrueQ", "[", 
              RowBox[{"0", "<", 
               RowBox[{"assoc", "[", "\"\<WaveSpeedRatio\>\"", "]"}], "<", 
               "waveUpper"}], "]"}]}]}]}], "\[IndentingNewLine]", "    ", 
          "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ClosedStableMembershipTest\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Value\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"\"\<Pass\>\"", "->", 
            RowBox[{"MemberQ", "[", 
             RowBox[{"stableScales", ",", "n"}], "]"}]}]}], 
          "\[IndentingNewLine]", "    ", "|>"}]}]}], "\[IndentingNewLine]", 
       "  ", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"73f20a52-5932-8a42-8238-6fa2fa07aba2"],

