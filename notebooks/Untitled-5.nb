Cell[CellGroupData[{

Cell["7. Equation display helper for any scale", "Section",ExpressionUUID->"1f5ada50-3371-8844-a11c-a5c835915a30"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "rhuftEquationForm", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhuftEquationForm", "[", "n_", "]"}], ":=", 
   RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{
         RowBox[{"waveSpeedRatio", "[", 
          RowBox[{"n", ",", "epsilon", ",", "rho0"}], "]"}], "^", "2"}]}], " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Psi", "[", 
          RowBox[{"r", ",", "t", ",", "n"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "2"}], "}"}]}], "]"}]}], "-", 
      RowBox[{"Laplacian", "[", 
       RowBox[{
        RowBox[{"Psi", "[", 
         RowBox[{"r", ",", "t", ",", "n"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "+", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"gamma", " ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Psi", "[", 
          RowBox[{"r", ",", "t", ",", "n"}], "]"}], ",", "t"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"gradientCoupling", "[", 
        RowBox[{"n", ",", "mass", ",", "hbar", ",", "cNorm"}], "]"}], " ", 
       RowBox[{
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"informationDensityRatio", "[", "n", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], " ", ".", " ", 
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"Psi", "[", 
           RowBox[{"r", ",", "t", ",", "n"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}]}]}], "==", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"goldenRatio", "^", "k"}]}], ")"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"k", ",", "k"}], "]"}], "[", 
               RowBox[{"r", ",", "n"}], "]"}], " ", ".", " ", "r"}], "-", 
             RowBox[{
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"omega", ",", "k"}], "]"}], "[", 
               RowBox[{"r", ",", "n"}], "]"}], " ", "t"}], "+", 
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"Omega", ",", "k"}], "]"}], "[", "t", "]"}]}], ")"}]}],
           "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "12"}], "}"}]}], "]"}], "+", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"lambdaConst", " ", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Psi", "[", 
           RowBox[{"r", ",", 
            RowBox[{"t", "+", "s"}], ",", "n"}], "]"}], " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "gamma"}], " ", 
            RowBox[{"Abs", "[", "s", "]"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"-", 
            RowBox[{"timeQuantum", "[", 
             RowBox[{"n", ",", "epsilon"}], "]"}]}], ",", "0"}], "}"}]}], 
        "]"}]}], "+", "\[IndentingNewLine]", "  ", 
      RowBox[{"kappaConst", " ", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Grad", "[", 
           RowBox[{
            RowBox[{"Psi", "[", 
             RowBox[{"r", ",", "t", ",", "n"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], " ", ".", " ",
           "dS"}], ",", 
         RowBox[{"{", 
          RowBox[{"dS", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "+", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"infoCoupling", "[", 
        RowBox[{"n", ",", "hbar", ",", "cNorm"}], "]"}], " ", 
       RowBox[{"Grad", "[", 
        RowBox[{
         RowBox[{"informationDensityRatio", "[", "n", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], "+", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"M", ",", "n"}], "]"}], " ", "PsiExternal"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"9369a6e7-cd49-c54c-8560-71c80ac14d50"],

Cell["Use: ", "CodeText",ExpressionUUID->"ae3c9629-01f6-454d-82bc-0d93876ba689"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TraditionalForm", "[", 
  RowBox[{"rhuftEquationForm", "[", "13", "]"}], "]"}]], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"378b4d9c-8c50-224e-8af9-ce63d4f1f9e6"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{
     FractionBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], 
        RowBox[{"Psi", "(", 
         RowBox[{"r", ",", "t", ",", "13"}], ")"}]}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["t", "2"]}],
       MultilineFunction->None], 
      SuperscriptBox[
       RowBox[{"waveSpeedRatio", "(", 
        RowBox[{"13", ",", "epsilon", ",", "rho0"}], ")"}], "2"]], "-", 
     TemplateBox[{
       RowBox[{"Psi", "(", 
         RowBox[{"r", ",", "t", ",", "13"}], ")"}], 
       RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}]},
      "Laplacian"], "+", 
     RowBox[{"gamma", " ", 
      FractionBox[
       RowBox[{"\[PartialD]", 
        RowBox[{"Psi", "(", 
         RowBox[{"r", ",", "t", ",", "13"}], ")"}]}], 
       RowBox[{"\[PartialD]", "t"}],
       MultilineFunction->None]}], "+", 
     RowBox[{
      RowBox[{"gradientCoupling", "(", 
       RowBox[{"13", ",", "mass", ",", "hbar", ",", "cNorm"}], ")"}], " ", 
      RowBox[{
       TemplateBox[{
         RowBox[{"informationDensityRatio", "(", "13", ")"}], 
         RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]},
        "Grad"], ".", 
       TemplateBox[{
         RowBox[{"Psi", "(", 
           RowBox[{"r", ",", "t", ",", "13"}], ")"}], 
         RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]},
        "Grad"]}]}]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "0"}], "12"], 
      FractionBox[
       RowBox[{"exp", "(", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             SubscriptBox["k", "k"], "(", 
             RowBox[{"r", ",", "13"}], ")"}], ".", "r"}], "-", 
           RowBox[{
            RowBox[{
             SubscriptBox["omega", "k"], "(", 
             RowBox[{"r", ",", "13"}], ")"}], " ", "t"}], "+", 
           RowBox[{
            SubscriptBox["Omega", "k"], "(", "t", ")"}]}], ")"}]}], ")"}], 
       SuperscriptBox["goldenRatio", "k"]]}], "+", 
     RowBox[{"lambdaConst", " ", 
      RowBox[{
       SubsuperscriptBox["\[Integral]", 
        RowBox[{"-", 
         RowBox[{"timeQuantum", "(", 
          RowBox[{"13", ",", "epsilon"}], ")"}]}], "0"], 
       RowBox[{
        RowBox[{"Psi", "(", 
         RowBox[{"r", ",", 
          RowBox[{"t", "+", "s"}], ",", "13"}], ")"}], " ", 
        RowBox[{"exp", "(", 
         RowBox[{
          RowBox[{"-", "gamma"}], " ", 
          TemplateBox[{"s"},
           "Abs"]}], ")"}], 
        RowBox[{"\[DifferentialD]", "s"}]}]}]}], "+", 
     RowBox[{"kappaConst", " ", 
      RowBox[{
       SubsuperscriptBox["\[Integral]", "0", "1"], 
       RowBox[{
        RowBox[{
         TemplateBox[{
           RowBox[{"Psi", "(", 
             RowBox[{"r", ",", "t", ",", "13"}], ")"}], 
           RowBox[{"{", 
             RowBox[{"x", ",", "y", ",", "z"}], "}"}]},
          "Grad"], ".", "dS"}], 
        RowBox[{"\[DifferentialD]", "dS"}]}]}]}], "+", 
     RowBox[{
      RowBox[{"infoCoupling", "(", 
       RowBox[{"13", ",", "hbar", ",", "cNorm"}], ")"}], " ", 
      TemplateBox[{
        RowBox[{"informationDensityRatio", "(", "13", ")"}], 
        RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}]},
       "Grad"]}], "+", 
     RowBox[{
      SubscriptBox["M", "13"], " ", "PsiExternal"}]}]}],
   HoldForm], TraditionalForm]], "Output",
 CellChangeTimes->{3.9938186087134647`*^9},
 CellLabel->
  "Out[38]//TraditionalForm=",ExpressionUUID->"44afc217-e10a-1943-bbc5-\
24dc1013f3d5"]
}, Open  ]],

