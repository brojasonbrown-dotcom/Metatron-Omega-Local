Cell[CellGroupData[{

Cell["2. RHUFT parameter model", "Section",ExpressionUUID->"bb9afc4f-2b57-044b-af7e-89cb1e464a0a"],

Cell["\<\
This section implements the chapter definitions in a computationally \
consistent form. \
\>", "Text",ExpressionUUID->"c49e2325-b135-0640-aef6-a8f99ab84779"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "lengthScale", ",", "timeQuantum", ",", "spatialResolution", ",", 
     "complexityMeasure", ",", "\[IndentingNewLine]", "  ", 
     "informationDensityRatio", ",", "stabilityScore", ",", "windingNumber", ",",
      "\[IndentingNewLine]", "  ", "kappaConst", ",", "lambdaConst", ",", 
     "infoCoupling", ",", "gradientCoupling", ",", "waveSpeedRatio", ",", 
     "\[IndentingNewLine]", "  ", "scaleAssociation"}], "\[IndentingNewLine]",
     "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kappaConst", "=", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"goldenRatio", " ", "Pi"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaConst", "=", 
    RowBox[{"1", "/", 
     RowBox[{"goldenRatio", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"lengthScale", "[", "n_", "]"}], ":=", 
    RowBox[{"planckLength", "*", 
     RowBox[{"goldenRatio", "^", "n"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"timeQuantum", "[", 
     RowBox[{"n_", ",", 
      RowBox[{"epsilon_", ":", " ", "0"}]}], "]"}], ":=", 
    RowBox[{"planckTime", "*", 
     RowBox[{"goldenRatio", "^", "n"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"epsilon", " ", "n"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"spatialResolution", "[", "n_", "]"}], ":=", 
    RowBox[{"planckLength", "*", 
     RowBox[{"goldenRatio", "^", 
      RowBox[{"-", "n"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"complexityMeasure", "[", "n_", "]"}], ":=", 
    RowBox[{"3", " ", "n", " ", 
     RowBox[{"Log", "[", "goldenRatio", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"informationDensityRatio", "[", "n_", "]"}], ":=", 
    RowBox[{"goldenRatio", "^", 
     RowBox[{"-", "n"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stabilityScore", "[", "n_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", "=", 
        RowBox[{
         RowBox[{"goldenRatio", "^", "n"}], "/", "13"}]}], "}"}], ",", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"x", "-", 
          RowBox[{"Round", "[", "x", "]"}]}], "]"}], "/", "x"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"windingNumber", "[", "n_", "]"}], ":=", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"goldenRatio", "^", "n"}], "/", "13"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"infoCoupling", "[", 
     RowBox[{"n_", ",", 
      RowBox[{"hbar_", ":", " ", "1"}], ",", 
      RowBox[{"c_", ":", " ", "1"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"hbar", "/", 
       RowBox[{"c", "^", "2"}]}], ")"}], " ", 
     RowBox[{"goldenRatio", "^", 
      RowBox[{"-", "n"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gradientCoupling", "[", 
     RowBox[{"n_", ",", 
      RowBox[{"mass_", ":", " ", "1"}], ",", 
      RowBox[{"hbar_", ":", " ", "1"}], ",", 
      RowBox[{"c_", ":", " ", "1"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"hbar", "/", 
       RowBox[{"(", 
        RowBox[{"mass", " ", 
         RowBox[{"c", "^", "2"}]}], ")"}]}], ")"}], " ", 
     RowBox[{"goldenRatio", "^", 
      RowBox[{"-", "n"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"waveSpeedRatio", "[", 
     RowBox[{"n_", ",", 
      RowBox[{"epsilon_", ":", " ", "0"}], ",", 
      RowBox[{"rho0_", ":", " ", "1"}], ",", 
      RowBox[{"kappa_", ":", " ", "kappaConst"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"rho", "=", 
         RowBox[{"rho0", " ", 
          RowBox[{"informationDensityRatio", "[", "n", "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"tau", "=", 
         RowBox[{
          RowBox[{"goldenRatio", "^", "n"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"epsilon", " ", "n"}]}], ")"}]}]}]}], 
       "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"rho", " ", "kappa"}], "]"}], " ", "tau"}], ")"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleAssociation", "[", 
    RowBox[{"n_", ",", 
     RowBox[{"opts", " ", ":", " ", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Epsilon\>\"", "->", "0"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<Rho0\>\"", "->", "1"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<Mass\>\"", "->", "1"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<HBar\>\"", "->", "1"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<LightSpeed\>\"", "->", "1"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityThreshold\>\"", "->", "0.99"}]}], 
        "\[IndentingNewLine]", "  ", "}"}], "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"epsilon", "=", 
        RowBox[{"OptionValue", "[", "\"\<Epsilon\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"rho0", "=", 
        RowBox[{"OptionValue", "[", "\"\<Rho0\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"mass", "=", 
        RowBox[{"OptionValue", "[", "\"\<Mass\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"hbar", "=", 
        RowBox[{"OptionValue", "[", "\"\<HBar\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"c", "=", 
        RowBox[{"OptionValue", "[", "\"\<LightSpeed\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"threshold", "=", 
        RowBox[{"OptionValue", "[", "\"\<StabilityThreshold\>\"", "]"}]}], ",",
        "\[IndentingNewLine]", "    ", "score"}], "\[IndentingNewLine]", "  ",
       "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"score", "=", 
       RowBox[{"stabilityScore", "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Scale\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<LengthScale\>\"", "->", 
         RowBox[{"lengthScale", "[", "n", "]"}]}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<TimeQuantum\>\"", "->", 
         RowBox[{"timeQuantum", "[", 
          RowBox[{"n", ",", "epsilon"}], "]"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<SpatialResolution\>\"", "->", 
         RowBox[{"spatialResolution", "[", "n", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Complexity\>\"", "->", 
         RowBox[{"complexityMeasure", "[", "n", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<InformationDensityRatio\>\"", "->", 
         RowBox[{"informationDensityRatio", "[", "n", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<WaveSpeedRatio\>\"", "->", 
         RowBox[{"waveSpeedRatio", "[", 
          RowBox[{"n", ",", "epsilon", ",", "rho0"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<InfoCoupling\>\"", "->", 
         RowBox[{"infoCoupling", "[", 
          RowBox[{"n", ",", "hbar", ",", "c"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<GradientCoupling\>\"", "->", 
         RowBox[{"gradientCoupling", "[", 
          RowBox[{"n", ",", "mass", ",", "hbar", ",", "c"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Kappa\>\"", "->", "kappaConst"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Lambda\>\"", "->", "lambdaConst"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<StabilityScore\>\"", "->", "score"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<WindingNumber\>\"", "->", 
         RowBox[{"windingNumber", "[", "n", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<StableQ\>\"", "->", 
         RowBox[{"score", ">=", "threshold"}]}]}], "\[IndentingNewLine]", 
       "  ", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"a82034f7-2a37-624a-97b7-b17802008fc0"],

