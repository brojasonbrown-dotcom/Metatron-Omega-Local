Cell[CellGroupData[{

Cell["6. Full visual interactive evaluator", "Section",ExpressionUUID->"fa84654c-d738-0e44-8892-88f1f8b3331c"],

Cell["\<\
This gives sliders and configuration controls for every scale and every main \
RHUFT hyperparameter. \
\>", "Text",ExpressionUUID->"2e63e051-2219-824d-a724-c3a6049c38d5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
      "assoc", ",", "\[IndentingNewLine]", "    ", "tests", ",", 
       "\[IndentingNewLine]", "    ", "summary", ",", "\[IndentingNewLine]", 
       "    ", "scoreVector", ",", "\[IndentingNewLine]", "    ", 
       "complexityVector", ",", "\[IndentingNewLine]", "    ", 
       "densityVector", ",", "\[IndentingNewLine]", "    ", "waveVector", ",",
        "\[IndentingNewLine]", "    ", "selectedRealm"}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"assoc", "=", 
       RowBox[{"scaleAssociation", "[", 
        RowBox[{"n", ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Epsilon\>\"", "->", "epsilon"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Rho0\>\"", "->", "rho0"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<Mass\>\"", "->", "mass"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<HBar\>\"", "->", "hbar"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<LightSpeed\>\"", "->", "cNorm"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityThreshold\>\"", "->", "stabilityThreshold"}]}],
         "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"tests", "=", 
       RowBox[{"runScaleTests", "[", 
        RowBox[{"n", ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Epsilon\>\"", "->", "epsilon"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Rho0\>\"", "->", "rho0"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<Mass\>\"", "->", "mass"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<HBar\>\"", "->", "hbar"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<LightSpeed\>\"", "->", "cNorm"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityThreshold\>\"", "->", "stabilityThreshold"}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<WaveSpeedUpperBound\>\"", "->", 
          "waveSpeedUpperBound"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"summary", "=", 
       RowBox[{"scaleSummaryDataset", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Epsilon\>\"", "->", "epsilon"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Rho0\>\"", "->", "rho0"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<Mass\>\"", "->", "mass"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<HBar\>\"", "->", "hbar"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<LightSpeed\>\"", "->", "cNorm"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityThreshold\>\"", "->", "stabilityThreshold"}]}],
         "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"scoreVector", "=", 
       RowBox[{"stabilityScore", " ", "/@", " ", "stableScales"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"complexityVector", "=", 
       RowBox[{"complexityMeasure", " ", "/@", " ", "stableScales"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"densityVector", "=", 
       RowBox[{"informationDensityRatio", " ", "/@", " ", "stableScales"}]}], 
      ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"waveVector", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"waveSpeedRatio", "[", 
          RowBox[{"#", ",", "epsilon", ",", "rho0"}], "]"}], " ", "&"}], " ", 
        "/@", " ", "stableScales"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"selectedRealm", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"realmName", ",", "n", ",", "\"\<Unknown\>\""}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
      RowBox[{"Column", "[", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"Style", "[", 
           
