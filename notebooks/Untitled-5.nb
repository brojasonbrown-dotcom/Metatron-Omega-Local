Cell["5. Visual summary helpers", "Section",ExpressionUUID->"8f82b43e-97b2-3640-93ec-f0879d5e2cae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "testResultGrid", ",", "scaleSummaryDataset", ",", "scaleBarChart", ",", 
     "stabilityPlot"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"testResultGrid", "[", "testAssoc_", "]"}], ":=", 
    RowBox[{"Grid", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Prepend", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", 
             RowBox[{"#2", "[", "\"\<Value\>\"", "]"}], ",", 
             RowBox[{"Lookup", "[", 
              RowBox[{"#2", ",", "\"\<Threshold\>\"", ",", "\"\<\>\""}], 
              "]"}], ",", 
             RowBox[{"#2", "[", "\"\<Pass\>\"", "]"}]}], "}"}], " ", "&"}], ",",
           "testAssoc"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"\"\<Test\>\"", ",", "\"\<Value\>\"", 
          ",", "\"\<Threshold\>\"", ",", "\"\<Pass\>\""}], "}"}]}], 
       "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Frame", "->", "All"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Background", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"None", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Lighter", "[", 
               RowBox[{"Red", ",", ".92"}], "]"}], ",", 
              RowBox[{"Lighter", "[", 
               RowBox[{"Green", ",", ".92"}], "]"}]}], "}"}]}], "}"}], " ", "/.",
           " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"False", "->", 
             RowBox[{"Lighter", "[", 
              RowBox[{"Red", ",", ".92"}], "]"}]}], ",", 
            RowBox[{"True", "->", 
             RowBox[{"Lighter", "[", 
              RowBox[{"Green", ",", ".92"}], "]"}]}]}], "}"}]}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleSummaryDataset", "[", 
     RowBox[{"opts", " ", ":", " ", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Epsilon\>\"", "->", "0"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<Rho0\>\"", "->", "1"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<Mass\>\"", "->", "1"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<HBar\>\"", "->", "1"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<LightSpeed\>\"", "->", "1"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityThreshold\>\"", "->", "0.99"}]}], 
        "\[IndentingNewLine]", "  ", "}"}], "]"}]}], "]"}], ":=", 
    RowBox[{"Dataset", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"Association", " ", "/@", " ", 
      RowBox[{"Map", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"n", ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"Append", "[", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"scaleAssociation", "[", 
             RowBox[{"n", ",", "\[IndentingNewLine]", "          ", 
              RowBox[{"\"\<Epsilon\>\"", "->", 
               RowBox[{"OptionValue", "[", "\"\<Epsilon\>\"", "]"}]}], ",", 
              "\[IndentingNewLine]", "          ", 
              RowBox[{"\"\<Rho0\>\"", "->", 
               RowBox[{"OptionValue", "[", "\"\<Rho0\>\"", "]"}]}], ",", 
              "\[IndentingNewLine]", "          ", 
              RowBox[{"\"\<Mass\>\"", "->", 
               RowBox[{"OptionValue", "[", "\"\<Mass\>\"", "]"}]}], ",", 
              "\[IndentingNewLine]", "          ", 
              RowBox[{"\"\<HBar\>\"", "->", 
               RowBox[{"OptionValue", "[", "\"\<HBar\>\"", "]"}]}], ",", 
              "\[IndentingNewLine]", "          ", 
              RowBox[{"\"\<LightSpeed\>\"", "->", 
               RowBox[{"OptionValue", "[", "\"\<LightSpeed\>\"", "]"}]}], ",",
               "\[IndentingNewLine]", "          ", 
              RowBox[{"\"\<StabilityThreshold\>\"", "->", 
               RowBox[{
               "OptionValue", "[", "\"\<StabilityThreshold\>\"", "]"}]}]}], 
             "\[IndentingNewLine]", "        ", "]"}], ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"\"\<Realm\>\"", "->", 
             RowBox[{"Lookup", "[", 
              RowBox[{"realmName", ",", "n", ",", "\"\<Unknown\>\""}], 
              "]"}]}]}], "\[IndentingNewLine]", "      ", "]"}]}], 
         "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
        "    ", "stableScales"}], "\[IndentingNewLine]", "  ", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleBarChart", "[", 
     RowBox[{"vals_", ",", "label_"}], "]"}], ":=", 
    RowBox[{"BarChart", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"vals", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"ChartLabels", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{"stableScales", ",", "Below"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"PlotLabel", "->", "label"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"ImageSize", "->", "Large"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"ChartStyle", "->", 
       RowBox[{
        RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "vals", "]"}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stabilityPlot", "[", 
    RowBox[{"opts", " ", ":", " ", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Threshold\>\"", "->", "0.99"}], "}"}], "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scores", ",", 
       RowBox[{"threshold", "=", 
        RowBox[{"OptionValue", "[", "\"\<Threshold\>\"", "]"}]}]}], "}"}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"scores", "=", 
       RowBox[{"stabilityScore", " ", "/@", " ", "stableScales"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"stableScales", ",", "scores"}], "}"}], "]"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"stableScales", ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"threshold", ",", 
               RowBox[{"Length", "[", "stableScales", "]"}]}], "]"}]}], "}"}],
            "]"}]}], "\[IndentingNewLine]", "    ", "}"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<StabilityScore\>\"", ",", "\"\<Threshold\>\""}], 
          "}"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"ImageSize", "->", "Large"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"GridLines", "->", 
         RowBox[{"{", 
          RowBox[{"stableScales", ",", "Automatic"}], "}"}]}]}], 
       "\[IndentingNewLine]", "  ", "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
   ";"}]}], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"ae35fe3b-a8ef-6e47-b36d-fa6846c73187"],

