           "FiniteWaveSpeedTest" -> <|
            "Value" -> $CellContext`assoc["WaveSpeedRatio"], "Pass" -> And[
               NumericQ[
                $CellContext`assoc["WaveSpeedRatio"]], 
               TrueQ[
               0 < $CellContext`assoc[
                 "WaveSpeedRatio"] < $CellContext`waveUpper]]|>, 
           "ClosedStableMembershipTest" -> <|
            "Value" -> $CellContext`n, "Pass" -> 
             MemberQ[$CellContext`stableScales, $CellContext`n]|>|>], \
$CellContext`stableScales = {0, 13, 20, 40, 60, 80, 100, 120, 140, 160, 180, 
        186, 200, 220, 240, 260, 280, 292}, $CellContext`scaleSummaryDataset[
         Pattern[$CellContext`opts, 
          
          OptionsPattern[{
           "Epsilon" -> 0, "Rho0" -> 1, "Mass" -> 1, "HBar" -> 1, 
            "LightSpeed" -> 1, "StabilityThreshold" -> 0.99}]]] := Dataset[
         Map[Association, 
          Map[
           Function[$CellContext`n, 
            Append[
             $CellContext`scaleAssociation[$CellContext`n, "Epsilon" -> 
              OptionValue["Epsilon"], "Rho0" -> OptionValue["Rho0"], "Mass" -> 
              OptionValue["Mass"], "HBar" -> OptionValue["HBar"], 
              "LightSpeed" -> OptionValue["LightSpeed"], "StabilityThreshold" -> 
              OptionValue["StabilityThreshold"]], "Realm" -> 
             Lookup[$CellContext`realmName, $CellContext`n, 
               "Unknown"]]], $CellContext`stableScales]]], \
$CellContext`realmName = <|
        0 -> "Planck Foam", 13 -> "Quark Core", 20 -> "QGP", 40 -> 
         "Muon/Pion", 60 -> "Proton/Neutron", 80 -> "Atom Core", 100 -> 
         "Bohr Atom", 120 -> "Molecule", 140 -> "DNA", 160 -> "Organelle", 
         180 -> "Cell", 186 -> "Neural", 200 -> "Human", 220 -> "Planetary", 
         240 -> "Solar System", 260 -> "Galactic", 280 -> "Galaxy Cluster", 
         292 -> "Observable Universe"|>, $CellContext`testResultGrid[
         Pattern[$CellContext`testAssoc, 
          Blank[]]] := Grid[
         Prepend[
          KeyValueMap[{#, 
            #2["Value"], 
            Lookup[#2, "Threshold", ""], 
            #2["Pass"]}& , $CellContext`testAssoc], {
          "Test", "Value", "Threshold", "Pass"}], Frame -> All, 
         Background -> {None, 
           ReplaceAll[{None, {
              Lighter[Red, 0.92], 
              Lighter[Green, 0.92]}}, {
            False -> Lighter[Red, 0.92], True -> Lighter[Green, 0.92]}]}]}; 
     Typeset`initDone$$ = True),
