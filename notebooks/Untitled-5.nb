Cell[CellGroupData[{

Cell["1. Core constants and stable scales", "Section",ExpressionUUID->"0bd5a17f-2f31-8044-9f41-aae7176d20c2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "goldenRatio", ",", "stableScales", ",", "planckLength", ",", 
     "planckTime", ",", "lightSpeed"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"goldenRatio", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}], ",", "80"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"planckLength", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{
     RowBox[{"1.616255", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "35"}]}]}], ",", "\"\<Meters\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"planckTime", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{
     RowBox[{"5.391247", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "44"}]}]}], ",", "\"\<Seconds\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lightSpeed", "=", 
    RowBox[{"Quantity", "[", 
     RowBox[{"299792458", ",", 
      RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableScales", "=", 
   RowBox[{"{", 
