Cell[CellGroupData[{

Cell["3. Toroidal parameterization", "Section",ExpressionUUID->"5e086daa-50e3-0e42-aaef-9f2adc379357"],

Cell[TextData[{
 "We define the standard embedded torus in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["R", FontSlant -> "Plain"], "3"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathbb{R}^3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0eee5f7-4029-574d-ac38-4a56c84204c9"],
 " with major radius ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "108ce18f-302c-3442-845d-ee3f31968a7a"],
 " and minor radius ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "76fe2817-3833-184a-889b-988b808eb028"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", FontSlant -> "Bold"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["u", "TI"], ",", 
             StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 StyleBox["R", "TI"], "+", 
                 StyleBox["r", "TI"], "cos", 
                 StyleBox["v", "TI"]}], ")"}], "cos", 
             StyleBox["u", "TI"], ", ", 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["R", "TI"], "+", 
                 StyleBox["r", "TI"], "cos", 
                 StyleBox["v", "TI"]}], ")"}], "sin", 
             StyleBox["u", "TI"], ", ", 
             StyleBox["r", "TI"], "sin", 
             StyleBox["v", "TI"]}], "}"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\mathbf{x}(u,v) = \\{(R + r \\cos v) \\cos u,\\ (R + r \\cos v) \\sin \
u,\\ r \\sin v\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f0939fb-776e-9b44-99ba-8b797b9264c0"],
 "with both angles periodic on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"[", 
         RowBox[{"0", ",", "2", "\[Pi]"}], "]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "[0,2\\pi]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3a10f59-823d-e742-94c3-03b7a704911e"],
 ". "
}], "Text",ExpressionUUID->"16c52276-35f1-ca4c-83ef-849560144d90"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "torusEmbedding", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"torusEmbedding", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", ",", "v"}], "}"}], ",", 
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"majorRadius", "+", 
          RowBox[{"minorRadius", " ", 
           RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
        RowBox[{"Cos", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"majorRadius", "+", 
          RowBox[{"minorRadius", " ", 
           RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
        RowBox[{"Sin", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"minorRadius", " ", 
        RowBox[{"Sin", "[", "v", "]"}]}]}], "\[IndentingNewLine]", "  ", 
      "}"}]}], "]"}]}], ";"}]}], "Input",ExpressionUUID->"d1a0646e-7d37-1c48-\
a9ed-155c3a79e2c5"],

Cell["Basic periodic closure identities: ", "CodeText",ExpressionUUID->"e878b400-5b4c-944d-a2df-0a4faabbf395"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"toroidalPeriodicClosureRules", ",", "toroidalPeriodicClosureQ"}],
     "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalPeriodicClosureRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"x_", "+", 
         RowBox[{"2", " ", "Pi"}]}], "]"}], ":>", 
       RowBox[{"Cos", "[", "x", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"x_", "+", 
         RowBox[{"2", " ", "Pi"}]}], "]"}], ":>", 
       RowBox[{"Sin", "[", "x", "]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalPeriodicClosureQ", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "embed", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"embed", "=", 
       RowBox[{"torusEmbedding", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Simplify", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"embed", "[", 
           RowBox[{
            RowBox[{"u", "+", 
             RowBox[{"2", " ", "Pi"}]}], ",", "v"}], "]"}], "==", 
          RowBox[{"embed", "[", 
           RowBox[{"u", ",", "v"}], "]"}]}], "&&", 
         RowBox[{
          RowBox[{"embed", "[", 
           RowBox[{"u", ",", 
            RowBox[{"v", "+", 
             RowBox[{"2", " ", "Pi"}]}]}], "]"}], "==", 
          RowBox[{"embed", "[", 
           RowBox[{"u", ",", "v"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"Assumptions", "->", "$Assumptions"}]}], 
       "\[IndentingNewLine]", "  ", "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
   ";"}]}], "Input",ExpressionUUID->"5a6a0165-5e30-6345-ac50-a2e333c5c3c3"],

