 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"5fb1e562-957d-0448-982e-f0f70fcef139"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Scalar fields on the torus", "Section",ExpressionUUID->"5b6a748b-5952-9845-9998-5f6d3ec20e09"],

Cell[TextData[{
 "We define a Fourier-mode basis respecting toroidal periodicity: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Psi]", 
          RowBox[{
            StyleBox["m", "TI"], ",", 
            StyleBox["n", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["u", "TI"], ",", 
             StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["a", "TI"], " ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", "\[Alpha]", "cos", 
            StyleBox["v", "TI"]}]], " ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "(", 
            RowBox[{
              StyleBox["m", "TI"], 
              StyleBox["u", "TI"], "+", 
              StyleBox["n", "TI"], 
              StyleBox["v", "TI"]}], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\psi_{m,n}(u,v) = a\\, e^{-\\alpha \\cos v}\\, e^{i(mu + nv)}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "45cb7e2e-33b1-884f-b178-bc89dadfeae3"],
 "For closure tests based on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", "\[Psi]", 
         SuperscriptBox["|", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "|\\psi|^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7a382b24-f5a0-fe4d-ba88-93bea691e7c3"],
 ", the phase part is periodic and the amplitude envelope remains well \
defined. "
}], "Text",ExpressionUUID->"2cdcbf6c-531c-954e-bc1f-8dfca0c22100"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "toroidalMode", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalMode", "[", 
    RowBox[{"m_Integer", ",", "n_Integer", ",", "amp_", ",", 
     RowBox[{"alpha_", ":", " ", "0"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", ",", "v"}], "}"}], ",", 
     RowBox[{"amp", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "alpha"}], " ", 
        RowBox[{"Cos", "[", "v", "]"}]}], "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"m", " ", "u"}], "+", 
          RowBox[{"n", " ", "v"}]}], ")"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"1d9b6e24-a421-0c45-b908-eb7127ef550f"],

Cell["A real-valued mode alternative is sometimes useful: ", "CodeText",ExpressionUUID->"18215af8-3b5c-ee4d-902d-a4265d67c5f0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "toroidalRealMode", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalRealMode", "[", 
    RowBox[{"m_Integer", ",", "n_Integer", ",", "amp_", ",", 
     RowBox[{"alpha_", ":", " ", "0"}], ",", 
     RowBox[{"beta_", ":", " ", "0"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", ",", "v"}], "}"}], ",", 
     RowBox[{"amp", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "alpha"}], " ", 
        RowBox[{"Cos", "[", "v", "]"}]}], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{
        RowBox[{"m", " ", "u"}], "+", 
        RowBox[{"n", " ", "v"}], "+", "beta"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"cd052738-8748-1549-be4b-32569f557aee"],

