Cell[CellGroupData[{

Cell["12. Smallest-scale toroidal framework summary", "Section",ExpressionUUID->"cb5f6717-0ea8-2349-ae52-c1bef92c1bde"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "smallestScaleToroidalFramework", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"smallestScaleToroidalFramework", "[", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"majorRadius", "=", 
        RowBox[{"3", "/", "2"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"minorRadius", "=", 
        RowBox[{"1", "/", "2"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"closureTargetValue", "=", 
        RowBox[{"goldenPhi", "^", 
         RowBox[{"-", "13"}]}]}]}], "\[IndentingNewLine]", "  ", "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"<|", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"\"\<FrameworkVersion\>\"", 
        "->", "\"\<Phase2.ToroidalGeometry\>\""}], ",", "\[IndentingNewLine]",
        "    ", 
       RowBox[{"\"\<ScaleIndex\>\"", "->", "smallestScaleIndex"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"\"\<Geometry\>\"", "->", 
        RowBox[{"toroidalGeometrySummary", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"\"\<ClosureTarget\>\"", "->", "closureTargetValue"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"\"\<ClosureAmplitudeRule\>\"", "->", 
        RowBox[{"closureAmplitudeRule", "[", 
         RowBox[{
         "majorRadius", ",", "minorRadius", ",", "closureTargetValue"}], 
         "]"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"\"\<Tests\>\"", "->", 
        RowBox[{"smallestScaleToroidalTestSuite", "[", "]"}]}]}], 
      "\[IndentingNewLine]", "  ", "|>"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"9b7ef34b-ea74-0349-9e32-8cf0c0c0720b"],

