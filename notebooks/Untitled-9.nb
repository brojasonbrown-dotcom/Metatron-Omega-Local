 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"2df964cd-9959-f444-aaea-d08f3afd3c12"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Exact normalization of a base mode", "Section",ExpressionUUID->"47e1affe-0813-0a49-b7b2-d70f6a44a2a2"],

Cell[TextData[{
 "Take the simplest complex toroidal mode with no angular winding and a \
constant envelope: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Psi]", 
          RowBox[{"0", ",", "0"}]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["u", "TI"], ",", 
             StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\psi_{0,0}(u,v) = a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "913561f9-36dd-6749-9d94-8930c1fef1c7"],
 "Then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         RowBox[{"[", 
           SubscriptBox["\[Psi]", 
            RowBox[{"0", ",", "0"}]], "]"}], "\[LongEqual]", "|", 
         StyleBox["a", "TI"], 
         SuperscriptBox["|", "2"], 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["torus", FontSlant -> "Plain"]], "\[LongEqual]", "|", 
         StyleBox["a", "TI"], 
         SuperscriptBox["|", "2"], "4", 
         SuperscriptBox["\[Pi]", "2"], 
         StyleBox["R", "TI"], 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "C[\\psi_{0,0}] = |a|^2 A_{\\mathrm{torus}} = |a|^2 4\\pi^2 R r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "85df6b4c-7f42-4247-ba22-e559cd789960"],
 "so exact normalization to a prescribed target ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["c", "TI"], "*"], TraditionalForm], "errors" -> {}, "input" -> 
     "c_*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "00f189d5-c6b0-4e4a-a9fe-ec350ad09aac"],
 " is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", "\[PlusMinus]", 
         SqrtBox[
          FractionBox[
           SubscriptBox[
            StyleBox["c", "TI"], "*"], 
           RowBox[{"4", 
             SuperscriptBox["\[Pi]", "2"], 
             StyleBox["R", "TI"], 
             StyleBox["r", "TI"]}]]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "a = \\pm \\sqrt{\\frac{c_*}{4\\pi^2 R r}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6a2e0450-209c-3045-adcd-28c749cf465d"]
}], "Text",ExpressionUUID->"59a08116-a038-e043-bfbe-130ebe028826"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"constantToroidalMode", ",", "closureAmplitudeRule"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"constantToroidalMode", "[", "amp_", "]"}], ":=", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u", ",", "v"}], "}"}], ",", "amp"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"closureAmplitudeRule", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_", ",", "closureTargetValue_"}],
     "]"}], ":=", 
   RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"amp", "^", "2"}], " ", 
       RowBox[{"torusSurfaceArea", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], "==", 
      "closureTargetValue"}], ",", "\[IndentingNewLine]", "  ", "amp", ",", 
     "\[IndentingNewLine]", "  ", "Reals"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"6ea3eac6-52a4-3445-b36d-aa3870fab05a"],

Cell["Normalized mode constructor: ", "CodeText",ExpressionUUID->"87afb12d-9444-a54d-8552-d03e43c2d5d8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "normalizedConstantToroidalMode", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normalizedConstantToroidalMode", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_", ",", "closureTargetValue_"}],
     "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "ampRule", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"ampRule", "=", 
       RowBox[{"First", "[", 
        RowBox[{"closureAmplitudeRule", "[", 
         RowBox[{
         "majorRadius", ",", "minorRadius", ",", "closureTargetValue"}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{"amp", " ", "/.", " ", "ampRule"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"7ae12a72-1107-6647-88ef-2984ed93e01c"],

