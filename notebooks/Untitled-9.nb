Cell[CellGroupData[{

Cell["11. Smallest-scale toroidal tests", "Section",ExpressionUUID->"28cb8a7e-cce3-a64b-adb9-b5a34dae5444"],

Cell["\<\
We define a self-contained test suite for the geometry module. \
\>", "Text",ExpressionUUID->"9cb1087b-3271-8145-8428-87049d4a7ed3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "smallestScaleToroidalTestSuite", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"smallestScaleToroidalTestSuite", "[", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"majorRadius", "=", 
        RowBox[{"3", "/", "2"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"minorRadius", "=", 
        RowBox[{"1", "/", "2"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"closureTargetValue", "=", 
        RowBox[{"goldenPhi", "^", 
         RowBox[{"-", "13"}]}]}], ",", "\[IndentingNewLine]", "    ", 
       "normalizedPsi", ",", "\[IndentingNewLine]", "    ", "ampRule"}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"ampRule", "=", 
       RowBox[{"First", "[", 
        RowBox[{"closureAmplitudeRule", "[", 
         RowBox[{
         "majorRadius", ",", "minorRadius", ",", "closureTargetValue"}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"normalizedPsi", "=", 
       RowBox[{"normalizedConstantToroidalMode", "[", 
        RowBox[{
        "majorRadius", ",", "minorRadius", ",", "closureTargetValue"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
      RowBox[{"TestReport", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"toroidalPeriodicClosureQ", "[", 
            RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{
           "TestID", "->", "\"\<Toroidal embedding periodic closure\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"torusMetricMatrix", "[", 
             RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], "===", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"majorRadius", "+", 
                   RowBox[{"minorRadius", " ", 
                    RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], "^", "2"}], ",",
                 "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"minorRadius", "^", "2"}]}], "}"}]}], "}"}]}], ",", 
           "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"TestID", "->", "\"\<Induced metric matrix\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"torusAreaElement", "[", 
               RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], ",", 
              "\[IndentingNewLine]", "        ", 
              RowBox[{"Assumptions", "->", "$Assumptions"}]}], 
             "\[IndentingNewLine]", "      ", "]"}], "===", 
            RowBox[{"minorRadius", " ", 
             RowBox[{"(", 
              RowBox[{"majorRadius", "+", 
               RowBox[{"minorRadius", " ", 
                RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}]}]}], ",", 
           "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"TestID", "->", "\"\<Toroidal area element\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"torusSurfaceArea", "[", 
               RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], ",", 
              "\[IndentingNewLine]", "        ", 
              RowBox[{"Assumptions", "->", "$Assumptions"}]}], 
             "\[IndentingNewLine]", "      ", "]"}], "===", 
            RowBox[{"4", " ", 
             RowBox[{"Pi", "^", "2"}], " ", "majorRadius", " ", 
             "minorRadius"}]}], ",", "\[IndentingNewLine]", "      ", "True", 
           ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"TestID", "->", "\"\<Toroidal surface area\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"fieldPeriodicClosureQ", "[", 
            RowBox[{"toroidalMode", "[", 
             RowBox[{"1", ",", "2", ",", "amp", ",", "alpha"}], "]"}], "]"}], 
           ",", "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{
           "TestID", "->", "\"\<Toroidal complex mode periodicity\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"amp", "^", "2"}], " ", 
                RowBox[{"torusSurfaceArea", "[", 
                 RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], " ", "/.",
                " ", 
               RowBox[{"ampRule", "-", "closureTargetValue"}]}], ",", 
              "\[IndentingNewLine]", "        ", 
              RowBox[{"Assumptions", "->", "$Assumptions"}]}], 
             "\[IndentingNewLine]", "      ", "]"}], "==", "0"}], ",", 
           "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{
           "TestID", 
            "->", "\"\<Exact closure amplitude normalization\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Chop", "[", 
             RowBox[{
              RowBox[{"integratedClosureResidual", "[", 
               RowBox[{
               "normalizedPsi", ",", "majorRadius", ",", "minorRadius", ",", 
                "closureTargetValue", ",", "80"}], "]"}], ",", 
              RowBox[{"10", "^", 
               RowBox[{"-", "40"}]}]}], "]"}], "==", "0"}], ",", 
           "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{
           "TestID", 
            "->", "\"\<Numerical integrated closure residual\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "  ", "}"}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"02f36ada-1268-b948-8db9-\
86fe99ecd628"],

