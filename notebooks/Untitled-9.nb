Cell[CellGroupData[{

Cell["6. Toroidal closure functional", "Section",ExpressionUUID->"9fdf5d28-59fb-e247-902e-4750be1a0b99"],

Cell[TextData[{
 "We now define a concrete closure functional over the torus surface: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         RowBox[{"[", "\[Psi]", "]"}], "\[LongEqual]", 
         SubsuperscriptBox["\[Integral]", "0", 
          RowBox[{"2", "\[Pi]"}]], "\[NegativeThinSpace]", 
         SubsuperscriptBox["\[Integral]", "0", 
          RowBox[{"2", "\[Pi]"}]], "|", "\[Psi]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["u", "TI"], ",", 
             StyleBox["v", "TI"]}], ")"}], 
         SuperscriptBox["|", "2"], " ", 
         SqrtBox[
          RowBox[{"det", 
            StyleBox["g", "TI"], 
            RowBox[{"(", 
              RowBox[{
                StyleBox["u", "TI"], ",", 
                StyleBox["v", "TI"]}], ")"}]}]], "\[DifferentialD]", 
         StyleBox["u", "TI"], "\[DifferentialD]", 
         StyleBox["v", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "C[\\psi] = \\int_{0}^{2\\pi}\\!\\int_{0}^{2\\pi} |\\psi(u,v)|^2 \\, \
\\sqrt{\\det g(u,v)} \\, du \\, dv", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec805a71-49f2-b344-abdb-6a45e7cbf542"]
}], "Text",ExpressionUUID->"db7644fb-91dc-b242-9826-8a5d878de42d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "toroidalClosureFunctional", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalClosureFunctional", "[", 
    RowBox[{"psi_", ",", "majorRadius_", ",", "minorRadius_", ",", 
     RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", 
   RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"psi", "[", 
          RowBox[{"u", ",", "v"}], "]"}], "]"}], "^", "2"}], " ", 
       RowBox[{"torusAreaElement", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"u", ",", "0", ",", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", "0", ",", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"WorkingPrecision", "->", "wp"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"AccuracyGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"PrecisionGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
        RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"1ef2716b-f755-8d47-8304-90c2ce111a68"],

Cell["\<\
For exact symbolic work, we also define a symbolic version where possible: \
\>", "CodeText",ExpressionUUID->"06fb4cb7-27d1-9042-b687-388e9c4262d9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "toroidalClosureFunctionalExact", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalClosureFunctionalExact", "[", 
    RowBox[{"psi_", ",", "majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Integrate", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"ComplexExpand", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"psi", "[", 
             RowBox[{"u", ",", "v"}], "]"}], "]"}], "^", "2"}], "]"}], " ", 
         RowBox[{"torusAreaElement", "[", 
          RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]",
       "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"2a0280b5-f1c9-2744-9929-\
fd1f51fdd393"],

Cell["Residual against a target closure value: ", "CodeText",ExpressionUUID->"d6ea37cf-7ce8-4e49-b4d0-fc8cd85c38df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "toroidalClosureResidual", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalClosureResidual", "[", 
    RowBox[{
    "psi_", ",", "majorRadius_", ",", "minorRadius_", ",", 
     "closureTargetValue_", ",", 
     RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"toroidalClosureFunctional", "[", 
       RowBox[{"psi", ",", "majorRadius", ",", "minorRadius", ",", "wp"}], 
       "]"}], "-", "closureTargetValue"}], ",", "wp"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"6b6287a9-0dc0-f143-8692-9a318f972506"],

