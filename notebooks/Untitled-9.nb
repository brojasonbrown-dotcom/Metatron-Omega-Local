Cell[CellGroupData[{

Cell["1. Precision policy and assumptions", "Section",ExpressionUUID->"6be79ce8-c325-3846-947a-756ca735fc7c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "setToroidalFrameworkPrecision", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"setToroidalFrameworkPrecision", "[", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"$Assumptions", "=", 
      RowBox[{
       RowBox[{"Element", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "majorRadius", ",", "minorRadius", ",", "u", ",", "v", ",", "amp", ",",
            "alpha", ",", "beta", ",", "closureTargetValue"}], "}"}], ",", 
         "\[IndentingNewLine]", "      ", "Reals"}], "\[IndentingNewLine]", 
        "    ", "]"}], "&&", 
       RowBox[{"majorRadius", ">", "0"}], "&&", 
       RowBox[{"minorRadius", ">", "0"}], "&&", 
       RowBox[{"majorRadius", ">", "minorRadius"}], "&&", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"0", "<=", "u", "<=", 
        RowBox[{"2", " ", "Pi"}]}], "&&", 
       RowBox[{"0", "<=", "v", "<=", 
        RowBox[{"2", " ", "Pi"}]}], "&&", 
       RowBox[{"alpha", ">", "0"}], "&&", 
       RowBox[{"beta", ">=", "0"}]}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"$MaxExtraPrecision", "=", "1000"}], ";"}], 
    "\[IndentingNewLine]", ")"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"setToroidalFrameworkPrecision", "[", "]"}], ";"}]}], "Input",Expres\
sionUUID->"6f0f43ce-f6b3-d441-86f4-d86f20c65831"],

Cell[TextData[{
 "As in Phase 1, exact ",
 Cell[BoxData[
  RowBox[{"WorkingPrecision", "->", "Infinity"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "f0b2d7ab-2cd3-ed4d-9b6a-18a69be58184"],
 " is not generally executable for numerical integration. This module \
therefore uses: "
}], "Text",ExpressionUUID->"760dfed7-70f7-564e-89f0-1260021174db"],

Cell["exact symbolic computation where possible,", "Item",ExpressionUUID->"a14f9b6e-7c13-dc48-9348-675b027b9f7b"],

Cell["otherwise high finite precision,", "Item",ExpressionUUID->"44ff70b8-0f06-b040-b061-5dea9872f0da"],

Cell["with explicit residual and convergence checks.", "Item",ExpressionUUID->"ea646537-3ba8-8d4a-a27f-70dc2abaab43"],

