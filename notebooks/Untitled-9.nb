}, Open  ]],

Cell[CellGroupData[{

Cell["8. Closure mismatch and geometric closure tests", "Section",ExpressionUUID->"039bda18-de2e-1340-8f1a-447eadccf0bf"],

Cell["We separate three notions:", "Text",ExpressionUUID->"d6645e79-d009-834a-bac4-417032bffac1"],

Cell[TextData[{
 "1. ",
 StyleBox["Embedding closure",
  FontWeight->Bold],
 ": periodic position matching."
}], "Text",ExpressionUUID->"fe5c0ef5-4957-8942-8a2f-989d41d89acf"],

Cell[TextData[{
 "2. ",
 StyleBox["Field closure",
  FontWeight->Bold],
 ": periodic field matching."
}], "Text",ExpressionUUID->"a50cfe73-de90-614e-b1f3-69fddaf9ec90"],

Cell[TextData[{
 "3. ",
 StyleBox["Integrated closure",
  FontWeight->Bold],
 ": functional matches target value. "
}], "Text",ExpressionUUID->"de0c77d5-fe0e-a347-b840-db4644a0df57"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"fieldPeriodicClosureQ", ",", "integratedClosureResidual"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fieldPeriodicClosureQ", "[", "psi_", "]"}], ":=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"psi", "[", 
         RowBox[{
          RowBox[{"u", "+", 
           RowBox[{"2", " ", "Pi"}]}], ",", "v"}], "]"}], "==", 
        RowBox[{"psi", "[", 
         RowBox[{"u", ",", "v"}], "]"}]}], "&&", 
       RowBox[{
        RowBox[{"psi", "[", 
         RowBox[{"u", ",", 
          RowBox[{"v", "+", 
           RowBox[{"2", " ", "Pi"}]}]}], "]"}], "==", 
        RowBox[{"psi", "[", 
         RowBox[{"u", ",", "v"}], "]"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"integratedClosureResidual", "[", 
    RowBox[{
    "psi_", ",", "majorRadius_", ",", "minorRadius_", ",", 
     "closureTargetValue_", ",", 
     RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"toroidalClosureResidual", "[", 
    RowBox[{
    "psi", ",", "majorRadius", ",", "minorRadius", ",", "closureTargetValue", 
     ",", "wp"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->"68301fae-2e4e-\
cb46-907a-a647ae09bd7e"],

