 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"84ced78b-c538-eb4c-b430-ec9e7af5252f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Tangent vectors, metric, and area element", "Section",ExpressionUUID->"4a8980b7-ba47-e742-86e5-4562592ac63b"],

Cell["\<\
We compute the induced geometry directly from the embedding. \
\>", "Text",ExpressionUUID->"387796b7-9552-294b-829f-e90ef2f2b16f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "torusTangentU", ",", "torusTangentV", ",", "torusMetricMatrix", ",", 
     "torusAreaElement"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusTangentU", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"embed", "=", 
        RowBox[{"torusEmbedding", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"embed", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", "u"}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusTangentV", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"embed", "=", 
        RowBox[{"torusEmbedding", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"embed", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", "v"}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusMetricMatrix", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xu", ",", "xv"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"xu", "=", 
        RowBox[{
         RowBox[{"torusTangentU", "[", 
          RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], "[", 
         RowBox[{"u", ",", "v"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"xv", "=", 
        RowBox[{
         RowBox[{"torusTangentV", "[", 
          RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], "[", 
         RowBox[{"u", ",", "v"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Simplify", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"xu", ".", "xu"}], ",", 
             RowBox[{"xu", ".", "xv"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"xv", ".", "xu"}], ",", 
             RowBox[{"xv", ".", "xv"}]}], "}"}]}], "}"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"Assumptions", "->", "$Assumptions"}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"torusAreaElement", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
   RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"Det", "[", 
       RowBox[{"torusMetricMatrix", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], "]"}], "]"}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"7e6684ec-7a78-794d-8b61-\
af6c52b3ce54"],

Cell[TextData[{
 "For a standard torus this simplifies to: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SqrtBox[
          RowBox[{"det", 
            StyleBox["g", "TI"]}]], "\[LongEqual]", 
         StyleBox["r", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["R", "TI"], "+", 
             StyleBox["r", "TI"], "cos", 
             StyleBox["v", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\sqrt{\\det g} = r (R + r \\cos v)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "326e1cba-571b-c54d-8c1f-a546be171ec4"],
 "which leads to the exact surface area ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", "4", 
         SuperscriptBox["\[Pi]", "2"], 
         StyleBox["R", "TI"], 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "A = 4 \\pi^2 R r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae16a856-2c3d-c840-8c07-a1401039a37c"],
 "implemented below. "
}], "Text",ExpressionUUID->"2d762ad9-7153-7e4b-b9b2-db2587a02d23"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "torusSurfaceArea", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"torusSurfaceArea", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Integrate", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"torusAreaElement", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]",
       "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"13026f62-4cd7-c346-9ffb-\
a5e762609cce"],

