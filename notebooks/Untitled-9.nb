Cell[CellGroupData[{

Cell["9. Geometric and analytic diagnostics", "Section",ExpressionUUID->"e51d44c9-c82f-5447-9f3a-62facb50b538"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "toroidalGeometrySummary", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalGeometrySummary", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Embedding\>\"", "->", 
      RowBox[{"HoldForm", "[", 
       RowBox[{
        RowBox[{"torusEmbedding", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], "[", 
        RowBox[{"u", ",", "v"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<Metric\>\"", "->", 
      RowBox[{"torusMetricMatrix", "[", 
       RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<AreaElement\>\"", "->", 
      RowBox[{"torusAreaElement", "[", 
       RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<SurfaceArea\>\"", "->", 
      RowBox[{"torusSurfaceArea", "[", 
       RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<PeriodicClosureQ\>\"", "->", 
      RowBox[{"toroidalPeriodicClosureQ", "[", 
       RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"26cb73ed-a350-cf42-8ed1-418213797aa6"],

