Cell[CellGroupData[{

Cell["2. Smallest-scale geometric parameters", "Section",ExpressionUUID->"a419d18a-9db5-c447-bb15-ba51231a85b7"],

Cell["\<\
We keep the scale bookkeeping separate from the torus geometry so that the \
module stays reusable. \
\>", "Text",ExpressionUUID->"1f755e64-f2d2-e44e-9877-09e3cb4071ec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "goldenPhi", ",", "planckLength", ",", "smallestScaleIndex", ",", 
     "scaleLength"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"goldenPhi", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"planckLength", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{
     RowBox[{"1.616255", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "35"}]}]}], ",", "\"\<Meters\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"smallestScaleIndex", "=", "0"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleLength", "[", 
    RowBox[{"n_Integer", " ", "?", " ", "NonNegative"}], "]"}], ":=", 
   RowBox[{"UnitSimplify", "[", 
    RowBox[{"planckLength", " ", 
     RowBox[{"goldenPhi", "^", "n"}]}], "]"}]}], ";"}]}], "Input",ExpressionUU\
ID->"97426253-526a-3c42-8d01-f2e9a870b494"],

Cell[TextData[{
 "For the toroidal module we work primarily in ",
 StyleBox["dimensionless coordinates",
  FontWeight->Bold],
 ", and only optionally attach units later. "
}], "Text",ExpressionUUID->"aadb0d5c-a3ef-4c43-9854-606f573e7962"],

