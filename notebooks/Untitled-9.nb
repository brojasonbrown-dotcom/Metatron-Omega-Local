Cell[CellGroupData[{

Cell["10. Precision-refinement utility for closure computations", "Section",ExpressionUUID->"818098c4-072a-094e-99dc-7319ad8dae2f"],

Cell["\<\
This gives an explicit convergence-under-precision scaffold for the toroidal \
closure functional. \
\>", "Text",ExpressionUUID->"c9471b9e-476d-1645-86b1-d0d6c362d829"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "closurePrecisionStudy", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"closurePrecisionStudy", "[", 
    RowBox[{
    "psi_", ",", "majorRadius_", ",", "minorRadius_", ",", 
     "precisions_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "values", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"values", "=", 
       RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{"precisions", ",", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"toroidalClosureFunctional", "[", 
            RowBox[{"psi", ",", "majorRadius", ",", "minorRadius", ",", "#"}],
             "]"}], " ", "&"}], " ", "/@", " ", "precisions"}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Values\>\"", "->", "values"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<PairwiseDifferences\>\"", "->", 
         RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"Rest", "[", "precisions", "]"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"MapThread", "[", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"#1", "-", "#2"}], "]"}], " ", "&"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Most", "[", 
                RowBox[{"Values", "[", "values", "]"}], "]"}], ",", 
               RowBox[{"Rest", "[", 
                RowBox[{"Values", "[", "values", "]"}], "]"}]}], "}"}]}], 
            "\[IndentingNewLine]", "      ", "]"}]}], "\[IndentingNewLine]", 
          "    ", "]"}]}]}], "\[IndentingNewLine]", "  ", "|>"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"b759c1ec-240a-ae48-bc9b-9e5d526ba365"],

