Cell[CellGroupData[{

Cell["13. Interactive exploration interface", "Section",ExpressionUUID->"cca0d81f-8d2c-ad4b-b9c0-d530a3ede966"],

Cell["\<\
This interface lets you explore torus geometry, a simple periodic mode, and \
the corresponding closure functional. \
\>", "Text",ExpressionUUID->"f046a06c-1ed4-7d49-96c3-2aa37a5d3c08"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
      "psi", ",", "area", ",", "closureValue", ",", "residualValue", ",", 
       "plot3D"}], "\[IndentingNewLine]", "  ", "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"psi", "=", 
       RowBox[{"toroidalMode", "[", 
        RowBox[{"m", ",", "n", ",", "amp", ",", "alpha"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"area", "=", 
       RowBox[{"torusSurfaceArea", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"closureValue", "=", 
       RowBox[{"toroidalClosureFunctional", "[", 
        RowBox[{"psi", ",", "majorRadius", ",", "minorRadius", ",", "wp"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"residualValue", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"closureValue", "-", "closureTargetValue"}], ",", "wp"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
      RowBox[{"plot3D", "=", 
       RowBox[{"ParametricPlot3D", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{"torusEmbedding", "[", 
            RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], "[", 
           RowBox[{"u", ",", "v"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"{", 
          RowBox[{"u", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"Mesh", "->", "None"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"PlotPoints", "->", "50"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"ColorFunction", "->", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y", ",", "z", ",", "uu", ",", "vv"}], "}"}], ",", 
            RowBox[{
             RowBox[{"ColorData", "[", "\"\<SolarColors\>\"", "]"}], "[", 
             RowBox[{"Rescale", "[", 
              RowBox[{
               RowBox[{"Re", "[", 
                RowBox[{"psi", "[", 
                 RowBox[{"uu", ",", "vv"}], "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"Abs", "[", "amp", "]"}]}], " ", 
                  RowBox[{"Exp", "[", "alpha", "]"}]}], ",", 
                 RowBox[{
                  RowBox[{"Abs", "[", "amp", "]"}], " ", 
                  RowBox[{"Exp", "[", "alpha", "]"}]}]}], "}"}]}], "]"}], 
             "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"Boxed", "->", "False"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"Axes", "->", "False"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<Closure = \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"closureValue", ",", 
               RowBox[{"{", 
                RowBox[{"12", ",", "8"}], "}"}]}], "]"}], 
             ",", "\"\<, Residual = \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"residualValue", ",", 
               RowBox[{"{", 
                RowBox[{"12", ",", "8"}], "}"}]}], "]"}]}], "}"}], "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Surface area: \>\"", ",", "area"}], "}"}], "]"}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Field periodic: \>\"", ",", 
            RowBox[{"fieldPeriodicClosureQ", "[", "psi", "]"}]}], "}"}], 
          "]"}], ",", "\[IndentingNewLine]", "    ", "plot3D"}], 
        "\[IndentingNewLine]", "  ", "}"}], "]"}]}]}], "\[IndentingNewLine]", 
    " ", "]"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"majorRadius", ",", "1.5", ",", "\"\<Major radius\>\""}], "}"}],
      ",", "0.6", ",", "3", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"minorRadius", ",", "0.5", ",", "\"\<Minor radius\>\""}], "}"}],
      ",", "0.1", ",", "1.2", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", "Delimiter", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "1", ",", "\"\<Mode m\>\""}], "}"}], ",", "0", ",", 
     "6", ",", "1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "\"\<Mode n\>\""}], "}"}], ",", "0", ",", 
     "6", ",", "1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"amp", ",", "0.1", ",", "\"\<Amplitude\>\""}], "}"}], ",", "0", 
     ",", "2", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"alpha", ",", "0", ",", "\"\<Envelope alpha\>\""}], "}"}], ",", 
     "0", ",", "2", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", "Delimiter", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"closureTargetValue", ",", 
       RowBox[{"goldenPhi", "^", 
        RowBox[{"-", "13"}]}], ",", "\"\<Closure target\>\""}], "}"}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}], ",", "1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"wp", ",", "50", ",", "\"\<Working precision\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"30", ",", "50", ",", "80", ",", "100"}], "}"}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"SaveDefinitions", "->", "True"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"b16910fc-74aa-354f-8f0f-408c0394253f"],

