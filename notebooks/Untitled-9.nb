Cell[CellGroupData[{

Cell["14. Recommended next step", "Section",ExpressionUUID->"a1139401-2431-8d4a-8c3d-a329e40c7a2a"],

Cell["\<\
After this toroidal geometry module, the next logically clean addition is:\
\>", "Text",ExpressionUUID->"8c348fc2-4dc9-7d43-aa95-a0ae43001ce8"],

Cell[TextData[{
 "1. add a ",
 StyleBox["field action on the torus",
  FontWeight->Bold],
 " using the induced metric,"
}], "Text",ExpressionUUID->"3bd3b631-7c9f-1a4a-9b5d-3aa1e7eafe0c"],

Cell["2. derive the corresponding Euler\[Dash]Lagrange equations,", "Text",ExpressionUUID->"94852410-d386-0b43-aeba-b59f3ca8d913"],

Cell["3. linearize around a background toroidal mode,", "Text",ExpressionUUID->"efa3d3db-174d-a342-881e-176d9a20d578"],

Cell["4. and then compute the toroidal eigenspectrum.", "Text",ExpressionUUID->"24d68eaf-0552-e343-8fba-17018b6b74a2"],

Cell["\<\
That would connect this notebook cleanly back to the Phase 1 Layer 1 \
refinement path.\
\>", "Text",ExpressionUUID->"1f296eba-f27b-884c-8836-6168e40ec93d"]
}, Open  ]]
}, Open  ]]
},
