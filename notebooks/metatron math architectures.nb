Cell[CellGroupData[{

Cell["4. Resolution Law", "Section",ExpressionUUID->"b31e1528-9e22-2f4f-8e58-b9d517d9b1db"],

Cell["\<\
Each scale carries a characteristic resolution, bandwidth, and sample \
density. \
\>", "Text",ExpressionUUID->"605675df-1268-f446-9196-1b3262523a5a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"resolutionLaw", ",", "bandwidthLaw", ",", "sampleDensityLaw"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"resolutionLaw", "[", 
     RowBox[{"n_", ",", 
      RowBox[{"baseResolution_", ":", " ", "128"}], ",", 
      RowBox[{"scaleRatio_", ":", " ", "phi"}]}], "]"}], ":=", 
    RowBox[{"baseResolution", " ", 
     RowBox[{"scaleRatio", "^", "n"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"bandwidthLaw", "[", 
     RowBox[{"n_", ",", 
      RowBox[{"baseBandwidth_", ":", " ", "1"}], ",", 
      RowBox[{"scaleRatio_", ":", " ", "phi"}]}], "]"}], ":=", 
    RowBox[{"baseBandwidth", "/", 
     RowBox[{"scaleRatio", "^", "n"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sampleDensityLaw", "[", 
     RowBox[{"n_", ",", 
      RowBox[{"baseDensity_", ":", " ", "1"}], ",", 
      RowBox[{"sampleExponent_", ":", " ", "1"}], ",", 
      RowBox[{"scaleRatio_", ":", " ", "phi"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{"baseDensity", " ", 
     RowBox[{"scaleRatio", "^", 
      RowBox[{"(", 
       RowBox[{"sampleExponent", " ", "n"}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", "\[IndentingNewLine]", "   ", 
   RowBox[{
    RowBox[{"<|", "\[IndentingNewLine]", "      ", 
     RowBox[{
      RowBox[{"\"\<n\>\"", "->", "n"}], ",", "\[IndentingNewLine]", "      ", 
      RowBox[{"\"\<Scale\>\"", "->", 
       RowBox[{"scaleLaw", "[", "n", "]"}]}], ",", "\[IndentingNewLine]", 
      "      ", 
      RowBox[{"\"\<Resolution\>\"", "->", 
       RowBox[{"resolutionLaw", "[", "n", "]"}]}], ",", "\[IndentingNewLine]",
       "      ", 
      RowBox[{"\"\<Bandwidth\>\"", "->", 
       RowBox[{"bandwidthLaw", "[", "n", "]"}]}], ",", "\[IndentingNewLine]", 
      "      ", 
      RowBox[{"\"\<SampleDensity\>\"", "->", 
       RowBox[{"sampleDensityLaw", "[", "n", "]"}]}]}], "\[IndentingNewLine]",
      "   ", "|>"}], ",", "\[IndentingNewLine]", "   ", 
    RowBox[{"{", 
     RowBox[{"n", ",", 
      RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "\[IndentingNewLine]", "]"}], 
  " ", "//", " ", "Dataset"}]}], "Input",ExpressionUUID->"6c5b42f0-b3e3-3d4b-\
8bc0-a1871f3d12e1"],

