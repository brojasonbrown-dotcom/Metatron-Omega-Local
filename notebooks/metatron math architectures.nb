Cell[CellGroupData[{

Cell["8. Core Evolution Law", "Section",ExpressionUUID->"231a9e8c-0709-ac40-8109-e5229c285fbc"],

Cell["\<\
The engine evolves by combining propagation, nonlinear coupling, recursive \
memory, cross-scale interaction, and self-measurement feedback. \
\>", "Text",ExpressionUUID->"4963ed4d-65d7-b84e-ab2f-5034f2bb583f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "mrceEvolutionLaw", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mrceEvolutionLaw", "=", 
    RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"omega", "[", "n", "]"}], "[", 
         RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], ",", "t"}], 
       "]"}], "==", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{
        RowBox[{"propOp", "[", "n", "]"}], "[", 
        RowBox[{
         RowBox[{
          RowBox[{"omega", "[", "n", "]"}], "[", 
          RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], ",", 
         RowBox[{
          RowBox[{"mu", "[", "n", "]"}], "[", 
          RowBox[{"x", ",", "t"}], "]"}]}], "]"}], "+", "\[IndentingNewLine]",
        "      ", 
       RowBox[{
        RowBox[{"nonlinearOp", "[", "n", "]"}], "[", 
        RowBox[{
         RowBox[{"omega", "[", "n", "]"}], "[", 
         RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], "]"}], "+", 
       "\[IndentingNewLine]", "      ", 
       RowBox[{"Integrate", "[", "\[IndentingNewLine]", "         ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"kernel", "[", "n", "]"}], "[", 
           RowBox[{"t", "-", "s"}], "]"}], " ", 
          RowBox[{
           RowBox[{"memResponse", "[", "n", "]"}], "[", 
           RowBox[{
            RowBox[{"omega", "[", "n", "]"}], "[", 
            RowBox[{"x", ",", "s", ",", "theta", ",", "mu"}], "]"}], "]"}]}], 
         ",", "\[IndentingNewLine]", "         ", 
         RowBox[{"{", 
          RowBox[{"s", ",", "0", ",", "t"}], "}"}]}], "\[IndentingNewLine]", 
        "      ", "]"}], "+", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"crossScaleOp", "[", "n", "]"}], "[", "\[IndentingNewLine]", 
        "         ", 
        RowBox[{
         RowBox[{
          RowBox[{"omega", "[", 
           RowBox[{"n", "-", "1"}], "]"}], "[", 
          RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], ",", 
         "\[IndentingNewLine]", "         ", 
         RowBox[{
          RowBox[{"omega", "[", "n", "]"}], "[", 
          RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], ",", 
         "\[IndentingNewLine]", "         ", 
         RowBox[{
          RowBox[{"omega", "[", 
           RowBox[{"n", "+", "1"}], "]"}], "[", 
          RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}]}], 
        "\[IndentingNewLine]", "      ", "]"}], "+", "\[IndentingNewLine]", 
       "      ", 
       RowBox[{
        RowBox[{"feedbackOp", "[", "n", "]"}], "[", 
        RowBox[{
         RowBox[{"gamma", "[", "n", "]"}], "[", 
         RowBox[{"omega", "[", "n", "]"}], "]"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "mrceEvolutionLaw"}], \
"Input",ExpressionUUID->"220549d0-5969-8140-b013-107e186ac14d"],

