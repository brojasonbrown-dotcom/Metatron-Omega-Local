Cell[CellGroupData[{

Cell["10. Focus Nodes and Coherence Concentration", "Section",ExpressionUUID->"9769767f-b111-5342-afe6-2ff538a3963d"],

Cell["\<\
Each scale may host one or more focus nodes where coherence, symmetry, \
memory, or stability concentrate. \
\>", "Text",ExpressionUUID->"548c630c-276c-054e-9753-65fbafdd2033"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"focusIntensity", ",", "focusNodeDefinition", ",", "focusStack"}],
     "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"focusIntensity", "[", 
     RowBox[{
     "field_", ",", "memoryTerm_", ",", "stabilityTerm_", ",", "phaseTerm_"}],
      "]"}], ":=", 
    RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"alpha", " ", 
       RowBox[{
        RowBox[{"Abs", "[", "field", "]"}], "^", "2"}]}], "+", 
      RowBox[{"beta", " ", "memoryTerm"}], "+", 
      RowBox[{"gamma", " ", "stabilityTerm"}], "+", 
      RowBox[{"delta", " ", "phaseTerm"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"focusNodeDefinition", "[", "n_", "]"}], ":=", 
    RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"focus", "[", "n", "]"}], "==", 
      RowBox[{"ArgMax", "[", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"focusIntensity", "[", "\[IndentingNewLine]", "         ", 
         RowBox[{
          RowBox[{
           RowBox[{"omega", "[", "n", "]"}], "[", 
           RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], ",", 
          "\[IndentingNewLine]", "         ", 
          RowBox[{
           RowBox[{"memory", "[", "n", "]"}], "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
          "         ", 
          RowBox[{
           RowBox[{"stability", "[", "n", "]"}], "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
          "         ", 
          RowBox[{
           RowBox[{"phaseStability", "[", "n", "]"}], "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "\[IndentingNewLine]", "      ", 
         "]"}], ",", "\[IndentingNewLine]", "      ", 
        RowBox[{"x", " ", "\[Element]", " ", 
         RowBox[{"domain", "[", "n", "]"}]}]}], "\[IndentingNewLine]", "   ", 
       "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"focusStack", "[", 
     RowBox[{"maxScale_Integer", "?", "NonNegative"}], "]"}], ":=", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "      ", 
     RowBox[{
      RowBox[{"scaleIndexSet", "[", "maxScale", "]"}], ",", 
      "\[IndentingNewLine]", "      ", 
      RowBox[{"focusNodeDefinition", " ", "/@", " ", 
       RowBox[{"scaleIndexSet", "[", "maxScale", "]"}]}]}], 
     "\[IndentingNewLine]", "   ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"focusStack", "[", "3", "]"}]}], "Input",ExpressionUUID->"e940d40e-\
2e50-e146-b1ad-518b678b56f7"],

Cell[CellGroupData[{

Cell["Interpretation", "Subsection",ExpressionUUID->"080e3f72-aeb9-0244-b6a6-436eb1df1706"],

Cell["\<\
A focus node is a computational coherence center, not merely a spatial \
maximum. \
\>", "Text",ExpressionUUID->"562aaaeb-53fc-b14c-b59c-1e3f7820e6ad"],

