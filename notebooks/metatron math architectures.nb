Cell[CellGroupData[{

Cell["15. Admissibility Rules", "Section",ExpressionUUID->"677f537d-9356-224e-b62f-7677bb279349"],

Cell["These rules keep the architecture disciplined. ", "Text",ExpressionUUID->"e2cc1d71-6029-f94e-961c-f7070710bdb8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "mrceAdmissibilityRules", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mrceAdmissibilityRules", "=", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", 
          "->", "\"\<All exponential kernel arguments must be \
dimensionless.\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<Critical\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", 
          "->", "\"\<All preferred-ratio effects must enter through explicit \
weighting functions or operators.\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<Critical\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", 
          "->", "\"\<Every cross-scale map must specify what structural \
quantity it preserves.\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<Critical\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", 
          "->", "\"\<Every measurement must be computable from the engine \
state.\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<Critical\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", 
          "->", "\"\<Geometry and dynamics must remain separable for \
comparative testing.\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<High\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", 
          "->", "\"\<Determinism scores must be derived from internal \
metrics, not asserted narratively.\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<High\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", 
          "->", "\"\<Infinite structure must be represented via a refinement \
hierarchy or limit process.\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<High\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", 
          "->", "\"\<Focus nodes must be defined by explicit optimization \
criteria.\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<High\>\""}]}], "|>"}]}], 
      "\[IndentingNewLine]", "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "mrceAdmissibilityRules"}], \
"Input",ExpressionUUID->"bf58423b-7374-7346-8886-668638e3bc7f"],

