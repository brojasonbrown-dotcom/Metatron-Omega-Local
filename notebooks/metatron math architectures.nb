Cell[CellGroupData[{

Cell["9. Self-Measurement Layer", "Section",ExpressionUUID->"e9cff234-88d1-c844-98b6-de04b4b0301d"],

Cell["\<\
A formal engine must explicitly compute its own state metrics. \
\>", "Text",ExpressionUUID->"691660a0-4fed-1945-96ca-252c03f91596"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
    "coherenceFunctional", ",", "\[IndentingNewLine]", "   ", 
     "driftFunctional", ",", "\[IndentingNewLine]", "   ", 
     "uncertaintyFunctional", ",", "\[IndentingNewLine]", "   ", 
     "attractorFunctional", ",", "\[IndentingNewLine]", "   ", 
     "informationDensityFunctional", ",", "\[IndentingNewLine]", "   ", 
     "measurementVector"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"coherenceFunctional", "[", "field_", "]"}], ":=", 
    RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "field", "]"}], "^", "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "domainMeasure"}], "}"}]}], "]"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"driftFunctional", "[", 
     RowBox[{"field_", ",", "reference_"}], "]"}], ":=", 
    RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"field", "-", "reference"}], "]"}], "^", "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "domainMeasure"}], "}"}]}], "]"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"uncertaintyFunctional", "[", "field_", "]"}], ":=", 
    RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{"Variance", "[", "field", "]"}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"attractorFunctional", "[", "field_", "]"}], ":=", 
    RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", "field", "]"}], "^", "4"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "domainMeasure"}], "}"}]}], "]"}], "/", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "field", "]"}], "^", "2"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "domainMeasure"}], "}"}]}], "]"}], "^", "2"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"informationDensityFunctional", "[", "field_", "]"}], ":=", 
    RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "field", "]"}], "^", "2"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"Abs", "[", "field", "]"}], "^", "2"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measurementVector", "[", 
     RowBox[{"field_", ",", "reference_"}], "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<Coherence\>\"", "->", 
       RowBox[{"coherenceFunctional", "[", "field", "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<Drift\>\"", "->", 
       RowBox[{"driftFunctional", "[", 
        RowBox[{"field", ",", "reference"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<Uncertainty\>\"", "->", 
       RowBox[{"uncertaintyFunctional", "[", "field", "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<Attractor\>\"", "->", 
       RowBox[{"attractorFunctional", "[", "field", "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<InformationDensity\>\"", "->", 
       RowBox[{"informationDensityFunctional", "[", "field", "]"}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"measurementVector", "[", 
  RowBox[{
   RowBox[{"HoldForm", "[", 
    RowBox[{
     RowBox[{"omega", "[", "n", "]"}], "[", 
     RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], "]"}], ",", 
   RowBox[{"HoldForm", "[", 
    RowBox[{
     RowBox[{"omegaRef", "[", "n", "]"}], "[", 
     RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], "]"}]}], 
  "]"}]}], "Input",ExpressionUUID->"01ed3695-6daf-1c4e-8779-632afdc3e3fc"],

Cell[CellGroupData[{

Cell["Principle", "Subsection",ExpressionUUID->"964de5e8-da8e-c940-9417-60d4876df348"],

Cell["\<\
Measurement is not commentary. It is a structural part of the evolution law. \
\>", "Text",ExpressionUUID->"15f7d349-56ba-f848-b4f5-c35f7b4a1b09"],

