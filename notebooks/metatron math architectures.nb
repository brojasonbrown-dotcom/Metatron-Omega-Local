Cell[CellGroupData[{

Cell["12. Stability and Attenuation Metrics", "Section",ExpressionUUID->"7d3c7db9-69a8-9a4f-ba01-102d3260ae8a"],

Cell["\<\
The engine requires explicit stability logic and attenuation laws. \
\>", "Text",ExpressionUUID->"9d1d26ed-8b63-334a-91dc-2428fdb5e8e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
    "stabilityScore", ",", "\[IndentingNewLine]", "   ", "attenuationLaw", ",",
      "\[IndentingNewLine]", "   ", "confidenceLower", ",", 
     "\[IndentingNewLine]", "   ", "confidenceUpper", ",", 
     "\[IndentingNewLine]", "   ", "corridorWidth", ",", 
     "\[IndentingNewLine]", "   ", "autonomyMode"}], "\[IndentingNewLine]", 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stabilityScore", "[", 
     RowBox[{"c_", ",", "d_", ",", "a_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"c", " ", "a"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", "d"}], ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"attenuationLaw", "[", 
     RowBox[{"intensity_", ",", "threshold_", ",", 
      RowBox[{"gain_", ":", " ", "1"}]}], "]"}], ":=", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Exp", "[", 
        RowBox[{"gain", " ", 
         RowBox[{"(", 
          RowBox[{"intensity", "-", "threshold"}], ")"}]}], "]"}]}], 
      ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"confidenceLower", "[", "d_", "]"}], ":=", 
    RowBox[{"Max", "[", 
     RowBox[{
      RowBox[{"phi", "^", 
       RowBox[{"-", "2"}]}], ",", 
      RowBox[{"1", "-", "d"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"confidenceUpper", "[", 
     RowBox[{"sigma_", ",", 
      RowBox[{"caution_", ":", " ", "1"}]}], "]"}], ":=", 
    RowBox[{"Min", "[", 
     RowBox[{"caution", ",", 
      RowBox[{"1", "-", 
       RowBox[{"sigma", " ", 
        RowBox[{"phi", "^", 
         RowBox[{"-", "1"}]}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"corridorWidth", "[", 
     RowBox[{"d_", ",", "sigma_", ",", 
      RowBox[{"caution_", ":", " ", "1"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"confidenceUpper", "[", 
      RowBox[{"sigma", ",", "caution"}], "]"}], "-", 
     RowBox[{"confidenceLower", "[", "d", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"autonomyMode", "[", 
     RowBox[{"d_", ",", "sigma_", ",", 
      RowBox[{"caution_", ":", " ", "1"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ciLow", "=", 
        RowBox[{"confidenceLower", "[", "d", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"ciLow", ">", 
         RowBox[{"phi", "^", 
          RowBox[{"-", "1"}]}]}], ",", "\"\<StableExploit\>\"", ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"ciLow", ">", "0.432"}], ",", "\"\<StressMixed\>\"", ",", 
        "\[IndentingNewLine]", "      ", "True", 
        ",", "\"\<CriticalExplore\>\""}], "\[IndentingNewLine]", "   ", 
       "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Dataset", " ", "@", " ", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"<|", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\"\<Drift\>\"", "->", "d"}], ",", "\[IndentingNewLine]", 
        "      ", 
        RowBox[{"\"\<Uncertainty\>\"", "->", "s"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<CILow\>\"", "->", 
         RowBox[{"confidenceLower", "[", "d", "]"}]}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<CIHigh\>\"", "->", 
         RowBox[{"confidenceUpper", "[", "s", "]"}]}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Width\>\"", "->", 
         RowBox[{"corridorWidth", "[", 
          RowBox[{"d", ",", "s"}], "]"}]}], ",", "\[IndentingNewLine]", 
        "      ", 
        RowBox[{"\"\<Mode\>\"", "->", 
         RowBox[{"autonomyMode", "[", 
          RowBox[{"d", ",", "s"}], "]"}]}]}], "\[IndentingNewLine]", "   ", 
       "|>"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"{", 
       RowBox[{"d", ",", 
        RowBox[{"{", 
         RowBox[{"0.1", ",", "0.3", ",", "0.5", ",", "0.8"}], "}"}]}], "}"}], 
      ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"{", 
       RowBox[{"s", ",", 
        RowBox[{"{", 
         RowBox[{"0.1", ",", "0.2", ",", "0.4"}], "}"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], " ", "//", " ", "Flatten"}], " ", "//", 
  " ", "Dataset"}]}], "Input",ExpressionUUID->"81d5de90-6703-2a4f-a930-\
841fdbbd69cd"],

