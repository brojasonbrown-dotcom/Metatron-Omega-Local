 RowBox[{
  RowBox[{
   RowBox[{"mrceScaleSymbols", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<n\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Meaning\>\"", "->", "\"\<Discrete scale index\>\""}], ",", 
