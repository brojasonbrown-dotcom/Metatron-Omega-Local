Cell[CellGroupData[{

Cell["11. Cross-Scale Translation Operators", "Section",ExpressionUUID->"ddb296b0-3f17-5d43-82cb-93187174d940"],

Cell["\<\
A multiscale engine requires explicit translation rules between adjacent \
scales. \
\>", "Text",ExpressionUUID->"300a00b9-7e53-f44c-be40-51469b8feeb9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "upTranslationLaw", ",", "downTranslationLaw", ",", 
     "translationConsistency"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"upTranslationLaw", "[", "n_", "]"}], ":=", 
    RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"upOp", "[", "n", "]"}], "[", 
       RowBox[{
        RowBox[{"omega", "[", "n", "]"}], "[", 
        RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], "]"}], "==", 
      RowBox[{
       RowBox[{"coarseMap", "[", "n", "]"}], "[", 
       RowBox[{
        RowBox[{"omega", "[", "n", "]"}], "[", 
        RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"downTranslationLaw", "[", "n_", "]"}], ":=", 
    RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"downOp", "[", "n", "]"}], "[", 
       RowBox[{
        RowBox[{"omega", "[", "n", "]"}], "[", 
        RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], "]"}], "==", 
      RowBox[{
       RowBox[{"refineMap", "[", "n", "]"}], "[", 
       RowBox[{
        RowBox[{"omega", "[", "n", "]"}], "[", 
        RowBox[{"x", ",", "t", ",", "theta", ",", "mu"}], "]"}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"translationConsistency", "[", "n_", "]"}], ":=", 
    RowBox[{"HoldForm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"gamma", "[", 
        RowBox[{"n", "+", "1"}], "]"}], "[", 
       RowBox[{
        RowBox[{"upOp", "[", "n", "]"}], "[", 
        RowBox[{"omega", "[", "n", "]"}], "]"}], "]"}], " ", "\[TildeTilde]", 
      " ", 
      RowBox[{
       RowBox[{"projectMetric", "[", 
        RowBox[{"n", ",", 
         RowBox[{"n", "+", "1"}]}], "]"}], "[", 
       RowBox[{
        RowBox[{"gamma", "[", "n", "]"}], "[", 
        RowBox[{"omega", "[", "n", "]"}], "]"}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"upTranslationLaw", "[", "0", "]"}], ",", 
   RowBox[{"downTranslationLaw", "[", "0", "]"}], ",", 
   RowBox[{"translationConsistency", "[", "0", "]"}]}], "}"}]}], "Input",Expre\
ssionUUID->"cdc1e2ac-cff2-e84a-9b7f-c5902d0dfc83"],

Cell[CellGroupData[{

Cell["Required property", "Subsection",ExpressionUUID->"642182b5-ed43-ab49-a73f-03a6ef9075db"],

Cell["Translation should preserve at least a selected subset of: ", "Text",ExpressionUUID->"4911c5b7-365f-7f47-a783-5d6942298b2c"],

Cell["attractor class,", "Item",ExpressionUUID->"3dc8674b-11ba-3446-94a3-afdb57614e40"],

Cell["dominant phase structure,", "Item",ExpressionUUID->"42c4e7fc-236e-5d43-b5ca-7464e836bf84"],

Cell["coherence order,", "Item",ExpressionUUID->"10cdee32-20d8-9648-93e1-a6eb27593ccb"],

Cell["normalized information density.", "Item",ExpressionUUID->"41eccf2f-f9db-104a-8b03-4ce8825af290"],

