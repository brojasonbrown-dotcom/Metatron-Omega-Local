Cell[CellGroupData[{

Cell["14. Architectural Associations", "Section",ExpressionUUID->"804c8562-2446-cb46-9d12-d7111b683e51"],

Cell["\<\
A compact symbolic system specification can be stored as an association. \
\>", "Text",ExpressionUUID->"1b561956-b27c-104d-9f50-7c6c49ee3732"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "mrceArchitecture", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mrceArchitecture", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<Name\>\"", 
       "->", "\"\<Metatronic Resonance Computation Engine\>\""}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ScaleLaw\>\"", "->", 
       RowBox[{"HoldForm", "[", 
        RowBox[{"sn", "==", 
         RowBox[{"s0", " ", 
          RowBox[{"phi", "^", "n"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"\"\<GeometryLibrary\>\"", "->", "geometryLibrary"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<PreferredRatios\>\"", "->", "preferredRatios"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<KernelFamilies\>\"", "->", "kernelFamilies"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<EvolutionLaw\>\"", "->", "mrceEvolutionLaw"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<MeasurementLayer\>\"", "->", 
       RowBox[{"<|", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"\"\<Coherence\>\"", "->", 
          RowBox[{"HoldForm", "[", 
           RowBox[{
            RowBox[{"c", "[", "n", "]"}], "[", "t", "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"\"\<Drift\>\"", "->", 
          RowBox[{"HoldForm", "[", 
           RowBox[{
            RowBox[{"d", "[", "n", "]"}], "[", "t", "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"\"\<Uncertainty\>\"", "->", 
          RowBox[{"HoldForm", "[", 
           RowBox[{
            RowBox[{"sigma", "[", "n", "]"}], "[", "t", "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"\"\<Attractor\>\"", "->", 
          RowBox[{"HoldForm", "[", 
           RowBox[{
            RowBox[{"a", "[", "n", "]"}], "[", "t", "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"\"\<InformationDensity\>\"", "->", 
          RowBox[{"HoldForm", "[", 
           RowBox[{
            RowBox[{"rhoI", "[", "n", "]"}], "[", 
            RowBox[{"x", ",", "t"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
        "   ", "|>"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<FocusNodeLaw\>\"", "->", 
       RowBox[{"focusNodeDefinition", "[", "0", "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<TranslationLaw\>\"", "->", 
       RowBox[{"translationConsistency", "[", "0", "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<DeterminismMetric\>\"", "->", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"delta", "[", "n", "]"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"c", "[", "n", "]"}], "[", "t", "]"}], " ", 
            RowBox[{
             RowBox[{"a", "[", "n", "]"}], "[", "t", "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{
             RowBox[{"d", "[", "n", "]"}], "[", "t", "]"}], "+", 
            RowBox[{
             RowBox[{"sigma", "[", "n", "]"}], "[", "t", "]"}]}], ")"}]}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "mrceArchitecture"}], \
"Input",ExpressionUUID->"c394fadb-7095-a54c-a525-9e75369b15ab"],

