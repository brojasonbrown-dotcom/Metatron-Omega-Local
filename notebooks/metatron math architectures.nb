Cell[CellGroupData[{

Cell["13. Determinism-Oriented Refinement Metrics", "Section",ExpressionUUID->"41447f16-56d9-1f4d-acf7-69bf81b6ebef"],

Cell["\<\
Determinism is represented as an emergent score based on coherence, \
stability, drift, and uncertainty. \
\>", "Text",ExpressionUUID->"8b10dc18-f490-b24b-a70b-a87aa4d7d1e1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "determinismScore", ",", "globalDeterminismScore", ",", 
     "refinementGain"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"determinismScore", "[", 
     RowBox[{"c_", ",", "a_", ",", "d_", ",", "sigma_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"c", " ", "a"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", "d", "+", "sigma"}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"globalDeterminismScore", "[", 
     RowBox[{
     "scoreAssociation_Association", ",", "weightAssociation_Association"}], 
     "]"}], ":=", "\[IndentingNewLine]", "   ", 
    RowBox[{"Total", "[", 
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"weightAssociation", "[", "#1", "]"}], " ", "#2"}], " ", 
        "&"}], ",", "scoreAssociation"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"refinementGain", "[", 
     RowBox[{"before_", ",", "after_"}], "]"}], ":=", 
    RowBox[{"after", "-", "before"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scoreExample", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], "->", "0.31"}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "->", "0.44"}], ",", 
     RowBox[{"0", "->", "0.66"}], ",", 
     RowBox[{"1", "->", "0.72"}], ",", 
     RowBox[{"2", "->", "0.81"}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"weightExample", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "->", "1"}], ",", 
      RowBox[{
       RowBox[{"-", "1"}], "->", "2"}], ",", 
      RowBox[{"0", "->", "3"}], ",", 
      RowBox[{"1", "->", "2"}], ",", 
      RowBox[{"2", "->", "1"}]}], "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"<|", "\[IndentingNewLine]", "   ", 
  RowBox[{
   RowBox[{"\"\<GlobalDeterminism\>\"", "->", 
    RowBox[{"globalDeterminismScore", "[", 
     RowBox[{"scoreExample", ",", "weightExample"}], "]"}]}], ",", 
   "\[IndentingNewLine]", "   ", 
   RowBox[{"\"\<RefinementGainExample\>\"", "->", 
    RowBox[{"refinementGain", "[", 
     RowBox[{"0.62", ",", "0.77"}], "]"}]}]}], "\[IndentingNewLine]", 
  "|>"}]}], "Input",ExpressionUUID->"1b4d1768-a0fc-df4e-a10d-db80d59e828f"],

Cell[CellGroupData[{

Cell["Interpretation", "Subsection",ExpressionUUID->"20e9bcf5-ebb0-3c42-ae40-6ae875f0e145"],

Cell["\<\
The engine computes toward usable determinism by increasing: \
\>", "Text",ExpressionUUID->"ea4062ea-1af6-4c49-bef3-4b20a143ba72"],

Cell["coherence,", "Item",ExpressionUUID->"7e9c8273-662e-4c4d-a296-1fb1216dab3f"],

Cell["attractor persistence,", "Item",ExpressionUUID->"c5d547e1-0dc9-5946-98e6-580f01562c4e"],

Cell["scale consistency,", "Item",ExpressionUUID->"99cc8379-9d0c-a748-883f-8ce287a43058"],

Cell["while decreasing: ", "Text",ExpressionUUID->"ba97b50c-95e5-7149-b104-c3a7136d040e"],

Cell["drift,", "Item",ExpressionUUID->"d4556575-de33-3242-b073-9ee676239628"],

Cell["uncertainty,", "Item",ExpressionUUID->"1f4bb193-63bf-aa46-866b-02c4593c8103"],

Cell["destructive attenuation.", "Item",ExpressionUUID->"a0872266-e68b-504c-9cf5-4b6f893c245b"],

