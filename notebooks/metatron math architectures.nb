Cell[CellGroupData[{

Cell["7. Kernel Families", "Section",ExpressionUUID->"f9e4d598-98d9-3940-9b0c-006c953aa6f3"],

Cell["\<\
Recursive memory and attenuation require a library of kernel families. \
\>", "Text",ExpressionUUID->"f8511c74-04bf-3d44-85a6-aef66f771995"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "kernelFamilies", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kernelFamilies", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<Exponential\>\"", "->", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"kernel", "[", "n", "]"}], "[", "tau_", "]"}], ":=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "tau"}], "/", 
           RowBox[{"taum", "[", "n", "]"}]}], "]"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<GaussianMemory\>\"", "->", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"kernel", "[", "n", "]"}], "[", "tau_", "]"}], ":=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"tau", "^", "2"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{
              RowBox[{"sigmam", "[", "n", "]"}], "^", "2"}]}], ")"}]}], 
          "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<PowerLaw\>\"", "->", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"kernel", "[", "n", "]"}], "[", "tau_", "]"}], ":=", 
         RowBox[{"1", "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"tau", "/", 
              RowBox[{"t0", "[", "n", "]"}]}]}], ")"}], "^", 
           RowBox[{"alpha", "[", "n", "]"}]}]}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<GoldenDecay\>\"", "->", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"kernel", "[", "n", "]"}], "[", "tau_", "]"}], ":=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "tau"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"taum", "[", "n", "]"}], " ", "phi"}], ")"}]}], "]"}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<OscillatoryMemory\>\"", "->", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"kernel", "[", "n", "]"}], "[", "tau_", "]"}], ":=", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "tau"}], "/", 
            RowBox[{"taum", "[", "n", "]"}]}], "]"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{"omega0", "[", "n", "]"}], " ", "tau"}], "]"}]}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "kernelFamilies"}], "Input",\
ExpressionUUID->"658e7737-0f4b-4f46-b352-7fe9739b84c9"],

Cell[CellGroupData[{

Cell["Kernel selection criteria", "Subsection",ExpressionUUID->"84d19960-1ab4-5a42-96b6-3af3f46850e5"],

Cell["A valid kernel family should be evaluated for: ", "Text",ExpressionUUID->"1b0abb65-f24e-5643-962e-c9b80a707862"],

Cell["dimensional admissibility,", "Item",ExpressionUUID->"db2c2843-67c9-764f-9d3f-4b9107f7bfe6"],

Cell["computational tractability,", "Item",ExpressionUUID->"8e5b414a-ca4d-6a42-ae95-87250c83c69c"],

Cell["memory depth control,", "Item",ExpressionUUID->"53966cd0-b143-2a4d-8ca5-6e4d2d2d2100"],

Cell["spectral smoothness,", "Item",ExpressionUUID->"8f6ae3a9-a45a-974b-9801-b182352e7ef6"],

Cell["stability under refinement.", "Item",ExpressionUUID->"1faced18-2645-7d41-a8d2-c9b6884e0458"],

