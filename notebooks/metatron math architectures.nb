Cell[CellGroupData[{

Cell["17. Immediate Next Formal Tasks", "Section",ExpressionUUID->"38c8f41c-1ce6-2247-8195-6da8cfd4817a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "mrceNextTasks", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mrceNextTasks", "=", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Task\>\"", 
          "->", "\"\<Specify a concrete toy evolution operator family\>\""}], 
         ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<Critical\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Task\>\"", 
          "->", "\"\<Choose one initial geometry and one alternative \
comparison geometry\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<Critical\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Task\>\"", 
          "->", "\"\<Define computational forms of coherence, drift, \
uncertainty, and attractor scores\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<Critical\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Task\>\"", 
          "->", "\"\<Define the first explicit cross-scale translation \
operator\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<High\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Task\>\"", 
          "->", "\"\<Implement the first focus-node extractor \
numerically\>\""}], ",", 
         RowBox[{"\"\<Priority\>\"", "->", "\"\<High\>\""}]}], "|>"}], ",", 
