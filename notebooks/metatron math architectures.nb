Cell[CellGroupData[{

Cell["3. Scale Law", "Section",ExpressionUUID->"c50d1821-736f-714d-a65e-5510e670b5ad"],

Cell["The engine is built on an explicit scale lattice. ", "Text",ExpressionUUID->"342d100c-bb54-cd41-b710-dc65be71631c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "phi", ",", "scaleLaw", ",", "scaleIndexSet", ",", "scaleAssociation"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phi", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleLaw", "[", 
     RowBox[{"n_", ",", 
      RowBox[{"s0_", ":", " ", "1"}], ",", 
      RowBox[{"scaleRatio_", ":", " ", "phi"}]}], "]"}], ":=", 
    RowBox[{"s0", " ", 
     RowBox[{"scaleRatio", "^", "n"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleIndexSet", "[", 
     RowBox[{"maxScale_Integer", "?", "NonNegative"}], "]"}], ":=", 
    RowBox[{"Range", "[", 
     RowBox[{
      RowBox[{"-", "maxScale"}], ",", "maxScale"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleAssociation", "[", 
     RowBox[{
      RowBox[{"maxScale_Integer", "?", "NonNegative"}], ",", 
      RowBox[{"s0_", ":", " ", "1"}], ",", 
      RowBox[{"scaleRatio_", ":", " ", "phi"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "      ", 
     RowBox[{
      RowBox[{"scaleIndexSet", "[", "maxScale", "]"}], ",", 
      "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{
        RowBox[{"scaleLaw", "[", 
         RowBox[{"#", ",", "s0", ",", "scaleRatio"}], "]"}], " ", "&"}], " ", 
       "/@", " ", 
       RowBox[{"scaleIndexSet", "[", "maxScale", "]"}]}]}], 
     "\[IndentingNewLine]", "   ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"scaleAssociation", "[", "4", "]"}]}], "Input",ExpressionUUID->\
"d639a645-5b5d-a047-aaa8-f0bd11d13892"],

Cell[CellGroupData[{

Cell["Remarks", "Subsection",ExpressionUUID->"a72b546b-99c3-164e-8bf7-623a81d23533"],

Cell[TextData[{
 "The default ratio is the golden ratio ",
 StyleBox["phi", "TI"],
 "."
}], "Item",ExpressionUUID->"7559cf5a-bd30-3244-9ae8-d9c5a4680a3d"],

Cell["\<\
Alternate scale ratios may be used for comparative architectures.\
\>", "Item",ExpressionUUID->"6a9cadfa-3a29-0c46-bad3-38877d035680"],

Cell["\<\
The engine should treat the scale law as configurable, not dogmatic.\
\>", "Item",ExpressionUUID->"9a6ce452-8898-3c42-83f0-e2cbce338e52"],

