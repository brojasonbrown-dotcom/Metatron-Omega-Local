Cell[BoxData[
 RowBox[{
  RowBox[{"state", "[", "s_", "]"}], ":=", 
  RowBox[{"<|", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"\"\<ScaleIndex\>\"", "->", "s"}], ",", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"\"\<InformationDensity\>\"", "->", 
     RowBox[{"rho", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<FieldComplexity\>\"", "->", 
     RowBox[{"chi", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Resolution\>\"", "->", 
     RowBox[{"res", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Curvature\>\"", "->", 
     RowBox[{"kappa", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Torsion\>\"", "->", 
     RowBox[{"tau", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<ClosurePhase\>\"", "->", 
     RowBox[{"theta", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<ToroidalRadiusMajor\>\"", "->", 
     RowBox[{"rMajor", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<ToroidalRadiusMinor\>\"", "->", 
     RowBox[{"rMinor", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Flux\>\"", "->", 
     RowBox[{"phiFlux", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Decoherence\>\"", "->", 
     RowBox[{"gamma", "[", "s", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<BoundaryCoupling\>\"", "->", 
     RowBox[{"beta", "[", "s", "]"}]}]}], "\[IndentingNewLine]", 
   "|>"}]}]], "Input",ExpressionUUID->"aa6e3cca-0d2b-de4c-98a2-99c163a4b272"],

Cell["A toroidal closure descriptor: ", "CodeText",ExpressionUUID->"7585ad75-5d47-7743-8d80-12e55b6f4422"],

Cell[BoxData[
 RowBox[{
  RowBox[{"toroidalDescriptor", "[", "s_", "]"}], ":=", 
  RowBox[{"<|", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"\"\<AspectRatio\>\"", "->", 
     RowBox[{
      RowBox[{"rMajor", "[", "s", "]"}], "/", 
      RowBox[{"rMinor", "[", "s", "]"}]}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<ClosureRatio\>\"", "->", 
     RowBox[{"Exp", "[", 
      RowBox[{"-", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"theta", "[", "s", "]"}], "-", 
         RowBox[{"2", " ", "Pi", " ", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"theta", "[", "s", "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "Pi"}], ")"}]}], "]"}]}]}], "]"}]}], "]"}]}], ",",
     "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<CurvatureTorsionBalance\>\"", "->", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"kappa", "[", "s", "]"}], "-", 
          RowBox[{"tau", "[", "s", "]"}]}], "]"}]}], ")"}]}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<FluxContainment\>\"", "->", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"phiFlux", "[", "x", "]"}], ",", "x"}], "]"}], " ", "/.", 
          " ", 
          RowBox[{"x", "->", "s"}]}], "]"}]}], ")"}]}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<BoundaryIntegrity\>\"", "->", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"beta", "[", "s", "]"}], "-", "1"}], "]"}]}], ")"}]}]}], ",",
     "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<MaintenanceFactor\>\"", "->", 
     RowBox[{"Exp", "[", 
      RowBox[{"-", 
       RowBox[{"gamma", "[", "s", "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "|>"}]}]], "Input",ExpressionUUID->"70c5b636-5aa6-1544-bdf9-494b303b1962"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Variational base", "Section",ExpressionUUID->"1fcf4fa3-43ea-3949-b1d9-823c8658aea8"],

Cell["Using the OPF-style layer-1 action: ", "CodeText",ExpressionUUID->"7afe60e2-94ea-3a45-b555-82b17b1c3bab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"actionDensity", "[", 
   RowBox[{"rho_", ",", "chi_", ",", "res_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"rho", " ", 
    RowBox[{"Log", "[", "chi", "]"}]}], "+", 
   RowBox[{"chi", " ", 
    RowBox[{"res", "^", "2"}]}]}]}]], "Input",ExpressionUUID->"630f5971-bbc4-\
8e45-b76f-e3f6b54b239c"],

Cell["\<\
A generalized extended action for toroidal stability can be explored as: \
\>", "CodeText",ExpressionUUID->"d9542124-cb44-1d4f-82f2-898c8b2d72aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"extendedActionDensity", "[", "s_", "]"}], ":=", 
  "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"rho", "[", "s", "]"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"chi", "[", "s", "]"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"chi", "[", "s", "]"}], " ", 
    RowBox[{
     RowBox[{"res", "[", "s", "]"}], "^", "2"}]}], "+", "\[IndentingNewLine]",
    "  ", 
   RowBox[{"lambda1", " ", 
    RowBox[{
     RowBox[{"kappa", "[", "s", "]"}], "^", "2"}]}], "+", 
   RowBox[{"lambda2", " ", 
    RowBox[{
     RowBox[{"tau", "[", "s", "]"}], "^", "2"}]}], "+", "\[IndentingNewLine]",
    "  ", 
   RowBox[{"lambda3", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"theta", "[", "s", "]"}], "-", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"n", "[", "s", "]"}]}]}], ")"}], "^", "2"}]}], "+", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"lambda4", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"rMajor", "[", "s", "]"}], "/", 
        RowBox[{"rMinor", "[", "s", "]"}]}], "-", "phi"}], ")"}], "^", 
     "2"}]}], "+", "\[IndentingNewLine]", "  ", 
   RowBox[{"lambda5", " ", 
    RowBox[{
     RowBox[{"gamma", "[", "s", "]"}], "^", "2"}]}]}]}]], "Input",ExpressionUU\
ID->"d49d0a46-1f7d-e447-a809-3d897381cc87"],

Cell[TextData[{
 "with ",
 Cell[BoxData[Cell["phi = (1 + Sqrt[5])/2",
   Background->None,ExpressionUUID->"9919f440-d400-5d4a-ad1f-828753a91c76"]], 
  "InlineCode",ExpressionUUID->"89aee4f8-e527-1b40-8031-ed5b7e820d16"],
 ". "
}], "Text",ExpressionUUID->"afc19a21-1439-984c-9cb4-738ae2b9ebfe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Proposed 18 stable scales", "Section",ExpressionUUID->"6d560e6e-a4c7-8442-ab19-40fa7464ecaf"],

Cell["\<\
These are placeholders for a fully refined classification. Each scale should \
have its own test vector and admissibility region. \
\>", "Text",ExpressionUUID->"e02df47d-6151-5640-9b78-4267b74e498d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"stableScales", "=", 
   RowBox[{"Range", "[", "18", "]"}]}], ";"}]], "Input",ExpressionUUID->\
"514f6533-fc7c-0943-a9eb-84ef3a076966"],

Cell[TextData[{
 "For each scale ",
 StyleBox["s", "TI"],
 ", compute a stability record: "
}], "CodeText",ExpressionUUID->"6f790736-70c6-3346-9fa9-6a317ce42156"],

Cell[BoxData[
 RowBox[{
  RowBox[{"stabilityRecord", "[", "s_", "]"}], ":=", 
  RowBox[{"<|", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"\"\<Scale\>\"", "->", "s"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<ClosureRatio\>\"", "->", 
     RowBox[{
      RowBox[{"toroidalDescriptor", "[", "s", "]"}], 
      "[", "\"\<ClosureRatio\>\"", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<CurvatureTorsionBalance\>\"", "->", 
     RowBox[{
      RowBox[{"toroidalDescriptor", "[", "s", "]"}], 
      "[", "\"\<CurvatureTorsionBalance\>\"", "]"}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<FluxContainment\>\"", "->", 
     RowBox[{
      RowBox[{"toroidalDescriptor", "[", "s", "]"}], 
      "[", "\"\<FluxContainment\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"\"\<BoundaryIntegrity\>\"", "->", 
     RowBox[{
      RowBox[{"toroidalDescriptor", "[", "s", "]"}], 
      "[", "\"\<BoundaryIntegrity\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"\"\<MaintenanceFactor\>\"", "->", 
     RowBox[{
      RowBox[{"toroidalDescriptor", "[", "s", "]"}], 
      "[", "\"\<MaintenanceFactor\>\"", "]"}]}]}], "\[IndentingNewLine]", 
   "|>"}]}]], "Input",ExpressionUUID->"afee2536-bb4c-e848-9176-e4f2d04b4dc3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Confidence corridor adaptation", "Section",ExpressionUUID->"4cc396a4-f5ec-d441-afa8-2dbfa35b6808"],

Cell["\<\
Map the confidence corridor image into symbolic computation: \
\>", "CodeText",ExpressionUUID->"dbb8b9cc-3250-7f49-8575-7ed5653d59da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"phi", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phiInv", "=", 
   RowBox[{"1", "/", "phi"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phiInv2", "=", 
    RowBox[{"1", "/", 
     RowBox[{"phi", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"confidenceCorridor", "[", 
   RowBox[{"vfeNorm_", ",", "sigmaNorm_", ",", 
    RowBox[{"phiCaution_", ":", " ", "phiInv"}]}], "]"}], ":=", 
  RowBox[{"<|", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"\"\<CILower\>\"", "->", 
     RowBox[{"Max", "[", 
      RowBox[{"phiInv2", ",", 
       RowBox[{"1", "-", "vfeNorm"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"\"\<CIUpper\>\"", "->", 
     RowBox[{"Min", "[", 
      RowBox[{"phiCaution", ",", 
       RowBox[{"1", "-", 
        RowBox[{"sigmaNorm", " ", "phiInv"}]}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Regime\>\"", "->", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"phiInv2", ",", 
          RowBox[{"1", "-", "vfeNorm"}]}], "]"}], ">", "phiInv"}], 
       ",", "\"\<Stable\>\"", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"phiInv2", ",", 
          RowBox[{"1", "-", "vfeNorm"}]}], "]"}], ">", "0.432"}], 
       ",", "\"\<Stress\>\"", ",", "\[IndentingNewLine]", "    ", "True", 
       ",", "\"\<Critical\>\""}], "\[IndentingNewLine]", "  ", "]"}]}]}], 
   "\[IndentingNewLine]", "|>"}]}]}], "Input",ExpressionUUID->"b1cf1047-ae46-\
0f4d-a1bc-c5285b7cb0bf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Eighteen rigorous tests", "Section",ExpressionUUID->"7b9097b9-4175-ca4d-9725-7fa572568108"],

Cell["\<\
Each test should be computable, falsifiable, and numerically checkable with \
residuals. \
\>", "Text",ExpressionUUID->"8abb02da-dad1-aa4d-a1b0-765961df0591"],

Cell[BoxData[
 RowBox[{
  RowBox[{"testSuite", "[", "stateAssoc_", "]"}], ":=", 
  RowBox[{"<|", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"\"\<Test01_ClosurePhaseLock\>\"", "->", 
     RowBox[{
      RowBox[{"stateAssoc", "[", "\"\<ClosureRatio\>\"", "]"}], ">=", 
      "phiInv2"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test02_CurvatureTorsionBalance\>\"", "->", 
     RowBox[{
      RowBox[{"stateAssoc", "[", "\"\<CurvatureTorsionBalance\>\"", "]"}], ">=",
       "phiInv2"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test03_FluxContainment\>\"", "->", 
     RowBox[{
      RowBox[{"stateAssoc", "[", "\"\<FluxContainment\>\"", "]"}], ">=", 
      "phiInv2"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test04_BoundaryIntegrity\>\"", "->", 
     RowBox[{
      RowBox[{"stateAssoc", "[", "\"\<BoundaryIntegrity\>\"", "]"}], ">=", 
      "phiInv2"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test05_MaintenanceFactor\>\"", "->", 
     RowBox[{
      RowBox[{"stateAssoc", "[", "\"\<MaintenanceFactor\>\"", "]"}], ">=", 
      "phiInv2"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test06_PositiveDensity\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test07_PositiveComplexity\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test08_PositiveResolution\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test09_AspectRatioBound\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test10_VariationalResidual\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test11_EigenmodeNeutrality\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test12_ScaleInvariance\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test13_BoundaryDualConsistency\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test14_MeasurementIntegrability\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test15_PrecisionConvergence\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test16_PipelineComposability\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test17_SymbolicReducibility\>\"", "->", "True"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Test18_CorridorClassification\>\"", "->", "True"}]}], 
   "\[IndentingNewLine]", "|>"}]}]], "Input",ExpressionUUID->"8d42650f-0cec-\
7740-be35-f522757a426b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Precision policy", "Section",ExpressionUUID->"e1151faa-4342-e344-a0c0-d0b7ff9381e9"],

Cell["\<\
For practical computation, use arbitrary precision aggressively, while noting \
that literal infinite working precision is not available for most numerical \
algorithms. \
\>", "Text",ExpressionUUID->"abc3c9cc-f855-a846-9daf-57382969dbc6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"precisionPolicy", "[", 
   RowBox[{"prec_", ":", " ", "100"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"$MaxPrecision", "=", "prec"}], ",", 
      RowBox[{"$MinPrecision", "=", "0"}]}], "}"}], ",", "prec"}], 
   "]"}]}]], "Input",ExpressionUUID->"e49ad9c3-d779-d344-9585-a9055e79ec8a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. TypeScript computational architecture", "Section",ExpressionUUID->"ae7595f8-fbc5-214d-ad5b-2f725d9e2d71"],

Cell["Suggested file structure: ", "Text",ExpressionUUID->"797ba6ca-19a1-224d-9e96-fe1046e893c6"],

Cell["\<\
src/
  core/
    types.ts
    constants.ts
    state.ts
    invariants.ts
    corridor.ts
    eigen.ts
    residuals.ts
    tests.ts
