           FrameBox[
            TagBox[GridBox[{
               {
                ItemBox[
                 PaneBox[
                  StyleBox["\<\"INPUT\"\>",
                   StripOnInput->False,
                   FontSize->11],
                  FrameMargins->{{5, 5}, {1, 1}}],
                 Background->LightDarkSwitched[
                   GrayLevel[0.95], 
                   GrayLevel[0.15295]],
