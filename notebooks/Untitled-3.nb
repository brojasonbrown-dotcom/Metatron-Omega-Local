  validation/
    schemas.ts
    assertions.ts
  index.ts\
\>", "Program",ExpressionUUID->"31ec89aa-b4dc-1545-9d50-bf3f2d595db5"],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[Cell["src/core/types.ts",
  Background->None,ExpressionUUID->
  "1ccada1b-ab5b-7b4c-9b5e-4a46c8e3073e"]], \
"InlineCode",ExpressionUUID->"f2be55fc-3626-fa46-ae30-9288588c13a1"]], \
"Subsection",ExpressionUUID->"b9af2686-a0b8-194f-91a0-29bd30e5710e"],

Cell["\<\
export type ScaleIndex = number;

export interface ScaleState {
  scaleIndex: ScaleIndex;
  informationDensity: number;
  fieldComplexity: number;
  resolution: number;
  curvature: number;
  torsion: number;
  closurePhase: number;
  toroidalRadiusMajor: number;
  toroidalRadiusMinor: number;
  flux: number;
  decoherence: number;
  boundaryCoupling: number;
}

export interface StabilityDescriptor {
  aspectRatio: number;
  closureRatio: number;
  curvatureTorsionBalance: number;
  fluxContainment: number;
  boundaryIntegrity: number;
  maintenanceFactor: number;
}

export interface ConfidenceCorridor {
  ciLower: number;
  ciUpper: number;
  regime: \"Stable\" | \"Stress\" | \"Critical\";
}\
\>", "Program",ExpressionUUID->"7660aead-4ae3-cb45-9dcd-8adb6bfa3db0"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[Cell["src/core/constants.ts",
  Background->None,ExpressionUUID->
  "42dad292-3bda-e140-922e-3bc6db895adb"]], \
"InlineCode",ExpressionUUID->"bf8f4cef-6574-3e41-8d58-df95f3ff6d95"]], \
"Subsection",ExpressionUUID->"d8e13bcd-eb8d-d642-858e-fadb548aadbb"],

Cell["\<\
export const goldenRatio = (1 + Math.sqrt(5)) / 2;
export const goldenInverse = 1 / goldenRatio;
export const goldenInverseSquared = 1 / (goldenRatio * goldenRatio);
export const stableScaleCount = 18;\
\>", "Program",ExpressionUUID->"dc3e4ec8-4c83-084d-923d-ae129bb8ee55"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[Cell["src/core/invariants.ts",
  Background->None,ExpressionUUID->
  "5184f070-7134-9648-9504-3d009fbc4be8"]], \
"InlineCode",ExpressionUUID->"e2cb48ab-3500-af4f-bf2b-e0f7516122d6"]], \
"Subsection",ExpressionUUID->"1e75faa3-3607-5b4d-ad42-b1a1a66ba65c"],

Cell["\<\
import { ScaleState, StabilityDescriptor } from \"./types\";

export function computeDescriptor(state: ScaleState): StabilityDescriptor {
  const aspectRatio = state.toroidalRadiusMajor / state.toroidalRadiusMinor;
  const phaseOffset = Math.abs(
    state.closurePhase - 2 * Math.PI * Math.round(state.closurePhase / (2 * \
Math.PI))
  );

  return {
    aspectRatio,
    closureRatio: Math.exp(-phaseOffset),
    curvatureTorsionBalance: 1 / (1 + Math.abs(state.curvature - \
state.torsion)),
    fluxContainment: 1 / (1 + Math.abs(state.flux)),
    boundaryIntegrity: 1 / (1 + Math.abs(state.boundaryCoupling - 1)),
    maintenanceFactor: Math.exp(-state.decoherence)
  };
}\
\>", "Program",ExpressionUUID->"d7255632-47fb-754d-a111-291a7e6004be"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[Cell["src/core/corridor.ts",
  Background->None,ExpressionUUID->
  "aec2d77c-c689-1447-80c6-5f8628e711c2"]], \
"InlineCode",ExpressionUUID->"1d4d4cc0-87e2-2440-bdcc-87b26e865a49"]], \
"Subsection",ExpressionUUID->"15a63ec2-e61c-c642-9ab4-9f3770160b78"],

Cell["\<\
import { ConfidenceCorridor } from \"./types\";
import { goldenInverse, goldenInverseSquared } from \"./constants\";

export function confidenceCorridor(vfeNorm: number, sigmaNorm: number, \
phiCaution = goldenInverse): ConfidenceCorridor {
  const ciLower = Math.max(goldenInverseSquared, 1 - vfeNorm);
  const ciUpper = Math.min(phiCaution, 1 - sigmaNorm * goldenInverse);

  const regime = ciLower > goldenInverse
    ? \"Stable\"
    : ciLower > 0.432
      ? \"Stress\"
      : \"Critical\";

  return { ciLower, ciUpper, regime };
}\
\>", "Program",ExpressionUUID->"8b374db8-a581-7348-a457-5377d6673603"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[Cell["src/core/tests.ts",
  Background->None,ExpressionUUID->
  "b50ca48f-820b-e54f-be66-bb5686a14b71"]], \
"InlineCode",ExpressionUUID->"e64cb624-2f33-9242-b6d8-9afdc0cab1fd"]], \
"Subsection",ExpressionUUID->"6c693115-081e-6d44-a50c-007fbe3c5f72"],

Cell["\<\
import { StabilityDescriptor } from \"./types\";
import { goldenInverseSquared } from \"./constants\";

export interface TestResult {
  name: string;
  passed: boolean;
  value: number | boolean;
  threshold?: number;
}

export function runCoreTests(descriptor: StabilityDescriptor): TestResult[] {
  return [
    {
      name: \"ClosurePhaseLock\",
      passed: descriptor.closureRatio >= goldenInverseSquared,
      value: descriptor.closureRatio,
      threshold: goldenInverseSquared
    },
    {
      name: \"CurvatureTorsionBalance\",
      passed: descriptor.curvatureTorsionBalance >= goldenInverseSquared,
      value: descriptor.curvatureTorsionBalance,
      threshold: goldenInverseSquared
    },
    {
      name: \"FluxContainment\",
      passed: descriptor.fluxContainment >= goldenInverseSquared,
      value: descriptor.fluxContainment,
      threshold: goldenInverseSquared
    },
    {
      name: \"BoundaryIntegrity\",
      passed: descriptor.boundaryIntegrity >= goldenInverseSquared,
      value: descriptor.boundaryIntegrity,
      threshold: goldenInverseSquared
    },
    {
      name: \"MaintenanceFactor\",
      passed: descriptor.maintenanceFactor >= goldenInverseSquared,
      value: descriptor.maintenanceFactor,
      threshold: goldenInverseSquared
    }
  ];
}\
\>", "Program",ExpressionUUID->"7b466846-2a02-324d-90c9-85a0c30e047e"]
}, Open  ]]
}, Open  ]],

