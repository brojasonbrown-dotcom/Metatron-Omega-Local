  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"59387da8-e699-7443-93b3-c3783c134a95"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"16. Recommended formal \[OpenCurlyDoubleQuote]unified \
equations\[CloseCurlyDoubleQuote] statement\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7b491da3-bc02-0d46-a598-06a2def057e5"],
 "\nIf you want a polished statement for the notebook, use this: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox[Cell[TextData[{
       StyleBox["Unified RHUFT/MRCE field framework.",
        FontWeight->Bold],
       "  \nLet ",
       Cell[BoxData[
        FormBox[
         TemplateBox[<|"boxes" -> FormBox[
             RowBox[{
               StyleBox["q", FontSlant -> "Bold"], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   SubscriptBox[
                    StyleBox["q", "TI"], "1"], ",", "\[Ellipsis]", ",", 
                   SubscriptBox[
                    StyleBox["q", "TI"], 
                    StyleBox["m", "TI"]]}], ")"}]}], TraditionalForm], 
           "errors" -> {}, "input" -> "\\mathbf{q}=(q_1,\\dots,q_m)", "state" -> 
           "Boxes"|>,
          "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
        "fc1ad68c-1d4a-6e4d-81bd-8f8fcb8258ff"],
       " denote the principal transported/reactive fields and ",
       Cell[BoxData[
        FormBox[
         TemplateBox[<|"boxes" -> FormBox[
             RowBox[{"\[Psi]", "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   SubscriptBox["\[Psi]", "1"], ",", "\[Ellipsis]", ",", 
                   SubscriptBox["\[Psi]", 
                    StyleBox["p", "TI"]]}], ")"}]}], TraditionalForm], 
           "errors" -> {}, "input" -> 
           "\\boldsymbol{\\psi}=(\\psi_1,\\dots,\\psi_p)", "state" -> "Boxes"|>,
          "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
        "3c3bceeb-2d3b-0a4b-b6a6-a3acfd5f6924"],
       " denote auxiliary coupled fields. On a domain ",
       Cell[BoxData[
        FormBox[
         TemplateBox[<|"boxes" -> FormBox[
             RowBox[{"\[CapitalOmega]", "\[Subset]", 
               SuperscriptBox[
                StyleBox["R", FontSlant -> "Plain"], 
                StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, 
           "input" -> "\\Omega\\subset\\mathbb{R}^n", "state" -> "Boxes"|>,
          "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
        "63484bdb-cafc-314f-8c7d-9703f3de17b1"],
       " over time interval ",
       Cell[BoxData[
        FormBox[
         TemplateBox[<|"boxes" -> FormBox[
             RowBox[{"[", 
               RowBox[{"0", ",", 
                 StyleBox["T", "TI"]}], "]"}], TraditionalForm], 
           "errors" -> {}, "input" -> "[0,T]", "state" -> "Boxes"|>,
          "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
        "e90cad4e-5404-d745-a35d-a8b6439fc784"],
       ", the governing system is\n",
       Cell[BoxData[
        FormBox[
         TemplateBox[<|"boxes" -> FormBox[
             RowBox[{
               FractionBox[
                RowBox[{"\[PartialD]", 
                  SubscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["i", "TI"]]}], 
                RowBox[{"\[PartialD]", 
                  StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
               RowBox[{"(", 
                 RowBox[{"-", 
                   UnderoverscriptBox["\[Sum]", 
                    RowBox[{
                    StyleBox["j", "TI"], "\[LongEqual]", "1"}], 
                    StyleBox["m", "TI"], LimitsPositioning -> True], 
                   SubscriptBox[
                    StyleBox["D", "TI"], 
                    RowBox[{
                    StyleBox["i", "TI"], 
                    StyleBox["j", "TI"]}]], "\[Del]", 
                   SubscriptBox[
                    StyleBox["q", "TI"], 
                    StyleBox["j", "TI"]], "+", 
                   SubscriptBox[
                    StyleBox["v", FontSlant -> "Bold"], 
                    StyleBox["i", "TI"]], 
                   SubscriptBox[
                    StyleBox["q", "TI"], 
                    StyleBox["i", "TI"]], "-", 
                   SubscriptBox["\[Chi]", 
                    StyleBox["i", "TI"]], 
                   SubscriptBox[
                    StyleBox["q", "TI"], 
                    StyleBox["i", "TI"]], "\[Del]", "\[Phi]", "+", 
                   SubsuperscriptBox[
                    StyleBox["J", FontSlant -> "Bold"], 
                    StyleBox["i", "TI"], 
                    StyleBox["cross", FontSlant -> "Plain"]]}], ")"}], 
               "\[LongEqual]", 
               SubscriptBox[
                StyleBox["R", "TI"], 
                StyleBox["i", "TI"]], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["q", FontSlant -> "Bold"], ",", "\[Psi]", ",", 
                   StyleBox["x", FontSlant -> "Bold"], ",", 
                   StyleBox["t", "TI"]}], ")"}], ",    ", 
               StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", 
               ",", 
               StyleBox["m", "TI"], ","}], TraditionalForm], "errors" -> {}, 
           "input" -> 
           "\\frac{\\partial q_i}{\\partial t}\n+\n\\nabla\\cdot\\left(\n\
-\\sum_{j=1}^{m} D_{ij}\\nabla q_j\n+ \\mathbf{v}_i q_i\n- \\chi_i q_i \
\\nabla \\phi\n+ \\mathbf{J}_i^{\\mathrm{cross}}\n\\right)\n=\n\
R_i(\\mathbf{q},\\boldsymbol{\\psi},\\mathbf{x},t),\n\\qquad i=1,\\dots,m,", 
           "state" -> "Boxes"|>,
          "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
        "dc799512-a5bb-7f44-a015-a59e2ff17278"],
       "\ntogether with auxiliary field equations\n",
       Cell[BoxData[
        FormBox[
         TemplateBox[<|"boxes" -> FormBox[
             RowBox[{
               SubscriptBox[
                StyleBox["L", "TI"], "\[Alpha]"], 
               RowBox[{"(", 
                 RowBox[{"\[Psi]", ",", 
                   StyleBox["q", FontSlant -> "Bold"], ",", 
                   StyleBox["x", FontSlant -> "Bold"], ",", 
                   StyleBox["t", "TI"]}], ")"}], "\[LongEqual]", "0", ",    ",
                "\[Alpha]", "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
               StyleBox["p", "TI"], ","}], TraditionalForm], "errors" -> {}, 
           "input" -> 
           "\\mathcal{L}_\\alpha(\\boldsymbol{\\psi},\\mathbf{q},\\mathbf{x},\
t)=0,\n\\qquad \\alpha=1,\\dots,p,", "state" -> "Boxes"|>,
          "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
        "e001913f-7cc1-b742-842e-20ed4e3d859f"],
       "\ninitial conditions\n",
       Cell[BoxData[
        FormBox[
         TemplateBox[<|"boxes" -> FormBox[
             RowBox[{
               SubscriptBox[
                StyleBox["q", "TI"], 
                StyleBox["i", "TI"]], 
               RowBox[{"(", 
                 RowBox[{"0", ",", 
                   StyleBox["x", FontSlant -> "Bold"]}], ")"}], 
               "\[LongEqual]", 
               SubscriptBox[
                StyleBox["q", "TI"], 
                RowBox[{
                  StyleBox["i", "TI"], ",", "0"}]], 
               RowBox[{"(", 
                 StyleBox["x", FontSlant -> "Bold"], ")"}], ","}], 
             TraditionalForm], "errors" -> {}, "input" -> 
           "q_i(0,\\mathbf{x}) = q_{i,0}(\\mathbf{x}),", "state" -> "Boxes"|>,
          "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
        "84486d19-11e8-dc4a-9ffc-cc2299e6a749"],
       "\nand boundary conditions chosen from concentration/value, flux, \
impermeability, transfer, symmetry, or outflow classes."
      }],
       Background->None,ExpressionUUID->
       "a3444704-9045-dc45-88d3-f94c60127c3b"],
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"1f978a5e-8236-e843-a83f-4e363555db45"],
 "\nThat is compact, broad, and mathematically respectable. \n",
 Cell[BoxData[
