 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"17. Suggested Wolfram Language scaffold\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d78b23f0-a150-db46-8dc9-d981d0dc31d5"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
            
            RowBox[{"q", ",", "psi", ",", "phi", ",", "x", ",", "y", ",", "z",
               ",", "t", ",", "vars", ",", "pars", ",", "eqns", ",", "ics", 
              ",", "bcs", ",", "region", ",", "sol"}], "\[IndentingNewLine]", 
            "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"vars", "=", 
