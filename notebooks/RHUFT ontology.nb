Cell[CellGroupData[{

Cell["12. Test Class 3 \[LongDash] Multiscale Coupling", "Section",ExpressionUUID->"fafa2884-2f13-a349-8ea8-c3ef03221586"],

Cell[TextData[{
 "Equations: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}], 
          RowBox[{"(", "0", ")"}]], "\[LongEqual]", 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubsuperscriptBox["\[CapitalPsi]", 
              StyleBox["t", "TI"], 
              RowBox[{"(", "0", ")"}]], ",", 
             SubsuperscriptBox["\[CapitalPsi]", 
              StyleBox["t", "TI"], 
              RowBox[{"(", "1", ")"}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Psi_{t+1}^{(0)} = f(\\Psi_t^{(0)}, \\Psi_t^{(1)})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "495e2293-f115-1044-8e89-50d8cfb1976a"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}], 
          RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["A", "TI"], 
             RowBox[{"[", 
               SubsuperscriptBox["\[CapitalPsi]", 
                StyleBox["t", "TI"], 
                RowBox[{"(", "0", ")"}]], "]"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Psi_{t+1}^{(1)} = g(A[\\Psi_t^{(0)}])", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6a309711-968f-c040-a539-0ad9c5739415"]
}], "Text",ExpressionUUID->"940d04d5-1065-9f44-adc1-48da56df0fd8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "simulateMultiscale", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"simulateMultiscale", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
    "a0_", ",", "a1_", ",", "b01_", ",", "b10_", ",", "source_", ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"steps_Integer", "?", "Positive"}], ",", 
     RowBox[{"psi00_", ":", " ", "1."}], ",", 
     RowBox[{"psi10_", ":", " ", "0."}], ",", 
     RowBox[{"target0_", ":", " ", "0."}], ",", 
     RowBox[{"target1_", ":", " ", "0."}]}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"psi0", ",", "psi1", ",", "t", ",", "jacobian", ",", "eigs"}], 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"psi0", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"psi1", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"psi0", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "psi00"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"psi1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "psi10"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"psi0", "[", 
           RowBox[{"[", 
            RowBox[{"t", "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"a0", " ", 
            RowBox[{"psi0", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"b01", " ", 
            RowBox[{"psi1", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}], "+", "source"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"psi1", "[", 
           RowBox[{"[", 
            RowBox[{"t", "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"a1", " ", 
            RowBox[{"psi1", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"b10", " ", 
            RowBox[{"psi0", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}]}]}], ";"}], 
        "\[IndentingNewLine]", "  ", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "1", ",", 
          RowBox[{"steps", "-", "1"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"jacobian", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a0", ",", "b01"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b10", ",", "a1"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"eigs", "=", 
       RowBox[{"Eigenvalues", "[", "jacobian", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Psi0\>\"", "->", "psi0"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Psi1\>\"", "->", "psi1"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Jacobian\>\"", "->", "jacobian"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Eigenvalues\>\"", "->", "eigs"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SpectralRadius\>\"", "->", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", "eigs", "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<MeanDrift0\>\"", "->", 
         RowBox[{"Mean", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"psi0", "-", "target0"}], ")"}], "^", "2"}], "]"}]}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<MeanDrift1\>\"", "->", 
         RowBox[{"Mean", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"psi1", "-", "target1"}], ")"}], "^", "2"}], "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"bab98213-11e0-3647-884f-\
00d152f6ca75"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "res", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"res", "=", 
       RowBox[{"simulateMultiscale", "[", 
        RowBox[{
        "a0", ",", "a1", ",", "b01", ",", "b10", ",", "source", ",", "steps", 
         ",", "psi00", ",", "psi10", ",", "target0", ",", "target1"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Grid", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Metric\>\"", ",", "Bold"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Value\>\"", ",", "Bold"}], "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{"\"\<Eigenvalues\>\"", ",", 
               RowBox[{"res", "[", "\"\<Eigenvalues\>\"", "]"}]}], "}"}], ",",
              "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{"\"\<Spectral radius\>\"", ",", 
               RowBox[{"res", "[", "\"\<SpectralRadius\>\"", "]"}]}], "}"}], ",",
              "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{"\"\<Linear stability\>\"", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"res", "[", "\"\<SpectralRadius\>\"", "]"}], "<", 
                  "1"}], ",", "\"\<stable\>\"", 
                 ",", "\"\<unstable / marginal\>\""}], "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{"\"\<Mean drift scale 0\>\"", ",", 
               RowBox[{"res", "[", "\"\<MeanDrift0\>\"", "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{"\"\<Mean drift scale 1\>\"", ",", 
               RowBox[{"res", "[", "\"\<MeanDrift1\>\"", "]"}]}], "}"}]}], 
            "\[IndentingNewLine]", "      ", "}"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "    ", 
          "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"res", "[", "\"\<Psi0\>\"", "]"}], ",", 
             RowBox[{"res", "[", "\"\<Psi1\>\"", "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<scale 0\>\"", ",", "\"\<scale 1\>\""}], "}"}]}], ",",
            "\[IndentingNewLine]", "      ", 
           RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"ImageSize", "->", "Large"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"PlotLabel", "->", "\"\<Test Class 3\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}]}], "\[IndentingNewLine]", "  ",
         "}"}], "]"}]}]}], "\[IndentingNewLine]", " ", "]"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a0", ",", "0.8"}], "}"}], ",", 
     RowBox[{"-", "1.5"}], ",", "1.5", ",", "0.01"}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a1", ",", "0.7"}], "}"}], ",", 
     RowBox[{"-", "1.5"}], ",", "1.5", ",", "0.01"}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b01", ",", "0.3"}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.01"}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b10", ",", "0.4"}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.01"}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"source", ",", "0.0"}], "}"}], ",", 
     RowBox[{"-", "2"}], ",", "2", ",", "0.01"}], "}"}], ",", 
   "\[IndentingNewLine]", " ", "Delimiter", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"steps", ",", "120"}], "}"}], ",", "20", ",", "500", ",", "1"}],
     "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"psi00", ",", "1."}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "3", ",", "0.01"}], "}"}], ",", 
