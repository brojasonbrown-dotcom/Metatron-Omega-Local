Cell[CellGroupData[{

Cell["18. Claim Classification Table", "Section",ExpressionUUID->"a98d99d4-812e-f449-809b-d4d62cb2e79b"],

Cell[BoxData[
 RowBox[{"Dataset", "[", "\[IndentingNewLine]", " ", 
  RowBox[{"{", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Claim\>\"", 
       "->", "\"\<Golden angle is irrational and nonrepeating on the circle\>\
\""}], ",", 
      RowBox[{"\"\<Status\>\"", "->", "\"\<MATH FACT\>\""}]}], "|>"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Claim\>\"", 
       "->", "\"\<Coverage discrepancy often improves under golden-angle \
scanning relative to many rational schedules\>\""}], ",", 
      RowBox[{"\"\<Status\>\"", "->", "\"\<DEFINED\>\""}]}], "|>"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Claim\>\"", 
       "->", "\"\<Existence is stabilization at scale\>\""}], ",", 
      RowBox[{"\"\<Status\>\"", "->", "\"\<RHUFT AXIOM\>\""}]}], "|>"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Claim\>\"", 
       "->", "\"\<Time is the ordered trace of recursive \
self-measurement\>\""}], ",", 
      RowBox[{"\"\<Status\>\"", "->", "\"\<RHUFT AXIOM\>\""}]}], "|>"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Claim\>\"", 
       "->", "\"\<Mass is integrated burden of stabilized information density\
\>\""}], ",", 
      RowBox[{"\"\<Status\>\"", "->", "\"\<RHUFT DER\>\""}]}], "|>"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Claim\>\"", 
       "->", "\"\<Gravity is field response to burden density \
gradients\>\""}], ",", 
      RowBox[{"\"\<Status\>\"", "->", "\"\<SPEC\>\""}]}], "|>"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Claim\>\"", 
       "->", "\"\<Inertia equals derivative of phase-lock with respect to \
acceleration\>\""}], ",", 
      RowBox[{"\"\<Status\>\"", "->", "\"\<SPEC\>\""}]}], "|>"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Claim\>\"", 
       "->", "\"\<Inertia can be modulated by phi-resonant EM driving\>\""}], 
      ",", 
      RowBox[{"\"\<Status\>\"", "->", "\"\<SPEC\>\""}]}], "|>"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Claim\>\"", 
       "->", "\"\<Equivalence principle follows automatically from burden \
geometry\>\""}], ",", 
      RowBox[{"\"\<Status\>\"", "->", "\"\<SPEC\>\""}]}], "|>"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Claim\>\"", 
       "->", "\"\<Consciousness is the interior side of recursive \
self-measurement\>\""}], ",", 
      RowBox[{"\"\<Status\>\"", "->", "\"\<PHIL\>\""}]}], "|>"}]}], 
   "\[IndentingNewLine]", " ", "}"}], "\[IndentingNewLine]", "]"}]], "Input",E\
xpressionUUID->"b97d0261-bc4e-7849-851b-34aece3a1afc"],

