Cell[CellGroupData[{

Cell["15. Inertia as Phase-Lock Resistance Proxy", "Section",ExpressionUUID->"5ae9ef1e-6b07-d549-9db0-e12ba3755ad0"],

Cell[TextData[{
 "From the text: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPhi]", 
          RowBox[{
            StyleBox["l", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["c", "TI"], 
            StyleBox["k", "TI"]}]], 
         RowBox[{"(", "\[Tau]", ")"}], "\[LongEqual]", "\[Integral]", 
         "\[CapitalPsi]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["r", FontSlant -> "Bold"], ",", 
             StyleBox["t", "TI"]}], ")"}], 
         OverscriptBox[
          RowBox[{"\[CapitalPsi]", "(", 
            RowBox[{
              StyleBox["r", FontSlant -> "Bold"], ",", 
              StyleBox["t", "TI"], "-", "\[Tau]"}], ")"}], "_"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", "\[Gamma]", "|", "\[Tau]", "|"}]], 
         StyleBox["d", "TI"], 
         StyleBox["r", FontSlant -> "Bold"], 
         StyleBox["d", "TI"], "\[Tau]"}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\Phi_{lock}(\\tau) = \\int \\Psi(\\mathbf{r}, t) \
\\overline{\\Psi(\\mathbf{r}, t-\\tau)} e^{-\\gamma |\\tau|} d\\mathbf{r} \
d\\tau", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "deec60b1-878d-8040-b2c1-6eca0fc5c58e"],
 "and inertial mass proxy: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox["\[CapitalPhi]", 
             RowBox[{
               StyleBox["l", "TI"], 
               StyleBox["o", "TI"], 
               StyleBox["c", "TI"], 
               StyleBox["k", "TI"]}]]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["a", "TI"]}]], 
         SubscriptBox["|", 
          RowBox[{
            StyleBox["a", "TI"], "\[LongEqual]", "0"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "m_i = \\frac{\\partial \\Phi_{lock}}{\\partial a}\\Big|_{a=0}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6684d339-affa-ff47-9674-4e62d51f0d3e"],
 "We implement a discrete proxy model. "
}], "Text",ExpressionUUID->"d00ae3ca-d8c0-b04b-a96d-9dd74c6fe8e0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "phaseField", ",", "phaseLockFunction", ",", "inertialMassProxy"}], "]"}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"phaseField", "[", 
     RowBox[{"x_", ",", "t_", ",", "omega0_", ",", "accel_", ",", 
      RowBox[{"phase0_", ":", " ", "0."}]}], "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"omega0", " ", "t"}], "+", "phase0", "+", 
        RowBox[{"accel", " ", "x", " ", "t"}]}], ")"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"phaseLockFunction", "[", 
     RowBox[{
     "omega0_", ",", "accel_", ",", "gamma_", ",", "tauMax_", ",", "xRange_", 
      ",", 
      RowBox[{"dx_", ":", " ", "0.05"}], ",", 
      RowBox[{"dtau_", ":", " ", "0.05"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xs", ",", "taus", ",", "integrand"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"xs", "=", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "xRange"}], ",", "xRange", ",", "dx"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"taus", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "tauMax", ",", "dtau"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"N", " ", "@", " ", 
        RowBox[{"Total", "@", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", "\[IndentingNewLine]", "      ", 
             RowBox[{
              RowBox[{"phaseField", "[", 
               RowBox[{"x", ",", "1.", ",", "omega0", ",", "accel"}], "]"}], "*", 
              RowBox[{"Conjugate", "[", 
               RowBox[{"phaseField", "[", 
                RowBox[{"x", ",", 
                 RowBox[{"1.", "-", "tau"}], ",", "omega0", ",", "accel"}], 
                "]"}], "]"}], "*", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "gamma"}], " ", 
                RowBox[{"Abs", "[", "tau", "]"}]}], "]"}]}], 
             "\[IndentingNewLine]", "    ", "]"}], " ", "dx", " ", "dtau"}], ",",
            "\[IndentingNewLine]", "    ", 
           RowBox[{"{", 
            RowBox[{"x", ",", "xs"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"tau", ",", "taus"}], "}"}]}], "\[IndentingNewLine]", 
          "  ", "]"}]}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"inertialMassProxy", "[", 
    RowBox[{"omega0_", ",", "gamma_", ",", "tauMax_", ",", "xRange_", ",", 
     RowBox[{"a0_", ":", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "3"}]}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fplus", ",", "fminus"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"fplus", "=", 
       RowBox[{"phaseLockFunction", "[", 
        RowBox[{
        "omega0", ",", "a0", ",", "gamma", ",", "tauMax", ",", "xRange"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"fminus", "=", 
       RowBox[{"phaseLockFunction", "[", 
        RowBox[{"omega0", ",", 
         RowBox[{"-", "a0"}], ",", "gamma", ",", "tauMax", ",", "xRange"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"fplus", "-", "fminus"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "a0"}], ")"}]}]}]}], "\[IndentingNewLine]", "]"}]}],
   ";"}]}], "Input",ExpressionUUID->"5a6553b7-c9be-2442-ad75-c8ecc1d40ca9"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"phi0", ",", "lockCurve", ",", "mi"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"lockCurve", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", 
           RowBox[{"phaseLockFunction", "[", 
            RowBox[{
            "omega0", ",", "a", ",", "gamma", ",", "tauMax", ",", "xRange", ",",
              "dx", ",", "dtau"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", 
           RowBox[{"-", "aMax"}], ",", "aMax", ",", "aStep"}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"mi", "=", 
       RowBox[{"inertialMassProxy", "[", 
        RowBox[{
        "omega0", ",", "gamma", ",", "tauMax", ",", "xRange", ",", "aProbe"}],
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Grid", "[", "\[IndentingNewLine]", "      ", 
