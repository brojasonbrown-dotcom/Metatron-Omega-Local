Cell[CellGroupData[{

Cell["10. Test Class 1 \[LongDash] Memory vs No-Memory Stabilization", \
"Section",ExpressionUUID->"426c71f6-d502-aa4a-97ac-d84e88b3760d"],

Cell[TextData[{
 "Equations: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         SubscriptBox["\[Alpha]\[CapitalPsi]", 
          StyleBox["t", "TI"]], "+", "\[Gamma]", 
         SubscriptBox[
          StyleBox["i", "TI"], 
          StyleBox["t", "TI"]], "+", "\[Delta]", 
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["t", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Psi_{t+1} = \\alpha \\Psi_t + \\gamma i_t + \\delta m_t", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5dd9dd6a-07dd-4f40-9fd4-1e9b8626ac7d"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "-", "\[Lambda]"}], ")"}], 
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["t", "TI"]], "+", 
         SubscriptBox["\[Lambda]\[CapitalPsi]", 
          StyleBox["t", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "m_{t+1} = (1-\\lambda)m_t + \\lambda \\Psi_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a7d53ba-bd32-fe45-9a9c-edf8a3e7e86b"]
}], "Text",ExpressionUUID->"a651457a-b973-6546-93ca-afd140905a16"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"pulseInput", ",", "simulateMemorySystem"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pulseInput", "[", 
     RowBox[{
      RowBox[{"steps_Integer", "?", "Positive"}], ",", 
      RowBox[{"pulseLength_Integer", "?", "Positive"}], ",", 
      RowBox[{"level_", ":", " ", "1."}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"t", "<=", "pulseLength"}], ",", "level", ",", "0."}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "steps"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"simulateMemorySystem", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
    "alpha_", ",", "gamma_", ",", "delta_", ",", "lambda_", ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"steps_Integer", "?", "Positive"}], ",", 
     RowBox[{"pulseLength_Integer", "?", "Positive"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"inputLevel_", ":", " ", "1."}], ",", 
     RowBox[{"psi0_", ":", " ", "0."}], ",", 
     RowBox[{"mem0_", ":", " ", "0."}], ",", 
     RowBox[{"target_", ":", " ", "0."}]}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"input", ",", "psiMem", ",", "mem", ",", "psiNoMem", ",", "t"}],
       "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"input", "=", 
       RowBox[{"pulseInput", "[", 
        RowBox[{"steps", ",", "pulseLength", ",", "inputLevel"}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"psiMem", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"mem", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"psiNoMem", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"psiMem", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "psi0"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"mem", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "mem0"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"psiNoMem", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "psi0"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"psiMem", "[", 
           RowBox[{"[", 
            RowBox[{"t", "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"alpha", " ", 
            RowBox[{"psiMem", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"gamma", " ", 
            RowBox[{"input", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"delta", " ", 
            RowBox[{"mem", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]",
          "    ", 
         RowBox[{
          RowBox[{"mem", "[", 
           RowBox[{"[", 
            RowBox[{"t", "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "lambda"}], ")"}], " ", 
            RowBox[{"mem", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"lambda", " ", 
            RowBox[{"psiMem", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]",
          "    ", 
         RowBox[{
          RowBox[{"psiNoMem", "[", 
           RowBox[{"[", 
            RowBox[{"t", "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"alpha", " ", 
            RowBox[{"psiNoMem", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"gamma", " ", 
            RowBox[{"input", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}]}]}], ";"}], 
        "\[IndentingNewLine]", "  ", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "1", ",", 
          RowBox[{"steps", "-", "1"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
