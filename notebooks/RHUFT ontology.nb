Cell[CellGroupData[{

Cell["9. Master Update Equation: Explicit Testable Instantiation", "Section",ExpressionUUID->"93643733-be72-834e-af64-c0d9ec059a3f"],

Cell[TextData[{
 "The formal equation in the text is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["N", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["\[Alpha]", 
              StyleBox["n", "TI"]], 
             SubsuperscriptBox["\[CapitalPsi]", 
              StyleBox["t", "TI"], 
              StyleBox["n", "TI"]], "+", 
             SubscriptBox["\[Beta]", 
              StyleBox["n", "TI"]], 
             SubscriptBox[
              StyleBox["G", "TI"], 
              StyleBox["n", "TI"]], "+", 
             SubscriptBox["\[Gamma]", 
              StyleBox["n", "TI"]], 
             SubscriptBox[
              StyleBox["P", "TI"], 
              StyleBox["n", "TI"]], "+", 
             SubscriptBox["\[Delta]", 
              StyleBox["n", "TI"]], 
             SubscriptBox[
              StyleBox["R", "TI"], 
              StyleBox["n", "TI"]], "+", 
             SubscriptBox["\[Epsilon]", 
              StyleBox["n", "TI"]], 
             SubscriptBox[
              StyleBox["C", "TI"], 
              StyleBox["n", "TI"]], "+", 
             SubscriptBox["\[Zeta]", 
              StyleBox["n", "TI"]], 
             SubscriptBox[
              StyleBox["S", "TI"], 
              StyleBox["n", "TI"]], "+", 
             SubscriptBox["\[Eta]", 
              StyleBox["n", "TI"]], 
             SubscriptBox[
              StyleBox["B", "TI"], 
              StyleBox["n", "TI"]], "+", 
             SubscriptBox["\[Mu]", 
              StyleBox["n", "TI"]], 
             SubscriptBox[
              StyleBox["A", "TI"], 
              StyleBox["n", "TI"]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Psi_{t+1}^n = N_n[\\alpha_n \\Psi_t^n + \\beta_n G_n + \\gamma_n P_n \
+ \\delta_n R_n + \\epsilon_n C_n + \\zeta_n S_n + \\eta_n B_n + \\mu_n A_n]",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ea2865b8-ff09-3246-bbdf-27d85fefce0b"],
 "Below is a concrete numeric implementation on the state vector. "
}], "Text",ExpressionUUID->"0e47345e-8062-a548-9754-5d34e5551e09"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "rhuftUpdateStep", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhuftUpdateStep", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{"state_Association", ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"opts", " ", ":", " ", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "     ", 
        RowBox[{
         RowBox[{"\"\<InputVector\>\"", "->", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", 
            RowBox[{"Length", "[", "stateKeys", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{"\"\<LawTarget\>\"", "->", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", 
            RowBox[{"Length", "[", "stateKeys", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{"\"\<SelfModel\>\"", "->", "Automatic"}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{"\"\<HigherScale\>\"", "->", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", 
            RowBox[{"Length", "[", "stateKeys", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{"\"\<LowerScale\>\"", "->", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", 
            RowBox[{"Length", "[", "stateKeys", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{"\"\<Alpha\>\"", "->", "0.6"}], ",", "\[IndentingNewLine]", 
         "     ", 
         RowBox[{"\"\<Beta\>\"", "->", "0.1"}], ",", "\[IndentingNewLine]", 
         "     ", 
         RowBox[{"\"\<Gamma\>\"", "->", "0.2"}], ",", "\[IndentingNewLine]", 
         "     ", 
         RowBox[{"\"\<Delta\>\"", "->", "0.2"}], ",", "\[IndentingNewLine]", 
         "     ", 
         RowBox[{"\"\<Epsilon\>\"", "->", "0.1"}], ",", "\[IndentingNewLine]",
          "     ", 
         RowBox[{"\"\<Zeta\>\"", "->", "0.2"}], ",", "\[IndentingNewLine]", 
         "     ", 
         RowBox[{"\"\<Eta\>\"", "->", "0.1"}], ",", "\[IndentingNewLine]", 
         "     ", 
         RowBox[{"\"\<Mu\>\"", "->", "0.1"}]}], "\[IndentingNewLine]", "   ", 
        "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
      "vec", ",", "inputVec", ",", "lawTarget", ",", "selfModel", ",", 
       "higherScale", ",", "lowerScale", ",", "\[IndentingNewLine]", "    ", 
       "alpha", ",", "beta", ",", "gamma", ",", "delta", ",", "epsilon", ",", 
       "zeta", ",", "eta", ",", "mu", ",", "\[IndentingNewLine]", "    ", 
       "geometryTerm", ",", "projectionTerm", ",", "reflectionTerm", ",", 
       "comparisonTerm", ",", "\[IndentingNewLine]", "    ", 
       "stabilizationTerm", ",", "constraintTerm", ",", "aggregationTerm", ",",
        "nextVec"}], "\[IndentingNewLine]", "  ", "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"vec", "=", 
       RowBox[{"numericStateVector", "[", "state", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"inputVec", "=", 
       RowBox[{"OptionValue", "[", "\"\<InputVector\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"lawTarget", "=", 
       RowBox[{"OptionValue", "[", "\"\<LawTarget\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"selfModel", "=", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<SelfModel\>\"", "]"}], ",", 
         RowBox[{"Automatic", ":>", "vec"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"higherScale", "=", 
       RowBox[{"OptionValue", "[", "\"\<HigherScale\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"lowerScale", "=", 
       RowBox[{"OptionValue", "[", "\"\<LowerScale\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "alpha", ",", "beta", ",", "gamma", ",", "delta", ",", "epsilon", ",",
          "zeta", ",", "eta", ",", "mu"}], "}"}], "=", 
       RowBox[{"OptionValue", " ", "/@", " ", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"\"\<Alpha\>\"", ",", "\"\<Beta\>\"", ",", "\"\<Gamma\>\"", 
          ",", "\"\<Delta\>\"", ",", "\"\<Epsilon\>\"", ",", "\"\<Zeta\>\"", 
          ",", "\"\<Eta\>\"", ",", "\"\<Mu\>\""}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"geometryTerm", "=", 
       RowBox[{"geometryOperator", "[", 
        RowBox[{"vec", ",", 
         RowBox[{"state", "[", "\"\<GeometryCode\>\"", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"projectionTerm", "=", 
       RowBox[{"projectionOperator", "[", 
        RowBox[{"inputVec", ",", "vec"}], "]"}]}], ";", "\[IndentingNewLine]",
       "  ", 
      RowBox[{"reflectionTerm", "=", 
       RowBox[{"reflectionOperator", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"state", "[", "\"\<Memory\>\"", "]"}], ",", 
           RowBox[{"Length", "[", "vec", "]"}]}], "]"}], ",", "vec"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"comparisonTerm", "=", 
       RowBox[{"comparisonOperator", "[", 
        RowBox[{"vec", ",", "lawTarget"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"stabilizationTerm", "=", 
       RowBox[{"stabilizationOperator", "[", 
        RowBox[{"selfModel", ",", "vec"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"constraintTerm", "=", 
       RowBox[{"constraintOperator", "[", "higherScale", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"aggregationTerm", "=", 
       RowBox[{
        RowBox[{"aggregationOperator", " ", "/@", " ", 
         RowBox[{"{", "lowerScale", "}"}]}], " ", "//", " ", "First"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"nextVec", "=", 
       RowBox[{"normalizationOperator", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"alpha", " ", "vec"}], "+", 
         RowBox[{"beta", " ", "geometryTerm"}], "+", 
         RowBox[{"gamma", " ", "projectionTerm"}], "+", 
         RowBox[{"delta", " ", "reflectionTerm"}], "+", "\[IndentingNewLine]",
          "    ", 
         RowBox[{"epsilon", " ", "comparisonTerm"}], "+", 
         RowBox[{"zeta", " ", "stabilizationTerm"}], "+", 
         RowBox[{"eta", " ", "constraintTerm"}], "+", 
         RowBox[{"mu", " ", "aggregationTerm"}]}], "\[IndentingNewLine]", 
        "  ", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"stateFromVector", "[", 
       RowBox[{"nextVec", ",", 
        RowBox[{"state", "[", "\"\<Scale\>\"", "]"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"ac9f7e4d-d458-1f4f-9008-20d85af03058"],

