     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "9a551a5d-f98d-604f-a384-93e93c73b2a5"]
 }], "InlineItem",ExpressionUUID->"9d02c264-cb78-4b4b-b6ca-9ce3a0112053"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "convection velocity ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["v", FontSlant -> "Bold"], TraditionalForm], "errors" -> {}, 
      "input" -> "\\mathbf{v}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "6eb2c5b1-3dbf-7743-b8bc-15bd0558f6a5"]
 }], "InlineItem",ExpressionUUID->"6bac22f0-1883-d446-a0d3-79cfbca92a55"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
