Cell[CellGroupData[{

Cell["5. Variable Dictionary Panel", "Section",ExpressionUUID->"7e67d000-af2c-7344-9089-6ef46e62bf41"],

Cell[BoxData[
 RowBox[{"Grid", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Symbol\>\"", ",", "Bold"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Meaning\>\"", ",", "Bold"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Notebook encoding\>\"", ",", "Bold"}], "]"}]}], "}"}], ",",
      "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<rho_I\>\"", ",", "\"\<Information density\>\"", 
       ",", "\"\<state[\\\"InformationDensity\\\"]\>\""}], "}"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<c\>\"", ",", "\"\<Temporal coherence\>\"", 
       ",", "\"\<state[\\\"Coherence\\\"]\>\""}], "}"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<phi\>\"", ",", "\"\<Phase / alignment\>\"", 
       ",", "\"\<state[\\\"Phase\\\"]\>\""}], "}"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<d\>\"", ",", "\"\<Drift score\>\"", 
       ",", "\"\<state[\\\"Drift\\\"]\>\""}], "}"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<kappa\>\"", ",", "\"\<Closure score\>\"", 
