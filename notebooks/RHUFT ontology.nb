Cell["19. Unified Dashboard", "Section",ExpressionUUID->"60f83715-4d92-2247-a8f2-5ebe84308a4b"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Switch", "[", 
    RowBox[{"test", ",", "\[IndentingNewLine]", "  ", "\"\<Memory\>\"", ",", 
     RowBox[{"simulateMemorySystem", "[", 
      RowBox[{
      "alpha1", ",", "gamma1", ",", "delta1", ",", "lambda1", ",", "steps1", ",",
        "pulseLength1", ",", "inputLevel1", ",", "psi01", ",", "mem01", ",", 
       "target1"}], "]"}], ",", "\[IndentingNewLine]", 
     "  ", "\"\<Reflection\>\"", ",", 
     RowBox[{"simulateReflectionSystem", "[", 
      RowBox[{
      "alpha2", ",", "zeta2", ",", "wm2", ",", "wpsi2", ",", "lambda2", ",", 
       "steps2", ",", "psi02", ",", "mem02", ",", "target2"}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", "\"\<Multiscale\>\"", ",", 
