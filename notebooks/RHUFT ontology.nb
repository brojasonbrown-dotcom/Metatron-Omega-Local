Cell[CellGroupData[{

Cell["11. Test Class 2 \[LongDash] Reflection vs One-Way Update", "Section",ExpressionUUID->"6297ebcd-0730-2446-9b3f-75068a76ea68"],

Cell[TextData[{
 "Equations: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox["\[CapitalPsi]", "^"], 
          StyleBox["t", "TI"]], "\[LongEqual]", 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["m", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["t", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\hat{\\Psi}_t = f(m_t, \\Psi_t)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39ba99cb-d6aa-444e-9fa4-5ab549a855b9"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         SubscriptBox["\[Alpha]\[CapitalPsi]", 
          StyleBox["t", "TI"]], "+", "\[Zeta]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              OverscriptBox["\[CapitalPsi]", "^"], 
              StyleBox["t", "TI"]], "-", 
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["t", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Psi_{t+1} = \\alpha \\Psi_t + \\zeta(\\hat{\\Psi}_t - \\Psi_t)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b762c1cf-17d7-c946-9e80-13c8c30d06c1"]
}], "Text",ExpressionUUID->"809f43f4-dad4-d345-864f-4ffb9394e23e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "simulateReflectionSystem", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"simulateReflectionSystem", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
    "alpha_", ",", "zeta_", ",", "wm_", ",", "wpsi_", ",", "lambda_", ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"steps_Integer", "?", "Positive"}], ",", 
     RowBox[{"psi0_", ":", " ", "1."}], ",", 
     RowBox[{"mem0_", ":", " ", "0."}], ",", 
     RowBox[{"target_", ":", " ", "0."}]}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "psiReflect", ",", "psiOneWay", ",", "mem", ",", "psiHat", ",", "t"}], 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"psiReflect", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"psiOneWay", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"mem", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"psiHat", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"psiReflect", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "psi0"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"psiOneWay", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "psi0"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"mem", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "mem0"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"psiHat", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"wm", " ", "mem0"}], "+", 
        RowBox[{"wpsi", " ", "psi0"}]}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"psiHat", "[", 
           RowBox[{"[", "t", "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"wm", " ", 
            RowBox[{"mem", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"wpsi", " ", 
            RowBox[{"psiReflect", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]",
          "    ", 
         RowBox[{
          RowBox[{"psiReflect", "[", 
           RowBox[{"[", 
            RowBox[{"t", "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"alpha", " ", 
            RowBox[{"psiReflect", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"zeta", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"psiHat", "[", 
               RowBox[{"[", "t", "]"}], "]"}], "-", 
              RowBox[{"psiReflect", "[", 
               RowBox[{"[", "t", "]"}], "]"}]}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"mem", "[", 
           RowBox[{"[", 
            RowBox[{"t", "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "lambda"}], ")"}], " ", 
            RowBox[{"mem", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}], "+", 
           RowBox[{"lambda", " ", 
            RowBox[{"psiReflect", "[", 
             RowBox[{"[", "t", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]",
          "    ", 
         RowBox[{
          RowBox[{"psiOneWay", "[", 
           RowBox[{"[", 
            RowBox[{"t", "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{"alpha", " ", 
           RowBox[{"psiOneWay", "[", 
            RowBox[{"[", "t", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
        "  ", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "1", ",", 
          RowBox[{"steps", "-", "1"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<PsiReflect\>\"", "->", "psiReflect"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<PsiOneWay\>\"", "->", "psiOneWay"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Memory\>\"", "->", "mem"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<PsiHat\>\"", "->", "psiHat"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<PredictionError\>\"", "->", 
         RowBox[{"Mean", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"psiHat", "[", 
              RowBox[{"[", 
               RowBox[{";;", " ", 
                RowBox[{"-", "2"}]}], "]"}], "]"}], "-", 
             RowBox[{"psiReflect", "[", 
              RowBox[{"[", 
               RowBox[{"2", " ", ";;"}], "]"}], "]"}]}], ")"}], "^", "2"}], 
          "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<MeanDriftReflect\>\"", "->", 
         RowBox[{"Mean", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"psiReflect", "-", "target"}], ")"}], "^", "2"}], "]"}]}],
         ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<MeanDriftOneWay\>\"", "->", 
         RowBox[{"Mean", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"psiOneWay", "-", "target"}], ")"}], "^", "2"}], "]"}]}], 
        ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<TemporalCoherence\>\"", "->", 
         RowBox[{"temporalCoherence", "[", 
          RowBox[{"psiReflect", ",", "psiHat"}], "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"25c7fc70-d643-9e4a-8997-\
9ae72aa86738"],

