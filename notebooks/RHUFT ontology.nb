Cell[CellGroupData[{

Cell["17. Monte Carlo Stress Testing Lab", "Section",ExpressionUUID->"b895566b-9889-b945-b97a-b0803afbb0ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "memoryMonteCarlo", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"memoryMonteCarlo", "[", 
    RowBox[{
     RowBox[{"samples_Integer", "?", "Positive"}], ",", 
     RowBox[{"steps_Integer", "?", "Positive"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "runs", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"runs", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"simulateMemorySystem", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.2"}], ",", "1.2"}], "}"}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", "steps", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{"5", ",", 
              RowBox[{"Floor", "[", 
               RowBox[{"steps", "/", "2"}], "]"}]}], "}"}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", "2"}], "}"}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", "2"}], "}"}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "2"}], ",", "2"}], "}"}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", "0."}], "\[IndentingNewLine]", 
          "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"{", "samples", "}"}]}], "\[IndentingNewLine]", "  ", 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Dataset", " ", "@", " ", 
       RowBox[{"Map", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"<|", "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{"\"\<MeanDriftMemory\>\"", "->", 
             RowBox[{"#", "[", "\"\<MeanDriftMemory\>\"", "]"}]}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"\"\<MeanDriftNoMemory\>\"", "->", 
             RowBox[{"#", "[", "\"\<MeanDriftNoMemory\>\"", "]"}]}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"\"\<TemporalCoherence\>\"", "->", 
             RowBox[{"#", "[", "\"\<TemporalCoherence\>\"", "]"}]}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"\"\<MemoryBeatsNoMemory\>\"", "->", 
             RowBox[{
              RowBox[{"#", "[", "\"\<MeanDriftMemory\>\"", "]"}], "<", 
              RowBox[{"#", "[", "\"\<MeanDriftNoMemory\>\"", "]"}]}]}]}], 
           "\[IndentingNewLine]", "    ", "|>"}], " ", "&"}], ",", 
         "\[IndentingNewLine]", "    ", "runs"}], "\[IndentingNewLine]", "  ",
         "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",Express\
ionUUID->"5099cadc-efa2-3440-8835-fd500df57ee5"],

