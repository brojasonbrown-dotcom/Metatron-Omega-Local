         RowBox[{"2", " ", "Pi", " ", 
          RowBox[{"p4", "/", "q4"}]}]}], "]"}], ",", "steps4", ",", "bins4"}],
       "]"}]}], "\[IndentingNewLine]", " ", "]"}], ",", "\[IndentingNewLine]",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"test", ",", "\"\<Memory\>\"", ",", "\"\<panel\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Memory\>\"", ",", "\"\<Reflection\>\"", 
       ",", "\"\<Multiscale\>\"", ",", "\"\<Geometry\>\""}], "}"}]}], "}"}], ",",
    "\[IndentingNewLine]", " ", "Delimiter", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"alpha1", ",", "0.8"}], "}"}], ",", 
     RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gamma1", ",", "0.8"}], "}"}], ",", 
