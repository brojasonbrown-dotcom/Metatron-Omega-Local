Cell[CellGroupData[{

Cell["4. RHUFT State Representation", "Section",ExpressionUUID->"17d414b6-38be-4642-a1ce-8bc4e436bd10"],

Cell[TextData[{
 "The state text defines a scale-indexed multicomponent state: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[CapitalPsi]", 
          StyleBox["t", "TI"], 
          RowBox[{"(", 
            StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
         SubsuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[Rho]", 
               StyleBox["I", "TI"]], ",", 
              StyleBox["c", "TI"], ",", "\[Phi]", ",", 
              StyleBox["d", "TI"], ",", "\[Kappa]", ",", 
              StyleBox["g", "TI"], ",", 
              StyleBox["m", "TI"], ",", 
              StyleBox["b", "TI"]}], ")"}], 
          StyleBox["t", "TI"], 
          RowBox[{"(", 
            StyleBox["n", "TI"], ")"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\Psi_t^{(n)} = (\\rho_I, c, \\phi, d, \\kappa, g, m, b)_t^{(n)}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc2e9773-12c3-c846-aeb2-721e77ed1311"],
 "We encode a state as an Association. "
}], "Text",ExpressionUUID->"2f8cccaf-623d-d340-9d5d-c536390e46d9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "makeState", ",", "stateKeys", ",", "numericStateVector", ",", 
     "stateFromVector"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stateKeys", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<InformationDensity\>\"", ",", "\[IndentingNewLine]", 
      "  ", "\"\<Coherence\>\"", ",", "\[IndentingNewLine]", 
      "  ", "\"\<Phase\>\"", ",", "\[IndentingNewLine]", "  ", "\"\<Drift\>\"",
       ",", "\[IndentingNewLine]", "  ", "\"\<Closure\>\"", ",", 
      "\[IndentingNewLine]", "  ", "\"\<GeometryCode\>\"", ",", 
      "\[IndentingNewLine]", "  ", "\"\<Memory\>\"", ",", 
      "\[IndentingNewLine]", "  ", "\"\<Burden\>\""}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeState", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"infoDensity_", ":", " ", "1."}], ",", 
      RowBox[{"coherence_", ":", " ", "0.8"}], ",", 
      RowBox[{"phase_", ":", " ", "0."}], ",", 
      RowBox[{"drift_", ":", " ", "0.1"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"closure_", ":", " ", "0.8"}], ",", 
      RowBox[{"geometryCode_", ":", " ", "1."}], ",", 
      RowBox[{"memory_", ":", " ", "0.5"}], ",", 
      RowBox[{"burden_", ":", " ", "0.2"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"scale_", ":", " ", "0"}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<InformationDensity\>\"", "->", "infoDensity"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Coherence\>\"", "->", "coherence"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Phase\>\"", "->", "phase"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<Drift\>\"", "->", "drift"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<Closure\>\"", "->", "closure"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<GeometryCode\>\"", "->", "geometryCode"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Memory\>\"", "->", "memory"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<Burden\>\"", "->", "burden"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<Scale\>\"", "->", "scale"}]}], "\[IndentingNewLine]", 
     "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"numericStateVector", "[", "state_Association", "]"}], ":=", 
    RowBox[{"Lookup", "[", 
     RowBox[{"state", ",", "stateKeys"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stateFromVector", "[", 
    RowBox[{"vec_List", ",", 
     RowBox[{"scale_", ":", " ", "0"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"AssociationThread", "[", 
     RowBox[{"stateKeys", "->", "vec"}], "]"}], " ", "~", "Join", "~", " ", 
    RowBox[{"<|", 
     RowBox[{"\"\<Scale\>\"", "->", "scale"}], "|>"}]}]}], ";"}]}], "Input",Ex\
pressionUUID->"057b832c-e38c-6548-9e8d-e320fb84e873"],

Cell[CellGroupData[{

Cell["Perfection state proxy", "Subsection",ExpressionUUID->"c57e0135-34e7-2b46-baaa-a9e8aeb7d082"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "makePerfectionState", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makePerfectionState", "[", 
    RowBox[{"scale_", ":", " ", "0"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<InformationDensity\>\"", "->", 
      RowBox[{"10", "^", "6"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Coherence\>\"", "->", "1."}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<Phase\>\"", "->", 
      RowBox[{"2", " ", 
       RowBox[{"Pi", "/", 
        RowBox[{"phi", "^", "2"}]}]}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Drift\>\"", "->", "0."}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Closure\>\"", "->", "1."}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<GeometryCode\>\"", "->", "1."}], ",", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"\"\<Memory\>\"", "->", 
      RowBox[{"10", "^", "6"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Burden\>\"", "->", "0."}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Scale\>\"", "->", "scale"}]}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]}], "Input",ExpressionUUID->"a74d3d26-aa8b-e248-9ac9-\
41cf17b8180c"],

