Cell[CellGroupData[{

Cell["2. Epistemic Labels", "Section",ExpressionUUID->"38c0da63-42a7-1443-a31c-fd4220861976"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"epistemicLabelStyle", ",", "epistemicColor", ",", "labelCell"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"epistemicColor", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<MATH FACT\>\"", "->", 
       RowBox[{"Darker", "[", "Blue", "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<DEFINED\>\"", "->", 
       RowBox[{"Darker", "[", "Green", "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<GEOM\>\"", "->", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.1", ",", "0.5", ",", "0.6"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<EST PHYS\>\"", "->", "Purple"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<OBSERVED\>\"", "->", "Brown"}], ",", "\[IndentingNewLine]",
       "  ", 
      RowBox[{"\"\<PHIL\>\"", "->", 
       RowBox[{"GrayLevel", "[", "0.35", "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<SPEC\>\"", "->", "Red"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<NUMERO\>\"", "->", "Orange"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<COIN\>\"", "->", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.75", ",", "0.45", ",", "0.1"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<CULT\>\"", "->", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.55", ",", "0.3", ",", "0.1"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<HIST\>\"", "->", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.2", ",", "0.2", ",", "0.5"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<RHUFT AXIOM\>\"", "->", 
       RowBox[{"Darker", "[", "Magenta", "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<RHUFT DER\>\"", "->", 
       RowBox[{"Darker", "[", "Teal", "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<CORRECTED\>\"", "->", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.2", ",", "0.6", ",", "0.2"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<DISPROV\>\"", "->", 
       RowBox[{"Darker", "[", "Red", "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<OPEN\>\"", "->", "Black"}]}], "\[IndentingNewLine]", 
     "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"epistemicLabelStyle", "[", "label_", "]"}], ":=", 
    RowBox[{"Style", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "label", ",", "\[IndentingNewLine]", "  ", "White", ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Background", "->", 
       RowBox[{"Lookup", "[", 
        RowBox[{"epistemicColor", ",", "label", ",", "Gray"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", "Bold"}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"labelCell", "[", 
    RowBox[{"label_", ",", "text_"}], "]"}], ":=", 
   RowBox[{"Row", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"epistemicLabelStyle", "[", "label", "]"}], ",", "\"\<  \>\"", ",",
       "text"}], "}"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->"6628c634-\
28aa-774a-8565-d77cedf1a7a9"],

