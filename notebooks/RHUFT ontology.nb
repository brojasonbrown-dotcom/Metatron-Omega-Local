Cell[CellGroupData[{

Cell["22. Optional Quantum Extension Skeleton", "Section",ExpressionUUID->"9132fd8c-fd2b-9e43-a926-1550639976e6"],

Cell[TextData[{
 "If you want to compare RHUFT-style recursive evolution with a quantum \
evolution toy model, the following uses the Wolfram Quantum Framework paclet \
through ",
 ButtonBox["PacletSymbol",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PacletSymbol"],
 ". "
}], "Text",ExpressionUUID->"32a18102-1162-0944-867d-3d78be4ad109"],

