Cell[CellGroupData[{

Cell["16. Consciousness Proxy Laboratory", "Section",ExpressionUUID->"f4cf9e4c-7c61-a042-8791-600a59594b42"],

Cell[TextData[{
 "Formal proxy: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", "\[LongEqual]", 
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           RowBox[{"depth", ",", 
             StyleBox["m", "TI"], "-integration", ",", 
             OverscriptBox["\[CapitalPsi]", "^"], "-accuracy", ",", 
             SubscriptBox[
              StyleBox["c", "TI"], 
              RowBox[{
                StyleBox["t", "TI"], 
                StyleBox["i", "TI"], 
                StyleBox["m", "TI"], 
                StyleBox["e", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Gamma = F(\\text{depth}, m\\text{-integration}, \
\\hat{\\Psi}\\text{-accuracy}, c_{time})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac6ba8db-6071-714a-9cf8-cae2a8fe4cac"]
}], "Text",ExpressionUUID->"40b3d822-63d7-b642-b950-25491c1c106d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "consciousnessCondition", ",", "recursiveDepthProxy", ",", 
     "memoryIntegrationProxy", ",", "selfPredictionAccuracyProxy"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"recursiveDepthProxy", "[", 
    RowBox[{"treeBranching_", ",", "depth_"}], "]"}], ":=", 
   RowBox[{"treeBranching", "*", "depth"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"memoryIntegrationProxy", "[", "memoryTrace_List", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "memoryTrace", "]"}], "<", "2"}], ",", "0", ",", 
     RowBox[{"clamp01", "[", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"StandardDeviation", "[", "memoryTrace", "]"}]}], ")"}]}], 
      "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"selfPredictionAccuracyProxy", "[", 
    RowBox[{"pred_List", ",", "actual_List"}], "]"}], ":=", 
   RowBox[{"clamp01", "[", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"pred", "-", "actual"}], ")"}], "^", "2"}], "]"}]}], 
      ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"consciousnessCondition", "[", 
    RowBox[{"gamma_", ",", "gammaCrit_"}], "]"}], ":=", 
   RowBox[{"gamma", ">", "gammaCrit"}]}], ";"}]}], "Input",ExpressionUUID->\
"37155487-6343-064a-a4f4-6b5ac32854ac"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "actual", ",", "pred", ",", "mem", ",", "depthScore", ",", "memScore", ",",
        "accScore", ",", "gammaVal"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"actual", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"w", " ", "t"}], "]"}], "+", 
          RowBox[{"noise", " ", 
           RowBox[{"RandomVariate", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", "1"}], "]"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tmax", ",", "dt"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"pred", "=", 
       RowBox[{
        RowBox[{"MovingAverage", "[", 
         RowBox[{"actual", ",", "2"}], "]"}], " ", "~", "Join", "~", " ", 
        RowBox[{"{", 
         RowBox[{"Last", "[", "actual", "]"}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"mem", "=", 
       RowBox[{
        RowBox[{"Accumulate", "[", "actual", "]"}], "/", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "actual", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"depthScore", "=", 
       RowBox[{
        RowBox[{"recursiveDepthProxy", "[", 
         RowBox[{"branching", ",", "depth"}], "]"}], "/", "100."}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"memScore", "=", 
       RowBox[{"memoryIntegrationProxy", "[", "mem", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"accScore", "=", 
       RowBox[{"selfPredictionAccuracyProxy", "[", 
        RowBox[{"pred", ",", "actual"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"gammaVal", "=", 
       RowBox[{"consciousnessProxy", "[", 
        RowBox[{
        "coherence", ",", "closure", ",", "depthScore", ",", "memScore", ",", 
         "accScore"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Grid", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Metric\>\"", ",", "Bold"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Value\>\"", ",", "Bold"}], "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{"\"\<Depth proxy\>\"", ",", "depthScore"}], "}"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{"\"\<Memory integration\>\"", ",", "memScore"}], "}"}], 
             ",", "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{"\"\<Prediction accuracy\>\"", ",", "accScore"}], "}"}],
              ",", "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{"\"\<Gamma proxy\>\"", ",", "gammaVal"}], "}"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{"\"\<Conscious?\>\"", ",", 
               RowBox[{"consciousnessCondition", "[", 
                RowBox[{"gammaVal", ",", "gammaCrit"}], "]"}]}], "}"}]}], 
            "\[IndentingNewLine]", "      ", "}"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "    ", 
          "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"actual", ",", "pred", ",", "mem"}], "}"}], ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<actual\>\"", ",", "\"\<pred\>\"", 
              ",", "\"\<memory trace\>\""}], "}"}]}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], 
        "\[IndentingNewLine]", "  ", "}"}], "]"}]}]}], "\[IndentingNewLine]", 
    " ", "]"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"coherence", ",", "0.8"}], "}"}], ",", "0", ",", "1", ",", 
     "0.01"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"closure", ",", "0.8"}], "}"}], ",", "0", ",", "1", ",", 
     "0.01"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"branching", ",", "3"}], "}"}], ",", "1", ",", "10", ",", "1"}],
     "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"depth", ",", "6"}], "}"}], ",", "1", ",", "20", ",", "1"}], 
    "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", ",", "1.0"}], "}"}], ",", "0.1", ",", "10", ",", "0.01"}], 
    "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"noise", ",", "0.05"}], "}"}], ",", "0", ",", "1", ",", 
     "0.005"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tmax", ",", "20"}], "}"}], ",", "5", ",", "100", ",", "1"}], 
    "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dt", ",", "0.2"}], "}"}], ",", "0.05", ",", "1", ",", "0.01"}],
     "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gammaCrit", ",", "0.2"}], "}"}], ",", "0", ",", "1", ",", 
     "0.01"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"SaveDefinitions", "->", "True"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"ControlPlacement", "->", "Left"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"af2fa92e-3b5e-344f-a057-75756db0ab75"],

