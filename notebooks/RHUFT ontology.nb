     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "cbe55d07-6503-4a42-b596-406feddaae42"]
 }], "InlineItem",ExpressionUUID->"ab5d3f0c-ec50-f842-a633-b718a46030ae"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "external forcing ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox[
         StyleBox["f", FontSlant -> "Bold"], 
         StyleBox["ext", FontSlant -> "Plain"]], TraditionalForm], 
      "errors" -> {}, "input" -> "\\mathbf{f}_{\\mathrm{ext}}", "state" -> 
      "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "f7ce7cd5-a4eb-1542-a48b-dc783b1b6544"]
 }], "InlineItem",ExpressionUUID->"218c1ba4-d7aa-a14e-969b-2fe5699eeccc"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"84bbe076-49df-094a-9f85-717bde1ffb7c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"3. RHUFT/MRCE-style generalized coupled system\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7584ac9f-086e-de44-b8e7-b0200a089252"],
 "\nIf your notebook is trying to unify many model classes under one \
umbrella, a very useful canonical system is: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["q", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             UnderoverscriptBox["\[Sum]", 
              RowBox[{
                StyleBox["j", "TI"], "\[LongEqual]", "1"}], 
              StyleBox["m", "TI"], LimitsPositioning -> True], 
             SubscriptBox[
              StyleBox["D", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["j", "TI"]}]], 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["q", FontSlant -> "Bold"], ",", 
                 StyleBox["x", FontSlant -> "Bold"], ",", 
                 StyleBox["t", "TI"]}], ")"}], "\[Del]", 
             SubscriptBox[
              StyleBox["q", "TI"], 
              StyleBox["j", "TI"]], "+", 
             SubscriptBox[
              StyleBox["v", FontSlant -> "Bold"], 
              StyleBox["i", "TI"]], 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["q", FontSlant -> "Bold"], ",", 
                 StyleBox["x", FontSlant -> "Bold"], ",", 
                 StyleBox["t", "TI"]}], ")"}], " ", 
             SubscriptBox[
              StyleBox["q", "TI"], 
              StyleBox["i", "TI"]], "+", 
             SubsuperscriptBox[
              StyleBox["J", FontSlant -> "Bold"], 
              StyleBox["i", "TI"], 
              StyleBox["cross", FontSlant -> "Plain"]]}], ")"}], 
         "\[LongEqual]", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["q", FontSlant -> "Bold"], ",", 
             StyleBox["x", FontSlant -> "Bold"], ",", 
             StyleBox["t", "TI"]}], ")"}], "+", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"\[Alpha]", "\[LongEqual]", "1"}], 
          StyleBox["p", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "\[Alpha]"}]], " ", 
         SubscriptBox["\[Psi]", "\[Alpha]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{\\partial q_i}{\\partial t}\n+\n\\nabla\\cdot\n\\left(\n- \
\\sum_{j=1}^{m} D_{ij}(\\mathbf{q},\\mathbf{x},t)\\nabla q_j\n+ \
\\mathbf{v}_i(\\mathbf{q},\\mathbf{x},t)\\, q_i\n+ \
\\mathbf{J}^{\\mathrm{cross}}_i\n\\right)\n=\nR_i(\\mathbf{q},\\mathbf{x},t)\n\
+\n\\sum_{\\alpha=1}^{p} C_{i\\alpha} \\,\\psi_\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bf71138e-a20e-4948-ab6b-dc730a60dd65"],
 "\nfor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
         StyleBox["m", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i=1,\\dots,m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "18120615-a52e-f647-bf26-48143d61feb4"],
 ".\n\nThis adds: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["cross-diffusion",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"84fab5d4-c98c-ee46-a423-2b170bdb986d"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["field-specific convection",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"cc476f8c-3d0d-3f43-a5e4-1e6e225e3255"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["cross-coupled fluxes",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"fac50792-26dd-354e-ab2c-a9814e2d18af"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["reaction network coupling",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"6d0f1c3a-fe88-3048-9736-5dbcfb598d0f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["auxiliary-field forcing",
   FontWeight->Bold],
  " through ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox["\[Psi]", "\[Alpha]"], TraditionalForm], "errors" -> {}, 
      "input" -> "\\psi_\\alpha", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "6d317526-dfe5-cc45-9515-d70c1a1b46fe"]
 }], "InlineItem",ExpressionUUID->"11e36e6c-11c7-8d45-8b2b-1029a16c12f1"],
 "\nThis is often the right \[OpenCurlyDoubleQuote]unified equations\
\[CloseCurlyDoubleQuote] form if RHUFT/MRCE is meant to be a synthesis \
framework rather than one single model. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"0fea6ad8-e95d-8c48-aff3-718dfd65b2af"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. Gray\[Dash]Scott-type reaction\[Dash]diffusion \
subsystem\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b9d9de60-81de-264e-93c9-e3a488e91e74"],
 "\nFrom the PDE application pattern shown in ",
 Cell[BoxData[
  TemplateBox[{
   "NDSolve", "paclet:ref/NDSolve", 
    "https://reference.wolfram.com/language/ref/NDSolve.html"},
   "TextRefLink"]],ExpressionUUID->"2133b0ee-8c51-4943-8272-5b9277a27dd2"],
 ", a canonical two-species subsystem is: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["u", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["c", "TI"], "1"], "\[CapitalDelta]", 
         StyleBox["u", "TI"], "-", 
         StyleBox["u", "TI"], 
         SuperscriptBox[
          StyleBox["v", "TI"], "2"], "+", 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["u", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\frac{\\partial u}{\\partial t}\n=\nc_1 \\Delta u - u v^2 + f(1-u)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0cab0737-67ca-3947-8515-8ff1b9237697"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["v", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["c", "TI"], "2"], "\[CapitalDelta]", 
         StyleBox["v", "TI"], "+", 
         StyleBox["u", "TI"], 
         SuperscriptBox[
          StyleBox["v", "TI"], "2"], "-", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["f", "TI"], "+", 
             StyleBox["k", "TI"]}], ")"}], 
         StyleBox["v", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial v}{\\partial t}\n=\nc_2 \\Delta v + u v^2 - (f+k)v", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b635f90f-a276-1847-8e6e-1bb94c8593f3"],
 "\nEquivalent conservative-flux form: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["u", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["c", "TI"], "1"], "\[Del]", 
             StyleBox["u", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["f", "TI"], "-", 
         StyleBox["u", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["f", "TI"], "+", 
             SuperscriptBox[
              StyleBox["v", "TI"], "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{\\partial u}{\\partial t} + \\nabla\\cdot(-c_1 \\nabla u)= \
f-u(f+v^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "45f525db-41b2-fa47-b6bd-79f33eb0ca4e"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["v", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["c", "TI"], "2"], "\[Del]", 
             StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", "-", 
         StyleBox["v", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["f", "TI"], "+", 
             StyleBox["k", "TI"], "-", 
             StyleBox["u", "TI"], 
             StyleBox["v", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\frac{\\partial v}{\\partial t} + \\nabla\\cdot(-c_2 \\nabla v)= \
-v(f+k-u v)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a0b50c99-eb56-4c44-ae14-0fca78005fd7"],
 "\nThis is a good \[OpenCurlyDoubleQuote]pattern-forming reaction module\
\[CloseCurlyDoubleQuote] inside a broader unified framework. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"fa10c47e-6b2d-374a-9b06-71d30a65834a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"5. Mass transport framework\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d735e7ae-3526-6b4e-880f-f1ce7cd263d2"],
 "\nFor transport of a scalar concentration ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], "(", 
         RowBox[{
           StyleBox["t", "TI"], ",", 
           StyleBox["x", FontSlant -> "Bold"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "c(t,\\mathbf{x})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d78bfed-5d97-6748-93ee-bab3f6a6a3a6"],
 ", a general mass-transport model is: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["c", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             StyleBox["d", "TI"], "\[Del]", 
             StyleBox["c", "TI"], "+", 
             StyleBox["v", FontSlant -> "Bold"], 
             StyleBox["c", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["s", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["c", "TI"], ",", 
             StyleBox["x", FontSlant -> "Bold"], ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\frac{\\partial c}{\\partial t}\n+\n\\nabla\\cdot\n\\left(\n- d \
\\nabla c + \\mathbf{v} c\n\\right)\n=\ns(c,\\mathbf{x},t)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "875340c3-1f72-624b-af66-ccee110f0301"],
 "\nThis aligns with ",
 Cell[BoxData[
  TemplateBox[{
   "MassTransportPDEComponent", "paclet:ref/MassTransportPDEComponent", 
    "https://reference.wolfram.com/language/ref/MassTransportPDEComponent.\
html"},
   "TextRefLink"]],ExpressionUUID->"29ef78f0-e7af-6744-bd04-24a2424f20e6"],
 ", which is part of the ",
 Cell[BoxData[
  TemplateBox[{
   "Mass Transport PDE Components", "paclet:guide/MassTransportPDEModels", 
    "https://reference.wolfram.com/language/guide/MassTransportPDEModels.\
html"},
   "TextRefLink"]],ExpressionUUID->"2644e903-e620-4f44-ac2a-c40e0b73530c"],
 " ecosystem within ",
 Cell[BoxData[
  TemplateBox[{
   "PDE Modeling", "paclet:guide/PDEModeling", 
    "https://reference.wolfram.com/language/guide/PDEModeling.html"},
   "TextRefLink"]],ExpressionUUID->"01307688-3d7b-6e49-98a2-6c7bb79fced0"],
 ".\n\nFor multiple species: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["c", FontSlant -> "Bold"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             StyleBox["D", FontSlant -> "Bold"], "\[Del]", 
             StyleBox["c", FontSlant -> "Bold"], "+", 
             StyleBox["V", FontSlant -> "Bold"], 
             StyleBox["c", FontSlant -> "Bold"]}], ")"}], "\[LongEqual]", 
         StyleBox["r", FontSlant -> "Bold"], 
         RowBox[{"(", 
           StyleBox["c", FontSlant -> "Bold"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{\\partial \\mathbf{c}}{\\partial t}\n+\n\\nabla\\cdot\n\\left(\n\
-\\mathbf{D}\\nabla \\mathbf{c}\n+\\mathbf{V}\\mathbf{c}\n\\right)\n=\n\
\\mathbf{r}(\\mathbf{c})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0dea3833-3763-fd4b-b668-6334cab59fe9"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"a0a8a89a-ef22-e443-9bb3-2bb0b84d9379"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"6. Axisymmetric transport / Lamm-type structure\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ebf8cc10-83e1-ad4a-b3a8-1b799ad53f6d"],
 "\nA 1D axisymmetric conservative transport equation, inspired by the \
Lamm-equation example in ",
 Cell[BoxData[
  TemplateBox[{
   "MassTransportPDEComponent", "paclet:ref/MassTransportPDEComponent", 
    "https://reference.wolfram.com/language/ref/MassTransportPDEComponent.\
html"},
   "TextRefLink"]],ExpressionUUID->"9dbeddfd-bd92-f447-91a3-522ef1208030"],
 ", can be written as: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["c", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", 
         FractionBox["1", 
          StyleBox["r", "TI"]], 
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["r", "TI"]}]], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["r", "TI"], "(", 
             RowBox[{"-", 
               StyleBox["d", "TI"], 
               FractionBox[
                RowBox[{"\[PartialD]", 
                  StyleBox["c", "TI"]}], 
                RowBox[{"\[PartialD]", 
                  StyleBox["r", "TI"]}]], "+", 
               SubscriptBox[
                StyleBox["v", "TI"], 
                StyleBox["r", "TI"]], 
               StyleBox["c", "TI"]}], ")"}], "]"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial c}{\\partial t}\n+\n\
\\frac{1}{r}\\frac{\\partial}{\\partial r}\n\\left[\n\
r\\left(-d\\frac{\\partial c}{\\partial r}+v_r c\\right)\n\\right]\n=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d86fe2f-48c2-b34e-8b8f-905650ce4b6c"],
 "\nWhen: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["r", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["s", "TI"], 
          StyleBox["c", "TI"]], 
         SuperscriptBox["\[Omega]", "2"], 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "v_r = s_c \\omega^2 r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bc6ec89a-2da8-9043-9cd0-c1bfeff519df"],
 "\nthe model becomes: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["c", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", 
         FractionBox["1", 
          StyleBox["r", "TI"]], 
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["r", "TI"]}]], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["r", "TI"], "(", 
             RowBox[{"-", 
               StyleBox["d", "TI"], 
               FractionBox[
                RowBox[{"\[PartialD]", 
                  StyleBox["c", "TI"]}], 
                RowBox[{"\[PartialD]", 
                  StyleBox["r", "TI"]}]], "+", 
               SubscriptBox[
                StyleBox["s", "TI"], 
                StyleBox["c", "TI"]], 
               SuperscriptBox["\[Omega]", "2"], 
               StyleBox["r", "TI"], " ", 
               StyleBox["c", "TI"]}], ")"}], "]"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial c}{\\partial t}\n+\n\
\\frac{1}{r}\\frac{\\partial}{\\partial r}\n\\left[\n\
r\\left(-d\\frac{\\partial c}{\\partial r}+s_c\\omega^2 r\\, c\\right)\n\
\\right]\n=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dea9a588-42da-7240-92d1-087d31a51297"],
 "\nThis is a nice \[OpenCurlyDoubleQuote]radial transport module\
\[CloseCurlyDoubleQuote] for the unified framework. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"218f61bd-7505-2541-ad06-85af602d5fa2"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"7. Electrochemical / boundary-reaction transport\"\>", 
    "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"cf4b1fb5-dd73-3441-9213-3f8ca3d45ec4"],
 "\nA coupled two-species transport model can be written as: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["c", "TI"], 
             StyleBox["A", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["d", "TI"], 
              StyleBox["A", "TI"]], "\[Del]", 
             SubscriptBox[
              StyleBox["c", "TI"], 
              StyleBox["A", "TI"]]}], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial c_A}{\\partial t} + \\nabla\\cdot(-d_A \\nabla c_A)=0",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c445dc65-d603-9f4c-9160-4a2fc79bb6e7"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["c", "TI"], 
             StyleBox["B", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["d", "TI"], 
              StyleBox["B", "TI"]], "\[Del]", 
             SubscriptBox[
              StyleBox["c", "TI"], 
              StyleBox["B", "TI"]]}], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial c_B}{\\partial t} + \\nabla\\cdot(-d_B \\nabla c_B)=0",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "598be341-6e0e-434b-a3ba-5a9f95dbe068"],
 "\nwith reactive boundary coupling: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         StyleBox["n", FontSlant -> "Bold"], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["d", "TI"], 
              StyleBox["A", "TI"]], "\[Del]", 
             SubscriptBox[
              StyleBox["c", "TI"], 
              StyleBox["A", "TI"]]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["c", "TI"]], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["A", "TI"]], "-", 
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["a", "TI"]], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["B", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "- \\mathbf{n}\\cdot(-d_A \\nabla c_A)= k_c c_A - k_a c_B", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d4fdf7ee-ac78-b349-99d4-7c8b7fbd08aa"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         StyleBox["n", FontSlant -> "Bold"], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["d", "TI"], 
              StyleBox["B", "TI"]], "\[Del]", 
             SubscriptBox[
              StyleBox["c", "TI"], 
              StyleBox["B", "TI"]]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["a", "TI"]], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["B", "TI"]], "-", 
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["c", "TI"]], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["A", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "- \\mathbf{n}\\cdot(-d_B \\nabla c_B)= k_a c_B - k_c c_A", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2f4da265-c2e0-2643-80e5-9fff37c85ee4"],
 "\nThis is structurally consistent with the coupled application form in ",
 Cell[BoxData[
  TemplateBox[{
   "MassTransportPDEComponent", 
    "paclet:ref/MassTransportPDEComponent#1764642656", 
    "https://reference.wolfram.com/language/ref/MassTransportPDEComponent#\
1764642656.html"},
   "TextRefLink"]],ExpressionUUID->"8ca2abe4-5fe3-2c43-bdc5-79e83a545ce0"],
 ".\n\nSo in a unified RHUFT/MRCE sense, one can distinguish: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["bulk evolution equations",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"dfc2469a-1a53-3a4b-bcc5-d7dfd04a53d2"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["interfacial reaction operators",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"bc8311a2-5807-5e41-bb13-31155d776f0f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["far-field concentration constraints",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"b990a97a-009c-5741-a43c-49b7062b8771"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"ad7cf97d-648e-9b45-87a6-5d6c4f25d52c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"8. Coupling to electrostatics\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"8a93955c-47be-b34b-a9cb-3f68bb9fcc28"],
 "\nA natural extension is to couple transport to an electrostatic potential ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ff34e8a0-634b-904d-afa7-66c4a10b1777"],
 ". Using the electrostatics framework around ",
 Cell[BoxData[
  TemplateBox[{
   "ElectrostaticPDEComponent", "paclet:ref/ElectrostaticPDEComponent", 
    "https://reference.wolfram.com/language/ref/ElectrostaticPDEComponent.\
html"},
   "TextRefLink"]],ExpressionUUID->"a39d2bf6-a0e4-6247-9a9f-c1815ecafd56"],
 ", a standard field equation is: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"\[Epsilon]", "\[Del]", "\[Phi]"}], ")"}], "\[LongEqual]", 
         "\[Rho]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "-\\nabla\\cdot(\\varepsilon \\nabla \\phi)=\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4883bb6e-fd5d-e447-81a1-a07dfbdda3fd"],
 "\nFor charged species transport, the flux can be extended to a \
Nernst\[Dash]Planck-type form: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["i", "TI"]], "\[Del]", 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["i", "TI"]], "-", 
         SubscriptBox["\[Mu]", 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["z", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["i", "TI"]], "\[Del]", "\[Phi]", "+", 
         StyleBox["v", FontSlant -> "Bold"], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{J}_i\n=\n- D_i \\nabla c_i\n- \\mu_i z_i c_i \\nabla \\phi\n+ \
\\mathbf{v} c_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a8e79bb5-ce1c-8747-ad4a-9dd7a3f09a47"],
 "\nand therefore: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["c", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["c", FontSlant -> "Bold"], ",", "\[Phi]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial c_i}{\\partial t}\n+\n\\nabla\\cdot \\mathbf{J}_i\n=\n\
R_i(\\mathbf{c},\\phi)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "452cca33-1f6f-074a-9688-35afb9e3b43b"],
 "\nwith charge density: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["i", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["z", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["i", "TI"]], "+", 
         SubscriptBox["\[Rho]", 
          StyleBox["fixed", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\rho = \\sum_i z_i c_i + \\rho_{\\mathrm{fixed}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1e4e780-b010-d247-9c4d-9e40451cedc3"],
 "\nThis gives a powerful unified ",
 StyleBox["transport + field + reaction",
  FontWeight->Bold],
 " framework. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"297bc850-3de6-8348-85b9-907f94cc3bc8"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"9. Unified multiphysics RHUFT/MRCE master block\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b3a9bdc9-2294-b240-9f3e-481aa5ab688a"],
 "\nA strong \[OpenCurlyDoubleQuote]super complete\[CloseCurlyDoubleQuote] \
master system is: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["q", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["q", FontSlant -> "Bold"], ",", "\[Psi]", ",", 
             StyleBox["x", FontSlant -> "Bold"], ",", 
             StyleBox["t", "TI"]}], ")"}], "    ", 
         StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
         StyleBox["m", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial q_i}{\\partial t}\n+\n\\nabla\\cdot \\mathbf{J}_i\n=\n\
R_i(\\mathbf{q},\\boldsymbol{\\psi},\\mathbf{x},t)\n\\qquad i=1,\\dots,m", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5de02861-fbdf-b346-a798-93ca5bafb3c9"],
 "\nwith fluxes \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["m", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["D", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[Del]", 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["j", "TI"]], "+", 
         SubscriptBox[
          StyleBox["v", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "-", 
         SubscriptBox["\[Chi]", 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[Del]", "\[Phi]", "+", 
         SubsuperscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"], 
          StyleBox["nonlocal", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathbf{J}_i\n=\n- \\sum_{j=1}^{m} D_{ij}\\nabla q_j\n+ \\mathbf{v}_i \
q_i\n- \\chi_i q_i \\nabla \\phi\n+ \\mathbf{J}^{\\mathrm{nonlocal}}_i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a3694043-1110-7c41-98b1-ba8f03591d82"],
 "\nand auxiliary fields \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], "\[Alpha]"], 
         RowBox[{"(", 
           RowBox[{"\[Psi]", ",", 
             StyleBox["q", FontSlant -> "Bold"], ",", 
             StyleBox["x", FontSlant -> "Bold"], ",", 
             StyleBox["t", "TI"]}], ")"}], "\[LongEqual]", "0    ", 
         "\[Alpha]", "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
         StyleBox["p", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{L}_\\alpha(\\boldsymbol{\\psi},\\mathbf{q},\\mathbf{x},t)=0\n\
\\qquad \\alpha=1,\\dots,p", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4ea93858-689c-cf48-ba8b-17f8b26c14cc"],
 "\nExamples of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["L", "TI"], "\[Alpha]"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{L}_\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7c5613f7-2ed8-7e44-b9e2-aca027b37578"],
 ": \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "electrostatics"
 }], "InlineItem",ExpressionUUID->"af2ac138-ba3a-9e42-984b-9bae20865429"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "elasticity"
 }], "InlineItem",ExpressionUUID->"83c22c19-f77c-8044-95f2-1da6ff097d55"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "heat transfer"
 }], "InlineItem",ExpressionUUID->"f43bf31d-f8f0-bd42-a85b-ece0959a88fd"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "wave/field equations"
 }], "InlineItem",ExpressionUUID->"ef7dd2b4-ba33-8649-bf2a-0446901440ba"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "constraint equations"
 }], "InlineItem",ExpressionUUID->"395641db-201e-eb4c-99de-4e47a8dbdda9"],
 "\nThis form is broad enough to include: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "reaction\[Dash]diffusion systems"
 }], "InlineItem",ExpressionUUID->"8b0a315f-3fee-6e44-ae12-917b724b0353"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "transport with drift"
 }], "InlineItem",ExpressionUUID->"ff8f396e-57d6-3f46-8a87-d544419de9f2"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "finite-element multiphysics"
 }], "InlineItem",ExpressionUUID->"1843b24f-be2b-3e4b-b8ca-68f4a1dfb149"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "interfacial reaction models"
 }], "InlineItem",ExpressionUUID->"a6937a5f-fd02-714c-87c6-d615296d2706"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "boundary-driven systems"
 }], "InlineItem",ExpressionUUID->"d6aa1db4-8efe-324d-b5dd-72a3eebe0d53"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"1472517f-2b07-cc45-abbd-cb4a4bdcbbab"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"10. Boundary condition taxonomy\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e9b0f98e-f814-8d42-bce9-605e3751e86b"],
 "\nA complete unified framework should classify boundaries by ",
 StyleBox["flux",
  FontWeight->Bold],
 ", ",
 StyleBox["value",
  FontWeight->Bold],
 ", and ",
 StyleBox["transfer",
  FontWeight->Bold],
 ". \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Dirichlet/value condition\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"2cb4f098-0e5d-0c44-aa07-9ce34ccf19b1"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["i", "TI"]], "  ", "on ", 
         SubscriptBox["\[CapitalGamma]", 
          StyleBox["D", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "q_i = g_i\n\\quad \\text{on } \\Gamma_D", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "62ee9afb-27ec-9d4c-9a57-2a789782b3a9"],
 "\nIn Wolfram Language this is typically ",
 Cell[BoxData[
  TemplateBox[{
   "DirichletCondition", "paclet:ref/DirichletCondition", 
    "https://reference.wolfram.com/language/ref/DirichletCondition.html"},
   "TextRefLink"]],ExpressionUUID->"4a7ecb7f-e9ba-5e4b-96ff-f9d41978f1fb"],
 ", and for mass transport specifically ",
 Cell[BoxData[
  TemplateBox[{
   "MassConcentrationCondition", "paclet:ref/MassConcentrationCondition", 
    "https://reference.wolfram.com/language/ref/MassConcentrationCondition.\
html"},
   "TextRefLink"]],ExpressionUUID->"2ff730e0-5d6a-8947-abd4-920944baac2d"],
 ", which effectively evaluates to a Dirichlet condition. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Neumann/flux condition\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a7640904-6007-8743-9698-d13bb72d63be"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", FontSlant -> "Bold"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], "  ", "on ", 
         SubscriptBox["\[CapitalGamma]", 
          StyleBox["N", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{n}\\cdot \\mathbf{J}_i = h_i\n\\quad \\text{on } \\Gamma_N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bdc23c75-58c6-1843-b7ef-e9622fd267b0"],
 "\nFor transport models this corresponds to tools like: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
    "MassFluxValue", "paclet:ref/MassFluxValue", 
     "https://reference.wolfram.com/language/ref/MassFluxValue.html"},
    "TextRefLink"]],ExpressionUUID->"3fe68c2c-4514-0e4e-8593-57f319c9f230"]
 }], "InlineItem",ExpressionUUID->"f47744ac-5471-2d4f-b7c7-2efb0e908020"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
    "MassImpermeableBoundaryValue", "paclet:ref/MassImpermeableBoundaryValue",
      "https://reference.wolfram.com/language/ref/\
MassImpermeableBoundaryValue.html"},
    "TextRefLink"]],ExpressionUUID->"28d74e1a-a27a-a842-b9f2-b6110a0cd1e9"]
 }], "InlineItem",ExpressionUUID->"706acdd3-33e9-e54b-b761-dad3d1a449a7"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
    "MassOutflowValue", "paclet:ref/MassOutflowValue", 
     "https://reference.wolfram.com/language/ref/MassOutflowValue.html"},
    "TextRefLink"]],ExpressionUUID->"4bec6edf-2ea6-ba4b-a252-421a3c027805"]
 }], "InlineItem",ExpressionUUID->"6c9be6e9-1d70-cc4a-8530-66402a40c37e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
    "MassTransferValue", "paclet:ref/MassTransferValue", 
     "https://reference.wolfram.com/language/ref/MassTransferValue.html"},
    "TextRefLink"]],ExpressionUUID->"718433bc-72aa-9445-914f-953fbdac7257"]
 }], "InlineItem",ExpressionUUID->"e1d124c5-5944-8241-89d6-82ff0656172e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
    "MassSymmetryValue", "paclet:ref/MassSymmetryValue", 
     "https://reference.wolfram.com/language/ref/MassSymmetryValue.html"},
    "TextRefLink"]],ExpressionUUID->"065791b2-5aff-684b-920d-f81e0b20c68d"]
 }], "InlineItem",ExpressionUUID->"11e845a5-84e6-ed4a-b311-0ef0fc7a059a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Robin/transfer condition\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"9bbe1d95-428c-2540-ab6c-7a13485d2af8"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", FontSlant -> "Bold"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Kappa]", 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["q", "TI"], 
              StyleBox["i", "TI"]], "-", 
             SubsuperscriptBox[
              StyleBox["q", "TI"], 
              StyleBox["i", "TI"], "*"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathbf{n}\\cdot \\mathbf{J}_i = \\kappa_i(q_i-q_i^{\\ast})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a201ac36-d672-554c-af87-f6e186beb76e"],
 "\nThis is especially important for: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "inflow/outflow"
 }], "InlineItem",ExpressionUUID->"79177f0f-db32-684b-9fb9-775337f7080e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "interfacial exchange"
 }], "InlineItem",ExpressionUUID->"ba3a5efe-52c8-0644-85ba-2dbb3617b034"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "electrode kinetics"
 }], "InlineItem",ExpressionUUID->"a2fe2748-bacd-ef49-ab4d-eecf1a12fb39"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "membrane transport"
 }], "InlineItem",ExpressionUUID->"f1f2d33e-5dcb-f545-b9bf-821140d83239"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"07e74cc0-554b-4b46-b13f-5ccb976e4284"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"11. Initial conditions\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0042949e-1b28-4a43-8424-631d5a6cc5a2"],
 "\nA fully unified transient model requires: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{"0", ",", 
             StyleBox["x", FontSlant -> "Bold"]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["q", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], ",", "0"}]], 
         RowBox[{"(", 
           StyleBox["x", FontSlant -> "Bold"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "q_i(0,\\mathbf{x}) = q_{i,0}(\\mathbf{x})", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d82fb482-ae48-df49-98ac-9ea1b5d9a0d9"],
 "\nand for auxiliary fields if needed: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Psi]", "\[Alpha]"], 
         RowBox[{"(", 
           RowBox[{"0", ",", 
             StyleBox["x", FontSlant -> "Bold"]}], ")"}], "\[LongEqual]", 
         SubscriptBox["\[Psi]", 
          RowBox[{"\[Alpha]", ",", "0"}]], 
         RowBox[{"(", 
           StyleBox["x", FontSlant -> "Bold"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\psi_\\alpha(0,\\mathbf{x}) = \\psi_{\\alpha,0}(\\mathbf{x})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8d31bd89-d1bc-f840-9749-82315ce1dbae"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"8ff5ae9e-36aa-9148-b3b1-244bf0032d36"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"12. Weak form / FEM-ready structure\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ccfb38e2-7efd-c84c-9fc1-daebe75e5add"],
 "\nFor finite element implementation, the conservative PDE \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["q", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         StyleBox["J", FontSlant -> "Bold"], "\[LongEqual]", 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial q}{\\partial t} + \\nabla\\cdot \\mathbf{J} = s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cc20f581-6793-3740-ab98-3d18b33a88bb"],
 "\nhas weak form: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Integral]", "\[CapitalOmega]"], 
         StyleBox["w", "TI"], 
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["q", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "\[DifferentialD]", "\[CapitalOmega]", 
         "-", 
         SubscriptBox["\[Integral]", "\[CapitalOmega]"], "\[Del]", 
         StyleBox["w", "TI"], "\[CenterDot]", 
         StyleBox["J", FontSlant -> "Bold"], "\[DifferentialD]", 
         "\[CapitalOmega]", "+", 
         SubscriptBox["\[Integral]", 
          RowBox[{"\[PartialD]", "\[CapitalOmega]"}]], 
         StyleBox["w", "TI"], " ", 
         StyleBox["n", FontSlant -> "Bold"], "\[CenterDot]", 
         StyleBox["J", FontSlant -> "Bold"], "\[DifferentialD]", 
         "\[CapitalGamma]", "\[LongEqual]", 
         SubscriptBox["\[Integral]", "\[CapitalOmega]"], 
         StyleBox["w", "TI"], 
         StyleBox["s", "TI"], "\[DifferentialD]", "\[CapitalOmega]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\int_{\\Omega} w \\frac{\\partial q}{\\partial t}\\, d\\Omega\n-\n\
\\int_{\\Omega} \\nabla w \\cdot \\mathbf{J}\\, d\\Omega\n+\n\\int_{\\partial \
\\Omega} w\\, \\mathbf{n}\\cdot\\mathbf{J}\\, d\\Gamma\n=\n\\int_{\\Omega} w \
s\\, d\\Omega", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c7c63cae-14b9-d841-86d8-7a6142c6c75d"],
 "\nThis is the conceptual bridge to the finite-element modeling emphasized \
in ",
 Cell[BoxData[
  TemplateBox[{
   "PDE Modeling", "paclet:guide/PDEModeling", 
    "https://reference.wolfram.com/language/guide/PDEModeling.html"},
   "TextRefLink"]],ExpressionUUID->"cb93c808-8e0b-ee46-b994-b1dc98bf9889"],
 ". \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"ab8ed0da-23be-e443-918d-8aca4ada942c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"13. Dimensionless unification\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"067a6b2f-a33c-eb49-8e0b-f26e580a9c3b"],
 "\nA useful \[OpenCurlyDoubleQuote]complete review\[CloseCurlyDoubleQuote] \
notebook should also include a nondimensional form.\n\nLet: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", FontSlant -> "Bold"], "\[LongEqual]", 
         StyleBox["L", "TI"], 
         SuperscriptBox[
          StyleBox["x", FontSlant -> "Bold"], "\[Prime]"], ",    ", 
         StyleBox["t", "TI"], "\[LongEqual]", 
         StyleBox["T", "TI"], 
         SuperscriptBox[
          StyleBox["t", "TI"], "\[Prime]"], ",    ", 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["Q", "TI"], 
          StyleBox["i", "TI"]], 
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"], "\[Prime]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathbf{x}=L\\mathbf{x}' , \\qquad t=T t', \\qquad q_i=Q_i q_i'", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "05e54580-eb78-f041-baf0-7fadea085693"],
 "\nThen a transport-reaction equation becomes: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubsuperscriptBox[
             StyleBox["q", "TI"], 
             StyleBox["i", "TI"], "\[Prime]"]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["t", "TI"], "\[Prime]"]}]], "+", 
         SuperscriptBox["\[Del]", "\[Prime]"], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             FractionBox[
              RowBox[{
                StyleBox["T", "TI"], 
                SubscriptBox[
                 StyleBox["D", "TI"], 
                 StyleBox["i", "TI"]]}], 
              SuperscriptBox[
               StyleBox["L", "TI"], "2"]], 
             SuperscriptBox["\[Del]", "\[Prime]"], 
             SubsuperscriptBox[
              StyleBox["q", "TI"], 
              StyleBox["i", "TI"], "\[Prime]"], "+", 
             FractionBox[
              RowBox[{
                StyleBox["T", "TI"], 
                SubscriptBox[
                 StyleBox["V", "TI"], 
                 StyleBox["i", "TI"]]}], 
              StyleBox["L", "TI"]], 
             SubscriptBox[
              StyleBox["u", FontSlant -> "Bold"], 
              StyleBox["i", "TI"]], 
             SubsuperscriptBox[
              StyleBox["q", "TI"], 
              StyleBox["i", "TI"], "\[Prime]"]}], ")"}], "\[LongEqual]", 
         StyleBox["T", "TI"], " ", 
         FractionBox[
          SubscriptBox[
           StyleBox["R", "TI"], 
           StyleBox["i", "TI"]], 
          SubscriptBox[
           StyleBox["Q", "TI"], 
           StyleBox["i", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial q_i'}{\\partial t'}\n+\n\\nabla' \\cdot\n\\left(\n\
-\\frac{T D_i}{L^2}\\nabla' q_i'\n+\n\\frac{T V_i}{L}\\mathbf{u}_i q_i'\n\
\\right)\n=\nT\\,\\frac{R_i}{Q_i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "13175487-9111-a348-b20d-8e1012e5eb7e"],
 "\nleading to characteristic groups such as: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["P\[EAcute]clet number",
   FontWeight->Bold],
  ":"
 }], "InlineItem",ExpressionUUID->"cf2575e8-056a-2b4e-bbaa-afae5a9ebe95"],
 "\n  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Pe", FontSlant -> "Plain"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["V", "TI"], 
            StyleBox["L", "TI"]}], 
          StyleBox["D", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Pe}=\\frac{V L}{D}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "52011dcd-040b-0b4d-89b4-af2384887a75"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["Damk\[ODoubleDot]hler number",
   FontWeight->Bold],
  ":"
 }], "InlineItem",ExpressionUUID->"994eff85-c005-d34d-8326-4d57bceeb3bc"],
 "\n  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Da", FontSlant -> "Plain"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["k", "TI"], 
            SuperscriptBox[
             StyleBox["L", "TI"], "2"]}], 
          StyleBox["D", "TI"]], "  ", "or", "  ", 
         StyleBox["Da", FontSlant -> "Plain"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["k", "TI"], 
            StyleBox["L", "TI"]}], 
          StyleBox["V", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Da}=\\frac{kL^2}{D}\n  \\quad\\text{or}\\quad\n  \\mathrm{Da}=\
\\frac{kL}{V}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "efa1aad4-1f50-7d4b-b478-eaf1f852c5e4"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["diffusivity ratios",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"5631c423-e54b-084b-9df7-3b07c0a507c8"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["coupling-strength ratios",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"13bf2e9f-c11b-f546-b69d-5e43c2f7d594"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["reaction selectivity parameters",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"36dfbcd1-e3e3-0a4e-bc10-368e2cfefd0a"],
 "\nFor RHUFT/MRCE, this matters because \[OpenCurlyDoubleQuote]unified \
frameworks\[CloseCurlyDoubleQuote] are usually most meaningful in \
dimensionless parameter space. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"95ddb1a1-b5f4-2846-aade-f4a196c7c938"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"14. Symbolic Wolfram Language master templates\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"2fbbff54-af28-b347-8fe5-407296746a8d"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"A. Generic two-field conservative PDE\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"cd80a007-1d10-df46-aa05-252243561636"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"eqns", "=", 
          RowBox[{"{", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{
                RowBox[{
                  RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "t"}], 
                    "]"}], "+", "\[IndentingNewLine]", "    ", 
                  RowBox[{"Div", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "d11"}], " ", 
                    RowBox[{"Grad", "[", 
                    RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "-", 
                    RowBox[{"d12", " ", 
                    RowBox[{"Grad", "[", 
                    RowBox[{
                    RowBox[{"v", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "+", 
                    RowBox[{"velU", " ", 
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "==", 
                "\[IndentingNewLine]", "    ", 
                RowBox[{"reactionU", "[", 
                  RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
                    RowBox[{"v", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "x", ",", 
                    "y", ",", "t"}], "]"}]}], ",", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{
                  RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"v", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "t"}], 
                    "]"}], "+", "\[IndentingNewLine]", "    ", 
                  RowBox[{"Div", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "d21"}], " ", 
                    RowBox[{"Grad", "[", 
                    RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "-", 
                    RowBox[{"d22", " ", 
                    RowBox[{"Grad", "[", 
                    RowBox[{
                    RowBox[{"v", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "+", 
                    RowBox[{"velV", " ", 
                    RowBox[{"v", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "==", 
                "\[IndentingNewLine]", "    ", 
                RowBox[{"reactionV", "[", 
                  RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
                    RowBox[{"v", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "x", ",", 
                    "y", ",", "t"}], "]"}]}]}], "\[IndentingNewLine]", 
            "}"}]}], ";"}]], "ChatCode", "Input", LanguageCategory -> "Input",
      ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "95484ade-2942-1c4f-8b0b-dc4ddf56f40c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"B. Gray\[Dash]Scott form\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"419b666a-eafd-9240-a447-f77be61d1302"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"eqnsGrayScott", "=", 
          RowBox[{"{", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{
                RowBox[{
                  RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "t"}], 
                    "]"}], "+", 
                  RowBox[{"Div", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "c1"}], " ", 
                    RowBox[{"Grad", "[", 
                    RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "==", 
                "\[IndentingNewLine]", "    ", 
                RowBox[{"f", "-", 
                  RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"f", "+", 
                    RowBox[{
                    RowBox[{"v", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], "^", "2"}]}], 
                    ")"}]}]}]}], ",", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{
                  RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"v", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "t"}], 
                    "]"}], "+", 
                  RowBox[{"Div", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "c2"}], " ", 
                    RowBox[{"Grad", "[", 
                    RowBox[{
                    RowBox[{"v", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "==", 
                "\[IndentingNewLine]", "    ", 
                RowBox[{
                  RowBox[{"-", 
                    RowBox[{"v", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], " ", 
                  RowBox[{"(", 
                    RowBox[{"f", "+", "k", "-", 
                    RowBox[{
                    RowBox[{"u", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}], " ", 
                    RowBox[{"v", "[", 
                    RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}], ")"}]}]}]}],
             "\[IndentingNewLine]", "}"}]}], ";"}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "fd7697d7-f73e-1247-872d-d93f7be40917"],
 "\nThis mirrors the application pattern in ",
 Cell[BoxData[
  TemplateBox[{
   "NDSolve", "paclet:ref/NDSolve#6181865", 
    "https://reference.wolfram.com/language/ref/NDSolve#6181865.html"},
   "TextRefLink"]],ExpressionUUID->"14c2b46c-f9a3-f64a-bf6b-0f093488d11c"],
 ". \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"C. Mass transport model component\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b320c6c4-4244-6042-b79b-7d2837ac4f42"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"vars", "=", 
            RowBox[{"{", 
              RowBox[{
                RowBox[{"c", "[", 
                  RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "t", ",", 
                RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}]}], "}"}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"pars", "=", 
            RowBox[{"<|", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"\"DiffusionCoefficient\"", "->", 
                  RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"dxx", ",", "dxy"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"dyx", ",", "dyy"}], "}"}]}], "}"}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"MassConvectionVelocity\"", "->", 
                  RowBox[{"{", 
                    RowBox[{
                    RowBox[{"vx", "[", 
                    RowBox[{"x", ",", "y", ",", "t"}], "]"}], ",", 
                    RowBox[{"vy", "[", 
                    RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], "}"}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"ModelForm\"", "->", "\"Conservative\""}]}], 
              "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"eqn", "=", 
            RowBox[{
              RowBox[{"MassTransportPDEComponent", "[", 
                RowBox[{"vars", ",", "pars"}], "]"}], "==", 
              RowBox[{"source", "[", 
                RowBox[{"x", ",", "y", ",", "t"}], "]"}]}]}], ";"}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "b68abaec-3d07-464a-81cc-d564e94ef3aa"],
