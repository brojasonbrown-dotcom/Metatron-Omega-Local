 RowBox[{
  RowBox[{"hamiltonian", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "t", "]"}], "^", "2"}], "/", "2"}], ")"}], " ", 
     RowBox[{"qOp", "[", "\"\<X\>\"", "]"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"t", "-", "1"}], "]"}], "/", "2"}], ")"}], " ", 
     RowBox[{"qOp", "[", 
      RowBox[{"\"\<I\>\"", "+", "\"\<Z\>\""}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"psi", "=", 
    RowBox[{"qEvolve", "[", 
     RowBox[{"hamiltonian", ",", 
      RowBox[{"qState", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"Pi", "/", "8"}], "]"}], ",", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"Pi", "/", "4"}]}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"Pi", "/", "8"}], "]"}]}]}], "}"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "3."}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"qState", "[", "\"\<UniformMixture\>\"", "]"}], 
    "[", "\"\<BlochPlot\>\"", "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"psi", "[", "\"\<BlochVector\>\"", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "3"}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",ExpressionUUID->"13afc2ef-6ee3-6c48-\
aa89-182a1b21093f"],

Cell[TextData[{
 "This is included only as a ",
 StyleBox["comparison scaffold",
  FontWeight->Bold],
 ", not as a claim that RHUFT reduces to standard quantum dynamics. "
}], "Text",ExpressionUUID->"6b45c75c-ed5f-fb46-b176-7cee47ebc569"],

