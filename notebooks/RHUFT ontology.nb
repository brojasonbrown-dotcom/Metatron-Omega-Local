Cell[CellGroupData[{

Cell["3. Core Constants and Helpers", "Section",ExpressionUUID->"353a6b46-93de-6244-afaa-2914629b0c63"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "phi", ",", "phiInv", ",", "phiInv2", ",", "goldenAngle", ",", 
     "lightSpeed", ",", "hbar", ",", "epsilon0"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phi", "=", "GoldenRatio"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phiInv", "=", 
   RowBox[{"1", "/", "phi"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phiInv2", "=", 
   RowBox[{"1", "/", 
    RowBox[{"phi", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"goldenAngle", "=", 
   RowBox[{"2", " ", "Pi", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "phiInv"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lightSpeed", "=", 
   RowBox[{"QuantityMagnitude", " ", "@", " ", 
    RowBox[{"UnitConvert", "[", 
     RowBox[{
      RowBox[{
       TemplateBox[{"\"speed of light\"", 
         RowBox[{"Entity", "[", 
           RowBox[{"\"PhysicalConstant\"", ",", "\"SpeedOfLight\""}], "]"}], 
         "\"Entity[\\\"PhysicalConstant\\\", \\\"SpeedOfLight\\\"]\"", 
         "\"physical constant\""},
        "Entity"], "[", "\"\<Value\>\"", "]"}], ",", 
      RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hbar", "=", 
   RowBox[{"QuantityMagnitude", " ", "@", " ", 
    RowBox[{"UnitConvert", "[", 
     RowBox[{
      RowBox[{
       TemplateBox[{"\"reduced Planck constant\"", 
         RowBox[{"Entity", "[", 
           RowBox[{"\"PhysicalConstant\"", ",", "\"ReducedPlanckConstant\""}],
            "]"}], "\"Entity[\\\"PhysicalConstant\\\", \
\\\"ReducedPlanckConstant\\\"]\"", "\"physical constant\""},
        "Entity"], "[", "\"\<Value\>\"", "]"}], ",", 
      RowBox[{"\"\<Joules\>\"", "*", "\"\<Seconds\>\""}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"epsilon0", "=", 
    RowBox[{"10", "^", 
     RowBox[{"-", "12"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "safeNorm", ",", "safeMean", ",", "normalizeVector", ",", "clamp01", ",", 
     "boundedValue"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"safeNorm", "[", 
    RowBox[{"x_", ",", 
     RowBox[{"e_", ":", " ", "epsilon0"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Norm", "[", "x", "]"}], "+", "e"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"safeMean", "[", "list_List", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"list", "===", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"Missing", "[", "\"\<Empty\>\"", "]"}], ",", 
     RowBox[{"Mean", "[", "list", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normalizeVector", "[", "v_", "]"}], ":=", 
   RowBox[{"v", "/", 
    RowBox[{"safeNorm", "[", "v", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"clamp01", "[", "x_", "]"}], ":=", 
   RowBox[{"Clip", "[", 
    RowBox[{"x", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"boundedValue", "[", 
    RowBox[{"x_", ",", 
     RowBox[{"{", 
      RowBox[{"xmin_", ",", "xmax_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Clip", "[", 
    RowBox[{"x", ",", 
     RowBox[{"{", 
      RowBox[{"xmin", ",", "xmax"}], "}"}]}], "]"}]}], ";"}]}], "Input",Expres\
sionUUID->"5700cb27-626b-194e-a41d-a9decd49e60f"],

