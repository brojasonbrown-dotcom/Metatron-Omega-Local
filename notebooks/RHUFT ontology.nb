Cell[CellGroupData[{

Cell["Programmable inertia toy model", "Subsection",ExpressionUUID->"e267e88c-7593-054a-8336-455cb18c0b00"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "programmableInertia", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"programmableInertia", "[", 
     RowBox[{
     "t_", ",", "mi0_", ",", "amps_List", ",", "freqs_List", ",", 
      "phases_List"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
    RowBox[{"mi0", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Total", "[", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", " ", 
            RowBox[{"Cos", "[", 
             RowBox[{
              RowBox[{"#2", " ", "t"}], "+", "#3"}], "]"}]}], " ", "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"amps", ",", "freqs", ",", "phases"}], "}"}]}], "]"}], 
        "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"programmableInertia", "[", 
