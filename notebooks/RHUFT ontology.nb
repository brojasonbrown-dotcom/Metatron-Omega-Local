Cell[CellGroupData[{

Cell["8. Operator Prototypes", "Section",ExpressionUUID->"3a66dbc4-e1a7-a543-a643-433256d9e716"],

Cell[TextData[{
 "These are ",
 StyleBox["explicit test instantiations",
  FontWeight->Bold],
 " of the operator symbols when the theory text does not uniquely specify \
them. "
}], "Text",ExpressionUUID->"971c8f19-e69c-7b49-a328-b0d5c8755755"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "projectionOperator", ",", "reflectionOperator", ",", 
     "comparisonOperator", ",", "\[IndentingNewLine]", "  ", 
     "stabilizationOperator", ",", "memoryUpdateOperator", ",", 
     "normalizationOperator", ",", "\[IndentingNewLine]", "  ", 
     "aggregationOperator", ",", "constraintOperator", ",", 
     "geometryOperator"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"projectionOperator", "[", 
     RowBox[{"input_", ",", "state_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"0.5", " ", "input"}], "+", 
     RowBox[{"0.5", " ", "state"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"reflectionOperator", "[", 
     RowBox[{"memory_", ",", "state_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"0.5", " ", "memory"}], "+", 
     RowBox[{"0.5", " ", "state"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"comparisonOperator", "[", 
     RowBox[{"state_", ",", "lawTarget_"}], "]"}], ":=", 
    RowBox[{"lawTarget", "-", "state"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stabilizationOperator", "[", 
     RowBox[{"selfModel_", ",", "state_"}], "]"}], ":=", 
    RowBox[{"selfModel", "-", "state"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"memoryUpdateOperator", "[", 
     RowBox[{"memory_", ",", "state_", ",", 
      RowBox[{"lambda_", ":", " ", "0.2"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "lambda"}], ")"}], " ", "memory"}], "+", 
     RowBox[{"lambda", " ", "state"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"normalizationOperator", "[", "vec_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v", "=", "vec"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"v", ",", 
        RowBox[{"{", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"2", "->", 
           RowBox[{"clamp01", "[", 
            RowBox[{"v", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"4", "->", 
           RowBox[{"Max", "[", 
            RowBox[{"0", ",", 
             RowBox[{"v", "[", 
              RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"5", "->", 
           RowBox[{"clamp01", "[", 
            RowBox[{"v", "[", 
             RowBox[{"[", "5", "]"}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"8", "->", 
           RowBox[{"Max", "[", 
            RowBox[{"0", ",", 
             RowBox[{"v", "[", 
              RowBox[{"[", "8", "]"}], "]"}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "  ", "}"}]}], "]"}]}], "\[IndentingNewLine]",
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aggregationOperator", "[", "lowerScaleState_", "]"}], ":=", 
   RowBox[{"Mean", "[", "lowerScaleState", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"constraintOperator", "[", "higherScaleState_", "]"}], ":=", 
   "higherScaleState"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"geometryOperator", "[", 
    RowBox[{"state_", ",", "geometryCode_"}], "]"}], ":=", 
   RowBox[{"state", "+", 
    RowBox[{"0.05", " ", "geometryCode"}]}]}], ";"}]}], "Input",ExpressionUUID\
->"febfe32a-5cea-9d4d-b24d-5edbf552e2fc"],

