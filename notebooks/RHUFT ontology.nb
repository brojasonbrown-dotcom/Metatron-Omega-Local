         "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<TemporalCoherence\>\"", "->", 
         RowBox[{"temporalCoherence", "[", 
          RowBox[{"psiMem", ",", "psiNoMem"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<FixedPointErrorMemory\>\"", "->", 
         RowBox[{"Mean", "@", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"psiMem", "-", "target"}], "]"}], ",", 
            RowBox[{"-", "10"}]}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<FixedPointErrorNoMemory\>\"", "->", 
