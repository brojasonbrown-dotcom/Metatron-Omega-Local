     RowBox[{"PlotLabel", "->", "\"\<Programmable inertia toy model\>\""}]}], 
    "\[IndentingNewLine]", " ", "]"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mi0", ",", "1.0"}], "}"}], ",", "0.1", ",", "5", ",", "0.01"}],
     "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a1", ",", "0.1"}], "}"}], ",", "0", ",", "0.5", ",", "0.005"}],
     "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a2", ",", "0.04"}], "}"}], ",", "0", ",", "0.5", ",", 
     "0.005"}], "}"}], ",", 
   RowBox[{"{", 
