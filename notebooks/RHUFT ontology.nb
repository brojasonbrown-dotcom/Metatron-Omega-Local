Cell[CellGroupData[{

Cell["7. Geometry Utilities", "Section",ExpressionUUID->"d84c0969-2cd6-9140-82da-48c9b795fb4d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "goldenAngleScan", ",", "periodicScan", ",", "coverageDiscrepancy", ",", 
     "spiralPoints"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"goldenAngleScan", "[", 
    RowBox[{
     RowBox[{"steps_Integer", "?", "Positive"}], ",", 
     RowBox[{"theta0_", ":", " ", "0."}]}], "]"}], ":=", 
   RowBox[{"NestList", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"#", "+", "goldenAngle"}], ",", 
        RowBox[{"2", " ", "Pi"}]}], "]"}], " ", "&"}], ",", "theta0", ",", 
     RowBox[{"steps", "-", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"periodicScan", "[", 
     RowBox[{"omega_", ",", 
      RowBox[{"steps_Integer", "?", "Positive"}], ",", 
      RowBox[{"theta0_", ":", " ", "0."}]}], "]"}], ":=", 
    RowBox[{"NestList", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"#", "+", "omega"}], ",", 
         RowBox[{"2", " ", "Pi"}]}], "]"}], " ", "&"}], ",", "theta0", ",", 
      RowBox[{"steps", "-", "1"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"coverageDiscrepancy", "[", 
     RowBox[{"angles_List", ",", 
      RowBox[{"bins_", ":", " ", "60"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "hist", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"hist", "=", 
        RowBox[{
         RowBox[{"BinCounts", "[", 
          RowBox[{"angles", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"2", " ", "Pi"}], ",", 
             RowBox[{"2", " ", 
              RowBox[{"Pi", "/", "bins"}]}]}], "}"}]}], "]"}], "/", 
         RowBox[{"Length", "[", "angles", "]"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"hist", "-", 
           RowBox[{"Mean", "[", "hist", "]"}]}], ")"}], "^", "2"}], "]"}]}]}],
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spiralPoints", "[", "angles_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "r", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "angles", "]"}], "]"}], "/", 
         RowBox[{"Length", "[", "angles", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", " ", 
          RowBox[{"Cos", "[", "angles", "]"}]}], ",", 
         RowBox[{"r", " ", 
          RowBox[{"Sin", "[", "angles", "]"}]}]}], "}"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"2f53d015-fcd7-a840-ab36-04726c4c0f25"],

