Cell[CellGroupData[{

Cell["14. Burden, Mass, and Gravity Proxies", "Section",ExpressionUUID->"52ce6081-c8d6-4948-8301-fd259e73f0f8"],

Cell[TextData[{
 "Formal text: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", 
          StyleBox["I", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ";", 
             StyleBox["n", "TI"]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], "1"], 
         StyleBox["H", "TI"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "2"], 
         StyleBox["R", "TI"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "3"], 
         StyleBox["K", "TI"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "4"], 
         StyleBox["S", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho_I(x;n) = a_1 H + a_2 R + a_3 K + a_4 S", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e7a749e2-7b69-534a-96e2-8fdd3389b1c4"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["t", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Integral]", 
          SubscriptBox["\[CapitalOmega]", 
           StyleBox["n", "TI"]]], 
         SubscriptBox["\[Rho]", 
          StyleBox["I", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ";", 
             StyleBox["n", "TI"]}], ")"}], "\[Kappa]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ";", 
             StyleBox["n", "TI"]}], ")"}], 
         SubscriptBox["\[Tau]", 
          RowBox[{
            StyleBox["p", "TI"], 
            StyleBox["e", "TI"], 
            StyleBox["r", "TI"], 
            StyleBox["s", "TI"], 
            StyleBox["i", "TI"], 
            StyleBox["s", "TI"], 
            StyleBox["t", "TI"]}]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[DifferentialD]", 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "b_t^n = \\int_{\\Omega_n} \\rho_I(x;n) \\kappa(x;n) \\tau_{persist}(x) \
\\, dx", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0045d278-ece9-de41-99e2-28d0851a25a0"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Del]", "2"], 
         SubscriptBox["\[CapitalPhi]", 
          StyleBox["b", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Lambda]\[Rho]", 
          StyleBox["b", "TI"]], ",  ", 
         SubscriptBox[
          StyleBox["F", "TI"], 
          StyleBox["g", "TI"]], "\[LongEqual]", "-", "\[Del]", 
         SubscriptBox["\[CapitalPhi]", 
          StyleBox["b", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla^2 \\Phi_b = \\lambda \\rho_b, \\quad F_g = -\\nabla \\Phi_b", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5762c274-ec33-fc4a-b8f3-54224a1871f7"],
 "We implement a discrete 2D proxy field. "
}], "Text",ExpressionUUID->"529162ad-6574-3044-832b-4383910099da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "informationDensityField", ",", "burdenField", ",", 
     "solveBurdenPotential2D"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"informationDensityField", "[", 
     RowBox[{
     "entropy_", ",", "relation_", ",", "curvature_", ",", "persistence_", ",", 
      RowBox[{"weights_", ":", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"weights", ".", 
     RowBox[{"{", 
      RowBox[{
      "entropy", ",", "relation", ",", "curvature", ",", "persistence"}], 
      "}"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"burdenField", "[", 
     RowBox[{"rhoField_", ",", "closureField_", ",", "tauField_"}], "]"}], ":=", 
    RowBox[{"rhoField", "*", "closureField", "*", "tauField"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"solveBurdenPotential2D", "[", 
    RowBox[{"rho_", ",", 
     RowBox[{"lambda_", ":", " ", "1."}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nx", ",", "ny", ",", "potential", ",", "eqns", ",", "vars"}], 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nx", ",", "ny"}], "}"}], "=", 
       RowBox[{"Dimensions", "[", "rho", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"vars", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"phi", ",", 
         RowBox[{"{", 
          RowBox[{"nx", ",", "ny"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"eqns", "=", 
       RowBox[{"Flatten", "@", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "     ", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"i", "==", "1"}], "||", 
             RowBox[{"i", "==", "nx"}], "||", 
             RowBox[{"j", "==", "1"}], "||", 
             RowBox[{"j", "==", "ny"}]}], ",", "\[IndentingNewLine]", 
            "       ", 
            RowBox[{
             RowBox[{"vars", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "==", "0"}], ",", 
            "\[IndentingNewLine]", "       ", 
            RowBox[{
             RowBox[{
              RowBox[{"vars", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"i", "+", "1"}], ",", "j"}], "]"}], "]"}], "+", 
              RowBox[{"vars", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"i", "-", "1"}], ",", "j"}], "]"}], "]"}], "+", 
              RowBox[{"vars", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", 
                 RowBox[{"j", "+", "1"}]}], "]"}], "]"}], "+", 
              RowBox[{"vars", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", 
                 RowBox[{"j", "-", "1"}]}], "]"}], "]"}], "-", 
              RowBox[{"4", " ", 
               RowBox[{"vars", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], "==", 
             RowBox[{"lambda", " ", 
              RowBox[{"rho", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}]}], 
           "\[IndentingNewLine]", "     ", "]"}], ",", "\[IndentingNewLine]", 
          "     ", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nx"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "ny"}], "}"}]}], "\[IndentingNewLine]", "   ", 
         "]"}]}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"potential", "=", 
       RowBox[{"vars", " ", "/.", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Solve", "[", 
          RowBox[{"eqns", ",", 
           RowBox[{"Flatten", "[", "vars", "]"}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", "  ", "potential"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"47d27e62-4f6d-f04b-ba42-\
c41b398a2b43"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "xGrid", ",", "yGrid", ",", "entropy", ",", "relation", ",", 
       "curvature", ",", "persistence", ",", "rho", ",", "closure", ",", 
       "tau", ",", "burden", ",", "potential", ",", "forcex", ",", "forcey"}],
       "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"xGrid", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "2", ",", 
         RowBox[{"n", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"yGrid", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "2", ",", 
         RowBox[{"n", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"entropy", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x", "-", "x0"}], ")"}], "^", "2"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"y", "-", "y0"}], ")"}], "^", "2"}]}], ")"}]}], "/", 
           RowBox[{"sigma", "^", "2"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xGrid"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "yGrid"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"relation", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"x", "+", "x0"}], ")"}], "^", "2"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"y", "+", "y0"}], ")"}], "^", "2"}]}], ")"}]}], "/", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1.2", " ", "sigma"}], ")"}], "^", "2"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xGrid"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "yGrid"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"curvature", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"0.5", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"x", "^", "2"}], "+", 
               RowBox[{"y", "^", "2"}]}], ")"}]}], "/", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"0.7", " ", "sigma"}], ")"}], "^", "2"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xGrid"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "yGrid"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"persistence", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"tau0", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"rho", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"informationDensityField", "[", 
           RowBox[{"#1", ",", "#2", ",", "#3", ",", "#4", ",", 
            RowBox[{"{", 
             RowBox[{"a1", ",", "a2", ",", "a3", ",", "a4"}], "}"}]}], "]"}], 
          " ", "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "entropy", ",", "relation", ",", "curvature", ",", "persistence"}], 
          "}"}], ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"closure", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"kappa0", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"tau", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"tau0", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"burden", "=", 
       RowBox[{"burdenField", "[", 
        RowBox[{"rho", ",", "closure", ",", "tau"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"potential", "=", 
       RowBox[{"solveBurdenPotential2D", "[", 
        RowBox[{"burden", ",", "lambdaG"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"forcex", ",", "forcey"}], "}"}], "=", 
       RowBox[{
        RowBox[{"Grad", "[", 
         RowBox[{"potential", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "]"}], " ", "/.", " ", 
        RowBox[{"Grad", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ListCorrelate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"1", ",", "0", ",", 
                  RowBox[{"-", "1"}]}], "}"}], "/", "2"}], ",", "#1", ",", 
               "2"}], "]"}], ",", 
             RowBox[{"ListCorrelate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"1", ",", "0", ",", 
                  RowBox[{"-", "1"}]}], "}"}], "/", "2"}], ",", "#1", ",", 
               "1"}], "]"}]}], "}"}], " ", "&"}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"ArrayPlot", "[", 
          RowBox[{"rho", ",", 
           RowBox[{"PlotLabel", "->", "\"\<Information density rho_I\>\""}], ",", 
           RowBox[{"ImageSize", "->", "300"}], ",", 
           RowBox[{"ColorFunction", "->", "\"\<SolarColors\>\""}]}], "]"}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"ArrayPlot", "[", 
          RowBox[{"burden", ",", 
           RowBox[{"PlotLabel", "->", "\"\<Burden field\>\""}], ",", 
           RowBox[{"ImageSize", "->", "300"}], ",", 
           RowBox[{"ColorFunction", "->", "\"\<DarkRainbow\>\""}]}], "]"}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"ArrayPlot", "[", 
          RowBox[{"potential", ",", 
           RowBox[{
           "PlotLabel", "->", "\"\<Gravity proxy potential Phi_b\>\""}], ",", 
           RowBox[{"ImageSize", "->", "300"}], ",", 
           RowBox[{"ColorFunction", "->", "\"\<AvocadoColors\>\""}]}], 
          "]"}]}], "\[IndentingNewLine]", "  ", "}"}], "]"}]}]}], 
    "\[IndentingNewLine]", " ", "]"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
