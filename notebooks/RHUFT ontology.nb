 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"15. Unified notebook-ready architecture\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"990a6671-0f62-0a46-b194-103eaee0e5f7"],
 "\nYou could define the RHUFT/MRCE framework in the notebook as the \
following layered schema: \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Layer I: State definition\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a66b2e08-84f8-7147-aafb-7bad142c816c"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             StyleBox["q", FontSlant -> "Bold"], ",", "\[Psi]", ",", 
             "\[CapitalOmega]", ",", "\[PartialD]", "\[CapitalOmega]", ",", 
             StyleBox["t", "TI"]}], "}"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\mathcal{S} = \\{\\mathbf{q}, \\boldsymbol{\\psi}, \\Omega, \
\\partial\\Omega, t\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e3e59e33-351d-6941-a242-6d94bc75f396"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Layer II: Bulk operators\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"929b199d-70a8-8845-bcdc-18271726b645"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"[", 
           SubscriptBox[
            StyleBox["q", "TI"], 
            StyleBox["i", "TI"]], "]"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["q", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "-", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{B}_i[q_i] = \\frac{\\partial q_i}{\\partial t} + \
\\nabla\\cdot \\mathbf{J}_i - R_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb1d06bd-ae86-f147-aafc-c0cc2e1b6f46"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Layer III: Flux operators\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"cbbc8f5d-f9a4-8743-91b2-a7e8829bd924"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"], 
          StyleBox["diff", FontSlant -> "Plain"]], "+", 
         SubsuperscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"], 
          StyleBox["adv", FontSlant -> "Plain"]], "+", 
         SubsuperscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"], 
          StyleBox["drift", FontSlant -> "Plain"]], "+", 
         SubsuperscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"], 
          StyleBox["cross", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathbf{J}_i = \\mathbf{J}_i^{\\mathrm{diff}} + \
\\mathbf{J}_i^{\\mathrm{adv}} + \\mathbf{J}_i^{\\mathrm{drift}} + \
\\mathbf{J}_i^{\\mathrm{cross}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "606548f5-4e2b-f847-af97-6f8eb05c6bb9"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Layer IV: Boundary operators\"\>", "Section",
