       "steps3", ",", "psi003", ",", "psi103", ",", "target03", ",", 
       "target13"}], "]"}], ",", "\[IndentingNewLine]", 
     "  ", "\"\<Geometry\>\"", ",", 
     RowBox[{"scanMetrics", "[", 
