        RowBox[{"w1", ",", "w2", ",", "w3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"d1", ",", "d2", ",", "d3"}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
