Cell[TextData[{
 "This notebook is designed as the ",
 StyleBox["most complete structured Wolfram Language review environment \
possible",
  FontWeight->Bold],
 " for the RHUFT/MRCE material you provided."
}], "Text",ExpressionUUID->"03d21137-eded-0440-a2a8-abe9aa17fa2e"],

Cell[TextData[{
 "It is organized as a ",
 StyleBox["formal laboratory",
  FontWeight->Bold],
 ", not as validation of physical truth. It separates: "
}], "Text",ExpressionUUID->"aecbab8e-b7ca-e948-86e5-006aa8794cc5"],

Cell[TextData[StyleBox["defined mathematics and simulations",
 FontWeight->Bold]], "Item",ExpressionUUID->"13808369-9f94-3342-8e34-\
f2481d18df90"],

Cell[TextData[StyleBox["framework assumptions / axioms",
 FontWeight->Bold]], "Item",ExpressionUUID->"ff724da4-c921-274b-87fa-\
f9ec34f1ba95"],

Cell[TextData[StyleBox["speculative correspondences",
 FontWeight->Bold]], "Item",ExpressionUUID->"1a4b4788-bf88-9740-a007-\
3672a6cfe41f"],

Cell[TextData[StyleBox["test harnesses and diagnostics",
 FontWeight->Bold]], "Item",ExpressionUUID->"3eea41f5-01f9-1449-b393-\
fcf9fdaa6a57"],

Cell[BoxData[GridBox[{
   {
    PaneBox[Cell[TextData[{
      "Important: This notebook helps you ",
      StyleBox["explore, stress-test, falsify, compare, and document",
       FontWeight->Bold],
      " the formalism. It does ",
      StyleBox["not",
       FontWeight->Bold],
      " certify the physical claims. Where functions are unspecified in the \
theory text, the notebook uses explicit test instantiations and labels them \
clearly."
     }],
      Background->None,ExpressionUUID->"d202f900-bb63-a949-abfa-ba5bc613e2c4"],
