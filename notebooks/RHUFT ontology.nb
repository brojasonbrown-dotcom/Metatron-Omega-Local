     RowBox[{"\"\<Which parts are definitions versus physical claims?\>\"", ",",
       "\[IndentingNewLine]", 
      "  ", "\"\<Which modules are mathematically well-posed?\>\"", ",", 
      "\[IndentingNewLine]", 
