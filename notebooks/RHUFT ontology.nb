             RowBox[{"psiNoMem", "-", "target"}], "]"}], ",", 
            RowBox[{"-", "10"}]}], "]"}]}]}]}], "\[IndentingNewLine]", "  ", 
       "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",Expression\
