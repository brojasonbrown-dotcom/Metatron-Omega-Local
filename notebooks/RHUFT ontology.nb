Cell[CellGroupData[{

Cell["13. Test Class 4 \[LongDash] Geometry Scan Efficiency", "Section",ExpressionUUID->"bc8690d4-4283-8a4b-a6f2-3afe1741faea"],

Cell[TextData[{
 "Equation: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Theta]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         SubscriptBox["\[Theta]", 
          StyleBox["t", "TI"]], "+", "\[Omega]  ", "mod", "2", "\[Pi]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta_{t+1} = \\theta_t + \\omega \\mod 2\\pi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5395f18b-e4a1-4c4d-b5d6-c32cc52b8fe5"],
 "Compare periodic: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Omega]", "\[LongEqual]", "2", "\[Pi]", 
         StyleBox["p", "TI"], "/", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\omega = 2\\pi p/q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "092ac87e-cfaa-df49-a521-c03c6bbac3cd"],
 "against golden-angle: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Omega]", "\[LongEqual]", "2", "\[Pi]", 
         RowBox[{"(", 
           RowBox[{"1", "-", "1", "/", "\[Phi]"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\omega = 2\\pi(1 - 1/\\phi)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "95070390-0710-6849-ab7f-c1df5cda7da4"]
}], "Text",ExpressionUUID->"9a666cbe-c4ee-c14c-b0fb-57d03cbebc0a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "scanMetrics", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scanMetrics", "[", 
    RowBox[{"omega_", ",", "steps_", ",", 
     RowBox[{"bins_", ":", " ", "50"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "angles", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"angles", "=", 
       RowBox[{"periodicScan", "[", 
        RowBox[{"omega", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Angles\>\"", "->", "angles"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<CoverageDiscrepancy\>\"", "->", 
         RowBox[{"coverageDiscrepancy", "[", 
          RowBox[{"angles", ",", "bins"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<UniqueRoundedCount\>\"", "->", 
         RowBox[{"Length", " ", "@", " ", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Round", "[", 
            RowBox[{"angles", ",", 
             RowBox[{"10", "^", 
              RowBox[{"-", "6"}]}]}], "]"}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Points\>\"", "->", 
         RowBox[{"spiralPoints", "[", "angles", "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"5402f347-23ee-cd4a-9e9a-\
8e39dd7bfa60"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"omegaPeriodic", ",", "periodic", ",", "golden"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"omegaPeriodic", "=", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"p", "/", "q"}]}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"periodic", "=", 
       RowBox[{"scanMetrics", "[", 
        RowBox[{"omegaPeriodic", ",", "steps", ",", "bins"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"golden", "=", 
       RowBox[{"scanMetrics", "[", 
        RowBox[{"goldenAngle", ",", "steps", ",", "bins"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Grid", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"Prepend", "[", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", "          ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<Coverage discrepancy\>\"", ",", 
                 RowBox[{
                 "periodic", "[", "\"\<CoverageDiscrepancy\>\"", "]"}], ",", 
                 RowBox[{
                 "golden", "[", "\"\<CoverageDiscrepancy\>\"", "]"}]}], "}"}],
                ",", "\[IndentingNewLine]", "          ", 
               RowBox[{"{", 
                RowBox[{"\"\<Unique rounded angles\>\"", ",", 
                 RowBox[{"periodic", "[", "\"\<UniqueRoundedCount\>\"", "]"}],
                  ",", 
                 RowBox[{"golden", "[", "\"\<UniqueRoundedCount\>\"", "]"}]}],
                 "}"}], ",", "\[IndentingNewLine]", "          ", 
               RowBox[{"{", 
                RowBox[{"\"\<Better by discrepancy\>\"", ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    "periodic", "[", "\"\<CoverageDiscrepancy\>\"", "]"}], ">", 
                    RowBox[{
                    "golden", "[", "\"\<CoverageDiscrepancy\>\"", "]"}]}], 
                   ",", "\"\<golden-angle\>\"", 
                   ",", "\"\<periodic or tie\>\""}], "]"}], ",", "\"\<\>\""}],
                 "}"}]}], "\[IndentingNewLine]", "        ", "}"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Metric\>\"", ",", "Bold"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Periodic\>\"", ",", "Bold"}], "]"}], ",", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Golden-angle\>\"", ",", "Bold"}], "]"}]}], 
              "}"}]}], "\[IndentingNewLine]", "      ", "]"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "    ", 
          "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"GraphicsRow", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{"{", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"ListPlot", "[", "\[IndentingNewLine]", "          ", 
             RowBox[{
              RowBox[{"periodic", "[", "\"\<Points\>\"", "]"}], ",", 
              "\[IndentingNewLine]", "          ", 
              RowBox[{"AspectRatio", "->", "1"}], ",", "\[IndentingNewLine]", 
              "          ", 
              RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
              "          ", 
              RowBox[{"PlotStyle", "->", "Blue"}], ",", "\[IndentingNewLine]",
               "          ", 
              RowBox[{"ImageSize", "->", "320"}], ",", "\[IndentingNewLine]", 
              "          ", 
              RowBox[{"PlotLabel", "->", 
               RowBox[{"Row", "[", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<Periodic p/q = \>\"", ",", "p", ",", "\"\</\>\"",
                   ",", "q"}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
             "        ", "]"}], ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"ListPlot", "[", "\[IndentingNewLine]", "          ", 
             RowBox[{
              RowBox[{"golden", "[", "\"\<Points\>\"", "]"}], ",", 
              "\[IndentingNewLine]", "          ", 
              RowBox[{"AspectRatio", "->", "1"}], ",", "\[IndentingNewLine]", 
              "          ", 
              RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
              "          ", 
              RowBox[{"PlotStyle", "->", "Red"}], ",", "\[IndentingNewLine]", 
              "          ", 
              RowBox[{"ImageSize", "->", "320"}], ",", "\[IndentingNewLine]", 
              "          ", 
              RowBox[{"PlotLabel", "->", "\"\<Golden-angle\>\""}]}], 
             "\[IndentingNewLine]", "        ", "]"}]}], 
           "\[IndentingNewLine]", "      ", "}"}], "\[IndentingNewLine]", 
          "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"coverageDiscrepancy", "[", 
                RowBox[{
                 RowBox[{"periodicScan", "[", 
                  RowBox[{"omegaPeriodic", ",", "k"}], "]"}], ",", "bins"}], 
                "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "10", ",", "steps"}], "}"}]}], "]"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"coverageDiscrepancy", "[", 
                RowBox[{
                 RowBox[{"goldenAngleScan", "[", "k", "]"}], ",", "bins"}], 
                "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "10", ",", "steps"}], "}"}]}], "]"}]}], 
            "\[IndentingNewLine]", "      ", "}"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<periodic\>\"", ",", "\"\<golden-angle\>\""}], 
             "}"}]}], ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"ImageSize", "->", "Large"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{
           "PlotLabel", 
            "->", "\"\<Coverage discrepancy vs step count\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}]}], "\[IndentingNewLine]", "  ",
         "}"}], "]"}]}]}], "\[IndentingNewLine]", " ", "]"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", ",", "3"}], "}"}], ",", "1", ",", "20", ",", "1"}], "}"}], 
   ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", ",", "8"}], "}"}], ",", "2", ",", "40", ",", "1"}], "}"}], 
   ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"steps", ",", "200"}], "}"}], ",", "20", ",", "800", ",", "1"}],
     "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bins", ",", "60"}], "}"}], ",", "10", ",", "160", ",", "1"}], 
    "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"SaveDefinitions", "->", "True"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"ControlPlacement", "->", "Left"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"15f9c871-5fa8-f547-954e-543436e62ba5"],

