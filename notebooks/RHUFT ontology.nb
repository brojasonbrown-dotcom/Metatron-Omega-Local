    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"afd01ee2-a83e-9d43-80e3-445acb7b136a"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{"\[PartialD]", "\[CapitalOmega]"}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["D", "TI"]], "\[Union]", 
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["N", "TI"]], "\[Union]", 
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["R", "TI"]], "\[Union]", 
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["interface", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathcal{C}_{\\partial\\Omega} = \\mathcal{C}_D \\cup \\mathcal{C}_N \
\\cup \\mathcal{C}_R \\cup \\mathcal{C}_{\\mathrm{interface}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
