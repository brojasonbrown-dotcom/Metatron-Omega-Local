Cell[CellGroupData[{

Cell["6. Core Metrics", "Section",ExpressionUUID->"9dc134c8-8955-ac4f-94f3-57b4e032a751"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "driftFromPerfection", ",", "temporalCoherence", ",", "closureScore", ",",
      "\[IndentingNewLine]", "  ", "consciousnessProxy", ",", 
     "surpriseMetric", ",", "confidenceLower", ",", "confidenceUpper"}], 
    "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"driftFromPerfection", "[", "state_Association", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"vec", ",", "perfect"}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"vec", "=", 
        RowBox[{
         RowBox[{"numericStateVector", "[", "state", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3", ",", "4", ",", "5", ",", "8"}], "}"}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"perfect", "=", 
        RowBox[{
         RowBox[{"numericStateVector", "[", 
          RowBox[{"makePerfectionState", "[", 
           RowBox[{"state", "[", "\"\<Scale\>\"", "]"}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3", ",", "4", ",", "5", ",", "8"}], "}"}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{"vec", "-", "perfect"}], "]"}], "^", "2"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"temporalCoherence", "[", 
     RowBox[{"x_List", ",", "y_List"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"x", ".", "y"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"safeNorm", "[", "x", "]"}], " ", 
       RowBox[{"safeNorm", "[", "y", "]"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"closureScore", "[", 
     RowBox[{"internal_", ",", "external_"}], "]"}], ":=", 
    RowBox[{"internal", "/", 
     RowBox[{"(", 
      RowBox[{"internal", "+", "external", "+", "epsilon0"}], ")"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"consciousnessProxy", "[", 
     RowBox[{
     "coherence_", ",", "closure_", ",", "depth_", ",", "memoryIntegration_", 
      ",", 
      RowBox[{"selfPredictionAccuracy_", ":", " ", "1."}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
    "coherence", "*", "closure", "*", "depth", "*", "memoryIntegration", "*", 
     "selfPredictionAccuracy"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"surpriseMetric", "[", 
     RowBox[{"value_", ",", "history_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mu", ",", "sigma"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"mu", "=", 
        RowBox[{"Mean", "[", "history", "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"sigma", "=", 
        RowBox[{
         RowBox[{"StandardDeviation", "[", "history", "]"}], "+", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"-", 
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"PDF", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"mu", ",", "sigma"}], "]"}], ",", "value"}], "]"}], "+", 
          RowBox[{"10", "^", 
           RowBox[{"-", "12"}]}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"confidenceLower", "[", "drift_", "]"}], ":=", 
   RowBox[{"Max", "[", 
    RowBox[{"phiInv2", ",", 
     RowBox[{"1", "-", "drift"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"confidenceUpper", "[", "uncertainty_", "]"}], ":=", 
   RowBox[{"Min", "[", 
    RowBox[{"1.", ",", 
     RowBox[{"1", "-", 
      RowBox[{"uncertainty", " ", "phiInv"}]}]}], "]"}]}], ";"}]}], "Input",Ex\
pressionUUID->"327b8586-7dac-bc4a-adf1-0bfd0e06c27d"],

