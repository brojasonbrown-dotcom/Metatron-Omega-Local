Cell[CellGroupData[{

Cell["3. Toroidal geometry module", "Section",ExpressionUUID->"79ff3814-b2a4-e141-ae27-f534b2cdc20c"],

Cell[TextData[{
 "We keep the explicit torus embedding from the previous phase: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", FontSlant -> "Bold"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["u", "TI"], ",", 
             StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 StyleBox["R", "TI"], "+", 
                 StyleBox["r", "TI"], "cos", 
                 StyleBox["v", "TI"]}], ")"}], "cos", 
             StyleBox["u", "TI"], ",", 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["R", "TI"], "+", 
                 StyleBox["r", "TI"], "cos", 
                 StyleBox["v", "TI"]}], ")"}], "sin", 
             StyleBox["u", "TI"], ",", 
             StyleBox["r", "TI"], "sin", 
             StyleBox["v", "TI"]}], "}"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\mathbf{x}(u,v)=\\{(R+r\\cos v)\\cos u,(R+r\\cos v)\\sin u,r\\sin \
v\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1c458c06-c49b-db48-ab52-efe5b53fefeb"]
}], "Text",ExpressionUUID->"5644bb8c-80ff-e246-ba63-82640a9932ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "torusEmbedding", ",", "torusTangentU", ",", "torusTangentV", ",", 
     "\[IndentingNewLine]", "  ", "torusMetricMatrixExact", ",", 
     "torusMetricMatrix", ",", "\[IndentingNewLine]", "  ", 
     "torusInverseMetricExact", ",", "torusAreaElement", ",", 
     "torusSurfaceArea"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusEmbedding", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u", ",", "v"}], "}"}], ",", 
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"majorRadius", "+", 
           RowBox[{"minorRadius", " ", 
            RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
         RowBox[{"Cos", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"majorRadius", "+", 
           RowBox[{"minorRadius", " ", 
            RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
         RowBox[{"Sin", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"minorRadius", " ", 
         RowBox[{"Sin", "[", "v", "]"}]}]}], "\[IndentingNewLine]", "  ", 
       "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusTangentU", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"embed", "=", 
        RowBox[{"torusEmbedding", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"embed", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", "u"}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusTangentV", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"embed", "=", 
        RowBox[{"torusEmbedding", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"embed", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", "v"}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusMetricMatrixExact", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"majorRadius", "+", 
           RowBox[{"minorRadius", " ", 
            RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], "^", "2"}], ",", "0"}],
        "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"minorRadius", "^", "2"}]}], "}"}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusMetricMatrix", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"torusMetricMatrixExact", "[", 
     RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusInverseMetricExact", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Inverse", "[", 
       RowBox[{"torusMetricMatrixExact", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusAreaElement", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Det", "[", 
        RowBox[{"torusMetricMatrix", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], "]"}], "]"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"torusSurfaceArea", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Integrate", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"torusAreaElement", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]",
       "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"650720e0-1539-0b49-b06d-\
64d40e1fdb89"],

