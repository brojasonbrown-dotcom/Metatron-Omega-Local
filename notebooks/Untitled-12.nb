Cell[CellGroupData[{

Cell["1. Precision policy and assumptions", "Section",ExpressionUUID->"fdbc38fe-22e7-0e45-868a-dabde062288e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "setToroidalFrameworkPrecision", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"setToroidalFrameworkPrecision", "[", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"$Assumptions", "=", 
      RowBox[{
       RowBox[{"Element", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", "        ", 
          RowBox[{
          "majorRadius", ",", "minorRadius", ",", "u", ",", "v", ",", 
           "\[IndentingNewLine]", "        ", "amp", ",", "alpha", ",", 
           "beta", ",", "\[IndentingNewLine]", "        ", "massTerm", ",", 
           "coupling", ",", "\[IndentingNewLine]", "        ", "fieldValue", ",",
            "backgroundValue", ",", "\[IndentingNewLine]", "        ", 
           "closureTargetValue"}], "\[IndentingNewLine]", "      ", "}"}], ",",
          "Reals"}], "\[IndentingNewLine]", "    ", "]"}], "&&", 
       RowBox[{"majorRadius", ">", "0"}], "&&", 
       RowBox[{"minorRadius", ">", "0"}], "&&", 
       RowBox[{"majorRadius", ">", "minorRadius"}], "&&", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"0", "<=", "u", "<=", 
        RowBox[{"2", " ", "Pi"}]}], "&&", 
       RowBox[{"0", "<=", "v", "<=", 
        RowBox[{"2", " ", "Pi"}]}], "&&", 
       RowBox[{"alpha", ">=", "0"}]}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"$MaxExtraPrecision", "=", "1000"}], ";"}], 
    "\[IndentingNewLine]", ")"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"setToroidalFrameworkPrecision", "[", "]"}], ";"}]}], "Input",Expres\
sionUUID->"47c5f08f-4339-fb48-9f08-c9524f31ef86"],

Cell[TextData[{
 "As before, exact ",
 Cell[BoxData[
  RowBox[{"WorkingPrecision", "->", "Infinity"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "43a2786e-fae5-0e4e-9cf3-b028833a8fbb"],
 " is not generally executable for numerical eigensolvers or integrations. \
The executable approximation used here is: "
}], "Text",ExpressionUUID->"791b21e1-c47c-8143-b753-8dcdc1c8364c"],

