Cell[CellGroupData[{

Cell["5. Toroidal closure functional and residual", "Section",ExpressionUUID->"9f53ffd0-bac9-f649-adea-f61433f321c0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "toroidalClosureFunctional", ",", "toroidalClosureResidual", ",", 
     "\[IndentingNewLine]", "  ", "closureAmplitudeRule", ",", 
     "normalizedConstantToroidalMode"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"toroidalClosureFunctional", "[", 
     RowBox[{"psi_", ",", "majorRadius_", ",", "minorRadius_", ",", 
      RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", 
    RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"psi", "[", 
           RowBox[{"u", ",", "v"}], "]"}], "]"}], "^", "2"}], " ", 
        RowBox[{"torusAreaElement", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"u", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"WorkingPrecision", "->", "wp"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"AccuracyGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"PrecisionGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
         RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"toroidalClosureResidual", "[", 
     RowBox[{
     "psi_", ",", "majorRadius_", ",", "minorRadius_", ",", 
      "closureTargetValue_", ",", 
      RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"toroidalClosureFunctional", "[", 
        RowBox[{"psi", ",", "majorRadius", ",", "minorRadius", ",", "wp"}], 
        "]"}], "-", "closureTargetValue"}], ",", "wp"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"closureAmplitudeRule", "[", 
     RowBox[{
     "majorRadius_", ",", "minorRadius_", ",", "closureTargetValue_"}], "]"}],
     ":=", 
    RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"amp", "^", "2"}], " ", 
        RowBox[{"torusSurfaceArea", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], "==", 
       "closureTargetValue"}], ",", "\[IndentingNewLine]", "  ", "amp", ",", 
      "\[IndentingNewLine]", "  ", "Reals"}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normalizedConstantToroidalMode", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_", ",", "closureTargetValue_"}],
     "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "ampRule", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"ampRule", "=", 
       RowBox[{"First", "[", 
        RowBox[{"closureAmplitudeRule", "[", 
         RowBox[{
         "majorRadius", ",", "minorRadius", ",", "closureTargetValue"}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{"amp", " ", "/.", " ", "ampRule"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"b12832cd-7d32-0945-b7ce-7d1f22a92e37"],

