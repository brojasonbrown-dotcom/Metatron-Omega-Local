 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"1140cc95-a00a-ff42-bbbc-a74ba7ce5108"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Linearized field model on the torus", "Section",ExpressionUUID->"8a58b2cd-5999-b144-b2b3-b31fb0aeb076"],

Cell[TextData[{
 "To add a meaningful stability layer, we introduce a scalar energy-density \
surrogate on the torus: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], 
         RowBox[{"[", "\[Psi]", "]"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], "\[Psi] ", 
         SubscriptBox["\[PartialD]", 
          StyleBox["j", "TI"]], "\[Psi]", "+", 
         SubsuperscriptBox[
          StyleBox["m", "TI"], "0", "2"], 
         SuperscriptBox["\[Psi]", "2"], "+", 
         SuperscriptBox["\[Lambda]\[Psi]", "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathcal{E}[\\psi]=g^{ij}\\partial_i \\psi\\,\\partial_j \\psi + m_0^2 \
\\psi^2 + \\lambda \\psi^4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a8cd9ffc-c228-434b-b98f-2d10a665a586"],
 "A linearization about a constant background ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Psi]", "\[LongEqual]", 
         SubscriptBox["\[Psi]", "0"], "+", "\[Delta]\[Psi]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\psi=\\psi_0+\\delta\\psi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "240211d0-30a3-5646-bff3-af586bf4fb0f"],
 " yields the Hessian operator ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["lin", FontSlant -> "Plain"]], " ", "\[Delta]\[Psi]", 
         "\[LongEqual]", "-", 
         SubscriptBox["\[CapitalDelta]", 
          StyleBox["T", "TI"]], "\[Delta]\[Psi]", "+", 
         RowBox[{"(", 
           RowBox[{
             SubsuperscriptBox[
              StyleBox["m", "TI"], "0", "2"], "+", "12", 
             SubsuperscriptBox["\[Lambda]\[Psi]", "0", "2"]}], ")"}], 
         "\[Delta]\[Psi]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{L}_{\\mathrm{lin}}\\,\\delta\\psi = -\\Delta_T \\delta\\psi + \
\\left(m_0^2 + 12\\lambda \\psi_0^2\\right)\\delta\\psi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec3558ec-bac2-f843-8086-a50884eedcdc"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalDelta]", 
        StyleBox["T", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta_T", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50cb593e-eabc-9a47-b557-e79cddf9e308"],
 " is a torus Laplace-type operator."
}], "Text",ExpressionUUID->"9db1e5d0-146c-c94b-833e-89714c1220aa"],

Cell[TextData[{
 "For a first computational scaffold, we use a ",
 StyleBox["flat torus proxy",
  FontWeight->Bold],
 " with periodic coordinates and effective lengths ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2", "\[Pi]", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "2\\pi R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b067148-17e1-4f40-8e62-051f52f664a3"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2", "\[Pi]", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "2\\pi r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "56b4e1f5-29ca-9146-80f4-5f2437b9d71a"],
 ". This preserves periodic closure and gives exact Fourier eigenvalues. "
}], "Text",ExpressionUUID->"887e3e20-ed0c-cf44-86cd-31f30cc8b0d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "effectiveMassTerm", ",", "flatTorusEigenvalue", ",", 
     "flatTorusFrequency"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"effectiveMassTerm", "[", 
     RowBox[{"massTerm_", ",", "coupling_", ",", "backgroundValue_"}], "]"}], 
    ":=", "\[IndentingNewLine]", "  ", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"massTerm", "+", 
       RowBox[{"12", " ", "coupling", " ", 
        RowBox[{"backgroundValue", "^", "2"}]}]}], ",", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"flatTorusEigenvalue", "[", 
     RowBox[{
     "m_Integer", ",", "n_Integer", ",", "majorRadius_", ",", "minorRadius_", 
      ",", "massTerm_", ",", "coupling_", ",", "backgroundValue_"}], "]"}], ":=",
     "\[IndentingNewLine]", "  ", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"m", "^", "2"}], "/", 
        RowBox[{"majorRadius", "^", "2"}]}], "+", 
       RowBox[{
        RowBox[{"n", "^", "2"}], "/", 
        RowBox[{"minorRadius", "^", "2"}]}], "+", 
       RowBox[{"effectiveMassTerm", "[", 
        RowBox[{"massTerm", ",", "coupling", ",", "backgroundValue"}], 
        "]"}]}], ",", "\[IndentingNewLine]", "    ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "  ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"flatTorusFrequency", "[", 
    RowBox[{
    "m_Integer", ",", "n_Integer", ",", "majorRadius_", ",", "minorRadius_", ",",
      "massTerm_", ",", "coupling_", ",", "backgroundValue_"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"Simplify", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"flatTorusEigenvalue", "[", 
       RowBox[{
       "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", "massTerm",
         ",", "coupling", ",", "backgroundValue"}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
    "  ", "]"}]}], ";"}]}], "Input",ExpressionUUID->"f9acc910-fdd1-bb43-aba6-\
93c64e8c4a0c"],

Cell["\<\
Undamped harmonic mode condition for this proxy is positivity of the \
eigenvalue. \
\>", "Text",ExpressionUUID->"a9023037-0248-5246-95ba-7845303145e4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"undampedModeQ", ",", "stableFlatTorusModes"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"undampedModeQ", "[", 
     RowBox[{
     "m_Integer", ",", "n_Integer", ",", "majorRadius_", ",", "minorRadius_", 
      ",", "massTerm_", ",", "coupling_", ",", "backgroundValue_"}], "]"}], ":=",
     "\[IndentingNewLine]", "  ", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"flatTorusEigenvalue", "[", 
        RowBox[{
        "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
         "massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}], ">", 
       "0"}], ",", "\[IndentingNewLine]", "    ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "  ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stableFlatTorusModes", "[", 
    RowBox[{
     RowBox[{"maxMode_Integer", " ", "?", " ", "NonNegative"}], ",", 
     "majorRadius_", ",", "minorRadius_", ",", "massTerm_", ",", "coupling_", 
     ",", "backgroundValue_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{"Select", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "0", ",", "maxMode"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "maxMode"}], "}"}]}], "]"}], ",", "1"}],
       "]"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"TrueQ", "[", 
       RowBox[{"undampedModeQ", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "majorRadius", ",", 
         "minorRadius", ",", "massTerm", ",", "coupling", ",", 
         "backgroundValue"}], "]"}], "]"}], " ", "&"}]}], 
    "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"e7ced869-2468-cc46-93b9-975e7d7ca983"],

