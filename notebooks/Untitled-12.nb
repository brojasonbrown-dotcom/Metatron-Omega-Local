Cell[CellGroupData[{

Cell["8. Eigenspectrum diagnostics and convergence", "Section",ExpressionUUID->"5ec799b4-55a0-834f-8691-ad1626d35612"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"eigenspectrumSummary", ",", "eigenspectrumResolutionStudy"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eigenspectrumSummary", "[", 
     RowBox[{
      RowBox[{"maxMode_Integer", " ", "?", " ", "NonNegative"}], ",", 
      "majorRadius_", ",", "minorRadius_", ",", "massTerm_", ",", "coupling_",
       ",", "backgroundValue_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
    RowBox[{"Association", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{"Flatten", "[", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", "        ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", ",", "n"}], "}"}], "->", 
           RowBox[{"<|", "\[IndentingNewLine]", "          ", 
            RowBox[{
             RowBox[{"\"\<Eigenvalue\>\"", "->", 
              RowBox[{"flatTorusEigenvalue", "[", 
               RowBox[{
               "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
                "massTerm", ",", "coupling", ",", "backgroundValue"}], 
               "]"}]}], ",", "\[IndentingNewLine]", "          ", 
             RowBox[{"\"\<Frequency\>\"", "->", 
              RowBox[{"flatTorusFrequency", "[", 
               RowBox[{
               "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
                "massTerm", ",", "coupling", ",", "backgroundValue"}], 
               "]"}]}], ",", "\[IndentingNewLine]", "          ", 
             RowBox[{"\"\<UndampedQ\>\"", "->", 
              RowBox[{"undampedModeQ", "[", 
               RowBox[{
               "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
                "massTerm", ",", "coupling", ",", "backgroundValue"}], 
               "]"}]}]}], "\[IndentingNewLine]", "        ", "|>"}]}], ")"}], 
         ",", "\[IndentingNewLine]", "        ", 
         RowBox[{"{", 
          RowBox[{"m", ",", "0", ",", "maxMode"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "maxMode"}], "}"}]}], 
        "\[IndentingNewLine]", "      ", "]"}], ",", "\[IndentingNewLine]", 
       "      ", "1"}], "\[IndentingNewLine]", "    ", "]"}], 
     "\[IndentingNewLine]", "  ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eigenspectrumResolutionStudy", "[", 
    RowBox[{
    "resolutions_List", ",", "massTerm_", ",", "coupling_", ",", 
     "backgroundValue_", ",", 
     RowBox[{"count_Integer", " ", ":", " ", "8"}], ",", 
     RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{"resolutions", ",", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"flatTorusEigenSystem", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "massTerm", ",", "coupling", 
           ",", "backgroundValue", ",", "count", ",", "wp"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], ")"}], " ", "/@", " ", 
      "resolutions"}]}], "\[IndentingNewLine]", "  ", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"5c691835-6a08-7a41-9cf1-858ba0832048"],

