Cell[CellGroupData[{

Cell["7. Recommended next refinement", "Section",ExpressionUUID->"ca2f7a66-e953-124d-a109-49f375ae5a7e"],

Cell["\<\
The next stronger geometric step would be to replace the flat-torus proxy \
operator by a true torus Laplace--Beltrami operator derived from the induced \
metric. That would make the linearization geometry-dependent rather than only \
periodic-domain dependent.\
\>", "Text",ExpressionUUID->"6d921cda-63e5-0d43-aaaa-86f4c8ee6082"]
}, Open  ]]
}, Open  ]]
