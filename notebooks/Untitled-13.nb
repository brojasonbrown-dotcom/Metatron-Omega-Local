Cell[CellGroupData[{

Cell["2. Periodic-grid operator and numerical eigensystem", "Section",ExpressionUUID->"60bc6ad2-c4c4-1e42-bac0-a6ef121ef6d9"],

Cell["\<\
This is a numerical proxy for a toroidal Laplacian with periodic boundary \
conditions on a rectangular parameter domain. \
\>", "Text",ExpressionUUID->"a96121b9-17e5-8246-80f3-13db9d4f752e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "periodicSecondDifferenceMatrix", ",", "\[IndentingNewLine]", "  ", 
     "flatTorusOperatorMatrix", ",", "\[IndentingNewLine]", "  ", 
     "flatTorusEigenSystem"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
    "periodicSecondDifferenceMatrix", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"nPts_Integer", " ", "?", " ", "Positive"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"domainLength_", ":", " ", 
       RowBox[{"2", " ", "Pi"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"wp_", ":", " ", "80"}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"h", ",", "rules"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"h", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"domainLength", "/", "nPts"}], ",", "wp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"rules", "=", 
        RowBox[{"Join", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "i"}], "}"}], "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "2"}], "/", 
                RowBox[{"h", "^", "2"}]}], ",", "wp"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "nPts"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"i", "+", "1"}]}], "}"}], "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"h", "^", "2"}]}], ",", "wp"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"nPts", "-", "1"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "i"}], "}"}], "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"h", "^", "2"}]}], ",", "wp"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"nPts", "-", "1"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"{", "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", "nPts"}], "}"}], "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"h", "^", "2"}]}], ",", "wp"}], "]"}]}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"nPts", ",", "1"}], "}"}], "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"h", "^", "2"}]}], ",", "wp"}], "]"}]}]}], 
           "\[IndentingNewLine]", "    ", "}"}]}], "\[IndentingNewLine]", 
         "  ", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"rules", ",", 
         RowBox[{"{", 
          RowBox[{"nPts", ",", "nPts"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"flatTorusOperatorMatrix", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"nU_Integer", " ", "?", " ", "Positive"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"nV_Integer", " ", "?", " ", "Positive"}], ",", 
      "\[IndentingNewLine]", "  ", "massEff_", ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"wp_", ":", " ", "80"}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"du2", ",", "dv2", ",", "idU", ",", "idV"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"du2", "=", 
        RowBox[{"periodicSecondDifferenceMatrix", "[", 
         RowBox[{"nU", ",", 
          RowBox[{"2", " ", "Pi"}], ",", "wp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"dv2", "=", 
        RowBox[{"periodicSecondDifferenceMatrix", "[", 
         RowBox[{"nV", ",", 
          RowBox[{"2", " ", "Pi"}], ",", "wp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"idU", "=", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"nU", ",", "SparseArray"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"idV", "=", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"nV", ",", "SparseArray"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"N", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"du2", ",", "idV"}], "]"}]}], "-", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"idU", ",", "dv2"}], "]"}], "+", 
          RowBox[{"massEff", " ", 
           RowBox[{"IdentityMatrix", "[", 
            RowBox[{
             RowBox[{"nU", " ", "nV"}], ",", "SparseArray"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", "    ", "wp"}], "\[IndentingNewLine]", "  ", 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"flatTorusEigenSystem", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"nU_Integer", " ", "?", " ", "Positive"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"nV_Integer", " ", "?", " ", "Positive"}], ",", 
     "\[IndentingNewLine]", "  ", "massTerm_", ",", "\[IndentingNewLine]", 
     "  ", "coupling_", ",", "\[IndentingNewLine]", "  ", "backgroundValue_", 
     ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"count_Integer", " ", "?", " ", "Positive"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"wp_", ":", " ", "80"}]}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"massEff", ",", "vals", ",", "vecs"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"massEff", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"effectiveMassTerm", "[", 
          RowBox[{"massTerm", ",", "coupling", ",", "backgroundValue"}], 
          "]"}], ",", "wp"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"flatTorusOperatorMatrix", "[", 
          RowBox[{"nU", ",", "nV", ",", "massEff", ",", "wp"}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", "count", ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"Method", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Arnoldi\>\"", ",", 
            RowBox[{"\"\<Criteria\>\"", "->", "\"\<RealPart\>\""}]}], 
           "}"}]}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"vals", ",", "vecs"}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"a2eb97be-d571-714b-87c7-\
42bdb6627450"],

