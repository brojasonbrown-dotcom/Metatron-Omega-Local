Cell[TextData[Cell[BoxData[Cell["goldenPhi",
  Background->None,ExpressionUUID->
  "8d5ce4b4-1e48-7d4f-b31d-8d9a78e0bb16"]], \
"InlineCode",ExpressionUUID->"f129402b-dcb9-b941-be29-69d06c5d1a25"]], "Item",\
ExpressionUUID->"55b098d0-ffc2-8340-9626-106f5039e965"],

Cell[TextData[Cell[BoxData[Cell["normalizedConstantToroidalMode",
