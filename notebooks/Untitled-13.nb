Cell[CellGroupData[{

Cell["3. Eigenspectrum summaries and resolution study", "Section",ExpressionUUID->"1bb4be6b-104c-a946-8f0e-09faa4eb0d9b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "eigenspectrumSummary", ",", "\[IndentingNewLine]", "  ", 
     "eigenspectrumResolutionStudy", ",", "\[IndentingNewLine]", "  ", 
     "linearizedToroidalModelSummary"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eigenspectrumSummary", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"maxMode_Integer", " ", "?", " ", "NonNegative"}], ",", 
      "\[IndentingNewLine]", "  ", "majorRadius_", ",", "minorRadius_", ",", 
      "\[IndentingNewLine]", "  ", "massTerm_", ",", "coupling_", ",", 
      "backgroundValue_"}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Association", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"Flatten", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", "n"}], "}"}], "->", 
          RowBox[{"<|", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"\"\<Eigenvalue\>\"", "->", 
             RowBox[{"flatTorusEigenvalue", "[", 
              RowBox[{
              "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
               "massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}]}],
             ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"\"\<Frequency\>\"", "->", 
             RowBox[{"flatTorusFrequency", "[", 
              RowBox[{
              "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
               "massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}]}],
             ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"\"\<UndampedQ\>\"", "->", 
             RowBox[{"undampedModeQ", "[", 
              RowBox[{
              "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
               "massTerm", ",", "coupling", ",", "backgroundValue"}], 
              "]"}]}]}], "\[IndentingNewLine]", "      ", "|>"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"{", 
          RowBox[{"m", ",", "0", ",", "maxMode"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "maxMode"}], "}"}]}], 
        "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
       "    ", "1"}], "\[IndentingNewLine]", "  ", "]"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eigenspectrumResolutionStudy", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "resolutions_List", ",", "\[IndentingNewLine]", "  ", "massTerm_", ",", 
      "coupling_", ",", "backgroundValue_", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"count_Integer", " ", ":", " ", "8"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"wp_", ":", " ", "80"}]}], "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"resolutions", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"flatTorusEigenSystem", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "massTerm", ",", "coupling",
             ",", "backgroundValue", ",", "count", ",", "wp"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "&"}], ")"}], " ", "/@", " ", 
       "resolutions"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedToroidalModelSummary", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "majorRadius_", ",", "minorRadius_", ",", "\[IndentingNewLine]", "  ", 
     "massTerm_", ",", "coupling_", ",", "backgroundValue_", ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"maxMode_", ":", " ", "3"}]}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<EffectiveMassTerm\>\"", "->", 
      RowBox[{"effectiveMassTerm", "[", 
       RowBox[{"massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}]}],
      ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<StableModes\>\"", "->", 
      RowBox[{"stableFlatTorusModes", "[", 
       RowBox[{
       "maxMode", ",", "majorRadius", ",", "minorRadius", ",", "massTerm", ",",
         "coupling", ",", "backgroundValue"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ModeSummary\>\"", "->", 
      RowBox[{"eigenspectrumSummary", "[", 
       RowBox[{
       "maxMode", ",", "majorRadius", ",", "minorRadius", ",", "massTerm", ",",
         "coupling", ",", "backgroundValue"}], "]"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"905316f4-a361-c245-9d80-679ea2c93afe"],

