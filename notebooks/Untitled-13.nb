Cell[CellGroupData[{

Cell["1. Linearized toroidal model", "Section",ExpressionUUID->"51efb611-948b-cc43-9e11-5b1a503f390c"],

Cell[TextData[{
 "We introduce a scalar surrogate energy on the torus and linearize about a \
constant background mode. For a quartic local term, the linearized operator \
takes the form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["lin", FontSlant -> "Plain"]], " ", "\[Delta]\[Psi]", 
         "\[LongEqual]", "-", "\[CapitalDelta] ", "\[Delta]\[Psi]", "+", 
         SubscriptBox["\[Mu]", 
          StyleBox["eff", FontSlant -> "Plain"]], " ", "\[Delta]\[Psi]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{L}_{\\mathrm{lin}}\\,\\delta\\psi = -\\Delta\\,\\delta\\psi + \
\\mu_{\\mathrm{eff}}\\,\\delta\\psi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2915bb77-7b18-ec45-9da3-48f73d1858cf"],
 "with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["eff", FontSlant -> "Plain"]], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["m", "TI"], "0", "2"], "+", "12", 
         SubsuperscriptBox["\[Lambda]\[Psi]", "0", "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mu_{\\mathrm{eff}} = m_0^2 + 12\\lambda\\psi_0^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "62fcaecb-db43-2647-9fee-0c2adf6ff4c8"],
 "where ",
 Cell[BoxData[Cell["psi0",
   Background->None,ExpressionUUID->"392a71ce-404d-1d4b-80cb-64395b2b1456"]], 
  "InlineCode",ExpressionUUID->"74929ff6-b529-434f-b527-009c3f3efab6"],
 " is the background value. "
}], "Text",ExpressionUUID->"8b21eaf7-a225-e845-822f-0e0d2bb53ea7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "effectiveMassTerm", ",", "\[IndentingNewLine]", "  ", 
     "flatTorusEigenvalue", ",", "\[IndentingNewLine]", "  ", 
     "flatTorusFrequency", ",", "\[IndentingNewLine]", "  ", "undampedModeQ", 
     ",", "\[IndentingNewLine]", "  ", "stableFlatTorusModes"}], 
    "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"effectiveMassTerm", "[", 
     RowBox[{"massTerm_", ",", "coupling_", ",", "backgroundValue_"}], "]"}], 
    ":=", "\[IndentingNewLine]", "  ", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"massTerm", "+", 
       RowBox[{"12", " ", "coupling", " ", 
        RowBox[{"backgroundValue", "^", "2"}]}]}], ",", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"flatTorusEigenvalue", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "m_Integer", ",", "n_Integer", ",", "\[IndentingNewLine]", "  ", 
      "majorRadius_", ",", "minorRadius_", ",", "\[IndentingNewLine]", "  ", 
      "massTerm_", ",", "coupling_", ",", "backgroundValue_"}], 
     "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"m", "^", "2"}], "/", 
        RowBox[{"majorRadius", "^", "2"}]}], "+", 
       RowBox[{
        RowBox[{"n", "^", "2"}], "/", 
        RowBox[{"minorRadius", "^", "2"}]}], "+", 
       RowBox[{"effectiveMassTerm", "[", 
        RowBox[{"massTerm", ",", "coupling", ",", "backgroundValue"}], 
        "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"flatTorusFrequency", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "m_Integer", ",", "n_Integer", ",", "\[IndentingNewLine]", "  ", 
      "majorRadius_", ",", "minorRadius_", ",", "\[IndentingNewLine]", "  ", 
      "massTerm_", ",", "coupling_", ",", "backgroundValue_"}], 
     "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"flatTorusEigenvalue", "[", 
        RowBox[{
        "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
         "massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}], "]"}], 
      ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"undampedModeQ", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "m_Integer", ",", "n_Integer", ",", "\[IndentingNewLine]", "  ", 
      "majorRadius_", ",", "minorRadius_", ",", "\[IndentingNewLine]", "  ", 
      "massTerm_", ",", "coupling_", ",", "backgroundValue_"}], 
     "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"flatTorusEigenvalue", "[", 
        RowBox[{
        "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
         "massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}], ">", 
       "0"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stableFlatTorusModes", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"maxMode_Integer", " ", "?", " ", "NonNegative"}], ",", 
     "\[IndentingNewLine]", "  ", "majorRadius_", ",", "minorRadius_", ",", 
     "\[IndentingNewLine]", "  ", "massTerm_", ",", "coupling_", ",", 
     "backgroundValue_"}], "\[IndentingNewLine]", "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"Select", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "0", ",", "maxMode"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "maxMode"}], "}"}]}], "]"}], ",", "1"}],
       "]"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"TrueQ", "[", "\[IndentingNewLine]", "      ", 
       RowBox[{"undampedModeQ", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "majorRadius", ",", 
         "minorRadius", ",", "massTerm", ",", "coupling", ",", 
         "backgroundValue"}], "]"}], "\[IndentingNewLine]", "    ", "]"}], 
      " ", "&"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",Exp\
ressionUUID->"de1df31e-2517-0a45-8507-fd4dff5db90a"],

