Cell[CellGroupData[{

Cell["5. Framework summary extension", "Section",ExpressionUUID->"2b50e4a6-2e2c-f84a-8a44-83f082ada5d5"],

Cell["\<\
If you already have a summary association, append a linearization block like \
this: \
\>", "CodeText",ExpressionUUID->"15be074e-bea9-294a-9f85-aeb0c7b01314"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "smallestScaleToroidalLinearizedFramework", "]"}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"smallestScaleToroidalLinearizedFramework", "[", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"majorRadius", "=", 
        RowBox[{"3", "/", "2"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"minorRadius", "=", 
        RowBox[{"1", "/", "2"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"closureTargetValue", "=", 
        RowBox[{"goldenPhi", "^", 
         RowBox[{"-", "13"}]}]}], ",", "\[IndentingNewLine]", "    ", 
       "normalizedPsi", ",", "\[IndentingNewLine]", "    ", "backgroundValue",
        ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"massTerm", "=", "1"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"coupling", "=", 
        RowBox[{"1", "/", "10"}]}]}], "\[IndentingNewLine]", "  ", "}"}], ",",
      "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"normalizedPsi", "=", 
       RowBox[{"normalizedConstantToroidalMode", "[", 
        RowBox[{
        "majorRadius", ",", "minorRadius", ",", "closureTargetValue"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"backgroundValue", "=", 
       RowBox[{"normalizedPsi", "[", 
        RowBox[{"0", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<FrameworkVersion\>\"", 
         "->", "\"\<Phase3.ToroidalLinearization\>\""}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ScaleIndex\>\"", "->", "0"}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<ClosureTarget\>\"", "->", "closureTargetValue"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<BackgroundValue\>\"", "->", "backgroundValue"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<LinearizedModel\>\"", "->", 
         RowBox[{
         "linearizedToroidalModelSummary", "[", "\[IndentingNewLine]", 
          "      ", 
          RowBox[{
          "majorRadius", ",", "minorRadius", ",", "massTerm", ",", "coupling",
            ",", "backgroundValue", ",", "3"}], "\[IndentingNewLine]", "    ",
           "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SampleNumericalEigenvalues\>\"", "->", 
         RowBox[{
          RowBox[{
          "flatTorusEigenSystem", "[", "\[IndentingNewLine]", "      ", 
           RowBox[{
           "10", ",", "10", ",", "massTerm", ",", "coupling", ",", 
            "backgroundValue", ",", "8", ",", "80"}], "\[IndentingNewLine]", 
           "    ", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Tests\>\"", "->", 
         RowBox[{"smallestScaleLinearizationTestSuite", "[", "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"68c7b19e-b5c0-bf4b-8dd9-\
b2c08e5172b8"],

