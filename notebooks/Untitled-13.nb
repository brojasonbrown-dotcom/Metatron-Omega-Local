Cell[CellGroupData[{

Cell["6. Interactive exploration interface", "Section",ExpressionUUID->"66b2a5e5-cd4e-b948-83d7-169a6cfdecbc"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
      "backgroundValue", ",", "\[IndentingNewLine]", "    ", "eigenTable", ",",
        "\[IndentingNewLine]", "    ", "numericalEigenvalues", ",", 
       "\[IndentingNewLine]", "    ", "modePlot"}], "\[IndentingNewLine]", 
      "  ", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"backgroundValue", "=", 
       RowBox[{
        RowBox[{"normalizedConstantToroidalMode", "[", 
         RowBox[{
         "majorRadius", ",", "minorRadius", ",", "closureTargetValue"}], 
         "]"}], "[", 
        RowBox[{"0", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"eigenTable", "=", 
       RowBox[{"Grid", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Prepend", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"Flatten", "[", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"Table", "[", "\[IndentingNewLine]", "          ", 
              RowBox[{
               RowBox[{"{", "\[IndentingNewLine]", "            ", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"m", ",", "n"}], "}"}], ",", "\[IndentingNewLine]", 
                 "            ", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"flatTorusEigenvalue", "[", 
                    RowBox[{
                    "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",",
                     "massTerm", ",", "coupling", ",", "backgroundValue"}], 
                    "]"}], ",", "20"}], "]"}], ",", "\[IndentingNewLine]", 
                 "            ", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"flatTorusFrequency", "[", 
                    RowBox[{
                    "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",",
                     "massTerm", ",", "coupling", ",", "backgroundValue"}], 
                    "]"}], ",", "20"}], "]"}]}], "\[IndentingNewLine]", 
                "          ", "}"}], ",", "\[IndentingNewLine]", "          ", 
               RowBox[{"{", 
                RowBox[{"m", ",", "0", ",", "maxMode"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"n", ",", "0", ",", "maxMode"}], "}"}]}], 
              "\[IndentingNewLine]", "        ", "]"}], ",", 
             "\[IndentingNewLine]", "        ", "1"}], "\[IndentingNewLine]", 
            "      ", "]"}], ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Mode\>\"", ",", "\"\<Eigenvalue\>\"", 
             ",", "\"\<Frequency\>\""}], "}"}]}], "\[IndentingNewLine]", 
          "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "  ", 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
      RowBox[{"numericalEigenvalues", "=", 
       RowBox[{
        RowBox[{"flatTorusEigenSystem", "[", 
         RowBox[{
         "nU", ",", "nV", ",", "massTerm", ",", "coupling", ",", 
          "backgroundValue", ",", "eigenCount", ",", "wp"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"modePlot", "=", 
       RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"toroidalMode", "[", 
             RowBox[{"modeU", ",", "modeV", ",", "1", ",", "alpha"}], "]"}], "[", 
            RowBox[{"u", ",", "v"}], "]"}], "]"}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"u", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"Mesh", "->", "None"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"PlotPoints", "->", "50"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"ColorFunction", "->", "\"\<SolarColors\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Re mode(\>\"", ",", "modeU", ",", "\"\<,\>\"", ",", 
             "modeV", ",", "\"\<)\>\""}], "}"}], "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
