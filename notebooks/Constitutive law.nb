Cell[CellGroupData[{

Cell["23. Stable-scale-only engine", "Section",ExpressionUUID->"550f59ec-5816-ed4b-817c-a46f989196ec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "stableScaleEngine", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stableScaleEngine", "[", 
    RowBox[{
     RowBox[{"divisor_", ":", "13"}], ",", 
     RowBox[{"tolerance_", ":", "0.01"}], ",", 
     RowBox[{"truncation_Integer", ":", "6"}], ",", 
     RowBox[{"sigmaValue_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"scaleComputationalBundle", "[", 
       RowBox[{"#", ",", "truncation", ",", "sigmaValue"}], "]"}], " ", "&"}],
      ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"stableScaleIndices", "[", 
      RowBox[{"maxScaleCount", ",", "divisor", ",", "tolerance"}], "]"}]}], 
