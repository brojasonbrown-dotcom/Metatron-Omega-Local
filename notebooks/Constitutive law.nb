Cell[CellGroupData[{

Cell["\<\
12. Linearized stiffness matrix around scale-specific backgrounds\
\>", "Section",ExpressionUUID->"1131f209-311c-ce47-b69c-0b095d279783"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "potentialPart", ",", "stiffnessMatrixLayer1", ",", 
     "stiffnessEigenSystemLayer1"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"potentialPart", "[", 
     RowBox[{"rhoVar_", ",", "chiVar_", ",", "resVar_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"rhoVar", " ", 
      RowBox[{"Log", "[", "chiVar", "]"}]}], "+", 
     RowBox[{"chiVar", " ", 
      RowBox[{"resVar", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stiffnessMatrixLayer1", "[", 
     RowBox[{"rhoBack_", ",", "chiBack_", ",", "resBack_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"potentialPart", "[", 
           RowBox[{
            RowBox[{"rhoBack", "+", "drho"}], ",", 
            RowBox[{"chiBack", "+", "dchi"}], ",", 
            RowBox[{"resBack", "+", "dres"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", "var1", ",", "var2"}], 
         "\[IndentingNewLine]", "  ", "]"}], " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"drho", "->", "0"}], ",", 
          RowBox[{"dchi", "->", "0"}], ",", 
          RowBox[{"dres", "->", "0"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"{", 
        RowBox[{"var1", ",", 
         RowBox[{"{", 
          RowBox[{"drho", ",", "dchi", ",", "dres"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"var2", ",", 
         RowBox[{"{", 
          RowBox[{"drho", ",", "dchi", ",", "dres"}], "}"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], " ", "//", " ", "FullSimplify"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stiffnessEigenSystemLayer1", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rhoBack", "=", 
        RowBox[{"informationDensity", "[", "n", "]"}]}], ",", 
       RowBox[{"chiBack", "=", 
        RowBox[{"fieldComplexityIndex", "[", "n", "]"}]}], ",", 
       RowBox[{"resBack", "=", 
        RowBox[{"phi", "^", "n"}]}], ",", "mat", ",", "vals", ",", "vecs"}], 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"stiffnessMatrixLayer1", "[", 
        RowBox[{"rhoBack", ",", "chiBack", ",", "resBack"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"mat", ",", 
         RowBox[{"Cubics", "->", "True"}], ",", 
         RowBox[{"Quartics", "->", "True"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<Background\>\"", "->", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Rho0\>\"", "->", "rhoBack"}], ",", 
           RowBox[{"\"\<Chi0\>\"", "->", "chiBack"}], ",", 
           RowBox[{"\"\<Res0\>\"", "->", "resBack"}]}], "|>"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<StiffnessMatrix\>\"", "->", "mat"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Eigenvalues\>\"", "->", "vals"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Eigenvectors\>\"", "->", "vecs"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<PureImaginaryModes\>\"", "->", 
         RowBox[{"Select", "[", 
          RowBox[{"vals", ",", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"FullSimplify", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", "#", "]"}], "==", "0"}], "&&", 
               RowBox[{
                RowBox[{"Im", "[", "#", "]"}], ">", "0"}]}], "]"}], "]"}], 
            " ", "&"}]}], "]"}]}]}], "\[IndentingNewLine]", "  ", "|>"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"3af84148-be0c-a44e-a5bb-e535a47b6800"],

