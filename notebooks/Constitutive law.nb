Cell[CellGroupData[{

Cell["27. Composable morphisms L0 -> L1 -> L2", "Section",ExpressionUUID->"dd6c50d1-4cf6-b344-be61-e7ed058f6b8d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "layer0ToLayer1", ",", "layer1ToSpectrum", ",", "spectrumToMeasurement", ",",
      "fullPipeline"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layer0ToLayer1", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"n", ",", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", 
        RowBox[{"\"\<Ontology\>\"", "->", 
         RowBox[{"fullScaleOntology", "[", "n", "]"}]}], ",", 
        RowBox[{"\"\<EulerEquations\>\"", "->", 
         RowBox[{"layer1EulerEquations", "[", "]"}]}]}], "|>"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layer1ToSpectrum", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"data", ",", 
      RowBox[{"Join", "[", 
       RowBox[{"data", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<SpectralData\>\"", "->", 
           RowBox[{"scaleSpectralData", "[", 
            RowBox[{
             RowBox[{"data", "[", "\"\<ScaleIndex\>\"", "]"}], ",", "6", ",", 
             "1"}], "]"}]}], ",", 
          RowBox[{"\"\<StiffnessAnalysis\>\"", "->", 
           RowBox[{"stiffnessEigenSystemLayer1", "[", 
            RowBox[{"data", "[", "\"\<ScaleIndex\>\"", "]"}], "]"}]}]}], 
         "|>"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spectrumToMeasurement", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"data", ",", 
      RowBox[{"Join", "[", 
       RowBox[{"data", ",", 
        RowBox[{"<|", 
         RowBox[{"\"\<Measurement\>\"", "->", 
          RowBox[{"scaleMeasurementAssociation", "[", 
           RowBox[{
            RowBox[{"data", "[", "\"\<ScaleIndex\>\"", "]"}], ",", 
            RowBox[{"data", "[", "\"\<SpectralData\>\"", "]"}]}], "]"}]}], 
         "|>"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fullPipeline", "=", 
   RowBox[{
   "layer0ToLayer1", " ", "/*", " ", "layer1ToSpectrum", " ", "/*", " ", 
    "spectrumToMeasurement"}]}], ";"}]}], "Input",ExpressionUUID->"f1b4b3e8-\
9207-324e-91b9-4c5d21b6ea83"],

