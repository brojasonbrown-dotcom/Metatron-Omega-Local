Cell[CellGroupData[{

Cell["3. Toroidal octave registry for all 18 modes per scale", "Section",ExpressionUUID->"35f5bd7c-1e24-654f-b1ec-25c59e87e05a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "octaveIndexData", ",", "scaleOctaveTable", ",", "allScaleOctaves"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"octaveIndexData", "[", 
     RowBox[{"n_Integer", ",", "octave_Integer"}], "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<OctaveIndex\>\"", "->", "octave"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<OctaveWeight\>\"", "->", 
       RowBox[{"phi", "^", 
        RowBox[{"(", 
         RowBox[{"octave", "-", "1"}], ")"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<AngularModeM\>\"", "->", 
       RowBox[{"octave", "-", "1"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<AngularModeN\>\"", "->", 
       RowBox[{
        RowBox[{"-", "octave"}], "+", "1"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<ClosureShift\>\"", "->", 
       RowBox[{"phi", "^", 
        RowBox[{"(", 
         RowBox[{"n", "+", "octave", "-", "1"}], ")"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ResolutionShift\>\"", "->", 
       RowBox[{"phi", "^", 
        RowBox[{"(", 
         RowBox[{"n", "-", "octave", "+", "1"}], ")"}]}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleOctaveTable", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"octaveTotal_", ":", "octaveCount"}]}], "]"}], ":=", 
    RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"octaveIndexData", "[", 
        RowBox[{"n", ",", "#"}], "]"}], " ", "&"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", "octaveTotal"}], "]"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allScaleOctaves", "[", "]"}], ":=", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"scaleOctaveTable", ",", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "maxScaleCount"}], "]"}]}], "]"}]}], ";"}]}], "Input",\
ExpressionUUID->"7d217662-bbd8-1a4c-9c2a-38616f3ee6f8"],

