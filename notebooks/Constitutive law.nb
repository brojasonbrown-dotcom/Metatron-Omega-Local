Cell[CellGroupData[{

Cell["10. Local stationary sector and exact reduction", "Section",ExpressionUUID->"77b69973-b813-024b-a13b-18d6797e5907"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "localPotential", ",", "stationaryConditions", ",", 
     "stationaryReduction"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"localPotential", "[", 
     RowBox[{"rhoVar_", ",", "chiVar_", ",", "resVar_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"rhoVar", " ", 
      RowBox[{"Log", "[", "chiVar", "]"}]}], "+", 
     RowBox[{"chiVar", " ", 
      RowBox[{"resVar", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stationaryConditions", ":=", 
    RowBox[{"Thread", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"localPotential", "[", 
           RowBox[{"rho0", ",", "chi0", ",", "res0"}], "]"}], ",", "rho0"}], 
         "]"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"localPotential", "[", 
           RowBox[{"rho0", ",", "chi0", ",", "res0"}], "]"}], ",", "chi0"}], 
         "]"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"localPotential", "[", 
           RowBox[{"rho0", ",", "chi0", ",", "res0"}], "]"}], ",", "res0"}], 
         "]"}]}], "\[IndentingNewLine]", "  ", "}"}], "==", "0"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stationaryReduction", ":=", 
   RowBox[{"Reduce", "[", 
    RowBox[{"stationaryConditions", ",", 
     RowBox[{"{", 
      RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "Reals"}], 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"063b867b-36e4-ea49-ae1a-\
13a0f833ab14"],

