Cell[CellGroupData[{

Cell["25. Validation diagnostics per scale", "Section",ExpressionUUID->"4108e92f-1d69-9342-aa46-bc2e680caf9a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "residueAnalysis", ",", "constitutiveConsistencyCheck", ",", 
     "scaleValidationReport"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"residueAnalysis", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mat", "=", 
        RowBox[{"stiffnessMatrixLayer1", "[", 
         RowBox[{
          RowBox[{"informationDensity", "[", "n", "]"}], ",", 
          RowBox[{"fieldComplexityIndex", "[", "n", "]"}], ",", 
          RowBox[{"phi", "^", "n"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Trace\>\"", "->", 
         RowBox[{"Tr", "[", "mat", "]"}]}], ",", 
        RowBox[{"\"\<Determinant\>\"", "->", 
         RowBox[{"Det", "[", "mat", "]"}]}], ",", 
        RowBox[{"\"\<MatrixNorm\>\"", "->", 
         RowBox[{"Norm", "[", "mat", "]"}]}]}], "|>"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"constitutiveConsistencyCheck", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"law", "=", 
        RowBox[{"scaleConstitutiveLaw", "[", "n", "]"}]}], "}"}], ",", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<PositivePermittivityQ\>\"", "->", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{"law", "[", "\"\<Permittivity\>\"", "]"}], ">", "0"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<PositivePermeabilityQ\>\"", "->", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{"law", "[", "\"\<Permeability\>\"", "]"}], ">", "0"}], 
          "]"}]}]}], "|>"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleValidationReport", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<ResidueAnalysis\>\"", "->", 
      RowBox[{"residueAnalysis", "[", "n", "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ConstitutiveConsistency\>\"", "->", 
      RowBox[{"constitutiveConsistencyCheck", "[", "n", "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<StableScaleQ\>\"", "->", 
      RowBox[{"stableScaleQ", "[", "n", "]"}]}]}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]}], "Input",ExpressionUUID->"d91b465b-e781-9745-b265-\
40823ed25d00"],

