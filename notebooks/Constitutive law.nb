Cell[CellGroupData[{

Cell["7. Per-scale constitutive laws", "Section",ExpressionUUID->"341097cf-2e72-9749-bb58-8fcdb36e1fda"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "scaleConstitutiveLaw", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleConstitutiveLaw", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"medium", "=", 
        RowBox[{"mediumTypeByScale", "[", "n", "]"}]}], ",", 
       RowBox[{"rho", "=", 
        RowBox[{"informationDensity", "[", "n", "]"}]}], ",", 
       RowBox[{"chi", "=", 
        RowBox[{"fieldComplexityIndex", "[", "n", "]"}]}], ",", 
       RowBox[{"res", "=", 
        RowBox[{"phi", "^", "n"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"Switch", "[", 
      RowBox[{
      "medium", ",", "\[IndentingNewLine]", "    ", "\"\<PreGeometric\>\"", ",",
        "\[IndentingNewLine]", "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Permittivity\>\"", "->", "rho"}], ",", 
         RowBox[{"\"\<Permeability\>\"", "->", "chi"}], ",", 
         RowBox[{"\"\<Dispersion\>\"", "->", "0"}], ",", 
         RowBox[{"\"\<Nonlinearity\>\"", "->", 
          RowBox[{"rho", " ", "chi"}]}]}], "|>"}], ",", "\[IndentingNewLine]",
        "    ", "\"\<QuantumInformational\>\"", ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Permittivity\>\"", "->", 
          RowBox[{"rho", "^", "2"}]}], ",", 
         RowBox[{"\"\<Permeability\>\"", "->", 
          RowBox[{"1", "/", "chi"}]}], ",", 
         RowBox[{"\"\<Dispersion\>\"", "->", 
          RowBox[{"rho", " ", "chi"}]}], ",", 
         RowBox[{"\"\<Nonlinearity\>\"", "->", 
          RowBox[{"rho", " ", "res"}]}]}], "|>"}], ",", "\[IndentingNewLine]",
        "    ", "\"\<FieldStructured\>\"", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Permittivity\>\"", "->", 
          RowBox[{"rho", " ", "chi"}]}], ",", 
         RowBox[{"\"\<Permeability\>\"", "->", 
          RowBox[{"1", "/", "rho"}]}], ",", 
         RowBox[{"\"\<Dispersion\>\"", "->", 
          RowBox[{"1", "/", "chi"}]}], ",", 
         RowBox[{"\"\<Nonlinearity\>\"", "->", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"rho", " ", "chi"}], "]"}]}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "    ", "\"\<ResonantEmergent\>\"", ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Permittivity\>\"", "->", 
          RowBox[{"chi", "/", "res"}]}], ",", 
         RowBox[{"\"\<Permeability\>\"", "->", 
          RowBox[{"rho", " ", "res"}]}], ",", 
         RowBox[{"\"\<Dispersion\>\"", "->", 
          RowBox[{"rho", "/", "chi"}]}], ",", 
         RowBox[{"\"\<Nonlinearity\>\"", "->", 
          RowBox[{"chi", " ", 
           RowBox[{"rho", "^", "2"}]}]}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "    ", "\"\<MacroscopicEmergent\>\"", ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Permittivity\>\"", "->", "chi"}], ",", 
         RowBox[{"\"\<Permeability\>\"", "->", "rho"}], ",", 
         RowBox[{"\"\<Dispersion\>\"", "->", 
          RowBox[{"rho", "/", "chi"}]}], ",", 
         RowBox[{"\"\<Nonlinearity\>\"", "->", 
          RowBox[{"res", "/", "chi"}]}]}], "|>"}]}], "\[IndentingNewLine]", 
      "  ", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",Expressi\
onUUID->"0b14da84-23b6-d14f-8efd-21307dc724a8"],

