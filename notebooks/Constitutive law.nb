Cell[CellGroupData[{

Cell["9. Layer-1 fields and variational density", "Section",ExpressionUUID->"45aed966-5273-ef48-81cd-f783e6daa3fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "rho", ",", "chi", ",", "res", ",", "x", ",", "y", ",", "z", ",", "t", ",",
      "coords3", ",", "layer1DensityRegularized", ",", 
     "layer1EulerEquations"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords3", "=", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"layer1DensityRegularized", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
      "rho_", ",", "chi_", ",", "res_", ",", "alphaRho_", ",", "alphaChi_", ",",
        "alphaRes_"}], "\[IndentingNewLine]", "]"}], "[", "vars_List", "]"}], 
    ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rhoExpr", ",", "chiExpr", ",", "resExpr"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"rhoExpr", "=", 
        RowBox[{"rho", " ", "@@", " ", "vars"}]}], ";", "\[IndentingNewLine]",
        "  ", 
       RowBox[{"chiExpr", "=", 
        RowBox[{"chi", " ", "@@", " ", "vars"}]}], ";", "\[IndentingNewLine]",
        "  ", 
       RowBox[{"resExpr", "=", 
        RowBox[{"res", " ", "@@", " ", "vars"}]}], ";", "\[IndentingNewLine]",
        "  ", 
       RowBox[{
        RowBox[{"rhoExpr", " ", 
         RowBox[{"Log", "[", "chiExpr", "]"}]}], "+", 
        RowBox[{"chiExpr", " ", 
         RowBox[{"resExpr", "^", "2"}]}], "+", "\[IndentingNewLine]", "  ", 
        RowBox[{"alphaRho", " ", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"rhoExpr", ",", "#"}], "]"}], "^", "2"}], " ", "&"}], 
           " ", "/@", " ", "vars"}], "]"}]}], "+", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"alphaChi", " ", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"chiExpr", ",", "#"}], "]"}], "^", "2"}], " ", "&"}], 
           " ", "/@", " ", "vars"}], "]"}]}], "+", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"alphaRes", " ", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{"resExpr", ",", "#"}], "]"}], "^", "2"}], " ", "&"}], 
           " ", "/@", " ", "vars"}], "]"}]}]}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layer1EulerEquations", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"vars_List", ":", "coords3"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"alphaRho_", ":", "alphaRho"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"alphaChi_", ":", "alphaChi"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"alphaRes_", ":", "alphaRes"}]}], "\[IndentingNewLine]", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lagrangian", ",", "rhoExpr", ",", "chiExpr", ",", "resExpr"}], 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"lagrangian", "=", 
       RowBox[{
        RowBox[{"layer1DensityRegularized", "[", 
         RowBox[{
         "rho", ",", "chi", ",", "res", ",", "alphaRho", ",", "alphaChi", ",",
           "alphaRes"}], "]"}], "[", "vars", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"rhoExpr", "=", 
       RowBox[{"rho", " ", "@@", " ", "vars"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"chiExpr", "=", 
       RowBox[{"chi", " ", "@@", " ", "vars"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"resExpr", "=", 
       RowBox[{"res", " ", "@@", " ", "vars"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<RhoEquation\>\"", "->", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"VariationalD", "[", 
            RowBox[{"lagrangian", ",", "rhoExpr", ",", "vars"}], "]"}], "==", 
           "0"}], "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ChiEquation\>\"", "->", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"VariationalD", "[", 
            RowBox[{"lagrangian", ",", "chiExpr", ",", "vars"}], "]"}], "==", 
           "0"}], "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ResolutionEquation\>\"", "->", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           RowBox[{"VariationalD", "[", 
            RowBox[{"lagrangian", ",", "resExpr", ",", "vars"}], "]"}], "==", 
           "0"}], "]"}]}]}], "\[IndentingNewLine]", "  ", "|>"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"e451d7ef-0830-f844-bc19-399203face65"],

