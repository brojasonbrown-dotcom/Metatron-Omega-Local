Cell[CellGroupData[{

Cell["1. Stable-scale arithmetic and closure diagnostics", "Section",ExpressionUUID->"9747f013-9cb4-1a49-9ecd-922b183d24c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "scaleResidual", ",", "closureScore", ",", "windingEstimate", ",", 
     "informationDensity", ",", "fieldComplexityIndex", ",", 
     "\[IndentingNewLine]", "  ", "stableScaleQ", ",", "stableScaleIndices", ",",
      "nextStableScale", ",", "scaleAssociationExact"}], 
    "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleResidual", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"divisor_", ":", "13"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"phi", "^", "n"}], "/", "divisor"}], ",", "100"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"x", "-", 
        RowBox[{"Round", "[", "x", "]"}]}], "]"}], "/", "x"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"closureScore", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"divisor_", ":", "13"}]}], "]"}], ":=", 
   RowBox[{"1", "-", 
    RowBox[{"scaleResidual", "[", 
     RowBox[{"n", ",", "divisor"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"windingEstimate", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"divisor_", ":", "13"}]}], "]"}], ":=", 
   RowBox[{"Round", "[", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"phi", "^", "n"}], "/", "divisor"}], ",", "100"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"informationDensity", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"phi", "^", 
    RowBox[{"-", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fieldComplexityIndex", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Fibonacci", "[", 
     RowBox[{"n", "+", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stableScaleQ", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"divisor_", ":", "13"}], ",", 
      RowBox[{"tolerance_", ":", "0.01"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"scaleResidual", "[", 
      RowBox[{"n", ",", "divisor"}], "]"}], "<", "tolerance"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stableScaleIndices", "[", 
     RowBox[{
      RowBox[{"maxN_Integer", ":", "maxScaleCount"}], ",", 
      RowBox[{"divisor_", ":", "13"}], ",", 
      RowBox[{"tolerance_", ":", "0.01"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "maxN"}], "]"}], ",", 
      RowBox[{
       RowBox[{"stableScaleQ", "[", 
        RowBox[{"#", ",", "divisor", ",", "tolerance"}], "]"}], " ", "&"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"nextStableScale", "[", 
     RowBox[{"currentN_Integer", ",", 
      RowBox[{"divisor_", ":", "13"}], ",", 
      RowBox[{"tolerance_", ":", "0.01"}], ",", 
      RowBox[{"maxN_", ":", "maxScaleCount"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"FirstCase", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"currentN", "+", "1"}], ",", "maxN"}], "]"}], ",", 
      RowBox[{
       RowBox[{"n_", " ", "/;", " ", 
        RowBox[{"stableScaleQ", "[", 
         RowBox[{"n", ",", "divisor", ",", "tolerance"}], "]"}]}], ":>", 
       "n"}], ",", 
      RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleAssociationExact", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"divisor_", ":", "13"}]}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<PhiPowerExact\>\"", "->", 
      RowBox[{"phi", "^", "n"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<PhiPowerNumeric\>\"", "->", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"phi", "^", "n"}], ",", "100"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Residual\>\"", "->", 
      RowBox[{"scaleResidual", "[", 
       RowBox[{"n", ",", "divisor"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<ClosureScore\>\"", "->", 
      RowBox[{"closureScore", "[", 
       RowBox[{"n", ",", "divisor"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<WindingEstimate\>\"", "->", 
      RowBox[{"windingEstimate", "[", 
       RowBox[{"n", ",", "divisor"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<InformationDensity\>\"", "->", 
      RowBox[{"informationDensity", "[", "n", "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<FieldComplexityIndex\>\"", "->", 
      RowBox[{"fieldComplexityIndex", "[", "n", "]"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"b0b05830-cbd6-1d4a-9941-5579dcc71225"],

