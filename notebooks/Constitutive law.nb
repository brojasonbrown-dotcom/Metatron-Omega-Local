Cell[CellGroupData[{

Cell["8. Octave-resolved constitutive refinement", "Section",ExpressionUUID->"044c5be3-109e-3246-90c9-a6b44506b35e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "octaveConstitutiveLaw", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"octaveConstitutiveLaw", "[", 
    RowBox[{"n_Integer", ",", "octave_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"base", "=", 
        RowBox[{"scaleConstitutiveLaw", "[", "n", "]"}]}], ",", 
       RowBox[{"weight", "=", 
        RowBox[{"phi", "^", 
         RowBox[{"(", 
          RowBox[{"octave", "-", "1"}], ")"}]}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", " ", "weight"}], " ", "&"}], ",", "base"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"f1a512fd-7580-ec4b-a461-bdfb56dc01f3"],

