Cell[CellGroupData[{

Cell["20. Per-scale full ontology object", "Section",ExpressionUUID->"8c43e563-d2a5-7f49-90da-fa73c2dcbeea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "fullScaleOntology", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fullScaleOntology", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"Join", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"scaleAssociationExact", "[", "n", "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"geometryOntology", "[", "n", "]"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"mediumOntology", "[", "n", "]"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"<|", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"\"\<PropagationType\>\"", "->", 
        RowBox[{"propagationTypeByScale", "[", "n", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"\"\<ConstitutiveLaw\>\"", "->", 
        RowBox[{"scaleConstitutiveLaw", "[", "n", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"\"\<ResolutionLaw\>\"", "->", 
        RowBox[{"scaleResolutionLaw", "[", "n", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"\"\<OctaveTable\>\"", "->", 
        RowBox[{"octaveStabilityTable", "[", "n", "]"}]}]}], 
      "\[IndentingNewLine]", "  ", "|>"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"08791096-a721-ac4a-8a38-7c54454a674d"],

