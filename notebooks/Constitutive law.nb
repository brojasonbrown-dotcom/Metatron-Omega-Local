Cell[CellGroupData[{

Cell["15. Toroidal modal basis", "Section",ExpressionUUID->"794ced1a-4cc6-5048-8b5b-c7fb486d3ca3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "toroidalMode", ",", "torusModeIndexSet", ",", "toroidalEigenvalue"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"toroidalMode", "[", 
      RowBox[{"m_Integer", ",", "n_Integer"}], "]"}], "[", 
     RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"m", " ", "u"}], "+", 
        RowBox[{"n", " ", "v"}]}], ")"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusModeIndexSet", "[", 
     RowBox[{"mMax_Integer", ",", "nMax_Integer"}], "]"}], ":=", 
    RowBox[{"Flatten", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", 
          RowBox[{"-", "mMax"}], ",", "mMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"-", "nMax"}], ",", "nMax"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", "1"}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalEigenvalue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m_Integer", ",", "n_Integer"}], "}"}], ",", "majorRadius_", ",",
      "minorRadius_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"m", "^", "2"}], "/", 
       RowBox[{"majorRadius", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"n", "^", "2"}], "/", 
       RowBox[{"minorRadius", "^", "2"}]}]}], ")"}]}]}], ";"}]}], "Input",Expr\
essionUUID->"ec50b787-e067-e24f-9af1-0c94d04431d5"],

