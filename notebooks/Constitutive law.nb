Cell[CellGroupData[{

Cell["18. Resolution law per scale and per octave", "Section",ExpressionUUID->"50e6a399-116b-7344-97ad-dc312335efe4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"scaleResolutionLaw", ",", "octaveResolutionLaw"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleResolutionLaw", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<GridScale\>\"", "->", 
       RowBox[{"phi", "^", 
        RowBox[{"-", "n"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ObservationKernelWidth\>\"", "->", 
       RowBox[{"phi", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "n"}], "/", "2"}], ")"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<EffectiveBandwidth\>\"", "->", 
       RowBox[{
        RowBox[{"phi", "^", "n"}], " ", 
        RowBox[{"informationDensity", "[", "n", "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<SamplingDensity\>\"", "->", 
       RowBox[{
        RowBox[{"fieldComplexityIndex", "[", "n", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", "n"}], ")"}]}]}]}], "\[IndentingNewLine]", 
     "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"octaveResolutionLaw", "[", 
    RowBox[{"n_Integer", ",", "octave_Integer"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<OctaveIndex\>\"", "->", "octave"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<GridScale\>\"", "->", 
      RowBox[{"phi", "^", 
       RowBox[{"(", 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"n", "+", "octave", "-", "1"}], ")"}]}], ")"}]}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ObservationKernelWidth\>\"", "->", 
      RowBox[{"phi", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"n", "+", "octave", "-", "1"}], ")"}]}], "/", "2"}], 
        ")"}]}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<EffectiveBandwidth\>\"", "->", 
      RowBox[{
       RowBox[{"phi", "^", 
        RowBox[{"(", 
         RowBox[{"n", "+", "octave", "-", "1"}], ")"}]}], " ", 
       RowBox[{"informationDensity", "[", "n", "]"}]}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<SamplingDensity\>\"", "->", 
      RowBox[{
       RowBox[{"fieldComplexityIndex", "[", "n", "]"}], " ", 
       RowBox[{
        RowBox[{"phi", "^", 
         RowBox[{"(", 
          RowBox[{"octave", "-", "1"}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", "n"}], ")"}]}]}]}]}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]}], "Input",ExpressionUUID->"a5156e89-25fe-ac47-a539-\
2d20d8511b5d"],

