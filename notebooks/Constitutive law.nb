Cell[CellGroupData[{

Cell["0. Initialization and kernel policies", "Section",ExpressionUUID->"6f7ad1a4-a385-e643-b604-93ee80eaeea5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "alphaRho", ",", "alphaChi", ",", "alphaRes", ",", "sigma", ",", 
         "gamma", ",", "kappa"}], "}"}], ",", "Reals"}], "]"}], "&&", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"alphaRho", ">", "0"}], "&&", 
     RowBox[{"alphaChi", ">", "0"}], "&&", 
     RowBox[{"alphaRes", ">", "0"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetSystemOptions", "[", 
    RowBox[{"\"\<ReduceOptions\>\"", "->", 
     RowBox[{"\"\<Measures\>\"", "->", "False"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"highPrecisionTarget", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxScaleCount", "=", "294"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"octaveCount", "=", "18"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phi", "=", "GoldenRatio"}], ";"}]}], "Input",ExpressionUUID->\
"9db3454e-1775-e64a-9c5c-44492c01a733"],

