Cell[CellGroupData[{

Cell["17. 18-octave toroidal stability table per scale", "Section",ExpressionUUID->"00a48876-9088-b540-9171-67820c80c6a2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"octaveModeTable", ",", "octaveStabilityTable"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"octaveModeTable", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"oct", ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"With", "[", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"radii", "=", 
             RowBox[{"octaveRadiiAtScale", "[", 
              RowBox[{"n", ",", "oct"}], "]"}]}], ",", "\[IndentingNewLine]", 
            "        ", 
            RowBox[{"mode", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"oct", "-", "1"}], ",", 
               RowBox[{
                RowBox[{"-", "oct"}], "+", "1"}]}], "}"}]}]}], 
           "\[IndentingNewLine]", "      ", "}"}], ",", "\[IndentingNewLine]",
           "      ", 
          RowBox[{"<|", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"\"\<OctaveIndex\>\"", "->", "oct"}], ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"\"\<Mode\>\"", "->", "mode"}], ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"\"\<MajorRadius\>\"", "->", 
             RowBox[{"radii", "[", "\"\<MajorRadius\>\"", "]"}]}], ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"\"\<MinorRadius\>\"", "->", 
             RowBox[{"radii", "[", "\"\<MinorRadius\>\"", "]"}]}], ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"\"\<TubeRadius\>\"", "->", 
             RowBox[{"radii", "[", "\"\<TubeRadius\>\"", "]"}]}], ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"\"\<Eigenvalue\>\"", "->", 
             RowBox[{
             "toroidalEigenvalue", "[", "\[IndentingNewLine]", "          ", 
              RowBox[{"mode", ",", "\[IndentingNewLine]", "          ", 
               RowBox[{"QuantityMagnitude", "[", 
                RowBox[{
                 RowBox[{"radii", "[", "\"\<MajorRadius\>\"", "]"}], 
                 ",", "\"\<Meters\>\""}], "]"}], ",", "\[IndentingNewLine]", 
               "          ", 
               RowBox[{"QuantityMagnitude", "[", 
                RowBox[{
                 RowBox[{"radii", "[", "\"\<MinorRadius\>\"", "]"}], 
                 ",", "\"\<Meters\>\""}], "]"}]}], "\[IndentingNewLine]", 
              "        ", "]"}]}], ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"\"\<ConstitutiveLaw\>\"", "->", 
             RowBox[{"octaveConstitutiveLaw", "[", 
              RowBox[{"n", ",", "oct"}], "]"}]}]}], "\[IndentingNewLine]", 
           "      ", "|>"}]}], "\[IndentingNewLine]", "    ", "]"}]}], 
       "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", "octaveCount"}], "]"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"octaveStabilityTable", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"octaveModeTable", "[", "n", "]"}]}], ";"}]}], "Input",ExpressionUU\
ID->"3a83a415-ff6c-4449-9db5-a920b2ae196c"],

