Cell[CellGroupData[{

Cell["24. Heavy-resolution numerical refinement hooks", "Section",ExpressionUUID->"2ca31c3e-c636-3549-bea9-a391aba473de"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"highPrecisionEvaluate", ",", "refinedEigenvalues"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"highPrecisionEvaluate", "[", 
     RowBox[{"expr_", ",", 
      RowBox[{"precision_", ":", "highPrecisionTarget"}]}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"$MaxExtraPrecision", "=", "precision"}], "}"}], ",", 
      RowBox[{"N", "[", 
       RowBox[{"expr", ",", "precision"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"refinedEigenvalues", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"precision_", ":", "highPrecisionTarget"}]}], "]"}], ":=", 
   RowBox[{"highPrecisionEvaluate", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", 
      RowBox[{
       RowBox[{"highPrecisionEvaluate", "[", 
        RowBox[{
         RowBox[{"stiffnessMatrixLayer1", "[", 
          RowBox[{
           RowBox[{"informationDensity", "[", "n", "]"}], ",", 
           RowBox[{"fieldComplexityIndex", "[", "n", "]"}], ",", 
           RowBox[{"phi", "^", "n"}]}], "]"}], ",", "precision"}], "]"}], ",", 
       RowBox[{"Cubics", "->", "True"}], ",", 
       RowBox[{"Quartics", "->", "True"}]}], "]"}], ",", "precision"}], 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"045ad25c-2a87-d641-b20b-\
0c537c57da54"],

