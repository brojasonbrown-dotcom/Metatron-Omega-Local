Cell[CellGroupData[{

Cell["16. Scale-specific spectral engine", "Section",ExpressionUUID->"6b604b76-f5f5-9f46-9de5-5502f43b0b2c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "scaleSpectralData", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleSpectralData", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"truncation_Integer", ":", "6"}], ",", 
     RowBox[{"sigmaValue_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"geometry", "=", 
        RowBox[{"geometryTypeByScale", "[", "n", "]"}]}], ",", "radii", ",", 
       "modes", ",", "operatorDiag", ",", "bestModes"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"radii", "=", 
       RowBox[{"torusRadiiAtScale", "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Switch", "[", 
       RowBox[{"geometry", ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Sphere\>\"", " ", "|", " ", "\"\<SphericalShell\>\""}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"modes", "=", 
          RowBox[{"sphericalModeIndexSet", "[", "truncation", "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"operatorDiag", "=", 
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"sphericalEigenvalue", "[", "#", "]"}], "+", 
              "sigmaValue"}], " ", "&"}], ",", "modes"}], "]"}]}], ";"}], ",",
         "\[IndentingNewLine]", "    ", "_", ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{
         RowBox[{"modes", "=", 
          RowBox[{"torusModeIndexSet", "[", 
           RowBox[{"truncation", ",", "truncation"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"operatorDiag", "=", 
          RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
              "toroidalEigenvalue", "[", "\[IndentingNewLine]", "        ", 
               RowBox[{"#", ",", "\[IndentingNewLine]", "        ", 
                RowBox[{"QuantityMagnitude", "[", 
                 RowBox[{
                  RowBox[{"radii", "[", "\"\<MajorRadius\>\"", "]"}], 
                  ",", "\"\<Meters\>\""}], "]"}], ",", "\[IndentingNewLine]", 
                "        ", 
                RowBox[{"QuantityMagnitude", "[", 
                 RowBox[{
                  RowBox[{"radii", "[", "\"\<MinorRadius\>\"", "]"}], 
                  ",", "\"\<Meters\>\""}], "]"}]}], "\[IndentingNewLine]", 
               "      ", "]"}], "+", "sigmaValue"}], " ", "&"}], ",", 
            "\[IndentingNewLine]", "      ", "modes"}], "\[IndentingNewLine]",
            "    ", "]"}]}], ";"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"bestModes", "=", 
       RowBox[{"MinimalBy", "[", 
        RowBox[{
         RowBox[{"Normal", "[", "operatorDiag", "]"}], ",", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "&"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<Geometry\>\"", "->", "geometry"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Modes\>\"", "->", "modes"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<OperatorDiagonal\>\"", "->", "operatorDiag"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<BestModes\>\"", "->", "bestModes"}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"3e9907a7-6f75-8648-8792-\
42b96df9059a"],

