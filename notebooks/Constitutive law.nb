Cell[CellGroupData[{

Cell["14. Spherical modal basis", "Section",ExpressionUUID->"0c79b62b-ac20-aa42-917b-dddae4140f67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "sphericalMode", ",", "sphericalModeIndexSet", ",", 
     "sphericalEigenvalue"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sphericalMode", "[", 
      RowBox[{"l_Integer", ",", "m_Integer"}], "]"}], "[", 
     RowBox[{"theta_", ",", "phiAng_"}], "]"}], ":=", 
    RowBox[{"SphericalHarmonicY", "[", 
     RowBox[{"l", ",", "m", ",", "theta", ",", "phiAng"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sphericalModeIndexSet", "[", "lMax_Integer", "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", ",", "m"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "0", ",", "lMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", 
          RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}], ",", "1"}], "]"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sphericalEigenvalue", "[", 
    RowBox[{"{", 
     RowBox[{"l_Integer", ",", "m_Integer"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "l"}], " ", 
    RowBox[{"(", 
     RowBox[{"l", "+", "1"}], ")"}]}]}], ";"}]}], "Input",ExpressionUUID->\
"df2423d6-aafa-b344-84c3-7af70e466337"],

