Cell[CellGroupData[{

Cell["19. Layer-2 measurement kernel", "Section",ExpressionUUID->"7cbacbbb-fa1a-4745-b839-586832680eb7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "scaleMeasurementWeight", ",", "modalObservable", ",", 
     "scaleMeasurementAssociation"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleMeasurementWeight", "[", 
     RowBox[{"n_Integer", ",", "mode_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"info", "=", 
         RowBox[{"informationDensity", "[", "n", "]"}]}], ",", 
        RowBox[{"res", "=", 
         RowBox[{"phi", "^", "n"}]}]}], "}"}], ",", 
      RowBox[{"info", " ", 
       RowBox[{"res", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           RowBox[{"Norm", "[", "mode", "]"}], "^", "2"}]}], ")"}]}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"modalObservable", "[", 
     RowBox[{"coeffs_Association", ",", "weightFunction_"}], "]"}], ":=", 
    RowBox[{"Total", " ", "@", " ", 
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", "#2", "]"}], " ", 
         RowBox[{"weightFunction", "[", "#1", "]"}], " ", "#2"}], " ", "&"}], 
       ",", "coeffs"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleMeasurementAssociation", "[", 
    RowBox[{"n_Integer", ",", "spectral_Association"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"bestModes", "=", 
        RowBox[{"spectral", "[", "\"\<BestModes\>\"", "]"}]}], ",", "wf"}], 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"wf", "=", 
       RowBox[{
        RowBox[{"scaleMeasurementWeight", "[", 
         RowBox[{"n", ",", "#"}], "]"}], " ", "&"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<BestModes\>\"", "->", "bestModes"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ModeWeights\>\"", "->", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{"wf", ",", 
           RowBox[{"spectral", "[", "\"\<Modes\>\"", "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ObservableProxyOnBestModes\>\"", "->", 
         RowBox[{"Association", " ", "@", " ", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "->", 
              RowBox[{"wf", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}], " ", "&"}], ",", 
            "bestModes"}], "]"}]}]}]}], "\[IndentingNewLine]", "  ", 
       "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",Expression\
UUID->"f2388b91-1c70-d24a-a69e-2403cf25b689"],

