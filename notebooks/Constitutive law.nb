Cell[CellGroupData[{

Cell["6. Medium ontology by scale", "Section",ExpressionUUID->"d8fce4a2-a9cf-fa48-8203-7b3104731261"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"mediumTypeByScale", ",", "mediumOntology"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mediumTypeByScale", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Which", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"n", "<=", "5"}], ",", "\"\<PreGeometric\>\"", ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"n", "<=", "20"}], ",", "\"\<QuantumInformational\>\"", ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"n", "<=", "80"}], ",", "\"\<FieldStructured\>\"", ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"n", "<=", "160"}], ",", "\"\<ResonantEmergent\>\"", ",", 
      "\[IndentingNewLine]", "  ", "True", 
      ",", "\"\<MacroscopicEmergent\>\""}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mediumOntology", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<MediumType\>\"", "->", 
      RowBox[{"mediumTypeByScale", "[", "n", "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<InformationDensityParameter\>\"", "->", 
      RowBox[{"informationDensity", "[", "n", "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<FieldComplexityParameter\>\"", "->", 
      RowBox[{"fieldComplexityIndex", "[", "n", "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ResolutionParameter\>\"", "->", 
      RowBox[{"phi", "^", "n"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<DampingParameter\>\"", "->", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", "n"}], ")"}]}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<CouplingParameter\>\"", "->", 
      RowBox[{"phi", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "n"}], "/", "2"}], ")"}]}]}]}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]}], "Input",ExpressionUUID->"85a725b0-9605-8a4a-8f66-\
7723efc3177c"],

