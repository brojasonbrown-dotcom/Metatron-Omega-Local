Cell[CellGroupData[{

Cell["4. Dimensional anchoring and radii laws", "Section",ExpressionUUID->"29753383-71df-8c43-b1ca-01d45b24a76c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "planckLength", ",", "planckTime", ",", "scaleLength", ",", 
     "torusRadiiAtScale", ",", "octaveRadiiAtScale"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"planckLength", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{
     RowBox[{"1.616255", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "35"}]}]}], ",", "\"\<Meters\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"planckTime", "=", 
    RowBox[{"Quantity", "[", 
     RowBox[{
      RowBox[{"5.391247", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "44"}]}]}], ",", "\"\<Seconds\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleLength", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"UnitConvert", "[", 
     RowBox[{
      RowBox[{"planckLength", " ", 
       RowBox[{"phi", "^", "n"}]}], ",", "\"\<Meters\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusRadiiAtScale", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<MajorRadius\>\"", "->", 
       RowBox[{"scaleLength", "[", "n", "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<MinorRadius\>\"", "->", 
       RowBox[{"scaleLength", "[", 
        RowBox[{"n", "-", "1"}], "]"}]}]}], "\[IndentingNewLine]", "|>"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"octaveRadiiAtScale", "[", 
    RowBox[{"n_Integer", ",", "octave_Integer"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<OctaveIndex\>\"", "->", "octave"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<MajorRadius\>\"", "->", 
      RowBox[{"UnitConvert", "[", 
       RowBox[{
        RowBox[{"planckLength", " ", 
         RowBox[{"phi", "^", 
          RowBox[{"(", 
           RowBox[{"n", "+", "octave", "-", "1"}], ")"}]}]}], 
        ",", "\"\<Meters\>\""}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<MinorRadius\>\"", "->", 
      RowBox[{"UnitConvert", "[", 
       RowBox[{
        RowBox[{"planckLength", " ", 
         RowBox[{"phi", "^", 
          RowBox[{"(", 
           RowBox[{"n", "+", "octave", "-", "2"}], ")"}]}]}], 
        ",", "\"\<Meters\>\""}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<TubeRadius\>\"", "->", 
      RowBox[{"UnitConvert", "[", 
       RowBox[{
        RowBox[{"planckLength", " ", 
         RowBox[{"phi", "^", 
          RowBox[{"(", 
           RowBox[{"n", "-", "octave", "+", "1"}], ")"}]}]}], 
        ",", "\"\<Meters\>\""}], "]"}]}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}]}], "Input",ExpressionUUID->"4867a349-3756-5946-bbec-37f5e23e5cef"],

