Cell[CellGroupData[{

Cell["13. Propagation-type ontology and operator registry", "Section",ExpressionUUID->"5ff14126-3c14-104a-9a22-f76bc1a0a42f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"propagationTypeByScale", ",", "scalePropagationOperator"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"propagationTypeByScale", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Which", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"n", "<=", "5"}], ",", "\"\<ConstraintTransfer\>\"", ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"n", "<=", "20"}], ",", "\"\<SchrodingerLike\>\"", ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"n", "<=", "120"}], ",", "\"\<WaveLike\>\"", ",", 
      "\[IndentingNewLine]", "  ", "True", ",", "\"\<DissipativeWave\>\""}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scalePropagationOperator", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ptype", "=", 
        RowBox[{"propagationTypeByScale", "[", "n", "]"}]}], ",", 
       RowBox[{"damping", "=", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", "n"}], ")"}]}]}], ",", 
       RowBox[{"coupling", "=", 
        RowBox[{"phi", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "n"}], "/", "2"}], ")"}]}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Switch", "[", 
      RowBox[{
      "ptype", ",", "\[IndentingNewLine]", 
       "    ", "\"\<ConstraintTransfer\>\"", ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<OperatorType\>\"", "->", "ptype"}], ",", 
         RowBox[{"\"\<Operator\>\"", "->", 
          RowBox[{"Function", "[", 
           RowBox[{"u", ",", 
            RowBox[{"coupling", " ", "u"}]}], "]"}]}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "    ", "\"\<SchrodingerLike\>\"", ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<OperatorType\>\"", "->", "ptype"}], ",", 
         RowBox[{"\"\<Operator\>\"", "->", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"u", ",", "vars"}], "}"}], ",", 
            RowBox[{
             RowBox[{"I", " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"u", " ", "@@", " ", "vars"}], ",", "t"}], "]"}]}], "+", 
             RowBox[{"coupling", " ", 
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"u", " ", "@@", " ", "vars"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"#", ",", "2"}], "}"}]}], "]"}], " ", "&"}], " ", 
                "/@", " ", 
                RowBox[{"Most", "[", "vars", "]"}]}], "]"}]}]}]}], "]"}]}]}], 
        "|>"}], ",", "\[IndentingNewLine]", "    ", "\"\<WaveLike\>\"", ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<OperatorType\>\"", "->", "ptype"}], ",", 
         RowBox[{"\"\<Operator\>\"", "->", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"u", ",", "vars"}], "}"}], ",", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"u", " ", "@@", " ", "vars"}], ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "+", 
             RowBox[{"damping", " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"u", " ", "@@", " ", "vars"}], ",", "t"}], "]"}]}], "-", 
             RowBox[{"coupling", " ", 
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"u", " ", "@@", " ", "vars"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"#", ",", "2"}], "}"}]}], "]"}], " ", "&"}], " ", 
                "/@", " ", 
                RowBox[{"Most", "[", "vars", "]"}]}], "]"}]}]}]}], "]"}]}]}], 
        "|>"}], ",", "\[IndentingNewLine]", "    ", "\"\<DissipativeWave\>\"",
        ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<OperatorType\>\"", "->", "ptype"}], ",", 
         RowBox[{"\"\<Operator\>\"", "->", 
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"u", ",", "vars"}], "}"}], ",", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"u", " ", "@@", " ", "vars"}], ",", 
               RowBox[{"{", 
                RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "+", 
             RowBox[{"2", " ", "damping", " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"u", " ", "@@", " ", "vars"}], ",", "t"}], "]"}]}], "-", 
             RowBox[{"coupling", " ", 
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"D", "[", 
                  RowBox[{
                   RowBox[{"u", " ", "@@", " ", "vars"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"#", ",", "2"}], "}"}]}], "]"}], " ", "&"}], " ", 
                "/@", " ", 
                RowBox[{"Most", "[", "vars", "]"}]}], "]"}]}], "+", 
             RowBox[{"damping", " ", 
              RowBox[{"u", " ", "@@", " ", "vars"}]}]}]}], "]"}]}]}], 
        "|>"}]}], "\[IndentingNewLine]", "  ", "]"}]}], "\[IndentingNewLine]",
     "]"}]}], ";"}]}], "Input",ExpressionUUID->"f8366131-d8d1-a24b-a373-\
52219808f686"],

