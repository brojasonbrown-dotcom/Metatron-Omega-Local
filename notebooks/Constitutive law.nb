Cell[CellGroupData[{

Cell["21. Full single-scale computational bundle", "Section",ExpressionUUID->"150cacd9-323e-6544-891d-22f1312fd55f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "scaleComputationalBundle", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleComputationalBundle", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"truncation_Integer", ":", "6"}], ",", 
     RowBox[{"sigmaValue_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ontology", ",", "euler", ",", "operator", ",", "spectral", ",", 
       "stiffness", ",", "measurement"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"ontology", "=", 
       RowBox[{"fullScaleOntology", "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"euler", "=", 
       RowBox[{"layer1EulerEquations", "[", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"operator", "=", 
       RowBox[{"scalePropagationOperator", "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"spectral", "=", 
       RowBox[{"scaleSpectralData", "[", 
        RowBox[{"n", ",", "truncation", ",", "sigmaValue"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"stiffness", "=", 
       RowBox[{"stiffnessEigenSystemLayer1", "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"measurement", "=", 
       RowBox[{"scaleMeasurementAssociation", "[", 
        RowBox[{"n", ",", "spectral"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<Ontology\>\"", "->", "ontology"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Layer1EulerEquations\>\"", "->", "euler"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<PropagationOperator\>\"", "->", "operator"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SpectralData\>\"", "->", "spectral"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<StiffnessAnalysis\>\"", "->", "stiffness"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Measurement\>\"", "->", "measurement"}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"056e3d67-269a-1b49-9332-\
539abf0166bd"],

