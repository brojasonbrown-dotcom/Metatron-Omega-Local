Cell[CellGroupData[{

Cell["11. Symbol discovery and missing-variable analysis", "Section",ExpressionUUID->"89666d8e-aa48-184e-b8e8-39eae866ded0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "layer1Symbols", ",", "standardModelConstants", ",", 
     "missingVariablesLayer1"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer1Symbols", "[", "expr_", "]"}], ":=", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{"expr", ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"s_Symbol", " ", "/;", " ", 
        RowBox[{
         RowBox[{"Context", "[", "s", "]"}], "=!=", "\"\<System`\>\""}]}], ",",
        "\[IndentingNewLine]", "  ", "Infinity"}], "\[IndentingNewLine]", 
      "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"standardModelConstants", "=", 
    RowBox[{"{", 
     RowBox[{
     "c", ",", "h", ",", "\[HBar]", ",", "G", ",", "kB", ",", "e", ",", "me", 
      ",", "mp"}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"missingVariablesLayer1", "[", "expr_", "]"}], ":=", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"layer1Symbols", "[", "expr", "]"}], ",", 
     "standardModelConstants"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"43ec61ef-d93e-2640-9c23-01624d22210b"],

