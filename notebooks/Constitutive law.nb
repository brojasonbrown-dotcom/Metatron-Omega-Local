Cell[CellGroupData[{

Cell["2. Full scale index registry", "Section",ExpressionUUID->"f84de222-7189-4c49-aee2-5c6261f0bb71"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "fullScaleRegistry", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fullScaleRegistry", "[", 
    RowBox[{
     RowBox[{"divisor_", ":", "13"}], ",", 
     RowBox[{"tolerance_", ":", "0.01"}]}], "]"}], ":=", 
   RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"scaleAssociationExact", "[", 
       RowBox[{"#", ",", "divisor"}], "]"}], " ", "&"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "maxScaleCount"}], "]"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"44fb8b9d-69f4-7542-bc0d-\
90f407618349"],

