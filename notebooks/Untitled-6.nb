           RowBox[{
            RowBox[{"psi", "[", 
             RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}]}], "+", 
         RowBox[{"gCoupling", " ", 
          RowBox[{"psi", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "+", "iCoupling"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{"Abs", "[", "pdeExpr", "]"}], "^", "2"}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"xDomain", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"xDomain", "[", 
