  "cc1c6056-203d-2044-903a-a6b59ac0d7db"]], \
"InlineCode",ExpressionUUID->"143a919d-3166-654a-b15b-4cb7dd2fa4ce"]], "Item",\
ExpressionUUID->"e89ceed5-70a7-714b-a84b-f80bbece9437"],

Cell[TextData[Cell[BoxData[Cell["findMostStableWaveform[n, ...]",
  Background->None,ExpressionUUID->
  "de3d9d2e-d2e9-9045-b69b-277389bd8a3e"]], \
"InlineCode",ExpressionUUID->"85f3e9d6-6426-6449-ae74-a2a32f2b0048"]], "Item",\
