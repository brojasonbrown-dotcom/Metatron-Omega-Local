  Background->None,ExpressionUUID->
  "7759dce6-e35a-f347-99f5-6dcfb1406b86"]], \
"InlineCode",ExpressionUUID->"c5812fd8-258a-ba47-9829-778b74468040"]], "Item",\
ExpressionUUID->"3d04066b-0a53-0e4c-a747-053b6c85c911"],

