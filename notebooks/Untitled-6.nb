Cell["Generate all reports: ", "CodeText",ExpressionUUID->"24517637-6d89-3048-9afe-ed2037595060"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reports", "=", 
   RowBox[{"allScaleReports", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Epsilon\>\"", "->", "0.001"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<Rho0\>\"", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Mass\>\"", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<HBar\>\"", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<LightSpeed\>\"", "->", "1"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<StabilityThreshold\>\"", "->", "0.99"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<WaveSpeedUpperBound\>\"", "->", 
      RowBox[{"10", "^", "12"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<WorkingPrecision\>\"", "->", "50"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",ExpressionUUID->"98c21f2b-\
21b7-0d4c-9d7e-bf3feafaf92c"],

Cell["Export safely: ", "CodeText",ExpressionUUID->"d9002a48-233c-f84a-822f-ae7167383baa"],

Cell[BoxData[
 RowBox[{"exportRHUFTJSON", "[", 
  RowBox[{
   RowBox[{"Normal", "@", 
    RowBox[{"scaleSummaryDataset", "[", "]"}]}], 
   ",", "\"\<rhuft-scale-summary.json\>\""}], "]"}]], "Input",ExpressionUUID->\
"7d0fc769-884c-cb42-b46b-4d564d531d23"],

Cell["Export all reports: ", "CodeText",ExpressionUUID->"34838125-3e98-2848-8cfb-b19dd14c37dc"],

Cell[BoxData[
 RowBox[{"exportRHUFTWXF", "[", 
  RowBox[{"reports", ",", "\"\<rhuft-all-scale-reports.wxf\>\""}], 
  "]"}]], "Input",ExpressionUUID->"8847769d-776b-cc44-8b2b-b71abfd36767"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12. Functional entry points", "Section",ExpressionUUID->"47e4e8e4-e590-3949-a50e-5d2147e2b400"],

Cell["These are the main callable functions in the framework: ", "Text",ExpressionUUID->"a46f462f-81c9-b14d-ab30-8825daa49fd7"],

Cell[TextData[Cell[BoxData[Cell["scaleAssociation[n, ...]",
  Background->None,ExpressionUUID->
  "f3ed0ae3-2758-7548-8aed-50699d91de19"]], \
"InlineCode",ExpressionUUID->"717abb40-7ac1-124e-a3b1-4f73f0eb1939"]], "Item",\
ExpressionUUID->"b5c8ef47-5ff7-5b44-bf48-806ead9e20a8"],

