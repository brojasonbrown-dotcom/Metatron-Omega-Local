Notebook[{

Cell[CellGroupData[{
Cell["Full RHUFT Scale Evaluation Framework", "Title",ExpressionUUID->"f097fc1e-f443-da4c-b081-b31a556c2724"],

Cell["\<\
Below is a refined, testable Wolfram Language notebook-style framework that: \
\>", "Text",ExpressionUUID->"fba85e5a-d6fa-b14e-be46-c025a457a2e1"],

Cell["evaluates each scale individually", "Item",ExpressionUUID->"f61c056c-dc95-9846-9409-745d10b06183"],

Cell["provides rigorous per-scale diagnostics", "Item",ExpressionUUID->"1eecd163-6bca-b948-8626-8583b6013266"],

Cell["adds waveform search and stability optimization tools", "Item",ExpressionUUID->"e188ad7e-d741-124c-9d65-e74504388b14"],

Cell["avoids the unsaved-notebook export issue", "Item",ExpressionUUID->"5d4381bb-99af-7c4e-9282-92f8f82e45ad"],

Cell["keeps the code modular and directly executable", "Item",ExpressionUUID->"642e210e-dd71-274f-bf6a-a127adabf967"],

Cell[CellGroupData[{

Cell["Design notes", "Section",ExpressionUUID->"9addec1b-989f-0146-87c7-d7e422396287"],

Cell["A few corrections were needed for rigor and validity: ", "Text",ExpressionUUID->"d8a4228c-7cba-8d47-ab2c-1a44590fa936"],

Cell[TextData[{
 "Your original ",
 Cell[BoxData[Cell["testResultGrid",
   Background->None,ExpressionUUID->"eb0d0769-edea-0444-9245-aab9ec6c20ac"]], 
  "InlineCode",ExpressionUUID->"cfb4d909-be40-f44b-975a-bfdb190298cf"],
 " background rule does not color rows by pass/fail correctly."
}], "Item",ExpressionUUID->"3c52b6c1-3761-2a46-8cb0-abab4276ba57"],

Cell[TextData[{
 Cell[BoxData[Cell["runScaleTests",
   Background->None,ExpressionUUID->"501f91cd-0f4e-da4e-9048-67a7a157bfed"]], 
  "InlineCode",ExpressionUUID->"62179b33-9993-bb40-97fc-8de9202eb468"],
 " looked at ",
 Cell[BoxData[Cell["n-1",
   Background->None,ExpressionUUID->"4d3f9a51-53e3-3540-a196-ab7223cc6549"]], 
  "InlineCode",ExpressionUUID->"31fd4df0-c369-d44d-81b4-a48cb623873a"],
 " and ",
 Cell[BoxData[Cell["n+1",
   Background->None,ExpressionUUID->"0fa67162-5723-f44b-8087-086d77891b0d"]], 
  "InlineCode",ExpressionUUID->"e6c31fe6-f1ee-7447-bf1a-aa6cc19cf2e7"],
 ", but your stable scales are not consecutive, so those neighbors were \
almost always absent."
}], "Item",ExpressionUUID->"a5db186f-5bfb-9843-adff-33cf054a12de"],

Cell[TextData[{
 Cell[BoxData[Cell["WaveSpeedRatio",
   Background->None,ExpressionUUID->"33d4d2b3-d3c9-9d4e-acb6-bf5ce775df2f"]], 
  "InlineCode",ExpressionUUID->"84da76ea-d175-c048-b972-5174910e3de8"],
 " in your code ignored the user-supplied light-speed normalization in the \
displayed plots."
}], "Item",ExpressionUUID->"47752809-a682-d441-8231-ea56d7ff8cea"],

Cell[TextData[{
 "Infinite working precision is not generally realizable for numerical \
procedures in the Wolfram Language; the practical rigorous replacement is to \
use exact arithmetic where possible, and configurable arbitrarily high ",
 ButtonBox["WorkingPrecision",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/WorkingPrecision"],
 " for numerical tasks."
}], "Item",ExpressionUUID->"7ee612b3-cb1c-284f-a99f-3a705f83dd76"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Export", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", "..."}], "}"}], "]"}], 
   "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "112c3eab-e30f-eb45-9250-ee1629c91165"],
 " fails for unsaved notebooks. A robust export helper should fall back to ",
 ButtonBox["$HomeDirectory",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/$HomeDirectory"],
 " or use ",
 ButtonBox["SystemDialogInput",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SystemDialogInput"],
 "."
}], "Item",ExpressionUUID->"103582f6-ffb7-584c-9717-7614e66de41d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Initialization and constants", "Section",ExpressionUUID->"516795fa-d869-4744-9d3e-97f7e2091249"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "goldenRatio", ",", "stableScales", ",", "planckLength", ",", 
     "planckTime", ",", "lightSpeedSI"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stableScales", "=", 
    RowBox[{"{", 
     RowBox[{
     "0", ",", "13", ",", "20", ",", "40", ",", "60", ",", "80", ",", "100", ",",
       "120", ",", "140", ",", "160", ",", "180", ",", "186", ",", "200", ",",
       "220", ",", "240", ",", "260", ",", "280", ",", "292"}], "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"goldenRatio", "=", 
   RowBox[{"N", "[", 
    RowBox[{"GoldenRatio", ",", "100"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"planckLength", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{
     RowBox[{"1.616255", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "35"}]}]}], ",", "\"\<Meters\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"planckTime", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{
     RowBox[{"5.391247", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "44"}]}]}], ",", "\"\<Seconds\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lightSpeedSI", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"299792458", ",", 
     RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"9de0817e-d8bf-cf43-abf8-6415ffb16a31"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Realm labels", "Section",ExpressionUUID->"53fe5def-1219-5d48-b8e2-1643d3002307"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "realmName", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"realmName", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"0", "->", "\"\<Planck Foam\>\""}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"13", "->", "\"\<Quark Core\>\""}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"20", "->", "\"\<QGP\>\""}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"40", "->", "\"\<Muon/Pion\>\""}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"60", "->", "\"\<Proton/Neutron\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"80", "->", "\"\<Atom Core\>\""}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"100", "->", "\"\<Bohr Atom\>\""}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"120", "->", "\"\<Molecule\>\""}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"140", "->", "\"\<DNA\>\""}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"160", "->", "\"\<Organelle\>\""}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"180", "->", "\"\<Cell\>\""}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"186", "->", "\"\<Neural\>\""}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"200", "->", "\"\<Human\>\""}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"220", "->", "\"\<Planetary\>\""}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"240", "->", "\"\<Solar System\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"260", "->", "\"\<Galactic\>\""}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"280", "->", "\"\<Galaxy Cluster\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"292", "->", "\"\<Observable Universe\>\""}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"450f6e8a-e602-de41-a8c5-53377075ddc4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Core RHUFT parameterization", "Section",ExpressionUUID->"b515ae49-6098-c049-8a1e-b61f04a90298"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "kappaConst", ",", "lambdaConst", ",", "\[IndentingNewLine]", "  ", 
     "lengthScale", ",", "timeQuantum", ",", "spatialResolution", ",", 
     "\[IndentingNewLine]", "  ", "complexityMeasure", ",", 
     "informationDensityRatio", ",", "\[IndentingNewLine]", "  ", 
     "stabilityResidual", ",", "stabilityScore", ",", "windingNumber", ",", 
     "\[IndentingNewLine]", "  ", "infoCoupling", ",", "gradientCoupling", ",",
      "waveSpeedRatio", ",", "\[IndentingNewLine]", "  ", 
     "nearestStableNeighbors", ",", "scaleAssociation"}], 
    "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kappaConst", "=", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"goldenRatio", " ", "Pi"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaConst", "=", 
    RowBox[{"1", "/", 
     RowBox[{"goldenRatio", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"lengthScale", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"planckLength", "*", 
     RowBox[{"goldenRatio", "^", "n"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"timeQuantum", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"epsilon_", ":", " ", "0"}]}], "]"}], ":=", 
    RowBox[{"planckTime", "*", 
     RowBox[{"goldenRatio", "^", "n"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"epsilon", " ", "n"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"spatialResolution", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"planckLength", "*", 
     RowBox[{"goldenRatio", "^", 
      RowBox[{"-", "n"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"complexityMeasure", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"3", " ", "n", " ", 
     RowBox[{"Log", "[", "goldenRatio", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"informationDensityRatio", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"goldenRatio", "^", 
     RowBox[{"-", "n"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stabilityResidual", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", "=", 
        RowBox[{
         RowBox[{"goldenRatio", "^", "n"}], "/", "13"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"x", "-", 
         RowBox[{"Round", "[", "x", "]"}]}], "]"}], "/", "x"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stabilityScore", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{"stabilityResidual", "[", "n", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"windingNumber", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"goldenRatio", "^", "n"}], "/", "13"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"infoCoupling", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"hbar_", ":", " ", "1"}], ",", 
      RowBox[{"c_", ":", " ", "1"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"hbar", "/", 
       RowBox[{"c", "^", "2"}]}], ")"}], " ", 
     RowBox[{"goldenRatio", "^", 
      RowBox[{"-", "n"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gradientCoupling", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"mass_", ":", " ", "1"}], ",", 
      RowBox[{"hbar_", ":", " ", "1"}], ",", 
      RowBox[{"c_", ":", " ", "1"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"hbar", "/", 
       RowBox[{"(", 
        RowBox[{"mass", " ", 
         RowBox[{"c", "^", "2"}]}], ")"}]}], ")"}], " ", 
     RowBox[{"goldenRatio", "^", 
      RowBox[{"-", "n"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"waveSpeedRatio", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"epsilon_", ":", " ", "0"}], ",", 
      RowBox[{"rho0_", ":", " ", "1"}], ",", 
      RowBox[{"kappa_", ":", " ", "kappaConst"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rho", ",", "tau"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"rho", "=", 
        RowBox[{"rho0", " ", 
         RowBox[{"informationDensityRatio", "[", "n", "]"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"tau", "=", 
        RowBox[{
         RowBox[{"goldenRatio", "^", "n"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"epsilon", " ", "n"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"rho", " ", "kappa"}], "]"}], " ", "tau"}], ")"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"nearestStableNeighbors", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "pos", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"pos", "=", 
        RowBox[{"FirstPosition", "[", 
         RowBox[{"stableScales", ",", "n", ",", 
          RowBox[{"Missing", "[", "\"\<NotStableScale\>\"", "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MissingQ", "[", "pos", "]"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Previous\>\"", "->", 
            RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], ",", 
           RowBox[{"\"\<Next\>\"", "->", 
            RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}]}], "|>"}],
          ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Previous\>\"", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"pos", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ">", "1"}], ",", 
              RowBox[{"stableScales", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"pos", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], "]"}], "]"}], ",", 
              RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
             "]"}]}], ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Next\>\"", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"pos", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "<", 
               RowBox[{"Length", "[", "stableScales", "]"}]}], ",", 
              RowBox[{"stableScales", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"pos", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], "]"}], "]"}], ",", 
              RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
             "]"}]}]}], "\[IndentingNewLine]", "    ", "|>"}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "scaleAssociation", "]"}], "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Epsilon\>\"", "->", "0"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<Rho0\>\"", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Mass\>\"", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<HBar\>\"", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<LightSpeed\>\"", "->", "1"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<StabilityThreshold\>\"", "->", "0.99"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleAssociation", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"opts", " ", ":", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"epsilon", "=", 
        RowBox[{"OptionValue", "[", "\"\<Epsilon\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"rho0", "=", 
        RowBox[{"OptionValue", "[", "\"\<Rho0\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"mass", "=", 
        RowBox[{"OptionValue", "[", "\"\<Mass\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"hbar", "=", 
        RowBox[{"OptionValue", "[", "\"\<HBar\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"c", "=", 
        RowBox[{"OptionValue", "[", "\"\<LightSpeed\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"threshold", "=", 
        RowBox[{"OptionValue", "[", "\"\<StabilityThreshold\>\"", "]"}]}], ",",
        "\[IndentingNewLine]", "    ", "score", ",", "neighbors"}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"score", "=", 
       RowBox[{"stabilityScore", "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"neighbors", "=", 
       RowBox[{"nearestStableNeighbors", "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Scale\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Realm\>\"", "->", 
         RowBox[{"Lookup", "[", 
          RowBox[{"realmName", ",", "n", ",", "\"\<Unknown\>\""}], "]"}]}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<LengthScale\>\"", "->", 
         RowBox[{"lengthScale", "[", "n", "]"}]}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<TimeQuantum\>\"", "->", 
         RowBox[{"timeQuantum", "[", 
          RowBox[{"n", ",", "epsilon"}], "]"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<SpatialResolution\>\"", "->", 
         RowBox[{"spatialResolution", "[", "n", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Complexity\>\"", "->", 
         RowBox[{"complexityMeasure", "[", "n", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<InformationDensityRatio\>\"", "->", 
         RowBox[{"informationDensityRatio", "[", "n", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<WaveSpeedRatio\>\"", "->", 
         RowBox[{"waveSpeedRatio", "[", 
          RowBox[{"n", ",", "epsilon", ",", "rho0"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<InfoCoupling\>\"", "->", 
         RowBox[{"infoCoupling", "[", 
          RowBox[{"n", ",", "hbar", ",", "c"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<GradientCoupling\>\"", "->", 
         RowBox[{"gradientCoupling", "[", 
          RowBox[{"n", ",", "mass", ",", "hbar", ",", "c"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Kappa\>\"", "->", "kappaConst"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Lambda\>\"", "->", "lambdaConst"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<StabilityResidual\>\"", "->", 
         RowBox[{"stabilityResidual", "[", "n", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<StabilityScore\>\"", "->", "score"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<WindingNumber\>\"", "->", 
         RowBox[{"windingNumber", "[", "n", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<StableQ\>\"", "->", 
         RowBox[{"score", ">=", "threshold"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<PreviousStableScale\>\"", "->", 
         RowBox[{"neighbors", "[", "\"\<Previous\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<NextStableScale\>\"", "->", 
         RowBox[{"neighbors", "[", "\"\<Next\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"e018a5fa-17df-e14a-86a1-\
5e86a187eac1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Per-scale rigorous test suite", "Section",ExpressionUUID->"361f8ff7-e74e-a14b-9130-f7358e25dc07"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "scaleNeighborComparisons", ",", "runScaleTests", ",", 
     "summarizePassRate"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleNeighborComparisons", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"opts", " ", ":", " ", 
       RowBox[{"OptionsPattern", "[", "scaleAssociation", "]"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"prevNext", "=", 
         RowBox[{"nearestStableNeighbors", "[", "n", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", "current", ",", "prev", ",", "next"}], 
       "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"current", "=", 
        RowBox[{"scaleAssociation", "[", 
         RowBox[{"n", ",", "opts"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"prev", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"IntegerQ", "[", 
           RowBox[{"prevNext", "[", "\"\<Previous\>\"", "]"}], "]"}], ",", 
          RowBox[{"scaleAssociation", "[", 
           RowBox[{
            RowBox[{"prevNext", "[", "\"\<Previous\>\"", "]"}], ",", "opts"}],
            "]"}], ",", 
          RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"next", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"IntegerQ", "[", 
           RowBox[{"prevNext", "[", "\"\<Next\>\"", "]"}], "]"}], ",", 
          RowBox[{"scaleAssociation", "[", 
           RowBox[{
            RowBox[{"prevNext", "[", "\"\<Next\>\"", "]"}], ",", "opts"}], 
           "]"}], ",", 
          RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Current\>\"", "->", "current"}], ",", 
         RowBox[{"\"\<Previous\>\"", "->", "prev"}], ",", 
         RowBox[{"\"\<Next\>\"", "->", "next"}]}], "|>"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "runScaleTests", "]"}], "=", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Options", "[", "scaleAssociation", "]"}], ",", 
      RowBox[{"{", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"\"\<WaveSpeedUpperBound\>\"", "->", "Infinity"}], ",", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"\"\<WorkingPrecision\>\"", "->", "80"}]}], 
       "\[IndentingNewLine]", "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runScaleTests", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"opts", " ", ":", " ", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{"assoc", ",", "comps", ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"threshold", "=", 
         RowBox[{"OptionValue", "[", "\"\<StabilityThreshold\>\"", "]"}]}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{"waveUpper", "=", 
         RowBox[{"OptionValue", "[", "\"\<WaveSpeedUpperBound\>\"", "]"}]}], ",",
         "\[IndentingNewLine]", "    ", "prev", ",", "next"}], 
       "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"assoc", "=", 
        RowBox[{"scaleAssociation", "[", 
         RowBox[{"n", ",", 
          RowBox[{"FilterRules", "[", 
           RowBox[{
            RowBox[{"{", "opts", "}"}], ",", 
            RowBox[{"Options", "[", "scaleAssociation", "]"}]}], "]"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"comps", "=", 
        RowBox[{"scaleNeighborComparisons", "[", 
         RowBox[{"n", ",", 
          RowBox[{"FilterRules", "[", 
           RowBox[{
            RowBox[{"{", "opts", "}"}], ",", 
            RowBox[{"Options", "[", "scaleAssociation", "]"}]}], "]"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"prev", "=", 
        RowBox[{"comps", "[", "\"\<Previous\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"next", "=", 
        RowBox[{"comps", "[", "\"\<Next\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<StableScaleMembershipTest\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", "n"}], ",", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{"MemberQ", "[", 
              RowBox[{"stableScales", ",", "n"}], "]"}]}]}], "|>"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityThresholdTest\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"assoc", "[", "\"\<StabilityScore\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Threshold\>\"", "->", "threshold"}], ",", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{
              RowBox[{"assoc", "[", "\"\<StabilityScore\>\"", "]"}], ">=", 
              "threshold"}]}]}], "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<ResidualBoundTest\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"assoc", "[", "\"\<StabilityResidual\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Threshold\>\"", "->", 
             RowBox[{"1", "-", "threshold"}]}], ",", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{
              RowBox[{"assoc", "[", "\"\<StabilityResidual\>\"", "]"}], "<=", 
              RowBox[{"1", "-", "threshold"}]}]}]}], "|>"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<PositiveLengthTest\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"UnitConvert", "[", 
              RowBox[{
               RowBox[{"assoc", "[", "\"\<LengthScale\>\"", "]"}], 
               ",", "\"\<Meters\>\""}], "]"}]}], ",", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{
              RowBox[{"QuantityMagnitude", "@", 
               RowBox[{"UnitConvert", "[", 
                RowBox[{
                 RowBox[{"assoc", "[", "\"\<LengthScale\>\"", "]"}], 
                 ",", "\"\<Meters\>\""}], "]"}]}], ">", "0"}]}]}], "|>"}]}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<PositiveTimeTest\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"UnitConvert", "[", 
              RowBox[{
               RowBox[{"assoc", "[", "\"\<TimeQuantum\>\"", "]"}], 
               ",", "\"\<Seconds\>\""}], "]"}]}], ",", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{
              RowBox[{"QuantityMagnitude", "@", 
               RowBox[{"UnitConvert", "[", 
                RowBox[{
                 RowBox[{"assoc", "[", "\"\<TimeQuantum\>\"", "]"}], 
                 ",", "\"\<Seconds\>\""}], "]"}]}], ">", "0"}]}]}], "|>"}]}], 
         ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<PositiveResolutionTest\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"UnitConvert", "[", 
              RowBox[{
               RowBox[{"assoc", "[", "\"\<SpatialResolution\>\"", "]"}], 
               ",", "\"\<Meters\>\""}], "]"}]}], ",", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{
              RowBox[{"QuantityMagnitude", "@", 
               RowBox[{"UnitConvert", "[", 
                RowBox[{
                 RowBox[{"assoc", "[", "\"\<SpatialResolution\>\"", "]"}], 
                 ",", "\"\<Meters\>\""}], "]"}]}], ">", "0"}]}]}], "|>"}]}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<ComplexityNonnegativeTest\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"assoc", "[", "\"\<Complexity\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{
              RowBox[{"assoc", "[", "\"\<Complexity\>\"", "]"}], ">=", 
              "0"}]}]}], "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<DensityDecayRangeTest\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"assoc", "[", "\"\<InformationDensityRatio\>\"", "]"}]}],
             ",", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{"0", "<", 
              RowBox[{"assoc", "[", "\"\<InformationDensityRatio\>\"", "]"}], 
              "<=", "1"}]}]}], "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<WindingIntegralityTest\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"assoc", "[", "\"\<WindingNumber\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{"IntegerQ", "[", 
              RowBox[{"assoc", "[", "\"\<WindingNumber\>\"", "]"}], "]"}]}]}],
            "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<FiniteWaveSpeedTest\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"assoc", "[", "\"\<WaveSpeedRatio\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{
              RowBox[{"NumericQ", "[", 
               RowBox[{"assoc", "[", "\"\<WaveSpeedRatio\>\"", "]"}], "]"}], "&&", 
              RowBox[{"TrueQ", "[", 
               RowBox[{"0", "<", 
                RowBox[{"assoc", "[", "\"\<WaveSpeedRatio\>\"", "]"}], "<", 
                "waveUpper"}], "]"}]}]}]}], "|>"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<LengthResolutionDualityTest\>\"", "->", 
          RowBox[{"<|", "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"UnitSimplify", "[", 
              RowBox[{
               RowBox[{"assoc", "[", "\"\<LengthScale\>\"", "]"}], " ", 
               RowBox[{"assoc", "[", "\"\<SpatialResolution\>\"", "]"}]}], 
              "]"}]}], ",", "\[IndentingNewLine]", "      ", 
            RowBox[{"\"\<Reference\>\"", "->", 
             RowBox[{"UnitSimplify", "[", 
              RowBox[{"planckLength", "^", "2"}], "]"}]}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{"TrueQ", "[", 
              RowBox[{"UnitSimplify", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"assoc", "[", "\"\<LengthScale\>\"", "]"}], " ", 
                 RowBox[{"assoc", "[", "\"\<SpatialResolution\>\"", "]"}]}], "==", 
                RowBox[{"planckLength", "^", "2"}]}], "]"}], "]"}]}]}], 
           "\[IndentingNewLine]", "    ", "|>"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<PreviousComplexityMonotonicityTest\>\"", "->", 
          RowBox[{"<|", "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"AssociationQ", "[", "prev", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"prev", "[", "\"\<Complexity\>\"", "]"}], ",", 
                 RowBox[{"assoc", "[", "\"\<Complexity\>\"", "]"}]}], "}"}], ",", 
               RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
              "]"}]}], ",", "\[IndentingNewLine]", "      ", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"AssociationQ", "[", "prev", "]"}], ",", 
               RowBox[{
                RowBox[{"assoc", "[", "\"\<Complexity\>\"", "]"}], ">=", 
                RowBox[{"prev", "[", "\"\<Complexity\>\"", "]"}]}], ",", 
               "True"}], "]"}]}]}], "\[IndentingNewLine]", "    ", "|>"}]}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<NextDensityMonotonicityTest\>\"", "->", 
          RowBox[{"<|", "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{"\"\<Value\>\"", "->", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"AssociationQ", "[", "next", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                 "assoc", "[", "\"\<InformationDensityRatio\>\"", "]"}], ",", 
                 RowBox[{
                 "next", "[", "\"\<InformationDensityRatio\>\"", "]"}]}], 
                "}"}], ",", 
               RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], 
              "]"}]}], ",", "\[IndentingNewLine]", "      ", 
            RowBox[{"\"\<Pass\>\"", "->", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"AssociationQ", "[", "next", "]"}], ",", 
               RowBox[{
                RowBox[{
                "assoc", "[", "\"\<InformationDensityRatio\>\"", "]"}], ">=", 
                RowBox[{
                "next", "[", "\"\<InformationDensityRatio\>\"", "]"}]}], ",", 
               "True"}], "]"}]}]}], "\[IndentingNewLine]", "    ", "|>"}]}]}],
         "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"summarizePassRate", "[", "testAssoc_Association", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "passes", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"passes", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{
         RowBox[{"Values", "[", "testAssoc", "]"}], ",", "\"\<Pass\>\""}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<PassCount\>\"", "->", 
         RowBox[{"Count", "[", 
          RowBox[{"passes", ",", "True"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<FailCount\>\"", "->", 
         RowBox[{"Count", "[", 
          RowBox[{"passes", ",", "False"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<PassFraction\>\"", "->", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Count", "[", 
             RowBox[{"passes", ",", "True"}], "]"}], "/", 
            RowBox[{"Length", "[", "passes", "]"}]}], ",", "20"}], "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"7cd8c25e-912d-c442-a0b3-\
4ced13a80b78"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Waveform family, PDE residual proxy, and stability search", "Section",ExpressionUUID->"db6eb1a4-c0ad-0d4d-abca-672c495716e9"],

Cell["\<\
This section adds automatic search for \"most stable waveforms\" in a \
testable way. Since the full integro-differential equation is symbolic and \
not fully specified numerically, the practical rigorous approach is: \
\>", "Text",ExpressionUUID->"9858ca86-d648-5d41-8aa1-4f99c8c0d0aa"],

Cell["define a parameterized waveform family", "Item",ExpressionUUID->"c835e29b-77cb-fd46-a827-57fa1cf685d6"],

Cell["define a residual-like stability functional", "Item",ExpressionUUID->"d32c0c00-2985-fe43-bdbf-2ef2c4e0f3b6"],

Cell[CellGroupData[{

Cell["optimize it over waveform parameters for each scale", "Item",ExpressionUUID->"41451229-7f0e-784f-af12-4af0e40d3a98"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "waveformFunction", ",", "waveformParameterAssociation", ",", 
     "\[IndentingNewLine]", "  ", "waveformResidualFunctional", ",", 
     "waveformObjective", ",", "\[IndentingNewLine]", "  ", 
     "findMostStableWaveform", ",", "batchFindMostStableWaveforms"}], 
    "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"waveformFunction", "[", 
      RowBox[{"n_Integer", ",", "params_Association"}], "]"}], "[", 
     RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"amplitude", "=", 
         RowBox[{"params", "[", "\"\<Amplitude\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"decay", "=", 
         RowBox[{"params", "[", "\"\<Decay\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"omega", "=", 
         RowBox[{"params", "[", "\"\<Omega\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"k", "=", 
         RowBox[{"params", "[", "\"\<WaveNumber\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"phase", "=", 
         RowBox[{"params", "[", "\"\<Phase\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"amplitude", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "decay"}], " ", "t"}], "]"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{
         RowBox[{"k", " ", "x"}], "-", 
         RowBox[{"omega", " ", "t"}], "+", "phase"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"waveformParameterAssociation", "[", 
     RowBox[{"{", 
      RowBox[{
      "amplitude_", ",", "decay_", ",", "omega_", ",", "waveNumber_", ",", 
       "phase_"}], "}"}], "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Amplitude\>\"", "->", "amplitude"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Decay\>\"", "->", "decay"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<Omega\>\"", "->", "omega"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<WaveNumber\>\"", "->", "waveNumber"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Phase\>\"", "->", "phase"}]}], "\[IndentingNewLine]", 
     "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "waveformResidualFunctional", "]"}], "=", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Options", "[", "scaleAssociation", "]"}], ",", 
      RowBox[{"{", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"\"\<XDomain\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"\"\<TDomain\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], ",", "\[IndentingNewLine]", "  ", 
        RowBox[{"\"\<WorkingPrecision\>\"", "->", "80"}]}], 
       "\[IndentingNewLine]", "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"waveformResidualFunctional", "[", 
     RowBox[{"n_Integer", ",", "params_Association", ",", 
      RowBox[{"opts", " ", ":", " ", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"epsilon", "=", 
         RowBox[{"OptionValue", "[", "\"\<Epsilon\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"rho0", "=", 
         RowBox[{"OptionValue", "[", "\"\<Rho0\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"mass", "=", 
         RowBox[{"OptionValue", "[", "\"\<Mass\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"hbar", "=", 
         RowBox[{"OptionValue", "[", "\"\<HBar\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"c", "=", 
         RowBox[{"OptionValue", "[", "\"\<LightSpeed\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"xDomain", "=", 
         RowBox[{"OptionValue", "[", "\"\<XDomain\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"tDomain", "=", 
         RowBox[{"OptionValue", "[", "\"\<TDomain\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"wp", "=", 
         RowBox[{"OptionValue", "[", "\"\<WorkingPrecision\>\"", "]"}]}], ",",
         "\[IndentingNewLine]", "    ", "psi", ",", "waveRatio", ",", 
        "gCoupling", ",", "iCoupling", ",", "pdeExpr"}], 
       "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"psi", "[", 
         RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
        RowBox[{
         RowBox[{"waveformFunction", "[", 
          RowBox[{"n", ",", "params"}], "]"}], "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"waveRatio", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"waveSpeedRatio", "[", 
           RowBox[{"n", ",", "epsilon", ",", "rho0"}], "]"}], ",", "wp"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"gCoupling", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"gradientCoupling", "[", 
           RowBox[{"n", ",", "mass", ",", "hbar", ",", "c"}], "]"}], ",", 
          "wp"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"iCoupling", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"infoCoupling", "[", 
           RowBox[{"n", ",", "hbar", ",", "c"}], "]"}], ",", "wp"}], "]"}]}], 
       ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"pdeExpr", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", 
            RowBox[{"waveRatio", "^", "2"}]}], ")"}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"psi", "[", 
             RowBox[{"x", ",", "t"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "2"}], "}"}]}], "]"}]}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"psi", "[", 
            RowBox[{"x", ",", "t"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "+", 
         RowBox[{
          RowBox[{"params", "[", "\"\<Decay\>\"", "]"}], " ", 
