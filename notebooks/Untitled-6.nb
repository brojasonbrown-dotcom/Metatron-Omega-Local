       ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"passSummary", "=", 
       RowBox[{"summarizePassRate", "[", "tests", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"bestWave", "=", 
       RowBox[{"findMostStableWaveform", "[", 
        RowBox[{"n", ",", 
         RowBox[{"FilterRules", "[", 
          RowBox[{
           RowBox[{"{", "opts", "}"}], ",", 
           RowBox[{"Options", "[", "findMostStableWaveform", "]"}]}], "]"}]}],
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<ScaleData\>\"", "->", "assoc"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Tests\>\"", "->", "tests"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<TestSummary\>\"", "->", "passSummary"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<BestWaveform\>\"", "->", "bestWave"}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"3aebc492-dac2-9847-8d96-\
fb61cf49ebfe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Export helpers that work in unsaved notebooks", "Section",ExpressionUUID->"1246ff53-8596-fc40-a18d-3732926b8507"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "safeExportDirectory", ",", "exportRHUFTJSON", ",", "exportRHUFTWXF"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"safeExportDirectory", "[", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dir", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"NotebookDirectory", "[", "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"StringQ", "[", "dir", "]"}], ",", "dir", ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"StringQ", "[", "$HomeDirectory", "]"}], ",", 
        "$HomeDirectory", ",", "\[IndentingNewLine]", "    ", "True", ",", 
        RowBox[{"Directory", "[", "]"}]}], "\[IndentingNewLine]", "  ", 
       "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exportRHUFTJSON", "[", 
     RowBox[{"data_", ",", 
      RowBox[{"fileName_", ":", " ", "\"\<rhuft-scale-summary.json\>\""}]}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "path", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"path", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"safeExportDirectory", "[", "]"}], ",", "fileName"}], 
          "}"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Export", "[", 
        RowBox[{"path", ",", "data", ",", "\"\<JSON\>\""}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exportRHUFTWXF", "[", 
    RowBox[{"data_", ",", 
     RowBox[{"fileName_", ":", " ", "\"\<rhuft-scale-summary.wxf\>\""}]}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "path", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"path", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"safeExportDirectory", "[", "]"}], ",", "fileName"}], "}"}],
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"Export", "[", 
       RowBox[{"path", ",", "data", ",", "\"\<WXF\>\""}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"ed0ef9f8-ee62-0c49-8b2b-e9b465ca7201"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Button-driven interactive evaluator", "Section",ExpressionUUID->"207c4492-d1a2-014b-9ace-1b1b3cbb2d8f"],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"n", "=", "13"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"epsilon", "=", "0."}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"rho0", "=", "1."}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"mass", "=", "1."}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"hbar", "=", "1."}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"cNorm", "=", "1."}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"stabilityThreshold", "=", "0.99"}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"waveSpeedUpperBound", "=", 
      RowBox[{"10", "^", "12"}]}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"workingPrecision", "=", "50"}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"currentAssoc", "=", 
      RowBox[{"<|", "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"currentTests", "=", 
      RowBox[{"<|", "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"currentReport", "=", 
      RowBox[{"<|", "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"bestWave", "=", 
      RowBox[{"<|", "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"allWaveResults", "=", 
      RowBox[{"<|", "|>"}]}]}], "\[IndentingNewLine]", "  ", "}"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<RHUFT Full Scale Evaluator\>\"", ",", "20", ",", 
         "Bold"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Scale\>\"", ",", 
             RowBox[{"PopupMenu", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "n", "]"}], ",", "stableScales"}], 
              "]"}]}], "}"}], ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Epsilon\>\"", ",", 
             RowBox[{"Slider", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "epsilon", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0.1"}], "}"}]}], "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Rho0\>\"", ",", 
             RowBox[{"InputField", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "rho0", "]"}], ",", "Number"}], 
              "]"}]}], "}"}], ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Mass\>\"", ",", 
             RowBox[{"InputField", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "mass", "]"}], ",", "Number"}], 
              "]"}]}], "}"}], ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<HBar\>\"", ",", 
             RowBox[{"InputField", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "hbar", "]"}], ",", "Number"}], 
              "]"}]}], "}"}], ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<LightSpeedNorm\>\"", ",", 
             RowBox[{"InputField", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "cNorm", "]"}], ",", "Number"}], 
              "]"}]}], "}"}], ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<StabilityThreshold\>\"", ",", 
             RowBox[{"Slider", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "stabilityThreshold", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"0.9", ",", "0.999999"}], "}"}]}], "]"}]}], "}"}], ",",
            "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<WaveSpeedUpperBound\>\"", ",", 
             RowBox[{"InputField", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "waveSpeedUpperBound", "]"}], ",", 
               "Number"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<WorkingPrecision\>\"", ",", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "workingPrecision", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"30", ",", "50", ",", "80", ",", "100"}], "}"}]}], 
              "]"}]}], "}"}]}], "\[IndentingNewLine]", "    ", "}"}], ",", 
         RowBox[{"Alignment", "->", "Left"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"Row", "[", 
        RowBox[{"{", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"Button", "[", 
           
           RowBox[{"\"\<Compute Scale Data\>\"", ",", "\[IndentingNewLine]", 
            "        ", 
            RowBox[{"currentAssoc", "=", 
             RowBox[{
             "scaleAssociation", "[", "\[IndentingNewLine]", "          ", 
              RowBox[{"n", ",", "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Epsilon\>\"", "->", "epsilon"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Rho0\>\"", "->", "rho0"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Mass\>\"", "->", "mass"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<HBar\>\"", "->", "hbar"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<LightSpeed\>\"", "->", "cNorm"}], ",", 
               "\[IndentingNewLine]", "          ", 
               
               RowBox[{"\"\<StabilityThreshold\>\"", "->", 
                "stabilityThreshold"}]}], "\[IndentingNewLine]", "        ", 
              "]"}]}], ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"Method", "->", "\"\<Queued\>\""}]}], 
           "\[IndentingNewLine]", "      ", "]"}], ",", "\[IndentingNewLine]",
           "      ", 
          RowBox[{"Spacer", "[", "10", "]"}], ",", "\[IndentingNewLine]", 
          "      ", 
          RowBox[{"Button", "[", 
           
           RowBox[{"\"\<Run Tests\>\"", ",", "\[IndentingNewLine]", 
            "        ", 
            RowBox[{"currentTests", "=", 
             RowBox[{
             "runScaleTests", "[", "\[IndentingNewLine]", "          ", 
              RowBox[{"n", ",", "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Epsilon\>\"", "->", "epsilon"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Rho0\>\"", "->", "rho0"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Mass\>\"", "->", "mass"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<HBar\>\"", "->", "hbar"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<LightSpeed\>\"", "->", "cNorm"}], ",", 
               "\[IndentingNewLine]", "          ", 
               
               RowBox[{"\"\<StabilityThreshold\>\"", "->", 
                "stabilityThreshold"}], ",", "\[IndentingNewLine]", 
               "          ", 
               
               RowBox[{"\"\<WaveSpeedUpperBound\>\"", "->", 
                "waveSpeedUpperBound"}], ",", "\[IndentingNewLine]", 
               "          ", 
               
               RowBox[{"\"\<WorkingPrecision\>\"", "->", 
                "workingPrecision"}]}], "\[IndentingNewLine]", "        ", 
              "]"}]}], ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"Method", "->", "\"\<Queued\>\""}]}], 
           "\[IndentingNewLine]", "      ", "]"}], ",", "\[IndentingNewLine]",
           "      ", 
          RowBox[{"Spacer", "[", "10", "]"}], ",", "\[IndentingNewLine]", 
          "      ", 
          RowBox[{"Button", "[", 
           
           RowBox[{"\"\<Find Most Stable Waveform\>\"", ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"bestWave", "=", 
             RowBox[{
             "findMostStableWaveform", "[", "\[IndentingNewLine]", 
              "          ", 
              RowBox[{"n", ",", "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Epsilon\>\"", "->", "epsilon"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Rho0\>\"", "->", "rho0"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Mass\>\"", "->", "mass"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<HBar\>\"", "->", "hbar"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<LightSpeed\>\"", "->", "cNorm"}], ",", 
               "\[IndentingNewLine]", "          ", 
               
               RowBox[{"\"\<WorkingPrecision\>\"", "->", 
                "workingPrecision"}]}], "\[IndentingNewLine]", "        ", 
              "]"}]}], ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"Method", "->", "\"\<Queued\>\""}]}], 
           "\[IndentingNewLine]", "      ", "]"}], ",", "\[IndentingNewLine]",
           "      ", 
          RowBox[{"Spacer", "[", "10", "]"}], ",", "\[IndentingNewLine]", 
          "      ", 
          RowBox[{"Button", "[", 
           
           RowBox[{"\"\<Build Full Scale Report\>\"", ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"currentReport", "=", 
             RowBox[{"scaleReport", "[", "\[IndentingNewLine]", "          ", 
              RowBox[{"n", ",", "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Epsilon\>\"", "->", "epsilon"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Rho0\>\"", "->", "rho0"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Mass\>\"", "->", "mass"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<HBar\>\"", "->", "hbar"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<LightSpeed\>\"", "->", "cNorm"}], ",", 
               "\[IndentingNewLine]", "          ", 
               
               RowBox[{"\"\<StabilityThreshold\>\"", "->", 
                "stabilityThreshold"}], ",", "\[IndentingNewLine]", 
               "          ", 
               
               RowBox[{"\"\<WaveSpeedUpperBound\>\"", "->", 
                "waveSpeedUpperBound"}], ",", "\[IndentingNewLine]", 
               "          ", 
               
               RowBox[{"\"\<WorkingPrecision\>\"", "->", 
                "workingPrecision"}]}], "\[IndentingNewLine]", "        ", 
              "]"}]}], ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"Method", "->", "\"\<Queued\>\""}]}], 
           "\[IndentingNewLine]", "      ", "]"}], ",", "\[IndentingNewLine]",
           "      ", 
          RowBox[{"Spacer", "[", "10", "]"}], ",", "\[IndentingNewLine]", 
          "      ", 
          RowBox[{"Button", "[", 
           
           RowBox[{"\"\<Search All Stable Scales\>\"", ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"allWaveResults", "=", 
             RowBox[{
             "batchFindMostStableWaveforms", "[", "\[IndentingNewLine]", 
              "          ", 
              RowBox[{
               RowBox[{"\"\<Epsilon\>\"", "->", "epsilon"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Rho0\>\"", "->", "rho0"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<Mass\>\"", "->", "mass"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<HBar\>\"", "->", "hbar"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"\"\<LightSpeed\>\"", "->", "cNorm"}], ",", 
               "\[IndentingNewLine]", "          ", 
               
               RowBox[{"\"\<WorkingPrecision\>\"", "->", 
                "workingPrecision"}]}], "\[IndentingNewLine]", "        ", 
              "]"}]}], ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"Method", "->", "\"\<Queued\>\""}]}], 
           "\[IndentingNewLine]", "      ", "]"}]}], "\[IndentingNewLine]", 
         "    ", "}"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
       "Delimiter", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Current Scale Data\>\"", ",", "16", ",", "Bold"}], "]"}],
        ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Dynamic", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"currentAssoc", "===", 
           RowBox[{"<|", "|>"}]}], ",", "\"\<No scale data computed yet.\>\"",
           ",", 
          RowBox[{"Dataset", "[", "currentAssoc", "]"}]}], "]"}], "]"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Current Tests\>\"", ",", "16", ",", "Bold"}], "]"}], ",",
        "\[IndentingNewLine]", "    ", 
       RowBox[{"Dynamic", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"currentTests", "===", 
           RowBox[{"<|", "|>"}]}], ",", "\"\<No tests run yet.\>\"", ",", 
          RowBox[{"testResultGrid", "[", "currentTests", "]"}]}], "]"}], 
        "]"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Best Waveform\>\"", ",", "16", ",", "Bold"}], "]"}], ",",
        "\[IndentingNewLine]", "    ", 
       RowBox[{"Dynamic", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"bestWave", "===", 
           RowBox[{"<|", "|>"}]}], ",", "\[IndentingNewLine]", 
          "        ", "\"\<No waveform search run yet.\>\"", ",", 
          "\[IndentingNewLine]", "        ", 
          RowBox[{"Column", "[", 
           RowBox[{"{", "\[IndentingNewLine]", "          ", 
            RowBox[{
             RowBox[{"Dataset", "[", "bestWave", "]"}], ",", 
             "\[IndentingNewLine]", "          ", 
             RowBox[{"waveformPlot", "[", 
              RowBox[{"n", ",", 
               RowBox[{"bestWave", "[", "\"\<BestParameters\>\"", "]"}]}], 
              "]"}]}], "\[IndentingNewLine]", "        ", "}"}], "]"}]}], 
         "\[IndentingNewLine]", "      ", "]"}], "\[IndentingNewLine]", 
        "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Full Scale Report\>\"", ",", "16", ",", "Bold"}], "]"}], 
       ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Dynamic", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"currentReport", "===", 
           RowBox[{"<|", "|>"}]}], ",", "\"\<No full report built yet.\>\"", ",", 
          RowBox[{"Dataset", "[", "currentReport", "]"}]}], "]"}], "]"}], ",",
        "\[IndentingNewLine]", "    ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Global Stability Plot\>\"", ",", "16", ",", "Bold"}], 
        "]"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Dynamic", "[", 
        RowBox[{"stabilityPlot", "[", 
         RowBox[{"\"\<Threshold\>\"", "->", "stabilityThreshold"}], "]"}], 
        "]"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<All-Scale Waveform Search Summary\>\"", ",", "16", ",", 
         "Bold"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Dynamic", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"allWaveResults", "===", 
           RowBox[{"<|", "|>"}]}], ",", "\[IndentingNewLine]", 
          "        ", "\"\<No batch search run yet.\>\"", ",", 
          "\[IndentingNewLine]", "        ", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Dataset", "[", "allWaveResults", "]"}], ",", 
             RowBox[{
             "waveformResidualBarChart", "[", "allWaveResults", "]"}]}], 
            "}"}], "]"}]}], "\[IndentingNewLine]", "      ", "]"}], 
        "\[IndentingNewLine]", "    ", "]"}]}], "\[IndentingNewLine]", "  ", 
      "}"}], ",", 
     RowBox[{"Spacings", "->", "2"}]}], "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"348fc7ce-4deb-ba49-a8af-1017796326e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Build all individual scale reports at once", "Section",ExpressionUUID->"cc121771-4f76-2941-88bf-d17eacb6abac"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "allScaleReports", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "allScaleReports", "]"}], "=", 
    RowBox[{"Options", "[", "scaleReport", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"allScaleReports", "[", 
    RowBox[{"opts", " ", ":", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{"stableScales", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"scaleReport", "[", 
        RowBox[{"#", ",", "opts"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "stableScales"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",Exp\
ressionUUID->"dc6f4249-4d9f-8041-a77b-707c9fe80b02"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Example usage", "Section",ExpressionUUID->"d7b11320-372b-3240-90e6-cc4d5d80746b"],

