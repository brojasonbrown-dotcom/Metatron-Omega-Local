     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "89f42df8-8ab9-a047-a78b-5f6c7080c23e"],
  " = phase/alignment"
 }], "InlineItem",ExpressionUUID->"8f1aeabe-efe2-3b42-834a-5e97e0f2d366"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
