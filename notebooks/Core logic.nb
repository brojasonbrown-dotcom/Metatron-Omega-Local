  "BlockQuote",
  Background->None,ExpressionUUID->"b320fc54-5585-894c-9d86-35046ecda00e"],
 "\nI would define the RHUFT spherical principle as: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "spherical closure", "\[Congruent]", 
         "maximal directional completeness under bounded self-relation"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\text{spherical closure} \\equiv \\text{maximal directional \
completeness under bounded self-relation}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73c3e472-e410-574f-b81a-613bc7f825a8"],
 "\nThis is strong and usable. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
