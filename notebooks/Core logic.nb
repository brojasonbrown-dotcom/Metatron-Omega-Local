        SuperscriptBox[
         StyleBox["d", "TI"], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], TraditionalForm], "errors" -> {}, 
      "input" -> "d^{(n)}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "2913e5e8-92c8-5241-8634-b25c59bcfd82"],
  " = drift"
 }], "InlineItem",ExpressionUUID->"e00eedd8-10ea-b04d-867a-2a9beabfb33b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SuperscriptBox["\[Kappa]", 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], TraditionalForm], "errors" -> {}, 
      "input" -> "\\kappa^{(n)}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "f8a620fb-2c76-214e-a183-473760dd2802"],
  " = closure"
 }], "InlineItem",ExpressionUUID->"f0bdefa8-bfec-794f-ad34-abfc9b38d242"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SuperscriptBox[
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], TraditionalForm], "errors" -> {}, 
      "input" -> "g^{(n)}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "1267b23c-a3cb-f94a-937c-7b0a53407908"],
  " = geometry descriptor"
 }], "InlineItem",ExpressionUUID->"d4bd6803-3f0e-c345-88a2-57f48789691f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SuperscriptBox[
         StyleBox["m", "TI"], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], TraditionalForm], "errors" -> {}, 
      "input" -> "m^{(n)}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "2ec6680f-8bae-744f-ab8f-be5c95e25b81"],
  " = memory state"
 }], "InlineItem",ExpressionUUID->"5930a9f6-0fea-7f41-b0b7-bfd2d883aa11"],
 "\nSo I would say: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox[Cell[TextData[{
       "In RHUFT, a state is a ",
       StyleBox[
       "scale-indexed local realization of informational-geometric \
stabilization",
        FontWeight->Bold],
       ", not just a wave amplitude."
      }],
       Background->None,ExpressionUUID->
       "6139b0be-68e7-be40-bcd9-af39725747f1"],
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic},
      ScrollPosition->{0., 0.}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"d310a45c-91f3-d148-9237-dcbf1cb0d5c7"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
