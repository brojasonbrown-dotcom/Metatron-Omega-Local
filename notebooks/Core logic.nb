Cell[CellGroupData[{

Cell["11. Boundary of validity", "Section",ExpressionUUID->"b5422b7e-3d8a-844e-8e91-6f30f87ce9c6"],

Cell["What can be made rigorous now: ", "Text",ExpressionUUID->"303f2bde-569e-6844-bcc4-a02d89720191"],

Cell["recursive update models", "Item",ExpressionUUID->"f050f339-de13-8947-a4b6-1e1bde3736f9"],

Cell["memory and reflection effects", "Item",ExpressionUUID->"a4e81170-d9da-424f-b8d2-ef97621a3126"],

Cell["multiscale stabilization simulations", "Item",ExpressionUUID->"84fc035c-0203-8341-9742-92292099b11a"],

Cell["geometric scan efficiency tests", "Item",ExpressionUUID->"d848e3ec-657f-5548-83cd-7c751d49c0cd"],

Cell["burden proxies for reconfiguration cost", "Item",ExpressionUUID->"f7a8a857-da26-0540-aefa-ebad11f83f30"],

Cell["closure metrics for subsystem detection", "Item",ExpressionUUID->"281a912c-d97e-f540-93b7-3d5419b225f1"],

Cell["\<\
What cannot yet be rigorously claimed without further specification: \
\>", "Text",ExpressionUUID->"1673816f-cd6f-c646-adb2-e5e932e0eb8d"],

Cell["actual cosmology", "Item",ExpressionUUID->"43f933f2-7fda-5b4d-8486-e93105318f26"],

