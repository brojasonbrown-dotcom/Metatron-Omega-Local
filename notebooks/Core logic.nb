Cell["Need explicit answer: ", "Text",ExpressionUUID->"03d035f7-5a9a-054f-a04a-210c874a2a59"],

Cell[TextData[{
 "What exactly is a state ",
 StyleBox["psi", "TI"],
 "?"
}], "Item",ExpressionUUID->"fd166ec3-5708-eb4c-a3a6-a57171bf5a2f"],

Cell["\<\
Scalar field, vector field, graph state, tensor field, symbolic relation \
network, or mixed multiscale object?\
\>", "Item",ExpressionUUID->"504cbae2-a654-f147-8374-27b6bfddb651"],

Cell["\<\
Is state local in space, abstract in relation-space, or both?\
\>", "Item",ExpressionUUID->"def0e8a5-4476-5c4b-8472-f660512b670c"],

Cell["Without this, equations remain underdetermined. ", "Text",ExpressionUUID->"a7c877a3-5e19-364e-989a-18b5dc0e080b"]
}, Open  ]],

