       RowBox[{
         SubsuperscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["t", "TI"], 
          RowBox[{"(", 
            StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["x", "TI"], "\[Element]", 
            SubscriptBox["\[CapitalOmega]", 
             StyleBox["n", "TI"]]}], LimitsPositioning -> True], 
         SubscriptBox["\[Rho]", 
