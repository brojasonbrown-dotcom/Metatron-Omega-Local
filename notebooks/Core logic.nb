Cell[CellGroupData[{

Cell["7. Wolfram Language-ready formulas", "Section",ExpressionUUID->"ad3c5468-0cd9-8a4a-a4e3-77afa7abae60"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "temporalCoherence", ",", "driftMetric", ",", "memoryStep", ",", 
     "reflectionStep"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"temporalCoherence", "[", 
     RowBox[{"state1_", ",", "state2_"}], "]"}], ":=", "\[IndentingNewLine]", 
    " ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"state1", " ", ".", " ", 
       RowBox[{"Conjugate", "[", "state2", "]"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Norm", "[", "state1", "]"}], " ", 
        RowBox[{"Norm", "[", "state2", "]"}]}], "+", 
       RowBox[{"10", "^", 
        RowBox[{"-", "12"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"driftMetric", "[", 
     RowBox[{"state_", ",", "ideal_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"state", "-", "ideal"}], "]"}], "^", "2"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"memoryStep", "[", 
    RowBox[{
    "state_", ",", "memory_", ",", "input_", ",", "alpha_", ",", "gamma_", ",",
      "delta_", ",", "lambda_"}], "]"}], ":=", "\[IndentingNewLine]", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nextState", ",", "nextMemory"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"nextState", "=", 
       RowBox[{
        RowBox[{"alpha", " ", "state"}], "+", 
        RowBox[{"gamma", " ", "input"}], "+", 
        RowBox[{"delta", " ", "memory"}]}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"nextMemory", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "lambda"}], ")"}], " ", "memory"}], "+", 
        RowBox[{"lambda", " ", "state"}]}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<State\>\"", "->", "nextState"}], ",", 
        RowBox[{"\"\<Memory\>\"", "->", "nextMemory"}]}], "|>"}]}]}], 
    "\[IndentingNewLine]", " ", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reflectionStep", "[", 
   RowBox[{
   "state_", ",", "memory_", ",", "input_", ",", "alpha_", ",", "zeta_", ",", 
    "lambda_"}], "]"}], ":=", "\[IndentingNewLine]", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"predicted", ",", "nextState", ",", "nextMemory"}], "}"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"predicted", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"state", "+", "memory"}], ")"}], "/", "2"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"nextState", "=", 
      RowBox[{
       RowBox[{"alpha", " ", "state"}], "+", 
       RowBox[{"zeta", " ", 
        RowBox[{"(", 
         RowBox[{"predicted", "-", "state"}], ")"}]}], "+", "input"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"nextMemory", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "lambda"}], ")"}], " ", "memory"}], "+", 
       RowBox[{"lambda", " ", "state"}]}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<State\>\"", "->", "nextState"}], ",", 
       RowBox[{"\"\<Memory\>\"", "->", "nextMemory"}], ",", 
       RowBox[{"\"\<Predicted\>\"", "->", "predicted"}]}], "|>"}]}]}], 
   "\[IndentingNewLine]", " ", "]"}]}]}], "Input",ExpressionUUID->"da610591-\
4d38-974d-82ae-8efab344deed"],

