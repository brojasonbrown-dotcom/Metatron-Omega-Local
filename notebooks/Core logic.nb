Cell[CellGroupData[{

Cell["10. Recommended next rigorous steps", "Section",ExpressionUUID->"b2837170-23dc-6f44-b8fb-85658ba02123"],

Cell["1. get your answers to the 12 questions above", "Text",ExpressionUUID->"d3d6d58f-e858-5c4a-8bc2-a49e9435fe24"],

Cell["2. choose one primitive state formalism for simulation", "Text",ExpressionUUID->"85d416d3-7e64-064a-83a3-78ebd6dafdf3"],

Cell["3. implement Tests 1 to 6 with explicit metrics", "Text",ExpressionUUID->"75e6987f-6b8d-ec43-a6c6-70b3a6eee870"],

Cell["\<\
4. compare memory / reflection / multiscale / geometry conditions\
\>", "Text",ExpressionUUID->"855ed2aa-03b0-b044-a99a-114082d644f0"],

Cell["5. only then strengthen the ontology claims ", "Text",ExpressionUUID->"3fc32f6e-a160-d445-bf4c-90d99583f996"],

