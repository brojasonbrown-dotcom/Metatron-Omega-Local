Cell[CellGroupData[{

Cell["4. Candidate master equations", "Section",ExpressionUUID->"57dbff2b-a106-7f45-b92a-d38643d9f705"],

Cell["\<\
These are not yet asserted as final truth. They are the minimum rigorous \
candidate forms that can actually be tested. \
\>", "Text",ExpressionUUID->"2f59f3c5-e30e-cf4f-b94e-d27dc80e5146"],

Cell[CellGroupData[{

Cell["4.1 Local recursive update", "Subsection",ExpressionUUID->"97bb8488-e1c9-b141-afb3-0dc491129639"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox["\[Psi]", 
         RowBox[{
           StyleBox["t", "TI"], "+", "1"}], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["N", "TI"], 
         StyleBox["n", "TI"]], 
        RowBox[{"[", 
          RowBox[{
            SubscriptBox["\[Alpha]", 
             StyleBox["n", "TI"]], 
            SubsuperscriptBox["\[Psi]", 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], "+", 
            SubscriptBox["\[Beta]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["G", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              RowBox[{
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]], ",", 
                SubsuperscriptBox[
                 StyleBox["g", "TI"], 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]]}], "]"}], "+", 
            SubscriptBox["\[Gamma]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["P", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["i", "TI"], 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]], ",", 
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]]}], "]"}], "+", 
            SubscriptBox["\[Delta]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["R", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              RowBox[{
                SubsuperscriptBox[
                 StyleBox["m", "TI"], 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]], ",", 
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]]}], "]"}], "+", 
            SubscriptBox["\[Epsilon]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["C", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              RowBox[{
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]], ",", 
                SubsuperscriptBox[
                 StyleBox["l", "TI"], 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]]}], "]"}], "+", 
            SubscriptBox["\[Zeta]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["S", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              RowBox[{
                SubsuperscriptBox[
                 OverscriptBox["\[Psi]", "^"], 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]], ",", 
                SubsuperscriptBox["\[Psi]", 
                 StyleBox["t", "TI"], 
                 RowBox[{"(", 
                   StyleBox["n", "TI"], ")"}]]}], "]"}], "+", 
            SubscriptBox["\[Eta]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["B", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              SubsuperscriptBox["\[Psi]", 
               StyleBox["t", "TI"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["n", "TI"], "+", "1"}], ")"}]], "]"}], "+", 
            SubscriptBox["\[Mu]", 
             StyleBox["n", "TI"]], 
            SubscriptBox[
             StyleBox["A", "TI"], 
             StyleBox["n", "TI"]], 
            RowBox[{"[", 
              SubsuperscriptBox["\[Psi]", 
               StyleBox["t", "TI"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["n", "TI"], "-", "1"}], ")"}]], "]"}]}], "]"}]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "\\psi_{t+1}^{(n)} = N_n\\Big[\n\\alpha_n \\psi_t^{(n)}\n+ \\beta_n \
G_n[\\psi_t^{(n)}, g_t^{(n)}]\n+ \\gamma_n P_n[i_t^{(n)}, \\psi_t^{(n)}]\n+ \
\\delta_n R_n[m_t^{(n)}, \\psi_t^{(n)}]\n+ \\epsilon_n C_n[\\psi_t^{(n)}, \
l_t^{(n)}]\n+ \\zeta_n S_n[\\hat{\\psi}_t^{(n)}, \\psi_t^{(n)}]\n+ \\eta_n \
B_n[\\psi_t^{(n+1)}]\n+ \\mu_n A_n[\\psi_t^{(n-1)}]\n\\Big]", "state" -> 
    "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"bc8411f8-1fc1-c345-8620-14a98fb97711"]], \
"Text",ExpressionUUID->"3036af57-1a6b-374e-8c69-14e3123d1153"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2 Self-model update", "Subsection",ExpressionUUID->"5cd2859b-2544-274d-b48b-3dff252224f2"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox[
         OverscriptBox["\[Psi]", "^"], 
         RowBox[{
           StyleBox["t", "TI"], "+", "1"}], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["H", "TI"], 
         StyleBox["n", "TI"]], 
        RowBox[{"(", 
          RowBox[{
            SubsuperscriptBox[
             OverscriptBox["\[Psi]", "^"], 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox[
             StyleBox["m", "TI"], 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox["\[Psi]", 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox[
             StyleBox["i", "TI"], 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]]}], ")"}]}], TraditionalForm], 
    "errors" -> {}, "input" -> 
    "\\hat{\\psi}_{t+1}^{(n)} = H_n\\big(\\hat{\\psi}_t^{(n)}, m_t^{(n)}, \
\\psi_t^{(n)}, i_t^{(n)}\\big)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"91c7a464-7b03-9d4f-8a13-8f534d6a7092"]], \
"Text",ExpressionUUID->"02cf8a66-b868-2343-bdc2-98713c8c87d6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3 Memory update", "Subsection",ExpressionUUID->"e001d251-68ff-754d-8d5d-9e4122cd4a52"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox[
         StyleBox["m", "TI"], 
         RowBox[{
           StyleBox["t", "TI"], "+", "1"}], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
        SubscriptBox[
         StyleBox["U", "TI"], 
         StyleBox["n", "TI"]], 
        RowBox[{"(", 
          RowBox[{
            SubsuperscriptBox[
             StyleBox["m", "TI"], 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox["\[Psi]", 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox[
             OverscriptBox["\[Psi]", "^"], 
             StyleBox["t", "TI"], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]], ",", 
            SubsuperscriptBox["\[Psi]", 
             RowBox[{
               StyleBox["t", "TI"], "+", "1"}], 
             RowBox[{"(", 
               StyleBox["n", "TI"], ")"}]]}], ")"}]}], TraditionalForm], 
    "errors" -> {}, "input" -> 
    "m_{t+1}^{(n)} = U_n\\big(m_t^{(n)}, \\psi_t^{(n)}, \\hat{\\psi}_t^{(n)}, \
\\psi_{t+1}^{(n)}\\big)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"59645497-c1b6-814f-8f05-d696bb9580f4"]], \
"Text",ExpressionUUID->"d96b219a-ceff-9e49-a8a5-7da05b13147f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.4 Drift metric", "Subsection",ExpressionUUID->"37adad72-d87d-9f44-9775-d3e0a40bc384"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["t", "TI"], 
          RowBox[{"(", 
            StyleBox["n", "TI"], ")"}]], "\[LongEqual]", "||", 
         SubsuperscriptBox["\[Psi]", 
          StyleBox["t", "TI"], 
          RowBox[{"(", 
            StyleBox["n", "TI"], ")"}]], "-", 
         SubsuperscriptBox["\[Psi]", 
          StyleBox["t", "TI"], 
          RowBox[{"*", "(", 
            StyleBox["n", "TI"], ")"}]], 
         SuperscriptBox["||", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "d_t^{(n)} = \\lVert \\psi_t^{(n)} - \\psi_t^{*(n)} \\rVert^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "93aa8401-1571-9c40-9eec-99386213a06a"],
 "where ",
 Cell[BoxData[Cell["psi*",
   Background->None,ExpressionUUID->"becac095-26a3-4b42-a0f0-0d2876facddf"]], 
  "InlineCode",ExpressionUUID->"d596edc8-ceb1-b644-a00a-bd9c08632473"],
 " is ideal or law-admissible target state. "
}], "Text",ExpressionUUID->"68c0a284-4439-5643-a494-679f31cfc1f4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.5 Temporal coherence", "Subsection",ExpressionUUID->"d3db002e-ce11-474b-aa88-913e131e21fe"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox[
         StyleBox["c", "TI"], 
         StyleBox["time", FontSlant -> "Plain"], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], 
        RowBox[{"(", 
          StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
        FractionBox[
         TemplateBox[{
           RowBox[{
             RowBox[{"\[LeftAngleBracket]", 
               RowBox[{
                 SubsuperscriptBox["\[Psi]", 
                  StyleBox["t", "TI"], 
                  RowBox[{"(", 
                    StyleBox["n", "TI"], ")"}]], ",", 
                 SubsuperscriptBox["\[Psi]", 
                  RowBox[{
                    StyleBox["t", "TI"], "+", "1"}], 
                  RowBox[{"(", 
                    StyleBox["n", "TI"], ")"}]]}], 
               "\[RightAngleBracket]"}]}]}, "Abs"], 
         RowBox[{"||", 
           SubsuperscriptBox["\[Psi]", 
            StyleBox["t", "TI"], 
            RowBox[{"(", 
              StyleBox["n", "TI"], ")"}]], "||||", 
           SubsuperscriptBox["\[Psi]", 
            RowBox[{
              StyleBox["t", "TI"], "+", "1"}], 
            RowBox[{"(", 
              StyleBox["n", "TI"], ")"}]], "||", "+", "\[Epsilon]"}]]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "c_{\\mathrm{time}}^{(n)}(t) =\n\\frac{|\\langle \\psi_t^{(n)}, \
\\psi_{t+1}^{(n)} \\rangle|}\n{\\lVert \\psi_t^{(n)} \\rVert \\lVert \
\\psi_{t+1}^{(n)} \\rVert + \\varepsilon}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"e69da20f-b9ad-2c43-8054-cd1d3b654ff2"]], \
"Text",ExpressionUUID->"59b0eff6-b140-5d47-b3b9-2a0eb51eb211"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.6 Closure score", "Subsection",ExpressionUUID->"8ada479f-c4ea-dd4b-8da9-934e9b895869"],

Cell[TextData[{
 "One candidate dynamical closure proxy: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Kappa]", 
          StyleBox["t", "TI"], 
          RowBox[{"(", 
            StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
         FractionBox["internal recurrent influence", 
          RowBox[{"total influence", "+", "\[Epsilon]"}]]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\kappa_t^{(n)} =\n\\frac{\\text{internal recurrent \
influence}}{\\text{total influence} + \\varepsilon}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d98b861d-b448-e94f-8f4b-d7fedcc7b736"],
 "For network dynamics, this could be: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Kappa]", 
          StyleBox["t", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            UnderscriptBox["\[Sum]", 
             RowBox[{
               StyleBox["i", "TI"], ",", 
               StyleBox["j", "TI"], "\[Element]", "\[CapitalOmega]"}], 
             LimitsPositioning -> True], "|", 
            SubscriptBox[
             StyleBox["w", "TI"], 
             RowBox[{
               StyleBox["i", "TI"], 
               StyleBox["j", "TI"]}]], "|"}], 
          RowBox[{
            UnderscriptBox["\[Sum]", 
             RowBox[{
               StyleBox["i", "TI"], "\[Element]", "\[CapitalOmega]", ",", 
               StyleBox["j", "TI"], "\[Element]", "all"}], LimitsPositioning -> 
             True], "|", 
            SubscriptBox[
             StyleBox["w", "TI"], 
             RowBox[{
               StyleBox["i", "TI"], 
               StyleBox["j", "TI"]}]], "|", "+", "\[Epsilon]"}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\kappa_t =\n\\frac{\\sum_{i,j \\in \\Omega} |w_{ij}|}\n{\\sum_{i \\in \
\\Omega, j \\in \\text{all}} |w_{ij}| + \\varepsilon}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "35fc8cfb-d038-2d4f-8fc7-1db638d96c32"],
 "for subsystem ",
 Cell[BoxData[Cell["Omega",
   Background->None,ExpressionUUID->"6c22486d-2d7a-ec47-bc5b-1f8550785341"]], 
  "InlineCode",ExpressionUUID->"6dfa010a-c2c9-5644-b7cb-a52b5804a0bb"],
 ". "
}], "Text",ExpressionUUID->"bf223e7f-3273-484a-ba25-123e53b64491"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.7 Information density", "Subsection",ExpressionUUID->"ed7c7974-dd9f-644d-881b-7cb8e52d3737"],

Cell[TextData[{
 "A testable composite proxy: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", 
          StyleBox["I", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ";", 
             StyleBox["n", "TI"]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], "1"], 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ";", 
             StyleBox["n", "TI"]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "2"], 
         StyleBox["R", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ";", 
             StyleBox["n", "TI"]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "3"], 
         StyleBox["K", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ";", 
             StyleBox["n", "TI"]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "4"], 
         StyleBox["S", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ";", 
             StyleBox["n", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\rho_I(x;n) = a_1 \\mathcal{H}(x;n) + a_2 \\mathcal{R}(x;n) + a_3 \
\\mathcal{K}(x;n) + a_4 \\mathcal{S}(x;n)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6893436d-4b99-d940-a35f-c9d34b0d8658"],
 "where: "
}], "Text",ExpressionUUID->"d06c50f5-f980-6244-9155-5e6a9198766f"],

Cell[TextData[{
 Cell[BoxData[Cell["H",
   Background->None,ExpressionUUID->"5f8d057f-b51a-a141-bdd5-4f2543b8bdfa"]], 
  "InlineCode",ExpressionUUID->"dd40bfb3-72e4-7b4f-97ac-baa207807413"],
 " = entropy or local state diversity"
}], "Item",ExpressionUUID->"8a400031-3f8b-b747-93da-6bb8cbcc9d49"],

