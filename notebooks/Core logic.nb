  " ",
  "vector field"
 }], "InlineItem",ExpressionUUID->"10e12911-a93e-a246-ad03-31514b220176"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "graph/network state"
 }], "InlineItem",ExpressionUUID->"9b5656e8-e45e-2d47-8451-d444f0bc8a35"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "geometric complex"
 }], "InlineItem",ExpressionUUID->"a802e90c-f098-7647-8455-28861242985d"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "hybrid multiscale association"
 }], "InlineItem",ExpressionUUID->"3d9be492-eb39-8745-b6bd-fe43cdacda19"],
 "\nMy recommendation: use a ",
 StyleBox["hybrid state association",
  FontWeight->Bold],
 " at first.\n\nIn Wolfram Language, something like: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"state", "=", 
          RowBox[{"<|", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"\"InformationDensity\"", "->", "rhoI"}], ",", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"\"Coherence\"", "->", "coherence"}], ",", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"\"Closure\"", "->", "closure"}], ",", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"\"Phase\"", "->", "phase"}], ",", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"\"Geometry\"", "->", "geometry"}], ",", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"\"Memory\"", "->", "memory"}]}], "\[IndentingNewLine]",
             "|>"}]}], ";"}]], "ChatCode", "Input", LanguageCategory -> 
     "Input", ShowAutoStyles -> True, ShowStringCharacters -> True, 
     ShowSyntaxStyles -> True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "b4e5460d-e9a2-1046-900b-7fac47b34820"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"2. Exact stability functional\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"684297b9-ed9b-b243-8c77-4cee0405ddbe"],
 "\nYou need one explicit score: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalSigma]", 
         RowBox[{"[", "\[Psi]", "]"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["w", "TI"], "1"], 
         StyleBox["c", "TI"], "+", 
         SubscriptBox[
          StyleBox["w", "TI"], "2"], "\[Kappa]", "-", 
         SubscriptBox[
          StyleBox["w", "TI"], "3"], 
         StyleBox["d", "TI"], "-", 
         SubscriptBox[
          StyleBox["w", "TI"], "4"], "\[Chi]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Sigma[\\psi] = w_1 c + w_2 \\kappa - w_3 d - w_4 \\chi", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8dffddfa-5d50-4442-befe-e2503d0951c8"],
 "\nwhere: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "6237102d-b95d-b942-92a8-7e04059bd3eb"],
  " = coherence"
 }], "InlineItem",ExpressionUUID->"a5d7b813-96e4-3e42-bf32-205efaf0913c"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Kappa]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\kappa", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "1c693d26-4c56-8042-bdce-d5c4a8097d4d"],
  " = closure"
 }], "InlineItem",ExpressionUUID->"9a5019f6-40ab-074e-8b9b-50d3951f0d30"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["d", "TI"], TraditionalForm], "errors" -> {}, "input" -> "d",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "839cdb03-0d0d-9e43-911d-b3276f316a46"],
  " = drift"
 }], "InlineItem",ExpressionUUID->"22ead5ca-f81b-9641-9b67-4fac26c13806"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Chi]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\chi", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "260ae087-4694-b745-a11e-993ed93518b6"],
  " = dissipation/reconfiguration loss"
 }], "InlineItem",ExpressionUUID->"2f8445a5-69f8-ec4d-9e3f-b036e3ae2192"],
 "\nThen stable iff: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalSigma]", 
         RowBox[{"[", "\[Psi]", "]"}], ">", 
         SubscriptBox["\[CapitalSigma]", 
          StyleBox["crit", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Sigma[\\psi] > \\Sigma_{\\mathrm{crit}}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "75876e2a-cc8a-674b-abea-969c1ec62650"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"3. Exact measurement operator\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}},
   ScrollPosition->{0., 0.}]], "InlineSection",
  Background->None,ExpressionUUID->"ed3ec083-9a1d-8044-9791-60e274ba0450"],
 "\nThis is probably the key operator in RHUFT. It should be defined \
directly, not metaphorically.\n\nA first formal version: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"[", 
           RowBox[{"\[Psi]", ",", 
             StyleBox["m", "TI"], ",", 
             StyleBox["i", "TI"]}], "]"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["U", "TI"], 
          StyleBox["n", "TI"]], "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["m", "TI"], ", ", 
             SubscriptBox[
              StyleBox["Q", "TI"], 
              StyleBox["n", "TI"]], "\[NegativeThinSpace]", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["R", "TI"], 
                  StyleBox["n", "TI"]], "\[NegativeThinSpace]", 
                 RowBox[{"(", 
                   RowBox[{
                    SubscriptBox[
                    StyleBox["P", "TI"], 
                    StyleBox["n", "TI"]], 
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["i", "TI"], ",", "\[Psi]"}], "]"}]}], ")"}], ",",
                  "\[Psi]"}], ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "M_n[\\psi,m,i] = U_n\\!\\left(m,\\; \
Q_n\\!\\left(R_n\\!\\left(P_n[i,\\psi]\\right),\\psi\\right)\\right)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4bde87bd-e43f-fd42-835c-dea7e739898e"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. Exact relation of burden to known mass\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}},
   ScrollPosition->{0., 0.}]], "InlineSection",
  Background->None,ExpressionUUID->"f49c6e5b-332d-8046-a544-53ae5215f20d"],
 "\nIf RHUFT wants physical unification credibility, you eventually need: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["physical", FontSlant -> "Plain"]], "\[LongEqual]", 
         "\[CapitalLambda] ", 
         StyleBox["b", "TI"], "+", "corrections"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "m_{\\mathrm{physical}} = \\Lambda \\, b + \\text{corrections}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b291955d-1986-6e4f-b58e-aef809b4d175"],
 "\nor a reason why standard mass is only an emergent approximation. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"5. Exact empirical predictions\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}},
   ScrollPosition->{0., 0.}]], "InlineSection",
  Background->None,ExpressionUUID->"3995165e-0c09-c649-a175-130ffa710ec9"],
 "\nYou need at least 3 places RHUFT differs from standard models.\n\nFor \
example, candidate prediction classes: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "golden-angle multiscale scan superiority in stabilization tasks"
 }], "InlineItem",ExpressionUUID->"d3a5663d-8c4c-744a-9ec1-9276e9d97a5e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "memory/reflection improving attractor resilience beyond baseline dynamical \
models"
 }], "InlineItem",ExpressionUUID->"744e7d00-34b6-3f49-9d14-df939b574e72"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "closure-defined subsystem boundaries outperforming naive graph \
partitioning for persistent dynamics"
 }], "InlineItem",ExpressionUUID->"a237bb49-2bf6-054b-932e-38f133d92f4e"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"cb508ed6-f4cd-a846-864f-3d1ccda145a2"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Recommended next move\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"258a7613-4033-2a4d-814e-d5144669d54c"],
 "\nThe best next step is ",
 StyleBox["not",
  FontWeight->Bold],
 " to jump to cosmology or ultimate proof.\n\nThe best next step is to build \
a ",
 StyleBox["minimal formal RHUFT core",
  FontWeight->Bold],
 " with only 6 quantities: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "state"
 }], "InlineItem",ExpressionUUID->"dc4c4fff-487d-7842-9b52-620483c718c5"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "memory"
 }], "InlineItem",ExpressionUUID->"661632d2-b425-3049-b7e4-f1d240c97446"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "coherence"
 }], "InlineItem",ExpressionUUID->"232c5978-2d3a-9340-94a5-3689dcd62a09"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "closure"
 }], "InlineItem",ExpressionUUID->"8ceb505d-74ae-0d4f-8138-4374f901e463"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "drift"
 }], "InlineItem",ExpressionUUID->"eca71bce-f78d-1e45-8f39-12f27ee3f8ad"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "burden"
 }], "InlineItem",ExpressionUUID->"f4e8e1e3-262b-1146-8541-1e6fe03bf82e"],
 "\nThen define one update law and test it. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"251d84eb-1f84-9a48-9ee0-c7987a2d7036"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Suggested minimal RHUFT toy formalism\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7532a06a-8110-444f-b2bd-582e83313305"],
 "\nLet \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Psi]", 
          StyleBox["t", "TI"]], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             SubscriptBox["\[Rho]", 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["c", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox["\[Kappa]", 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox["\[Phi]", 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["m", "TI"], 
              StyleBox["t", "TI"]], ",", 
             SubscriptBox[
              StyleBox["b", "TI"], 
              StyleBox["t", "TI"]]}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\psi_t = \\{\\rho_t,c_t,\\kappa_t,\\phi_t,m_t,b_t\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50a6cf59-edb4-7049-8e26-050940e9b555"],
 "\nwith update: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         SubscriptBox["\[Alpha]\[Rho]", 
          StyleBox["t", "TI"]], "+", "\[Beta]", 
         SubscriptBox[
          StyleBox["i", "TI"], 
          StyleBox["t", "TI"]], "+", "\[Delta]", 
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["t", "TI"]], "-", "\[Nu]", 
         SubscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["t", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho_{t+1} = \\alpha \\rho_t + \\beta i_t + \\delta m_t - \\nu d_t", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "97f01b5a-d054-9b44-b48e-4a85802729e6"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "-", "\[Lambda]"}], ")"}], 
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["t", "TI"]], "+", 
         SubscriptBox["\[Lambda]\[Rho]", 
          StyleBox["t", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "m_{t+1} = (1-\\lambda)m_t + \\lambda \\rho_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "326f1dc5-5a12-3943-a1aa-c5e586f33b4f"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["c", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         StyleBox["sim", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Psi]", 
              RowBox[{
                StyleBox["t", "TI"], "+", "1"}]], ",", 
             SubscriptBox["\[Psi]", 
              StyleBox["t", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "c_{t+1} = \\mathrm{sim}(\\psi_{t+1},\\psi_t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f76a8aeb-4d59-7747-b922-2cb69f2172cf"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Kappa]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         FractionBox["internal influence", 
          RowBox[{"total influence", "+", "\[Epsilon]"}]]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\kappa_{t+1} = \\frac{\\text{internal influence}}{\\text{total \
influence}+\\varepsilon}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "615e571f-01fe-b34b-8b86-4869841097f5"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["t", "TI"]], "+", 
         StyleBox["a", "TI"], 
         SubscriptBox["\[Rho]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], 
         SubscriptBox["\[Kappa]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "-", 
         StyleBox["r", "TI"], " ", 
         SubscriptBox["dissipation", 
          StyleBox["t", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "b_{t+1} = b_t + a\\rho_{t+1}\\kappa_{t+1} - r\\,\\text{dissipation}_t", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "04a4d157-02b8-e240-82a7-4050a0b28dd0"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalSigma]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["w", "TI"], "1"], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "+", 
         SubscriptBox[
          StyleBox["w", "TI"], "2"], 
         SubscriptBox["\[Kappa]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "-", 
         SubscriptBox[
          StyleBox["w", "TI"], "3"], 
         SubscriptBox[
          StyleBox["d", "TI"], 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]], "-", 
         SubscriptBox[
          StyleBox["w", "TI"], "4"], 
         SubscriptBox["\[Chi]", 
          RowBox[{
            StyleBox["t", "TI"], "+", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Sigma_{t+1} = w_1 c_{t+1} + w_2 \\kappa_{t+1} - w_3 d_{t+1} - w_4 \
\\chi_{t+1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "874f9631-92bd-f54d-804b-31f86dd7ddcf"],
 "\nThis is enough to start. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"938f5674-3a72-1243-937b-f7dd05a0ae6d"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Wolfram Language representation I recommend\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e4b65ff1-c4e1-094a-a536-11fd829f77eb"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            
            RowBox[{"stabilityScore", ",", "temporalCoherence", ",", 
              "makeState"}], "]"}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"temporalCoherence", "[", 
              RowBox[{"state1_", ",", "state2_"}], "]"}], ":=", 
            "\[IndentingNewLine]", " ", 
            RowBox[{
              RowBox[{"Abs", "[", 
                RowBox[{"state1", ".", "state2"}], "]"}], "/", 
              RowBox[{"(", 
                RowBox[{
                  RowBox[{
                    RowBox[{"Norm", "[", "state1", "]"}], " ", 
                    RowBox[{"Norm", "[", "state2", "]"}]}], "+", 
