  Background->None,ExpressionUUID->"df870b8e-2399-f347-9c9b-8d7e703354a7"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox[Cell[TextData[{
     "Q3. What is a state ",
     Cell[BoxData[
      TemplateBox[{
        Cell["\\psi", Background -> None]},
       "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
      "46a8e353-ca48-d749-80ff-0b527fe2d6a6"],
     "?"
    }],
     Background->None,ExpressionUUID->"ea1ebaf4-6787-204d-bf9a-e7d878929ae3"],
     "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}},
   ScrollPosition->{0., 0.}]], "InlineSection",
  Background->None,ExpressionUUID->"86f83f60-2b38-bd40-8c60-dbae32c7e061"],
 "\nYour answer says the state is not a single simple amplitude. It is more \
like: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "information density at a given scale"
 }], "InlineItem",ExpressionUUID->"1ecbdc14-bc67-4c47-a747-508dea28baad"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "measured relational complexity"
 }], "InlineItem",ExpressionUUID->"1544063f-3270-a349-bfb2-fccc0537922d"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "local stabilization status"
 }], "InlineItem",ExpressionUUID->"4852c0dc-72ee-6c46-a543-862f0f604783"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "phase drag / resistance due to density"
 }], "InlineItem",ExpressionUUID->"11a25156-69c4-4e42-a683-a4e1eb531363"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a scale-relative description of what is stabilized there"
 }], "InlineItem",ExpressionUUID->"071d1d9a-d30b-bb49-a264-9cc5dadccb81"],
 "\nSo the state should probably be modeled as a ",
 StyleBox["multicomponent state",
  FontWeight->Bold],
 ", not a scalar.\n\nA better formal candidate is: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Psi]", 
          StyleBox["t", "TI"], 
          RowBox[{"(", 
            StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubsuperscriptBox["\[Rho]", 
               StyleBox["I", "TI"], 
               RowBox[{"(", 
                 StyleBox["n", "TI"], ")"}]], ", ", 
              SuperscriptBox[
               StyleBox["c", "TI"], 
               RowBox[{"(", 
                 StyleBox["n", "TI"], ")"}]], ", ", 
              SuperscriptBox["\[Phi]", 
               RowBox[{"(", 
                 StyleBox["n", "TI"], ")"}]], ", ", 
              SuperscriptBox[
               StyleBox["d", "TI"], 
               RowBox[{"(", 
                 StyleBox["n", "TI"], ")"}]], ", ", 
              SuperscriptBox["\[Kappa]", 
               RowBox[{"(", 
                 StyleBox["n", "TI"], ")"}]], ", ", 
              SuperscriptBox[
               StyleBox["g", "TI"], 
               RowBox[{"(", 
                 StyleBox["n", "TI"], ")"}]], ", ", 
              SuperscriptBox[
               StyleBox["m", "TI"], 
               RowBox[{"(", 
                 StyleBox["n", "TI"], ")"}]]}], ")"}], 
          StyleBox["t", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\psi_t^{(n)} = \\Big(\\rho_I^{(n)},\\; c^{(n)},\\; \\phi^{(n)},\\; \
d^{(n)},\\; \\kappa^{(n)},\\; g^{(n)},\\; m^{(n)}\\Big)_t", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "57e56622-d158-114b-87b8-63c92aeea79d"],
 "\nwhere: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubsuperscriptBox["\[Rho]", 
         StyleBox["I", "TI"], 
         RowBox[{"(", 
           StyleBox["n", "TI"], ")"}]], TraditionalForm], "errors" -> {}, 
      "input" -> "\\rho_I^{(n)}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "7044bc20-21aa-2542-9eae-177fa51691fc"],
  " = information density"
 }], "InlineItem",ExpressionUUID->"0fd5f5fb-b5d0-e24d-a50d-10aa0b22bc15"],
 "\n",
 Cell[TextData[{
