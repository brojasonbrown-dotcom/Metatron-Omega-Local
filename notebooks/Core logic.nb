Cell[CellGroupData[{

Cell["6. Python-ready formulas", "Section",ExpressionUUID->"fffa233c-5349-cb4e-8d62-8794f85cc0cc"],

Cell[CellGroupData[{

Cell["6.1 Memory stabilization toy model", "Subsection",ExpressionUUID->"b0ec20d0-28f1-174b-8f38-0a31f81d1a92"],

Cell["\<\
import numpy as np

def run_memory_model(alpha=0.8, gamma=0.2, delta=0.3, lam=0.1, steps=200, \
noise=0.05):
    psi = 0.0
    m = 0.0
    states = []
    memories = []
    inputs = np.random.normal(0, noise, steps)
    for t in range(steps):
        psi_next = alpha * psi + gamma * inputs[t] + delta * m
        m_next = (1 - lam) * m + lam * psi
        states.append(psi_next)
        memories.append(m_next)
        psi, m = psi_next, m_next
    return np.array(states), np.array(memories)

def temporal_coherence(x):
    x1 = x[:-1]
    x2 = x[1:]
    num = np.abs(np.sum(x1 * x2))
    den = np.sqrt(np.sum(x1**2) * np.sum(x2**2)) + 1e-12
    return num / den

def drift_metric(x, target=0.0):
    return np.mean((x - target)**2)\
\>", "ExternalLanguage",
 CellEvaluationLanguage->
  "Python",ExpressionUUID->"5d281aa5-0c6e-4c4f-b62d-9fc5ca999066"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2 Reflection model", "Subsection",ExpressionUUID->"61d319bd-1d10-5942-8605-b4c9e658481d"],

Cell["\<\
import numpy as np

def run_reflection_model(alpha=0.85, zeta=0.2, lam=0.1, steps=200, noise=0.05):
    psi = 0.0
    m = 0.0
    states = []
    preds = []
    inputs = np.random.normal(0, noise, steps)
    for t in range(steps):
        psi_hat = 0.5 * psi + 0.5 * m
        psi_next = alpha * psi + zeta * (psi_hat - psi) + inputs[t]
        m_next = (1 - lam) * m + lam * psi
        states.append(psi_next)
        preds.append(psi_hat)
        psi, m = psi_next, m_next
    return np.array(states), np.array(preds)\
\>", "ExternalLanguage",
 CellEvaluationLanguage->
  "Python",ExpressionUUID->"f8b0e5f6-5577-7e48-958a-de79b31b9138"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.3 Golden-angle coverage test", "Subsection",ExpressionUUID->"985f2efb-df2e-1343-b143-0c2736088e88"],

Cell["\<\
import numpy as np

def scan_angles(omega, steps=500):
    theta = 0.0
    vals = []
    for _ in range(steps):
        theta = (theta + omega) % (2*np.pi)
        vals.append(theta)
    return np.array(vals)

def coverage_discrepancy(angles, bins=50):
    hist, _ = np.histogram(angles, bins=bins, range=(0, 2*np.pi), density=True)
    uniform = np.ones_like(hist) / (2*np.pi / bins)
    return np.mean((hist - hist.mean())**2)

golden_omega = 2*np.pi*(1 - 1/((1+np.sqrt(5))/2))\
\>", "ExternalLanguage",
 CellEvaluationLanguage->
  "Python",ExpressionUUID->"003fc6b0-79b0-bb4d-8adc-f374a99654dd"],

