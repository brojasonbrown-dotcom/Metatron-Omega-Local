Cell[CellGroupData[{
Cell["RHUFT Foundation Mapping and Test Plan", "Title",ExpressionUUID->"85f72173-db3c-3b4d-8fa3-de3702e73954"],

Cell["This notebook organizes your current framework into:", "Text",ExpressionUUID->"72097e9d-a413-d542-8ef0-5294b233429c"],

Cell["1. core claims already present", "Text",ExpressionUUID->"d81ebcac-9ec6-3a41-9c71-d5963461d55f"],

