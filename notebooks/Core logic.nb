Cell["4.8 Burden / mass candidate", "Subsection",ExpressionUUID->"c498483e-b173-284d-957a-0fb44137a636"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["t", "TI"], 
          RowBox[{"(", 
            StyleBox["n", "TI"], ")"}]], "\[LongEqual]", 
         SubscriptBox["\[Integral]", 
          SubscriptBox["\[CapitalOmega]", 
           StyleBox["n", "TI"]]], 
         SubscriptBox["\[Rho]", 
          StyleBox["I", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ";", 
             StyleBox["n", "TI"]}], ")"}], " ", 
         SubscriptBox[
          StyleBox["w", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[DifferentialD]", 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "b_t^{(n)} = \\int_{\\Omega_n} \\rho_I(x;n)\\, w_n(x)\\, dx", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "533cc3f3-2c73-334d-bb62-594e000ac080"],
 "or discrete form: ",
 Cell[BoxData[
