    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            
            RowBox[{"sphericalMode", ",", "sphericalEigenvalue", ",", 
              "sphereModeSet"}], "]"}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{
              RowBox[{"sphericalMode", "[", 
                RowBox[{"{", 
                  RowBox[{"l_Integer", ",", "m_Integer"}], "}"}], "]"}], "[", 
              RowBox[{"\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
            RowBox[{"SphericalHarmonicY", "[", 
              RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], 
              "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"sphericalEigenvalue", "[", 
              RowBox[{"{", 
                RowBox[{"l_Integer", ",", "m_Integer"}], "}"}], "]"}], ":=", 
            RowBox[{
              RowBox[{"-", "l"}], " ", 
              RowBox[{"(", 
                RowBox[{"l", "+", "1"}], ")"}]}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"sphereModeSet", "[", "lMax_Integer", "]"}], ":=", 
            RowBox[{"Flatten", "[", 
              RowBox[{
                RowBox[{"Table", "[", 
                  RowBox[{
                    RowBox[{"{", 
                    RowBox[{"l", ",", "m"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"l", ",", "0", ",", "lMax"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"m", ",", 
                    RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}], ",", 
                "1"}], "]"}]}], ";"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "34e6b192-1d26-eb47-b216-125e8992bd31"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"7b. Toroidal/Fourier proxy\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"bdf75f47-5c6e-b147-97ae-b9994c5bebf4"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            
            RowBox[{"toroidalMode", ",", "toroidalEigenvalue", ",", 
              "torusModeSet"}], "]"}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{
              RowBox[{"toroidalMode", "[", 
                RowBox[{"{", 
                  RowBox[{"m_Integer", ",", "n_Integer"}], "}"}], "]"}], "[", 
              RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
            RowBox[{"Exp", "[", 
              RowBox[{"I", " ", 
                RowBox[{"(", 
                  RowBox[{
                    RowBox[{"m", " ", "u"}], "+", 
                    RowBox[{"n", " ", "v"}]}], ")"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"toroidalEigenvalue", "[", 
              RowBox[{
                RowBox[{"{", 
                  RowBox[{"m_Integer", ",", "n_Integer"}], "}"}], ",", 
                "majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
            "\[IndentingNewLine]", "  ", 
            RowBox[{"-", 
              RowBox[{"(", 
                RowBox[{
                  RowBox[{
                    RowBox[{"m", "^", "2"}], "/", 
                    RowBox[{"majorRadius", "^", "2"}]}], "+", 
                  RowBox[{
                    RowBox[{"n", "^", "2"}], "/", 
                    RowBox[{"minorRadius", "^", "2"}]}]}], ")"}]}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"torusModeSet", "[", 
              RowBox[{"mMax_Integer", ",", "nMax_Integer"}], "]"}], ":=", 
            "\[IndentingNewLine]", "  ", 
            RowBox[{"Flatten", "[", 
              RowBox[{
                RowBox[{"Table", "[", 
                  RowBox[{
                    RowBox[{"{", 
                    RowBox[{"m", ",", "n"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"m", ",", 
                    RowBox[{"-", "mMax"}], ",", "mMax"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"n", ",", 
                    RowBox[{"-", "nMax"}], ",", "nMax"}], "}"}]}], "]"}], ",",
                 "1"}], "]"}]}], ";"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
