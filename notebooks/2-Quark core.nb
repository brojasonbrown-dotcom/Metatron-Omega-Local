 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. Algebraic stationary sector\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a9c3fc1b-b202-0049-8b5d-fcef8680d4e2"],
 "\nFor the local potential alone, derive exact stationarity conditions. \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            
            RowBox[{"localPotential", ",", "stationaryConditions", ",", 
              "stationaryReduction"}], "]"}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"localPotential", "[", 
              RowBox[{"rhoVar_", ",", "chiVar_", ",", "resVar_"}], "]"}], 
            ":=", 
            RowBox[{
              RowBox[{"rhoVar", " ", 
                RowBox[{"Log", "[", "chiVar", "]"}]}], "+", 
              RowBox[{"chiVar", " ", 
                RowBox[{"resVar", "^", "2"}]}]}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"stationaryConditions", "=", 
            RowBox[{"Thread", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"localPotential", "[", 
                    RowBox[{"rho0", ",", "chi0", ",", "res0"}], "]"}], ",", 
                    "rho0"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"localPotential", "[", 
                    RowBox[{"rho0", ",", "chi0", ",", "res0"}], "]"}], ",", 
                    "chi0"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"localPotential", "[", 
                    RowBox[{"rho0", ",", "chi0", ",", "res0"}], "]"}], ",", 
                    "res0"}], "]"}]}], "\[IndentingNewLine]", "  ", "}"}], 
                "==", "0"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"stationaryReduction", "=", 
          RowBox[{"Reduce", "[", 
            RowBox[{"stationaryConditions", ",", 
              RowBox[{"{", 
                RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", 
              "Reals"}], "]"}]}]}]], "ChatCode", "Input", LanguageCategory -> 
     "Input", ShowAutoStyles -> True, ShowStringCharacters -> True, 
     ShowSyntaxStyles -> True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "83006a88-b4f1-ce4d-a55b-17e79ad6f469"],
 "\nThis should give the exact local stationary structure instead of a \
terminated recursion. \n",
 Cell[BoxData[
