 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"9. Linearized Layer-1 stiffness around scale background\"\>",
     "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"688ef0e7-de56-9049-a3df-20eae7835260"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            
            RowBox[{"potentialPart", ",", "stiffnessMatrixLayer1", ",", 
              "stiffnessEigenSystemLayer1"}], "]"}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"potentialPart", "[", 
              RowBox[{"rhoVar_", ",", "chiVar_", ",", "resVar_"}], "]"}], 
            ":=", 
            RowBox[{
              RowBox[{"rhoVar", " ", 
                RowBox[{"Log", "[", "chiVar", "]"}]}], "+", 
              RowBox[{"chiVar", " ", 
                RowBox[{"resVar", "^", "2"}]}]}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"stiffnessMatrixLayer1", "[", 
              RowBox[{"rhoBack_", ",", "chiBack_", ",", "resBack_"}], "]"}], 
            ":=", 
            RowBox[{
              RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{
                    RowBox[{"D", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"potentialPart", "[", 
                    RowBox[{
                    RowBox[{"rhoBack", "+", "\[Delta]rho"}], ",", 
                    RowBox[{"chiBack", "+", "\[Delta]chi"}], ",", 
                    RowBox[{"resBack", "+", "\[Delta]res"}]}], "]"}], ",", 
                    "\[IndentingNewLine]", "    ", "var1", ",", "var2"}], 
                    "\[IndentingNewLine]", "  ", "]"}], " ", "/.", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\[Delta]rho", "->", "0"}], ",", 
                    RowBox[{"\[Delta]chi", "->", "0"}], ",", 
                    RowBox[{"\[Delta]res", "->", "0"}]}], "}"}]}], ",", 
                  "\[IndentingNewLine]", "  ", 
                  RowBox[{"{", 
                    RowBox[{"var1", ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\[Delta]rho", ",", "\[Delta]chi", ",", "\[Delta]res"}], 
                    "}"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
                  RowBox[{"{", 
                    RowBox[{"var2", ",", 
                    RowBox[{"{", 
                    
                    RowBox[{
                    "\[Delta]rho", ",", "\[Delta]chi", ",", "\[Delta]res"}], 
                    "}"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], " ", "//",
               " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            
            RowBox[{"stiffnessEigenSystemLayer1", "[", "ontology_Association",
               "]"}], ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"rhoBack", "=", 
                    
                    RowBox[{
                    "ontology", "[", "\"InformationDensityParameter\"", 
                    "]"}]}], ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"chiBack", "=", 
                    
                    RowBox[{
                    "ontology", "[", "\"FieldComplexityParameter\"", "]"}]}], 
                    ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"resBack", "=", 
                    
                    RowBox[{
                    "ontology", "[", "\"ResolutionParameter\"", "]"}]}], ",", 
                    "\[IndentingNewLine]", "    ", "mat", ",", "vals", ",", 
                    "vecs"}], "\[IndentingNewLine]", "  ", "}"}], ",", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"mat", "=", 
                    RowBox[{"stiffnessMatrixLayer1", "[", 
                    RowBox[{"rhoBack", ",", "chiBack", ",", "resBack"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "  ", 
                  RowBox[{
                    RowBox[{"{", 
                    RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
                    RowBox[{"Eigensystem", "[", 
                    RowBox[{"mat", ",", 
                    RowBox[{"Cubics", "->", "True"}], ",", 
                    RowBox[{"Quartics", "->", "True"}]}], "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"<|", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"\"Background\"", "->", 
                    RowBox[{"<|", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"\"Rho0\"", "->", "rhoBack"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"Chi0\"", "->", "chiBack"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"Res0\"", "->", "resBack"}]}], 
                    "\[IndentingNewLine]", "    ", "|>"}]}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"StiffnessMatrix\"", "->", "mat"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Eigenvalues\"", "->", "vals"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Eigenvectors\"", "->", "vecs"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"PureImaginaryModes\"", "->", 
                    RowBox[{"Select", "[", 
                    RowBox[{"vals", ",", 
                    RowBox[{
                    RowBox[{"FullSimplify", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Re", "[", "#", "]"}], "==", "0"}], "&&", 
                    RowBox[{
                    RowBox[{"Im", "[", "#", "]"}], ">", "0"}]}], "]"}], " ", 
                    "&"}]}], "]"}]}]}], "\[IndentingNewLine]", "  ", 
                    "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "0219f629-bef8-3449-b6d6-71baf34e9f18"],
