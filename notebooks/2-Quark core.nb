 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"6. Scale-specific propagation operators\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"91b88f57-f3ba-0446-94e9-d388ece72876"],
 "\nEach scale gets its own operator based on ontology. \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", "scalePropagationOperator", "]"}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            
            RowBox[{"scalePropagationOperator", "[", "ontology_Association", 
              "]"}], ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"propagationType", "=", 
                    RowBox[{"ontology", "[", "\"PropagationType\"", "]"}]}], 
                    ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"damping", "=", 
                    RowBox[{"ontology", "[", "\"DampingParameter\"", "]"}]}], 
                    ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"coupling", "=", 
                    
                    RowBox[{
                    "ontology", "[", "\"CouplingParameter\"", "]"}]}]}], 
                  "\[IndentingNewLine]", "  ", "}"}], ",", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{"Switch", "[", 
                  
                  RowBox[{
                   "propagationType", ",", "\[IndentingNewLine]", "    ", 
                    "\[IndentingNewLine]", "    ", "\"ConstraintTransfer\"", 
                    ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    
                    RowBox[{
                    "\"OperatorType\"", "->", "\"AlgebraicConstraint\""}], 
                    ",", "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"Operator\"", "->", 
                    RowBox[{"Function", "[", 
                    RowBox[{"u", ",", 
                    RowBox[{"coupling", " ", "u"}]}], "]"}]}]}], 
                    "\[IndentingNewLine]", "    ", "|>"}], ",", 
                    "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", 
                    "    ", "\"SchrodingerLike\"", ",", "\[IndentingNewLine]",
                     "    ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"\"OperatorType\"", "->", "\"SchrodingerLike\""}],
                     ",", "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"Operator\"", "->", 
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"u", ",", "vars"}], "}"}], ",", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{"I", " ", 
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"u", " ", "@@", " ", "vars"}], ",", "t"}], 
                    "]"}]}], "+", 
                    RowBox[{"coupling", " ", 
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"u", " ", "@@", " ", "vars"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"#1", ",", "2"}], "}"}]}], "]"}], " ", "&"}], " ",
                     "/@", " ", 
                    RowBox[{"Most", "[", "vars", "]"}]}], "]"}]}]}]}], 
                    "\[IndentingNewLine]", "      ", "]"}]}]}], 
                    "\[IndentingNewLine]", "    ", "|>"}], ",", 
                    "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", 
                    "    ", "\"WaveLike\"", ",", "\[IndentingNewLine]", 
                    "    ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"\"OperatorType\"", "->", "\"WaveLike\""}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"Operator\"", "->", 
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"u", ",", "vars"}], "}"}], ",", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"u", " ", "@@", " ", "vars"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "+", 
                    RowBox[{"damping", " ", 
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"u", " ", "@@", " ", "vars"}], ",", "t"}], 
                    "]"}]}], "-", "\[IndentingNewLine]", "        ", 
                    RowBox[{"coupling", " ", 
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"u", " ", "@@", " ", "vars"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"#1", ",", "2"}], "}"}]}], "]"}], " ", "&"}], " ",
                     "/@", " ", 
                    RowBox[{"Most", "[", "vars", "]"}]}], "]"}]}]}]}], 
                    "\[IndentingNewLine]", "      ", "]"}]}]}], 
                    "\[IndentingNewLine]", "    ", "|>"}], ",", 
                    "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", 
                    "    ", "\"DissipativeWave\"", ",", "\[IndentingNewLine]",
                     "    ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"\"OperatorType\"", "->", "\"DissipativeWave\""}],
                     ",", "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"Operator\"", "->", 
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"u", ",", "vars"}], "}"}], ",", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"u", " ", "@@", " ", "vars"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "+", 
                    RowBox[{"2", " ", "damping", " ", 
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"u", " ", "@@", " ", "vars"}], ",", "t"}], 
                    "]"}]}], "-", "\[IndentingNewLine]", "        ", 
                    RowBox[{"coupling", " ", 
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"u", " ", "@@", " ", "vars"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"#1", ",", "2"}], "}"}]}], "]"}], " ", "&"}], " ",
                     "/@", " ", 
                    RowBox[{"Most", "[", "vars", "]"}]}], "]"}]}], "+", 
                    RowBox[{"damping", " ", 
                    RowBox[{"u", " ", "@@", " ", "vars"}]}]}]}], 
                    "\[IndentingNewLine]", "      ", "]"}]}]}], 
                    "\[IndentingNewLine]", "    ", "|>"}]}], 
                  "\[IndentingNewLine]", "  ", "]"}]}], "\[IndentingNewLine]",
               "]"}]}], ";"}]}]], "ChatCode", "Input", LanguageCategory -> 
     "Input", ShowAutoStyles -> True, ShowStringCharacters -> True, 
     ShowSyntaxStyles -> True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "cd546a08-9ae9-354d-aa0b-31cf81bd3149"],
