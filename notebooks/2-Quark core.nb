 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"14. High-precision executable strategy\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"bdf90242-73c0-804d-8aa3-b146d9f491bb"],
 "\nSince your ontology asks for extreme precision, use this pattern: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", "highPrecisionEvaluate", "]"}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"highPrecisionEvaluate", "[", 
              RowBox[{"expr_", ",", 
                RowBox[{"precision_", ":", " ", "200"}]}], "]"}], ":=", 
            RowBox[{"Block", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", 
                  RowBox[{"$MaxExtraPrecision", "=", "precision"}], "}"}], 
                ",", "\[IndentingNewLine]", "  ", 
                RowBox[{"N", "[", 
                  RowBox[{"expr", ",", "precision"}], "]"}]}], 
              "\[IndentingNewLine]", "]"}]}], ";"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "2118a140-886c-5e42-ad17-6c7bbcc19daf"],
 "\nFor numerical eigensystems or integrals, use finite but high precision: \n\
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"N", "[", 
        RowBox[{
          RowBox[{"phi", "^", "200"}], ",", "300"}], "]"}]], "ChatCode", 
     "Input", LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "b9906cac-0950-414d-a722-158fa49a6aef"],
 "\nnot: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"WorkingPrecision", "->", "Infinity"}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "73e23c0f-7e2b-5049-ac78-8c22e8fd766e"],
 "\nbecause that is not supported by built-in numerical functions. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"42119bbe-9776-ec41-8efd-86101efa3db6"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"15. Optional dimensional anchoring with Planck units\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"17b117f9-3e85-e548-8704-bc8da5a96a3d"],
 "\nIf you want the next scale physically anchored: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            RowBox[{"planckLength", ",", "scaleLength"}], "]"}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"planckLength", "=", 
            RowBox[{"Quantity", "[", 
              RowBox[{
                RowBox[{"1.616255", "*", 
                  RowBox[{"10", "^", 
                    RowBox[{"-", "35"}]}]}], ",", "\"Meters\""}], "]"}]}], 
          ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"scaleLength", "[", "n_Integer", "]"}], ":=", 
            RowBox[{"UnitConvert", "[", 
              RowBox[{
                RowBox[{"planckLength", " ", 
                  RowBox[{"phi", "^", "n"}]}], ",", "\"Meters\""}], "]"}]}], 
          ";"}]}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
