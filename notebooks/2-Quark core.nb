Cell[CellGroupData[{

Cell["1. Core constants and stable-scale utilities", "Section",ExpressionUUID->"98acbe4f-d8cf-3a4a-9737-fd054ee80724"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "phi", ",", "scaleResidual", ",", "closureScore", ",", "windingEstimate", 
     ",", "informationDensity", ",", "\[IndentingNewLine]", "  ", 
     "stableScaleQ", ",", "stableScaleIndices", ",", "scaleAssociation"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phi", "=", "GoldenRatio"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleResidual", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"divisor_", ":", " ", "13"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"phi", "^", "n"}], "/", "divisor"}], ",", "80"}], "]"}]}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"x", "-", 
         RowBox[{"Round", "[", "x", "]"}]}], "]"}], "/", "x"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"closureScore", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"divisor_", ":", " ", "13"}]}], "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{"scaleResidual", "[", 
      RowBox[{"n", ",", "divisor"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"windingEstimate", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"divisor_", ":", " ", "13"}]}], "]"}], ":=", 
    RowBox[{"Round", "[", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"phi", "^", "n"}], "/", "divisor"}], ",", "80"}], "]"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"informationDensity", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"phi", "^", 
     RowBox[{"-", "n"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stableScaleQ", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"divisor_", ":", " ", "13"}], ",", 
      RowBox[{"tolerance_", ":", " ", "0.01"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"scaleResidual", "[", 
      RowBox[{"n", ",", "divisor"}], "]"}], "<", "tolerance"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stableScaleIndices", "[", 
     RowBox[{"maxN_Integer", ",", 
      RowBox[{"divisor_", ":", " ", "13"}], ",", 
      RowBox[{"tolerance_", ":", " ", "0.01"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "maxN"}], "]"}], ",", 
      RowBox[{
       RowBox[{"stableScaleQ", "[", 
        RowBox[{"#", ",", "divisor", ",", "tolerance"}], "]"}], " ", "&"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleAssociation", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"divisor_", ":", " ", "13"}]}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<PhiPower\>\"", "->", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"phi", "^", "n"}], ",", "80"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Residual\>\"", "->", 
      RowBox[{"scaleResidual", "[", 
       RowBox[{"n", ",", "divisor"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<ClosureScore\>\"", "->", 
      RowBox[{"closureScore", "[", 
       RowBox[{"n", ",", "divisor"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<WindingEstimate\>\"", "->", 
      RowBox[{"windingEstimate", "[", 
       RowBox[{"n", ",", "divisor"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<InformationDensity\>\"", "->", 
      RowBox[{"informationDensity", "[", "n", "]"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"d4069b59-33ff-7e44-9eee-3f23d83ef0db"],

