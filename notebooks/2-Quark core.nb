  Background->None,ExpressionUUID->"75c030f7-e141-f246-a4c1-4709542f4509"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", "scaleSpectralData", "]"}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"scaleSpectralData", "[", "\[IndentingNewLine]", "  ", 
              
              RowBox[{"ontology_Association", ",", "\[IndentingNewLine]", 
                "  ", 
                RowBox[{"truncation_", ":", " ", "4"}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"sigma_", ":", " ", "1"}]}], "\[IndentingNewLine]", 
              "]"}], ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"geometry", "=", 
                    RowBox[{"ontology", "[", "\"Geometry\"", "]"}]}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"majorRadius", "=", 
                    RowBox[{"ontology", "[", "\"MajorRadius\"", "]"}]}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"minorRadius", "=", 
                    RowBox[{"ontology", "[", "\"MinorRadius\"", "]"}]}], ",", 
                    "\[IndentingNewLine]", "    ", "modes", ",", 
                    "eigenAssoc"}], "\[IndentingNewLine]", "  ", "}"}], ",", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"Switch", "[", 
                    
                    RowBox[{
                    "geometry", ",", "\[IndentingNewLine]", "    ", 
                    "\[IndentingNewLine]", "    ", "\"Sphere\"", ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"modes", "=", 
                    RowBox[{"sphereModeSet", "[", "truncation", "]"}]}], ";", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"eigenAssoc", "=", 
                    RowBox[{"AssociationMap", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"sphericalEigenvalue", "[", "#", "]"}], "+", 
                    "sigma"}], " ", "&"}], ",", "modes"}], "]"}]}]}], ",", 
                    "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", 
                    "    ", "\"SphericalShell\"", ",", "\[IndentingNewLine]", 
                    "    ", 
                    RowBox[{
                    RowBox[{"modes", "=", 
                    RowBox[{"sphereModeSet", "[", "truncation", "]"}]}], ";", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"eigenAssoc", "=", 
                    RowBox[{"AssociationMap", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"sphericalEigenvalue", "[", "#", "]"}], "+", 
                    "sigma"}], " ", "&"}], ",", "modes"}], "]"}]}]}], ",", 
                    "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", 
                    "    ", "\"Toroidal\"", ",", "\[IndentingNewLine]", 
                    "    ", 
                    RowBox[{
                    RowBox[{"modes", "=", 
                    RowBox[{"torusModeSet", "[", 
                    RowBox[{"truncation", ",", "truncation"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"eigenAssoc", "=", 
                    
                    RowBox[{
                    "AssociationMap", "[", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"toroidalEigenvalue", "[", 
                    RowBox[{"#", ",", "majorRadius", ",", "minorRadius"}], 
                    "]"}], "+", "sigma"}], " ", "&"}], ",", 
                    "\[IndentingNewLine]", "      ", "modes"}], 
                    "\[IndentingNewLine]", "    ", "]"}]}]}], ",", 
                    "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", 
                    "    ", "_", ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"modes", "=", 
                    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", "    ", 
                    RowBox[{"eigenAssoc", "=", 
                    RowBox[{"<|", "|>"}]}]}]}], "\[IndentingNewLine]", "  ", 
                    "]"}], ";", "\[IndentingNewLine]", "  ", 
                  "\[IndentingNewLine]", "  ", 
                  RowBox[{"<|", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"\"Modes\"", "->", "modes"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Eigenvalues\"", "->", "eigenAssoc"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"BestModes\"", "->", 
                    RowBox[{"MinimalBy", "[", 
                    RowBox[{
                    RowBox[{"Normal", "[", "eigenAssoc", "]"}], ",", 
                    RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "&"}]}], 
                    "]"}]}]}], "\[IndentingNewLine]", "  ", "|>"}]}]}], 
              "\[IndentingNewLine]", "]"}]}], ";"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "51681871-1b31-7b40-b61c-6edadeb14456"],
