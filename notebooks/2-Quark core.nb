 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"12. Full pipeline for the next scale\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"82bc52f3-1dc3-414b-8d55-7b90363183c2"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", "nextScaleFramework", "]"}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"nextScaleFramework", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{"currentN_Integer", ",", "\[IndentingNewLine]", "  ", 
                RowBox[{"divisor_", ":", " ", "13"}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"tolerance_", ":", " ", "0.01"}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"truncation_", ":", " ", "4"}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"sigma_", ":", " ", "1"}]}], "\[IndentingNewLine]", 
              "]"}], ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", "\[IndentingNewLine]", "    ", 
                  
                  RowBox[{
                   "nNext", ",", "ontology", ",", "l1eqns", ",", "operator", 
                    ",", "spectral", ",", "stiffness", ",", "medium", ",", 
                    "resolution", ",", "measurement"}], "\[IndentingNewLine]",
                   "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"nNext", "=", 
                    RowBox[{"nextStableScale", "[", 
                    RowBox[{"currentN", ",", "divisor", ",", "tolerance"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "  ", 
                  "\[IndentingNewLine]", "  ", 
                  RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"MissingQ", "[", "nNext", "]"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"Return", "[", 
                    RowBox[{"<|", 
                    
                    RowBox[{
                    "\"Error\"", "->", 
                    "\"No next stable scale found in search range.\""}], 
                    "|>"}], "]"}]}], "\[IndentingNewLine]", "  ", "]"}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"ontology", "=", 
                    RowBox[{"makeScaleOntology", "[", 
                    RowBox[{"nNext", ",", "divisor"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", 
                  RowBox[{"l1eqns", "=", 
                    RowBox[{"layer1EulerEquations", "[", "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", 
                  RowBox[{"operator", "=", 
                    
                    RowBox[{
                    "scalePropagationOperator", "[", "ontology", "]"}]}], ";",
                   "\[IndentingNewLine]", "  ", 
                  RowBox[{"spectral", "=", 
                    RowBox[{"scaleSpectralData", "[", 
                    RowBox[{"ontology", ",", "truncation", ",", "sigma"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "  ", 
                  RowBox[{"stiffness", "=", 
                    
                    RowBox[{
                    "stiffnessEigenSystemLayer1", "[", "ontology", "]"}]}], 
                  ";", "\[IndentingNewLine]", "  ", 
                  RowBox[{"medium", "=", 
                    RowBox[{"scaleMediumLaw", "[", "ontology", "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", 
                  RowBox[{"resolution", "=", 
                    RowBox[{"scaleResolutionLaw", "[", "ontology", "]"}]}], 
                  ";", "\[IndentingNewLine]", "  ", 
                  RowBox[{"measurement", "=", 
                    RowBox[{"scaleMeasurementAssociation", "[", 
                    RowBox[{"ontology", ",", "spectral"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"<|", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"\"NextScale\"", "->", "nNext"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Ontology\"", "->", "ontology"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Layer1EulerEquations\"", "->", "l1eqns"}], ",",
                     "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"PropagationOperator\"", "->", "operator"}], 
                    ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"SpectralData\"", "->", "spectral"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"StiffnessAnalysis\"", "->", "stiffness"}], ",",
                     "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"MediumLaw\"", "->", "medium"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"ResolutionLaw\"", "->", "resolution"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Measurement\"", "->", "measurement"}]}], 
                    "\[IndentingNewLine]", "  ", "|>"}]}]}], 
              "\[IndentingNewLine]", "]"}]}], ";"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "6b42b8ed-ed14-6a43-989b-e649a433d87c"],
 "\nUsage: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"framework", "=", 
          RowBox[{"nextScaleFramework", "[", "12", "]"}]}], ";"}]], 
