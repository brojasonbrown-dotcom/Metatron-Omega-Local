Cell[CellGroupData[{

Cell["2. Layer-1 variational field equations", "Section",ExpressionUUID->"c805fa94-4543-f446-bab3-ae7c49dbf7d6"],

Cell[TextData[{
 "We encode your Layer-1 action density ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], ")"}], "\[LongEqual]", "\[Rho]", "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{L}(\\rho,\\chi,R) = \\rho\\log(\\chi) + \\chi R^2",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0ce9829-9acc-cf41-a99a-825f8e94582d"],
 "and derive Euler-Lagrange equations in a symbolic way. "
}], "Text",ExpressionUUID->"63307274-562e-244d-9d10-34277e08ace6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "rhoField", ",", "chiField", ",", "resolutionField", ",", "x", ",", "y", ",",
      "z", ",", "t", ",", "coords", ",", "lagrangianDensity", ",", 
     "\[IndentingNewLine]", "  ", "actionDensity", ",", "eulerEqns"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords", "=", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoField", "=", 
   RowBox[{"rhoField", " ", "@@", " ", "coords"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"chiField", "=", 
   RowBox[{"chiField", " ", "@@", " ", "coords"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"resolutionField", "=", 
    RowBox[{"resolutionField", " ", "@@", " ", "coords"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lagrangianDensity", "=", 
    RowBox[{
     RowBox[{"rhoField", " ", 
      RowBox[{"Log", "[", "chiField", "]"}]}], "+", 
     RowBox[{"chiField", " ", 
      RowBox[{"resolutionField", "^", "2"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"actionDensity", "=", "lagrangianDensity"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerEqns", "=", 
    RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rhoField", ",", "chiField", ",", "resolutionField"}], "}"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"VariationalD", "[", 
           RowBox[{"actionDensity", ",", "#", ",", "coords"}], "]"}], " ", "//",
           " ", "FullSimplify"}], ")"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"rhoField", ",", "chiField", ",", "resolutionField"}], 
        "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "eulerEqns"}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"b9b08f34-2545-3d4c-b1e7-fecabb2d0c8e"],

