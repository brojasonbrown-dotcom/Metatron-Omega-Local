Cell[CellGroupData[{

Cell["11. Schr\[ODoubleDot]dinger-based propagating sector", "Section",ExpressionUUID->"ae37a72e-bf93-3a42-9610-43f3f4de6966"],

Cell[TextData[{
 "To add a propagating wave sector with built-in PDE functionality, use ",
 ButtonBox["SchrodingerPDEComponent",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SchrodingerPDEComponent"],
 ". "
}], "Text",ExpressionUUID->"e366ecb8-058f-be4e-ab74-e10d79ca338f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "schrodingerOperator1D", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"schrodingerOperator1D", "[", 
     RowBox[{"xSymbol_", ",", "potential_", ",", 
      RowBox[{"mass_", ":", " ", "1"}], ",", 
      RowBox[{"hbar_", ":", " ", "1"}]}], "]"}], ":=", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"SchrodingerPDEComponent", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"psi", "[", "xSymbol", "]"}], ",", 
        RowBox[{"{", "xSymbol", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{"<|", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\"\<Mass\>\"", "->", "mass"}], ",", "\[IndentingNewLine]", 
        "      ", 
        RowBox[{"\"\<ReducedPlanckConstant\>\"", "->", "hbar"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<SchrodingerPotential\>\"", "->", "potential"}]}], 
       "\[IndentingNewLine]", "    ", "|>"}]}], "\[IndentingNewLine]", "  ", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"schrodingerOperator1D", "[", 
  RowBox[{"x", ",", 
   RowBox[{"x", "^", "2"}], ",", 
   RowBox[{"1", "/", "2"}], ",", 
   RowBox[{"1", "/", "10"}]}], "]"}]}], "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"e50fb6c1-7d69-d546-969f-23d81755af51"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["x", "2"], " ", 
   RowBox[{"psi", "[", "x", "]"}]}], "+", 
  TemplateBox[{
    RowBox[{"(", 
      RowBox[{
        RowBox[{"{", 
          RowBox[{"{", 
            RowBox[{"-", 
              FractionBox["1", "100"]}], "}"}], "}"}], ".", 
        TemplateBox[{
          RowBox[{"psi", "[", "x", "]"}], 
          RowBox[{"{", "x", "}"}], "Inactive"}, "InactiveGrad", SyntaxForm -> 
         Del]}], ")"}], 
    RowBox[{"{", "x", "}"}], "Inactive"},
   "InactiveDiv"]}]], "Output",
 CellChangeTimes->{3.9941294624786777`*^9},
 CellLabel->"Out[87]=",ExpressionUUID->"a08b6fcc-e65d-de46-bd69-ac8e5f1a5f41"]
}, Open  ]],

Cell[TextData[{
 "You can then compute eigensystems numerically via ",
 ButtonBox["NDEigensystem",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NDEigensystem"],
 " or symbolically in simpler settings via ",
 ButtonBox["DSolveValue",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/DSolveValue"],
 ". "
}], "Text",ExpressionUUID->"b5a6167f-b9d9-fb41-ae35-5ca3281b721d"],

