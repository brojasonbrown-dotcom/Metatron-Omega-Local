Cell["5. Efficient modal field framework on sphere and torus", "Section",ExpressionUUID->"69807cde-c8dc-554a-9c33-820a4a52cb6c"],

Cell[CellGroupData[{

Cell["5a. Spherical basis", "Subsection",ExpressionUUID->"b8954ad4-ba3d-5f48-8362-5831306f1474"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "sphericalMode", ",", "sphericalSuperposition", ",", 
     "sphericalCoefficientRules"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sphericalMode", "[", 
      RowBox[{"l_Integer", ",", "m_Integer"}], "]"}], "[", 
     RowBox[{"theta_", ",", "phi_"}], "]"}], ":=", 
    RowBox[{"SphericalHarmonicY", "[", 
     RowBox[{"l", ",", "m", ",", "theta", ",", "phi"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sphericalSuperposition", "[", "coeffs_Association", "]"}], "[", 
    RowBox[{"theta_", ",", "phi_"}], "]"}], ":=", 
   RowBox[{"Total", " ", "@", " ", 
    RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"#2", " ", 
         RowBox[{"sphericalMode", " ", "@@", " ", 
          RowBox[{"#1", "[", 
           RowBox[{"theta", ",", "phi"}], "]"}]}]}], ")"}], " ", "&"}], ",", 
      "\[IndentingNewLine]", "  ", "coeffs"}], "\[IndentingNewLine]", 
     "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"d4e7fdbc-7dc6-9c43-8639-7b1e1c027d76"],

