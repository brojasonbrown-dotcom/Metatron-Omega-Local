 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"11. Measurement kernel for Layer-2 observables\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"03944c34-175c-3c45-8bfb-bc909bbdb0af"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            RowBox[{"modalObservable", ",", "scaleMeasurementAssociation"}], 
            "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"modalObservable", "[", 
              RowBox[{"coeffs_Association", ",", "weightFunction_"}], "]"}], 
            ":=", 
            RowBox[{"Total", " ", "@", " ", 
              RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{
                    RowBox[{
                    RowBox[{"Conjugate", "[", "#2", "]"}], " ", 
                    RowBox[{"weightFunction", "[", "#1", "]"}], " ", "#2"}], 
                    " ", "&"}], ",", "\[IndentingNewLine]", "  ", "coeffs"}], 
                "\[IndentingNewLine]", "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            
            RowBox[{"scaleMeasurementAssociation", "[", "\[IndentingNewLine]",
               "  ", 
              
              RowBox[{"ontology_Association", ",", "\[IndentingNewLine]", 
                "  ", "spectral_Association"}], "\[IndentingNewLine]", "]"}], 
            ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"bestModes", "=", 
                    RowBox[{"spectral", "[", "\"BestModes\"", "]"}]}], ",", 
                    "\[IndentingNewLine]", "    ", "weightFunction"}], 
                  "\[IndentingNewLine]", "  ", "}"}], ",", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"weightFunction", "=", 
                    RowBox[{
                    RowBox[{"scaleMeasurementWeight", "[", 
                    RowBox[{"ontology", ",", "#"}], "]"}], " ", "&"}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"<|", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"\"BestModes\"", "->", "bestModes"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"ModeWeights\"", "->", 
                    RowBox[{"AssociationMap", "[", 
                    RowBox[{"weightFunction", ",", 
                    RowBox[{"spectral", "[", "\"Modes\"", "]"}]}], "]"}]}], 
                    ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"ObservableProxyOnBestModes\"", "->", 
                    RowBox[{"Association", " ", "@", " ", 
                    RowBox[{"Map", "[", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "->", 
                    RowBox[{"weightFunction", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}]}], " ", "&"}], ",", 
                    "\[IndentingNewLine]", "      ", "bestModes"}], 
                    "\[IndentingNewLine]", "    ", "]"}]}]}]}], 
                    "\[IndentingNewLine]", "  ", "|>"}]}]}], 
              "\[IndentingNewLine]", "]"}]}], ";"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "bf7ec34e-b9b8-804c-943d-7bd159fe057b"],
 "\n",
 Cell[BoxData[
