Cell[CellGroupData[{

Cell["8. Discrete amplification framework", "Section",ExpressionUUID->"bbb0e639-4dc1-3f4b-bfdb-60b08b5c862d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "effectiveGrowthFactor", ",", "amplificationSequence", ",", "birthStep"}],
     "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"effectiveGrowthFactor", "[", "lambda_", "]"}], ":=", 
    RowBox[{"1", "+", 
     RowBox[{"2", " ", 
      RowBox[{"lambda", "/", "Pi"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"amplificationSequence", "[", 
     RowBox[{"lambda_", ",", "steps_Integer", ",", 
      RowBox[{"amp0_", ":", " ", "1"}]}], "]"}], ":=", 
    RowBox[{"NestList", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", " ", 
        RowBox[{"effectiveGrowthFactor", "[", "lambda", "]"}]}], " ", "&"}], ",",
       "amp0", ",", "steps"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"birthStep", "[", 
    RowBox[{"threshold_", ",", "lambda_", ",", 
     RowBox[{"amp0_", ":", " ", "1"}], ",", 
     RowBox[{"maxSteps_", ":", " ", "1000"}]}], "]"}], ":=", 
   RowBox[{"FirstCase", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "maxSteps"}], "]"}], "->", 
       RowBox[{"amplificationSequence", "[", 
        RowBox[{"lambda", ",", "maxSteps", ",", "amp0"}], "]"}]}], "]"}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"step_", "->", "amp_"}], ")"}], " ", "/;", " ", 
       RowBox[{"amp", ">=", "threshold"}]}], ":>", "step"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Missing", "[", "\"\<NotReached\>\"", "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[71]:=",ExpressionUUID->"9647a667-cf1c-d64f-a3ae-2efbb4575b43"],

