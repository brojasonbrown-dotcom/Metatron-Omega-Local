 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"10. Medium law and resolution law for the next scale\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0a9a5a12-d5f7-bc44-992c-2fac2abbaf31"],
 "\nThis is where per-scale distinct physics gets encoded. \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            
            RowBox[{"scaleMediumLaw", ",", "scaleResolutionLaw", ",", 
              "scaleMeasurementWeight"}], "]"}], ";"}], "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"scaleMediumLaw", "[", "ontology_Association", "]"}], 
            ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"medium", "=", 
                    RowBox[{"ontology", "[", "\"MediumType\"", "]"}]}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"density", "=", 
                    
                    RowBox[{
                    "ontology", "[", "\"InformationDensityParameter\"", 
                    "]"}]}], ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"complexity", "=", 
                    
                    RowBox[{
                    "ontology", "[", "\"FieldComplexityParameter\"", 
                    "]"}]}]}], "\[IndentingNewLine]", "  ", "}"}], ",", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{"Switch", "[", 
                  
                  RowBox[{
                   "medium", ",", "\[IndentingNewLine]", "    ", 
                    "\"PreGeometric\"", ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"Permittivity\"", "->", "density"}], ",", 
                    RowBox[{"\"Permeability\"", "->", "complexity"}], ",", 
                    RowBox[{"\"Dispersion\"", "->", "0"}]}], "|>"}], ",", 
                    "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", 
                    "    ", "\"QuantumInformational\"", ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"Permittivity\"", "->", 
                    RowBox[{"density", "^", "2"}]}], ",", 
                    RowBox[{"\"Permeability\"", "->", 
                    RowBox[{"1", "/", "complexity"}]}], ",", 
                    RowBox[{"\"Dispersion\"", "->", 
                    RowBox[{"density", " ", "complexity"}]}]}], "|>"}], ",", 
                    "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", 
                    "    ", "\"FieldStructured\"", ",", "\[IndentingNewLine]",
                     "    ", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"Permittivity\"", "->", 
                    RowBox[{"density", " ", "complexity"}]}], ",", 
                    RowBox[{"\"Permeability\"", "->", 
                    RowBox[{"density", "^", 
                    RowBox[{"-", "1"}]}]}], ",", 
                    RowBox[{"\"Dispersion\"", "->", 
                    RowBox[{"complexity", "^", 
                    RowBox[{"-", "1"}]}]}]}], "|>"}], ",", 
                    "\[IndentingNewLine]", "    ", "\[IndentingNewLine]", 
                    "    ", "\"MacroscopicEmergent\"", ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"Permittivity\"", "->", "complexity"}], ",", 
                    RowBox[{"\"Permeability\"", "->", "density"}], ",", 
                    RowBox[{"\"Dispersion\"", "->", 
                    RowBox[{"density", "/", "complexity"}]}]}], "|>"}]}], 
                  "\[IndentingNewLine]", "  ", "]"}]}], "\[IndentingNewLine]",
               "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"scaleResolutionLaw", "[", "ontology_Association", "]"}], 
            ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"res", "=", 
                    
                    RowBox[{
                    "ontology", "[", "\"ResolutionParameter\"", "]"}]}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"info", "=", 
                    
                    RowBox[{
                    "ontology", "[", "\"InformationDensityParameter\"", 
                    "]"}]}]}], "\[IndentingNewLine]", "  ", "}"}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"<|", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"\"GridScale\"", "->", 
                    RowBox[{"1", "/", "res"}]}], ",", "\[IndentingNewLine]", 
                    "    ", 
                    RowBox[{"\"ObservationKernelWidth\"", "->", 
                    RowBox[{"1", "/", 
                    RowBox[{"Sqrt", "[", "res", "]"}]}]}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"EffectiveBandwidth\"", "->", 
                    RowBox[{"res", " ", "info"}]}]}], "\[IndentingNewLine]", 
                  "  ", "|>"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"scaleMeasurementWeight", "[", 
              RowBox[{"ontology_Association", ",", "mode_"}], "]"}], ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"info", "=", 
                    
                    RowBox[{
                    "ontology", "[", "\"InformationDensityParameter\"", 
                    "]"}]}], ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"res", "=", 
                    RowBox[{
                    "ontology", "[", "\"ResolutionParameter\"", "]"}]}]}], 
                  "\[IndentingNewLine]", "  ", "}"}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"info", " ", 
                  RowBox[{"res", "/", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    RowBox[{"Norm", "[", "mode", "]"}], "^", "2"}]}], 
                    ")"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "11e95517-4bb4-9a40-8f20-f23d8c59e329"],
