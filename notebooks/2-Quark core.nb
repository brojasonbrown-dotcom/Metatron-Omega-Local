     "coefficientAssociation", ",", "normalizedSphereField", ",", 
     "gramMatrixSphere", ",", "operatorMatrixSphere", ",", 
     "\[IndentingNewLine]", "  ", "bestSphereSuperposition"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sphereOperator", "[", "psi_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Laplacian", "[", 
      RowBox[{
       RowBox[{"psi", "[", 
        RowBox[{"theta", ",", "phi"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"theta", ",", "phi"}], "}"}], ",", "\"\<Spherical\>\""}], 
      "]"}], "+", 
     RowBox[{"sigma", " ", 
      RowBox[{"psi", "[", 
       RowBox[{"theta", ",", "phi"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"modeIndexSet", "[", "lMax_Integer", "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", ",", "m"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "0", ",", "lMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", 
          RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}], ",", "1"}], "]"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"coefficientVector", "[", "lMax_Integer", "]"}], ":=", 
    RowBox[{"Array", "[", 
     RowBox[{"c", ",", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"modeIndexSet", "[", "lMax", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"coefficientAssociation", "[", "lMax_Integer", "]"}], ":=", 
    RowBox[{"AssociationThread", "[", 
     RowBox[{
      RowBox[{"modeIndexSet", "[", "lMax", "]"}], ",", 
      RowBox[{"coefficientVector", "[", "lMax", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"normalizedSphereField", "[", "lMax_Integer", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"coeffs", "=", 
         RowBox[{"coefficientAssociation", "[", "lMax", "]"}]}], ",", "psi"}],
        "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"psi", "[", 
         RowBox[{"theta_", ",", "phi_"}], "]"}], "=", 
        RowBox[{
         RowBox[{"sphericalSuperposition", "[", "coeffs", "]"}], "[", 
         RowBox[{"theta", ",", "phi"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", "psi"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sphereResidualFunctional", "[", "lMax_Integer", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"psi", "=", 
        RowBox[{"normalizedSphereField", "[", "lMax", "]"}]}], ",", "res"}], 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"res", "=", 
       RowBox[{"sphereOperator", "[", "psi", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assuming", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"sigma", " ", "\[Element]", " ", "Reals"}], "}"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"Integrate", "[", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"ComplexExpand", "[", 
            RowBox[{
             RowBox[{"Conjugate", "[", "res", "]"}], " ", "res"}], "]"}], " ", 
           RowBox[{"Sin", "[", "theta", "]"}]}], ",", "\[IndentingNewLine]", 
          "      ", 
          RowBox[{"{", 
           RowBox[{"theta", ",", "0", ",", "Pi"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"phi", ",", "0", ",", 
            RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
          "      ", 
          RowBox[{"GenerateConditions", "->", "False"}]}], 
         "\[IndentingNewLine]", "    ", "]"}]}], "\[IndentingNewLine]", "  ", 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"97b4c785-e880-e440-869b-633402662fcd"],

Cell["\<\
For practical optimization, build the operator matrix directly in the \
orthonormal basis instead of integrating the full symbolic superposition \
repeatedly. \
\>", "Text",ExpressionUUID->"01e227e1-34b7-1243-8cbd-c5fbaa518a53"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "sphericalEigenvalue", ",", "operatorDiagonalSphere", ",", 
     "bestSphereMode"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sphericalEigenvalue", "[", 
     RowBox[{"{", 
      RowBox[{"l_Integer", ",", "m_Integer"}], "}"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"-", "l"}], " ", 
     RowBox[{"(", 
      RowBox[{"l", "+", "1"}], ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"operatorDiagonalSphere", "[", 
     RowBox[{"lMax_Integer", ",", "sigmaValue_"}], "]"}], ":=", 
    RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"sphericalEigenvalue", "[", "#", "]"}], "+", "sigmaValue"}], 
       " ", "&"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"modeIndexSet", "[", "lMax", "]"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bestSphereMode", "[", 
    RowBox[{"lMax_Integer", ",", "sigmaValue_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "diag", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"diag", "=", 
       RowBox[{"operatorDiagonalSphere", "[", 
        RowBox[{"lMax", ",", "sigmaValue"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"MinimalBy", "[", 
       RowBox[{
        RowBox[{"Normal", "[", "diag", "]"}], ",", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "&"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"4d4c8fe3-6efa-fb45-bb16-42fb3fe4d694"],

Cell["\<\
This is the most efficient linearized method: for diagonal operators in the \
spherical harmonic basis, the most stable mode is the one minimizing the \
operator eigenvalue magnitude. \
\>", "Text",ExpressionUUID->"01fc059a-657a-5849-96a1-abb283da74ee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6b. Toroidal residual using Fourier basis", "Subsection",ExpressionUUID->"f95cd257-ccc6-3d46-8086-34fa26b049b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "toroidalEigenvalue", ",", "torusOperatorDiagonal", ",", 
     "torusModeIndexSet", ",", "bestTorusMode"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusModeIndexSet", "[", 
     RowBox[{"mMax_Integer", ",", "nMax_Integer"}], "]"}], ":=", 
    RowBox[{"Flatten", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", 
          RowBox[{"-", "mMax"}], ",", "mMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"-", "nMax"}], ",", "nMax"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", "1"}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"toroidalEigenvalue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m_Integer", ",", "n_Integer"}], "}"}], ",", "majorRadius_", ",",
       "minorRadius_"}], "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"m", "^", "2"}], "/", 
        RowBox[{"majorRadius", "^", "2"}]}], "+", 
       RowBox[{
        RowBox[{"n", "^", "2"}], "/", 
        RowBox[{"minorRadius", "^", "2"}]}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusOperatorDiagonal", "[", 
     RowBox[{
     "mMax_Integer", ",", "nMax_Integer", ",", "majorRadius_", ",", 
      "minorRadius_", ",", "sigmaValue_"}], "]"}], ":=", 
    RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"toroidalEigenvalue", "[", 
         RowBox[{"#", ",", "majorRadius", ",", "minorRadius"}], "]"}], "+", 
        "sigmaValue"}], " ", "&"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"torusModeIndexSet", "[", 
       RowBox[{"mMax", ",", "nMax"}], "]"}]}], "\[IndentingNewLine]", "]"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bestTorusMode", "[", 
    RowBox[{
    "mMax_Integer", ",", "nMax_Integer", ",", "majorRadius_", ",", 
     "minorRadius_", ",", "sigmaValue_"}], "]"}], ":=", "\[IndentingNewLine]",
    "  ", 
   RowBox[{"MinimalBy", "[", 
    RowBox[{
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"torusOperatorDiagonal", "[", 
       RowBox[{
       "mMax", ",", "nMax", ",", "majorRadius", ",", "minorRadius", ",", 
        "sigmaValue"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "&"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"f68bc86a-492a-4140-a528-c0c51a29fecb"],

