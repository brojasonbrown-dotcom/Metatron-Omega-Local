 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox[Cell[TextData[{
     "13. Callable morphisms ",
     Cell[BoxData[
      FormBox[
       TemplateBox[<|"boxes" -> FormBox[
           RowBox[{
             StyleBox["L", "TI"], "0", "\[Rule]", 
             StyleBox["L", "TI"], "1", "\[Rule]", 
             StyleBox["L", "TI"], "2"}], TraditionalForm], "errors" -> {}, 
         "input" -> "L0 \\to L1 \\to L2", "state" -> "Boxes"|>,
        "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
      "d257c195-7088-8c48-9ec3-0bfe26258b10"]
    }],
     Background->None,ExpressionUUID->"cc247485-8f32-bc4a-a53b-8fad8a77f70e"],
     "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d6ce608b-14d3-7745-a828-0a2f774c9d98"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            
            RowBox[{"layer0ToLayer1", ",", "layer1ToLayer2", ",", 
              "fullOPFPipeline"}], "]"}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"layer0ToLayer1", "=", 
            RowBox[{"Function", "[", 
              RowBox[{
                RowBox[{"{", "currentN", "}"}], ",", "\[IndentingNewLine]", 
                "  ", 
                RowBox[{"Module", "[", 
                  RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"nNext", "=", 
                    RowBox[{"nextStableScale", "[", "currentN", "]"}]}], ",", 
                    "ontology"}], "}"}], ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"ontology", "=", 
                    RowBox[{"makeScaleOntology", "[", "nNext", "]"}]}], ";", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"<|", "\[IndentingNewLine]", "      ", 
                    RowBox[{
                    RowBox[{"\"ScaleIndex\"", "->", "nNext"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"Ontology\"", "->", "ontology"}], ",", 
                    "\[IndentingNewLine]", "      ", 
                    RowBox[{"\"Layer1EulerEquations\"", "->", 
                    RowBox[{"layer1EulerEquations", "[", "]"}]}]}], 
                    "\[IndentingNewLine]", "    ", "|>"}]}]}], 
                  "\[IndentingNewLine]", "  ", "]"}]}], "\[IndentingNewLine]",
               "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"layer1ToLayer2", "=", 
            RowBox[{"Function", "[", 
              RowBox[{
                RowBox[{"{", "assoc", "}"}], ",", "\[IndentingNewLine]", "  ", 
                RowBox[{"Module", "[", 
                  RowBox[{
                    RowBox[{"{", 
                    RowBox[{"ontology", ",", "spectral", ",", "measurement"}],
                     "}"}], ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"ontology", "=", 
                    RowBox[{"assoc", "[", "\"Ontology\"", "]"}]}], ";", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"spectral", "=", 
                    RowBox[{"scaleSpectralData", "[", 
                    RowBox[{"ontology", ",", "4", ",", "1"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"measurement", "=", 
                    RowBox[{"scaleMeasurementAssociation", "[", 
                    RowBox[{"ontology", ",", "spectral"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"Join", "[", 
                    RowBox[{"assoc", ",", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"SpectralData\"", "->", "spectral"}], ",", 
                    RowBox[{"\"Measurement\"", "->", "measurement"}]}], 
                    "|>"}]}], "]"}]}]}], "\[IndentingNewLine]", "  ", "]"}]}],
               "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"fullOPFPipeline", "=", 
            RowBox[{"layer0ToLayer1", " ", "/*", " ", "layer1ToLayer2"}]}], 
          ";"}]}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "62bcaea5-bbdd-5d48-892a-9b748c7c283e"],
 "\nUsage: \n",
 Cell[BoxData[
