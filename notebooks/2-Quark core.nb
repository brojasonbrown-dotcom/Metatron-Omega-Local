 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"5. Missing-variable analysis, properly implemented\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"5c22de36-5bb4-0348-9129-87cd94cdb616"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            
            RowBox[{"layer1Symbols", ",", "standardModelConstants", ",", 
              "missingVariablesLayer1"}], "]"}], ";"}], "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"layer1Symbols", "[", "expr_", "]"}], ":=", 
            RowBox[{"DeleteDuplicates", " ", "@", " ", 
              RowBox[{"Cases", "[", "\[IndentingNewLine]", "  ", 
                RowBox[{"expr", ",", "\[IndentingNewLine]", "  ", 
                  RowBox[{"s_Symbol", " ", "/;", " ", 
                    RowBox[{
                    RowBox[{"Context", "[", "s", "]"}], "=!=", 
                    "\"System`\""}]}], ",", "\[IndentingNewLine]", "  ", 
                  "Infinity"}], "\[IndentingNewLine]", "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"standardModelConstants", "=", 
            RowBox[{"{", 
              
              RowBox[{"c", ",", "h", ",", "\[HBar]", ",", "G", ",", "kB", ",",
                 "e", ",", "me", ",", "mp"}], "}"}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"missingVariablesLayer1", "[", "expr_", "]"}], ":=", 
            RowBox[{"Complement", "[", 
              RowBox[{
                RowBox[{"layer1Symbols", "[", "expr", "]"}], ",", 
                "standardModelConstants"}], "]"}]}], ";"}]}]], "ChatCode", 
     "Input", LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "8bf14ede-0d0f-3145-a6e7-bf7361117a11"],
 "\nUsage: \n",
 Cell[BoxData[
