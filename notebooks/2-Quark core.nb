Cell[TextData[{
 "entity-backed physical calibration using ",
 Cell[BoxData[
  TemplateBox[<|"query" -> "...", "boxes" -> InterpretationBox["", 
      Failure[
      "TimedOut", <|
       "MessageTemplate" -> 
        "A network operation timed out. Please try again later.", 
        "MessageParameters" -> <||>, "Query" -> "..."|>]], 
    "allassumptions" -> {}, "assumptions" -> {}, "open" -> {1, 2}, 
    "querystate" -> {
     "Online" -> True, "Allowed" -> True, "$TimedOut" -> 
      5.1509892`8.163435632798931, "Messages" -> {}}, "contextinfo" -> 
    Automatic, "version" -> 5|>,
   "LinguisticAssistantTemplate"]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "a149fc7b-6bf6-034b-943c-b3d3b279447a"],
 " natural language entities if you want to anchor scales to known systems"
}], "Item",ExpressionUUID->"50716e69-7910-5b4c-b2fd-eb4f56b69667"],

