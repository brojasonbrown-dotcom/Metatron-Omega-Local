Cell["Example: ", "CodeText",ExpressionUUID->"4aaca45f-3bdb-1547-b875-b9fdc1ba82fb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sphericalCoefficientRules", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], "->", "c00"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "->", "c10"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "->", "c11"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "}"}], "->", "c1m1"}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"psiSphere", "=", 
   RowBox[{
    RowBox[{"sphericalSuperposition", "[", "sphericalCoefficientRules", "]"}],
     "[", 
    RowBox[{"theta", ",", "phi"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"ceec1fe0-f3d3-d94c-be32-4739694ee08b"]
}, Open  ]],

