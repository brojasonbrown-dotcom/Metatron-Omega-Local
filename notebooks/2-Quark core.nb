Cell[CellGroupData[{

Cell["9. Measurement kernel (Layer-2 map)", "Section",ExpressionUUID->"88de6638-7f41-164d-b53d-a353f39e1252"],

Cell["\<\
We encode the measured observable as an eigenbasis integral or discrete modal \
sum. \
\>", "Text",ExpressionUUID->"fc9e38a8-c231-5144-8205-77fa597643e4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"measurementKernel", ",", "modalObservable"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measurementKernel", "[", 
     RowBox[{"psi_", ",", "vars_List", ",", "region_"}], "]"}], ":=", 
    RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"psi", " ", "@@", " ", "vars"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"Evaluate", " ", "@", " ", "Sequence"}], " ", "@@", " ", 
       "region"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modalObservable", "[", 
    RowBox[{"coeffs_Association", ",", "weights_Association"}], "]"}], ":=", 
   RowBox[{"Total", " ", "@", " ", 
    RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Conjugate", "[", "#2", "]"}], " ", 
        RowBox[{"weights", "[", "#1", "]"}], " ", "#2"}], " ", "&"}], ",", 
      "\[IndentingNewLine]", "  ", "coeffs"}], "\[IndentingNewLine]", 
     "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"2ffa1021-897f-504e-bfde-c553639b6aa8"],

Cell["\<\
For orthonormal modal bases, this is much more efficient than direct grid \
integration. \
\>", "Text",ExpressionUUID->"bf50d30f-7e98-f44f-a0c3-09f908f1cab8"],

