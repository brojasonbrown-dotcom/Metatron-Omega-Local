Cell["\<\
Because the given density has no derivative terms, the Euler equations are \
algebraic stationarity conditions. To obtain nontrivial propagating PDE \
structure, add gradient regularization terms: \
\>", "CodeText",ExpressionUUID->"406889bd-e1bb-df43-b083-c93ba219373a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "gradientWeights", ",", "regularizedDensity", ",", 
     "regularizedEulerEqns"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gradientWeights", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Rho\>\"", "->", "alphaRho"}], ",", 
      RowBox[{"\"\<Chi\>\"", "->", "alphaChi"}], ",", 
      RowBox[{"\"\<Resolution\>\"", "->", "alphaRes"}]}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"regularizedDensity", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"rhoField", " ", 
      RowBox[{"Log", "[", "chiField", "]"}]}], "+", 
     RowBox[{"chiField", " ", 
      RowBox[{"resolutionField", "^", "2"}]}], "+", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"gradientWeights", "[", "\"\<Rho\>\"", "]"}], " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"Grad", "[", 
         RowBox[{"rhoField", ",", "coords"}], "]"}], "]"}], "^", "2"}]}], "+",
      "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"gradientWeights", "[", "\"\<Chi\>\"", "]"}], " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"Grad", "[", 
         RowBox[{"chiField", ",", "coords"}], "]"}], "]"}], "^", "2"}]}], "+",
      "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"gradientWeights", "[", "\"\<Resolution\>\"", "]"}], " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"Grad", "[", 
         RowBox[{"resolutionField", ",", "coords"}], "]"}], "]"}], "^", 
       "2"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"regularizedEulerEqns", "=", 
    RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rhoField", ",", "chiField", ",", "resolutionField"}], "}"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"VariationalD", "[", 
           RowBox[{"regularizedDensity", ",", "#", ",", "coords"}], "]"}], 
          " ", "//", " ", "FullSimplify"}], ")"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"rhoField", ",", "chiField", ",", "resolutionField"}], 
        "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "regularizedEulerEqns"}], \
"Input",
 CellLabel->"In[23]:=",ExpressionUUID->"b2747ebf-2266-e44e-82e9-bdf24b045852"],

