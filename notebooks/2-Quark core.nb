Cell[CellGroupData[{

Cell["4. Stable resonances from linearization", "Section",ExpressionUUID->"7db34bfb-4ee2-0747-93f0-e6a4a073da95"],

Cell[TextData[{
 "We linearize around a homogeneous background: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", 
         SubscriptBox["\[Rho]", "0"], "+", "\[Delta]\[Rho]", ",  ", "\[Chi]", 
         "\[LongEqual]", 
         SubscriptBox["\[Chi]", "0"], "+", "\[Delta]\[Chi]", ",  ", 
         StyleBox["R", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["R", "TI"], "0"], "+", "\[Delta]", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho = \\rho_0 + \\delta \\rho, \\quad \\chi = \\chi_0 + \\delta \
\\chi, \\quad R = R_0 + \\delta R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "13a69fe1-ee16-8e4d-8984-2f6b7f0c3526"],
 "and extract the stiffness matrix from the potential part. "
}], "Text",ExpressionUUID->"55414477-700a-6d41-889a-9c53b4c22f3f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "rho0", ",", "chi0", ",", "res0", ",", "drho", ",", "dchi", ",", "dres", ",",
      "potentialPart", ",", "fluctuationPotential", ",", 
     "\[IndentingNewLine]", "  ", "stiffnessMatrix", ",", 
     "stiffnessEigenvalues", ",", "stableFrequencies"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"potentialPart", "[", 
     RowBox[{"rho_", ",", "chi_", ",", "res_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"rho", " ", 
      RowBox[{"Log", "[", "chi", "]"}]}], "+", 
     RowBox[{"chi", " ", 
      RowBox[{"res", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fluctuationPotential", "=", 
    RowBox[{"Normal", " ", "@", " ", 
     RowBox[{"Series", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"potentialPart", "[", 
        RowBox[{
         RowBox[{"rho0", "+", "drho"}], ",", 
         RowBox[{"chi0", "+", "dchi"}], ",", 
         RowBox[{"res0", "+", "dres"}]}], "]"}], ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"{", 
        RowBox[{"drho", ",", "0", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"dchi", ",", "0", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"dres", ",", "0", ",", "2"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stiffnessMatrix", "=", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"potentialPart", "[", 
           RowBox[{
            RowBox[{"rho0", "+", "drho"}], ",", 
            RowBox[{"chi0", "+", "dchi"}], ",", 
            RowBox[{"res0", "+", "dres"}]}], "]"}], ",", "var1", ",", 
          "var2"}], "]"}], " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"drho", "->", "0"}], ",", 
          RowBox[{"dchi", "->", "0"}], ",", 
          RowBox[{"dres", "->", "0"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"{", 
        RowBox[{"var1", ",", 
         RowBox[{"{", 
          RowBox[{"drho", ",", "dchi", ",", "dres"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"var2", ",", 
         RowBox[{"{", 
          RowBox[{"drho", ",", "dchi", ",", "dres"}], "}"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], " ", "//", " ", "FullSimplify"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stiffnessEigenvalues", "=", 
    RowBox[{"Eigenvalues", "[", 
     RowBox[{"stiffnessMatrix", ",", 
      RowBox[{"Cubics", "->", "True"}], ",", 
      RowBox[{"Quartics", "->", "True"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stableFrequencies", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"stiffnessEigenvalues", ",", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Re", "[", "#", "]"}], "==", "0"}], "&&", 
         RowBox[{
          RowBox[{"Im", "[", "#", "]"}], ">", "0"}]}], "]"}], " ", "&"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"<|", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"\"\<StiffnessMatrix\>\"", "->", "stiffnessMatrix"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Eigenvalues\>\"", "->", "stiffnessEigenvalues"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<UndampedHarmonicModes\>\"", "->", "stableFrequencies"}]}], 
  "\[IndentingNewLine]", "|>"}]}], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"71792691-abe6-ff48-9530-9e228b6d7f39"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"StiffnessMatrix\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", 
        FractionBox["1", "chi0"], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["1", "chi0"], ",", 
        RowBox[{"-", 
         FractionBox["rho0", 
          SuperscriptBox["chi0", "2"]]}], ",", 
        RowBox[{"2", " ", "res0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"2", " ", "res0"}], ",", 
        RowBox[{"2", " ", "chi0"}]}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Eigenvalues\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        SuperscriptBox["chi0", "2"]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", "3"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", 
             SuperscriptBox["chi0", "3"]}], "-", "rho0"}], ")"}]}], "-", 
         FractionBox[
          RowBox[{
           SuperscriptBox["2", 
            RowBox[{"1", "/", "3"}]], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "3"}], " ", 
              SuperscriptBox["chi0", "2"]}], "-", 
             RowBox[{"4", " ", 
              SuperscriptBox["chi0", "6"]}], "-", 
             RowBox[{"12", " ", 
              SuperscriptBox["chi0", "4"], " ", 
              SuperscriptBox["res0", "2"]}], "-", 
             RowBox[{"2", " ", 
              SuperscriptBox["chi0", "3"], " ", "rho0"}], "-", 
             SuperscriptBox["rho0", "2"]}], ")"}]}], 
          RowBox[{"3", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "36"}], " ", 
               SuperscriptBox["chi0", "5"]}], "+", 
              RowBox[{"16", " ", 
               SuperscriptBox["chi0", "9"]}], "+", 
              RowBox[{"72", " ", 
               SuperscriptBox["chi0", "7"], " ", 
               SuperscriptBox["res0", "2"]}], "-", 
              RowBox[{"9", " ", 
               SuperscriptBox["chi0", "2"], " ", "rho0"}], "+", 
              RowBox[{"12", " ", 
               SuperscriptBox["chi0", "6"], " ", "rho0"}], "-", 
              RowBox[{"36", " ", 
               SuperscriptBox["chi0", "4"], " ", 
               SuperscriptBox["res0", "2"], " ", "rho0"}], "-", 
              RowBox[{"6", " ", 
               SuperscriptBox["chi0", "3"], " ", 
               SuperscriptBox["rho0", "2"]}], "-", 
              RowBox[{"2", " ", 
               SuperscriptBox["rho0", "3"]}], "+", 
              SqrtBox[
               RowBox[{
                RowBox[{"4", " ", 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", "3"}], " ", 
                    SuperscriptBox["chi0", "2"]}], "-", 
                    RowBox[{"4", " ", 
                    SuperscriptBox["chi0", "6"]}], "-", 
                    RowBox[{"12", " ", 
                    SuperscriptBox["chi0", "4"], " ", 
                    SuperscriptBox["res0", "2"]}], "-", 
                    RowBox[{"2", " ", 
                    SuperscriptBox["chi0", "3"], " ", "rho0"}], "-", 
                    SuperscriptBox["rho0", "2"]}], ")"}], "3"]}], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "36"}], " ", 
                    SuperscriptBox["chi0", "5"]}], "+", 
                   RowBox[{"16", " ", 
                    SuperscriptBox["chi0", "9"]}], "+", 
                   RowBox[{"72", " ", 
                    SuperscriptBox["chi0", "7"], " ", 
                    SuperscriptBox["res0", "2"]}], "-", 
                   RowBox[{"9", " ", 
                    SuperscriptBox["chi0", "2"], " ", "rho0"}], "+", 
                   RowBox[{"12", " ", 
                    SuperscriptBox["chi0", "6"], " ", "rho0"}], "-", 
                   RowBox[{"36", " ", 
                    SuperscriptBox["chi0", "4"], " ", 
                    SuperscriptBox["res0", "2"], " ", "rho0"}], "-", 
                   RowBox[{"6", " ", 
                    SuperscriptBox["chi0", "3"], " ", 
                    SuperscriptBox["rho0", "2"]}], "-", 
                   RowBox[{"2", " ", 
                    SuperscriptBox["rho0", "3"]}]}], ")"}], "2"]}]]}], ")"}], 
            RowBox[{"1", "/", "3"}]]}]], "+", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "36"}], " ", 
              SuperscriptBox["chi0", "5"]}], "+", 
             RowBox[{"16", " ", 
              SuperscriptBox["chi0", "9"]}], "+", 
             RowBox[{"72", " ", 
              SuperscriptBox["chi0", "7"], " ", 
              SuperscriptBox["res0", "2"]}], "-", 
             RowBox[{"9", " ", 
              SuperscriptBox["chi0", "2"], " ", "rho0"}], "+", 
             RowBox[{"12", " ", 
              SuperscriptBox["chi0", "6"], " ", "rho0"}], "-", 
             RowBox[{"36", " ", 
              SuperscriptBox["chi0", "4"], " ", 
              SuperscriptBox["res0", "2"], " ", "rho0"}], "-", 
             RowBox[{"6", " ", 
              SuperscriptBox["chi0", "3"], " ", 
