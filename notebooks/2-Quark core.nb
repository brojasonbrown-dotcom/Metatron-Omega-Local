Cell[CellGroupData[{

Cell["10. Full composable pipeline", "Section",ExpressionUUID->"81df3f70-b751-db4f-ad11-b4f5c4163bef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "layer0ToLayer1", ",", "layer1ToSpectrum", ",", "spectrumToMeasurement", ",",
      "fullPipeline"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layer0ToLayer1", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"n", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<ScaleData\>\"", "->", 
         RowBox[{"scaleAssociation", "[", "n", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<TorusRadii\>\"", "->", 
         RowBox[{"torusRadiiAtScale", "[", "n", "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layer1ToSpectrum", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"data", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "=", 
           RowBox[{"data", "[", 
            RowBox[{"\"\<ScaleData\>\"", ",", "\"\<ScaleIndex\>\""}], "]"}]}],
           ",", "radii"}], "}"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"radii", "=", 
          RowBox[{"data", "[", "\"\<TorusRadii\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<BestToroidalMode\>\"", "->", 
            RowBox[{"bestTorusMode", "[", "\[IndentingNewLine]", "        ", 
             RowBox[{"4", ",", "4", ",", "\[IndentingNewLine]", "        ", 
              RowBox[{"QuantityMagnitude", "[", 
               RowBox[{
                RowBox[{"radii", "[", "\"\<MajorRadius\>\"", "]"}], 
                ",", "\"\<Meters\>\""}], "]"}], ",", "\[IndentingNewLine]", 
              "        ", 
              RowBox[{"QuantityMagnitude", "[", 
               RowBox[{
                RowBox[{"radii", "[", "\"\<MinorRadius\>\"", "]"}], 
                ",", "\"\<Meters\>\""}], "]"}], ",", "\[IndentingNewLine]", 
              "        ", "1"}], "\[IndentingNewLine]", "      ", "]"}]}], ",",
            "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<BestSphericalMode\>\"", "->", 
            RowBox[{"bestSphereMode", "[", 
             RowBox[{"4", ",", "1"}], "]"}]}]}], "\[IndentingNewLine]", 
          "    ", "|>"}]}]}], "\[IndentingNewLine]", "  ", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spectrumToMeasurement", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"spec", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<ToroidalObservableProxy\>\"", "->", 
         RowBox[{"spec", "[", "\"\<BestToroidalMode\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SphericalObservableProxy\>\"", "->", 
         RowBox[{"spec", "[", "\"\<BestSphericalMode\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fullPipeline", "=", 
   RowBox[{
   "layer0ToLayer1", " ", "/*", " ", "layer1ToSpectrum", " ", "/*", " ", 
    "spectrumToMeasurement"}]}], ";"}]}], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"bc4897b6-087b-4d44-a011-6ddd134eed84"],

Cell["Example: ", "CodeText",ExpressionUUID->"65bdbbf7-8fc4-794b-9286-fe7c858b79a4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"fullPipeline", "[", "0", "]"}], "\[IndentingNewLine]", 
 RowBox[{"fullPipeline", "[", "firstStableScale", "]"}]}], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"ccb3a03a-c31b-cc4c-aff5-fc03c73716ca"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ToroidalObservableProxy\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], "\[Rule]", "1.`"}], "}"}]}], ",", 
   RowBox[{"\<\"SphericalObservableProxy\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], "\[Rule]", "1"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "}"}], "\[Rule]", 
       RowBox[{"-", "1"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], "\[Rule]", 
       RowBox[{"-", "1"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "\[Rule]", 
       RowBox[{"-", "1"}]}]}], "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.994129462403677*^9},
 CellLabel->"Out[83]=",ExpressionUUID->"a2e8ce49-3a15-1c48-8f09-c84d1cfe1642"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ToroidalObservableProxy\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], "\[Rule]", "1.`"}], "}"}]}], ",", 
   RowBox[{"\<\"SphericalObservableProxy\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
