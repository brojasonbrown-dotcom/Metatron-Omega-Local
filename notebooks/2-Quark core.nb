Cell[CellGroupData[{

Cell["12. Recommended workflow for your project", "Section",ExpressionUUID->"276752fa-82ed-cd4a-88b6-764bf36afa17"],

Cell[CellGroupData[{

Cell["Planck scale", "Subsection",ExpressionUUID->"59bbfcc4-39d8-4448-9727-a2c3e720701c"],

Cell[TextData[{
 "1. Compute ",
 Cell[BoxData[Cell["scaleAssociation[0]",
   Background->None,ExpressionUUID->"d2f8e4de-cb85-3841-ab26-743711813918"]], 
  "InlineCode",ExpressionUUID->"d613c378-53b5-ba40-a66f-3b648a4f531e"],
 "."
}], "Text",ExpressionUUID->"15d1d143-22f0-0d4b-ad23-8edd30cfd6ab"],

Cell[TextData[{
 "2. Use ",
 Cell[BoxData[Cell["bestSphereMode",
   Background->None,ExpressionUUID->"aead5bb7-ee77-cb4f-896d-afd717881518"]], 
  "InlineCode",ExpressionUUID->"50938cd7-6e39-4c49-bb7d-659bba626c3c"],
 " and ",
 Cell[BoxData[Cell["bestTorusMode",
   Background->None,ExpressionUUID->"90a7e0cd-2920-ce44-9fe3-dc5894ba2fab"]], 
  "InlineCode",ExpressionUUID->"d7b3cc30-390e-4648-9023-d74aacf301cd"],
 " to identify linearized most-stable modes."
}], "Text",ExpressionUUID->"7a429e61-f454-3044-88cc-5374ae0e82f0"],

Cell[TextData[{
 "3. Use ",
 Cell[BoxData[Cell["birthStep[13, 1/phi^2]",
   Background->None,ExpressionUUID->"cf2cff98-6f20-9c46-a74a-30aa3c42f4e1"]], 
  "InlineCode",ExpressionUUID->"f06a60bf-3d86-0d4c-a37d-786d520caf6d"],
 " as a first amplification proxy."
}], "Text",ExpressionUUID->"050b8283-1825-b047-adc0-149463ac515d"],

Cell["\<\
4. Replace the proxy with a full coefficient evolution once the operator is \
fixed. \
\>", "Text",ExpressionUUID->"e178367f-4663-1944-ac2d-bc44d5523f9d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["First stable toroidal scale", "Subsection",ExpressionUUID->"4a1d92bc-966e-8d49-ba11-a9161c2be4e6"],

Cell[TextData[{
 "1. Compute ",
 Cell[BoxData[Cell["firstStableScale",
   Background->None,ExpressionUUID->"4c752add-3fbd-574c-ac28-b76d2bc77595"]], 
  "InlineCode",ExpressionUUID->"7f4d8644-b21b-5f4d-8a46-a5b29c1b5411"],
 "."
}], "Text",ExpressionUUID->"717fd6a6-0fce-2e49-9b2a-76b395204bd1"],

Cell[TextData[{
 "2. Build radii using ",
 Cell[BoxData[Cell["torusRadiiAtScale[firstStableScale]",
   Background->None,ExpressionUUID->"5bb68f9a-2cf0-724c-9e55-98e7ff0cdcab"]], 
  "InlineCode",ExpressionUUID->"2199de27-7e73-5a4e-ad6e-1a0f7c099e86"],
 "."
}], "Text",ExpressionUUID->"4274d178-0d5b-e747-ad26-d738e835a706"],

Cell["3. Use Fourier torus modes for the sensory field.", "Text",ExpressionUUID->"fa27731c-68d9-f244-8111-5d4ed84a530b"],

Cell["\<\
4. Construct a finite-dimensional operator matrix and solve its eigensystem.\
\>", "Text",ExpressionUUID->"722c2682-96b4-504a-af39-66ae95d835f6"],

Cell["5. Select the mode or superposition with minimal residual. ", "Text",ExpressionUUID->"0aef512e-5c28-b341-8dc8-1a26b02c94b4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Across all stable scales", "Subsection",ExpressionUUID->"877a1f12-a38c-6041-9f24-5a45477b065f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"stableScales", "=", 
   RowBox[{"stableScaleIndices", "[", "294", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scaleFramework", "=", 
   RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"n", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"<|", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"\"\<ScaleData\>\"", "->", 
          RowBox[{"scaleAssociation", "[", "n", "]"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"\"\<PipelineOutput\>\"", "->", 
          RowBox[{"fullPipeline", "[", "n", "]"}]}]}], "\[IndentingNewLine]", 
        "    ", "|>"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
     "\[IndentingNewLine]", "  ", "stableScales"}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"10577a50-5b99-b749-a631-90172bb4aa6b"],

