Cell[TextData[{
 "1. ",
 StyleBox["Refine Layer 1 into a true PDE action",
  FontWeight->Bold],
 "2. ",
 StyleBox["Build a torus parameterization and toroidal closure residual",
  FontWeight->Bold],
 "3. ",
 StyleBox["Add linearization and eigenspectrum tests",
  FontWeight->Bold],
 "4. ",
 StyleBox["Add convergence-under-precision tests",
  FontWeight->Bold],
 "5. ",
 StyleBox["Create an interactive exploration interface",
  FontWeight->Bold]
}], "Text",
 CellChangeTimes->{
  3.9938248332913017`*^9},ExpressionUUID->"ce83afd0-2ecb-4940-b933-\
7060e7fd13b4"],

