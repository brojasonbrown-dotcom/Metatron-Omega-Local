Cell[CellGroupData[{

Cell["9. Layer 2 measurement kernel", "Section",ExpressionUUID->"a836ca53-5a58-2540-ae70-1ccdb6833d49"],

Cell["\<\
Define a measurement map as a normalized integral over the domain. \
\>", "Text",ExpressionUUID->"3384cbdb-d83b-d34f-847b-115d7aa5e57a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "measurementKernel", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementKernel", "[", 
    RowBox[{"psi_", ",", "radMax_", ",", 
     RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", 
   RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"psi", "[", 
       RowBox[{"r", ",", "theta", ",", "phiAngle"}], "]"}], " ", 
      RowBox[{"r", "^", "2"}], " ", 
      RowBox[{"Sin", "[", "theta", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "radMax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"theta", ",", "0", ",", "Pi"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"phiAngle", ",", "0", ",", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"WorkingPrecision", "->", "wp"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"AccuracyGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"PrecisionGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
        RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"833bf06c-7ce5-924c-9ec7-bdd997f6b40c"],

Cell["Maintenance operator residual for a time-dependent field: ", "CodeText",ExpressionUUID->"cec4eaa3-2dff-9041-8633-228b0742bd08"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "maintenanceResidual", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maintenanceResidual", "[", 
    RowBox[{"psi_", ",", "gammaValue_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"psi", "[", "t", "]"}], ",", "t"}], "]"}], "+", 
    RowBox[{"gammaValue", " ", 
     RowBox[{"psi", "[", "t", "]"}]}]}]}], ";"}]}], "Input",ExpressionUUID->\
"f2797ae9-1a9a-184b-bb1a-16af587b2b30"],

