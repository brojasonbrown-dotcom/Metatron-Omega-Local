   RowBox[{"{", 
    RowBox[{"rho", ",", "chi", ",", "res"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"standardModelParameterPlaceholders", "=", 
    RowBox[{"{", 
     RowBox[{
     "c", ",", "hbar", ",", "elementaryCharge", ",", "electronMass", ",", 
      "quarkMass"}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"missingVariables", "[", "]"}], ":=", 
   RowBox[{"Complement", "[", 
    RowBox[{"layer1Variables", ",", "standardModelParameterPlaceholders"}], 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"e22a6ff7-44e5-474b-84cd-\
d4982ac03487"],

