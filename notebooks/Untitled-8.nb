Cell[CellGroupData[{

Cell["2. Kernel assumptions and precision policy", "Section",ExpressionUUID->"f98d5359-5cb3-2e40-9469-53528a81b555"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "setFrameworkPrecision", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"setFrameworkPrecision", "[", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"$Assumptions", "=", 
      RowBox[{
       RowBox[{"Element", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "r", ",", "theta", ",", "phiAngle", ",", "t", ",", "rho", ",", 
           "chi", ",", "res", ",", "gamma", ",", "kappa"}], "}"}], ",", 
         "Reals"}], "]"}], "&&", 
       RowBox[{
        RowBox[{"\\\n", "    ", "r"}], ">=", "0"}], "&&", 
       RowBox[{"0", "<=", "theta", "<=", "Pi"}], "&&", 
       RowBox[{"0", "<=", "phiAngle", "<=", 
        RowBox[{"2", " ", "Pi"}]}], "&&", 
       RowBox[{"res", ">", "0"}], "&&", 
       RowBox[{"chi", ">", "0"}]}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"$MaxExtraPrecision", "=", "1000"}], ";"}], 
    "\[IndentingNewLine]", ")"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"setFrameworkPrecision", "[", "]"}], ";"}]}], "Input",ExpressionUUID\
->"4c4156b1-6fab-fb46-9b05-08c8b5635283"],

Cell[TextData[{
 "Note: exact ",
 Cell[BoxData[
  RowBox[{"WorkingPrecision", "->", "Infinity"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "ac10b97c-4f4d-7945-99f4-209f9beb6014"],
 " is not a valid executable setting for general numerical integration in \
Wolfram Language. For the testing suite we therefore use: "
}], "Text",ExpressionUUID->"9ae2ddcf-3e7c-d84a-b41e-9772ba045552"],

Cell["exact arithmetic when possible,", "Item",ExpressionUUID->"14d03b80-1dae-fa49-9560-8d9a393adc8f"],

Cell["symbolic integration when possible,", "Item",ExpressionUUID->"c5ae10c7-813f-1d46-8225-3af375d7cc5b"],

Cell["\<\
otherwise high finite precision with explicit residual checks.\
\>", "Item",ExpressionUUID->"e5f4f688-19a8-fe4e-9d20-fd4ec5c21bcf"],

