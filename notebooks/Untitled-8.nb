Cell[CellGroupData[{

Cell["4. Layer 0: symbolic topological seed", "Section",ExpressionUUID->"ea51ea5d-2528-8740-9a93-1b5b3ced745c"],

Cell["\<\
We encode a minimal symbolic Layer 0 seed rather than an overcommitted \
geometric claim. \
\>", "Text",ExpressionUUID->"4b452959-8eae-9a42-8a57-58e6ccc08670"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "layer0Seed", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layer0Seed", "[", "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Topology\>\"", "->", "\"\<SphereBoundaryDuality\>\""}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Vertices\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "Infinity"}], "}"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<TemporalMode\>\"", "->", "\"\<Timeless\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Substrate\>\"", "->", "\"\<EmptySpacetime\>\""}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"a17325a6-7ba6-bc48-a620-bfbbc783977e"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
