Cell[CellGroupData[{

Cell["5. Layer 1: variational field model", "Section",ExpressionUUID->"dfe5a351-7ba4-fd44-aceb-2fbdd12e51f7"],

Cell[TextData[{
 "Your OPF action is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "\[LongEqual]", "\[Integral]", 
         RowBox[{"(", 
           RowBox[{"\[Rho]", "log", 
             RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
             SuperscriptBox[
              StyleBox["R", "TI"], "2"]}], ")"}], "\[DifferentialD]", 
         "\[CapitalOmega]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "S = \\int (\\rho \\log(\\chi) + \\chi R^2) \\, d\\Omega", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e02222be-da6a-e64e-bb29-0c2ee112b9fe"],
 "To make this computationally testable, we model the fields as scalar \
functions over spherical coordinates: "
}], "Text",ExpressionUUID->"aed88ca5-0a76-134c-a2b9-37bbb720daee"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{"\[Rho]", "\[LongEqual]", "\[Rho]", 
        RowBox[{"(", 
          RowBox[{
            StyleBox["r", "TI"], ",", "\[Theta]", ",", "\[Phi]"}], ")"}]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "\\rho = \\rho(r,\\theta,\\phi)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"bcd6d482-4f47-1145-8d7d-4b9402cb493f"]], \
"Item",ExpressionUUID->"e62eb139-19b6-ed49-911f-3870e98491d7"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{"\[Chi]", "\[LongEqual]", "\[Chi]", 
        RowBox[{"(", 
          RowBox[{
            StyleBox["r", "TI"], ",", "\[Theta]", ",", "\[Phi]"}], ")"}]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "\\chi = \\chi(r,\\theta,\\phi)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"29698242-9094-d943-829b-a8bd2d5860f4"]], \
"Item",ExpressionUUID->"49aa8774-e42f-2e4a-916b-bccb701e9133"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", 
         StyleBox["R", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["r", "TI"], ",", "\[Theta]", ",", "\[Phi]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> "R = R(r,\\theta,\\phi)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fd0650ff-b844-5843-98fa-73c830d86fe2"],
 " or a scale parameter ",
 StyleBox["res", "TI"]
}], "Item",ExpressionUUID->"781188a8-4794-2542-b4de-76e4d32da7d8"],

Cell[TextData[{
 "For the first frame we use a local density: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], ")"}], "\[LongEqual]", "\[Rho]", "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L}(\\rho,\\chi,R) = \\rho \\log(\\chi) + \\chi R^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30002352-2242-ca4f-91e8-12b3bb01c43f"],
 "and treat the fields independently first. "
}], "Text",ExpressionUUID->"2627ecc1-1235-3046-9c5b-c653433fea58"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "rhoField", ",", "chiField", ",", "resField", ",", "lagrangianDensity"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoField", "=", 
   RowBox[{"rhoField", "[", 
    RowBox[{"r", ",", "theta", ",", "phiAngle"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"chiField", "=", 
   RowBox[{"chiField", "[", 
    RowBox[{"r", ",", "theta", ",", "phiAngle"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"resField", "=", 
    RowBox[{"resField", "[", 
     RowBox[{"r", ",", "theta", ",", "phiAngle"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lagrangianDensity", "[", 
    RowBox[{"rho_", ",", "chi_", ",", "res_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"rho", " ", 
     RowBox[{"Log", "[", "chi", "]"}]}], "+", 
    RowBox[{"chi", " ", 
     RowBox[{"res", "^", "2"}]}]}]}], ";"}]}], "Input",ExpressionUUID->\
"dbd9339f-537e-aa41-95ee-70e47c86707a"],

Cell["Volume element in spherical coordinates: ", "CodeText",ExpressionUUID->"d002eb04-efd2-8e43-bc5b-61105c0029bb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "sphericalMeasure", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sphericalMeasure", "[", 
    RowBox[{"r_", ",", "theta_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"r", "^", "2"}], " ", 
    RowBox[{"Sin", "[", "theta", "]"}]}]}], ";"}]}], "Input",ExpressionUUID->\
"4563bcfd-3c13-a543-bad7-3f1f8b10fc49"],

Cell[TextData[{
 "Action on a finite ball of radius ",
 Cell[BoxData[Cell["radMax",
   Background->None,ExpressionUUID->"a77512ff-ad2e-7045-ad94-0cf533ed54eb"]], 
  "InlineCode",ExpressionUUID->"9031ad14-2740-1342-95de-676128cd458b"],
 ": "
}], "CodeText",ExpressionUUID->"f7eab3d9-b30b-7f4d-bc05-ee8d750bf675"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "actionFunctional", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"actionFunctional", "[", "radMax_", "]"}], ":=", 
   RowBox[{"Integrate", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"lagrangianDensity", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"rhoField", "[", 
         RowBox[{"r", ",", "theta", ",", "phiAngle"}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"chiField", "[", 
         RowBox[{"r", ",", "theta", ",", "phiAngle"}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"resField", "[", 
         RowBox[{"r", ",", "theta", ",", "phiAngle"}], "]"}]}], 
       "\[IndentingNewLine]", "  ", "]"}], " ", 
      RowBox[{"sphericalMeasure", "[", 
       RowBox[{"r", ",", "theta"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "radMax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"theta", ",", "0", ",", "Pi"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"phiAngle", ",", "0", ",", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"radMax", ">", "0"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"f79bd93d-8ca3-5f40-b9c0-d1ccc9b9fcc4"],

Cell[CellGroupData[{

Cell["Euler-style stationarity equations", "Subsection",ExpressionUUID->"4c9f770e-2f7a-cf45-b484-e5db102ca37c"],

Cell[TextData[{
 "Since the current density contains no derivatives of the fields, \
stationarity is pointwise: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["L", "TI"]}], 
          RowBox[{"\[PartialD]", "\[Rho]"}]], "\[LongEqual]", "log", 
         RowBox[{"(", "\[Chi]", ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial \\mathcal{L}}{\\partial \\rho} = \\log(\\chi) = 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "136d2390-8cab-9743-a479-a35ada354c33"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["L", "TI"]}], 
          RowBox[{"\[PartialD]", "\[Chi]"}]], "\[LongEqual]", 
         FractionBox["\[Rho]", "\[Chi]"], "+", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{\\partial \\mathcal{L}}{\\partial \\chi} = \\frac{\\rho}{\\chi} \
+ R^2 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b7a8c2df-d417-a148-8bea-deda00138e64"]
}], "Text",ExpressionUUID->"a13f381e-bbaa-2647-8827-229fac4eda30"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "layer1StationarityEquations", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer1StationarityEquations", "[", 
     RowBox[{"rho_", ",", "chi_", ",", "res_"}], "]"}], ":=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"lagrangianDensity", "[", 
          RowBox[{"rho", ",", "chi", ",", "res"}], "]"}], ",", "rho"}], "]"}],
        "==", "0"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"lagrangianDensity", "[", 
          RowBox[{"rho", ",", "chi", ",", "res"}], "]"}], ",", "chi"}], "]"}],
        "==", "0"}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"layer1PointwiseSolution", "=", 
   RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"layer1StationarityEquations", "[", 
      RowBox[{"rho", ",", "chi", ",", "res"}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"rho", ",", "chi"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     "Reals"}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUI\
D->"d623e3a9-0077-7948-894c-c8d3f4e82100"],

Cell["This yields the symbolic solution: ", "Text",ExpressionUUID->"e630dce9-df6b-1048-96ef-54ccb1825bac"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{"\[Chi]", "\[LongEqual]", "1"}], TraditionalForm], 
    "errors" -> {}, "input" -> "\\chi = 1", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"a367bfed-eea3-df4e-b2e4-780b903fdc40"]], \
"Item",ExpressionUUID->"e261cca7-34c0-b149-8a28-2b1ad89a64fa"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{"\[Rho]", "\[LongEqual]", "-", 
        SuperscriptBox[
         StyleBox["R", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
    "input" -> "\\rho = -R^2", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"2fc27c3c-275b-de4f-b557-06decdc368b0"]], \
"Item",ExpressionUUID->"65189945-0f38-8044-9b8d-c93ca502155a"],

Cell["\<\
which is mathematically valid in the model as written, though it may be \
physically undesirable if one wants nonnegative information density. That \
tells us immediately the action may require constraints or additional \
derivative terms in later refinement. \
\>", "Text",ExpressionUUID->"0971f0af-0baf-0046-bef1-7954c9e7cb1a"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
