 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"3332fcfb-6ce1-0e4d-a33f-21eb919b928f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["14. Suggested execution order", "Section",ExpressionUUID->"8e729e83-484b-4f48-aaed-fc1cb8094e5c"],

Cell["For the next notebook phase, the best order is:", "Text",ExpressionUUID->"32c8341f-feb4-a641-8d82-e500025934fe"],

Cell[CellGroupData[{

Cell[BoxData[
 StyleBox[
  RowBox[{
  "Refine", " ", "Layer", " ", "1", " ", "into", " ", "a", " ", "true", " ", 
   "PDE", " ", "action", " "}],
  FontWeight->Bold]], "ChatInput",
 TaggingRules-><|
  "ChatNotebookSettings" -> <|
    "Model" -> <|"Service" -> "LLMKit", "Name" -> Automatic|>, "LLMEvaluator" -> 
     "WolframAIAssistant"|>|>,
 CellLabel->"In[43]:=",ExpressionUUID->"bb5a2b19-d2f2-1b46-85d8-e419cb06cce0"],

Cell[TextData[{
 "This is a strong Phase 1 scaffold.\n\nIt is careful in the right ways: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "symbolic where possible,"
 }], "InlineItem",ExpressionUUID->"14ee5b03-da37-3d4a-93fe-62efbdf0ef2f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "explicit about assumptions,"
 }], "InlineItem",ExpressionUUID->"f2d5ed30-1c50-3140-9da5-cf2ca864f7d4"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "modular,"
 }], "InlineItem",ExpressionUUID->"798a9244-f73d-ec4b-bb9b-45323bcba21b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "test-oriented,"
 }], "InlineItem",ExpressionUUID->"09294151-555c-fe4a-b8e6-f255521047e8"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "and importantly, it avoids overclaiming physical interpretation."
 }], "InlineItem",ExpressionUUID->"5ff3d276-9dca-8942-abe8-57181b5f8135"],
 "\nA few points stand out as especially good:\n\n1. Your note that ",
 Cell[BoxData[
  RowBox[{"WorkingPrecision", "->", "Infinity"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "8142647e-8850-174a-b4f8-3b5e99a44b38"],
 " is not an executable general numeric setting in Wolfram Language is \
correct.\n2. The separation of: \n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Layer 0 seed,"
 }], "InlineSubitem",ExpressionUUID->"1e6dc07a-2a2a-e941-aa39-d27ee0f8a1cc"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Layer 1 action/stationarity,"
 }], "InlineSubitem",ExpressionUUID->"aeeb159b-d657-1040-85cb-2727b058f46d"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Layer 2 measurement,"
 }], "InlineSubitem",ExpressionUUID->"765da835-d556-db45-b69f-947a27074469"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "closure/stability tests,"
 }], "InlineSubitem",ExpressionUUID->"8e7fb6f9-0984-2140-b809-40b67bdfe3c6"],
 "\n   is well structured.\n3. The use of ",
 Cell[BoxData[
  TemplateBox[{
   "SphericalHarmonicY", "paclet:ref/SphericalHarmonicY", 
    "https://reference.wolfram.com/language/ref/SphericalHarmonicY.html"},
   "TextRefLink"]],ExpressionUUID->"0c72eda8-7a90-b24f-ad41-8016bb2f33d6"],
 " for the first angular basis is mathematically natural, especially given \
the sphere-based Layer 0 seed and the standard spherical Laplacian structure \
via ",
 Cell[BoxData[
  TemplateBox[{
   "Laplacian", "paclet:ref/Laplacian", 
    "https://reference.wolfram.com/language/ref/Laplacian.html"},
   "TextRefLink"]],ExpressionUUID->"b06067e5-c5ef-a746-a30c-53c3e5f37a19"],
 ".\n4. Your warning that the current action produces only algebraic \
stationarity equations is exactly the right diagnosis. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Main correction before Phase 2\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"62cf82d5-08bb-4c4c-92ca-67ef3bf1ca91"],
 "\nYour proposed next step is the right one: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", "\[Rho]", "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "\[Rho]"], "|", "\[Del]", "\[Rho]", 
         SuperscriptBox["|", "2"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "\[Chi]"], "|", "\[Del]", "\[Chi]", 
         SuperscriptBox["|", "2"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["R", "TI"]], "|", "\[Del]", 
         StyleBox["R", "TI"], 
         SuperscriptBox["|", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L}\n=\n\\rho \\log(\\chi)\n+\n\\chi R^2\n+\na_\\rho |\\nabla \
\\rho|^2\n+\na_\\chi |\\nabla \\chi|^2\n+\na_R |\\nabla R|^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "894cb459-eeb4-2545-87b2-f0eb7d37500d"],
 "\nThat is the minimum structural change needed to make Step 1 of your OPF \
pipeline actually produce field equations rather than pointwise algebraic \
constraints. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Recommended Phase 2 scope\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"648ac5dc-46b1-2b42-a7af-842e953753e2"],
 "\nI would suggest the next notebook should do exactly these four things and \
no more: \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"1. Replace the algebraic action by a derivative action\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a14b4ea0-14ad-0e4c-ab72-81cc71d9259e"],
 "\nUse spherical coordinates and define the gradient terms explicitly. Since \
you are already working on a sphere/ball, you can use ",
 Cell[BoxData[
  TemplateBox[{
   "Laplacian", "paclet:ref/Laplacian", 
    "https://reference.wolfram.com/language/ref/Laplacian.html"},
   "TextRefLink"]],ExpressionUUID->"8c941239-5a4b-dc40-92ac-f89e47f1ac03"],
 " in spherical coordinates or construct the variational equations directly.\n\
\nA clean symbolic density is: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"lagrangianDensityPDE", "[", "\[IndentingNewLine]", "  ", 
            
            RowBox[{"rho_", ",", "chi_", ",", "res_", ",", 
              "\[IndentingNewLine]", "  ", "gradRhoSq_", ",", "gradChiSq_", 
              ",", "gradResSq_", ",", "\[IndentingNewLine]", "  ", "aRho_", 
              ",", "aChi_", ",", "aRes_"}], "\[IndentingNewLine]", "]"}], 
          ":=", 
          RowBox[{
            RowBox[{"rho", " ", 
              RowBox[{"Log", "[", "chi", "]"}]}], "+", 
            RowBox[{"chi", " ", 
              RowBox[{"res", "^", "2"}]}], "+", 
            RowBox[{"aRho", " ", "gradRhoSq"}], "+", 
            RowBox[{"aChi", " ", "gradChiSq"}], "+", 
            RowBox[{"aRes", " ", "gradResSq"}]}]}], ";"}]], "ChatCode", 
     "Input", LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "4378af34-ba48-5147-9663-f768ac066225"],
 "\nThen derive Euler\[Dash]Lagrange equations for the fields. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"2. Keep the angular basis spectral\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"9225a26f-9a63-c34e-8b33-e7e12db485e2"],
 "\nExpand fields in spherical modes using ",
 Cell[BoxData[
  TemplateBox[{
   "SphericalHarmonicY", "paclet:ref/SphericalHarmonicY", 
    "https://reference.wolfram.com/language/ref/SphericalHarmonicY.html"},
   "TextRefLink"]],ExpressionUUID->"57559e56-2726-0d47-9c39-a6d48b1335b3"],
 ", because on the sphere they diagonalize the angular part of the Laplacian: \
\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalDelta]", 
          SuperscriptBox[
           StyleBox["S", "TI"], "2"]], 
         SubscriptBox[
          StyleBox["Y", "TI"], 
          RowBox[{"\[ScriptL]", 
            StyleBox["m", "TI"]}]], "\[LongEqual]", "-", "\[ScriptL]", 
         RowBox[{"(", 
           RowBox[{"\[ScriptL]", "+", "1"}], ")"}], 
         SubscriptBox[
          StyleBox["Y", "TI"], 
          RowBox[{"\[ScriptL]", 
            StyleBox["m", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Delta_{S^2} Y_{\\ell m} = -\\ell(\\ell+1) Y_{\\ell m}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "163f30eb-d955-3040-ba75-0de4f5d21b9b"],
 "\nThis is exactly the right basis for a smallest-scale symbolic stability \
analysis. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"3. Define stability operationally\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"1e817ce1-7e81-3a42-8b07-cfe8ba94ec9e"],
 "\nYour Section C is excellent. I would formalize it into predicates such \
as: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["closureResidualBoundedQ", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "0fdf12d2-1a05-3940-b067-bdb040915d65"]
 }], "InlineItem",ExpressionUUID->"64c581df-5a79-3d41-a86f-bd4bcc26a216"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["energySemiboundedQ", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "650a30bc-0d0e-3e4f-b438-7b223f500187"]
 }], "InlineItem",ExpressionUUID->"718c7ffd-4e66-f045-ae8e-b4cedc916765"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["measurementConvergentQ", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "eaeca2a6-6b3f-0e42-aae3-330870a7f42f"]
 }], "InlineItem",ExpressionUUID->"0bdc7d97-b7ad-3943-b038-9ca8f411647f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["noGrowingLinearModesQ", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "82c2e1cc-faef-bc44-8543-8fea46eee993"]
 }], "InlineItem",ExpressionUUID->"d0914feb-9f58-d44d-91a8-67df242e5e4f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   TemplateBox[{
     Cell["precisionStableQ", Background -> None]},
    "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
   "39e58c94-1c5f-cb46-a2fd-106512ae4f6c"]
 }], "InlineItem",ExpressionUUID->"63f75b23-1c08-9248-8fc9-27b6414c1a28"],
 "\nThen the phrase \[OpenCurlyDoubleQuote]smallest stable scale\
\[CloseCurlyDoubleQuote] becomes a computable property. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. Delay torus embedding until after PDE validation\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"005d5ad2-a1e5-4b4f-9b04-2c9e91629515"],
 "\nThis is important. A torus parameterization is useful, but introducing it \
too early can mix: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "topology,"
 }], "InlineItem",ExpressionUUID->"e53689e7-3c26-5741-a203-4b06660d1ca6"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "embedding geometry,"
 }], "InlineItem",ExpressionUUID->"5103460d-4dc1-ed46-9a71-746138177fb9"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "and field dynamics."
 }], "InlineItem",ExpressionUUID->"4079ddb5-4f01-b347-a1f8-16e844b3b8f8"],
 "\nYour current spherical seed plus closure residual is a good first \
symbolic frame. The toroidal embedding should come after the PDE layer is \
validated. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Best immediate refinement\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b87fa0e8-0fac-2745-8913-cd6563117b1c"],
 "\nIf your next notebook is \[OpenCurlyDoubleQuote]Refine Layer 1 into a \
true PDE action\[CloseCurlyDoubleQuote], I recommend organizing it into these \
sections: \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Phase 2 notebook outline\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"be13cbae-a8bb-ef41-a7a4-ffb0271d5a23"],
 "\n1. ",
 StyleBox["Precision and assumptions",
  FontWeight->Bold],
 "\n2. ",
 StyleBox["Derivative-augmented action",
  FontWeight->Bold],
 "\n3. ",
 StyleBox["Euler\[Dash]Lagrange derivation",
  FontWeight->Bold],
 "\n4. ",
 StyleBox["Spherical harmonic mode decomposition",
  FontWeight->Bold],
 "\n5. ",
 StyleBox["Linearization around background solution",
  FontWeight->Bold],
 "\n6. ",
 StyleBox["Mode eigenvalue/stability analysis",
  FontWeight->Bold],
 "\n7. ",
 StyleBox["Measurement kernel convergence tests",
  FontWeight->Bold],
 "\n8. ",
 StyleBox["Residual-based test suite",
  FontWeight->Bold],
 "\n9. ",
 StyleBox["Pipeline update L0 \[RightArrow] L1 \[RightArrow] L2",
  FontWeight->Bold],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"One conceptual caution\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a335b7fa-941c-d54c-b527-cdc6902c2a68"],
 "\nUnder the OPF directives, some requirements are mathematically stronger \
than Wolfram Language can literally enforce in a generic way, especially: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "exact infinite precision numerics,"
 }], "InlineItem",ExpressionUUID->"1f0709ef-e06d-cc4d-9a0b-76f785d0f202"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "universal closed-form solvability,"
 }], "InlineItem",ExpressionUUID->"676571ae-e994-254e-aa95-fe3a7135764c"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "guaranteed residuals below ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SuperscriptBox["10", "-50"], TraditionalForm], "errors" -> {}, 
      "input" -> "10^{-50}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "72b8bce9-aaf8-9945-9339-218e9eb7e2df"],
  " for arbitrary nonlinear systems."
 }], "InlineItem",ExpressionUUID->"22b51fd2-feb1-0244-bc24-5afb1c0de6a1"],
 "\nSo the best executable interpretation is the one you already started \
using: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "exact/symbolic first,"
 }], "InlineItem",ExpressionUUID->"fed1cc82-ad38-4a4d-9e7c-a17fd420e2b0"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "arbitrary high finite precision when needed,"
 }], "InlineItem",ExpressionUUID->"e9fbca5e-a9df-8d4c-bc6e-1b04139f45b6"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "explicit residual verification,"
 }], "InlineItem",ExpressionUUID->"293fec97-974a-e844-b739-37b4f11a4573"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "refinement tests."
 }], "InlineItem",ExpressionUUID->"65d12815-2851-134d-9e52-6b80fa86c26b"],
 "\nThat is the correct computational translation. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Recommended next action\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0f8153bf-2e11-4446-89d5-0d5b2b2882c2"],
 "\nYes \[LongDash] the next notebook phase should be:\n\n\|01f4ac ",
 StyleBox["Refine Layer 1 into a true PDE action",
  FontWeight->Bold],
 "\n\nIf you want, I can generate the full ",
 StyleBox["Phase 2 notebook",
  FontWeight->Bold],
 " in Wolfram Language, including: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "derivative-based action,"
 }], "InlineItem",ExpressionUUID->"c54fdacc-6624-c245-b190-e1b88b79cedc"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "symbolic Euler\[Dash]Lagrange equations,"
 }], "InlineItem",ExpressionUUID->"1ecb869e-ea71-c94b-ba4d-1aadab96310d"],
