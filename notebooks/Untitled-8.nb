Cell[CellGroupData[{

Cell["12. Summary association for the first frame", "Section",ExpressionUUID->"5943fc5a-377b-cb4f-af8d-c26343f52439"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "smallestScaleFramework", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"smallestScaleFramework", "[", "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<FrameworkVersion\>\"", 
      "->", "\"\<Phase1.SmallestScale\>\""}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<ScaleIndex\>\"", "->", "0"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<Layer0\>\"", "->", 
      RowBox[{"layer0Seed", "[", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Layer1Solution\>\"", "->", "layer1PointwiseSolution"}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ClosureTarget\>\"", "->", "closureTarget"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ClosureAmplitudeRule\>\"", "->", "closureAmplitudeRule"}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<SampleStableFrequencies\>\"", "->", 
      RowBox[{"stableFrequencies", "[", 
       RowBox[{"12", ",", "1", ",", "1"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Pipeline\>\"", "->", "fullPipeline"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Tests\>\"", "->", 
      RowBox[{"smallestScaleTestSuite", "[", "]"}]}]}], "\[IndentingNewLine]",
     "|>"}]}], ";"}]}], "Input",ExpressionUUID->"940c79f1-c649-7242-afbe-\
595d61b9964a"],

