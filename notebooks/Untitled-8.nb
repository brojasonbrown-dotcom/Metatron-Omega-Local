                   StyleBox[
                    DynamicBox[ToBoxes[
                    FEPrivate`FrontEndResource[
                    "ChatbookStrings", "FormattingToolUsing"], StandardForm]],
                    StripOnInput->False,
                    
                    FontColor->RGBColor[
                    0.53214525, 0.6238195470000001, 0.67275]], 
                   StyleBox["\<\"Create Notebook\"\>",
                    StripOnInput->False,
                    FontWeight->"DemiBold",
                    
                    FontColor->RGBColor[
                    0.53214525, 0.6238195470000001, 0.67275]], 
                   
                   DynamicBox[FEPrivate`FrontEndResource[
                    "FEExpressions", "PercolateColorAnimator"][Small, 
                    RGBColor[0.53214525, 0.6238195470000001, 0.67275]]], 
                   PaneSelectorBox[{True->
                    TemplateBox[{
                    RGBColor[0.53214525, 0.6238195470000001, 0.67275]},
                    "DiscardedMaterialCloserIcon"], False->
                    TemplateBox[{
                    RGBColor[0.53214525, 0.6238195470000001, 0.67275]},
                    "DiscardedMaterialOpenerIcon"]}, Dynamic[Typeset`var$$],
                    BaselinePosition->Baseline,
                    ImageSize->Automatic]}
                 },
                 AutoDelete->False,
                 
                 BaseStyle->{
                  FontColor -> 
                   RGBColor[0.53214525, 0.6238195470000001, 0.67275], 
                   ShowStringCharacters -> False},
                 BaselinePosition->{1, 1},
                 
                 GridBoxAlignment->{
                  "Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
                 
                 GridBoxItemSize->{
                  "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
                 GridBoxSpacings->{"Columns" -> {{0.25}}}],
                "Grid"],
               EventHandlerTag[{"MouseDown" :> FEPrivate`Set[Typeset`var$$, 
                   Not[Typeset`var$$]], Method -> "Preemptive", 
                 PassEventsDown -> Automatic, PassEventsUp -> True}]],
              MouseAppearanceTag["Arrow"]]}, Dynamic[
              CurrentValue["MouseOver"]],
             FrameMargins->0,
             ImageSize->Automatic]},
           {
            TabViewBox[{{1,"\<\"Raw\"\>"->
             FrameBox[
              FrameBox[Cell[BoxData[
                PaneBox[
                 
                 PaneBox["\<\"/create_nb\\n# Toroidal Closure / Dimensional \
Stability Framework\\n\\n## Phase 3 Notebook: Toroidal Geometry, \
Linearization, and Eigenspectrum Tests\\n\\nThis notebook extends the \
toroidal geometry module by adding:\\n\\n- a torus-compatible scalar field \
operator,\\n- linearization about a background toroidal mode,\\n- \
Fourier-mode eigenspectrum formulas on the flat torus proxy,\\n- numerical \
matrix-based eigenspectrum tests,\\n- convergence-under-resolution \
checks,\\n- and an interactive exploration interface.\\n\\nThis is a \
**testable computational scaffold**. It does **not** claim physical \
identification beyond what is explicitly encoded.\\n\\n---\\n\\n## 1. \
Precision policy and \
assumptions\\n\\n```wl\\nClearAll[setToroidalFrameworkPrecision];\\n\\\
nsetToroidalFrameworkPrecision[] := (\\n  $Assumptions = Element[\\n      \
{\\n        majorRadius, minorRadius, u, v,\\n        amp, alpha, beta,\\n    \
    massTerm, coupling,\\n        fieldValue, backgroundValue,\\n        \
closureTargetValue\\n      }, Reals\\n    ] && majorRadius > 0 && minorRadius \
> 0 && majorRadius > minorRadius &&\\n    0 <= u <= 2 Pi && 0 <= v <= 2 Pi && \
alpha >= 0;\\n  $MaxExtraPrecision = \
1000;\\n)\\n\\nsetToroidalFrameworkPrecision[];\\n```\\n\\nAs before, exact \
``WorkingPrecision -> Infinity`` is not generally executable for numerical \
eigensolvers or integrations. The executable approximation used here \
is:\\n\\n- exact symbolic derivation where possible,\\n- high finite \
precision numerical evaluation when necessary,\\n- explicit residual and \
convergence tests.\\n\\n---\\n\\n## 2. Scale \
bookkeeping\\n\\n```wl\\nClearAll[goldenPhi, planckLength, \
smallestScaleIndex, scaleLength];\\n\\ngoldenPhi = (1 + Sqrt[5]) / \
2;\\nplanckLength = Quantity[1.616255*10^-35, \
\\\"Meters\\\"];\\nsmallestScaleIndex = 0;\\n\\nscaleLength[n_Integer ? \
NonNegative] := UnitSimplify[planckLength \
goldenPhi^n];\\n```\\n\\n---\\n\\n## 3. Toroidal geometry module\\n\\nWe keep \
the explicit torus embedding from the previous \
phase:\\n\\n$$\\n\\\\mathbf{x}(u,v)=\\\\{(R+r\\\\cos v)\\\\cos u,(R+r\\\\cos \
v)\\\\sin u,r\\\\sin v\\\\}\\n$$\\n\\n```wl\\nClearAll[\\n  torusEmbedding, \
torusTangentU, torusTangentV,\\n  torusMetricMatrixExact, \
torusMetricMatrix,\\n  torusInverseMetricExact, torusAreaElement, \
torusSurfaceArea\\n];\\n\\ntorusEmbedding[majorRadius_, minorRadius_] :=\\n  \
Function[{u, v}, {\\n    (majorRadius + minorRadius Cos[v]) Cos[u],\\n    \
(majorRadius + minorRadius Cos[v]) Sin[u],\\n    minorRadius Sin[v]\\n  \
}];\\n\\ntorusTangentU[majorRadius_, minorRadius_] := Module[\\n  {embed = \
torusEmbedding[majorRadius, minorRadius]},\\n  Function[{u, v}, D[embed[u, \
v], u]]\\n];\\n\\ntorusTangentV[majorRadius_, minorRadius_] := Module[\\n  \
{embed = torusEmbedding[majorRadius, minorRadius]},\\n  Function[{u, v}, \
D[embed[u, v], v]]\\n];\\n\\ntorusMetricMatrixExact[majorRadius_, \
minorRadius_] := {\\n  {(majorRadius + minorRadius Cos[v])^2, 0},\\n  {0, \
minorRadius^2}\\n};\\n\\ntorusMetricMatrix[majorRadius_, minorRadius_] := \
torusMetricMatrixExact[majorRadius, \
minorRadius];\\n\\ntorusInverseMetricExact[majorRadius_, minorRadius_] := \
Simplify[\\n  Inverse[torusMetricMatrixExact[majorRadius, minorRadius]],\\n  \
Assumptions -> $Assumptions\\n];\\n\\ntorusAreaElement[majorRadius_, \
minorRadius_] := Simplify[\\n  Sqrt[Det[torusMetricMatrix[majorRadius, \
minorRadius]]],\\n  Assumptions -> \
$Assumptions\\n];\\n\\ntorusSurfaceArea[majorRadius_, minorRadius_] := \
FullSimplify[\\n  Integrate[\\n    torusAreaElement[majorRadius, \
minorRadius],\\n    {u, 0, 2 Pi}, {v, 0, 2 Pi},\\n    Assumptions -> \
$Assumptions\\n  ],\\n  Assumptions -> \
$Assumptions\\n];\\n```\\n\\n---\\n\\n## 4. Periodic scalar modes on the \
torus\\n\\n```wl\\nClearAll[toroidalMode, toroidalRealMode, \
constantToroidalMode];\\n\\ntoroidalMode[m_Integer, n_Integer, amp_, alpha_: \
0] :=\\n  Function[{u, v}, amp Exp[-alpha Cos[v]] Exp[I (m u + n \
v)]];\\n\\ntoroidalRealMode[m_Integer, n_Integer, amp_, alpha_: 0, beta_: 0] \
:=\\n  Function[{u, v}, amp Exp[-alpha Cos[v]] Cos[m u + n v + \
beta]];\\n\\nconstantToroidalMode[amp_] := Function[{u, v}, \
amp];\\n```\\n\\nPeriodicity \
tests:\\n\\n```wl\\nClearAll[toroidalPeriodicClosureQ, \
fieldPeriodicClosureQ];\\n\\ntoroidalPeriodicClosureQ[majorRadius_, \
minorRadius_] := Module[\\n  {embed},\\n  embed = torusEmbedding[majorRadius, \
minorRadius];\\n  Simplify[\\n    embed[u + 2 Pi, v] == embed[u, v] && \
embed[u, v + 2 Pi] == embed[u, v],\\n    Assumptions -> $Assumptions\\n  \
]\\n];\\n\\nfieldPeriodicClosureQ[psi_] := Simplify[\\n  psi[u + 2 Pi, v] == \
psi[u, v] && psi[u, v + 2 Pi] == psi[u, v],\\n  Assumptions -> \
$Assumptions\\n];\\n```\\n\\n---\\n\\n## 5. Toroidal closure functional and \
residual\\n\\n```wl\\nClearAll[\\n  toroidalClosureFunctional, \
toroidalClosureResidual,\\n  closureAmplitudeRule, \
normalizedConstantToroidalMode\\n];\\n\\ntoroidalClosureFunctional[psi_, \
majorRadius_, minorRadius_, wp_: 80] := NIntegrate[\\n  Evaluate[Abs[psi[u, \
v]]^2 torusAreaElement[majorRadius, minorRadius]],\\n  {u, 0, 2 Pi}, {v, 0, 2 \
Pi},\\n  WorkingPrecision -> wp,\\n  AccuracyGoal -> 30,\\n  PrecisionGoal -> \
30,\\n  Method -> {\\\"GlobalAdaptive\\\", \\\"SymbolicProcessing\\\" -> \
0}\\n];\\n\\ntoroidalClosureResidual[psi_, majorRadius_, minorRadius_, \
closureTargetValue_, wp_: 80] :=\\n  N[toroidalClosureFunctional[psi, \
majorRadius, minorRadius, wp] - closureTargetValue, \
wp];\\n\\nclosureAmplitudeRule[majorRadius_, minorRadius_, \
closureTargetValue_] := Solve[\\n  amp^2 torusSurfaceArea[majorRadius, \
minorRadius] == closureTargetValue,\\n  amp,\\n  \
Reals\\n];\\n\\nnormalizedConstantToroidalMode[majorRadius_, minorRadius_, \
closureTargetValue_] := Module[\\n  {ampRule},\\n  ampRule = \
First[closureAmplitudeRule[majorRadius, minorRadius, closureTargetValue]];\\n \
 Function[{u, v}, amp /. ampRule]\\n];\\n```\\n\\n---\\n\\n## 6. Linearized \
field model on the torus\\n\\nTo add a meaningful stability layer, we \
introduce a scalar energy-density surrogate on the \
torus:\\n\\n$$\\n\\\\mathcal{E}[\\\\psi]=g^{ij}\\\\partial_i \
\\\\psi\\\\,\\\\partial_j \\\\psi + m_0^2 \\\\psi^2 + \\\\lambda \
\\\\psi^4\\n$$\\n\\nA linearization about a constant background \
$$\\\\psi=\\\\psi_0+\\\\delta\\\\psi$$ yields the Hessian operator\\n\\n$$\\n\
\\\\mathcal{L}_{\\\\mathrm{lin}}\\\\,\\\\delta\\\\psi = -\\\\Delta_T \
\\\\delta\\\\psi + \\\\left(m_0^2 + 12\\\\lambda \
\\\\psi_0^2\\\\right)\\\\delta\\\\psi\\n$$\\n\\nwhere $$\\\\Delta_T$$ is a \
torus Laplace-type operator.\\n\\nFor a first computational scaffold, we use \
a **flat torus proxy** with periodic coordinates and effective lengths \
$$2\\\\pi R$$ and $$2\\\\pi r$$. This preserves periodic closure and gives \
exact Fourier eigenvalues.\\n\\n```wl\\nClearAll[effectiveMassTerm, \
flatTorusEigenvalue, flatTorusFrequency];\\n\\neffectiveMassTerm[massTerm_, \
coupling_, backgroundValue_] :=\\n  Simplify[massTerm + 12 coupling \
backgroundValue^2, Assumptions -> \
$Assumptions];\\n\\nflatTorusEigenvalue[m_Integer, n_Integer, majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_] :=\\n  Simplify[\\n    \
m^2/majorRadius^2 + n^2/minorRadius^2 + effectiveMassTerm[massTerm, coupling, \
backgroundValue],\\n    Assumptions -> $Assumptions\\n  \
];\\n\\nflatTorusFrequency[m_Integer, n_Integer, majorRadius_, minorRadius_, \
massTerm_, coupling_, backgroundValue_] :=\\n  Simplify[\\n    \
Sqrt[flatTorusEigenvalue[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue]],\\n    Assumptions -> $Assumptions\\n  \
];\\n```\\n\\nUndamped harmonic mode condition for this proxy is positivity \
of the eigenvalue.\\n\\n```wl\\nClearAll[undampedModeQ, \
stableFlatTorusModes];\\n\\nundampedModeQ[m_Integer, n_Integer, majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_] :=\\n  Simplify[\\n    \
flatTorusEigenvalue[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue] > 0,\\n    Assumptions -> $Assumptions\\n  \
];\\n\\nstableFlatTorusModes[maxMode_Integer ? NonNegative, majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_] :=\\n  Select[\\n    \
Flatten[Table[{m, n}, {m, 0, maxMode}, {n, 0, maxMode}], 1],\\n    \
TrueQ[undampedModeQ[#[[1]], #[[2]], majorRadius, minorRadius, massTerm, \
coupling, backgroundValue]] &\\n  ];\\n```\\n\\n---\\n\\n## 7. Matrix \
eigenspectrum on a periodic rectangular torus proxy\\n\\nTo make the \
eigenspectrum directly testable, we discretize the operator\\n\\n$$\\nL = -\\\
\\partial_u^2 - \\\\partial_v^2 + \\\\mu_{\\\\mathrm{eff}}\\n$$\\n\\non a \
doubly periodic grid. This is a numerical proxy for the linearized toroidal \
operator.\\n\\n```wl\\nClearAll[\\n  periodicSecondDifferenceMatrix,\\n  \
flatTorusOperatorMatrix,\\n  \
flatTorusEigenSystem\\n];\\n\\nperiodicSecondDifferenceMatrix[nPts_Integer ? \
Positive, domainLength_: 2 Pi, wp_: 80] := Module[\\n  {h, rules},\\n  h = \
SetPrecision[domainLength/nPts, wp];\\n  rules = Join[\\n    Table[{i, i} -> \
SetPrecision[-2/h^2, wp], {i, nPts}],\\n    Table[{i, i + 1} -> \
SetPrecision[1/h^2, wp], {i, 1, nPts - 1}],\\n    Table[{i + 1, i} -> \
SetPrecision[1/h^2, wp], {i, 1, nPts - 1}],\\n    {\\n      {1, nPts} -> \
SetPrecision[1/h^2, wp],\\n      {nPts, 1} -> SetPrecision[1/h^2, wp]\\n    }\
\\n  ];\\n  SparseArray[rules, {nPts, \
nPts}]\\n];\\n\\nflatTorusOperatorMatrix[nU_Integer ? Positive, nV_Integer ? \
Positive, massEff_, wp_: 80] := Module[\\n  {du2, dv2, idU, idV},\\n  du2 = \
periodicSecondDifferenceMatrix[nU, 2 Pi, wp];\\n  dv2 = \
periodicSecondDifferenceMatrix[nV, 2 Pi, wp];\\n  idU = IdentityMatrix[nU, \
SparseArray];\\n  idV = IdentityMatrix[nV, SparseArray];\\n  \
N[-KroneckerProduct[du2, idV] - KroneckerProduct[idU, dv2] + massEff \
IdentityMatrix[nU nV, SparseArray], \
wp]\\n];\\n\\nflatTorusEigenSystem[nU_Integer ? Positive, nV_Integer ? \
Positive, massTerm_, coupling_, backgroundValue_, count_Integer ? Positive, \
wp_: 80] := Module[\\n  {massEff, vals, vecs},\\n  massEff = \
N[effectiveMassTerm[massTerm, coupling, backgroundValue], wp];\\n  {vals, \
vecs} = Eigensystem[\\n    flatTorusOperatorMatrix[nU, nV, massEff, wp],\\n   \
 count,\\n    Method -> {\\\"Arnoldi\\\", \\\"Criteria\\\" -> \
\\\"RealPart\\\"}\\n  ];\\n  {vals, vecs}\\n];\\n```\\n\\n---\\n\\n## 8. \
Eigenspectrum diagnostics and \
convergence\\n\\n```wl\\nClearAll[eigenspectrumSummary, \
eigenspectrumResolutionStudy];\\n\\neigenspectrumSummary[maxMode_Integer ? \
NonNegative, majorRadius_, minorRadius_, massTerm_, coupling_, \
backgroundValue_] :=\\n  Association[\\n    Flatten[\\n      Table[\\n        \
({m, n} -> <|\\n          \\\"Eigenvalue\\\" -> flatTorusEigenvalue[m, n, \
majorRadius, minorRadius, massTerm, coupling, backgroundValue],\\n          \
\\\"Frequency\\\" -> flatTorusFrequency[m, n, majorRadius, minorRadius, \
massTerm, coupling, backgroundValue],\\n          \\\"UndampedQ\\\" -> \
undampedModeQ[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue]\\n        |>),\\n        {m, 0, maxMode}, {n, 0, maxMode}\\n \
     ],\\n      1\\n    ]\\n  \
];\\n\\neigenspectrumResolutionStudy[resolutions_List, massTerm_, coupling_, \
backgroundValue_, count_Integer : 8, wp_: 80] :=\\n  AssociationThread[\\n    \
resolutions,\\n    (flatTorusEigenSystem[#[[1]], #[[2]], massTerm, coupling, \
backgroundValue, count, wp][[1]] &) /@ resolutions\\n  \
];\\n```\\n\\n---\\n\\n## 9. Geometry and linearization \
summaries\\n\\n```wl\\nClearAll[toroidalGeometrySummary, \
linearizedToroidalModelSummary];\\n\\ntoroidalGeometrySummary[majorRadius_, \
minorRadius_] := <|\\n  \\\"Embedding\\\" -> \
HoldForm[torusEmbedding[majorRadius, minorRadius][u, v]],\\n  \\\"Metric\\\" \
-> torusMetricMatrixExact[majorRadius, minorRadius],\\n  \
\\\"InverseMetric\\\" -> torusInverseMetricExact[majorRadius, \
minorRadius],\\n  \\\"AreaElement\\\" -> torusAreaElement[majorRadius, \
minorRadius],\\n  \\\"SurfaceArea\\\" -> torusSurfaceArea[majorRadius, \
minorRadius],\\n  \\\"PeriodicClosureQ\\\" -> \
toroidalPeriodicClosureQ[majorRadius, \
minorRadius]\\n|>;\\n\\nlinearizedToroidalModelSummary[majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_, maxMode_: 3] := <|\\n  \
\\\"EffectiveMassTerm\\\" -> effectiveMassTerm[massTerm, coupling, \
backgroundValue],\\n  \\\"StableModes\\\" -> stableFlatTorusModes[maxMode, \
majorRadius, minorRadius, massTerm, coupling, backgroundValue],\\n  \
\\\"ModeSummary\\\" -> eigenspectrumSummary[maxMode, majorRadius, \
minorRadius, massTerm, coupling, \
backgroundValue]\\n|>;\\n```\\n\\n---\\n\\n## 10. Smallest-scale tests: \
linearization and \
eigenspectrum\\n\\n```wl\\nClearAll[smallestScaleLinearizationTestSuite];\\n\\\
nsmallestScaleLinearizationTestSuite[] := Module[\\n  {\\n    majorRadius = \
3/2,\\n    minorRadius = 1/2,\\n    closureTargetValue = goldenPhi^-13,\\n    \
backgroundValue,\\n    massTerm = 1,\\n    coupling = 1/10,\\n    \
normalizedPsi,\\n    eigenvaluesCoarse,\\n    eigenvaluesFine\\n  },\\n\\n  \
normalizedPsi = normalizedConstantToroidalMode[majorRadius, minorRadius, \
closureTargetValue];\\n  backgroundValue = normalizedPsi[0, 0];\\n\\n  \
eigenvaluesCoarse = Sort[Re[flatTorusEigenSystem[8, 8, massTerm, coupling, \
backgroundValue, 6, 60][[1]]]];\\n  eigenvaluesFine = \
Sort[Re[flatTorusEigenSystem[12, 12, massTerm, coupling, backgroundValue, 6, \
60][[1]]]];\\n\\n  TestReport[{\\n\\n    VerificationTest[\\n      \
toroidalPeriodicClosureQ[majorRadius, minorRadius],\\n      True,\\n      \
TestID -> \\\"Toroidal embedding periodic closure\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      fieldPeriodicClosureQ[toroidalMode[2, 3, amp, \
alpha]],\\n      True,\\n      TestID -> \\\"Toroidal mode periodicity\\\"\\n \
   ],\\n\\n    VerificationTest[\\n      FullSimplify[\\n        \
flatTorusEigenvalue[0, 0, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue] ==\\n        effectiveMassTerm[massTerm, coupling, \
backgroundValue],\\n        Assumptions -> $Assumptions\\n      ],\\n      \
True,\\n      TestID -> \\\"Zero mode eigenvalue equals effective mass\\\"\\n \
   ],\\n\\n    VerificationTest[\\n      TrueQ[\\n        \
flatTorusEigenvalue[1, 0, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue] >\\n        flatTorusEigenvalue[0, 0, majorRadius, \
minorRadius, massTerm, coupling, backgroundValue]\\n      ],\\n      True,\\n \
     TestID -> \\\"Nonzero mode exceeds zero mode\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      Length[stableFlatTorusModes[3, majorRadius, \
minorRadius, massTerm, coupling, backgroundValue]] > 0,\\n      True,\\n      \
TestID -> \\\"Stable flat torus modes exist\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      Min[eigenvaluesCoarse] > 0,\\n      True,\\n      \
TestID -> \\\"Coarse-grid eigenvalues positive\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      Max[Abs[eigenvaluesCoarse - eigenvaluesFine[[1 ;; \
Length[eigenvaluesCoarse]]]] ] < 10,\\n      True,\\n      TestID -> \
\\\"Resolution refinement remains bounded\\\"\\n    ]\\n\\n  }]\\n];\\n```\\n\
\\n---\\n\\n## 11. Framework \
summary\\n\\n```wl\\nClearAll[smallestScaleToroidalLinearizedFramework];\\n\\\
nsmallestScaleToroidalLinearizedFramework[] := Module[\\n  {\\n    \
majorRadius = 3/2,\\n    minorRadius = 1/2,\\n    closureTargetValue = \
goldenPhi^-13,\\n    normalizedPsi,\\n    backgroundValue,\\n    massTerm = \
1,\\n    coupling = 1/10\\n  },\\n\\n  normalizedPsi = \
normalizedConstantToroidalMode[majorRadius, minorRadius, closureTargetValue];\
\\n  backgroundValue = normalizedPsi[0, 0];\\n\\n  <|\\n    \
\\\"FrameworkVersion\\\" -> \\\"Phase3.ToroidalLinearization\\\",\\n    \
\\\"ScaleIndex\\\" -> smallestScaleIndex,\\n    \\\"Geometry\\\" -> \
toroidalGeometrySummary[majorRadius, minorRadius],\\n    \
\\\"ClosureTarget\\\" -> closureTargetValue,\\n    \\\"BackgroundValue\\\" -> \
backgroundValue,\\n    \\\"LinearizedModel\\\" -> \
linearizedToroidalModelSummary[majorRadius, minorRadius, massTerm, coupling, \
backgroundValue, 3],\\n    \\\"SampleNumericalEigenvalues\\\" -> \
flatTorusEigenSystem[10, 10, massTerm, coupling, backgroundValue, 8, \
80][[1]],\\n    \\\"Tests\\\" -> smallestScaleLinearizationTestSuite[]\\n  |>\
\\n];\\n```\\n\\nRun the framework \
summary:\\n\\n```wl\\nsmallestScaleToroidalLinearizedFramework[]\\n```\\n\\n--\
-\\n\\n## 12. Interactive exploration interface\\n\\nThis interface explores \
the linearized flat-torus proxy spectrum.\\n\\n```wl\\nManipulate[\\n Module[\
\\n  {\\n    backgroundValue,\\n    eigenTable,\\n    \
numericalEigenvalues,\\n    modePlot\\n  },\\n\\n  backgroundValue = \
normalizedConstantToroidalMode[majorRadius, minorRadius, \
closureTargetValue][0, 0];\\n\\n  eigenTable = Grid[\\n    Prepend[\\n      \
Flatten[\\n        Table[\\n          {\\n            {m, n},\\n            \
N[flatTorusEigenvalue[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue], 20],\\n            N[flatTorusFrequency[m, n, majorRadius, \
minorRadius, massTerm, coupling, backgroundValue], 20]\\n          },\\n      \
    {m, 0, maxMode}, {n, 0, maxMode}\\n        ],\\n        1\\n      ],\\n   \
   {\\\"Mode\\\", \\\"Eigenvalue\\\", \\\"Frequency\\\"}\\n    ],\\n    Frame \
-> All\\n  ];\\n\\n  numericalEigenvalues = flatTorusEigenSystem[nU, nV, \
massTerm, coupling, backgroundValue, eigenCount, wp][[1]];\\n\\n  modePlot = \
Plot3D[\\n    Evaluate[Re[toroidalMode[modeU, modeV, 1, alpha][u, v]]],\\n    \
{u, 0, 2 Pi}, {v, 0, 2 Pi},\\n    Mesh -> None,\\n    PlotPoints -> 50,\\n    \
ColorFunction -> \\\"SolarColors\\\",\\n    PlotLabel -> Row[{\\\"Re \
mode(\\\", modeU, \\\",\\\", modeV, \\\")\\\"}]\\n  ];\\n\\n  Column[{\\n    \
Row[{\\\"Background value: \\\", N[backgroundValue, 20]}],\\n    \
Row[{\\\"Effective mass term: \\\", N[effectiveMassTerm[massTerm, coupling, \
backgroundValue], 20]}],\\n    Row[{\\\"Numerical eigenvalues: \\\", \
N[numericalEigenvalues, 10]}],\\n    eigenTable,\\n    modePlot\\n  }]\\n \
],\\n {{majorRadius, 1.5, \\\"Major radius\\\"}, 0.6, 3, Appearance -> \
\\\"Labeled\\\"},\\n {{minorRadius, 0.5, \\\"Minor radius\\\"}, 0.1, 1.2, \
Appearance -> \\\"Labeled\\\"},\\n Delimiter,\\n {{closureTargetValue, \
goldenPhi^-13, \\\"Closure target\\\"}, 10^-6, 1, Appearance -> \\\"Labeled\\\
\"},\\n {{massTerm, 1, \\\"Mass term\\\"}, 0, 5, Appearance -> \
\\\"Labeled\\\"},\\n {{coupling, 0.1, \\\"Quartic coupling\\\"}, 0, 2, \
Appearance -> \\\"Labeled\\\"},\\n {{alpha, 0, \\\"Envelope alpha\\\"}, 0, 2, \
Appearance -> \\\"Labeled\\\"},\\n Delimiter,\\n {{maxMode, 2, \\\"Analytic \
max mode\\\"}, 0, 5, 1, Appearance -> \\\"Labeled\\\"},\\n {{modeU, 1, \
\\\"Plot mode m\\\"}, 0, 6, 1, Appearance -> \\\"Labeled\\\"},\\n {{modeV, 1, \
\\\"Plot mode n\\\"}, 0, 6, 1, Appearance -> \\\"Labeled\\\"},\\n \
Delimiter,\\n {{nU, 10, \\\"Grid u\\\"}, 6, 20, 1, Appearance -> \
\\\"Labeled\\\"},\\n {{nV, 10, \\\"Grid v\\\"}, 6, 20, 1, Appearance -> \
\\\"Labeled\\\"},\\n {{eigenCount, 8, \\\"Eigenvalue count\\\"}, 4, 20, 1, \
Appearance -> \\\"Labeled\\\"},\\n {{wp, 60, \\\"Working precision\\\"}, {40, \
60, 80, 100}},\\n SaveDefinitions -> True\\n]\\n```\"\>",
                  ImageSize->Dynamic[
                    (If[# > 600, #, 600]& )[
                    0.9 AbsoluteCurrentValue[{WindowSize, 1}]]]],
                 AppearanceElements->None,
                 ImageSize->{
                   Scaled[1], 
                   UpTo[400]},
                 ScrollPosition->{0., 0.},
                 Scrollbars->Automatic]], "Text", "RawToolCall",
                FontSize->11,
                Background->None,ExpressionUUID->
                "12827ead-f71f-6f42-83cc-a8046849a253"],
               Background->LightDarkSwitched[
                 GrayLevel[1], 
                 GrayLevel[0.09805]],
               BaseStyle->"Text",
               FrameMargins->5,
               FrameStyle->None,
               ImageSize->{
                 Scaled[1], Automatic},
               StripOnInput->False],
              Background->LightDarkSwitched[
                GrayLevel[1], 
                GrayLevel[0.09805]],
              FrameMargins->10,
              FrameStyle->None,
              StripOnInput->False]}, {2,"\<\"Interpreted\"\>"->
             FrameBox[
              TagBox[GridBox[{
                 {
                  ItemBox[
                   PaneBox[
                    StyleBox["\<\"INPUT\"\>",
                    StripOnInput->False,
                    FontSize->11],
                    FrameMargins->{{5, 5}, {1, 1}}],
                   Background->LightDarkSwitched[
                    GrayLevel[0.95], 
                    GrayLevel[0.15295]],
                   ItemSize->Fit,
                   StripOnInput->False]},
                 {
                  FrameBox[
                   TagBox[GridBox[{
                    {"\<\"content\"\>", 
                    InterpretationBox[
                    
                    DynamicModuleBox[{
                    Wolfram`Chatbook`ResourceFunctions`ClickToCopy`cell$$}, 
                    TagBox[
                    TagBox[
                    PaneSelectorBox[{False->
                    
                    FrameBox["\<\"# Toroidal Closure / Dimensional Stability \
Framework\\n\\n## Phase 3 Notebook: Toroidal Geometry, Linearization, and \
Eigenspectrum Tests\\n\\nThis notebook extends the toroidal geometry module \
by adding:\\n\\n- a torus-compatible scalar field operator,\\n- linearization \
about a background toroidal mode,\\n- Fourier-mode eigenspectrum formulas on \
the flat torus proxy,\\n- numerical matrix-based eigenspectrum tests,\\n- \
convergence-under-resolution checks,\\n- and an interactive exploration \
interface.\\n\\nThis is a **testable computational scaffold**. It does \
**not** claim physical identification beyond what is explicitly \
encoded.\\n\\n---\\n\\n## 1. Precision policy and \
assumptions\\n\\n```wl\\nClearAll[setToroidalFrameworkPrecision];\\n\\\
nsetToroidalFrameworkPrecision[] := (\\n  $Assumptions = Element[\\n      \
{\\n        majorRadius, minorRadius, u, v,\\n        amp, alpha, beta,\\n    \
    massTerm, coupling,\\n        fieldValue, backgroundValue,\\n        \
closureTargetValue\\n      }, Reals\\n    ] && majorRadius > 0 && minorRadius \
> 0 && majorRadius > minorRadius &&\\n    0 <= u <= 2 Pi && 0 <= v <= 2 Pi && \
alpha >= 0;\\n  $MaxExtraPrecision = \
1000;\\n)\\n\\nsetToroidalFrameworkPrecision[];\\n```\\n\\nAs before, exact \
``WorkingPrecision -> Infinity`` is not generally executable for numerical \
eigensolvers or integrations. The executable approximation used here \
is:\\n\\n- exact symbolic derivation where possible,\\n- high finite \
precision numerical evaluation when necessary,\\n- explicit residual and \
convergence tests.\\n\\n---\\n\\n## 2. Scale \
bookkeeping\\n\\n```wl\\nClearAll[goldenPhi, planckLength, \
smallestScaleIndex, scaleLength];\\n\\ngoldenPhi = (1 + Sqrt[5]) / \
2;\\nplanckLength = Quantity[1.616255*10^-35, \
\\\"Meters\\\"];\\nsmallestScaleIndex = 0;\\n\\nscaleLength[n_Integer ? \
NonNegative] := UnitSimplify[planckLength \
goldenPhi^n];\\n```\\n\\n---\\n\\n## 3. Toroidal geometry module\\n\\nWe keep \
the explicit torus embedding from the previous \
phase:\\n\\n$$\\n\\\\mathbf{x}(u,v)=\\\\{(R+r\\\\cos v)\\\\cos u,(R+r\\\\cos \
v)\\\\sin u,r\\\\sin v\\\\}\\n$$\\n\\n```wl\\nClearAll[\\n  torusEmbedding, \
torusTangentU, torusTangentV,\\n  torusMetricMatrixExact, \
torusMetricMatrix,\\n  torusInverseMetricExact, torusAreaElement, \
torusSurfaceArea\\n];\\n\\ntorusEmbedding[majorRadius_, minorRadius_] :=\\n  \
Function[{u, v}, {\\n    (majorRadius + minorRadius Cos[v]) Cos[u],\\n    \
(majorRadius + minorRadius Cos[v]) Sin[u],\\n    minorRadius Sin[v]\\n  \
}];\\n\\ntorusTangentU[majorRadius_, minorRadius_] := Module[\\n  {embed = \
torusEmbedding[majorRadius, minorRadius]},\\n  Function[{u, v}, D[embed[u, \
v], u]]\\n];\\n\\ntorusTangentV[majorRadius_, minorRadius_] := Module[\\n  \
{embed = torusEmbedding[majorRadius, minorRadius]},\\n  Function[{u, v}, \
D[embed[u, v], v]]\\n];\\n\\ntorusMetricMatrixExact[majorRadius_, \
minorRadius_] := {\\n  {(majorRadius + minorRadius Cos[v])^2, 0},\\n  {0, \
minorRadius^2}\\n};\\n\\ntorusMetricMatrix[majorRadius_, minorRadius_] := \
torusMetricMatrixExact[majorRadius, \
minorRadius];\\n\\ntorusInverseMetricExact[majorRadius_, minorRadius_] := \
Simplify[\\n  Inverse[torusMetricMatrixExact[majorRadius, minorRadius]],\\n  \
Assumptions -> $Assumptions\\n];\\n\\ntorusAreaElement[majorRadius_, \
minorRadius_] := Simplify[\\n  Sqrt[Det[torusMetricMatrix[majorRadius, \
minorRadius]]],\\n  Assumptions -> \
$Assumptions\\n];\\n\\ntorusSurfaceArea[majorRadius_, minorRadius_] := \
FullSimplify[\\n  Integrate[\\n    torusAreaElement[majorRadius, \
minorRadius],\\n    {u, 0, 2 Pi}, {v, 0, 2 Pi},\\n    Assumptions -> \
$Assumptions\\n  ],\\n  Assumptions -> \
$Assumptions\\n];\\n```\\n\\n---\\n\\n## 4. Periodic scalar modes on the \
torus\\n\\n```wl\\nClearAll[toroidalMode, toroidalRealMode, \
constantToroidalMode];\\n\\ntoroidalMode[m_Integer, n_Integer, amp_, alpha_: \
0] :=\\n  Function[{u, v}, amp Exp[-alpha Cos[v]] Exp[I (m u + n \
v)]];\\n\\ntoroidalRealMode[m_Integer, n_Integer, amp_, alpha_: 0, beta_: 0] \
:=\\n  Function[{u, v}, amp Exp[-alpha Cos[v]] Cos[m u + n v + \
beta]];\\n\\nconstantToroidalMode[amp_] := Function[{u, v}, \
amp];\\n```\\n\\nPeriodicity \
tests:\\n\\n```wl\\nClearAll[toroidalPeriodicClosureQ, \
fieldPeriodicClosureQ];\\n\\ntoroidalPeriodicClosureQ[majorRadius_, \
minorRadius_] := Module[\\n  {embed},\\n  embed = torusEmbedding[majorRadius, \
minorRadius];\\n  Simplify[\\n    embed[u + 2 Pi, v] == embed[u, v] && \
embed[u, v + 2 Pi] == embed[u, v],\\n    Assumptions -> $Assumptions\\n  \
]\\n];\\n\\nfieldPeriodicClosureQ[psi_] := Simplify[\\n  psi[u + 2 Pi, v] == \
psi[u, v] && psi[u, v + 2 Pi] == psi[u, v],\\n  Assumptions -> \
$Assumptions\\n];\\n```\\n\\n---\\n\\n## 5. Toroidal closure functional and \
residual\\n\\n```wl\\nClearAll[\\n  toroidalClosureFunctional, \
toroidalClosureResidual,\\n  closureAmplitudeRule, \
normalizedConstantToroidalMode\\n];\\n\\ntoroidalClosureFunctional[psi_, \
majorRadius_, minorRadius_, wp_: 80] := NIntegrate[\\n  Evaluate[Abs[psi[u, \
v]]^2 torusAreaElement[majorRadius, minorRadius]],\\n  {u, 0, 2 Pi}, {v, 0, 2 \
Pi},\\n  WorkingPrecision -> wp,\\n  AccuracyGoal -> 30,\\n  PrecisionGoal -> \
30,\\n  Method -> {\\\"GlobalAdaptive\\\", \\\"SymbolicProcessing\\\" -> \
0}\\n];\\n\\ntoroidalClosureResidual[psi_, majorRadius_, minorRadius_, \
closureTargetValue_, wp_: 80] :=\\n  N[toroidalClosureFunctional[psi, \
majorRadius, minorRadius, wp] - closureTargetValue, \
wp];\\n\\nclosureAmplitudeRule[majorRadius_, minorRadius_, \
closureTargetValue_] := Solve[\\n  amp^2 torusSurfaceArea[majorRadius, \
minorRadius] == closureTargetValue,\\n  amp,\\n  \
Reals\\n];\\n\\nnormalizedConstantToroidalMode[majorRadius_, minorRadius_, \
closureTargetValue_] := Module[\\n  {ampRule},\\n  ampRule = \
First[closureAmplitudeRule[majorRadius, minorRadius, closureTargetValue]];\\n \
 Function[{u, v}, amp /. ampRule]\\n];\\n```\\n\\n---\\n\\n## 6. Linearized \
field model on the torus\\n\\nTo add a meaningful stability layer, we \
introduce a scalar energy-density surrogate on the \
torus:\\n\\n$$\\n\\\\mathcal{E}[\\\\psi]=g^{ij}\\\\partial_i \
\\\\psi\\\\,\\\\partial_j \\\\psi + m_0^2 \\\\psi^2 + \\\\lambda \
\\\\psi^4\\n$$\\n\\nA linearization about a constant background \
$$\\\\psi=\\\\psi_0+\\\\delta\\\\psi$$ yields the Hessian operator\\n\\n$$\\n\
\\\\mathcal{L}_{\\\\mathrm{lin}}\\\\,\\\\delta\\\\psi = -\\\\Delta_T \
\\\\delta\\\\psi + \\\\left(m_0^2 + 12\\\\lambda \
\\\\psi_0^2\\\\right)\\\\delta\\\\psi\\n$$\\n\\nwhere $$\\\\Delta_T$$ is a \
torus Laplace-type operator.\\n\\nFor a first computational scaffold, we use \
a **flat torus proxy** with periodic coordinates and effective lengths \
$$2\\\\pi R$$ and $$2\\\\pi r$$. This preserves periodic closure and gives \
exact Fourier eigenvalues.\\n\\n```wl\\nClearAll[effectiveMassTerm, \
flatTorusEigenvalue, flatTorusFrequency];\\n\\neffectiveMassTerm[massTerm_, \
coupling_, backgroundValue_] :=\\n  Simplify[massTerm + 12 coupling \
backgroundValue^2, Assumptions -> \
$Assumptions];\\n\\nflatTorusEigenvalue[m_Integer, n_Integer, majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_] :=\\n  Simplify[\\n    \
m^2/majorRadius^2 + n^2/minorRadius^2 + effectiveMassTerm[massTerm, coupling, \
backgroundValue],\\n    Assumptions -> $Assumptions\\n  \
];\\n\\nflatTorusFrequency[m_Integer, n_Integer, majorRadius_, minorRadius_, \
massTerm_, coupling_, backgroundValue_] :=\\n  Simplify[\\n    \
Sqrt[flatTorusEigenvalue[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue]],\\n    Assumptions -> $Assumptions\\n  \
];\\n```\\n\\nUndamped harmonic mode condition for this proxy is positivity \
of the eigenvalue.\\n\\n```wl\\nClearAll[undampedModeQ, \
stableFlatTorusModes];\\n\\nundampedModeQ[m_Integer, n_Integer, majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_] :=\\n  Simplify[\\n    \
flatTorusEigenvalue[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue] > 0,\\n    Assumptions -> $Assumptions\\n  \
];\\n\\nstableFlatTorusModes[maxMode_Integer ? NonNegative, majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_] :=\\n  Select[\\n    \
Flatten[Table[{m, n}, {m, 0, maxMode}, {n, 0, maxMode}], 1],\\n    \
TrueQ[undampedModeQ[#[[1]], #[[2]], majorRadius, minorRadius, massTerm, \
coupling, backgroundValue]] &\\n  ];\\n```\\n\\n---\\n\\n## 7. Matrix \
eigenspectrum on a periodic rectangular torus proxy\\n\\nTo make the \
eigenspectrum directly testable, we discretize the operator\\n\\n$$\\nL = -\\\
\\partial_u^2 - \\\\partial_v^2 + \\\\mu_{\\\\mathrm{eff}}\\n$$\\n\\non a \
doubly periodic grid. This is a numerical proxy for the linearized toroidal \
operator.\\n\\n```wl\\nClearAll[\\n  periodicSecondDifferenceMatrix,\\n  \
flatTorusOperatorMatrix,\\n  \
flatTorusEigenSystem\\n];\\n\\nperiodicSecondDifferenceMatrix[nPts_Integer ? \
Positive, domainLength_: 2 Pi, wp_: 80] := Module[\\n  {h, rules},\\n  h = \
SetPrecision[domainLength/nPts, wp];\\n  rules = Join[\\n    Table[{i, i} -> \
SetPrecision[-2/h^2, wp], {i, nPts}],\\n    Table[{i, i + 1} -> \
SetPrecision[1/h^2, wp], {i, 1, nPts - 1}],\\n    Table[{i + 1, i} -> \
SetPrecision[1/h^2, wp], {i, 1, nPts - 1}],\\n    {\\n      {1, nPts} -> \
SetPrecision[1/h^2, wp],\\n      {nPts, 1} -> SetPrecision[1/h^2, wp]\\n    }\
\\n  ];\\n  SparseArray[rules, {nPts, \
nPts}]\\n];\\n\\nflatTorusOperatorMatrix[nU_Integer ? Positive, nV_Integer ? \
Positive, massEff_, wp_: 80] := Module[\\n  {du2, dv2, idU, idV},\\n  du2 = \
periodicSecondDifferenceMatrix[nU, 2 Pi, wp];\\n  dv2 = \
periodicSecondDifferenceMatrix[nV, 2 Pi, wp];\\n  idU = IdentityMatrix[nU, \
SparseArray];\\n  idV = IdentityMatrix[nV, SparseArray];\\n  \
N[-KroneckerProduct[du2, idV] - KroneckerProduct[idU, dv2] + massEff \
IdentityMatrix[nU nV, SparseArray], \
wp]\\n];\\n\\nflatTorusEigenSystem[nU_Integer ? Positive, nV_Integer ? \
Positive, massTerm_, coupling_, backgroundValue_, count_Integer ? Positive, \
wp_: 80] := Module[\\n  {massEff, vals, vecs},\\n  massEff = \
N[effectiveMassTerm[massTerm, coupling, backgroundValue], wp];\\n  {vals, \
vecs} = Eigensystem[\\n    flatTorusOperatorMatrix[nU, nV, massEff, wp],\\n   \
 count,\\n    Method -> {\\\"Arnoldi\\\", \\\"Criteria\\\" -> \
\\\"RealPart\\\"}\\n  ];\\n  {vals, vecs}\\n];\\n```\\n\\n---\\n\\n## 8. \
Eigenspectrum diagnostics and \
convergence\\n\\n```wl\\nClearAll[eigenspectrumSummary, \
eigenspectrumResolutionStudy];\\n\\neigenspectrumSummary[maxMode_Integer ? \
NonNegative, majorRadius_, minorRadius_, massTerm_, coupling_, \
backgroundValue_] :=\\n  Association[\\n    Flatten[\\n      Table[\\n        \
({m, n} -> <|\\n          \\\"Eigenvalue\\\" -> flatTorusEigenvalue[m, n, \
majorRadius, minorRadius, massTerm, coupling, backgroundValue],\\n          \
\\\"Frequency\\\" -> flatTorusFrequency[m, n, majorRadius, minorRadius, \
massTerm, coupling, backgroundValue],\\n          \\\"UndampedQ\\\" -> \
undampedModeQ[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue]\\n        |>),\\n        {m, 0, maxMode}, {n, 0, maxMode}\\n \
     ],\\n      1\\n    ]\\n  \
];\\n\\neigenspectrumResolutionStudy[resolutions_List, massTerm_, coupling_, \
backgroundValue_, count_Integer : 8, wp_: 80] :=\\n  AssociationThread[\\n    \
resolutions,\\n    (flatTorusEigenSystem[#[[1]], #[[2]], massTerm, coupling, \
backgroundValue, count, wp][[1]] &) /@ resolutions\\n  \
];\\n```\\n\\n---\\n\\n## 9. Geometry and linearization \
summaries\\n\\n```wl\\nClearAll[toroidalGeometrySummary, \
linearizedToroidalModelSummary];\\n\\ntoroidalGeometrySummary[majorRadius_, \
minorRadius_] := <|\\n  \\\"Embedding\\\" -> \
HoldForm[torusEmbedding[majorRadius, minorRadius][u, v]],\\n  \\\"Metric\\\" \
-> torusMetricMatrixExact[majorRadius, minorRadius],\\n  \
\\\"InverseMetric\\\" -> torusInverseMetricExact[majorRadius, \
minorRadius],\\n  \\\"AreaElement\\\" -> torusAreaElement[majorRadius, \
minorRadius],\\n  \\\"SurfaceArea\\\" -> torusSurfaceArea[majorRadius, \
minorRadius],\\n  \\\"PeriodicClosureQ\\\" -> \
toroidalPeriodicClosureQ[majorRadius, \
minorRadius]\\n|>;\\n\\nlinearizedToroidalModelSummary[majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_, maxMode_: 3] := <|\\n  \
\\\"EffectiveMassTerm\\\" -> effectiveMassTerm[massTerm, coupling, \
backgroundValue],\\n  \\\"StableModes\\\" -> stableFlatTorusModes[maxMode, \
majorRadius, minorRadius, massTerm, coupling, backgroundValue],\\n  \
\\\"ModeSummary\\\" -> eigenspectrumSummary[maxMode, majorRadius, \
minorRadius, massTerm, coupling, \
backgroundValue]\\n|>;\\n```\\n\\n---\\n\\n## 10. Smallest-scale tests: \
linearization and \
eigenspectrum\\n\\n```wl\\nClearAll[smallestScaleLinearizationTestSuite];\\n\\\
nsmallestScaleLinearizationTestSuite[] := Module[\\n  {\\n    majorRadius = \
3/2,\\n    minorRadius = 1/2,\\n    closureTargetValue = goldenPhi^-13,\\n    \
backgroundValue,\\n    massTerm = 1,\\n    coupling = 1/10,\\n    \
normalizedPsi,\\n    eigenvaluesCoarse,\\n    eigenvaluesFine\\n  },\\n\\n  \
normalizedPsi = normalizedConstantToroidalMode[majorRadius, minorRadius, \
closureTargetValue];\\n  backgroundValue = normalizedPsi[0, 0];\\n\\n  \
eigenvaluesCoarse = Sort[Re[flatTorusEigenSystem[8, 8, massTerm, coupling, \
backgroundValue, 6, 60][[1]]]];\\n  eigenvaluesFine = \
Sort[Re[flatTorusEigenSystem[12, 12, massTerm, coupling, backgroundValue, 6, \
60][[1]]]];\\n\\n  TestReport[{\\n\\n    VerificationTest[\\n      \
toroidalPeriodicClosureQ[majorRadius, minorRadius],\\n      True,\\n      \
TestID -> \\\"Toroidal embedding periodic closure\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      fieldPeriodicClosureQ[toroidalMode[2, 3, amp, \
alpha]],\\n      True,\\n      TestID -> \\\"Toroidal mode periodicity\\\"\\n \
   ],\\n\\n    VerificationTest[\\n      FullSimplify[\\n        \
flatTorusEigenvalue[0, 0, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue] ==\\n        effectiveMassTerm[massTerm, coupling, \
backgroundValue],\\n        Assumptions -> $Assumptions\\n      ],\\n      \
True,\\n      TestID -> \\\"Zero mode eigenvalue equals effective mass\\\"\\n \
   ],\\n\\n    VerificationTest[\\n      TrueQ[\\n        \
flatTorusEigenvalue[1, 0, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue] >\\n        flatTorusEigenvalue[0, 0, majorRadius, \
minorRadius, massTerm, coupling, backgroundValue]\\n      ],\\n      True,\\n \
     TestID -> \\\"Nonzero mode exceeds zero mode\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      Length[stableFlatTorusModes[3, majorRadius, \
minorRadius, massTerm, coupling, backgroundValue]] > 0,\\n      True,\\n      \
TestID -> \\\"Stable flat torus modes exist\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      Min[eigenvaluesCoarse] > 0,\\n      True,\\n      \
TestID -> \\\"Coarse-grid eigenvalues positive\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      Max[Abs[eigenvaluesCoarse - eigenvaluesFine[[1 ;; \
Length[eigenvaluesCoarse]]]] ] < 10,\\n      True,\\n      TestID -> \
\\\"Resolution refinement remains bounded\\\"\\n    ]\\n\\n  }]\\n];\\n```\\n\
\\n---\\n\\n## 11. Framework \
summary\\n\\n```wl\\nClearAll[smallestScaleToroidalLinearizedFramework];\\n\\\
nsmallestScaleToroidalLinearizedFramework[] := Module[\\n  {\\n    \
majorRadius = 3/2,\\n    minorRadius = 1/2,\\n    closureTargetValue = \
goldenPhi^-13,\\n    normalizedPsi,\\n    backgroundValue,\\n    massTerm = \
1,\\n    coupling = 1/10\\n  },\\n\\n  normalizedPsi = \
normalizedConstantToroidalMode[majorRadius, minorRadius, closureTargetValue];\
\\n  backgroundValue = normalizedPsi[0, 0];\\n\\n  <|\\n    \
\\\"FrameworkVersion\\\" -> \\\"Phase3.ToroidalLinearization\\\",\\n    \
\\\"ScaleIndex\\\" -> smallestScaleIndex,\\n    \\\"Geometry\\\" -> \
toroidalGeometrySummary[majorRadius, minorRadius],\\n    \
\\\"ClosureTarget\\\" -> closureTargetValue,\\n    \\\"BackgroundValue\\\" -> \
backgroundValue,\\n    \\\"LinearizedModel\\\" -> \
linearizedToroidalModelSummary[majorRadius, minorRadius, massTerm, coupling, \
backgroundValue, 3],\\n    \\\"SampleNumericalEigenvalues\\\" -> \
flatTorusEigenSystem[10, 10, massTerm, coupling, backgroundValue, 8, \
80][[1]],\\n    \\\"Tests\\\" -> smallestScaleLinearizationTestSuite[]\\n  |>\
\\n];\\n```\\n\\nRun the framework \
summary:\\n\\n```wl\\nsmallestScaleToroidalLinearizedFramework[]\\n```\\n\\n--\
-\\n\\n## 12. Interactive exploration interface\\n\\nThis interface explores \
the linearized flat-torus proxy spectrum.\\n\\n```wl\\nManipulate[\\n Module[\
\\n  {\\n    backgroundValue,\\n    eigenTable,\\n    \
numericalEigenvalues,\\n    modePlot\\n  },\\n\\n  backgroundValue = \
normalizedConstantToroidalMode[majorRadius, minorRadius, \
closureTargetValue][0, 0];\\n\\n  eigenTable = Grid[\\n    Prepend[\\n      \
Flatten[\\n        Table[\\n          {\\n            {m, n},\\n            \
N[flatTorusEigenvalue[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue], 20],\\n            N[flatTorusFrequency[m, n, majorRadius, \
minorRadius, massTerm, coupling, backgroundValue], 20]\\n          },\\n      \
    {m, 0, maxMode}, {n, 0, maxMode}\\n        ],\\n        1\\n      ],\\n   \
   {\\\"Mode\\\", \\\"Eigenvalue\\\", \\\"Frequency\\\"}\\n    ],\\n    Frame \
-> All\\n  ];\\n\\n  numericalEigenvalues = flatTorusEigenSystem[nU, nV, \
massTerm, coupling, backgroundValue, eigenCount, wp][[1]];\\n\\n  modePlot = \
Plot3D[\\n    Evaluate[Re[toroidalMode[modeU, modeV, 1, alpha][u, v]]],\\n    \
{u, 0, 2 Pi}, {v, 0, 2 Pi},\\n    Mesh -> None,\\n    PlotPoints -> 50,\\n    \
ColorFunction -> \\\"SolarColors\\\",\\n    PlotLabel -> Row[{\\\"Re \
mode(\\\", modeU, \\\",\\\", modeV, \\\")\\\"}]\\n  ];\\n\\n  Column[{\\n    \
Row[{\\\"Background value: \\\", N[backgroundValue, 20]}],\\n    \
Row[{\\\"Effective mass term: \\\", N[effectiveMassTerm[massTerm, coupling, \
backgroundValue], 20]}],\\n    Row[{\\\"Numerical eigenvalues: \\\", \
N[numericalEigenvalues, 10]}],\\n    eigenTable,\\n    modePlot\\n  }]\\n \
],\\n {{majorRadius, 1.5, \\\"Major radius\\\"}, 0.6, 3, Appearance -> \
\\\"Labeled\\\"},\\n {{minorRadius, 0.5, \\\"Minor radius\\\"}, 0.1, 1.2, \
Appearance -> \\\"Labeled\\\"},\\n Delimiter,\\n {{closureTargetValue, \
goldenPhi^-13, \\\"Closure target\\\"}, 10^-6, 1, Appearance -> \\\"Labeled\\\
\"},\\n {{massTerm, 1, \\\"Mass term\\\"}, 0, 5, Appearance -> \
\\\"Labeled\\\"},\\n {{coupling, 0.1, \\\"Quartic coupling\\\"}, 0, 2, \
Appearance -> \\\"Labeled\\\"},\\n {{alpha, 0, \\\"Envelope alpha\\\"}, 0, 2, \
Appearance -> \\\"Labeled\\\"},\\n Delimiter,\\n {{maxMode, 2, \\\"Analytic \
max mode\\\"}, 0, 5, 1, Appearance -> \\\"Labeled\\\"},\\n {{modeU, 1, \
\\\"Plot mode m\\\"}, 0, 6, 1, Appearance -> \\\"Labeled\\\"},\\n {{modeV, 1, \
\\\"Plot mode n\\\"}, 0, 6, 1, Appearance -> \\\"Labeled\\\"},\\n \
Delimiter,\\n {{nU, 10, \\\"Grid u\\\"}, 6, 20, 1, Appearance -> \
\\\"Labeled\\\"},\\n {{nV, 10, \\\"Grid v\\\"}, 6, 20, 1, Appearance -> \
\\\"Labeled\\\"},\\n {{eigenCount, 8, \\\"Eigenvalue count\\\"}, 4, 20, 1, \
Appearance -> \\\"Labeled\\\"},\\n {{wp, 60, \\\"Working precision\\\"}, {40, \
60, 80, 100}},\\n SaveDefinitions -> True\\n]\\n```\"\>",
                    Background->None,
                    FrameMargins->1,
                    FrameStyle->Dynamic[
                    CurrentValue[Background]],
                    StripOnInput->False], True->
                    FrameBox[
                    
                    StyleBox["\<\"# Toroidal Closure / Dimensional Stability \
Framework\\n\\n## Phase 3 Notebook: Toroidal Geometry, Linearization, and \
Eigenspectrum Tests\\n\\nThis notebook extends the toroidal geometry module \
by adding:\\n\\n- a torus-compatible scalar field operator,\\n- linearization \
about a background toroidal mode,\\n- Fourier-mode eigenspectrum formulas on \
the flat torus proxy,\\n- numerical matrix-based eigenspectrum tests,\\n- \
convergence-under-resolution checks,\\n- and an interactive exploration \
interface.\\n\\nThis is a **testable computational scaffold**. It does \
**not** claim physical identification beyond what is explicitly \
encoded.\\n\\n---\\n\\n## 1. Precision policy and \
assumptions\\n\\n```wl\\nClearAll[setToroidalFrameworkPrecision];\\n\\\
nsetToroidalFrameworkPrecision[] := (\\n  $Assumptions = Element[\\n      \
{\\n        majorRadius, minorRadius, u, v,\\n        amp, alpha, beta,\\n    \
    massTerm, coupling,\\n        fieldValue, backgroundValue,\\n        \
closureTargetValue\\n      }, Reals\\n    ] && majorRadius > 0 && minorRadius \
> 0 && majorRadius > minorRadius &&\\n    0 <= u <= 2 Pi && 0 <= v <= 2 Pi && \
alpha >= 0;\\n  $MaxExtraPrecision = \
1000;\\n)\\n\\nsetToroidalFrameworkPrecision[];\\n```\\n\\nAs before, exact \
``WorkingPrecision -> Infinity`` is not generally executable for numerical \
eigensolvers or integrations. The executable approximation used here \
is:\\n\\n- exact symbolic derivation where possible,\\n- high finite \
precision numerical evaluation when necessary,\\n- explicit residual and \
convergence tests.\\n\\n---\\n\\n## 2. Scale \
bookkeeping\\n\\n```wl\\nClearAll[goldenPhi, planckLength, \
smallestScaleIndex, scaleLength];\\n\\ngoldenPhi = (1 + Sqrt[5]) / \
2;\\nplanckLength = Quantity[1.616255*10^-35, \
\\\"Meters\\\"];\\nsmallestScaleIndex = 0;\\n\\nscaleLength[n_Integer ? \
NonNegative] := UnitSimplify[planckLength \
goldenPhi^n];\\n```\\n\\n---\\n\\n## 3. Toroidal geometry module\\n\\nWe keep \
the explicit torus embedding from the previous \
phase:\\n\\n$$\\n\\\\mathbf{x}(u,v)=\\\\{(R+r\\\\cos v)\\\\cos u,(R+r\\\\cos \
v)\\\\sin u,r\\\\sin v\\\\}\\n$$\\n\\n```wl\\nClearAll[\\n  torusEmbedding, \
torusTangentU, torusTangentV,\\n  torusMetricMatrixExact, \
torusMetricMatrix,\\n  torusInverseMetricExact, torusAreaElement, \
torusSurfaceArea\\n];\\n\\ntorusEmbedding[majorRadius_, minorRadius_] :=\\n  \
Function[{u, v}, {\\n    (majorRadius + minorRadius Cos[v]) Cos[u],\\n    \
(majorRadius + minorRadius Cos[v]) Sin[u],\\n    minorRadius Sin[v]\\n  \
}];\\n\\ntorusTangentU[majorRadius_, minorRadius_] := Module[\\n  {embed = \
torusEmbedding[majorRadius, minorRadius]},\\n  Function[{u, v}, D[embed[u, \
v], u]]\\n];\\n\\ntorusTangentV[majorRadius_, minorRadius_] := Module[\\n  \
{embed = torusEmbedding[majorRadius, minorRadius]},\\n  Function[{u, v}, \
D[embed[u, v], v]]\\n];\\n\\ntorusMetricMatrixExact[majorRadius_, \
minorRadius_] := {\\n  {(majorRadius + minorRadius Cos[v])^2, 0},\\n  {0, \
minorRadius^2}\\n};\\n\\ntorusMetricMatrix[majorRadius_, minorRadius_] := \
torusMetricMatrixExact[majorRadius, \
minorRadius];\\n\\ntorusInverseMetricExact[majorRadius_, minorRadius_] := \
Simplify[\\n  Inverse[torusMetricMatrixExact[majorRadius, minorRadius]],\\n  \
Assumptions -> $Assumptions\\n];\\n\\ntorusAreaElement[majorRadius_, \
minorRadius_] := Simplify[\\n  Sqrt[Det[torusMetricMatrix[majorRadius, \
minorRadius]]],\\n  Assumptions -> \
$Assumptions\\n];\\n\\ntorusSurfaceArea[majorRadius_, minorRadius_] := \
FullSimplify[\\n  Integrate[\\n    torusAreaElement[majorRadius, \
minorRadius],\\n    {u, 0, 2 Pi}, {v, 0, 2 Pi},\\n    Assumptions -> \
$Assumptions\\n  ],\\n  Assumptions -> \
$Assumptions\\n];\\n```\\n\\n---\\n\\n## 4. Periodic scalar modes on the \
torus\\n\\n```wl\\nClearAll[toroidalMode, toroidalRealMode, \
constantToroidalMode];\\n\\ntoroidalMode[m_Integer, n_Integer, amp_, alpha_: \
0] :=\\n  Function[{u, v}, amp Exp[-alpha Cos[v]] Exp[I (m u + n \
v)]];\\n\\ntoroidalRealMode[m_Integer, n_Integer, amp_, alpha_: 0, beta_: 0] \
:=\\n  Function[{u, v}, amp Exp[-alpha Cos[v]] Cos[m u + n v + \
beta]];\\n\\nconstantToroidalMode[amp_] := Function[{u, v}, \
amp];\\n```\\n\\nPeriodicity \
tests:\\n\\n```wl\\nClearAll[toroidalPeriodicClosureQ, \
fieldPeriodicClosureQ];\\n\\ntoroidalPeriodicClosureQ[majorRadius_, \
minorRadius_] := Module[\\n  {embed},\\n  embed = torusEmbedding[majorRadius, \
minorRadius];\\n  Simplify[\\n    embed[u + 2 Pi, v] == embed[u, v] && \
embed[u, v + 2 Pi] == embed[u, v],\\n    Assumptions -> $Assumptions\\n  \
]\\n];\\n\\nfieldPeriodicClosureQ[psi_] := Simplify[\\n  psi[u + 2 Pi, v] == \
psi[u, v] && psi[u, v + 2 Pi] == psi[u, v],\\n  Assumptions -> \
$Assumptions\\n];\\n```\\n\\n---\\n\\n## 5. Toroidal closure functional and \
residual\\n\\n```wl\\nClearAll[\\n  toroidalClosureFunctional, \
toroidalClosureResidual,\\n  closureAmplitudeRule, \
normalizedConstantToroidalMode\\n];\\n\\ntoroidalClosureFunctional[psi_, \
majorRadius_, minorRadius_, wp_: 80] := NIntegrate[\\n  Evaluate[Abs[psi[u, \
v]]^2 torusAreaElement[majorRadius, minorRadius]],\\n  {u, 0, 2 Pi}, {v, 0, 2 \
Pi},\\n  WorkingPrecision -> wp,\\n  AccuracyGoal -> 30,\\n  PrecisionGoal -> \
30,\\n  Method -> {\\\"GlobalAdaptive\\\", \\\"SymbolicProcessing\\\" -> \
0}\\n];\\n\\ntoroidalClosureResidual[psi_, majorRadius_, minorRadius_, \
closureTargetValue_, wp_: 80] :=\\n  N[toroidalClosureFunctional[psi, \
majorRadius, minorRadius, wp] - closureTargetValue, \
wp];\\n\\nclosureAmplitudeRule[majorRadius_, minorRadius_, \
closureTargetValue_] := Solve[\\n  amp^2 torusSurfaceArea[majorRadius, \
minorRadius] == closureTargetValue,\\n  amp,\\n  \
Reals\\n];\\n\\nnormalizedConstantToroidalMode[majorRadius_, minorRadius_, \
closureTargetValue_] := Module[\\n  {ampRule},\\n  ampRule = \
First[closureAmplitudeRule[majorRadius, minorRadius, closureTargetValue]];\\n \
 Function[{u, v}, amp /. ampRule]\\n];\\n```\\n\\n---\\n\\n## 6. Linearized \
field model on the torus\\n\\nTo add a meaningful stability layer, we \
introduce a scalar energy-density surrogate on the \
torus:\\n\\n$$\\n\\\\mathcal{E}[\\\\psi]=g^{ij}\\\\partial_i \
\\\\psi\\\\,\\\\partial_j \\\\psi + m_0^2 \\\\psi^2 + \\\\lambda \
\\\\psi^4\\n$$\\n\\nA linearization about a constant background \
$$\\\\psi=\\\\psi_0+\\\\delta\\\\psi$$ yields the Hessian operator\\n\\n$$\\n\
\\\\mathcal{L}_{\\\\mathrm{lin}}\\\\,\\\\delta\\\\psi = -\\\\Delta_T \
\\\\delta\\\\psi + \\\\left(m_0^2 + 12\\\\lambda \
\\\\psi_0^2\\\\right)\\\\delta\\\\psi\\n$$\\n\\nwhere $$\\\\Delta_T$$ is a \
torus Laplace-type operator.\\n\\nFor a first computational scaffold, we use \
a **flat torus proxy** with periodic coordinates and effective lengths \
$$2\\\\pi R$$ and $$2\\\\pi r$$. This preserves periodic closure and gives \
exact Fourier eigenvalues.\\n\\n```wl\\nClearAll[effectiveMassTerm, \
flatTorusEigenvalue, flatTorusFrequency];\\n\\neffectiveMassTerm[massTerm_, \
coupling_, backgroundValue_] :=\\n  Simplify[massTerm + 12 coupling \
backgroundValue^2, Assumptions -> \
$Assumptions];\\n\\nflatTorusEigenvalue[m_Integer, n_Integer, majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_] :=\\n  Simplify[\\n    \
m^2/majorRadius^2 + n^2/minorRadius^2 + effectiveMassTerm[massTerm, coupling, \
backgroundValue],\\n    Assumptions -> $Assumptions\\n  \
];\\n\\nflatTorusFrequency[m_Integer, n_Integer, majorRadius_, minorRadius_, \
massTerm_, coupling_, backgroundValue_] :=\\n  Simplify[\\n    \
Sqrt[flatTorusEigenvalue[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue]],\\n    Assumptions -> $Assumptions\\n  \
];\\n```\\n\\nUndamped harmonic mode condition for this proxy is positivity \
of the eigenvalue.\\n\\n```wl\\nClearAll[undampedModeQ, \
stableFlatTorusModes];\\n\\nundampedModeQ[m_Integer, n_Integer, majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_] :=\\n  Simplify[\\n    \
flatTorusEigenvalue[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue] > 0,\\n    Assumptions -> $Assumptions\\n  \
];\\n\\nstableFlatTorusModes[maxMode_Integer ? NonNegative, majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_] :=\\n  Select[\\n    \
Flatten[Table[{m, n}, {m, 0, maxMode}, {n, 0, maxMode}], 1],\\n    \
TrueQ[undampedModeQ[#[[1]], #[[2]], majorRadius, minorRadius, massTerm, \
coupling, backgroundValue]] &\\n  ];\\n```\\n\\n---\\n\\n## 7. Matrix \
eigenspectrum on a periodic rectangular torus proxy\\n\\nTo make the \
eigenspectrum directly testable, we discretize the operator\\n\\n$$\\nL = -\\\
\\partial_u^2 - \\\\partial_v^2 + \\\\mu_{\\\\mathrm{eff}}\\n$$\\n\\non a \
doubly periodic grid. This is a numerical proxy for the linearized toroidal \
operator.\\n\\n```wl\\nClearAll[\\n  periodicSecondDifferenceMatrix,\\n  \
flatTorusOperatorMatrix,\\n  \
flatTorusEigenSystem\\n];\\n\\nperiodicSecondDifferenceMatrix[nPts_Integer ? \
Positive, domainLength_: 2 Pi, wp_: 80] := Module[\\n  {h, rules},\\n  h = \
SetPrecision[domainLength/nPts, wp];\\n  rules = Join[\\n    Table[{i, i} -> \
SetPrecision[-2/h^2, wp], {i, nPts}],\\n    Table[{i, i + 1} -> \
SetPrecision[1/h^2, wp], {i, 1, nPts - 1}],\\n    Table[{i + 1, i} -> \
SetPrecision[1/h^2, wp], {i, 1, nPts - 1}],\\n    {\\n      {1, nPts} -> \
SetPrecision[1/h^2, wp],\\n      {nPts, 1} -> SetPrecision[1/h^2, wp]\\n    }\
\\n  ];\\n  SparseArray[rules, {nPts, \
nPts}]\\n];\\n\\nflatTorusOperatorMatrix[nU_Integer ? Positive, nV_Integer ? \
Positive, massEff_, wp_: 80] := Module[\\n  {du2, dv2, idU, idV},\\n  du2 = \
periodicSecondDifferenceMatrix[nU, 2 Pi, wp];\\n  dv2 = \
periodicSecondDifferenceMatrix[nV, 2 Pi, wp];\\n  idU = IdentityMatrix[nU, \
SparseArray];\\n  idV = IdentityMatrix[nV, SparseArray];\\n  \
N[-KroneckerProduct[du2, idV] - KroneckerProduct[idU, dv2] + massEff \
IdentityMatrix[nU nV, SparseArray], \
wp]\\n];\\n\\nflatTorusEigenSystem[nU_Integer ? Positive, nV_Integer ? \
Positive, massTerm_, coupling_, backgroundValue_, count_Integer ? Positive, \
wp_: 80] := Module[\\n  {massEff, vals, vecs},\\n  massEff = \
N[effectiveMassTerm[massTerm, coupling, backgroundValue], wp];\\n  {vals, \
vecs} = Eigensystem[\\n    flatTorusOperatorMatrix[nU, nV, massEff, wp],\\n   \
 count,\\n    Method -> {\\\"Arnoldi\\\", \\\"Criteria\\\" -> \
\\\"RealPart\\\"}\\n  ];\\n  {vals, vecs}\\n];\\n```\\n\\n---\\n\\n## 8. \
Eigenspectrum diagnostics and \
convergence\\n\\n```wl\\nClearAll[eigenspectrumSummary, \
eigenspectrumResolutionStudy];\\n\\neigenspectrumSummary[maxMode_Integer ? \
NonNegative, majorRadius_, minorRadius_, massTerm_, coupling_, \
backgroundValue_] :=\\n  Association[\\n    Flatten[\\n      Table[\\n        \
({m, n} -> <|\\n          \\\"Eigenvalue\\\" -> flatTorusEigenvalue[m, n, \
majorRadius, minorRadius, massTerm, coupling, backgroundValue],\\n          \
\\\"Frequency\\\" -> flatTorusFrequency[m, n, majorRadius, minorRadius, \
massTerm, coupling, backgroundValue],\\n          \\\"UndampedQ\\\" -> \
undampedModeQ[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue]\\n        |>),\\n        {m, 0, maxMode}, {n, 0, maxMode}\\n \
     ],\\n      1\\n    ]\\n  \
];\\n\\neigenspectrumResolutionStudy[resolutions_List, massTerm_, coupling_, \
backgroundValue_, count_Integer : 8, wp_: 80] :=\\n  AssociationThread[\\n    \
resolutions,\\n    (flatTorusEigenSystem[#[[1]], #[[2]], massTerm, coupling, \
backgroundValue, count, wp][[1]] &) /@ resolutions\\n  \
];\\n```\\n\\n---\\n\\n## 9. Geometry and linearization \
summaries\\n\\n```wl\\nClearAll[toroidalGeometrySummary, \
linearizedToroidalModelSummary];\\n\\ntoroidalGeometrySummary[majorRadius_, \
minorRadius_] := <|\\n  \\\"Embedding\\\" -> \
HoldForm[torusEmbedding[majorRadius, minorRadius][u, v]],\\n  \\\"Metric\\\" \
-> torusMetricMatrixExact[majorRadius, minorRadius],\\n  \
\\\"InverseMetric\\\" -> torusInverseMetricExact[majorRadius, \
minorRadius],\\n  \\\"AreaElement\\\" -> torusAreaElement[majorRadius, \
minorRadius],\\n  \\\"SurfaceArea\\\" -> torusSurfaceArea[majorRadius, \
minorRadius],\\n  \\\"PeriodicClosureQ\\\" -> \
toroidalPeriodicClosureQ[majorRadius, \
minorRadius]\\n|>;\\n\\nlinearizedToroidalModelSummary[majorRadius_, \
minorRadius_, massTerm_, coupling_, backgroundValue_, maxMode_: 3] := <|\\n  \
\\\"EffectiveMassTerm\\\" -> effectiveMassTerm[massTerm, coupling, \
backgroundValue],\\n  \\\"StableModes\\\" -> stableFlatTorusModes[maxMode, \
majorRadius, minorRadius, massTerm, coupling, backgroundValue],\\n  \
\\\"ModeSummary\\\" -> eigenspectrumSummary[maxMode, majorRadius, \
minorRadius, massTerm, coupling, \
backgroundValue]\\n|>;\\n```\\n\\n---\\n\\n## 10. Smallest-scale tests: \
linearization and \
eigenspectrum\\n\\n```wl\\nClearAll[smallestScaleLinearizationTestSuite];\\n\\\
nsmallestScaleLinearizationTestSuite[] := Module[\\n  {\\n    majorRadius = \
3/2,\\n    minorRadius = 1/2,\\n    closureTargetValue = goldenPhi^-13,\\n    \
backgroundValue,\\n    massTerm = 1,\\n    coupling = 1/10,\\n    \
normalizedPsi,\\n    eigenvaluesCoarse,\\n    eigenvaluesFine\\n  },\\n\\n  \
normalizedPsi = normalizedConstantToroidalMode[majorRadius, minorRadius, \
closureTargetValue];\\n  backgroundValue = normalizedPsi[0, 0];\\n\\n  \
eigenvaluesCoarse = Sort[Re[flatTorusEigenSystem[8, 8, massTerm, coupling, \
backgroundValue, 6, 60][[1]]]];\\n  eigenvaluesFine = \
Sort[Re[flatTorusEigenSystem[12, 12, massTerm, coupling, backgroundValue, 6, \
60][[1]]]];\\n\\n  TestReport[{\\n\\n    VerificationTest[\\n      \
toroidalPeriodicClosureQ[majorRadius, minorRadius],\\n      True,\\n      \
TestID -> \\\"Toroidal embedding periodic closure\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      fieldPeriodicClosureQ[toroidalMode[2, 3, amp, \
alpha]],\\n      True,\\n      TestID -> \\\"Toroidal mode periodicity\\\"\\n \
   ],\\n\\n    VerificationTest[\\n      FullSimplify[\\n        \
flatTorusEigenvalue[0, 0, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue] ==\\n        effectiveMassTerm[massTerm, coupling, \
backgroundValue],\\n        Assumptions -> $Assumptions\\n      ],\\n      \
True,\\n      TestID -> \\\"Zero mode eigenvalue equals effective mass\\\"\\n \
   ],\\n\\n    VerificationTest[\\n      TrueQ[\\n        \
flatTorusEigenvalue[1, 0, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue] >\\n        flatTorusEigenvalue[0, 0, majorRadius, \
minorRadius, massTerm, coupling, backgroundValue]\\n      ],\\n      True,\\n \
     TestID -> \\\"Nonzero mode exceeds zero mode\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      Length[stableFlatTorusModes[3, majorRadius, \
minorRadius, massTerm, coupling, backgroundValue]] > 0,\\n      True,\\n      \
TestID -> \\\"Stable flat torus modes exist\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      Min[eigenvaluesCoarse] > 0,\\n      True,\\n      \
TestID -> \\\"Coarse-grid eigenvalues positive\\\"\\n    ],\\n\\n    \
VerificationTest[\\n      Max[Abs[eigenvaluesCoarse - eigenvaluesFine[[1 ;; \
Length[eigenvaluesCoarse]]]] ] < 10,\\n      True,\\n      TestID -> \
\\\"Resolution refinement remains bounded\\\"\\n    ]\\n\\n  }]\\n];\\n```\\n\
\\n---\\n\\n## 11. Framework \
summary\\n\\n```wl\\nClearAll[smallestScaleToroidalLinearizedFramework];\\n\\\
nsmallestScaleToroidalLinearizedFramework[] := Module[\\n  {\\n    \
majorRadius = 3/2,\\n    minorRadius = 1/2,\\n    closureTargetValue = \
goldenPhi^-13,\\n    normalizedPsi,\\n    backgroundValue,\\n    massTerm = \
1,\\n    coupling = 1/10\\n  },\\n\\n  normalizedPsi = \
normalizedConstantToroidalMode[majorRadius, minorRadius, closureTargetValue];\
\\n  backgroundValue = normalizedPsi[0, 0];\\n\\n  <|\\n    \
\\\"FrameworkVersion\\\" -> \\\"Phase3.ToroidalLinearization\\\",\\n    \
\\\"ScaleIndex\\\" -> smallestScaleIndex,\\n    \\\"Geometry\\\" -> \
toroidalGeometrySummary[majorRadius, minorRadius],\\n    \
\\\"ClosureTarget\\\" -> closureTargetValue,\\n    \\\"BackgroundValue\\\" -> \
backgroundValue,\\n    \\\"LinearizedModel\\\" -> \
linearizedToroidalModelSummary[majorRadius, minorRadius, massTerm, coupling, \
backgroundValue, 3],\\n    \\\"SampleNumericalEigenvalues\\\" -> \
flatTorusEigenSystem[10, 10, massTerm, coupling, backgroundValue, 8, \
80][[1]],\\n    \\\"Tests\\\" -> smallestScaleLinearizationTestSuite[]\\n  |>\
\\n];\\n```\\n\\nRun the framework \
summary:\\n\\n```wl\\nsmallestScaleToroidalLinearizedFramework[]\\n```\\n\\n--\
-\\n\\n## 12. Interactive exploration interface\\n\\nThis interface explores \
the linearized flat-torus proxy spectrum.\\n\\n```wl\\nManipulate[\\n Module[\
\\n  {\\n    backgroundValue,\\n    eigenTable,\\n    \
numericalEigenvalues,\\n    modePlot\\n  },\\n\\n  backgroundValue = \
normalizedConstantToroidalMode[majorRadius, minorRadius, \
closureTargetValue][0, 0];\\n\\n  eigenTable = Grid[\\n    Prepend[\\n      \
Flatten[\\n        Table[\\n          {\\n            {m, n},\\n            \
N[flatTorusEigenvalue[m, n, majorRadius, minorRadius, massTerm, coupling, \
backgroundValue], 20],\\n            N[flatTorusFrequency[m, n, majorRadius, \
minorRadius, massTerm, coupling, backgroundValue], 20]\\n          },\\n      \
    {m, 0, maxMode}, {n, 0, maxMode}\\n        ],\\n        1\\n      ],\\n   \
   {\\\"Mode\\\", \\\"Eigenvalue\\\", \\\"Frequency\\\"}\\n    ],\\n    Frame \
-> All\\n  ];\\n\\n  numericalEigenvalues = flatTorusEigenSystem[nU, nV, \
massTerm, coupling, backgroundValue, eigenCount, wp][[1]];\\n\\n  modePlot = \
Plot3D[\\n    Evaluate[Re[toroidalMode[modeU, modeV, 1, alpha][u, v]]],\\n    \
{u, 0, 2 Pi}, {v, 0, 2 Pi},\\n    Mesh -> None,\\n    PlotPoints -> 50,\\n    \
ColorFunction -> \\\"SolarColors\\\",\\n    PlotLabel -> Row[{\\\"Re \
mode(\\\", modeU, \\\",\\\", modeV, \\\")\\\"}]\\n  ];\\n\\n  Column[{\\n    \
Row[{\\\"Background value: \\\", N[backgroundValue, 20]}],\\n    \
Row[{\\\"Effective mass term: \\\", N[effectiveMassTerm[massTerm, coupling, \
backgroundValue], 20]}],\\n    Row[{\\\"Numerical eigenvalues: \\\", \
N[numericalEigenvalues, 10]}],\\n    eigenTable,\\n    modePlot\\n  }]\\n \
],\\n {{majorRadius, 1.5, \\\"Major radius\\\"}, 0.6, 3, Appearance -> \
\\\"Labeled\\\"},\\n {{minorRadius, 0.5, \\\"Minor radius\\\"}, 0.1, 1.2, \
Appearance -> \\\"Labeled\\\"},\\n Delimiter,\\n {{closureTargetValue, \
goldenPhi^-13, \\\"Closure target\\\"}, 10^-6, 1, Appearance -> \\\"Labeled\\\
\"},\\n {{massTerm, 1, \\\"Mass term\\\"}, 0, 5, Appearance -> \
\\\"Labeled\\\"},\\n {{coupling, 0.1, \\\"Quartic coupling\\\"}, 0, 2, \
Appearance -> \\\"Labeled\\\"},\\n {{alpha, 0, \\\"Envelope alpha\\\"}, 0, 2, \
Appearance -> \\\"Labeled\\\"},\\n Delimiter,\\n {{maxMode, 2, \\\"Analytic \
max mode\\\"}, 0, 5, 1, Appearance -> \\\"Labeled\\\"},\\n {{modeU, 1, \
\\\"Plot mode m\\\"}, 0, 6, 1, Appearance -> \\\"Labeled\\\"},\\n {{modeV, 1, \
\\\"Plot mode n\\\"}, 0, 6, 1, Appearance -> \\\"Labeled\\\"},\\n \
Delimiter,\\n {{nU, 10, \\\"Grid u\\\"}, 6, 20, 1, Appearance -> \
\\\"Labeled\\\"},\\n {{nV, 10, \\\"Grid v\\\"}, 6, 20, 1, Appearance -> \
\\\"Labeled\\\"},\\n {{eigenCount, 8, \\\"Eigenvalue count\\\"}, 4, 20, 1, \
Appearance -> \\\"Labeled\\\"},\\n {{wp, 60, \\\"Working precision\\\"}, {40, \
60, 80, 100}},\\n SaveDefinitions -> True\\n]\\n```\"\>",
                    StripOnInput->False,
                    FontColor->GrayLevel[0]],
                    Background->RGBColor[0.87, 0.94, 1],
                    FrameMargins->1,
                    FrameStyle->Dynamic[
                    CurrentValue[Background]],
