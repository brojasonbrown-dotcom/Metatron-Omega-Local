Cell[CellGroupData[{

Cell["10. Morphism pipeline L0 -> L1 -> L2", "Section",ExpressionUUID->"cbbdd53b-f13c-1842-8bb9-1e2bcaed88e7"],

Cell["We expose callable transformations as pure functions. ", "Text",ExpressionUUID->"25911423-99aa-7f47-b87b-e96d7269a9f9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"l0ToL1", ",", "l1ToL2", ",", "fullPipeline"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"l0ToL1", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"seed", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Seed\>\"", "->", "seed"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<ActionDensity\>\"", "->", 
         RowBox[{"HoldForm", "[", 
          RowBox[{"lagrangianDensity", "[", 
           RowBox[{"rho", ",", "chi", ",", "res"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<StationarityRules\>\"", "->", 
         "layer1PointwiseSolution"}]}], "\[IndentingNewLine]", "  ", "|>"}]}],
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"l1ToL2", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"layer1", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Layer1\>\"", "->", "layer1"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<MeasurementModel\>\"", 
         "->", "\"\<SphericalIntegralKernel\>\""}]}], "\[IndentingNewLine]", 
       "  ", "|>"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fullPipeline", "=", 
   RowBox[{"RightComposition", "[", 
    RowBox[{"l0ToL1", ",", "l1ToL2"}], "]"}]}], ";"}]}], "Input",ExpressionUUI\
D->"a4612572-88f7-1c44-9136-558c67f3d34e"],

