Cell[CellGroupData[{

Cell["7. Linearized stability and undamped mode extraction", "Section",ExpressionUUID->"7c47393b-ad44-434e-9254-bf3c9c163db5"],

Cell["\<\
For a first stable-mode test, use a radial operator with toroidal-style \
periodic angle closure represented by spherical harmonics and a radial \
Sturm-Liouville component.\
\>", "Text",ExpressionUUID->"409909bd-5b6b-044d-8db1-c94a90f8900b"],

Cell[TextData[{
 "We define a simple linear operator: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         StyleBox["u", "TI"], "\[LongEqual]", "-", 
         SuperscriptBox[
          StyleBox["u", "TI"], "\[Prime]\[Prime]"], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}], "+", 
         SubsuperscriptBox["\[Omega]", "0", "2"], 
         StyleBox["u", "TI"], 
         RowBox[{"(", 
           StyleBox["r", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{L}u = -u''(r) + \\omega_0^2 u(r)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fcf466ff-f0ac-2849-9c41-5231a10dc634"],
 "with Dirichlet condition on a finite domain $[0, r_{max}]$. "
}], "Text",ExpressionUUID->"0269a5ab-ee53-f840-82ae-a4754b9d201b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "radialOperatorMatrix", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"radialOperatorMatrix", "[", 
    RowBox[{
     RowBox[{"nPts_Integer", "?", "Positive"}], ",", 
     RowBox[{"radMax_", ":", " ", "1"}], ",", 
     RowBox[{"omega0_", ":", " ", "1"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", ",", "lap1d", ",", "id"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"h", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"radMax", "/", 
          RowBox[{"(", 
           RowBox[{"nPts", "+", "1"}], ")"}]}], ",", "50"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"lap1d", "=", 
       RowBox[{"SparseArray", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"Band", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"2", "/", 
              RowBox[{"h", "^", "2"}]}], ",", "nPts"}], "]"}]}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"Band", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], "]"}], "->", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "1"}], "/", 
              RowBox[{"h", "^", "2"}]}], ",", 
             RowBox[{"nPts", "-", "1"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"Band", "[", 
            RowBox[{"{", 
             RowBox[{"2", ",", "1"}], "}"}], "]"}], "->", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "1"}], "/", 
              RowBox[{"h", "^", "2"}]}], ",", 
             RowBox[{"nPts", "-", "1"}]}], "]"}]}]}], "\[IndentingNewLine]", 
         "    ", "}"}], "\[IndentingNewLine]", "  ", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"id", "=", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"nPts", ",", "SparseArray"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Normal", "[", 
       RowBox[{"lap1d", "+", 
        RowBox[{
         RowBox[{"omega0", "^", "2"}], " ", "id"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"90838421-371e-9b4b-8f77-93cdedff9ed8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "stableFrequencies", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stableFrequencies", "[", 
    RowBox[{
     RowBox[{"nPts_Integer", "?", "Positive"}], ",", 
     RowBox[{"radMax_", ":", " ", "1"}], ",", 
     RowBox[{"omega0_", ":", " ", "1"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "evals", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"evals", "=", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"radialOperatorMatrix", "[", 
         RowBox[{"nPts", ",", "radMax", ",", "omega0"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", "evals", "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Im", "[", "#", "]"}], "==", "0"}], "&&", 
          RowBox[{
           RowBox[{"Re", "[", "#", "]"}], ">", "0"}]}], " ", "&"}]}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionU\
UID->"b2d7021b-52bc-0f4e-9fc3-272ea346583c"],

