Cell[CellGroupData[{

Cell["11. Smallest-scale test suite", "Section",ExpressionUUID->"f0706c40-a42e-6c48-ac95-abc06856d548"],

Cell["This suite checks only what is actually defined. ", "Text",ExpressionUUID->"38d2f0a2-a09e-7741-b110-9d25777320bc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "smallestScaleTestSuite", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"smallestScaleTestSuite", "[", "]"}], ":=", 
   RowBox[{"TestReport", "[", 
    RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Chop", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"goldenPhi", "^", "2"}], "-", "goldenPhi", "-", "1"}], ",", 
           RowBox[{"10", "^", 
            RowBox[{"-", "40"}]}]}], "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"TestID", "->", "\"\<Golden ratio identity\>\""}]}], 
       "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"scaleLength", "[", "0", "]"}], "===", "planckLength"}], ",",
         "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"TestID", "->", "\"\<Scale length at n=0\>\""}]}], 
       "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"scaleComplexity", "[", "0", "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"TestID", "->", "\"\<Scale complexity at n=0\>\""}]}], 
       "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"layer1PointwiseSolution", "===", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"chi", "->", "1"}], ",", 
            RowBox[{"rho", "->", 
             RowBox[{"-", 
              RowBox[{"res", "^", "2"}]}]}]}], "}"}], "}"}]}], ",", 
        "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{
        "TestID", "->", "\"\<Layer 1 pointwise stationary solution\>\""}]}], 
       "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Simplify", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"amp", "^", "2"}], " ", 
            RowBox[{"Integrate", "[", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"basePsi", "[", 
                  RowBox[{
                  "smallestScaleRadius", ",", "theta", ",", "phiAngle"}], 
                  "]"}], "]"}], "^", "2"}], " ", 
               RowBox[{"Sin", "[", "theta", "]"}]}], ",", 
              "\[IndentingNewLine]", "        ", 
              RowBox[{"{", 
               RowBox[{"theta", ",", "0", ",", "Pi"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"phiAngle", ",", "0", ",", 
                RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]",
               "        ", 
              RowBox[{"Assumptions", "->", 
               RowBox[{"amp", " ", "\.08", " ", "Reals"}]}]}], 
             "\[IndentingNewLine]", "      ", "]"}]}], " ", "/.", " ", 
           RowBox[{
            RowBox[{"First", "[", "closureAmplitudeRule", "]"}], "-", 
            "closureTarget"}]}], "\[IndentingNewLine]", "    ", "]"}], "==", 
         "0"}], ",", "\[IndentingNewLine]", "    ", "True", ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"TestID", "->", "\"\<Closure amplitude normalization\>\""}]}],
        "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"stableFrequencies", "[", 
           RowBox[{"12", ",", "1", ",", "1"}], "]"}], "]"}], ">", "0"}], ",", 
        "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"TestID", "->", "\"\<Stable frequencies exist\>\""}]}], 
       "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"missingVariables", "[", "]"}], "===", 
         RowBox[{"{", 
          RowBox[{"rho", ",", "chi", ",", "res"}], "}"}]}], ",", 
        "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"TestID", "->", "\"\<Missing variable extraction\>\""}]}], 
       "\[IndentingNewLine]", "  ", "]"}]}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "}"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"832e869c-d800-0d49-a2b5-160fb458ea1b"],

