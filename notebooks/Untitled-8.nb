Cell[CellGroupData[{

Cell["3. Fundamental constants and scale model", "Section",ExpressionUUID->"3e4b8b7a-cd40-9540-af8d-0637d487a0cd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "goldenPhi", ",", "lambdaCrit", ",", "silverDelta", ",", "geometricPi", ",",
      "planckLength", ",", "planckTime", ",", "cLight"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"goldenPhi", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}]}], ";"}]}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"lambdaCrit", "=", 
    RowBox[{"1", "/", 
     RowBox[{"goldenPhi", "^", "2"}]}]}], ";"}]}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"silverDelta", "=", 
    RowBox[{"1", "+", 
     RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}]}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"geometricPi", "=", 
    RowBox[{"4", "/", 
     RowBox[{"Sqrt", "[", "goldenPhi", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"planckLength", "=", 
    RowBox[{"Quantity", "[", 
     RowBox[{
      RowBox[{"1.616255", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "35"}]}]}], ",", "\"\<Meters\>\""}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"planckTime", "=", 
    RowBox[{"Quantity", "[", 
     RowBox[{
      RowBox[{"5.391247", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "44"}]}]}], ",", "\"\<Seconds\>\""}], "]"}]}], ";"}]}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"cLight", "=", 
    RowBox[{"Quantity", "[", 
     RowBox[{"299792458", ",", 
      RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}], 
   ";"}]}]}], "Input",ExpressionUUID->"f29f48a7-cf7d-4041-82ec-4431c85c5bb5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "stableScales", ",", "scaleLength", ",", "scaleTime", ",", 
     "scaleResolution", ",", "scaleComplexity", ",", "scaleInfoDensity"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stableScales", "=", 
    RowBox[{"{", 
     RowBox[{
     "0", ",", "13", ",", "20", ",", "40", ",", "60", ",", "80", ",", "100", ",",
       "120", ",", "140", ",", "160", ",", "180", ",", "186", ",", "200", ",",
       "220", ",", "240", ",", "260", ",", "280", ",", "292"}], "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleLength", "[", 
    RowBox[{"n_Integer", "?", "NonNegative"}], "]"}], ":=", 
   RowBox[{"UnitSimplify", "[", 
    RowBox[{"planckLength", "*", 
     RowBox[{"goldenPhi", "^", "n"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleTime", "[", 
    RowBox[{"n_Integer", "?", "NonNegative"}], "]"}], ":=", 
   RowBox[{"UnitSimplify", "[", 
    RowBox[{"planckTime", "*", 
     RowBox[{"goldenPhi", "^", "n"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleResolution", "[", 
    RowBox[{"n_Integer", "?", "NonNegative"}], "]"}], ":=", 
   RowBox[{"UnitSimplify", "[", 
    RowBox[{"planckLength", "*", 
     RowBox[{"goldenPhi", "^", 
      RowBox[{"-", "n"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleComplexity", "[", 
    RowBox[{"n_Integer", "?", "NonNegative"}], "]"}], ":=", 
   RowBox[{"3", " ", "n", " ", 
    RowBox[{"Log", "[", "goldenPhi", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleInfoDensity", "[", 
    RowBox[{
     RowBox[{"n_Integer", "?", "NonNegative"}], ",", 
     RowBox[{"rho0_", ":", " ", "1"}]}], "]"}], ":=", 
   RowBox[{"rho0", "*", 
    RowBox[{"goldenPhi", "^", 
     RowBox[{"-", "n"}]}]}]}], ";"}]}], "Input",ExpressionUUID->"e5b2442f-\
a490-b041-85e4-f4bf75b4d93f"],

Cell["Quick inspection of the smallest scale: ", "CodeText",ExpressionUUID->"7c193845-604b-7143-96cf-7173b6b361f8"],

Cell[BoxData[
