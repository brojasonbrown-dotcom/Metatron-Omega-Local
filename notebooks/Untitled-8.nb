    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"142cdc77-d134-c64e-ae55-8b93c670e0a8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Minimal toroidal closure ansatz", "Section",ExpressionUUID->"3c1f2d11-2fee-4442-9316-e8d9f076fdd7"],

Cell["\<\
To avoid undefined vector calculus objects, we define a concrete scalar test \
field and a concrete closure residual. \
\>", "Text",ExpressionUUID->"0e348ed1-a311-f140-9cc5-5a167e5ed292"],

Cell[CellGroupData[{

Cell["Radial-exponential spherical mode ansatz", "Subsection",ExpressionUUID->"16ed8b47-abce-e24d-9764-8f3a124dfdcc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "testWave", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testWave", "[", 
    RowBox[{"a_", ",", "b_", ",", 
     RowBox[{"ell_Integer", "?", "NonNegative"}], ",", "m_Integer"}], "]"}], ":=",
    "\[IndentingNewLine]", "  ", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", "theta", ",", "phiAngle"}], "}"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "a"}], " ", "r"}], "]"}], " ", 
      RowBox[{"BesselJ", "[", 
       RowBox[{"0", ",", 
        RowBox[{"b", " ", "r"}]}], "]"}], " ", 
      RowBox[{"SphericalHarmonicY", "[", 
       RowBox[{"ell", ",", "m", ",", "theta", ",", "phiAngle"}], "]"}]}]}], 
    "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"668745f3-4d32-4a47-90ed-abe5efd69e92"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Closure residual", "Subsection",ExpressionUUID->"1ddc8f4d-82b1-424c-93b1-21ed0fe011ea"],

Cell[TextData[{
 "Instead of a symbolic ",
 Cell[BoxData[Cell["SurfaceIntegral",
   Background->None,ExpressionUUID->"1085e729-4c25-364f-a12f-cc10a7f86d7c"]], 
  "InlineCode",ExpressionUUID->"30d87013-3b4c-e341-866f-705c00588f38"],
 " placeholder, define a measurable closure functional on a sphere of radius ",
 Cell[BoxData[Cell["radMax",
   Background->None,ExpressionUUID->"e088f572-1d18-aa43-abbd-1d87b698d92e"]], 
  "InlineCode",ExpressionUUID->"ab95c2a8-3421-4f48-b039-54e9d6c5bf65"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], 
         RowBox[{"[", "\[Psi]", "]"}], "\[LongEqual]", 
         SubscriptBox["\[Integral]", 
          SuperscriptBox[
           StyleBox["S", "TI"], "2"]], "|", "\[Psi]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["r", "TI"], 
             StyleBox["a", "TI"], 
             StyleBox["d", "TI"], 
             StyleBox["M", "TI"], 
             StyleBox["a", "TI"], 
             StyleBox["x", "TI"], ",", "\[Theta]", ",", "\[Phi]"}], ")"}], 
         SuperscriptBox["|", "2"], "\[DifferentialD]", "\[CapitalOmega]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "C[\\psi] = \\int_{S^2} |\\psi(radMax,\\theta,\\phi)|^2 \\, d\\Omega", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c8a33edb-e017-0746-9432-9ce1b6342582"],
 "and compare it to a target closure constant. "
}], "Text",ExpressionUUID->"e24c647b-61d2-d74b-bdf1-865dd43d62b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "closureTarget", ",", "toroidalClosureFunctional", ",", 
     "toroidalClosureResidual"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"closureTarget", "=", 
    RowBox[{"goldenPhi", "^", 
     RowBox[{"-", "13"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"toroidalClosureFunctional", "[", 
     RowBox[{"psi_", ",", "radMax_", ",", 
      RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", 
    RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"psi", "[", 
          RowBox[{"radMax", ",", "theta", ",", "phiAngle"}], "]"}], "]"}], "^",
         "2"}], " ", 
       RowBox[{"Sin", "[", "theta", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"theta", ",", "0", ",", "Pi"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"phiAngle", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"WorkingPrecision", "->", "wp"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"AccuracyGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"PrecisionGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
         RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalClosureResidual", "[", 
    RowBox[{"psi_", ",", "radMax_", ",", 
     RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"toroidalClosureFunctional", "[", 
       RowBox[{"psi", ",", "radMax", ",", "wp"}], "]"}], "-", 
      "closureTarget"}], ",", "wp"}], "]"}]}], ";"}]}], "Input",ExpressionUUID\
->"c66111d1-fd87-274c-91f5-dbbb9080566f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solve for a normalized amplitude at the smallest scale", "Subsection",ExpressionUUID->"cf19e5a8-372b-8744-94f4-82418cc28e10"],

Cell[TextData[{
 "For the simplest isotropic mode ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[ScriptL]", "\[LongEqual]", "0", ",", 
         StyleBox["m", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\ell=0,m=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0cd3fe95-2675-a24b-ab45-fd49f2ca9727"],
 ", solve for amplitude ",
 StyleBox["amp", "TI"],
 " such that closure is exact at ",
 Cell[BoxData[Cell["radMax = 1",
   Background->None,ExpressionUUID->"49e964de-1f2a-c747-888a-792e336071d8"]], 
  "InlineCode",ExpressionUUID->"e6118320-b6a4-394c-b833-4b291fc33cfb"],
 " in dimensionless units. "
}], "Text",ExpressionUUID->"bb09a07c-e4b6-5a4c-9d5f-c3a18a36eff8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "basePsi", ",", "normalizedPsi", ",", "smallestScaleRadius", ",", 
     "closureAmplitudeRule"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"smallestScaleRadius", "=", "1"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"basePsi", "=", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", "theta", ",", "phiAngle"}], "}"}], ",", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", "r"}], "]"}], " ", 
       RowBox[{"SphericalHarmonicY", "[", 
        RowBox[{"0", ",", "0", ",", "theta", ",", "phiAngle"}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"closureAmplitudeRule", "=", 
    RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"amp", "^", "2"}], " ", 
        RowBox[{"Integrate", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"basePsi", "[", 
              RowBox[{"smallestScaleRadius", ",", "theta", ",", "phiAngle"}], 
              "]"}], "]"}], "^", "2"}], " ", 
           RowBox[{"Sin", "[", "theta", "]"}]}], ",", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"{", 
           RowBox[{"theta", ",", "0", ",", "Pi"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"phiAngle", ",", "0", ",", 
            RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"Assumptions", "->", 
           RowBox[{"amp", " ", "\.08", " ", "Reals"}]}]}], 
         "\[IndentingNewLine]", "  ", "]"}]}], "==", "closureTarget"}], ",", 
      "\[IndentingNewLine]", "  ", "amp", ",", "\[IndentingNewLine]", "  ", 
      "Reals"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"normalizedPsi", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", "theta", ",", "phiAngle"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"amp", " ", "/.", " ", 
        RowBox[{"First", "[", "closureAmplitudeRule", "]"}]}], ")"}], " ", 
      RowBox[{"basePsi", "[", 
       RowBox[{"r", ",", "theta", ",", "phiAngle"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"757968e0-06fa-0c4b-89a1-27116abb8058"],

