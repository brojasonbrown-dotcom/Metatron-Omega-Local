Cell[CellGroupData[{

Cell["11. Practical eigenmode computation tools", "Section",ExpressionUUID->"e35677b0-65ab-e94b-a1bb-563b7a605a29"],

Cell["\<\
When you want actual stable frequencies rather than only closure scores, use \
built-in PDE eigensolvers. \
\>", "Text",ExpressionUUID->"f8323c7a-5981-2a4a-91f8-1578a8da2495"],

Cell[CellGroupData[{

Cell[TextData[{
 "11.1 1D prototype with ",
 ButtonBox["SchrodingerPDEComponent",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SchrodingerPDEComponent"]
}], "Subsection",ExpressionUUID->"7d4528ba-9ed1-8542-8e44-c64128a52a1b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"schrodingerOperator1D", ",", "vals", ",", "funs"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"schrodingerOperator1D", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"SchrodingerPDEComponent", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"psi", "[", "x", "]"}], ",", 
        RowBox[{"{", "x", "}"}]}], "}"}], ",", "\[IndentingNewLine]", "    ", 
      RowBox[{"<|", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\"\<ReducedPlanckConstant\>\"", "->", 
         RowBox[{"1", "/", "10"}]}], ",", "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<SchrodingerPotential\>\"", "->", 
         RowBox[{"x", "^", "2"}]}], ",", "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Mass\>\"", "->", 
         RowBox[{"1", "/", "2"}]}]}], "\[IndentingNewLine]", "    ", "|>"}]}],
      "\[IndentingNewLine]", "  ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vals", ",", "funs"}], "}"}], "=", 
   RowBox[{"NDEigensystem", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{"schrodingerOperator1D", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"psi", "[", "x", "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", "10", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<PDEDiscretization\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<FiniteElement\>\"", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<MeshOptions\>\"", "->", 
            RowBox[{"{", 
             RowBox[{"MaxCellMeasure", "->", "0.05"}], "}"}]}], "}"}]}], 
         "}"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",\
ExpressionUUID->"42ce34f9-693a-d041-b3d1-f72a1b8c6e60"],

Cell["\<\
This is useful as a numerical analog for extracting stable frequencies. \
\>", "Text",ExpressionUUID->"616c3022-bfe7-3c4e-b75c-5aa947a0ac57"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "11.2 Closed-form benchmark with ",
 ButtonBox["DSolveValue",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/DSolveValue"]
}], "Subsection",ExpressionUUID->"bd4d71c0-96bd-8e40-be6d-776ff759cb79"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"eqn", ",", "bcs", ",", "boxSol"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqn", "=", 
   RowBox[{
    RowBox[{"I", " ", "hbar", " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"psi", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}]}], "==", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"hbar", "^", "2"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "mass"}], ")"}]}], ")"}], " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"psi", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bcs", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"psi", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"psi", "[", 
        RowBox[{"d", ",", "t"}], "]"}], "==", "0"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"boxSol", "=", 
   RowBox[{"DSolveValue", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eqn", ",", 
         RowBox[{
          RowBox[{"psi", "[", 
           RowBox[{"x", ",", "0"}], "]"}], "==", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"2", "/", "d"}], "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"Pi", " ", 
             RowBox[{"x", "/", "d"}]}], "]"}]}]}]}], "}"}], ",", "bcs"}], 
      "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"psi", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "t"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"385d6e61-04cc-9342-9a8a-e46e74918ad7"],

Cell["This gives exact symbolic structure for stationary states. ", "Text",ExpressionUUID->"2c539af6-576d-be44-9879-4b1a0d32d1de"],

