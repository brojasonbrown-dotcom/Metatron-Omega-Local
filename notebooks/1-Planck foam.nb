Cell[CellGroupData[{

Cell["12. Recommended complete workflow for your project", "Section",ExpressionUUID->"f815137c-bc0f-1148-86a6-f26d6d749326"],

Cell[CellGroupData[{

Cell["Stage A: scale census", "Subsection",ExpressionUUID->"8debb47b-9ad0-2e4b-9cb2-5859090204e4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"stableScales", "=", 
   RowBox[{"firstStableScales", "[", 
    RowBox[{"18", ",", "400", ",", "0.01"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{"scaleAssociation", " ", "/@", " ", "stableScales"}], 
  "]"}]}], "Input",ExpressionUUID->"4b71b1f6-953e-1f4f-afd6-0ef50ac8d5c8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stage B: Planck substrate", "Subsection",ExpressionUUID->"7e6b4157-71b2-db46-80be-2cec766881f9"],

Cell[TextData[{
 "spherical proxy basis up to ",
 Cell[BoxData[Cell["lMax = 3",
   Background->None,ExpressionUUID->"6358f1ab-ac86-574a-b388-1ce7fc10de58"]], 
  "InlineCode",ExpressionUUID->"7a1dbd66-7290-3a43-a8f0-76edfdb8d929"]
}], "Item",ExpressionUUID->"784d8164-580e-ea44-a9e5-47781c1ad436"],

Cell["torus comparison geometry", "Item",ExpressionUUID->"5e2346f8-ebab-bc46-a8f5-92dd12b7e707"],

Cell["threshold-crossing amplification study", "Item",ExpressionUUID->"d2fc543b-6f65-7243-af8d-8285bb817bd0"],

Cell["residual-minimized superposition search", "Item",ExpressionUUID->"6254cead-2cdf-4344-ab00-024be82e01e4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stage C: first toroidal closure", "Subsection",ExpressionUUID->"399c59fb-5e1f-a048-86ee-1ad50bfefc4a"],

Cell[TextData[{
 "first stable ",
 Cell[BoxData[Cell["n > 0",
   Background->None,ExpressionUUID->"f1c7b27c-e981-3f42-a616-d4faa0f0a10f"]], 
  "InlineCode",ExpressionUUID->"bb25b29c-dad7-d344-804c-d3f09646990c"],
 " from closure metric"
}], "Item",ExpressionUUID->"a3fd6b9a-a04b-9f45-bb36-6afb4f520e2d"],

Cell[TextData[{
 "toroidal basis ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{"I", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"m", " ", "u"}], "+", 
      RowBox[{"n", " ", "v"}]}], ")"}]}], "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "68715d2d-63ac-c24c-8768-f09de31422a5"],
 " with small cutoff"
}], "Item",ExpressionUUID->"56a0212a-11d2-a94e-9b05-c23ef97596c2"],

Cell["residual minimization", "Item",ExpressionUUID->"b1db3295-6032-384a-93e4-11ac829bfed6"],

Cell["spectral extraction", "Item",ExpressionUUID->"b838434c-4233-2445-8230-dcb42946f97a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stage D: all stable scales", "Subsection",ExpressionUUID->"f0919455-fa0e-7047-b45a-88f1996de716"],

Cell[TextData[{
 "instantiate ",
 Cell[BoxData[Cell["makeScaleFramework /@ stableScales",
   Background->None,ExpressionUUID->"1696c142-29ff-3642-9107-6d628face12d"]], 
  "InlineCode",ExpressionUUID->"56bced17-f3d4-2542-a12a-16ebf8fd9fb0"]
}], "Item",ExpressionUUID->"2b734f68-1953-c04c-a4a6-29ee9771110e"],

Cell["fit scale-specific transfer maps", "Item",ExpressionUUID->"b22c3dbb-da85-e24a-bebc-67d0c815bac6"],

Cell["evolve chain across scales", "Item",ExpressionUUID->"12b344f4-0cdf-584e-85a1-48c73b04acbc"],

