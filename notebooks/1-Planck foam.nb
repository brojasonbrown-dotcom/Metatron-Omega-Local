Cell[CellGroupData[{

Cell["2. Core constants and scale model", "Section",ExpressionUUID->"a1c86e7a-48ba-534b-b561-c8c8ab6f00f2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "phi", ",", "planckScaleData", ",", "stableScaleQ", ",", 
     "closureResidual", ",", "closureScore", ",", "\[IndentingNewLine]", "  ",
      "windingNumber", ",", "informationDensity", ",", "scaleAssociation"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"phi", "=", "GoldenRatio"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"planckScaleData", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<PlanckLength\>\"", "->", 
       RowBox[{"Quantity", "[", 
        RowBox[{
         RowBox[{"1.616255", "*", 
          RowBox[{"10", "^", 
           RowBox[{"-", "35"}]}]}], ",", "\"\<Meters\>\""}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<PlanckTime\>\"", "->", 
       RowBox[{"Quantity", "[", 
        RowBox[{
         RowBox[{"5.391247", "*", 
          RowBox[{"10", "^", 
           RowBox[{"-", "44"}]}]}], ",", "\"\<Seconds\>\""}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<VacuumAngularFrequency\>\"", "->", 
       RowBox[{"2", " ", "Pi", "*", "9.01", "*", 
        RowBox[{"10", "^", "17"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Lambda0\>\"", "->", 
       RowBox[{"1", "/", 
        RowBox[{"phi", "^", "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Kappa0\>\"", "->", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"phi", " ", "Pi"}], ")"}]}]}]}], "\[IndentingNewLine]", 
     "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"closureResidual", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"phi", "^", "n"}], "/", "13"}], ",", "80"}], "]"}]}], "}"}],
      ",", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"x", "-", 
        RowBox[{"Round", "[", "x", "]"}]}], "]"}], "/", "x"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"closureScore", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"1", "-", 
    RowBox[{"closureResidual", "[", "n", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"windingNumber", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"Round", "[", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"phi", "^", "n"}], "/", "13"}], ",", "80"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"informationDensity", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"phi", "^", 
       RowBox[{"-", "n"}]}], ",", "80"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stableScaleQ", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"tolerance_", ":", " ", "0.01"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"closureResidual", "[", "n", "]"}], "<", "tolerance"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleAssociation", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<ScaleIndex\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<ClosureResidual\>\"", "->", 
      RowBox[{"closureResidual", "[", "n", "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ClosureScore\>\"", "->", 
      RowBox[{"closureScore", "[", "n", "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<WindingNumber\>\"", "->", 
      RowBox[{"windingNumber", "[", "n", "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<InformationDensity\>\"", "->", 
      RowBox[{"informationDensity", "[", "n", "]"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"8909c7a1-2dc1-6a46-99e2-5a522b131588"],

Cell["Generate the first stable scales: ", "CodeText",ExpressionUUID->"1330d5a7-6e87-574f-9758-0a212cbde3f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "firstStableScales", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"firstStableScales", "[", 
     RowBox[{
      RowBox[{"count_Integer", " ", ":", " ", "18"}], ",", 
      RowBox[{"nMax_Integer", " ", ":", " ", "400"}], ",", 
      RowBox[{"tolerance_", ":", " ", "0.01"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "nMax"}], "]"}], ",", 
      RowBox[{
       RowBox[{"stableScaleQ", "[", 
        RowBox[{"#", ",", "tolerance"}], "]"}], " ", "&"}], ",", "count"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableScales", "=", 
   RowBox[{"firstStableScales", "[", 
    RowBox[{"18", ",", "400", ",", "0.01"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scaleTable", "=", 
   RowBox[{"Dataset", "[", 
    RowBox[{"scaleAssociation", " ", "/@", " ", "stableScales"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"e897055d-2d6b-494b-8541-903c4a2094e5"],

