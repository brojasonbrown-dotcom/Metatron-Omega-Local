 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"9750fbde-9391-2e4c-a0ae-fd9d9c8fdda0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Efficient full-scale pipeline", "Section",ExpressionUUID->"987a4351-2113-e047-a16f-7fcbb12d2622"],

Cell["This is the most useful abstraction for your notebook. ", "Text",ExpressionUUID->"88c04734-9ddb-f841-8e59-dd9496ce9482"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "makeScaleFramework", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeScaleFramework", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"basisType_", ":", " ", "\"\<Toroidal\>\""}], ",", 
     RowBox[{"basisCutoff_", ":", " ", "2"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scaleData", ",", "geometry", ",", "basis"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"scaleData", "=", 
       RowBox[{"scaleAssociation", "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"geometry", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", "==", "0"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"sphereGeometry", "[", 
          RowBox[{"QuantityMagnitude", "[", 
           RowBox[{"UnitConvert", "[", 
            RowBox[{
             RowBox[{"planckScaleData", "[", "\"\<PlanckLength\>\"", "]"}], 
             ",", "\"\<Meters\>\""}], "]"}], "]"}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"torusGeometry", " ", "@@", " ", 
          RowBox[{"Values", "[", 
           RowBox[{"torusRadii", "[", "n", "]"}], "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"basis", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "basisType", ",", "\[IndentingNewLine]", "    ", "\"\<Spherical\>\"", 
         ",", 
         RowBox[{"sphericalBasis", "[", "basisCutoff", "]"}], ",", 
         "\[IndentingNewLine]", "    ", "\"\<Toroidal\>\"", ",", 
         RowBox[{"toroidalBasis", "[", 
          RowBox[{"basisCutoff", ",", "basisCutoff"}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", "_", ",", 
         RowBox[{"toroidalBasis", "[", 
          RowBox[{"basisCutoff", ",", "basisCutoff"}], "]"}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<ScaleData\>\"", "->", "scaleData"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Geometry\>\"", "->", "geometry"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Basis\>\"", "->", "basis"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<SuperpositionField\>\"", "->", 
         RowBox[{"Function", "[", 
          RowBox[{"coeffs", ",", 
           RowBox[{"superpositionField", "[", 
            RowBox[{"coeffs", ",", "basis"}], "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<NormalizeCoefficients\>\"", "->", 
         "normalizeCoefficients"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ClosureMetric\>\"", "->", 
         RowBox[{"closureScore", "[", "n", "]"}]}]}], "\[IndentingNewLine]", 
       "  ", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",Expr\
essionUUID->"d4291b1a-c89f-7049-820a-ac20f57d3e82"],

Cell["Build frameworks for all stable scales: ", "CodeText",ExpressionUUID->"ec6f173c-78c0-8547-9420-c1acbb4a3b3b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"scaleFrameworks", "=", 
   RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{"stableScales", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"makeScaleFramework", "[", 
        RowBox[{"#", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#", "==", "0"}], ",", "\"\<Spherical\>\"", 
           ",", "\"\<Toroidal\>\""}], "]"}], ",", "2"}], "]"}], " ", "&"}], 
      " ", "/@", " ", "stableScales"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"3db81a4c-799e-ea49-8e2e-807706786d8f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"6a003aaf-2816-9749-bd66-357a02336586"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Sensory-field algorithm", "Section",ExpressionUUID->"fc752dc5-dbdc-7b4c-95df-e23a1899eff5"],

Cell["\<\
This is the high-level algorithm I recommend for each stable scale. \
\>", "Text",ExpressionUUID->"c5672f36-bd9e-2f4e-9f00-1ad23d37e9a1"],

Cell[CellGroupData[{

Cell["Algorithm", "Subsection",ExpressionUUID->"2da95dc8-a3d7-d44c-a181-ceafa42f481c"],

Cell[TextData[{
 "1. Generate the stable scale list using ",
 Cell[BoxData[Cell["closureResidual",
   Background->None,ExpressionUUID->"17149590-cdd7-2c4d-8934-e1bf10415cd1"]], 
  "InlineCode",ExpressionUUID->"f75abf56-f732-4640-8d8a-a35694b0be70"],
 "."
}], "Text",ExpressionUUID->"e75d9a54-9d5e-2a4e-b3b6-093c3b78b938"],

Cell["2. Assign geometry: ", "Text",ExpressionUUID->"da44573c-2206-bd4e-baea-24dff98f9ea6"],

Cell[TextData[{
 Cell[BoxData[Cell["n = 0",
   Background->None,ExpressionUUID->"81074370-6cde-e04e-ba01-03fc1042073b"]], 
  "InlineCode",ExpressionUUID->"915332e0-98ff-f049-9f5a-906c81a78647"],
 ": sphere proxy and torus comparison"
}], "Subitem",ExpressionUUID->"38c13990-3395-0f42-adb5-0cf4c47828a7"],

Cell[TextData[{
 Cell[BoxData[Cell["n > 0",
   Background->None,ExpressionUUID->"11ace271-6d9f-204a-a9f5-4eca015e0530"]], 
  "InlineCode",ExpressionUUID->"c6c507ab-e70f-f044-a099-bfb1ab6eaff1"],
 ": torus"
}], "Subitem",ExpressionUUID->"00553052-c9d2-5349-a2c0-7a7534da62f8"],

Cell["3. Generate a low-order basis.", "Text",ExpressionUUID->"4af39afc-cfb1-0543-a1b4-fb222cd7f691"],

Cell["4. Build a scale-specific operator or residual.", "Text",ExpressionUUID->"f71e6276-eb35-804a-b559-7fd29c16d7a9"],

Cell["5. Minimize residual over normalized superpositions.", "Text",ExpressionUUID->"23be7bc6-7820-5c48-acce-314fe8a923d5"],

Cell["6. Keep only superpositions below threshold.", "Text",ExpressionUUID->"d6fd3ff7-3575-b742-88da-876237645aba"],

Cell["\<\
7. Propagate coefficients by phase update plus maintenance damping.\
\>", "Text",ExpressionUUID->"568fe2fd-7537-5f48-a2b0-8df418e00c0a"],

Cell["8. Measure overlap into the next scale. ", "Text",ExpressionUUID->"61050c2b-890f-7d4c-a7e9-9acecbc38879"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Implementation skeleton", "Subsection",ExpressionUUID->"bf1b5066-3fbe-0844-9bdb-bf31be16c549"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "sensoryFieldStep", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sensoryFieldStep", "[", 
    RowBox[{"coeffs_List", ",", "eigenvalues_List", ",", "dt_", ",", 
     RowBox[{"gamma_", ":", " ", "0"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"normalizeCoefficients", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "gamma"}], "+", 
         RowBox[{"I", " ", "eigenvalues"}]}], ")"}], " ", "dt"}], "]"}], " ", 
     "coeffs"}], "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",Expres\
sionUUID->"19ed9748-e7aa-fc40-810a-ed39c2590f9e"],

Cell["Cross-scale transfer: ", "CodeText",ExpressionUUID->"71f41753-e672-3d4f-b7fb-522fb90fb2a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "crossScaleTransfer", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"crossScaleTransfer", "[", 
    RowBox[{"sourceCoeffs_List", ",", 
     RowBox[{"transferMatrix_", "?", "MatrixQ"}]}], "]"}], ":=", 
   RowBox[{"normalizeCoefficients", "[", 
    RowBox[{"transferMatrix", ".", "sourceCoeffs"}], "]"}]}], ";"}]}], "Input",\
ExpressionUUID->"29498668-6a0f-254f-a1c0-7fceb3202a20"],

Cell["This gives a clean causal chain: ", "CodeText",ExpressionUUID->"3d8da6c9-c032-f84e-82fe-89c0f61f5a30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"L0toL1toL2", "=", 
   RowBox[{"sensoryFieldStep", " ", "/*", " ", "crossScaleTransfer"}]}], 
  ";"}]], "Input",ExpressionUUID->"4a46e7c9-d835-b046-a81c-02d791c3a9f8"],

