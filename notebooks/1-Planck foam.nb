Cell[CellGroupData[{

Cell["3. Geometry layer: sphere and torus", "Section",ExpressionUUID->"3cedfe32-6f6b-7944-b7b3-11ff9e9d5a36"],

Cell["\<\
For the Planck substrate, start with a spherical proxy and then move to exact \
toroidal closure geometry. \
\>", "Text",ExpressionUUID->"2a062e2e-30e6-f545-beca-8186dbbac4a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"sphereGeometry", ",", "torusGeometry"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sphereGeometry", "[", "r_", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Type\>\"", "->", "\"\<Sphere\>\""}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Radius\>\"", "->", "r"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Area\>\"", "->", 
       RowBox[{"4", " ", "Pi", " ", 
        RowBox[{"r", "^", "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Volume\>\"", "->", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"4", "/", "3"}], ")"}], " ", "Pi", " ", 
        RowBox[{"r", "^", "3"}]}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"torusGeometry", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Type\>\"", "->", "\"\<Torus\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<MajorRadius\>\"", "->", "majorRadius"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<MinorRadius\>\"", "->", "minorRadius"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Area\>\"", "->", 
      RowBox[{"4", " ", 
       RowBox[{"Pi", "^", "2"}], " ", "majorRadius", " ", "minorRadius"}]}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Volume\>\"", "->", 
      RowBox[{"2", " ", 
       RowBox[{"Pi", "^", "2"}], " ", "majorRadius", " ", 
       RowBox[{"minorRadius", "^", "2"}]}]}]}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]}], "Input",ExpressionUUID->"89dac846-a8cf-8c47-a91e-\
6761e89d6766"],

Cell["Planck torus: ", "CodeText",ExpressionUUID->"7dd9731c-cf4e-9240-b0c3-954fbec69199"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "planckTorus", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"planckTorus", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "r0", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"r0", "=", 
       RowBox[{"QuantityMagnitude", "[", 
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          RowBox[{"planckScaleData", "[", "\"\<PlanckLength\>\"", "]"}], 
          ",", "\"\<Meters\>\""}], "]"}], "]"}]}], ";", "\[IndentingNewLine]",
       "  ", 
      RowBox[{"torusGeometry", "[", 
       RowBox[{"r0", ",", 
        RowBox[{"r0", "/", "phi"}]}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"5ce1cc2c-c1e7-2b42-93c1-\
f754a9ec827d"],

