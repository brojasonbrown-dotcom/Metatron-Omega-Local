Cell[CellGroupData[{

Cell["7. Planck-scale monopole prototype", "Section",ExpressionUUID->"6cfba5b5-f48a-bc40-9856-0e05da251add"],

Cell[TextData[{
 "A compact executable prototype for ",
 Cell[BoxData[Cell["n = 0",
   Background->None,ExpressionUUID->"a1784209-119c-484d-9363-81d3fa0f777d"]], 
  "InlineCode",ExpressionUUID->"38428170-e0fd-c44b-8eba-dfc3c3576064"],
 ": "
}], "CodeText",ExpressionUUID->"eb5a79e3-10f0-494e-8a04-81f20af8dc98"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "cLight", ",", "omega0", ",", "lambda0", ",", "tPValue", ",", "ampStep", ",",
      "birthStep"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cLight", "=", 
   RowBox[{"QuantityMagnitude", "[", 
    RowBox[{"UnitConvert", "[", 
     RowBox[{
      RowBox[{
       TemplateBox[{"\"speed of light\"", 
         RowBox[{"Entity", "[", 
           RowBox[{"\"PhysicalConstant\"", ",", "\"SpeedOfLight\""}], "]"}], 
         "\"Entity[\\\"PhysicalConstant\\\", \\\"SpeedOfLight\\\"]\"", 
         "\"physical constant\""},
        "Entity"], "[", "\"\<Value\>\"", "]"}], ",", 
      RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"omega0", "=", 
   RowBox[{"planckScaleData", "[", "\"\<VacuumAngularFrequency\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lambda0", "=", 
   RowBox[{"planckScaleData", "[", "\"\<Lambda0\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tPValue", "=", 
    RowBox[{"QuantityMagnitude", "[", 
     RowBox[{"UnitConvert", "[", 
      RowBox[{
       RowBox[{"planckScaleData", "[", "\"\<PlanckTime\>\"", "]"}], 
       ",", "\"\<Seconds\>\""}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ampStep", "[", 
     RowBox[{"amp_", ",", "k_Integer"}], "]"}], ":=", 
    RowBox[{"amp", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"lambda0", " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"Sin", "[", 
          RowBox[{"omega0", " ", "k", " ", "tPValue"}], "]"}], "]"}]}]}], 
      ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"birthStep", "[", 
    RowBox[{
     RowBox[{"threshold_", ":", " ", "13"}], ",", 
     RowBox[{"amp0_", ":", " ", "1"}], ",", 
     RowBox[{"maxSteps_", ":", " ", 
      RowBox[{"10", "^", "6"}]}]}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{"FirstCase", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"FoldList", "[", 
      RowBox[{"ampStep", ",", "amp0", ",", 
       RowBox[{"Range", "[", "maxSteps", "]"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"x_", " ", "/;", " ", 
      RowBox[{"x", ">=", "threshold"}]}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"Missing", "[", "\"\<NotReached\>\"", "]"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"{", "1", "}"}]}], "\[IndentingNewLine]", "  ", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"bd6ac221-f10b-9948-923c-65c540f9ffed"],

Cell["A version that returns the index explicitly: ", "CodeText",ExpressionUUID->"baa40854-ab1f-b64d-a413-e6d0c95c512a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "firstThresholdCrossing", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"firstThresholdCrossing", "[", 
    RowBox[{
     RowBox[{"threshold_", ":", " ", "13"}], ",", 
     RowBox[{"amp0_", ":", " ", "1"}], ",", 
     RowBox[{"maxSteps_", ":", " ", 
      RowBox[{"10", "^", "6"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "amps", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"amps", "=", 
       RowBox[{"FoldList", "[", 
        RowBox[{"ampStep", ",", "amp0", ",", 
         RowBox[{"Range", "[", "maxSteps", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"FirstCase", "[", 
       RowBox[{
        RowBox[{"MapIndexed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"#2", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", "#1"}], "}"}],
            " ", "&"}], ",", "amps"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"k_", ",", "a_"}], "}"}], " ", "/;", " ", 
          RowBox[{"a", ">=", "threshold"}]}], ":>", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Step\>\"", "->", "k"}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"\"\<Amplitude\>\"", "->", "a"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<TimeSeconds\>\"", "->", 
            RowBox[{"k", " ", "tPValue"}]}]}], "\[IndentingNewLine]", "    ", 
          "|>"}]}], ",", 
        RowBox[{"Missing", "[", "\"\<NotReached\>\"", "]"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"f02ee27c-e9a9-5345-9f0d-5c7748d7d1f7"],

