 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"7ed39f5e-03b1-5843-a283-941721629c9f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Exact toroidal closure at the first stable scale", "Section",ExpressionUUID->"dc2fc31e-af87-d040-89d3-9a471d25e399"],

Cell["\<\
Let the first stable scale be data-driven from your closure metric rather \
than hard-coded. \
\>", "Text",ExpressionUUID->"636b4919-7999-ff4a-9aa5-0396a72388cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "firstStableScale", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"firstStableScale", "[", 
     RowBox[{
      RowBox[{"tolerance_", ":", " ", "0.01"}], ",", 
      RowBox[{"nMax_", ":", " ", "200"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"First", "@", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "nMax"}], "]"}], ",", 
       RowBox[{
        RowBox[{"stableScaleQ", "[", 
         RowBox[{"#", ",", "tolerance"}], "]"}], " ", "&"}]}], "]"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n1", "=", 
   RowBox[{"firstStableScale", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"firstClosureData", "=", 
   RowBox[{"scaleAssociation", "[", "n1", "]"}]}], ";"}]}], "Input",Expression\
UUID->"606966f0-134a-6d40-8a3e-4bd84a2f1db0"],

Cell["Construct torus radii by scale: ", "CodeText",ExpressionUUID->"09b0928e-3be5-0d48-86f9-01dac9f14873"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"scaleLength", ",", "torusRadii"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleLength", "[", "n_Integer", "]"}], ":=", 
    RowBox[{
     RowBox[{"QuantityMagnitude", "[", 
      RowBox[{"UnitConvert", "[", 
       RowBox[{
        RowBox[{"planckScaleData", "[", "\"\<PlanckLength\>\"", "]"}], 
        ",", "\"\<Meters\>\""}], "]"}], "]"}], " ", 
     RowBox[{"phi", "^", "n"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"torusRadii", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<MajorRadius\>\"", "->", 
      RowBox[{"scaleLength", "[", "n", "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<MinorRadius\>\"", "->", 
      RowBox[{
       RowBox[{"scaleLength", "[", "n", "]"}], "/", "phi"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"ef3ede48-7f35-a04e-852f-45e0ec7fd715"],

Cell["Then geometry: ", "CodeText",ExpressionUUID->"d59f4a30-45e1-3f43-863d-17fb31c0bfab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"firstClosureTorus", "=", 
   RowBox[{"torusGeometry", " ", "@@", " ", 
    RowBox[{"Values", "[", 
     RowBox[{"torusRadii", "[", "n1", "]"}], "]"}]}]}], ";"}]], "Input",Expres\
sionUUID->"4d444db3-ef8c-a943-963c-92a5aebbbfc8"],

