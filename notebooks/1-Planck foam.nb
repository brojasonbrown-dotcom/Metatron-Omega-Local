Cell[CellGroupData[{

Cell["14. Most useful next build step", "Section",ExpressionUUID->"fdd298f6-4647-ae4e-bab4-165accbb2e8d"],

Cell[TextData[{
 "The strongest next notebook step is to build a ",
 StyleBox["single executable function",
  FontWeight->Bold],
 " that: "
}], "Text",ExpressionUUID->"ec8b822c-3dd6-004e-95fb-db3d7e9d7c34"],

Cell["finds stable scales", "Item",ExpressionUUID->"432af558-ffd0-8c44-8c98-5a9891787747"],

Cell["creates basis and geometry for a chosen scale", "Item",ExpressionUUID->"79ab0f17-8882-2341-a211-90229f853d68"],

Cell["optimizes superposition coefficients", "Item",ExpressionUUID->"0bad31ab-122b-a24a-8899-f390cdebdfd5"],

Cell["returns diagnostics and plots", "Item",ExpressionUUID->"95b2dc02-e7ce-4641-afd5-8a7397616d81"],

Cell["Here is that wrapper. ", "Text",ExpressionUUID->"e347b426-70aa-a840-8a5d-7e6d04534952"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "computeScaleModel", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "computeScaleModel", "]"}], "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<BasisType\>\"", "->", "Automatic"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<BasisCutoff\>\"", "->", "2"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<Tolerance\>\"", "->", "0.01"}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"computeScaleModel", "[", 
    RowBox[{"n_Integer", ",", "objective_", ",", 
     RowBox[{"opts", " ", ":", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"basisType", ",", "basisCutoff", ",", "framework", ",", "fit"}],
       "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"basisType", "=", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<BasisType\>\"", "]"}], ",", 
         RowBox[{"Automatic", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"n", "==", "0"}], ",", "\"\<Spherical\>\"", 
            ",", "\"\<Toroidal\>\""}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"basisCutoff", "=", 
       RowBox[{"OptionValue", "[", "\"\<BasisCutoff\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"framework", "=", 
       RowBox[{"makeScaleFramework", "[", 
        RowBox[{"n", ",", "basisType", ",", "basisCutoff"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"fit", "=", 
       RowBox[{"findMostStableSuperposition", "[", 
        RowBox[{
         RowBox[{"framework", "[", "\"\<Basis\>\"", "]"}], ",", "objective"}],
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Scale\>\"", "->", "n"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Framework\>\"", "->", "framework"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Optimization\>\"", "->", "fit"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ClosureScore\>\"", "->", 
         RowBox[{"framework", "[", "\"\<ClosureMetric\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"ec4789ed-4c3a-b941-aeb5-\
65276dd02bfc"],

