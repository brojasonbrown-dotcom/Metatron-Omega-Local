Cell[CellGroupData[{

Cell["6. Spectral stability framework", "Section",ExpressionUUID->"e8992f14-1cb1-7444-b8d1-d4c2b2edf606"],

Cell["\<\
This is the key part: stable modes should be ranked by a residual functional \
and, where possible, by eigenvalue structure. \
\>", "Text",ExpressionUUID->"bb3b7e6f-1f51-7341-8854-85056c2415ea"],

Cell[CellGroupData[{

Cell["6.1 Residual functional", "Subsection",ExpressionUUID->"39d5b269-11fb-e74b-9297-5ba600a0bd65"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "residualFunctional", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "residualFunctional", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"WorkingPrecision", "->", "80"}], ",", 
      RowBox[{"AccuracyGoal", "->", "30"}], ",", 
      RowBox[{"PrecisionGoal", "->", "30"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"residualFunctional", "[", 
    RowBox[{"pde_", ",", "psi_", ",", "vars_List", ",", "domainSpec_List", ",", 
     RowBox[{"opts", " ", ":", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"pde", " ", "/.", " ", 
        RowBox[{"Equal", "->", "Subtract"}]}], "]"}], "^", "2"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"Evaluate", " ", "@@", " ", "domainSpec"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"WorkingPrecision", "->", 
      RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"AccuracyGoal", "->", 
      RowBox[{"OptionValue", "[", "AccuracyGoal", "]"}]}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"PrecisionGoal", "->", 
      RowBox[{"OptionValue", "[", "PrecisionGoal", "]"}]}]}], 
    "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"7546c3e5-8148-8a44-863b-974dda1095dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2 Harmonic bases on sphere and torus", "Subsection",ExpressionUUID->"087c3aa1-72c6-f140-ba62-56d1e9f84ddd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"sphericalBasis", ",", "toroidalBasis"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sphericalBasis", "[", "lMax_Integer", "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"SphericalHarmonicY", "[", 
        RowBox[{"l", ",", "m", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "0", ",", "lMax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", 
         RowBox[{"-", "l"}], ",", "l"}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toroidalBasis", "[", 
    RowBox[{"mMax_Integer", ",", "nMax_Integer"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"m", " ", "u"}], "+", 
          RowBox[{"n", " ", "v"}]}], ")"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"-", "mMax"}], ",", "mMax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", 
        RowBox[{"-", "nMax"}], ",", "nMax"}], "}"}]}], "]"}]}]}], 
  ";"}]}], "Input",ExpressionUUID->"fdd142d2-cde0-d541-86c9-c298efcb9cdb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.3 Superposition ansatz", "Subsection",ExpressionUUID->"7deaf7f7-15de-884c-a9cb-2734ea72247d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "superpositionField", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"superpositionField", "[", 
     RowBox[{"coeffs_List", ",", "basis_List"}], "]"}], " ", "/;", " ", 
    RowBox[{
     RowBox[{"Length", "[", "coeffs", "]"}], "==", 
     RowBox[{"Length", "[", "basis", "]"}]}]}], ":=", 
   RowBox[{"coeffs", ".", "basis"}]}], ";"}]}], "Input",ExpressionUUID->\
"d46f6416-6d67-f646-bcf6-bec38fe50b82"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.4 Normalize coefficient vectors", "Subsection",ExpressionUUID->"f1a83608-7d86-f540-b7c1-68d1777d4644"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "normalizeCoefficients", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normalizeCoefficients", "[", "coeffs_List", "]"}], ":=", 
   RowBox[{"coeffs", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"Abs", "[", "coeffs", "]"}], "^", "2"}], "]"}], "]"}]}]}], 
  ";"}]}], "Input",ExpressionUUID->"17c1b698-68f1-ce49-83ec-3ba90cd5a6b3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
6.5 Efficient real-parameter encoding for complex coefficients\
\>", "Subsection",ExpressionUUID->"ff20085c-da50-fb47-9a98-bf48480c551b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "complexVectorFromReal", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"complexVectorFromReal", "[", "pars_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"half", "=", 
       RowBox[{
        RowBox[{"Length", "[", "pars", "]"}], "/", "2"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Take", "[", 
       RowBox[{"pars", ",", "half"}], "]"}], "+", 
      RowBox[{"I", " ", 
       RowBox[{"Take", "[", 
        RowBox[{"pars", ",", 
         RowBox[{"-", "half"}]}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}],
   ";"}]}], "Input",ExpressionUUID->"f1c4279f-5580-734d-9c8d-cdb5c0e63d63"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.6 Most-stable superposition search", "Subsection",ExpressionUUID->"642c36d6-fe86-fe43-b2d4-ecbce5a772bb"],

Cell["\<\
This version minimizes a user-supplied residual objective under coefficient \
normalization. \
\>", "Text",ExpressionUUID->"1eca8075-2d5b-b148-bd1d-410fab531f86"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "findMostStableSuperposition", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "findMostStableSuperposition", "]"}], "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Method", "->", "\"\<NelderMead\>\""}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"WorkingPrecision", "->", "50"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"MaxIterations", "->", "200"}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"findMostStableSuperposition", "[", 
    RowBox[{"basis_List", ",", "objective_", ",", 
     RowBox[{"opts", " ", ":", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "basis", "]"}]}], ",", "vars", ",", "coeffs", ",",
        "normedCoeffs", ",", "result"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"vars", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"a", ",", 
         RowBox[{"2", " ", 
          RowBox[{"Length", "[", "basis", "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"coeffs", "=", 
       RowBox[{"complexVectorFromReal", "[", "vars", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"normedCoeffs", "=", 
       RowBox[{"normalizeCoefficients", "[", "coeffs", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"result", "=", 
       RowBox[{"NMinimize", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"objective", "[", 
            RowBox[{"normedCoeffs", ",", "basis"}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", "True"}], "\[IndentingNewLine]", 
          "    ", "}"}], ",", "\[IndentingNewLine]", "    ", "vars", ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"Method", "->", 
          RowBox[{"OptionValue", "[", "Method", "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"WorkingPrecision", "->", 
          RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"MaxIterations", "->", 
          RowBox[{"OptionValue", "[", "MaxIterations", "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Minimum\>\"", "->", 
         RowBox[{"First", "[", "result", "]"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Parameters\>\"", "->", 
         RowBox[{"Last", "[", "result", "]"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Coefficients\>\"", "->", 
         RowBox[{"normalizeCoefficients", "[", 
          RowBox[{"coeffs", " ", "/.", " ", 
           RowBox[{"Last", "[", "result", "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Basis\>\"", "->", "basis"}]}], "\[IndentingNewLine]", 
       "  ", "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",Expr\
essionUUID->"13670b95-8dbf-4d45-825c-55c62c49a505"],

