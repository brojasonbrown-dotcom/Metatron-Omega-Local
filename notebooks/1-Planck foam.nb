Cell[CellGroupData[{

Cell["1. Design goals", "Section",ExpressionUUID->"b442d29a-402e-fb46-8e63-4c7f90fe6af5"],

Cell["We want a framework that is:", "Text",ExpressionUUID->"720a93cb-f17f-d542-8166-a1a93a6bdd2a"],

Cell[TextData[{
 "1. ",
 StyleBox["Symbolically derived first",
  FontWeight->Bold],
 "2. ",
 StyleBox["Residual-validated",
  FontWeight->Bold],
 "3. ",
 StyleBox["Composable across scales",
  FontWeight->Bold],
 "4. ",
 StyleBox["Efficient in memory and kernel time",
  FontWeight->Bold],
 "5. ",
 StyleBox["Able to rank stable superpositions",
  FontWeight->Bold],
 "6. ",
 StyleBox["Ready to generalize from sphere to torus",
  FontWeight->Bold],
 "The implementation below follows your OPF structure while staying \
executable in built-in Wolfram Language. "
}], "Text",ExpressionUUID->"b00b60d7-3abd-a540-a477-43a19cde7c2f"],

