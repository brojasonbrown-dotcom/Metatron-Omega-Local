Cell[CellGroupData[{

Cell["4. OPF Layer 1 action and Euler-Lagrange equations", "Section",ExpressionUUID->"ce9c658e-0a45-4944-bef1-bd194486ad7b"],

Cell[TextData[{
 "From your OPF statement, use the action density ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], ")"}], "\[LongEqual]", "\[Rho]", "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L}(\\rho, \\chi, R) = \\rho \\log(\\chi) + \\chi R^2.", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8dc5f262-0b02-1d4b-b561-f21fea6b858f"],
 "A direct variational treatment requires specifying field dependence on \
coordinates. Below is a practical symbolic model where "
}], "Text",ExpressionUUID->"eb19d780-b3e8-e942-ab89-7bf1c62c40f4"],

Cell[TextData[Cell[BoxData[Cell["rhoField[x]",
  Background->None,ExpressionUUID->
  "3c04014f-551d-f248-9699-6fc4ca52fa92"]], \
"InlineCode",ExpressionUUID->"a43c847e-4add-5442-b9b0-9edd6643933d"]], "Item",\
ExpressionUUID->"c2c5cc57-fb88-264d-aac7-03b0d8594759"],

Cell[TextData[Cell[BoxData[Cell["chiField[x]",
  Background->None,ExpressionUUID->
  "190a23ec-44d8-5244-a935-722b307f5970"]], \
"InlineCode",ExpressionUUID->"d7fe90ab-981d-344d-802b-3766d7781c51"]], "Item",\
ExpressionUUID->"93c26cd2-4e12-fa49-8ba3-2de46466e95d"],

Cell[TextData[Cell[BoxData[Cell["resField[x]",
  Background->None,ExpressionUUID->
  "61d1f90b-c22e-954e-8fb3-37404d9e6eb9"]], \
"InlineCode",ExpressionUUID->"0ca6e21b-613e-9844-b0e7-b278b643dd80"]], "Item",\
ExpressionUUID->"5782a321-ebe5-a74f-9d96-e3704176f19f"],

Cell["are scalar fields over a spatial coordinate chart. ", "Text",ExpressionUUID->"52b8d44c-a650-604c-9e67-c71a7e1f3e15"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "x", ",", "y", ",", "z", ",", "t", ",", "rhoField", ",", "chiField", ",", 
     "resField", ",", "opfLagrangianDensity", ",", "\[IndentingNewLine]", 
     "  ", "opfEulerEquations"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"opfLagrangianDensity", "[", "coords_List", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"rhoField", " ", "@@", " ", "coords"}], "*", 
      RowBox[{"Log", "[", 
       RowBox[{"chiField", " ", "@@", " ", "coords"}], "]"}]}], "+", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"chiField", " ", "@@", " ", "coords"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"resField", " ", "@@", " ", "coords"}], ")"}], "^", 
       "2"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"opfEulerEquations", "[", "coords_List", "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"EulerEquations", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"opfLagrangianDensity", "[", "coords", "]"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rhoField", " ", "@@", " ", "coords"}], ",", 
       RowBox[{"chiField", " ", "@@", " ", "coords"}], ",", 
       RowBox[{"resField", " ", "@@", " ", "coords"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "    ", "coords"}], "\[IndentingNewLine]", "  ", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"458ac700-94ee-104e-8b4e-\
1a2a40a4931b"],

Cell["For a 1D prototype: ", "CodeText",ExpressionUUID->"13f038ba-1015-2c4d-8e02-b045e0eed0b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"opfEuler1D", "=", 
   RowBox[{"opfEulerEquations", "[", 
    RowBox[{"{", "x", "}"}], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"dbb69ec1-4e74-334d-ab58-a21624593a7f"],

Cell["\<\
This gives a symbolic baseline. If you want derivative-penalty terms for \
nontrivial PDE structure, add gradient energy: \
\>", "CodeText",ExpressionUUID->"4ab69003-3f09-d943-9d89-d2f4fb66aa21"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "opfLagrangianDensityExtended", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"opfLagrangianDensityExtended", "[", 
    RowBox[{"coords_List", ",", 
     RowBox[{"alpha_", ":", " ", "1"}], ",", 
     RowBox[{"beta_", ":", " ", "1"}], ",", 
     RowBox[{"gamma_", ":", " ", "1"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rho", "=", 
        RowBox[{"rhoField", " ", "@@", " ", "coords"}]}], ",", 
       RowBox[{"chi", "=", 
        RowBox[{"chiField", " ", "@@", " ", "coords"}]}], ",", 
       RowBox[{"res", "=", 
        RowBox[{"resField", " ", "@@", " ", "coords"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"rho", " ", 
       RowBox[{"Log", "[", "chi", "]"}]}], "+", 
      RowBox[{"chi", " ", 
       RowBox[{"res", "^", "2"}]}], "+", "\[IndentingNewLine]", "  ", 
      RowBox[{"alpha", " ", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Grad", "[", 
          RowBox[{"rho", ",", "coords"}], "]"}], "^", "2"}], "]"}]}], "+", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"beta", " ", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Grad", "[", 
          RowBox[{"chi", ",", "coords"}], "]"}], "^", "2"}], "]"}]}], "+", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"gamma", " ", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Grad", "[", 
          RowBox[{"res", ",", "coords"}], "]"}], "^", "2"}], "]"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"15bfea43-e1ea-4c4d-9ebd-c1f6cdd6d93a"],

Cell["Then derive: ", "CodeText",ExpressionUUID->"d418a0c2-c38c-d741-916f-6eff77182581"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "opfEulerEquationsExtended", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"opfEulerEquationsExtended", "[", 
    RowBox[{"coords_List", ",", 
     RowBox[{"alpha_", ":", " ", "1"}], ",", 
     RowBox[{"beta_", ":", " ", "1"}], ",", 
     RowBox[{"gamma_", ":", " ", "1"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"EulerEquations", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"opfLagrangianDensityExtended", "[", 
      RowBox[{"coords", ",", "alpha", ",", "beta", ",", "gamma"}], "]"}], ",",
      "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rhoField", " ", "@@", " ", "coords"}], ",", 
       RowBox[{"chiField", " ", "@@", " ", "coords"}], ",", 
       RowBox[{"resField", " ", "@@", " ", "coords"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "    ", "coords"}], "\[IndentingNewLine]", "  ", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"7700550a-d486-a346-ba19-\
74e55fe26336"],

Cell["\<\
This is the better computational starting point because it creates real field \
equations. \
\>", "Text",ExpressionUUID->"5cdba00b-5066-6840-b6f7-443f0daca330"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"3371386b-e94f-294a-8555-2f108b24911c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Maintenance operator and Layer 2 measured reality", "Section",ExpressionUUID->"2fbef383-66c2-6141-a1e8-e062ba1c069b"],

Cell[TextData[{
 "Your maintenance rule is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["u", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[CapitalGamma]", 
         StyleBox["u", "TI"], "\[LongEqual]", "0."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{\\partial u}{\\partial t} + \\Gamma u = 0.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "65e7683b-3812-924d-bdf3-bf8edf79f166"],
 "Represent this as a reusable evolution wrapper. "
}], "Text",ExpressionUUID->"713116b8-3c7c-9f44-886a-0338c43afc8c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "maintenanceSolution", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maintenanceSolution", "[", 
    RowBox[{"field0_", ",", "gamma_", ",", 
     RowBox[{"timeVar_", ":", " ", "t"}]}], "]"}], ":=", 
   RowBox[{"field0", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "gamma"}], " ", "timeVar"}], "]"}]}]}], ";"}]}], "Input",Ex\
pressionUUID->"cfafd303-415b-ba43-af2e-f1f5434e6d15"],

Cell["\<\
For measured observables, use a basis expansion and integration kernel: \
\>", "CodeText",ExpressionUUID->"4d1f541c-d486-b443-b192-ae5afaf0362e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"measurementKernel", ",", "observableFromBasis"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measurementKernel", "[", 
     RowBox[{"psi_", ",", "basis_List", ",", "vars_List", ",", "region_", ",", 
      RowBox[{"opts", " ", ":", " ", 
       RowBox[{"OptionsPattern", "[", "NIntegrate", "]"}]}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{"basis", ",", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"Conjugate", "[", "#", "]"}], " ", "psi"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"Evaluate", " ", "@@", " ", "region"}], ",", 
          "\[IndentingNewLine]", "      ", "opts"}], "\[IndentingNewLine]", 
         "    ", "]"}], " ", "&"}], " ", "/@", " ", "basis"}]}], 
     "\[IndentingNewLine]", "  ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"observableFromBasis", "[", 
    RowBox[{"psi_", ",", "basis_List", ",", "coeffs_Association"}], "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#2", " ", "#1"}], " ", "&"}], ",", "coeffs"}], "]"}], "]"}]}],
   ";"}]}], "Input",ExpressionUUID->"c475f178-2331-3244-8eeb-295e8174e566"],

Cell[TextData[{
 "For exact symbolic basis integrals in simple domains, replace ",
 ButtonBox["NIntegrate",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NIntegrate"],
 " with ",
 ButtonBox["Integrate",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Integrate"],
 ". "
}], "Text",ExpressionUUID->"ac7d7a11-114f-f541-b53b-dca3baba2c5e"],

