Cell[CellGroupData[{

Cell["Candidate D. Coupled reaction-diffusion systems", "Subsection",ExpressionUUID->"3643bbe8-c372-d146-860e-407d23b7ca08"],

Cell[TextData[{
 "For example: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["u", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["d", "TI"], 
              StyleBox["u", "TI"]], "\[Del]", 
             StyleBox["u", "TI"]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["u", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["u", "TI"], ",", 
             StyleBox["v", "TI"], ",", "\[Ellipsis]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial u}{\\partial t} = \\nabla\\cdot(d_u\\nabla u) + \
f_u(u,v,\\dots)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f83c13f3-017a-5a48-b8d2-f398c8370c62"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["v", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "\[LongEqual]", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["d", "TI"], 
              StyleBox["v", "TI"]], "\[Del]", 
             StyleBox["v", "TI"]}], ")"}], "+", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["v", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["u", "TI"], ",", 
             StyleBox["v", "TI"], ",", "\[Ellipsis]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial v}{\\partial t} = \\nabla\\cdot(d_v\\nabla v) + \
f_v(u,v,\\dots)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29fa5941-80aa-1d49-b4ef-851e29e3e4e2"]
