Cell[CellGroupData[{

Cell["Candidate E. Drift-diffusion plus electrostatic coupling", "Subsection",ExpressionUUID->"4d6b108f-4cc2-114d-a275-ac9629797823"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["c", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial c_i}{\\partial t} + \\nabla\\cdot\\mathbf{J}_i = R_i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "84d9f13a-39eb-734e-ac0b-d519e32a3b6d"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["i", "TI"]], "\[Del]", 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["i", "TI"]], "-", 
         SubscriptBox["\[Mu]", 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["z", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["i", "TI"]], "\[Del]", "\[Phi]", "+", 
         StyleBox["v", FontSlant -> "Bold"], 
         SubscriptBox[
          StyleBox["c", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{J}_i = -D_i\\nabla c_i - \\mu_i z_i c_i\\nabla \\phi + \
\\mathbf{v}c_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28965221-980e-5549-b3ad-00aea8bc9967"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"\[Epsilon]", "\[Del]", "\[Phi]"}], ")"}], "\[LongEqual]", 
         "\[Rho]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "-\\nabla\\cdot(\\varepsilon\\nabla\\phi)=\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7543824b-0cae-f04a-9d72-6038daf2019c"]
}], "Text",ExpressionUUID->"4b2c8bbb-0edd-6447-afc9-ec616b71fe9d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Logic", "Subsection",ExpressionUUID->"cdc25de5-a86c-284e-9586-0073f1e0e331"],

Cell["\<\
This is one of the strongest extensions if RHUFT is meant to cover charged \
transport or field-mediated migration. \
\>", "Text",ExpressionUUID->"a97f3df6-6749-3c42-859f-2dde28cf1b7b"]
}, Open  ]],

