Cell[CellGroupData[{

Cell["I. Strongest RHUFT Candidate Classes", "Section",ExpressionUUID->"48233f40-73fc-1045-8ad0-1759cea3fb92"],

Cell[CellGroupData[{

Cell["Candidate A. Abstract conservation-law framework", "Subsection",ExpressionUUID->"c62d76bc-7096-e848-982a-be64aeb93b99"],

Cell[TextData[{
 "The most general candidate is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["q", FontSlant -> "Bold"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         StyleBox["F", FontSlant -> "Bold"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["q", FontSlant -> "Bold"], ",", "\[Del]", 
             StyleBox["q", FontSlant -> "Bold"], ",", 
             StyleBox["x", FontSlant -> "Bold"], ",", 
             StyleBox["t", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["S", FontSlant -> "Bold"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["q", FontSlant -> "Bold"], ",", "\[Del]", 
             StyleBox["q", FontSlant -> "Bold"], ",", 
             StyleBox["x", FontSlant -> "Bold"], ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\frac{\\partial \\mathbf{q}}{\\partial t} + \\nabla \\cdot \
\\mathbf{F}(\\mathbf{q},\\nabla \\mathbf{q},\\mathbf{x},t) = \
\\mathbf{S}(\\mathbf{q},\\nabla \\mathbf{q},\\mathbf{x},t)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e56aad2-88e0-284e-a4e6-ead80f82e029"],
 "where: "
}], "Text",ExpressionUUID->"1e758f84-b42f-244b-af96-373a284cbe2c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["q", FontSlant -> "Bold"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathbf{q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a81eb166-7f7e-7546-b29b-27333e56692e"],
 " is the state vector"
}], "Item",ExpressionUUID->"b5bd7fa6-7471-364a-8cf5-b7f8e2c16022"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["F", FontSlant -> "Bold"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathbf{F}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd14467a-83af-b740-854f-025067ab4cd4"],
 " is the total flux"
}], "Item",ExpressionUUID->"15aeaed8-f35f-a644-9fb5-4d2d4db1587f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["S", FontSlant -> "Bold"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathbf{S}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2ba1d72e-4a97-0f4d-9dd6-95218e8a4e9c"],
 " is the source or reaction structure"
}], "Item",ExpressionUUID->"04f3997a-a46b-f84c-b330-bbbfc779d2b4"]
}, Open  ]],

