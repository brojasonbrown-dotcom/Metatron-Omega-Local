Cell[CellGroupData[{

Cell["VII. Review Conclusions", "Section",ExpressionUUID->"382365d6-b3d0-794d-916a-6fe830c03b42"],

Cell[CellGroupData[{

Cell["Most complete RHUFT framework", "Subsection",ExpressionUUID->"444758ca-72d6-e64e-a8ff-42fffe66ddba"],

Cell[TextData[{
 "The cleanest and strongest complete candidate is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["q", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial q_i}{\\partial t} + \\nabla\\cdot\\mathbf{J}_i = R_i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98416079-182b-df4c-bcd0-3eff2792368b"],
 "with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", 
         UnderscriptBox["\[Sum]", 
          StyleBox["j", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["D", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[Del]", 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["j", "TI"]], "+", 
         SubscriptBox[
          StyleBox["v", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "-", 
         SubscriptBox["\[Chi]", 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[Del]", "\[Phi]", "+", 
         SubsuperscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"], 
          StyleBox["cross", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathbf{J}_i = -\\sum_j D_{ij}\\nabla q_j + \\mathbf{v}_i q_i - \
\\chi_i q_i\\nabla\\phi + \\mathbf{J}^{\\mathrm{cross}}_i", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9dda799d-6377-cc43-ac67-d34d2ba6c25c"],
 "plus auxiliary coupled equations ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], "\[Alpha]"], 
         RowBox[{"(", 
           RowBox[{"\[Psi]", ",", 
             StyleBox["q", FontSlant -> "Bold"]}], ")"}], "\[LongEqual]", 
         "0."}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{L}_\\alpha(\\boldsymbol{\\psi},\\mathbf{q})=0.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2a23fa56-1a16-de49-9575-426437eb4e6b"],
 "  "
}], "Text",ExpressionUUID->"baf7477f-2bdc-3245-ab2b-efbab93717fe"]
}, Open  ]],

