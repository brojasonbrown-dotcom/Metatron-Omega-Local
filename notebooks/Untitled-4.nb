Cell["drift", "Item",ExpressionUUID->"f348b790-1a2c-e648-a079-9e9d8e7e999e"],

Cell["reaction networks", "Item",ExpressionUUID->"53af7387-03fe-6043-bde2-457988e3965f"],

Cell["nonlocal closures", "Item",ExpressionUUID->"d8ad4f06-f452-ea49-b200-4cbca92562a3"],

Cell["coupled auxiliary fields", "Item",ExpressionUUID->"71cfe0e1-aaec-7c47-8cd9-233974ff906d"]
}, Open  ]],

