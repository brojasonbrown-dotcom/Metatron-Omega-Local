Cell[CellGroupData[{

Cell["II. Best Unified RHUFT Recommendation", "Section",ExpressionUUID->"cfca28d4-c2b3-5d4c-b86b-ec1691d6fdf7"],

Cell["The strongest complete RHUFT framework candidate is: ", "Text",ExpressionUUID->"272502f9-2b18-3243-bb98-bd51dc93241a"],

Cell[BoxData[GridBox[{
   {
    PaneBox[Cell[TextData[{
      "Let ",
      Cell[BoxData[
       FormBox[
        TemplateBox[<|"boxes" -> FormBox[
            RowBox[{
              StyleBox["q", FontSlant -> "Bold"], "\[LongEqual]", 
              RowBox[{"(", 
                RowBox[{
                  SubscriptBox[
                   StyleBox["q", "TI"], "1"], ",", "\[Ellipsis]", ",", 
                  SubscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["m", "TI"]]}], ")"}]}], TraditionalForm], 
          "errors" -> {}, "input" -> "\\mathbf{q}=(q_1,\\dots,q_m)", "state" -> 
          "Boxes"|>,
         "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
       "30140903-e30b-7243-8f29-7eb23e36580b"],
      " denote the primary fields and ",
      Cell[BoxData[
       FormBox[
        TemplateBox[<|"boxes" -> FormBox[
            RowBox[{"\[Psi]", "\[LongEqual]", 
              RowBox[{"(", 
                RowBox[{
                  SubscriptBox["\[Psi]", "1"], ",", "\[Ellipsis]", ",", 
                  SubscriptBox["\[Psi]", 
                   StyleBox["p", "TI"]]}], ")"}]}], TraditionalForm], 
          "errors" -> {}, "input" -> 
          "\\boldsymbol{\\psi}=(\\psi_1,\\dots,\\psi_p)", "state" -> "Boxes"|>,
         "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
       "cfb33698-55b3-b54e-a93d-40504c6fab15"],
      " denote auxiliary coupled fields. Then on ",
      Cell[BoxData[
       FormBox[
        TemplateBox[<|"boxes" -> FormBox[
            RowBox[{"\[CapitalOmega]", "\[Subset]", 
              SuperscriptBox[
               StyleBox["R", FontSlant -> "Plain"], 
               StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, 
          "input" -> "\\Omega\\subset\\mathbb{R}^n", "state" -> "Boxes"|>,
         "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
       "12ca090b-15e2-3341-9016-9c1b905aaad8"],
      ",\n\n",
      Cell[BoxData[
       FormBox[
        TemplateBox[<|"boxes" -> FormBox[
            RowBox[{
              FractionBox[
               RowBox[{"\[PartialD]", 
                 SubscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["i", "TI"]]}], 
               RowBox[{"\[PartialD]", 
                 StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
              RowBox[{"(", 
                RowBox[{"-", 
                  UnderoverscriptBox["\[Sum]", 
                   RowBox[{
                    StyleBox["j", "TI"], "\[LongEqual]", "1"}], 
                   StyleBox["m", "TI"], LimitsPositioning -> True], 
                  SubscriptBox[
                   StyleBox["D", "TI"], 
                   RowBox[{
                    StyleBox["i", "TI"], 
                    StyleBox["j", "TI"]}]], "\[Del]", 
                  SubscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["j", "TI"]], "+", 
                  SubscriptBox[
                   StyleBox["v", FontSlant -> "Bold"], 
                   StyleBox["i", "TI"]], 
                  SubscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["i", "TI"]], "-", 
                  SubscriptBox["\[Chi]", 
                   StyleBox["i", "TI"]], 
                  SubscriptBox[
                   StyleBox["q", "TI"], 
                   StyleBox["i", "TI"]], "\[Del]", "\[Phi]", "+", 
                  SubsuperscriptBox[
                   StyleBox["J", FontSlant -> "Bold"], 
                   StyleBox["i", "TI"], 
                   StyleBox["cross", FontSlant -> "Plain"]]}], ")"}], 
              "\[LongEqual]", 
              SubscriptBox[
               StyleBox["R", "TI"], 
               StyleBox["i", "TI"]], 
              RowBox[{"(", 
                RowBox[{
                  StyleBox["q", FontSlant -> "Bold"], ",", "\[Psi]", ",", 
                  StyleBox["x", FontSlant -> "Bold"], ",", 
                  StyleBox["t", "TI"]}], ")"}], ",    ", 
              StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", 
              ",", 
              StyleBox["m", "TI"], ","}], TraditionalForm], "errors" -> {}, 
          "input" -> 
          "\\frac{\\partial q_i}{\\partial t} + \
\\nabla\\cdot\\left(-\\sum_{j=1}^{m} D_{ij}\\nabla q_j + \\mathbf{v}_i q_i - \
\\chi_i q_i\\nabla\\phi + \\mathbf{J}_i^{\\mathrm{cross}}\\right) = \
R_i(\\mathbf{q},\\boldsymbol{\\psi},\\mathbf{x},t), \\qquad i=1,\\dots,m,", 
          "state" -> "Boxes"|>,
         "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
       "822315bf-6d50-4544-8395-1583888c11b9"],
      "\n\ntogether with auxiliary equations\n\n",
      Cell[BoxData[
       FormBox[
        TemplateBox[<|"boxes" -> FormBox[
            RowBox[{
              SubscriptBox[
               StyleBox["L", "TI"], "\[Alpha]"], 
              RowBox[{"(", 
                RowBox[{"\[Psi]", ",", 
                  StyleBox["q", FontSlant -> "Bold"], ",", 
                  StyleBox["x", FontSlant -> "Bold"], ",", 
                  StyleBox["t", "TI"]}], ")"}], "\[LongEqual]", "0", ",    ", 
              "\[Alpha]", "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
              StyleBox["p", "TI"], "."}], TraditionalForm], "errors" -> {}, 
          "input" -> 
          "\\mathcal{L}_\\alpha(\\boldsymbol{\\psi},\\mathbf{q},\\mathbf{x},t)\
=0, \\qquad \\alpha=1,\\dots,p.", "state" -> "Boxes"|>,
         "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
       "3ce111b6-35b4-b542-a8ee-7d5766462000"]
     }],
      Background->None,ExpressionUUID->"50fd11a7-f4dd-2d49-a01f-760cd440da3d"],
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"9f636914-729b-b44c-9b4b-41ff7034418d"],

Cell[CellGroupData[{

Cell["Why this is strongest", "Subsection",ExpressionUUID->"b39b8d41-6a9d-1e40-acc4-72bca6be601a"],

Cell["preserves conservation structure", "Item",ExpressionUUID->"69e8c094-210b-7644-8606-8b13c3904f8b"],

Cell["accommodates multiple transport mechanisms", "Item",ExpressionUUID->"3cd3023f-0b2b-5e45-acd5-86e2deced062"],

Cell["allows field coupling", "Item",ExpressionUUID->"f24e217e-5497-284e-b0ce-69d6e42191aa"],

Cell["subsumes reaction-diffusion and mass-transport models", "Item",ExpressionUUID->"36451be1-26b9-bf46-8296-63c9d6e75d64"],

Cell["supports clean boundary classification", "Item",ExpressionUUID->"ac66d0cb-d783-6b4d-976b-e1c77569e38e"],

Cell[TextData[{
 "maps well to ",
 ButtonBox["NDSolveValue",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NDSolveValue"],
 " and PDE component workflows"
}], "Item",ExpressionUUID->"f9cf3d1d-d5bf-5844-817b-760f686e5a9d"],

