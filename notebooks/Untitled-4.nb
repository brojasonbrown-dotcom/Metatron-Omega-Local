 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"a693ca70-92c0-c241-b790-2f2a49b5fde1"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["IV. Conservative vs Nonconservative Logic", "Section",ExpressionUUID->"50c4ca80-f14b-0d4c-b2ec-e4450d37972a"],

Cell["\<\
This distinction is critical and should remain explicit in the RHUFT review.\
\>", "Text",ExpressionUUID->"25beeae0-005c-594a-b5f6-773ac4379e83"],

Cell["For mass transport, the documentation states: ", "Text",ExpressionUUID->"34837adc-bd7d-df4b-9470-7d5b1e9638fb"],

Cell[TextData[{
 "in the ",
 StyleBox["conservative formulation",
  FontWeight->Bold],
 ", ",
 ButtonBox["NeumannValue",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NeumannValue"],
 " specifies the boundary value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", FontSlant -> "Bold"], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["d", "TI"], "\[Del]", 
             StyleBox["c", "TI"], "-", 
             StyleBox["v", FontSlant -> "Bold"], 
             StyleBox["c", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\mathbf{n}\\cdot(d\\nabla c - \\mathbf{v}c)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5fa6a4d2-8511-2d42-8834-cf222d2640f8"]
}], "Item",ExpressionUUID->"3f9e9a05-9ad9-4a48-a164-ad2ad330df8a"],

Cell[TextData[{
 "in the ",
 StyleBox["nonconservative formulation",
  FontWeight->Bold],
 ", ",
 ButtonBox["NeumannValue",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NeumannValue"],
 " specifies the boundary value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", FontSlant -> "Bold"], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["d", "TI"], "\[Del]", 
             StyleBox["c", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\mathbf{n}\\cdot(d\\nabla c)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d2ea771-0576-5f4c-b557-7da3edf48eb9"]
}], "Item",ExpressionUUID->"b0f56c6e-d7a9-9c4c-94aa-11ce1b4cd698"],

Cell["\<\
This is one of the most important review points for keeping the notebook \
logically correct. \
\>", "Text",ExpressionUUID->"774263a5-6fdc-3341-930b-f60030d524a8"],

Cell[CellGroupData[{

Cell["Practical rule", "Subsection",ExpressionUUID->"6fd6b8b9-a780-724d-b9e9-643a2e658553"],

Cell[TextData[{
 "use the ",
 StyleBox["conservative form",
  FontWeight->Bold],
 " when conservation and true total flux accounting are central"
}], "Item",ExpressionUUID->"1727ffdb-4c42-2746-9890-bbb0bbdfc394"],

Cell[TextData[{
 "use the ",
 StyleBox["nonconservative form",
  FontWeight->Bold],
 " only with explicit awareness of how convective boundary contributions are \
handled"
}], "Item",ExpressionUUID->"c87f6d6e-3b72-314f-8332-ccc65d5459dc"],

