Cell[CellGroupData[{

Cell["Candidate C. Mass transport PDE framework", "Subsection",ExpressionUUID->"e07371a7-309a-0944-b897-4e822259e29d"],

Cell[TextData[{
 "For a scalar concentration ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be0b5b6c-264f-8842-ab52-c428db113f9f"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["c", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             StyleBox["d", "TI"], "\[Del]", 
             StyleBox["c", "TI"], "+", 
             StyleBox["v", FontSlant -> "Bold"], 
             StyleBox["c", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["s", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["c", "TI"], ",", 
             StyleBox["x", FontSlant -> "Bold"], ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\frac{\\partial c}{\\partial t} + \\nabla\\cdot\\left(-d\\nabla c + \
\\mathbf{v}c\\right) = s(c,\\mathbf{x},t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "87b9fadf-7333-3b44-a446-cbd56872ab3c"],
 "This is directly aligned with ",
 ButtonBox["MassTransportPDEComponent",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MassTransportPDEComponent"],
 ". "
}], "Text",ExpressionUUID->"d823eddf-218d-c440-b5da-15e393dc251e"]
}, Open  ]],

