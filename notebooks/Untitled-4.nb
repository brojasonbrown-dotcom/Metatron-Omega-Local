Cell[CellGroupData[{

Cell["III. Boundary Logic Review", "Section",ExpressionUUID->"98e6acf9-566e-0f42-b286-7880128f62e4"],

Cell["\<\
From the mass transport framework, the main boundary classes are: \
\>", "Text",ExpressionUUID->"cc4c94e3-a983-e948-aad3-5ec139b3ace3"],

Cell[TextData[ButtonBox["DirichletCondition",
 BaseStyle->"Link",
 ButtonData->"paclet:ref/DirichletCondition"]], "Item",ExpressionUUID->\
"01152c4d-2290-9a4b-81fb-626c701b7d51"],

Cell[TextData[ButtonBox["NeumannValue",
 BaseStyle->"Link",
 ButtonData->"paclet:ref/NeumannValue"]], "Item",ExpressionUUID->"47ced413-\
efbd-0e41-88fd-f3a812b20728"],

Cell[TextData[ButtonBox["PeriodicBoundaryCondition",
 BaseStyle->"Link",
 ButtonData->"paclet:ref/PeriodicBoundaryCondition"]], "Item",ExpressionUUID->\
"a53e054c-1d53-d04f-a5a5-eb3780573b58"],

Cell["\<\
The mass transport tutorial identifies four major boundary classes:\
\>", "Text",ExpressionUUID->"7ede5fe4-7751-9b4c-aab0-e7245d485981"],

Cell["1. concentration or value type", "Text",ExpressionUUID->"6b70f493-c92a-f74b-919c-36f63b7dc648"],

Cell["2. flux type", "Text",ExpressionUUID->"bf5dd3b0-9ad9-ab4b-be0f-ca2965eac9b3"],

Cell["3. Robin or transfer type", "Text",ExpressionUUID->"b2e5f764-49d4-b74e-8140-59bb45e208cf"],

Cell["4. periodic type", "Text",ExpressionUUID->"a7a79f48-e5f9-a74f-bbc5-937c3997b686"],

Cell[TextData[{
 "See ",
 ButtonBox["Mass Transport tutorial",
  BaseStyle->"Link",
  ButtonData->"paclet:PDEModels/tutorial/MassTransport/MassTransport"],
 ". "
}], "Text",ExpressionUUID->"3aed5347-2ced-484a-ab46-5a896f526970"],

Cell[CellGroupData[{

Cell["Clean RHUFT boundary taxonomy", "Subsection",ExpressionUUID->"d84bb4ee-30f7-704a-b329-41f5be971b33"],

Cell[CellGroupData[{

Cell["Value condition", "Subsubsection",ExpressionUUID->"0f2bf1ed-d8db-c047-a1a6-803015e004d6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["i", "TI"]], "  ", "on ", 
         SubscriptBox["\[CapitalGamma]", 
          StyleBox["D", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "q_i = g_i \\quad \\text{on } \\Gamma_D", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0801e3a-b903-7048-8cab-745c73727efe"],
 "Use ",
 ButtonBox["DirichletCondition",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/DirichletCondition"],
 ", or for transport concentrations, ",
 ButtonBox["MassConcentrationCondition",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MassConcentrationCondition"],
 ". "
}], "Text",ExpressionUUID->"0dbc85cf-e1e1-eb47-a426-0da45ecf5ceb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Flux condition", "Subsubsection",ExpressionUUID->"044ac3c2-e39d-104c-9273-65982e8e6601"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", FontSlant -> "Bold"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], "  ", "on ", 
         SubscriptBox["\[CapitalGamma]", 
          StyleBox["N", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{n}\\cdot\\mathbf{J}_i = h_i \\quad \\text{on } \\Gamma_N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "99420988-1757-8740-a006-3280de5daa3c"],
 "Use ",
 ButtonBox["NeumannValue",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NeumannValue"],
 ", or transport-specific wrappers such as ",
 ButtonBox["MassFluxValue",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MassFluxValue"],
 ". "
}], "Text",ExpressionUUID->"73c71d66-af92-024c-8cc2-55c5ef73f18f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Impermeable condition", "Subsubsection",ExpressionUUID->"98bcf304-0298-cf41-8351-553764270dec"],

Cell[TextData[{
 "For the conservative transport model: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", FontSlant -> "Bold"], "\[CenterDot]", 
         StyleBox["J", FontSlant -> "Bold"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{n}\\cdot\\mathbf{J}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "282f5223-b4ae-a044-a412-5362b930966d"],
 "The transport tutorial notes that for the conservative form, this is \
effectively a zero Neumann condition and can be implicit. "
}], "Text",ExpressionUUID->"68587683-b89f-5643-b8a5-163c89bdad47"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Transfer or Robin condition", "Subsubsection",ExpressionUUID->"40419c87-afc6-9f4e-b749-66e447bbd906"],

Cell[TextData[{
 "A standard surrounding-flux form is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", FontSlant -> "Bold"], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["d", "TI"], "\[Del]", 
             StyleBox["c", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["k", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["c", "TI"], 
              StyleBox["ext", FontSlant -> "Plain"]], "-", 
             StyleBox["c", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\mathbf{n}\\cdot(d\\nabla c)=k(c_{\\mathrm{ext}}-c)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c6d5a2e0-877a-424d-9840-60dc266ee2b4"],
 "This can be represented by ",
 ButtonBox["MassTransferValue",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MassTransferValue"],
 ". "
}], "Text",ExpressionUUID->"0b58aa69-dac2-1d46-8fa6-3e841961bcc4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Outflow condition", "Subsubsection",ExpressionUUID->"74a17e8d-ff91-7548-8b4f-fe00b7c1d0ab"],

Cell["\<\
Outflow handling depends on the model form. The distinction between \
conservative and nonconservative formulations is important in transport \
models. \
\>", "Text",ExpressionUUID->"098245f9-3068-0740-a1e3-7387ba032af6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
