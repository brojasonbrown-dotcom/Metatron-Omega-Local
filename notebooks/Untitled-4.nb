Cell[CellGroupData[{

Cell["Review Principles", "Section",ExpressionUUID->"b0969ffd-e850-f843-8d6b-de5103ac7aa1"],

Cell[TextData[{
 "Keep only ",
 StyleBox["frameworks with clear governing equations, boundary logic, and \
implementation pathways",
  FontWeight->Bold],
 "."
}], "Item",ExpressionUUID->"2bca1b9e-5948-9845-8e88-ba168f716b63"],

Cell[TextData[{
 "Prefer ",
 StyleBox["conservative formulations",
  FontWeight->Bold],
 " when conservation is central."
}], "Item",ExpressionUUID->"2de6ade4-c751-2b43-bc02-f6c4326a08bb"],

Cell[TextData[{
 "Distinguish carefully between ",
 StyleBox["bulk dynamics",
  FontWeight->Bold],
 ", ",
 StyleBox["flux laws",
  FontWeight->Bold],
 ", ",
 StyleBox["source terms",
  FontWeight->Bold],
 ", and ",
 StyleBox["boundary operators",
  FontWeight->Bold],
 "."
}], "Item",ExpressionUUID->"968243ba-08a1-0f4e-a192-86ab6b123698"],

Cell[TextData[{
 "Use ",
 StyleBox["built-in Wolfram Language PDE functionality",
  FontWeight->Bold],
 " wherever possible."
}], "Item",ExpressionUUID->"b08b74a8-d2c6-2d41-abfd-1b455774190f"],

Cell[TextData[{
 "Organize all candidates by ",
 StyleBox["generality",
  FontWeight->Bold],
 ", ",
 StyleBox["interpretability",
  FontWeight->Bold],
 ", ",
 StyleBox["extensibility",
  FontWeight->Bold],
 ", and ",
 StyleBox["computational realizability",
  FontWeight->Bold],
 "."
}], "Item",ExpressionUUID->"f4ca401c-4157-474c-81ec-eeeef0b608c3"],

