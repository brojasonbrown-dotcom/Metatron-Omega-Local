Cell[CellGroupData[{

Cell["Candidate B. Conservative reaction-transport framework", "Subsection",ExpressionUUID->"dc34e6ca-bde3-184d-8927-2d1a11197cf9"],

Cell[TextData[{
 "A stronger applied candidate is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["q", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], "+", "\[Del]", "\[CenterDot]", 
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["q", FontSlant -> "Bold"], ",", "\[Psi]", ",", 
             StyleBox["x", FontSlant -> "Bold"], ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\frac{\\partial q_i}{\\partial t} + \\nabla\\cdot \\mathbf{J}_i = R_i(\
\\mathbf{q},\\boldsymbol{\\psi},\\mathbf{x},t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ecacc01a-daa7-504c-b301-3bbaa501285a"],
 "with flux decomposition ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", 
         UnderscriptBox["\[Sum]", 
          StyleBox["j", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["D", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[Del]", 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["j", "TI"]], "+", 
         SubscriptBox[
          StyleBox["v", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "-", 
         SubscriptBox["\[Chi]", 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[Del]", "\[Phi]", "+", 
         SubsuperscriptBox[
          StyleBox["J", FontSlant -> "Bold"], 
          StyleBox["i", "TI"], 
          StyleBox["cross", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathbf{J}_i = -\\sum_j D_{ij}\\nabla q_j + \\mathbf{v}_i q_i - \
\\chi_i q_i\\nabla \\phi + \\mathbf{J}^{\\mathrm{cross}}_i", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e094586c-28e4-f342-9328-db827f117bdc"],
 "for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
         StyleBox["m", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i=1,\\dots,m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "703bc2ed-b612-4a41-acaf-02ef2c4639a1"],
 ". "
}], "Text",ExpressionUUID->"9db6e52f-71e7-fa4a-8787-fdc6ada6407a"]
}, Open  ]],

