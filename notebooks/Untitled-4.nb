Cell["Strong multiphysics extension", "Item",ExpressionUUID->"e1755a22-7263-4a4b-a080-75a20401ed30"],

Cell["Recommended as a second-tier core module", "Item",ExpressionUUID->"ac7e05bd-6f2e-a54e-aa58-dd65a35fc9a2"],

