Cell[CellGroupData[{

Cell["VI. Clean Wolfram Language Framework Templates", "Section",ExpressionUUID->"08570e0a-3c99-3f4b-a3b6-be0a984edb5f"],

Cell[CellGroupData[{

Cell["1. Abstract conservative PDE template", "Subsection",ExpressionUUID->"1931afb8-e94b-9b48-973c-5cfe4dea17ca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"q", ",", "x", ",", "y", ",", "t", ",", "flux", ",", "source"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "t"}], "]"}], "+", 
     RowBox[{"Div", "[", 
      RowBox[{
       RowBox[{"flux", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "==", 
    RowBox[{"source", "[", 
     RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}], ";"}]}], "Input",Expression\
UUID->"0e715a6f-ecb8-5f46-8c5e-773e7997383b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Transport specialization", "Subsection",ExpressionUUID->"39835cf4-e72d-f74b-a009-41616901fe75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "c", ",", "x", ",", "y", ",", "t", ",", "d", ",", "vx", ",", "vy", ",", 
     "reaction"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "t"}], "]"}], "+", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"Div", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "d"}], " ", 
         RowBox[{"Grad", "[", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"vx", "[", 
            RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", 
           RowBox[{"vy", "[", 
            RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "}"}], " ", 
         RowBox[{"c", "[", 
          RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "==", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{"reaction", "[", 
     RowBox[{
      RowBox[{"c", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}], ",", "x", ",", "y", ",", 
      "t"}], "]"}]}]}], ";"}]}], "Input",ExpressionUUID->"366e6531-4f4d-b448-\
a52e-53d05a3256ad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Built-in mass transport component", "Subsection",ExpressionUUID->"b280ed83-9584-c147-9f34-6c27f5095c9c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "[", 
       RowBox[{"t", ",", "x"}], "]"}], ",", "t", ",", 
      RowBox[{"{", "x", "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pars", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<DiffusionCoefficient\>\"", "->", "0.026"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<MassConvectionVelocity\>\"", "->", 
       RowBox[{"{", "0.1", "}"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ModelForm\>\"", "->", "\"\<Conservative\>\""}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fluxBc", "=", 
   RowBox[{"MassFluxValue", "[", 
    RowBox[{
     RowBox[{"x", "==", "0"}], ",", "vars", ",", "pars", ",", 
     RowBox[{"<|", 
      RowBox[{"\"\<MassFlux\>\"", "->", "1"}], "|>"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"concBc", "=", 
    RowBox[{"MassConcentrationCondition", "[", 
     RowBox[{
      RowBox[{"x", "==", "1"}], ",", "vars", ",", "pars", ",", 
      RowBox[{"<|", 
       RowBox[{"\"\<MassConcentration\>\"", "->", "0"}], "|>"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqn", "=", 
   RowBox[{
    RowBox[{"MassTransportPDEComponent", "[", 
     RowBox[{"vars", ",", "pars"}], "]"}], "==", "fluxBc"}]}], 
  ";"}]}], "Input",ExpressionUUID->"86cb6656-60d2-9d48-acaf-68eda586e409"],

Cell[TextData[{
 "This matches the structure documented for ",
 ButtonBox["MassTransportPDEComponent",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MassTransportPDEComponent"],
 " and ",
 ButtonBox["MassFluxValue",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MassFluxValue"],
 ". "
}], "Text",ExpressionUUID->"67109ca1-3a8d-1e48-9da4-257c9fb7b2ad"],

