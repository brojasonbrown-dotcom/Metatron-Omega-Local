   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"bd3503da-7daa-cd49-a271-6c8c4d18a6e7"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"8. The master equation\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"99602ee7-2bf2-c346-b17e-040b5602e9c1"],
 "\nYou write, effectively, \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["p", "TI"]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["G", "TI"], "-1"], 
             SubscriptBox["\[Integral]", "Vol"], 
             RowBox[{"(", 
               RowBox[{"|", 
                 SubscriptBox["\[CapitalOmega]", "rec"], 
                 SuperscriptBox["|", "2"], "-", "|", 
                 SubscriptBox["\[CapitalOmega]", "base"], 
                 SuperscriptBox["|", "2"]}], ")"}], "\[DifferentialD]", 
             StyleBox["r", "TI"]}], ")"}], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Phi]", 
              RowBox[{"15", "+", 
                SuperscriptBox["\[Phi]", "-1"]}]], "\[CenterDot]", 
             FractionBox["6455", "6456"]}], ")"}], "\[CenterDot]", 
         RowBox[{"(", "electromagnetic coherence factor", ")"}], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "M_p =\n\\left(\nG^{-1}\\int_{\\text{Vol}} (\\lvert \
\\Omega_{\\text{rec}}\\rvert^2-\\lvert \\Omega_{\\text{base}}\\rvert^2)\\,dr\n\
\\right)\n\\cdot\n\\left(\\phi^{15+\\phi^{-1}}\\cdot \
\\frac{6455}{6456}\\right)\n\\cdot\n\\left(\\text{electromagnetic coherence \
factor}\\right).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "61a5113e-9e14-a04a-8ad6-0db0f826c7ba"],
 "\nConceptually, this is useful as a ",
 StyleBox["framework decomposition",
  FontWeight->Bold],
 ": \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "dimensional scale term,"
 }], "InlineItem",ExpressionUUID->"fb0a0c37-9dcb-3841-b47c-fa98f9a0d300"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "geometric hierarchy term,"
 }], "InlineItem",ExpressionUUID->"702dce71-aa4c-914e-9f44-9b8f7426b51f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "boundary/coherence term."
 }], "InlineItem",ExpressionUUID->"cc117f5c-3c47-bf42-8bbd-420e7b5a5211"],
 "\nThat decomposition is actually valuable. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"But the mathematical status is mixed\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"50b650ab-f2cd-4349-a788-adb01536a5da"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"First bracket\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f0fa0b89-4eba-eb48-bb3d-df379858015b"],
 "\npotentially meaningful \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Second bracket\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"24c9e288-0299-6746-ace5-7325638a092b"],
 "\ncurrently fitted / conjectural \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Third bracket\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c6f02b49-fbad-4041-8ea1-400a284b2bc3"],
 "\ncurrently not derived\n\nSo as an RHUFT master equation, this should be \
labeled:\n\n",
 StyleBox["prototype synthesis equation",
  FontWeight->Bold],
