Cell[CellGroupData[{

Cell["5. Canonical Engine State", "Section",ExpressionUUID->"acd34176-b8d5-824f-9f39-7f0be38f308b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "makeEngineState", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeEngineState", "[", 
    RowBox[{"config_", ":", " ", "defaultConfig"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"config", "[", "\"\<StringCount\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"seed", "=", 
        RowBox[{"config", "[", "\"\<Seed\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "   ", "freqs", ",", "\[IndentingNewLine]", 
       "   ", "phases", ",", "\[IndentingNewLine]", "   ", "amplitudes", ",", 
       "\[IndentingNewLine]", "   ", "nodeGraph", ",", "\[IndentingNewLine]", 
       "   ", "nodeValues"}], "\[IndentingNewLine]", "  ", "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"freqs", "=", 
       RowBox[{"goldenFrequencies", "[", "n", "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"phases", "=", 
       RowBox[{"randomPhases", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"amplitudes", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1.", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"nodeGraph", "=", 
       RowBox[{"RandomGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"Round", "[", 
            RowBox[{"1.6", " ", "n"}], "]"}]}], "}"}], ",", 
         RowBox[{"VertexLabels", "->", "Automatic"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"nodeValues", "=", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "nodeGraph", "]"}], ",", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"VertexCount", "[", "nodeGraph", "]"}]}], "]"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{"\"\<Time\>\"", "->", "0"}], ",", "\[IndentingNewLine]", 
        "   ", 
        RowBox[{"\"\<Config\>\"", "->", "config"}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"\"\<Oscillator\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "     ", 
          RowBox[{
           RowBox[{"\"\<Phases\>\"", "->", "phases"}], ",", 
           "\[IndentingNewLine]", "     ", 
           RowBox[{"\"\<Frequencies\>\"", "->", "freqs"}], ",", 
           "\[IndentingNewLine]", "     ", 
           RowBox[{"\"\<Amplitudes\>\"", "->", "amplitudes"}]}], 
          "\[IndentingNewLine]", "   ", "|>"}]}], ",", "\[IndentingNewLine]", 
        "   ", 
        RowBox[{"\"\<Topology\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "     ", 
          RowBox[{
           RowBox[{"\"\<FluxIn\>\"", "->", "1."}], ",", "\[IndentingNewLine]",
            "     ", 
           RowBox[{"\"\<FluxOut\>\"", "->", "1."}], ",", 
           "\[IndentingNewLine]", "     ", 
           RowBox[{"\"\<Imbalance\>\"", "->", "0."}], ",", 
           "\[IndentingNewLine]", "     ", 
           RowBox[{"\"\<ClosureScore\>\"", "->", "1."}], ",", 
           "\[IndentingNewLine]", "     ", 
           RowBox[{"\"\<ClosedQ\>\"", "->", "True"}]}], "\[IndentingNewLine]",
           "   ", "|>"}]}], ",", "\[IndentingNewLine]", "   ", 
        RowBox[{"\"\<Nodes\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "     ", 
          RowBox[{
           RowBox[{"\"\<Graph\>\"", "->", "nodeGraph"}], ",", 
           "\[IndentingNewLine]", "     ", 
           RowBox[{"\"\<Values\>\"", "->", "nodeValues"}]}], 
          "\[IndentingNewLine]", "   ", "|>"}]}], ",", "\[IndentingNewLine]", 
        "   ", 
        RowBox[{"\"\<Memory\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "     ", 
          RowBox[{
           RowBox[{"\"\<PreviousSignature\>\"", "->", 
            RowBox[{"0.", "+", 
             RowBox[{"0.", " ", "I"}]}]}], ",", "\[IndentingNewLine]", 
           "     ", 
           RowBox[{"\"\<Prediction\>\"", "->", 
            RowBox[{"0.", "+", 
             RowBox[{"0.", " ", "I"}]}]}], ",", "\[IndentingNewLine]", 
           "     ", 
           RowBox[{"\"\<Discrepancy\>\"", "->", "0."}], ",", 
           "\[IndentingNewLine]", "     ", 
           RowBox[{"\"\<PersistenceScore\>\"", "->", "1."}]}], 
          "\[IndentingNewLine]", "   ", "|>"}]}], ",", "\[IndentingNewLine]", 
        "   ", 
        RowBox[{"\"\<Density\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "     ", 
          RowBox[{
           RowBox[{"\"\<Burden\>\"", "->", "0."}], ",", "\[IndentingNewLine]",
            "     ", 
           RowBox[{"\"\<InertiaProxy\>\"", "->", "0."}]}], 
          "\[IndentingNewLine]", "   ", "|>"}]}], ",", "\[IndentingNewLine]", 
        "   ", 
        RowBox[{"\"\<Metrics\>\"", "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "     ", 
          RowBox[{
           RowBox[{"\"\<Coherence\>\"", "->", "0."}], ",", 
           "\[IndentingNewLine]", "     ", 
           RowBox[{"\"\<Closure\>\"", "->", "1."}], ",", 
           "\[IndentingNewLine]", "     ", 
           RowBox[{"\"\<Drift\>\"", "->", "0."}], ",", "\[IndentingNewLine]", 
           "     ", 
           RowBox[{"\"\<Leak\>\"", "->", "0."}], ",", "\[IndentingNewLine]", 
           "     ", 
           RowBox[{"\"\<Objective\>\"", "->", "0."}]}], "\[IndentingNewLine]",
           "   ", "|>"}]}], ",", "\[IndentingNewLine]", "   ", 
        RowBox[{"\"\<Diagnostics\>\"", "->", 
         RowBox[{"<|", "|>"}]}]}], "\[IndentingNewLine]", "  ", "|>"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"8ffc96b8-9876-4147-8e71-5c6a40192346"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Engine Step and Runtime", "Section",ExpressionUUID->"91ee9c49-2d1a-b04f-9723-04793a0a81e1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"engineStep", ",", "runEngine", ",", "metricSeries"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"engineStep", "[", "state_Association", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{"config", "=", 
         RowBox[{"state", "[", "\"\<Config\>\"", "]"}]}], ",", 
        "\[IndentingNewLine]", "   ", "phases", ",", "\[IndentingNewLine]", 
        "   ", "newPhases", ",", "\[IndentingNewLine]", "   ", "freqs", ",", 
        "\[IndentingNewLine]", "   ", "amps", ",", "\[IndentingNewLine]", 
        "   ", "sig", ",", "\[IndentingNewLine]", "   ", "prevSig", ",", 
        "\[IndentingNewLine]", "   ", "fluxIn", ",", "\[IndentingNewLine]", 
        "   ", "fluxOut", ",", "\[IndentingNewLine]", "   ", "topology", ",", 
        "\[IndentingNewLine]", "   ", "measurement", ",", 
        "\[IndentingNewLine]", "   ", "newMemory", ",", "\[IndentingNewLine]",
         "   ", "newNodes", ",", "\[IndentingNewLine]", "   ", "burden", ",", 
        "\[IndentingNewLine]", "   ", "inertia", ",", "\[IndentingNewLine]", 
        "   ", "coherence", ",", "\[IndentingNewLine]", "   ", "drift", ",", 
        "\[IndentingNewLine]", "   ", "leak", ",", "\[IndentingNewLine]", 
        "   ", "newState", ",", "\[IndentingNewLine]", "   ", "objective", ",",
         "\[IndentingNewLine]", "   ", "continuity"}], "\[IndentingNewLine]", 
       "  ", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"phases", "=", 
        RowBox[{"state", "[", 
         RowBox[{"\"\<Oscillator\>\"", ",", "\"\<Phases\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"freqs", "=", 
        RowBox[{"state", "[", 
         RowBox[{"\"\<Oscillator\>\"", ",", "\"\<Frequencies\>\""}], "]"}]}], 
       ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"amps", "=", 
        RowBox[{"state", "[", 
         RowBox[{"\"\<Oscillator\>\"", ",", "\"\<Amplitudes\>\""}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
       RowBox[{"newPhases", "=", 
        RowBox[{"kuramotoStep", "[", 
         RowBox[{"phases", ",", "freqs", ",", 
          RowBox[{"config", "[", "\"\<Coupling\>\"", "]"}], ",", 
          RowBox[{"config", "[", "\"\<Dt\>\"", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"sig", "=", 
        RowBox[{"superpositionSignal", "[", 
         RowBox[{"newPhases", ",", "amps"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"prevSig", "=", 
        RowBox[{"state", "[", 
         RowBox[{"\"\<Memory\>\"", ",", "\"\<Prediction\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
       RowBox[{"fluxIn", "=", 
        RowBox[{"1.", "+", 
         RowBox[{"0.15", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"state", "[", "\"\<Time\>\"", "]"}], "+", "1"}], ")"}], 
            "/", "12."}], "]"}]}], "+", 
         RowBox[{"0.05", " ", 
          RowBox[{"coherenceMagnitude", "[", "newPhases", "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"fluxOut", "=", 
        RowBox[{"1.", "+", 
         RowBox[{"0.12", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"state", "[", "\"\<Time\>\"", "]"}], "+", "1"}], ")"}], 
            "/", "15."}], "]"}]}], "+", 
         RowBox[{"0.03", " ", 
          RowBox[{
           RowBox[{"Abs", "[", "sig", "]"}], "/", 
           RowBox[{"Length", "[", "newPhases", "]"}]}]}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"topology", "=", 
        RowBox[{"closureMetrics", "[", 
         RowBox[{"fluxIn", ",", "fluxOut", ",", "config"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
       RowBox[{"measurement", "=", 
        RowBox[{"<|", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"\"\<Signature\>\"", "->", "sig"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Coherence\>\"", "->", 
           RowBox[{"coherenceMagnitude", "[", "newPhases", "]"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Closure\>\"", "->", 
           RowBox[{"topology", "[", "\"\<ClosureScore\>\"", "]"}]}]}], 
         "\[IndentingNewLine]", "  ", "|>"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"newMemory", "=", 
        RowBox[{"memoryUpdate", "[", 
         RowBox[{
          RowBox[{"state", "[", "\"\<Memory\>\"", "]"}], ",", "measurement", ",", 
          RowBox[{"config", "[", "\"\<MemoryAlpha\>\"", "]"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
       RowBox[{"newNodes", "=", 
        RowBox[{"nodeUpdate", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"state", "[", 
           RowBox[{"\"\<Nodes\>\"", ",", "\"\<Graph\>\""}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"state", "[", 
           RowBox[{"\"\<Nodes\>\"", ",", "\"\<Values\>\""}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", "sig", ",", "\[IndentingNewLine]", 
          "    ", "newMemory", ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"config", "[", "\"\<Dt\>\"", "]"}]}], "\[IndentingNewLine]",
          "  ", "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"burden", "=", 
        RowBox[{"burdenMeasure", "[", "newNodes", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"inertia", "=", "burden"}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"coherence", "=", 
        RowBox[{"measurement", "[", "\"\<Coherence\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"drift", "=", 
        RowBox[{
         RowBox[{"config", "[", "\"\<DriftScale\>\"", "]"}], " ", 
         RowBox[{"newMemory", "[", "\"\<Discrepancy\>\"", "]"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"leak", "=", 
        RowBox[{
         RowBox[{"config", "[", "\"\<LeakScale\>\"", "]"}], " ", 
         RowBox[{"topology", "[", "\"\<Imbalance\>\"", "]"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"continuity", "=", 
        RowBox[{"timeContinuity", "[", 
         RowBox[{"prevSig", ",", "sig"}], "]"}]}], ";", "\[IndentingNewLine]",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"newState", "=", 
        RowBox[{"<|", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"\"\<Time\>\"", "->", 
           RowBox[{
            RowBox[{"state", "[", "\"\<Time\>\"", "]"}], "+", "1"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Config\>\"", "->", "config"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Oscillator\>\"", "->", 
           RowBox[{"<|", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"\"\<Phases\>\"", "->", "newPhases"}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"\"\<Frequencies\>\"", "->", "freqs"}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"\"\<Amplitudes\>\"", "->", "amps"}]}], 
            "\[IndentingNewLine]", "    ", "|>"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Topology\>\"", "->", "topology"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Nodes\>\"", "->", 
           RowBox[{"<|", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"\"\<Graph\>\"", "->", 
              RowBox[{"state", "[", 
               RowBox[{"\"\<Nodes\>\"", ",", "\"\<Graph\>\""}], "]"}]}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"\"\<Values\>\"", "->", "newNodes"}]}], 
            "\[IndentingNewLine]", "    ", "|>"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Memory\>\"", "->", "newMemory"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Density\>\"", "->", 
           RowBox[{"<|", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"\"\<Burden\>\"", "->", "burden"}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"\"\<InertiaProxy\>\"", "->", "inertia"}]}], 
            "\[IndentingNewLine]", "    ", "|>"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Metrics\>\"", "->", 
           RowBox[{"<|", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"\"\<Coherence\>\"", "->", "coherence"}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"\"\<Closure\>\"", "->", 
              RowBox[{"topology", "[", "\"\<ClosureScore\>\"", "]"}]}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"\"\<Drift\>\"", "->", "drift"}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"\"\<Leak\>\"", "->", "leak"}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"\"\<Objective\>\"", "->", "0."}]}], 
            "\[IndentingNewLine]", "    ", "|>"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<Diagnostics\>\"", "->", 
           RowBox[{"<|", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"\"\<FieldSignal\>\"", "->", "sig"}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"\"\<FieldPhase\>\"", "->", 
              RowBox[{"Arg", "[", "sig", "]"}]}], ",", "\[IndentingNewLine]", 
             "      ", 
             RowBox[{"\"\<Continuity\>\"", "->", "continuity"}]}], 
            "\[IndentingNewLine]", "    ", "|>"}]}]}], "\[IndentingNewLine]", 
         "  ", "|>"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"objective", "=", 
        RowBox[{"actualizationObjective", "[", "newState", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"newState", "=", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{"newState", ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Metrics\>\"", ",", "\"\<Objective\>\""}], "}"}], "->",
            "objective"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"engineStateQ", "[", "newState", "]"}], ",", "newState", ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidState\>\"", ",", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<Message\>\"", 
             "->", "\"\<Engine state failed invariant checks.\>\""}], 
            "|>"}]}], "]"}]}], "\[IndentingNewLine]", "  ", "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runEngine", "[", 
     RowBox[{
      RowBox[{"steps_Integer", "?", "Positive"}], ",", 
      RowBox[{"config_", ":", " ", "defaultConfig"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"initialState", "=", 
        RowBox[{"makeEngineState", "[", 
         RowBox[{"Join", "[", 
          RowBox[{"defaultConfig", ",", "config"}], "]"}], "]"}]}], "}"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"NestList", "[", 
       RowBox[{"engineStep", ",", "initialState", ",", "steps"}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"metricSeries", "[", 
    RowBox[{"states_List", ",", "key_String"}], "]"}], ":=", 
   RowBox[{"states", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "\"\<Metrics\>\"", ",", "key"}], "]"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"8435e130-28a5-ba4e-aecc-6207018ded01"]
