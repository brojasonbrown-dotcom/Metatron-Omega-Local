        "\[IndentingNewLine]", "   ", 
        RowBox[{"threshold", "=", 
         RowBox[{"config", "[", "\"\<ClosureThreshold\>\"", "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{"\"\<FluxIn\>\"", "->", "fluxIn"}], ",", 
