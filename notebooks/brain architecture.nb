             SubscriptBox["\[CapitalOmega]", "rec"], 
             SuperscriptBox["|", "2"], "-", "|", 
             SubscriptBox["\[CapitalOmega]", "base"], 
             SuperscriptBox["|", "2"]}], ")"}], "\[DifferentialD]", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M = C_{\\text{mass}} \\int_{\\text{Vol}} \\left(\\lvert \
\\Omega_{\\text{rec}}\\rvert^2 - \\lvert \
\\Omega_{\\text{base}}\\rvert^2\\right)\\, dr", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ab97b2f7-b5b7-124d-9c23-11f5e583eca6"],
 "\nis a plausible RHUFT-style mass ansatz. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Why it is good\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"aacb91ed-a8e5-f742-a2b3-8adee8fc6a96"],
 "\nIt says mass is not primitive but emergent from: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "localized field organization,"
 }], "InlineItem",ExpressionUUID->"96357dc1-393e-ba45-8769-b9b31f0430b6"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "relative to a background field,"
 }], "InlineItem",ExpressionUUID->"6a12f813-5102-8e47-8d88-3a57337e34bd"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "integrated over effective volume."
 }], "InlineItem",ExpressionUUID->"104c13b0-fa16-3448-ad3b-b91d47f0cba5"],
 "\nThat is conceptually coherent. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Important caveat\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"55883948-70d4-604e-81db-c2437e557247"],
 "\nThis is still an ",
 StyleBox["ansatz",
  FontWeight->Bold],
 ", not a derivation.  \nYou are choosing a quadratic contrast density, \
likely by analogy with energy density. That is reasonable, but it is not \
uniquely forced.\n\nQuestions RHUFT should answer later: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Why ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"|", "\[CapitalOmega]", 
          SuperscriptBox["|", "2"]}], TraditionalForm], "errors" -> {}, 
      "input" -> "|\\Omega|^2", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "d71e2c7f-f1c1-314e-8a4e-5e46f3cc0028"],
  " rather than ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        TemplateBox[{
          RowBox[{"\[CapitalOmega]"}]}, "Abs"], TraditionalForm], 
      "errors" -> {}, "input" -> "|\\Omega|", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "c0e570c2-bbab-8347-b931-969ccefb5ba1"],
  " or another invariant?"
 }], "InlineItem",ExpressionUUID->"3be2d556-21db-9546-9d4b-2c6a39e0d49b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Why volume integral rather than spacetime integral?"
 }], "InlineItem",ExpressionUUID->"cc1276c6-dbef-a74f-97ad-fa3fa5d6af7a"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "What defines the effective support of the particle?"
 }], "InlineItem",ExpressionUUID->"4c814d18-9e09-874d-b425-5242d7c2811b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Is ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox["\[CapitalOmega]", "base"], TraditionalForm], 
      "errors" -> {}, "input" -> "\\Omega_{\\text{base}}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "b2dadc75-31b9-9e4a-9cff-d9824b5a5ee5"],
  " constant, vacuum-dependent, scale-dependent?"
 }], "InlineItem",ExpressionUUID->"66ddd88b-0ac5-964e-8398-1de9f6a9194c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"RHUFT alignment\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"da1753c4-8161-a44f-bdd5-801bec864213"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " strong provisional model equation \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"6cc59eaa-fc03-8f4e-bace-df5e34852a0c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox[Cell[TextData[{
     "3. Dimensional proof that the coupling has units of ",
     Cell[BoxData[
      FormBox[
       TemplateBox[<|"boxes" -> FormBox[
           SuperscriptBox[
            StyleBox["G", "TI"], "-1"], TraditionalForm], "errors" -> {}, 
         "input" -> "G^{-1}", "state" -> "Boxes"|>,
        "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
      "85b35c00-c1e0-6f42-88e4-8bc07965934d"]
    }],
     Background->None,ExpressionUUID->"c91a632e-970d-8440-b709-68d7453f1178"],
     "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"1cfa5271-37fe-674b-a1e4-0542c1aae243"],
 "\nThis is your strongest formal result.\n\nYou compute: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           RowBox[{
             SuperscriptBox["\[CapitalOmega]", "2"], 
             StyleBox["d", "TI"], 
             StyleBox["V", "TI"]}], "]"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["T", "TI"], "-2"], 
         SuperscriptBox[
          StyleBox["L", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "[\\Omega^2 dV] = T^{-2} L^3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "527e726e-90c5-9441-ad38-e93de0d8dd18"],
 "\nso for \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["C", "TI"], "mass"], 
         StyleBox["I", "TI"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "M = C_{\\text{mass}} I,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "df9963f9-76a1-eb41-91c5-542f295e1b11"],
 "\nyou need \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           SubscriptBox[
            StyleBox["C", "TI"], "mass"], "]"}], "\[LongEqual]", 
         StyleBox["M", "TI"], 
         SuperscriptBox[
          StyleBox["L", "TI"], "-3"], 
         SuperscriptBox[
          StyleBox["T", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "[C_{\\text{mass}}] = M L^{-3} T^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cca89990-9c29-cd47-9073-f46bc616a2a8"],
 "\nand since \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           StyleBox["G", "TI"], "]"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["L", "TI"], "3"], 
         SuperscriptBox[
          StyleBox["M", "TI"], "-1"], 
         SuperscriptBox[
          StyleBox["T", "TI"], "-2"], ","}], TraditionalForm], "errors" -> {},
      "input" -> "[G] = L^3 M^{-1} T^{-2},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "352f153b-abdd-5f4d-9c46-7441331fdc2f"],
 "\nit follows that \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           SuperscriptBox[
            StyleBox["G", "TI"], "-1"], "]"}], "\[LongEqual]", 
         StyleBox["M", "TI"], 
         SuperscriptBox[
          StyleBox["L", "TI"], "-3"], 
         SuperscriptBox[
          StyleBox["T", "TI"], "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "[G^{-1}] = M L^{-3} T^2.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "91af1ac7-8c6e-cb43-9a96-c87acb5e42bc"],
 "\nThis is dimensionally correct. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"What this actually proves\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"26a13b84-6fe9-314f-942a-1c5a7bf8a1ab"],
 "\nIt proves only that ",
 StyleBox["if",
  FontWeight->Bold],
 " your mass functional has that form, then a natural coupling with the right \
dimensions could be proportional to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["G", "TI"], "-1"], TraditionalForm], "errors" -> {}, "input" -> 
     "G^{-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6473c22e-47c3-8d41-86e3-6a0f9021d5ed"],
 ".\n\nIt does ",
 StyleBox["not",
  FontWeight->Bold],
 " prove: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "that the coefficient must equal exactly ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SuperscriptBox[
         StyleBox["G", "TI"], "-1"], TraditionalForm], "errors" -> {}, 
      "input" -> "G^{-1}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "3a695b24-346d-ef4c-ae38-f7c3f0de9863"],
  ","
 }], "InlineItem",ExpressionUUID->"33ad5ef0-d88a-d34b-bdcb-f3253ec54046"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "that gravity causes mass,"
 }], "InlineItem",ExpressionUUID->"d5cf8a6d-caee-4f47-afed-e910c6781f7f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "or that this is the unique possible form."
 }], "InlineItem",ExpressionUUID->"811159eb-a951-4646-8468-a6f52c876deb"],
 "\nYou need to distinguish: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["dimensional compatibility",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"696e6df4-aa66-264f-bb93-597aa66db64c"],
 "\nfrom \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["physical identity",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"efdd8463-b747-2a41-86a3-dd025bd93cf5"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Best phrasing\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e5a10989-7810-7845-bd71-f08fde545f35"],
 "\nInstead of: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox["\<\"\[OpenCurlyDoubleQuote]This confirms the foundational \
postulate...\[CloseCurlyDoubleQuote]\"\>",
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"1a027fe4-9783-d341-94cf-2912b10f295b"],
 "\nprefer: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox[Cell[TextData[{
       "\[OpenCurlyDoubleQuote]This shows that ",
       Cell[BoxData[
        FormBox[
         TemplateBox[<|"boxes" -> FormBox[
             SuperscriptBox[
              StyleBox["G", "TI"], "-1"], TraditionalForm], "errors" -> {}, 
           "input" -> "G^{-1}", "state" -> "Boxes"|>,
          "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
        "4a254834-bcd3-ee4e-ba7c-62b4a7773c9e"],
       " has exactly the dimensions required to serve as the natural coupling \
coefficient in the proposed mass-emergence functional.\[CloseCurlyDoubleQuote]"
      }],
       Background->None,ExpressionUUID->
       "ef1046f2-6035-e245-8cc1-aeb46096bc66"],
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"c0d76fed-b928-2446-89b2-a9bca163ee16"],
 "\nThat is rigorous. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"RHUFT alignment\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"71c7809e-4b48-054d-b9fc-48ba38c29957"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " valid dimensional observation, important \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"25556e85-408f-9849-834e-2813286b587c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. \[OpenCurlyDoubleQuote]Mass is fundamentally linked to \
the inverse gravitational coupling\[CloseCurlyDoubleQuote]\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"26323276-2a8e-e24c-90d0-8a60d1bc14df"],
 "\nThis is an interpretive claim. It may be RHUFT-consistent, but it \
currently exceeds what the math shows.\n\nSafer statement: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "The proposed RHUFT mass functional is dimensionally compatible with a \
coupling proportional to ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SuperscriptBox[
         StyleBox["G", "TI"], "-1"], TraditionalForm], "errors" -> {}, 
      "input" -> "G^{-1}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "d9cba727-9e58-5f4c-aa48-9a57d0a0fd2f"],
  "."
 }], "InlineItem",ExpressionUUID->"4e2e87b4-60f4-e24c-8ddc-734781dc1a08"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "This suggests a deep relation between gravitational scale-setting and \
coherence-based mass emergence."
 }], "InlineItem",ExpressionUUID->"8cbc9f31-2c0f-3446-a24a-e348946972f0"],
 "\nThat is much better than claiming proof of ontological identity. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"71095341-3ab8-9d4d-8d9c-b61d054c0f35"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"5. Golden-ratio mass hierarchy\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0bc0e68c-df10-0747-905d-68dac970affb"],
 "\nThe move \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          SubscriptBox[
           StyleBox["M", "TI"], 
           StyleBox["B", "TI"]], 
          SubscriptBox[
           StyleBox["M", "TI"], 
           StyleBox["A", "TI"]]], "\[Proportional]", 
         SuperscriptBox["\[Phi]", 
          RowBox[{"\[CapitalDelta]", 
            StyleBox["n", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\frac{M_B}{M_A} \\propto \\phi^{\\Delta n}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ccd435af-9eb5-be4d-8398-77827238c52b"],
 "\nis a speculative scaling hypothesis.\n\nIt may be aesthetically \
RHUFT-aligned if RHUFT emphasizes: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "recursive self-similarity,"
 }], "InlineItem",ExpressionUUID->"45f20983-3f99-2b43-a0b4-71f517a3a6a0"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "harmonic hierarchy,"
 }], "InlineItem",ExpressionUUID->"12e719f1-9891-4847-802d-cb0577176df2"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "preferred geometric scaling."
 }], "InlineItem",ExpressionUUID->"08f12e36-0ee4-6844-a2df-b44abc01289b"],
 "\nBut it is not derived here. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Major issue\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"74c8e5d4-cc85-3249-84e7-35e53a3a0025"],
 "\nYou define \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["n", "TI"], "mass"], "\[LongEqual]", "15", "+", 
         SuperscriptBox["\[Phi]", "-1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "n_{\\text{mass}} = 15 + \\phi^{-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c3481aed-c410-064e-97cc-f1511fec60da"],
 "\nand then introduce a correction \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox["6455", "6456"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{6455}{6456}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "56a25de6-c406-9841-86ca-e32b44b168cd"],
 "\nto match the proton/electron ratio closely.\n\nThat is not a proof. It is \
a tuned formula. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Why the correction is problematic\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0bb63334-5330-a14c-a603-3439b60ff27d"],
 "\nThe phrase: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox["\<\"\[OpenCurlyDoubleQuote]final, non-arbitrary geometric \
correction factor\[CloseCurlyDoubleQuote]\"\>",
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
