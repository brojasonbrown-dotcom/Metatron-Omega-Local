 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"3. Information density / burden / inertia analogs\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"97a70503-41fa-294c-8afb-f31891550569"],
 "\nInteresting and potentially useful, but still prototype-level.\n\nCurrent \
forms like: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"complexityMeasure", "[", "x_", "]"}], ":=", 
          RowBox[{"x", "^", "2"}]}], "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"relationalDensity", "[", "x_", "]"}], ":=", 
          RowBox[{"1", "+", 
            RowBox[{"0.5", " ", 
              RowBox[{"Sin", "[", "x", "]"}]}]}]}], "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"curvatureBurden", "[", "x_", "]"}], ":=", 
          RowBox[{"0.2", "+", 
            RowBox[{"0.3", " ", 
              RowBox[{
                RowBox[{"Cos", "[", 
                  RowBox[{"2", " ", "x"}], "]"}], "^", "2"}]}]}]}], 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"stabilizationCost", "[", "x_", "]"}], ":=", 
          RowBox[{"0.5", "+", 
            RowBox[{"0.5", " ", 
              RowBox[{"Exp", "[", 
                RowBox[{
                  RowBox[{"-", 
                    RowBox[{"x", "^", "2"}]}], "/", "4"}], "]"}]}]}]}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "fdd74bca-9a4b-3b4d-99c7-5db62fd85345"],
 "\nare workable placeholders, but not yet RHUFT-derived.\n\nThese should be \
labeled: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
