  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"9b93a9d0-8fbd-5643-aff2-4f65d09fcaaa"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"6. Fine structure constant identity\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"9d77504e-e5f2-6e40-857b-09bc93dcfd00"],
 "\nYou propose \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], "Ideal"], "\[LongEqual]", "137", "+", 
         FractionBox[
          SuperscriptBox["\[Pi]", "2"], 
          RowBox[{"6", 
            StyleBox["e", "TI"]}]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "C_{\\text{Ideal}} = 137 + \\frac{\\pi^2}{6e}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7dc52496-5d74-604a-afe8-d63f37a65c34"],
 "\nNumerically this is not close enough to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Alpha]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b8f1ea35-9304-f841-a2bb-7c1692f3dc2a"],
 " to count as a derivation. It gives about:\n137.6051...\nwhile measured ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Alpha]", "\[TildeTilde]", "137.0360..."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "1/\\alpha \\approx 137.0360...", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c5692bd-0287-8540-9a56-9c6f5115c44e"],
 "\nThat is a sizable difference.\n\nYou then define \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], "fluc"], "\[LongEqual]", 
         FractionBox[
          SubscriptBox[
           StyleBox["C", "TI"], "Ideal"], 
          SubscriptBox[
           RowBox[{"(", 
             RowBox[{"1", "/", "\[Alpha]"}], ")"}], "CODATA"]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "C_{\\text{fluc}} = \
\\frac{C_{\\text{Ideal}}}{(1/\\alpha)_{\\text{CODATA}}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "158fffea-54b0-0547-874a-7146a487b25d"],
 "\nand interpret the discrepancy as \[OpenCurlyDoubleQuote]universal \
non-coherence.\[CloseCurlyDoubleQuote] \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Problem\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"be31b63a-8438-fb4f-ae79-49c49208d5ad"],
 "\nThis is not predictive. It is a reinterpretation of mismatch.\n\nIf a \
theory predicts the wrong value and then defines a correction constant from \
the difference, that is not validation; it is parameter absorption. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Better framing\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"8f8cf89c-f737-b643-b53e-d16d83996f13"],
 "\nThis can still be useful if presented as: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a proposed idealized geometric baseline,"
 }], "InlineItem",ExpressionUUID->"5f8b37d1-6619-f949-ab79-72c44eb264e7"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "with empirical deviation quantified by a fluctuation factor,"
 }], "InlineItem",ExpressionUUID->"84bc9b54-b060-7048-9841-09a76fb51509"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "to be explained dynamically later."
 }], "InlineItem",ExpressionUUID->"04f2d992-4d0c-bb4d-ab82-f2b15efe372b"],
 "\nBut it should ",
 StyleBox["not",
  FontWeight->Bold],
 " be called proof. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"RHUFT classification\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"442acd38-f50b-184f-81e7-a6a80afb5683"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " speculative phenomenological ansatz, not established \n",
 Cell[BoxData[
