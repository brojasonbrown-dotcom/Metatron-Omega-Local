         ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<flux imbalance at scale s\>\""}], ",", 
         RowBox[{"\"\<Type\>\"", "->", "\"\<observable\>\""}]}], "|>"}], ",", 
