\\\"Claim\\\" -> \\\"The discrepancy between the geometric ideal and measured \
1/\[Alpha] is an entropic non-coherence factor Cfluc.\\\",\\n      \
\\\"Equation\\\" -> HoldForm[Cfluc == CIdeal/(1/\[Alpha]measured)],\\n      \
\\\"Category\\\" -> \\\"NeedsEvidence\\\",\\n      \\\"Type\\\" -> \
\\\"Interpretive\\\",\\n      \\\"RHUFTLayer\\\" -> \\\"Electromagnetic \
