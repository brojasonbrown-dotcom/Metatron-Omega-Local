   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"87fd21bd-99f6-464a-b6c4-1dc4e3609229"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " correct dimensional result   \n",
 StyleBox["Classification:",
  FontWeight->Bold],
 " formal/dimensional result \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Derivation\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f6411e5f-6e9b-5f45-9aae-3a6790ca7e12"],
 "\nGiven \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["C", "TI"], "mass"], 
         StyleBox["I", "TI"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "M = C_{\\text{mass}} I,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "529c3dee-0ddf-4f4c-a3b9-dcac46f0164d"],
 "\nwith \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["I", "TI"], "\[LongEqual]", "\[Integral]", "|", 
         "\[CapitalOmega]", 
         SuperscriptBox["|", "2"], "\[DifferentialD]", 
         StyleBox["V", "TI"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "I = \\int |\\Omega|^2\\, dV,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "53e8192e-3192-9f4c-9ff1-bcdf296a8cdf"],
 "\nand \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", "\[CapitalOmega]", "]"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["T", "TI"], "-1"], ","}], TraditionalForm], "errors" -> {},
      "input" -> "[\\Omega]=T^{-1},", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c0081ca1-1cf8-774c-824d-ac20fe97429d"],
 "\nwe obtain: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           StyleBox["I", "TI"], "]"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["T", "TI"], "-2"], 
         SuperscriptBox[
          StyleBox["L", "TI"], "3"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "[I]=T^{-2}L^3.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f169324f-56a6-414f-921b-3b1a18883426"],
 "\nTherefore: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
