         SubscriptBox[
          StyleBox["w", "TI"], 
          StyleBox["l", "TI"]], 
         StyleBox["L", "TI"], "+", 
         SubscriptBox[
          StyleBox["w", "TI"], 
          StyleBox["p", "TI"]], 
         StyleBox["P", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{J} = w_c r + w_q Q - w_d D - w_l L + w_p P", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3eb13f3c-82c0-0248-9bc6-aad9406c421f"],
