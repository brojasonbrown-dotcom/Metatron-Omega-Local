         SuperscriptBox[
          StyleBox["L", "TI"], "-3"], 
         SuperscriptBox[
          StyleBox["T", "TI"], "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "[C_{\\text{mass}}]=\\frac{M}{L^3T^{-2}} = ML^{-3}T^2.", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8d0e1de5-199b-1f40-a562-1af1ea05bed6"],
 "\nNewton\[CloseCurlyQuote]s gravitational constant has dimensions: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
