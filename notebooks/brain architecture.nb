     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "53748f35-5d52-3f42-aa2b-e369814d8bf4"]
 }], "InlineItem",ExpressionUUID->"08f1a542-60af-ff4c-bf09-e8c6a561f2d3"],
 "\n",
 Cell[TextData[{
