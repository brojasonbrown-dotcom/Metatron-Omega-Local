    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f2071993-29e4-e54d-a79f-95bf4a318af9"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Stable matter corresponds to localized coherent field nodes.\
\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"25028620-e3c3-1e47-b153-6e931a08799c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Assessment\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"835cf61d-6602-f646-9832-64d8884c5f13"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " plausible RHUFT principle, not derived   \n",
 StyleBox["Classification:",
  FontWeight->Bold],
 " modeling ansatz / heuristic interpretation\n\nThis idea is consistent with \
your architecture notebook: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "coherence,"
 }], "InlineItem",ExpressionUUID->"2cc05b1e-25db-8a4d-926c-c669417ccaa4"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "closure,"
 }], "InlineItem",ExpressionUUID->"f919e30d-162a-0a40-ab31-2d324ead3a76"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "persistence,"
 }], "InlineItem",ExpressionUUID->"31f9708d-8fae-2745-9f91-0d29761e0805"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "self-measurement,"
 }], "InlineItem",ExpressionUUID->"65d9c651-fbd1-2e44-bd2d-235cd293b8bd"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "stability metrics."
 }], "InlineItem",ExpressionUUID->"af58bfd0-55f1-cf49-af88-d50e519b787b"],
 "\nIt is also conceptually coherent in a broad field-theoretic sense.\n\nBut \
in the current RHUFT material, it has not been derived from a governing PDE, \
variational principle, or stability theorem. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Needed for rigor\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"8e43bf5b-adc9-ee4c-9509-c991139a6034"],
 "\nTo elevate this, RHUFT would need: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a field equation for ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[CapitalOmega]", TraditionalForm], "errors" -> {}, 
      "input" -> "\\Omega", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "1efc3415-4f0e-ec46-9182-6551a4d7dc69"],
  ","
 }], "InlineItem",ExpressionUUID->"ea8e1f46-ed8e-4842-b4e9-950a0e454ddd"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a definition of stationary/coherent node solutions,"
 }], "InlineItem",ExpressionUUID->"04639d0d-abb9-a04c-977a-4eab965b7b9e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a stability condition,"
 }], "InlineItem",ExpressionUUID->"e80950a9-4cdb-5f49-a71e-2d9c61d38200"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "and a mechanism for localization."
 }], "InlineItem",ExpressionUUID->"a5e72627-f387-354c-b4ed-5de2a0ccadfa"],
 "\nWithout that, it remains a plausible interpretive principle. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"31d47aa8-7ab6-9a4c-9b20-d74e2bb2da0b"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Claim 6  \"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b2b659e4-6d7b-e248-9452-6240ecb8fe18"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Particle mass ratios follow a golden-ratio scaling law:\"\>",
     "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"6de30550-d24b-314d-8114-c5f32c43de7f"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          SubscriptBox[
           StyleBox["M", "TI"], 
           StyleBox["B", "TI"]], 
          SubscriptBox[
           StyleBox["M", "TI"], 
           StyleBox["A", "TI"]]], "\[Proportional]", 
         SuperscriptBox["\[Phi]", 
          RowBox[{"\[CapitalDelta]", 
            StyleBox["n", "TI"]}]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\frac{M_B}{M_A}\\propto \\phi^{\\Delta n}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "95428a05-c3af-a447-96b8-8f85162249e4"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Assessment\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"624603b8-c9d1-f544-8784-82439044ed04"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " speculative hypothesis   \n",
 StyleBox["Classification:",
  FontWeight->Bold],
 " unsupported scaling ansatz\n\nThere is no derivation in the material \
provided that forces ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0fa19efa-88e0-4d47-82f6-7736cdd8f66d"],
 " to control the hierarchy of particle masses.\n\nThis may be aesthetically \
motivated by self-similarity or recursive packing, but no necessity is shown. \
\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Main issue\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"77ef6d42-739c-224b-9258-27222ae0fcf3"],
 "\nA valid theoretical derivation would need at least one of: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "an eigenvalue problem whose spectrum asymptotically scales with ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\phi", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "d6fbdc0f-7083-d843-b8fa-a6be2909382a"],
  ","
 }], "InlineItem",ExpressionUUID->"fa4bfcb4-1296-f040-a134-a6cdc8a22e55"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a geometric recursion law that produces ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\phi", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "188e7cfa-4f78-1643-a207-65115852aa97"],
  " uniquely,"
 }], "InlineItem",ExpressionUUID->"152b1e45-1663-c84b-8f22-a95a0b3b75cd"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a stability functional minimized at golden-ratio partitions,"
 }], "InlineItem",ExpressionUUID->"12d7af31-2616-214b-9e1e-161371127dc4"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "or a symmetry argument."
 }], "InlineItem",ExpressionUUID->"8dc62b61-f3d8-7842-a258-2d52db31aaf8"],
 "\nNone of that is present yet. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Correct status\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"74f3b599-468d-444a-945a-450b62936bb7"],
 "\nThis is currently a ",
 StyleBox["conjecture",
  FontWeight->Bold],
 ", not a proof and not an established RHUFT result. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"5ae1a94e-a65e-6241-bfd7-3b265791413f"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Claim 7  \"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7fe8ce00-83b0-554d-8210-6aa792d8f25b"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"The proton/electron mass ratio is explained by\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"3a1078b9-9e93-d24f-84ee-b944309e5e0c"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Phi]", 
          RowBox[{"15", "+", 
            SuperscriptBox["\[Phi]", "-1"]}]], "\[CenterDot]", 
         FractionBox["6455", "6456"], "."}], TraditionalForm], "errors" -> {},
      "input" -> "\\phi^{15+\\phi^{-1}}\\cdot \\frac{6455}{6456}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "99a82f21-9651-8744-86e3-5c1f190cee2b"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Assessment\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"4dcfd278-ff82-da46-bf57-3f0e3153e0d6"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " numerical fit   \n",
 StyleBox["Classification:",
  FontWeight->Bold],
 " empirical fit / unsupported as theory\n\nThis is the most important place \
to be strict. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"What is true\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"bdc3b7e0-4b7f-6240-b254-6451e144d7d8"],
 "\nNumerically, a formula can be made very close to the measured \
proton/electron mass ratio. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"What is not established\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"eaecc211-24ae-ea45-8889-f562bbb3c0b3"],
 "\nNothing in the provided text derives: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "why the exponent should be ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"15", "+", 
          SuperscriptBox["\[Phi]", "-1"]}], TraditionalForm], "errors" -> {}, 
      "input" -> "15+\\phi^{-1}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "6c90770f-7227-814a-a7e8-362030ce55f2"],
  ","
 }], "InlineItem",ExpressionUUID->"b1118dce-ba80-bf44-bed4-6cdaed141e9e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "why 15 is privileged,"
 }], "InlineItem",ExpressionUUID->"65de68b6-dcf6-5843-9035-e445a7a69064"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "why ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SuperscriptBox["\[Phi]", "-1"], TraditionalForm], "errors" -> {}, 
      "input" -> "\\phi^{-1}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "4c4875fe-ff81-6441-87ce-8e4b7f978cbf"],
  " enters additively,"
 }], "InlineItem",ExpressionUUID->"ef434950-3822-9745-b859-ca0d5f93cc30"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "why the factor ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"6455", "/", "6456"}], TraditionalForm], "errors" -> {}, 
      "input" -> "6455/6456", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "077b7ec1-94bd-3c4a-9eea-b023aa0847e0"],
  " is unique or necessary."
 }], "InlineItem",ExpressionUUID->"3d7e0e32-42ca-dc4b-af70-a27b9b2c7e77"],
 "\nWithout derivation, this is not a proof. It is a fitted expression. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Key rigor principle\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"fee3f731-2cdf-e84c-925d-de8c557f3012"],
 "\nIf a formula contains a near-unity correction introduced specifically to \
improve agreement with measurement, then: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "unless independently derived,"
 }], "InlineItem",ExpressionUUID->"14401950-dff3-d949-a31f-d61f230cc07f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "it is a fit parameter in disguise."
 }], "InlineItem",ExpressionUUID->"ee560e48-5248-0a40-8aab-d9f386effb33"],
 "\nThat is exactly how it must be treated. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Best rigorous wording\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d0882e2e-d38a-6b4d-b858-8c3c827added"],
 "\n",
 Cell[BoxData[GridBox[{
    {
     PaneBox[Cell[TextData[{
       "The expression\n",
       Cell[BoxData[
        FormBox[
         TemplateBox[<|"boxes" -> FormBox[
             RowBox[{
               SuperscriptBox["\[Phi]", 
                RowBox[{"15", "+", 
                  SuperscriptBox["\[Phi]", "-1"]}]], "\[CenterDot]", 
               FractionBox["6455", "6456"]}], TraditionalForm], 
           "errors" -> {}, "input" -> 
           "\\phi^{15+\\phi^{-1}}\\cdot \\frac{6455}{6456}", "state" -> 
           "Boxes"|>,
          "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
        "53610820-0f23-b046-ad97-0858b6e5e40d"],
       "\nprovides a close numerical fit to the proton/electron mass ratio, \
but no first-principles derivation has yet been supplied for its exponent or \
correction factor."
      }],
       Background->None,ExpressionUUID->
       "8be6405e-d51e-a143-9e0b-1df6679592c3"],
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"c8dc66e9-595c-9343-b1a7-712e1e8729f5"],
 "\nThat is the accurate statement. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"24839e78-0bc3-1843-b22c-683900c6befb"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Claim 8  \"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"487bc8c3-d327-2546-8248-86ac83197af7"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox[Cell[TextData[{
     "The factor ",
     Cell[BoxData[
      FormBox[
       TemplateBox[<|"boxes" -> FormBox[
           RowBox[{"6455", "/", "6456"}], TraditionalForm], "errors" -> {}, 
         "input" -> "6455/6456", "state" -> "Boxes"|>,
        "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
      "4d69f960-4efe-6d48-8cec-83e5114a5302"],
     " is \[OpenCurlyDoubleQuote]non-arbitrary.\[CloseCurlyDoubleQuote]"
    }],
     Background->None,ExpressionUUID->"c162fe60-c891-f343-aded-b33f0546aabb"],
     "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d630cd5f-ac76-7543-b622-87fd0f1c90f8"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Assessment\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"931de6cc-b186-5d49-a798-e38364d4ca55"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " unsupported   \n",
 StyleBox["Classification:",
  FontWeight->Bold],
 " unsupported claim\n\nThis cannot be called non-arbitrary unless you show: \
\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "where both integers arise from a prior derivation,"
 }], "InlineItem",ExpressionUUID->"70ae5aa0-326b-934f-95ad-f37757639fe8"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "why they are uniquely selected,"
 }], "InlineItem",ExpressionUUID->"689913c8-80ab-5f43-8819-7ecd4abab580"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "and why neighboring values are excluded."
 }], "InlineItem",ExpressionUUID->"0b324f6c-c1c2-3f48-8ec4-278369d3c489"],
 "\nAt present, the text does not do that.\n\nSo rigor requires the opposite \
wording: \n",
 Cell[BoxData[GridBox[{
    {
     PaneBox["\<\"At present, the correction factor appears ad hoc unless \
independently derived.\"\>",
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
