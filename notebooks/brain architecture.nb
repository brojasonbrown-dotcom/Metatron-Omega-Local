          StyleBox["L", "TI"], "3"], 
         SuperscriptBox[
          StyleBox["M", "TI"], "-1"], 
         SuperscriptBox[
          StyleBox["T", "TI"], "-2"], ","}], TraditionalForm], "errors" -> {},
