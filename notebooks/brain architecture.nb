  Background->None,ExpressionUUID->"61013898-b238-3b41-9c5e-2600c3b624e7"],
 "\nThis is a good engineering device: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["J", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["w", "TI"], 
          StyleBox["c", "TI"]], 
         StyleBox["r", "TI"], "+", 
         SubscriptBox[
          StyleBox["w", "TI"], 
          StyleBox["q", "TI"]], 
         StyleBox["Q", "TI"], "-", 
