Cell[CellGroupData[{

Cell["3. Root Equations", "Section",ExpressionUUID->"4709ea21-0f9f-8644-bff5-0e745e405a42"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"makeSectionCell", "[", "\"\<Root Equations\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "makeSubsectionCell", "[", "\"\<Oscillator Bank / Superposition Field\>\"",
     "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"oscillatorUpdate", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]", "[", "i", "]"}], "[", 
      RowBox[{"t", "+", "1"}], "]"}], "==", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]", "[", "i", "]"}], "[", "t", "]"}], "+", 
      RowBox[{
       RowBox[{"\[Omega]", "[", "i", "]"}], " ", "\[CapitalDelta]t"}], "+", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"\[CapitalDelta]t", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"K", "[", 
           RowBox[{"i", ",", "j"}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Theta]", "[", "j", "]"}], "[", "t", "]"}], "-", 
            RowBox[{
             RowBox[{"\[Theta]", "[", "i", "]"}], "[", "t", "]"}]}], "]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"superpositionField", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\[Psi]Field", "[", "t", "]"}], "==", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"a", "[", "i", "]"}], "[", "t", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{
           RowBox[{"\[Theta]", "[", "i", "]"}], "[", "t", "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coherenceEquation", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"r", "[", "t", "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"\[Psi]Phase", "[", "t", "]"}]}], "]"}]}], "==", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "n"}], ")"}], " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{
           RowBox[{"\[Theta]", "[", "i", "]"}], "[", "t", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coherenceMagnitudeEquation", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"r", "[", "t", "]"}], "==", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "n"}], ")"}], " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", 
           RowBox[{
            RowBox[{"\[Theta]", "[", "i", "]"}], "[", "t", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "]"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeFormulaCell", " ", "/@", " ", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
     "oscillatorUpdate", ",", "\[IndentingNewLine]", "   ", 
      "superpositionField", ",", "\[IndentingNewLine]", "   ", 
      "coherenceEquation", ",", "\[IndentingNewLine]", "   ", 
      "coherenceMagnitudeEquation"}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "makeSubsectionCell", "[", "\"\<Toroidal Recurrence / Closure Logic\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fluxImbalanceEquation", "=", 
   RowBox[{
    RowBox[{"\[CapitalDelta]", "[", 
     RowBox[{"s", ",", "t"}], "]"}], "==", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"FIn", "[", 
       RowBox[{"s", ",", "t"}], "]"}], "-", 
      RowBox[{"FOut", "[", 
       RowBox[{"s", ",", "t"}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"closureQualityEquation", "=", 
   RowBox[{
    RowBox[{"Q", "[", 
     RowBox[{"s", ",", "t"}], "]"}], "==", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[Lambda]", "[", "s", "]"}]}], " ", 
      RowBox[{"\[CapitalDelta]", "[", 
       RowBox[{"s", ",", "t"}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hardClosureEquation", "=", 
   RowBox[{
    RowBox[{"\[CapitalDelta]", "[", 
     RowBox[{"s", ",", "t"}], "]"}], "<", 
    RowBox[{"\[Tau]", "[", "s", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phiClosureEquation", "=", 
   RowBox[{
    RowBox[{"\[Tau]", "[", "s", "]"}], "==", 
    RowBox[{"1", "/", 
     RowBox[{"phi", "^", "3"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeFormulaCell", " ", "/@", " ", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
     "fluxImbalanceEquation", ",", "\[IndentingNewLine]", "   ", 
      "closureQualityEquation", ",", "\[IndentingNewLine]", "   ", 
      "hardClosureEquation", ",", "\[IndentingNewLine]", "   ", 
      "phiClosureEquation"}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "makeSubsectionCell", "[", "\"\<Node / Lattice Propagation\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nodeUpdateEquation", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "k", "]"}], "[", 
     RowBox[{"t", "+", "1"}], "]"}], "==", 
    RowBox[{
     RowBox[{"f", "[", "k", "]"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "[", "k", "]"}], "[", "t", "]"}], ",", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"w", "[", 
          RowBox[{"j", ",", "k"}], "]"}], " ", 
         RowBox[{
          RowBox[{"x", "[", "j", "]"}], "[", "t", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"neighbors", "[", "k", "]"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"\[Psi]Field", "[", "t", "]"}], ",", 
      RowBox[{"M", "[", "t", "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeFormulaCell", "[", "nodeUpdateEquation", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "makeSubsectionCell", "[", "\"\<Self-Measurement / Time / Memory\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"measurementEquation", "=", 
   RowBox[{
    RowBox[{"Y", "[", "t", "]"}], "==", 
    RowBox[{"P", "[", 
     RowBox[{
      RowBox[{"\[Psi]", "[", "t", "]"}], ",", 
      RowBox[{"X", "[", "t", "]"}], ",", 
      RowBox[{"\[CapitalXi]", "[", "t", "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"discrepancyEquation", "=", 
   RowBox[{
    RowBox[{"D", "[", "t", "]"}], "==", 
    RowBox[{"d", "[", 
     RowBox[{
      RowBox[{"Y", "[", "t", "]"}], ",", 
      RowBox[{"YHat", "[", "t", "]"}], ",", 
      RowBox[{"M", "[", "t", "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"memoryUpdateEquation", "=", 
   RowBox[{
    RowBox[{"M", "[", 
     RowBox[{"t", "+", "1"}], "]"}], "==", 
    RowBox[{"UM", "[", 
     RowBox[{
      RowBox[{"M", "[", "t", "]"}], ",", 
      RowBox[{"Y", "[", "t", "]"}], ",", 
      RowBox[{"D", "[", "t", "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"timeContinuityEquation", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"CTime", "[", "t", "]"}], "==", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"InnerProduct", "[", 
       RowBox[{
        RowBox[{"\[Psi]", "[", "t", "]"}], ",", 
        RowBox[{"\[Psi]", "[", 
         RowBox[{"t", "+", "1"}], "]"}]}], "]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"\[Psi]", "[", "t", "]"}], "]"}], " ", 
       RowBox[{"Norm", "[", 
        RowBox[{"\[Psi]", "[", 
         RowBox[{"t", "+", "1"}], "]"}], "]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeFormulaCell", " ", "/@", " ", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
     "measurementEquation", ",", "\[IndentingNewLine]", "   ", 
      "discrepancyEquation", ",", "\[IndentingNewLine]", "   ", 
      "memoryUpdateEquation", ",", "\[IndentingNewLine]", "   ", 
      "timeContinuityEquation"}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "makeSubsectionCell", "[", "\"\<Actualization / Stabilization Selection\>\"",
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"actualizationObjectiveEquation", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"\[ScriptCapitalJ]", "[", "t", "]"}], "==", 
    RowBox[{
     RowBox[{"wc", " ", 
      RowBox[{"r", "[", "t", "]"}]}], "+", 
     RowBox[{"wq", " ", 
      RowBox[{"QGlobal", "[", "t", "]"}]}], "-", 
     RowBox[{"wd", " ", 
      RowBox[{"D", "[", "t", "]"}]}], "-", 
     RowBox[{"wl", " ", 
      RowBox[{"L", "[", "t", "]"}]}], "+", 
     RowBox[{"wp", " ", 
      RowBox[{"PAlign", "[", "t", "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeFormulaCell", "[", "actualizationObjectiveEquation", "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "makeSubsectionCell", "[", "\"\<Information Density / Burden / Inertia\>\"",
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"informationDensityEquation", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"\[Rho]I", "[", 
     RowBox[{"x", ",", "s"}], "]"}], "==", 
    RowBox[{"fI", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalC]", "[", 
       RowBox[{"x", ",", "s"}], "]"}], ",", 
      RowBox[{"\[ScriptCapitalR]", "[", 
       RowBox[{"x", ",", "s"}], "]"}], ",", 
      RowBox[{"\[ScriptCapitalK]", "[", 
       RowBox[{"x", ",", "s"}], "]"}], ",", 
      RowBox[{"\[ScriptCapitalS]", "[", 
       RowBox[{"x", ",", "s"}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"burdenEquation", "=", 
   RowBox[{
    RowBox[{"B", "[", 
     RowBox[{"s", ",", "t"}], "]"}], "==", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]I", "[", 
        RowBox[{"x", ",", "s"}], "]"}], " ", 
       RowBox[{"ws", "[", "x", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"\[CapitalOmega]", "[", "s", "]"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"inertiaEquation", "=", 
   RowBox[{
    RowBox[{"Inertia", "[", 
     RowBox[{"s", ",", "t"}], "]"}], "==", 
    RowBox[{"\[Kappa]B", " ", 
     RowBox[{"B", "[", 
      RowBox[{"s", ",", "t"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"makeFormulaCell", " ", "/@", " ", 
   RowBox[{"{", "\[IndentingNewLine]", "   ", 
    RowBox[{
    "informationDensityEquation", ",", "\[IndentingNewLine]", "   ", 
     "burdenEquation", ",", "\[IndentingNewLine]", "   ", "inertiaEquation"}],
     "\[IndentingNewLine]", "}"}]}], ";"}]}], "Input",ExpressionUUID->\
"be9d9dc9-f954-af40-b8af-739d65598a2b"]
