Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"symbolDictionary", "=", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
