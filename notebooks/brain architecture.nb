    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c326d09c-53b4-5248-ace4-0b05b486ceff"],
 "\nI suggest building a formal RHUFT knowledge base in the notebook as a \
dataset.\n\nSomething like this: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"rhuftKnowledgeBase", "=", 
          RowBox[{"Dataset", " ", "@", " ", 
            RowBox[{"{", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"<|", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"\"Concept\"", "->", "\"Coherence\""}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    
                    RowBox[{
                    "\"Definition\"", "->", 
                    "\"Degree of phase alignment or ordered collective \
behavior\""}], ",", "\[IndentingNewLine]", "    ", 
                    
                    RowBox[{
                    "\"RoleInRHUFT\"", "->", 
                    "\"Candidate realizability/stability factor\""}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    
                    RowBox[{
                    "\"CurrentImplementation\"", "->", 
                    "\"Kuramoto order parameter magnitude\""}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Status\"", "->", "\"Provisional\""}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    
                    RowBox[{
                    "\"EvidenceType\"", "->", 
                    "\"Computational surrogate\""}]}], "\[IndentingNewLine]", 
                  "  ", "|>"}], ",", "\[IndentingNewLine]", "  ", 
                RowBox[{"<|", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"\"Concept\"", "->", "\"Closure\""}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    
                    RowBox[{
                    "\"Definition\"", "->", 
                    "\"Degree to which a process balances or recirculates its \
internal flux\""}], ",", "\[IndentingNewLine]", "    ", 
                    
                    RowBox[{
                    "\"RoleInRHUFT\"", "->", 
                    "\"Candidate persistence/containment factor\""}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    
                    RowBox[{
                    "\"CurrentImplementation\"", "->", 
                    "\"Exp[-lambda*imbalance]\""}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Status\"", "->", "\"Strong provisional\""}], 
