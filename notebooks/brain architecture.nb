Cell[CellGroupData[{

Cell["18. Professional Refactor Principles", "Section",ExpressionUUID->"b0209e1e-c795-9140-895f-04df54bf3370"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"refactorPrinciples", "=", 
    RowBox[{"Dataset", " ", "@", " ", 
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", "->", "\"\<Single responsibility\>\""}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<each file should own one coherent computational \
role\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", "->", "\"\<Canonical state model\>\""}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<all modules communicate through shared typed state \
structures\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", "->", "\"\<Constants centralized\>\""}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<all thresholds and defaults come from a single \
source\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", 
          "->", "\"\<No symbolic metadata in numeric kernels\>\""}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<Hebrew/chakra/semantic mappings stay in data, not core \
math\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", "->", "\"\<Observable invariants\>\""}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<coherence, closure, drift, and burden must be measurable \
every step\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", "->", "\"\<Ablation-ready design\>\""}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<golden-ratio choices must be testable against \
alternatives\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", "->", "\"\<Deterministic test mode\>\""}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<seeded runs should reproduce signatures and \
metrics\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", "->", "\"\<Layered dependency policy\>\""}], 
         ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<higher layers may depend on lower layers, not vice versa\
\>\""}]}], "|>"}]}], "\[IndentingNewLine]", "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "refactorPrinciples"}], \
"Input",ExpressionUUID->"1b3389d3-2358-394d-b3c7-3bb7f88aa6b1"]
}, Open  ]],

