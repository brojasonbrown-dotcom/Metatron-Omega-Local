         RowBox[{"\"\<Type\>\"", "->", "\"\<state\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Symbol\>\"", "->", "\"\<a_i(t)\>\""}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<amplitude of oscillator i\>\""}], ",", 
         RowBox[{"\"\<Type\>\"", "->", "\"\<state\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Symbol\>\"", "->", "\"\<\\\\[Omega]_i\>\""}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<natural frequency of oscillator i\>\""}], ",", 
         RowBox[{"\"\<Type\>\"", "->", "\"\<parameter\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Symbol\>\"", "->", "\"\<K_ij\>\""}], ",", 
         RowBox[{"\"\<Meaning\>\"", 
          "->", "\"\<coupling strength from oscillator j to i\>\""}], ",", 
         RowBox[{"\"\<Type\>\"", "->", "\"\<parameter\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
