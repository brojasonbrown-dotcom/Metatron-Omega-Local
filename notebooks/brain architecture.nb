  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kuramotoStep", "[", 
     RowBox[{"phases_List", ",", "freqs_List", ",", 
      RowBox[{"coupling_", "?", "NumericQ"}], ",", 
      RowBox[{"dt_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "phases", "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"phases", "+", 
       RowBox[{"dt", " ", 
        RowBox[{"(", 
