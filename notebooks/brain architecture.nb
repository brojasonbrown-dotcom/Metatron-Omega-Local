 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Claim 9  \"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"3c9de02a-5de8-5a46-b6f7-4d4c729f30e7"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"The fine-structure constant is governed by the \
\[OpenCurlyDoubleQuote]geometric ideal identity\[CloseCurlyDoubleQuote]\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"706c6875-8970-ef4e-82bb-18115f48bf93"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], "Ideal"], "\[LongEqual]", "137", "+", 
         FractionBox[
          SuperscriptBox["\[Pi]", "2"], 
          RowBox[{"6", 
            StyleBox["e", "TI"]}]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "C_{\\text{Ideal}} = 137 + \\frac{\\pi^2}{6e}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9c90858a-5cbe-c444-b8fb-35ee080f6c2a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Assessment\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"978ed14b-46dd-364f-a313-4d265c9fdd4f"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " speculative numerical ansatz   \n",
 StyleBox["Classification:",
  FontWeight->Bold],
 " heuristic fit candidate \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"What is true\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"3e92f1eb-11bb-3745-8cd8-2cad3ac1b1db"],
 "\nThe expression is mathematically well-defined. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"What is false if overclaimed\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7e2c0ea6-0095-4848-a4ec-840a210bf374"],
 "\nIt is not a derivation of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Alpha]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "708588df-2a03-bf49-9cd6-aee308b7749e"],
 ".\n\nNumerically: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "measured ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"1", "/", "\[Alpha]", "\[TildeTilde]", "137.035999..."}], 
        TraditionalForm], "errors" -> {}, "input" -> 
      "1/\\alpha \\approx 137.035999...", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "2c810163-e72d-3e43-85ff-a6b3898e7254"]
 }], "InlineItem",ExpressionUUID->"7b36ecfe-4033-d941-affd-2bcb1090469e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "your expression gives about ",
  "137.605137..."
 }], "InlineItem",ExpressionUUID->"a7dff7ae-925b-474e-a8c6-8d7e50d69683"],
 "\nThat is not a small residual in the context of a supposed fundamental \
constant derivation. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Why this matters\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c5ee9e22-06b5-1c4f-918a-a4e390794662"],
 "\nFor a true constant law, the burden is very high.  \nA mismatch of \
roughly 0.569 is enormous compared to metrological precision.\n\nThus, this \
cannot currently be treated as a successful prediction. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Best rigorous wording\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"bfde7b9f-5c3c-5e49-8eb2-33b0f2ccd497"],
 "\n",
 Cell[BoxData[GridBox[{
    {
     PaneBox[Cell[TextData[{
       "The expression ",
       Cell[BoxData[
        FormBox[
         TemplateBox[<|"boxes" -> FormBox[
             RowBox[{"137", "+", 
               SuperscriptBox["\[Pi]", "2"], "/", 
               RowBox[{"(", 
                 RowBox[{"6", 
                   StyleBox["e", "TI"]}], ")"}]}], TraditionalForm], 
           "errors" -> {}, "input" -> "137+\\pi^2/(6e)", "state" -> "Boxes"|>,
          "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
        "5bfcf93a-1544-4041-8d4b-ff1ead8d7515"],
       " may be viewed as a speculative geometric ansatz for an idealized \
boundary scale, but it does not reproduce the measured inverse fine-structure \
constant with precision."
      }],
       Background->None,ExpressionUUID->
       "585c9159-9e72-e04e-ae9c-24bf6dac2229"],
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"710d1c57-b186-ee43-ab75-29634a31e9bc"],
 "\nThat is correct. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"c36316fd-223a-fe4f-8124-782588bb61a3"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Claim 10  \"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"653d6cef-90a8-6a43-96e5-cead9cbaa23b"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"The discrepancy can be interpreted as an entropic \
fluctuation factor:\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"dd5c69fe-f48e-bf4c-93af-8addb692715e"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], "fluc"], "\[LongEqual]", 
         FractionBox[
          SubscriptBox[
           StyleBox["C", "TI"], "Ideal"], 
          SubscriptBox[
           RowBox[{"(", 
             RowBox[{"1", "/", "\[Alpha]"}], ")"}], "measured"]], "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "C_{\\text{fluc}}=\\frac{C_{\\text{Ideal}}}{(1/\\alpha)_{\\text{measured}\
}}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8d9d71f9-c17f-3842-94ba-8beeabc10a41"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Assessment\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0da4a992-2e16-c142-b1b6-2b7d8488c320"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " definitional reparameterization, not derivation   \n",
 StyleBox["Classification:",
  FontWeight->Bold],
 " heuristic interpretation\n\nThis is mathematically allowed: you can define \
such a ratio.\n\nBut it is not explanatory by itself.\n\nDefining a \
correction factor from mismatch does not explain the mismatch unless the \
theory independently predicts the factor. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"What would be needed\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7663e6f3-3aff-fd4d-afde-c1e0502499c6"],
 "\nTo make this meaningful, RHUFT would need: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a formal definition of entropy/coherence in the field,"
 }], "InlineItem",ExpressionUUID->"49d9dd37-ad30-194c-8177-2ea49421492e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a derivation of why the ideal value renormalizes to the measured one,"
 }], "InlineItem",ExpressionUUID->"2c63053c-c58d-0449-9ddd-f81b07e420e1"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "and a law connecting fluctuation to observables."
 }], "InlineItem",ExpressionUUID->"e17296b5-195f-f045-88a8-71f4f121fe4a"],
 "\nWithout that, this is just a relabeling of error. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"9caea75d-6107-f14c-8bda-f21375501465"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Claim 11  \"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f38fbfc0-fdc5-c843-96bb-5205d8c37489"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"\[OpenCurlyDoubleQuote]Entropic unification achieved.\
\[CloseCurlyDoubleQuote]\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d3ea08fb-0853-284c-9cb6-5b831c9ee566"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Assessment\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"6bdf48bf-41d8-b74b-bac9-92ba44e15d3b"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " not established   \n",
 StyleBox["Classification:",
  FontWeight->Bold],
 " unsupported claim\n\nThis phrase should not be used at this stage.\n\nNo \
entropic law has been derived.  \nNo dynamical relation between entropy and \
electromagnetic coupling has been shown.  \nNo predictive formula for the \
deviation has been established.\n\nThis is precisely the kind of statement \
that should be removed or downgraded. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"0de047cf-6a2d-284e-87ef-f8d0cc724dee"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Claim 12  \"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d235f19f-86be-2944-ba70-dfa4127ddef1"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"The RHUFT master equation unifies mass, hierarchy, and \
electromagnetic boundary conditions.\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ffb5849d-68f1-b744-90a7-a5d6929da006"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Assessment\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ed863a0a-85c1-7d46-a35e-feaddecb3e65"],
 "\n",
 StyleBox["Status:",
  FontWeight->Bold],
 " prototype synthesis expression   \n",
 StyleBox["Classification:",
  FontWeight->Bold],
 " mixed construction\n\nThis is an important distinction.\n\nYour master \
equation is useful as a ",
 StyleBox["conceptual decomposition",
  FontWeight->Bold],
 " into:\n1. a dimensional scale term,\n2. a hierarchy term,\n3. a \
boundary/coherence term.\n\nThat is architecturally valuable.\n\nBut the \
mathematical status of the three parts is different: \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Part A: dimensional mass term\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"16f84975-ce06-734c-a029-b600f4fd2068"],
 "\nPotentially meaningful and dimensionally sound. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Part B: phi-based hierarchy factor\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d50a3cb6-efbc-7e45-a251-3d34a7057f58"],
 "\nCurrently conjectural / fitted. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Part C: alpha-related coherence factor\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b0d0a082-0549-5d48-a5aa-95afaaaa631a"],
 "\nCurrently speculative / not derived.\n\nTherefore the entire master \
equation is ",
 StyleBox["not yet a theorem",
  FontWeight->Bold],
 ". It is a ",
 StyleBox["synthesis hypothesis",
  FontWeight->Bold],
 ". \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Best rigorous wording\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"dae39970-2242-ef4e-befd-7ef5f6fe0262"],
 "\n",
 Cell[BoxData[GridBox[{
    {
     PaneBox["\<\"The RHUFT master equation currently functions as a unifying \
prototype expression organizing the theory\[CloseCurlyQuote]s dimensional, \
hierarchical, and boundary-condition hypotheses into a single framework.\"\>",
      BaseStyle->{"Text", FontColor -> LightDarkSwitched[
          GrayLevel[0.35], 
          GrayLevel[0.8602474]]},
      ImageMargins->5,
      ImageSize->{Full, Automatic}]}
   },
   AutoDelete->False,
   GridBoxBackground->{"Columns" -> {{
        LightDarkSwitched[
         GrayLevel[1], 
         GrayLevel[0.278317]]}}},
   GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
         LightDarkSwitched[
          RGBColor[0.87, 0.94, 1], 
          RGBColor[0.2491127, 0.3295188, 0.4231198]], 
         AbsoluteThickness[4]]}, "Rows" -> {{False}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], 
  "BlockQuote",
  Background->None,ExpressionUUID->"143fe1c8-38f0-ad46-99c0-176ae6d76571"],
 "\nThat is accurate. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"d930dbd3-3221-2943-974d-4f67b3c4d22c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"IV. Audit of the computational notebook in light of the \
updated thesis\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"242a0821-01f9-7848-87e0-4024977e3960"],
 "\nNow I\[CloseCurlyQuote]ll connect this to your earlier executable \
notebook. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"What the notebook got right\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"80236507-ff41-0042-9a41-b27b0bc68e13"],
 "\nThe notebook was stronger than the thesis text in several ways: \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"1. It treated theory as a measurable dynamical system\"\>", 
    "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c4426dbb-9763-2747-9c84-b8ee3856d166"],
 "\nThis is excellent. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"2. It separated symbolic equations from executable operators\
\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"31348efd-1eb2-2148-9ea9-573384801386"],
 "\nThis is methodologically sound. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"3. It used explicit observables\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"cff51c45-b25d-b542-b54a-5aa770073fea"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "coherence"
 }], "InlineItem",ExpressionUUID->"1fc5e633-a207-fc40-b879-dac889650bc9"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "closure"
 }], "InlineItem",ExpressionUUID->"53fbe7a6-63d8-1840-ab20-80fb772565be"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "drift"
 }], "InlineItem",ExpressionUUID->"5334c567-ad53-184a-b5e0-967863fe0221"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "persistence"
 }], "InlineItem",ExpressionUUID->"12364fa3-9578-8e43-9def-cea263f5f8e4"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "burden"
 }], "InlineItem",ExpressionUUID->"15812cee-9c89-b94d-9bdf-e978cc335539"],
 "\nThese are exactly the kinds of quantities a serious RHUFT program would \
need. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. It allowed ablation\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"9905fb0d-8d30-dc4d-8983-3100b05fc57b"],
 "\nThis is crucial for avoiding dogmatism about: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\phi", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "285e9dab-f632-ab4f-851c-b2309ae462c5"],
  " scaling,"
 }], "InlineItem",ExpressionUUID->"24a563e4-65fa-1340-a132-59d8bd4a8d08"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Fibonacci counts,"
 }], "InlineItem",ExpressionUUID->"c21bca0a-e57c-1a4c-b098-fc17373a6c9c"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "toroidal preference,"
 }], "InlineItem",ExpressionUUID->"a1ee68d9-69e8-ef44-9dba-37b53161434e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "closure thresholds."
 }], "InlineItem",ExpressionUUID->"0af11b09-f0cf-3145-af75-cfad04ece64e"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"5. It included invariants\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"82625150-863c-f148-bba1-ba5c73d607f4"],
 "\nThat is necessary for computational rigor. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Where the notebook must still be interpreted carefully\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c5b185fe-cd7f-f549-b814-c94818d404ec"],
 "\nThe notebook contains placeholders that should not be mistaken for \
derived RHUFT laws: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Kuramoto phases are a surrogate, not yet the RHUFT field equation."
 }], "InlineItem",ExpressionUUID->"22c4836d-16f9-b545-a4a1-e5f59b7f958f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "The node update rule is a numerical prototype, not a derived physical law."
 }], "InlineItem",ExpressionUUID->"04a9b819-1d9c-9048-9393-0e08aa2733dd"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "The burden functional is illustrative, not fundamental."
 }], "InlineItem",ExpressionUUID->"60336ad0-317b-bc40-a509-c7e754d0ece1"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Golden ratio frequencies and thresholds are hypotheses, not established \
necessities."
 }], "InlineItem",ExpressionUUID->"f59b6b60-7b45-1a4e-91e1-9de07e472023"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Toroidal visualization is suggestive, not proven topology."
 }], "InlineItem",ExpressionUUID->"01f7e7cd-333a-bb45-9027-2b13879f5588"],
 "\nSo the notebook is best understood as a ",
 StyleBox["computational research scaffold",
  FontWeight->Bold],
 ", not as a direct proof of RHUFT. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"6da728db-5b26-2f4b-ba92-c11b61444fe5"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"V. Provisional RHUFT ontology\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"29cb05e8-fff5-6f4a-90bc-c4fa04bedcb2"],
 "\nHere is the most rigorous current ontology I can defend. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"A. Likely RHUFT-core concepts\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e0c1fd86-f01d-da42-8520-d29319ead1fc"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Recursive coherence field\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"67a8b941-9049-7d43-8572-5d9fcd5d51c7"],
 "\nA field-like quantity governing local recursive organization. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Background/base field\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"93815b02-25fc-9445-a45c-822a26da58c0"],
 "\nA reference state relative to which localized structure is measured. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Coherence contrast\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"bd054b78-aed3-134e-b6d2-bdbffb8ca205"],
 "\nDifference between localized and background recursive field intensity. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Emergent mass\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"bdb32eaf-a854-6444-b38c-7a51b5b0fd56"],
 "\nA quantity proportional, under a proposed coupling, to integrated \
coherence contrast. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Stability / persistence\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"74997831-745c-6348-9f33-9339ae5931fc"],
 "\nConditions under which a localized coherent structure remains sustained.\n\
\nThese concepts are internally coherent and worth developing. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"B. Useful but not yet foundational\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e2aeb414-1121-2441-a426-eef26597474a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Closure\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"082f4923-b6a0-7749-9059-05ecca20d3d9"],
 "\nA metric of balance/recirculation; computationally useful, not yet \
formally derived from the field ontology. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Self-measurement / memory\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b83eaf58-a6e8-7546-8ff7-6ab01fb345b8"],
 "\nConceptually relevant if RHUFT includes recursive self-reference; still \
formalization needed. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Actualization objective\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"bd9cb11b-8204-0445-8de7-70602893e944"],
 "\nA control functional in the computational model; not yet a physical law. \
\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Burden / inertia proxy\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"6ffb98d3-dc64-974a-88e2-93c0cc21c9e5"],
 "\nA plausible complexity-cost surrogate; not yet derived. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"C. Speculative overlay concepts\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f6845d34-3f76-8047-b108-397a9ae1bf1a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Golden-ratio mass scaling\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"8bda8ebb-3bac-3e4f-80ff-6fa131233b10"],
 "\nInteresting but unproven. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Fibonacci string counts\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"4635556b-bbdb-6c4b-94e8-df40cf45380f"],
 "\nImplementation hypothesis only. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Toroidal privileged geometry\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"5133e51c-f5ce-2e44-aa0d-24775807f2e6"],
 "\nConceptual option, not necessity. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"E8 harmonic-shell interpretation\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"80deda06-a96b-de4d-b028-1372da485257"],
 "\nUnsupported unless explicitly derived. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"b61fa697-68f0-1041-8ad7-84937bf9eda6"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"VI. What can be said rigorously right now\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a515b93d-3767-4942-bb4c-467912914af4"],
 "\nThe following statements are, in my judgment, the strongest accurate \
RHUFT statements presently available. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Statement 1\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"cfc6a414-719f-2642-bac8-669fb6f69fec"],
 "\nA recursive coherence field may be modeled as a quantity with dimensions \
of inverse time in order to preserve dimensional consistency of \
self-referential kernel expressions. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Statement 2\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"36cb3e8f-cd83-6742-9a3c-4e0503cc1008"],
 "\nIf mass is modeled as proportional to the integrated quadratic contrast \
of such a field over a spatial region, then the required coupling coefficient \
has the same dimensions as the inverse gravitational constant. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Statement 3\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"68111e3a-2a53-1943-a762-77e6a187a05f"],
 "\nThis dimensional correspondence suggests that gravity may act as the \
scale-setting conversion factor in a coherence-based emergent mass framework. \
\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Statement 4\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"853dd166-6f34-034c-bac5-a0ecfd53d73f"],
 "\nA computational implementation of RHUFT can meaningfully track \
observables such as coherence, closure, discrepancy, persistence, and burden, \
even if the underlying field equations remain provisional.\n\nThese four \
statements are the most defensible current RHUFT core. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"4c06eb25-3a67-ba4c-a1fa-a5c005b00300"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"VII. What cannot yet be said rigorously\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b896f870-3421-9d4d-8f57-bf4ac8dc7e7f"],
 "\nThese claims are not currently justified as written: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "that RHUFT has proven the proton/electron mass ratio,"
 }], "InlineItem",ExpressionUUID->"2bcdfc3a-e7a2-eb47-9207-45c8d9b82a88"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "that RHUFT has derived the fine-structure constant,"
 }], "InlineItem",ExpressionUUID->"b64ed73e-b898-bb44-b989-0cc37cb3d846"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "that the correction factors are non-arbitrary,"
 }], "InlineItem",ExpressionUUID->"922e9c1e-7edd-5945-b5b3-bab28b117936"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "that entropic unification has been achieved,"
 }], "InlineItem",ExpressionUUID->"33114b21-ab48-7743-bd5e-6be3a2f80e35"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "that the full master equation is validated,"
 }], "InlineItem",ExpressionUUID->"b187e000-ec2f-2a4b-8676-0be697ba411e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "that ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\phi", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "5189f0cc-cb54-c84f-8b02-2200a2fbeb6d"],
  " scaling is a demonstrated law of particle hierarchy."
 }], "InlineItem",ExpressionUUID->"56af22c7-72e6-6549-8499-c7f06b0398df"],
 "\nThese must remain open hypotheses or fitted observations. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"8580944d-1442-9d4a-b4dd-8df8726c786e"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"VIII. What is needed next for real theoretical rigor\"\>", 
    "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b3fa110c-36e8-4340-9f25-82f2292dbbf8"],
 "\nIf RHUFT is to move beyond conceptual synthesis, it needs the following \
in order. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox[Cell[TextData[{
     "1. A precise field equation for ",
     Cell[BoxData[
      FormBox[
       TemplateBox[<|
        "boxes" -> FormBox["\[CapitalOmega]", TraditionalForm], 
         "errors" -> {}, "input" -> "\\Omega", "state" -> "Boxes"|>,
        "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
      "ff0e75f2-3918-7f43-ad4e-3c6a83c38261"]
    }],
     Background->None,ExpressionUUID->"eed51ec7-c190-8246-83fb-e149fdf98c5e"],
     "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"3e1fabdf-37f3-c847-bed0-30808f5ee03d"],
 "\nYou need an explicit governing law: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "PDE,"
 }], "InlineItem",ExpressionUUID->"6af0e6c3-59f2-0242-b5a3-608e1ca2d649"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "integrodifferential equation,"
 }], "InlineItem",ExpressionUUID->"3bdf4011-d189-424f-b9eb-60ecff4a5aaf"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "variational principle,"
 }], "InlineItem",ExpressionUUID->"3357bf71-41c2-9243-a849-392756c14f89"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "or recurrence law."
 }], "InlineItem",ExpressionUUID->"131fae69-ed1f-6c42-9142-9f2e6cbd296f"],
 "\nWithout this, the theory remains interpretive. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"2. A definition of admissible states\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"5b10b68f-04af-d342-91c9-1d03099294bd"],
 "\nSpecify: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "domain,"
 }], "InlineItem",ExpressionUUID->"68c90f7f-e76c-2149-a3c0-1d25615e28d6"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "boundary conditions,"
 }], "InlineItem",ExpressionUUID->"f5713328-29c6-154b-b5b4-495594e53933"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "smoothness,"
 }], "InlineItem",ExpressionUUID->"a5a92d73-c653-b545-9df0-fefdc7b3bd48"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "gauge/symmetry structure,"
 }], "InlineItem",ExpressionUUID->"1a87d039-d719-2a4d-8877-e4da62d73371"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "and what counts as a localized solution."
 }], "InlineItem",ExpressionUUID->"4321bded-8019-d047-9710-3030c007e08c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"3. A derivation of stable particle-like solutions\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
