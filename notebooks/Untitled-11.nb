Cell[CellGroupData[{

Cell["\<\
7. Matrix eigenspectrum on a periodic rectangular torus proxy\
\>", "Section",ExpressionUUID->"42918c96-1160-0b47-8b4d-170ac6cfb5e2"],

Cell[TextData[{
 "To make the eigenspectrum directly testable, we discretize the operator ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", "-", 
         SubsuperscriptBox["\[PartialD]", 
          StyleBox["u", "TI"], "2"], "-", 
         SubsuperscriptBox["\[PartialD]", 
          StyleBox["v", "TI"], "2"], "+", 
         SubscriptBox["\[Mu]", 
          StyleBox["eff", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "L = -\\partial_u^2 - \\partial_v^2 + \\mu_{\\mathrm{eff}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3085fca-93b6-a44b-a9df-865bce26c73c"],
 "on a doubly periodic grid. This is a numerical proxy for the linearized \
toroidal operator. "
}], "Text",ExpressionUUID->"b1c641ce-4d3f-b942-8b4e-865530953b7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "periodicSecondDifferenceMatrix", ",", "flatTorusOperatorMatrix", ",", 
     "flatTorusEigenSystem"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"periodicSecondDifferenceMatrix", "[", 
     RowBox[{
      RowBox[{"nPts_Integer", " ", "?", " ", "Positive"}], ",", 
      RowBox[{"domainLength_", ":", " ", 
       RowBox[{"2", " ", "Pi"}]}], ",", 
      RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"h", ",", "rules"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"h", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"domainLength", "/", "nPts"}], ",", "wp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"rules", "=", 
        RowBox[{"Join", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "i"}], "}"}], "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "2"}], "/", 
                RowBox[{"h", "^", "2"}]}], ",", "wp"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "nPts"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"i", "+", "1"}]}], "}"}], "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"h", "^", "2"}]}], ",", "wp"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"nPts", "-", "1"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "i"}], "}"}], "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"h", "^", "2"}]}], ",", "wp"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"nPts", "-", "1"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"{", "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", "nPts"}], "}"}], "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"h", "^", "2"}]}], ",", "wp"}], "]"}]}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"nPts", ",", "1"}], "}"}], "->", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"h", "^", "2"}]}], ",", "wp"}], "]"}]}]}], 
           "\[IndentingNewLine]", "    ", "}"}]}], "\[IndentingNewLine]", 
         "  ", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"rules", ",", 
         RowBox[{"{", 
          RowBox[{"nPts", ",", "nPts"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"flatTorusOperatorMatrix", "[", 
     RowBox[{
      RowBox[{"nU_Integer", " ", "?", " ", "Positive"}], ",", 
      RowBox[{"nV_Integer", " ", "?", " ", "Positive"}], ",", "massEff_", ",", 
      RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"du2", ",", "dv2", ",", "idU", ",", "idV"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"du2", "=", 
        RowBox[{"periodicSecondDifferenceMatrix", "[", 
         RowBox[{"nU", ",", 
          RowBox[{"2", " ", "Pi"}], ",", "wp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"dv2", "=", 
        RowBox[{"periodicSecondDifferenceMatrix", "[", 
         RowBox[{"nV", ",", 
          RowBox[{"2", " ", "Pi"}], ",", "wp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"idU", "=", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"nU", ",", "SparseArray"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"idV", "=", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"nV", ",", "SparseArray"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"du2", ",", "idV"}], "]"}]}], "-", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"idU", ",", "dv2"}], "]"}], "+", 
          RowBox[{"massEff", " ", 
           RowBox[{"IdentityMatrix", "[", 
            RowBox[{
             RowBox[{"nU", " ", "nV"}], ",", "SparseArray"}], "]"}]}]}], ",", 
         "wp"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"flatTorusEigenSystem", "[", 
    RowBox[{
     RowBox[{"nU_Integer", " ", "?", " ", "Positive"}], ",", 
     RowBox[{"nV_Integer", " ", "?", " ", "Positive"}], ",", "massTerm_", ",",
      "coupling_", ",", "backgroundValue_", ",", 
     RowBox[{"count_Integer", " ", "?", " ", "Positive"}], ",", 
     RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"massEff", ",", "vals", ",", "vecs"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"massEff", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"effectiveMassTerm", "[", 
          RowBox[{"massTerm", ",", "coupling", ",", "backgroundValue"}], 
          "]"}], ",", "wp"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{
         RowBox[{"flatTorusOperatorMatrix", "[", 
          RowBox[{"nU", ",", "nV", ",", "massEff", ",", "wp"}], "]"}], ",", 
         "count", ",", 
         RowBox[{"Method", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Arnoldi\>\"", ",", 
            RowBox[{"\"\<Criteria\>\"", "->", "\"\<RealPart\>\""}]}], 
           "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"vals", ",", "vecs"}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"f6ffb35c-7aac-b541-ac44-\
6d365c9d4bd4"],

