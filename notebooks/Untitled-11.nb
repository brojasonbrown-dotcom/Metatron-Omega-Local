Cell[CellGroupData[{

Cell["11. Framework summary", "Section",ExpressionUUID->"5dea3f83-3db1-5f49-a82f-b7480d7d3340"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "smallestScaleToroidalLinearizedFramework", "]"}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"smallestScaleToroidalLinearizedFramework", "[", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"majorRadius", "=", 
        RowBox[{"3", "/", "2"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"minorRadius", "=", 
        RowBox[{"1", "/", "2"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"closureTargetValue", "=", 
        RowBox[{"goldenPhi", "^", 
         RowBox[{"-", "13"}]}]}], ",", "\[IndentingNewLine]", "    ", 
       "normalizedPsi", ",", "\[IndentingNewLine]", "    ", "backgroundValue",
        ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"massTerm", "=", "1"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"coupling", "=", 
        RowBox[{"1", "/", "10"}]}]}], "\[IndentingNewLine]", "  ", "}"}], ",",
      "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"normalizedPsi", "=", 
       RowBox[{"normalizedConstantToroidalMode", "[", 
        RowBox[{
        "majorRadius", ",", "minorRadius", ",", "closureTargetValue"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"backgroundValue", "=", 
       RowBox[{"normalizedPsi", "[", 
        RowBox[{"0", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<FrameworkVersion\>\"", 
         "->", "\"\<Phase3.ToroidalLinearization\>\""}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ScaleIndex\>\"", "->", "smallestScaleIndex"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Geometry\>\"", "->", 
         RowBox[{"toroidalGeometrySummary", "[", 
          RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ClosureTarget\>\"", "->", "closureTargetValue"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<BackgroundValue\>\"", "->", "backgroundValue"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<LinearizedModel\>\"", "->", 
         RowBox[{"linearizedToroidalModelSummary", "[", 
          RowBox[{
          "majorRadius", ",", "minorRadius", ",", "massTerm", ",", "coupling",
            ",", "backgroundValue", ",", "3"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SampleNumericalEigenvalues\>\"", "->", 
         RowBox[{
          RowBox[{"flatTorusEigenSystem", "[", 
           RowBox[{
           "10", ",", "10", ",", "massTerm", ",", "coupling", ",", 
            "backgroundValue", ",", "8", ",", "80"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Tests\>\"", "->", 
         RowBox[{"smallestScaleLinearizationTestSuite", "[", "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"0a714885-ff64-d04b-a7d7-\
ce85915b4a9a"],

