Cell[CellGroupData[{

Cell["8. Eigenspectrum diagnostics and convergence", "Section",ExpressionUUID->"40ee0e1d-1bb3-0846-9e3d-7ddcb8fbbe61"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"eigenspectrumSummary", ",", "eigenspectrumResolutionStudy"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eigenspectrumSummary", "[", 
     RowBox[{
      RowBox[{"maxMode_Integer", " ", "?", " ", "NonNegative"}], ",", 
      "majorRadius_", ",", "minorRadius_", ",", "massTerm_", ",", "coupling_",
       ",", "backgroundValue_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
    RowBox[{"Association", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"Table", "[", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", ",", "n"}], "}"}], "->", 
         RowBox[{"<|", "\[IndentingNewLine]", "        ", 
          RowBox[{
           RowBox[{"\"\<Eigenvalue\>\"", "->", 
            RowBox[{"flatTorusEigenvalue", "[", 
             RowBox[{
             "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
              "massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}]}], 
           ",", "\[IndentingNewLine]", "        ", 
           RowBox[{"\"\<Frequency\>\"", "->", 
            RowBox[{"flatTorusFrequency", "[", 
             RowBox[{
             "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
              "massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}]}], 
           ",", "\[IndentingNewLine]", "        ", 
           RowBox[{"\"\<UndampedQ\>\"", "->", 
            RowBox[{"undampedModeQ", "[", 
             RowBox[{
             "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",", 
              "massTerm", ",", "coupling", ",", "backgroundValue"}], 
             "]"}]}]}], "\[IndentingNewLine]", "      ", "|>"}]}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"{", 
         RowBox[{"m", ",", "0", ",", "maxMode"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", "maxMode"}], "}"}]}], 
       "\[IndentingNewLine]", "    ", "]"}], " ", "//", " ", "Flatten"}], 
     "\[IndentingNewLine]", "  ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eigenspectrumResolutionStudy", "[", 
    RowBox[{
    "resolutions_List", ",", "massTerm_", ",", "coupling_", ",", 
     "backgroundValue_", ",", 
     RowBox[{"count_Integer", " ", ":", " ", "8"}], ",", 
     RowBox[{"wp_", ":", " ", "80"}]}], "]"}], ":=", 
   RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{"resolutions", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"flatTorusEigenSystem", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "massTerm", ",", "coupling", 
           ",", "backgroundValue", ",", "count", ",", "wp"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "\[IndentingNewLine]", "  ", ")"}], 
       " ", "&"}], " ", "/@", " ", "resolutions"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"5b336a73-cf42-9546-83b3-\
3d824a791025"],

