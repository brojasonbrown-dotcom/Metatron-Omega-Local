Cell[CellGroupData[{

Cell["10. Smallest-scale tests: linearization and eigenspectrum", "Section",ExpressionUUID->"a1013deb-a516-9e43-b794-b5744c8512b1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "smallestScaleLinearizationTestSuite", "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"smallestScaleLinearizationTestSuite", "[", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"majorRadius", "=", 
        RowBox[{"3", "/", "2"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"minorRadius", "=", 
        RowBox[{"1", "/", "2"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"closureTargetValue", "=", 
        RowBox[{"goldenPhi", "^", 
         RowBox[{"-", "13"}]}]}], ",", "\[IndentingNewLine]", "    ", 
       "backgroundValue", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"massTerm", "=", "1"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"coupling", "=", 
        RowBox[{"1", "/", "10"}]}], ",", "\[IndentingNewLine]", "    ", 
       "normalizedPsi", ",", "\[IndentingNewLine]", "    ", 
       "eigenvaluesCoarse", ",", "\[IndentingNewLine]", "    ", 
       "eigenvaluesFine"}], "\[IndentingNewLine]", "  ", "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"normalizedPsi", "=", 
       RowBox[{"normalizedConstantToroidalMode", "[", 
        RowBox[{
        "majorRadius", ",", "minorRadius", ",", "closureTargetValue"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"backgroundValue", "=", 
       RowBox[{"normalizedPsi", "[", 
        RowBox[{"0", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"eigenvaluesCoarse", "=", 
       RowBox[{
        RowBox[{"flatTorusEigenSystem", "[", 
         RowBox[{
         "8", ",", "8", ",", "massTerm", ",", "coupling", ",", 
          "backgroundValue", ",", "6", ",", "60"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"eigenvaluesFine", "=", 
       RowBox[{
        RowBox[{"flatTorusEigenSystem", "[", 
         RowBox[{
         "12", ",", "12", ",", "massTerm", ",", "coupling", ",", 
          "backgroundValue", ",", "6", ",", "60"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"TestReport", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"toroidalPeriodicClosureQ", "[", 
            RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{
           "TestID", "->", "\"\<Toroidal embedding periodic closure\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"fieldPeriodicClosureQ", "[", 
            RowBox[{"toroidalMode", "[", 
             RowBox[{"2", ",", "3", ",", "amp", ",", "alpha"}], "]"}], "]"}], 
           ",", "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"TestID", "->", "\"\<Toroidal mode periodicity\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"flatTorusEigenvalue", "[", 
               RowBox[{
               "0", ",", "0", ",", "majorRadius", ",", "minorRadius", ",", 
                "massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}], 
              "==", "\[IndentingNewLine]", "        ", 
              RowBox[{"effectiveMassTerm", "[", 
               RowBox[{"massTerm", ",", "coupling", ",", "backgroundValue"}], 
               "]"}]}], ",", "\[IndentingNewLine]", "        ", 
             RowBox[{"Assumptions", "->", "$Assumptions"}]}], 
            "\[IndentingNewLine]", "      ", "]"}], ",", 
           "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{
           "TestID", 
            "->", "\"\<Zero mode eigenvalue equals effective mass\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"TrueQ", "[", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"flatTorusEigenvalue", "[", 
              RowBox[{
              "1", ",", "0", ",", "majorRadius", ",", "minorRadius", ",", 
               "massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}], ">",
              "\[IndentingNewLine]", "        ", 
             RowBox[{"flatTorusEigenvalue", "[", 
              RowBox[{
              "0", ",", "0", ",", "majorRadius", ",", "minorRadius", ",", 
               "massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}]}],
             "\[IndentingNewLine]", "      ", "]"}], ",", 
           "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{
           "TestID", "->", "\"\<Nonzero mode exceeds zero mode\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"stableFlatTorusModes", "[", 
              RowBox[{
              "3", ",", "majorRadius", ",", "minorRadius", ",", "massTerm", ",",
                "coupling", ",", "backgroundValue"}], "]"}], "]"}], ">", 
            "0"}], ",", "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{
           "TestID", "->", "\"\<Stable flat torus modes exist\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"Re", "[", "eigenvaluesCoarse", "]"}], "]"}], ">", "0"}],
            ",", "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{
           "TestID", "->", "\"\<Coarse-grid eigenvalues positive\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"Sort", "[", 
                RowBox[{"Re", "[", "eigenvaluesCoarse", "]"}], "]"}], "-", 
               RowBox[{"Sort", "[", 
                RowBox[{"Re", "[", 
                 RowBox[{"eigenvaluesFine", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", " ", ";;", " ", 
                    RowBox[{"Length", "[", "eigenvaluesCoarse", "]"}]}], 
                   "]"}], "]"}], "]"}], "]"}]}], "]"}], "]"}], "<", "10"}], ",",
            "\[IndentingNewLine]", "      ", "True", ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{
           "TestID", 
            "->", "\"\<Resolution refinement remains bounded\>\""}]}], 
          "\[IndentingNewLine]", "    ", "]"}]}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "  ", "}"}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"40629c00-782f-c545-a4eb-\
645390bfd979"],

