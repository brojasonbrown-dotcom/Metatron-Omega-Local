Cell[CellGroupData[{

Cell["12. Interactive exploration interface", "Section",ExpressionUUID->"66c3298d-d2e5-2543-9995-15ca40df3ff4"],

Cell["\<\
This interface explores the linearized flat-torus proxy spectrum. \
\>", "Text",ExpressionUUID->"52404858-c24f-3643-a6d3-725d6d99bca3"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
      "backgroundValue", ",", "\[IndentingNewLine]", "    ", "eigenTable", ",",
        "\[IndentingNewLine]", "    ", "numericalEigenvalues", ",", 
       "\[IndentingNewLine]", "    ", "modePlot"}], "\[IndentingNewLine]", 
      "  ", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"backgroundValue", "=", 
       RowBox[{
        RowBox[{"normalizedConstantToroidalMode", "[", 
         RowBox[{
         "majorRadius", ",", "minorRadius", ",", "closureTargetValue"}], 
         "]"}], "[", 
        RowBox[{"0", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"eigenTable", "=", 
       RowBox[{"Grid", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Prepend", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Table", "[", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", "          ", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"m", ",", "n"}], "}"}], ",", "\[IndentingNewLine]", 
                "          ", 
                RowBox[{"N", "[", 
                 RowBox[{
                  RowBox[{"flatTorusEigenvalue", "[", 
                   RowBox[{
                   "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",",
                     "massTerm", ",", "coupling", ",", "backgroundValue"}], 
                   "]"}], ",", "20"}], "]"}], ",", "\[IndentingNewLine]", 
                "          ", 
                RowBox[{"N", "[", 
                 RowBox[{
                  RowBox[{"flatTorusFrequency", "[", 
                   RowBox[{
                   "m", ",", "n", ",", "majorRadius", ",", "minorRadius", ",",
                     "massTerm", ",", "coupling", ",", "backgroundValue"}], 
                   "]"}], ",", "20"}], "]"}]}], "\[IndentingNewLine]", 
               "        ", "}"}], ",", "\[IndentingNewLine]", "        ", 
              RowBox[{"{", 
               RowBox[{"m", ",", "0", ",", "maxMode"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "0", ",", "maxMode"}], "}"}]}], 
             "\[IndentingNewLine]", "      ", "]"}], " ", "//", " ", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"#", ",", "1"}], "]"}], " ", "&"}]}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Mode\>\"", ",", "\"\<Eigenvalue\>\"", 
             ",", "\"\<Frequency\>\""}], "}"}]}], "\[IndentingNewLine]", 
          "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "  ", 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
      RowBox[{"numericalEigenvalues", "=", 
       RowBox[{
        RowBox[{"flatTorusEigenSystem", "[", 
         RowBox[{
         "nU", ",", "nV", ",", "massTerm", ",", "coupling", ",", 
          "backgroundValue", ",", "eigenCount", ",", "wp"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"modePlot", "=", 
       RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"toroidalMode", "[", 
             RowBox[{"modeU", ",", "modeV", ",", "1", ",", "alpha"}], "]"}], "[", 
            RowBox[{"u", ",", "v"}], "]"}], "]"}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"u", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"Mesh", "->", "None"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"PlotPoints", "->", "50"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"ColorFunction", "->", "\"\<SolarColors\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Re mode(\>\"", ",", "modeU", ",", "\"\<,\>\"", ",", 
             "modeV", ",", "\"\<)\>\""}], "}"}], "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Background value: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{"backgroundValue", ",", "20"}], "]"}]}], "}"}], "]"}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Effective mass term: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"effectiveMassTerm", "[", 
               RowBox[{"massTerm", ",", "coupling", ",", "backgroundValue"}], 
               "]"}], ",", "20"}], "]"}]}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Numerical eigenvalues: \>\"", ",", 
            RowBox[{"N", "[", 
             RowBox[{"numericalEigenvalues", ",", "10"}], "]"}]}], "}"}], 
          "]"}], ",", "\[IndentingNewLine]", "    ", "eigenTable", ",", 
         "\[IndentingNewLine]", "    ", "modePlot"}], "\[IndentingNewLine]", 
        "  ", "}"}], "]"}]}]}], "\[IndentingNewLine]", " ", "]"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"majorRadius", ",", "1.5", ",", "\"\<Major radius\>\""}], "}"}],
      ",", "0.6", ",", "3", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"minorRadius", ",", "0.5", ",", "\"\<Minor radius\>\""}], "}"}],
      ",", "0.1", ",", "1.2", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", "Delimiter", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"closureTargetValue", ",", 
       RowBox[{"goldenPhi", "^", 
        RowBox[{"-", "13"}]}], ",", "\"\<Closure target\>\""}], "}"}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}], ",", "1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"massTerm", ",", "1", ",", "\"\<Mass term\>\""}], "}"}], ",", 
     "0", ",", "5", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"coupling", ",", "0.1", ",", "\"\<Quartic coupling\>\""}], 
      "}"}], ",", "0", ",", "2", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"alpha", ",", "0", ",", "\"\<Envelope alpha\>\""}], "}"}], ",", 
     "0", ",", "2", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", "Delimiter", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"maxMode", ",", "2", ",", "\"\<Analytic max mode\>\""}], "}"}], 
     ",", "0", ",", "5", ",", "1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"modeU", ",", "1", ",", "\"\<Plot mode m\>\""}], "}"}], ",", 
     "0", ",", "6", ",", "1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"modeV", ",", "1", ",", "\"\<Plot mode n\>\""}], "}"}], ",", 
     "0", ",", "6", ",", "1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", "Delimiter", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nU", ",", "10", ",", "\"\<Grid u\>\""}], "}"}], ",", "6", ",", 
     "20", ",", "1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nV", ",", "10", ",", "\"\<Grid v\>\""}], "}"}], ",", "6", ",", 
     "20", ",", "1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eigenCount", ",", "8", ",", "\"\<Eigenvalue count\>\""}], 
      "}"}], ",", "4", ",", "20", ",", "1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"wp", ",", "60", ",", "\"\<Working precision\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"40", ",", "60", ",", "80", ",", "100"}], "}"}]}], "}"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"SaveDefinitions", "->", "True"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"7757d254-d12e-724a-870b-e7e0ec67e112"],

