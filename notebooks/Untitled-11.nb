Cell[CellGroupData[{

Cell["4. Periodic scalar modes on the torus", "Section",ExpressionUUID->"8dd3bfa7-1685-714a-ac57-0383bae6737a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "toroidalMode", ",", "toroidalRealMode", ",", "constantToroidalMode"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"toroidalMode", "[", 
     RowBox[{"m_Integer", ",", "n_Integer", ",", "amp_", ",", 
      RowBox[{"alpha_", ":", " ", "0"}]}], "]"}], ":=", "\[IndentingNewLine]",
     "  ", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u", ",", "v"}], "}"}], ",", 
      RowBox[{"amp", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "alpha"}], " ", 
         RowBox[{"Cos", "[", "v", "]"}]}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"m", " ", "u"}], "+", 
           RowBox[{"n", " ", "v"}]}], ")"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"toroidalRealMode", "[", 
     RowBox[{"m_Integer", ",", "n_Integer", ",", "amp_", ",", 
      RowBox[{"alpha_", ":", " ", "0"}], ",", 
      RowBox[{"beta_", ":", " ", "0"}]}], "]"}], ":=", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u", ",", "v"}], "}"}], ",", 
      RowBox[{"amp", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "alpha"}], " ", 
         RowBox[{"Cos", "[", "v", "]"}]}], "]"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{
         RowBox[{"m", " ", "u"}], "+", 
         RowBox[{"n", " ", "v"}], "+", "beta"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"constantToroidalMode", "[", "amp_", "]"}], ":=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"u", ",", "v"}], "}"}], ",", "amp"}], "]"}]}], ";"}]}], "Input",\
ExpressionUUID->"89b178ed-b2aa-e645-832e-405aaa38d512"],

Cell["Periodicity tests: ", "CodeText",ExpressionUUID->"e45988e3-caf4-ab41-ba2f-41da5b4d525c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"toroidalPeriodicClosureQ", ",", "fieldPeriodicClosureQ"}], "]"}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"toroidalPeriodicClosureQ", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "embed", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"embed", "=", 
        RowBox[{"torusEmbedding", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"Simplify", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"embed", "[", 
            RowBox[{
             RowBox[{"u", "+", 
              RowBox[{"2", " ", "Pi"}]}], ",", "v"}], "]"}], "==", 
           RowBox[{"embed", "[", 
            RowBox[{"u", ",", "v"}], "]"}]}], "&&", 
          RowBox[{
           RowBox[{"embed", "[", 
            RowBox[{"u", ",", 
             RowBox[{"v", "+", 
              RowBox[{"2", " ", "Pi"}]}]}], "]"}], "==", 
           RowBox[{"embed", "[", 
            RowBox[{"u", ",", "v"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"Assumptions", "->", "$Assumptions"}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fieldPeriodicClosureQ", "[", "psi_", "]"}], ":=", 
   RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"psi", "[", 
        RowBox[{
         RowBox[{"u", "+", 
          RowBox[{"2", " ", "Pi"}]}], ",", "v"}], "]"}], "==", 
       RowBox[{"psi", "[", 
        RowBox[{"u", ",", "v"}], "]"}]}], "&&", 
      RowBox[{
       RowBox[{"psi", "[", 
        RowBox[{"u", ",", 
         RowBox[{"v", "+", 
          RowBox[{"2", " ", "Pi"}]}]}], "]"}], "==", 
       RowBox[{"psi", "[", 
        RowBox[{"u", ",", "v"}], "]"}]}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"04de9796-48e5-414e-b813-\
bcbe540df427"],

Cell[BoxData[
