Cell[CellGroupData[{

Cell["9. Geometry and linearization summaries", "Section",ExpressionUUID->"caa6c326-b433-f741-b531-38594972c301"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "toroidalGeometrySummary", ",", "linearizedToroidalModelSummary"}], "]"}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"toroidalGeometrySummary", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Embedding\>\"", "->", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{"torusEmbedding", "[", 
          RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], "[", 
         RowBox[{"u", ",", "v"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<Metric\>\"", "->", 
       RowBox[{"torusMetricMatrixExact", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<InverseMetric\>\"", "->", 
       RowBox[{"torusInverseMetricExact", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<AreaElement\>\"", "->", 
       RowBox[{"torusAreaElement", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<SurfaceArea\>\"", "->", 
       RowBox[{"torusSurfaceArea", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<PeriodicClosureQ\>\"", "->", 
       RowBox[{"toroidalPeriodicClosureQ", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedToroidalModelSummary", "[", 
    RowBox[{
    "majorRadius_", ",", "minorRadius_", ",", "massTerm_", ",", "coupling_", ",",
      "backgroundValue_", ",", 
     RowBox[{"maxMode_", ":", " ", "3"}]}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<EffectiveMassTerm\>\"", "->", 
      RowBox[{"effectiveMassTerm", "[", 
       RowBox[{"massTerm", ",", "coupling", ",", "backgroundValue"}], "]"}]}],
      ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<StableModes\>\"", "->", 
      RowBox[{"stableFlatTorusModes", "[", 
       RowBox[{
       "maxMode", ",", "majorRadius", ",", "minorRadius", ",", "massTerm", ",",
         "coupling", ",", "backgroundValue"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ModeSummary\>\"", "->", 
      RowBox[{"eigenspectrumSummary", "[", 
       RowBox[{
       "maxMode", ",", "majorRadius", ",", "minorRadius", ",", "massTerm", ",",
         "coupling", ",", "backgroundValue"}], "]"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",ExpressionUUID->\
"478bab44-6e01-344c-bbf0-383c97165dfe"],

