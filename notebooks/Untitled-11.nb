Cell[CellGroupData[{

Cell["3. Toroidal geometry module", "Section",ExpressionUUID->"95745733-7ac3-0048-a8b6-9bb5559cc99b"],

Cell[TextData[{
 "We keep the explicit torus embedding from the previous phase: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", FontSlant -> "Bold"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["u", "TI"], ",", 
             StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 StyleBox["R", "TI"], "+", 
                 StyleBox["r", "TI"], "cos", 
                 StyleBox["v", "TI"]}], ")"}], "cos", 
             StyleBox["u", "TI"], ",", 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["R", "TI"], "+", 
                 StyleBox["r", "TI"], "cos", 
                 StyleBox["v", "TI"]}], ")"}], "sin", 
             StyleBox["u", "TI"], ",", 
             StyleBox["r", "TI"], "sin", 
             StyleBox["v", "TI"]}], "}"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\mathbf{x}(u,v)=\\{(R+r\\cos v)\\cos u,(R+r\\cos v)\\sin u,r\\sin \
v\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3bd4fa96-113d-bb41-921f-e931419be7ad"]
}], "Text",ExpressionUUID->"58379db3-8c5f-004f-bb8e-0c3882b7cbba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "torusEmbedding", ",", "torusTangentU", ",", "torusTangentV", ",", 
     "torusMetricMatrix", ",", "torusAreaElement", ",", "torusSurfaceArea"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusEmbedding", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u", ",", "v"}], "}"}], ",", 
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"majorRadius", "+", 
           RowBox[{"minorRadius", " ", 
            RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
         RowBox[{"Cos", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"majorRadius", "+", 
           RowBox[{"minorRadius", " ", 
            RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
         RowBox[{"Sin", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"minorRadius", " ", 
         RowBox[{"Sin", "[", "v", "]"}]}]}], "\[IndentingNewLine]", "  ", 
       "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusTangentU", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"embed", "=", 
        RowBox[{"torusEmbedding", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"embed", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", "u"}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusTangentV", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"embed", "=", 
        RowBox[{"torusEmbedding", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"embed", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", "v"}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusMetricMatrixExact", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"majorRadius", "+", 
           RowBox[{"minorRadius", " ", 
            RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], "^", "2"}], ",", "0"}],
        "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"minorRadius", "^", "2"}]}], "}"}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusMetricMatrix", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"torusMetricMatrixExact", "[", 
     RowBox[{"majorRadius", ",", "minorRadius"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"torusAreaElement", "[", 
     RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Det", "[", 
        RowBox[{"torusMetricMatrix", "[", 
         RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], "]"}], "]"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"torusSurfaceArea", "[", 
    RowBox[{"majorRadius_", ",", "minorRadius_"}], "]"}], ":=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Integrate", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"torusAreaElement", "[", 
        RowBox[{"majorRadius", ",", "minorRadius"}], "]"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]",
       "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"cf954494-1073-b841-9f88-\
24e597e6f3a0"],

Cell["A helper for the inverse metric is useful later: ", "CodeText",ExpressionUUID->"38e3e98b-eecb-1a44-bb46-4b3df09f8fd9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "torusInverseMetricExact", "]"}], ";"}], 
