{
  "name": "metatron-omega",
  "version": "1.0.0",
  "private": true,
  "author": "METATRON Project",
  "type": "module",
  "description": "METATRON Ω — desktop interface to the certified toroidal RHUFT brain. Real computation only: every answer is computed live from the field, never canned.",
  "main": "electron/main.cjs",
  "scripts": {
    "bundle:omega": "node scripts/bundle-omega.mjs",
    "icon": "python scripts/make-icon.py",
    "start": "npm run bundle:omega && electron .",
    "smoke": "npm run bundle:omega && node scripts/smoke.mjs",
    "smoke:gui": "npm run bundle:omega && electron . --ci",
    "pack": "npm run bundle:omega && electron-builder --dir",
    "dist": "npm run bundle:omega && electron-builder",
    "verify:dist": "electron-builder --dir && release/win-unpacked/METATRON-OMEGA.exe --ci"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}
