{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "*.ts",
    "core/**/*.ts",
    "adapters/**/*.ts",
    "cognition/**/*.ts",
    "parallel/**/*.ts",
    "schemas/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "blobs", "manifests", "mind_state", "mind_inbox", "_archive", "formal"]
}
