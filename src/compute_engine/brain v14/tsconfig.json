{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "core/**/*.ts",
    "adapters/**/*.ts",
    "cognition/**/*.ts",
    "schemas/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "blobs", "manifests", "mind_state", "mind_inbox"]
}
