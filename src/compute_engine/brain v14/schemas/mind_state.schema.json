{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RHUFT Mind — Persisted Mind State",
  "description": "Snapshot of the mind's learned state (concept lexicon + counters). Prototype fields are base64 of raw little-endian Float64Array(28) bytes. Corrupt files are quarantined (renamed), never silently repaired. Executable validator: schemas/validate.ts#validateMindState.",
  "type": "object",
  "required": ["version", "savedAt", "stableThoughtCount", "concepts"],
  "properties": {
    "version": { "const": 1 },
    "savedAt": { "type": "number" },
    "stableThoughtCount": { "type": "number", "minimum": 0 },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "labels", "prototype", "reinforcement", "firstSeen", "lastSeen"],
        "properties": {
          "id": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "prototype": { "type": "string", "description": "base64, 224 bytes (28 Float64)" },
          "reinforcement": { "type": "number", "minimum": 0 },
          "firstSeen": { "type": "number" },
          "lastSeen": { "type": "number" },
          "sourceTrace": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
