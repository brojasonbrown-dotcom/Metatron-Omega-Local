{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RHUFT Mind — LLM Tool Response Contracts",
  "description": "Contracts for structured responses from local LLM tools (phi/mathstral via Ollama). Executable validators: schemas/validate.ts. TRUTH_SOURCES: responses failing validation are rejected and journaled; never mocked.",
  "definitions": {
    "nameThis": {
      "type": "object",
      "required": ["labels"],
      "properties": {
        "labels": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "minItems": 1, "maxItems": 5 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "define": {
      "type": "object",
      "required": ["definition"],
      "properties": {
        "word": { "type": "string" },
        "definition": { "type": "string", "maxLength": 2000 },
        "related": { "type": "array", "items": { "type": "string" }, "maxItems": 8 }
      }
    },
    "relate": {
      "type": "object",
      "required": ["relation"],
      "properties": {
        "relation": { "type": "string", "maxLength": 2000 },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "verify": {
      "type": "object",
      "required": ["verdict"],
      "properties": {
        "verdict": { "type": "string", "enum": ["valid", "invalid", "uncertain"] },
        "reasoning": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
