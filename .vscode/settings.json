{
  // Python
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": false,
  "python.linting.flake8Enabled": true,
  "python.formatting.provider": "black",
  "python.sortImports.args": ["--profile", "black"],
  
  // Editor
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "editor.rulers": [80, 100, 120],
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  
  // Files
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true,
    "**/.coverage": true,
    "**/htmlcov": true,
    "**/build": true,
    "**/dist": true,
    "**/*.egg-info": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true
  },
  
  // C/C++
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.intelliSenseCacheSize": 5120,
  
  // Rust
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.procMacro.enable": true,
  
  // Terminal
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.profiles.windows": {
    "Git Bash": {
      "source": "Git Bash"
    },
    "PowerShell": {
      "source": "PowerShell"
    },
    "Command Prompt": {
      "path": "${env:windir}\\System32\\cmd.exe"
    }
  },
  
  // Jupyter
  "jupyter.askForKernelRestart": false,
  "jupyter.interactiveWindow.creationMode": "perFile",

  // Wolfram Language
  "wolfram.systemPath": "Automatic",
  "wolfram.lsp.serverEnabled": true,
  "wolfram.notebook.kernelEnabled": true,
  "wolfram.mcp.serverEnabled": true,
  "wolfram.lsp.semanticTokens": true,
  "wolframLanguageNotebook.rendering.renderTexForm": true,
  "wolframLanguageNotebook.rendering.renderAsImages": true,
  "wolframLanguageNotebook.kernel.connectOnOpeningNotebook": true,
  
  // Git
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  
  // Search
  "search.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/build": true,
    "**/dist": true
  },

  // Watchers: never watch the Electron packaging output. The watcher holds a
  // Windows delete-share lock on release/win-unpacked*/resources/*.asar and
  // EBUSY-kills electron-builder mid-pack (ADR-011). Note: takes effect on
  // window reload; builds also stage outside the tree via build-driver.mjs.
  "files.watcherExclude": {
    "**/src/compute_engine/app/release/**": true,
    "**/src/compute_engine/app/node_modules/**": true
  }
}
