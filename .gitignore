# dependencies (any depth)
node_modules/
**/node_modules/
# build output
dist/
out/
**/dist/
**/out/
*.log
# 5.4G of re-pullable Ollama model blobs — never commit
**/ollama_models/
**/blobs/
# electron / bundler artifacts
**/*.tsbuildinfo
src/compute_engine/app/release/
# python caches / packaging metadata
__pycache__/
**/__pycache__/
*.egg-info/
**/*.egg-info/

# mind private state (journal + learned memory) — local only, never commit
**/mind_state/
# Ava internal tooling memory — local only
.ava/
# editor / scratch
**/.obsidian/
.obsidian/
sandbox/
backup/
*.canvas

# environment files — never commit real secrets. The tracked root .env holds only
# devcontainer build config (no credentials); ignore all OTHER .env variants so a
# future real key (`.env.local`, `app/.env`, …) can never slip into git.
**/.env.local
**/.env.*.local
**/.env.development
**/.env.production
src/compute_engine/app/.env

# local mind memory state (journal + learned memory) — never commit
.Omega/

# MCP server config contains a live GitHub PAT — never commit the real one.
# Share .mcp.example.json instead (placeholder token).
.mcp.json

# stale duplicate web export (vite/wrangler/bun build) — superseded by
# src/compute_engine/omega/ (the certified trunk) and the Electron app
src/compute_engine/Metatron Omega/

# vendored OCR sidecar + Tesseract language data + Windows reserved-name artifact — never commit
Unlimited-OCR-main/
*.traineddata
nul

# python wheels / large model artifacts — never commit
*.whl
